		Effect = function(s, n)
			s.Decoy = true
			s.DecoyCount = n
		end,
	},
}

----------------------------------------------------------------------------
-- LOOKUP + HELPERS
----------------------------------------------------------------------------
PowerUps.ById = {}
for _, def in ipairs(PowerUps.Definitions) do
	assert(Config.Rarity[def.Rarity], "Unknown rarity on power-up " .. def.Id)
	assert(not PowerUps.ById[def.Id], "Duplicate power-up id " .. def.Id)
	PowerUps.ById[def.Id] = def
end

function PowerUps.Get(id)
	return PowerUps.ById[id]
end

-- Builds the stat table for a player from their owned power-ups.
-- `owned` is a dictionary { [powerUpId] = stacks }.
function PowerUps.ComputeStats(owned)
	local stats = baseStats()
	if owned then
		for _, def in ipairs(PowerUps.Definitions) do
			local stacks = owned[def.Id]
			if stacks and stacks > 0 then
				def.Effect(stats, stacks)
			end
		end
	end
	stats.MaxHealth = math.max(stats.MaxHealth, 20) -- Glass Cannon can't kill you outright
	return stats
end

-- Draws `count` DIFFERENT random power-ups for a player, weighted by rarity.
-- Power-ups the player already has at MaxStacks are never offered.
-- `rng` is an optional Random object.
function PowerUps.DrawCards(owned, count, rng)
	rng = rng or Random.new()
	owned = owned or {}

	local pool = {}
	for _, def in ipairs(PowerUps.Definitions) do
		if (owned[def.Id] or 0) < (def.MaxStacks or 1) then
			table.insert(pool, def)
		end
	end

	local cards = {}
	while #cards < count and #pool > 0 do
		local total = 0
		for _, def in ipairs(pool) do
			total += Config.Rarity[def.Rarity].Weight
		end
		local roll = rng:NextNumber() * total
		local chosenIndex = #pool
		for i, def in ipairs(pool) do
			roll -= Config.Rarity[def.Rarity].Weight
			if roll <= 0 then
				chosenIndex = i
				break
			end
		end
		-- remove from the pool so the same card can't appear twice
		table.insert(cards, table.remove(pool, chosenIndex).Id)
	end
	return cards
end

return PowerUps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes.lua  (ReplicatedStorage.Shared.Remotes)

	One place that lists every RemoteEvent the game uses. The server creates
	them; clients wait for them. Use it like:

		local Remotes = require(ReplicatedStorage.Shared.Remotes)
		Remotes.Get("Fire"):FireServer(...)

	C->S = client to server, S->C = server to client
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

Remotes.Names = {
	"QueueToggle", -- C->S  join / leave the match queue
	"MatchState", -- S->C  full match/lobby state snapshot (phase, scores, power-ups, cards)
	"Fire", -- C->S  shot request (origin, direction, hit claims)
	"ShotFx", -- S->C  bullet paths for drawing the enemy's tracers
	"HitConfirm", -- S->C  tells the shooter what they hit (hitmarker / kill sound)
	"Damaged", -- S->C  tells the victim they were hit (and from where)
	"PickCard", -- C->S  the loser picks a power-up card by index
	"Ability", -- C->S  power-up abilities (Decoy, PhantomDash, Shockwave, Grapple visuals)
	"Knockback", -- S->C  push the local character (client owns its physics)
	"Buff", -- S->C  timed buffs, e.g. Second Wind speed boost
	"Effect", -- S->C  one-off visual effects (explosions, shockwaves, grapple ropes)
	"SettingsLoad", -- S->C  saved settings for this player
	"SettingsSave", -- C->S  save settings
	"Aim", -- C->S  where you're looking up/down (others see your aim pose)
	"Practice", -- C->S  lobby power-up lab: add / remove / clear practice power-ups
	"PlaygroundToggle", -- C->S  enter / leave Playground mode
	"AdminCommand", -- C->S  admin commands (e.g. "bot" starts a match vs a bot)
	"Notify", -- S->C  short toast message (admin command results etc.)
	"Duel", -- C->S  "Challenge" (userId) / "Accept" / "Decline" (userId) / "Rematch"
	"DuelInvite", -- S->C  someone challenged you / wants a rematch
}

local FOLDER_NAME = "Remotes"

local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		for _, name in ipairs(Remotes.Names) do
			if not folder:FindFirstChild(name) then
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = folder
			end
		end
	else
		folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	end
	return folder
end

-- On the server, Get returns a thin wrapper so FireClient quietly skips
-- bots (they're plain tables, not real Players, and have no client).
local wrappers = {}
local function wrap(remote)
	local wrapper = wrappers[remote]
	if not wrapper then
		wrapper = {
			Remote = remote,
			Name = remote.Name,
			OnServerEvent = remote.OnServerEvent,
			FireClient = function(_, player, ...)
				if typeof(player) == "Instance" and player.Parent then
					remote:FireClient(player, ...)
				end
			end,
			FireAllClients = function(_, ...)
				remote:FireAllClients(...)
			end,
		}
		wrappers[remote] = wrapper
	end
	return wrapper
end

-- Returns the RemoteEvent with this name (a bot-safe wrapper on the server).
function Remotes.Get(name)
	local f = getFolder()
	if RunService:IsServer() then
		local remote = f:FindFirstChild(name)
		return remote and wrap(remote)
	end
	return f:WaitForChild(name)
end

-- Server: call once at startup so every remote exists before clients ask.
function Remotes.Init()
	getFolder()
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal.lua  (ReplicatedStorage.Shared.Signal)
	Tiny event class:  local s = Signal.new(); s:Connect(fn); s:Fire(...)
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	table.insert(handlers, fn)
	return {
		Disconnect = function()
			local i = table.find(handlers, fn)
			if i then
				table.remove(handlers, i)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, fn in ipairs(table.clone(self._handlers)) do
		task.spawn(fn, ...)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--[[
	Util.lua  (ReplicatedStorage.Shared.Util)
	Small helpers used by both server and client.
]]

local Util = {}

-- Moves `current` toward `target` by at most `maxDelta`.
function Util.approach(current, target, maxDelta)
	if current < target then
		return math.min(current + maxDelta, target)
	end
	return math.max(current - maxDelta, target)
end

-- Frame-rate independent exponential smoothing factor.
-- lerp(a, b, Util.smooth(speed, dt)) moves a toward b at `speed`.
function Util.smooth(speed, dt)
	return 1 - math.exp(-speed * dt)
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

-- Removes the Y component of a vector.
function Util.flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

-- Returns v.Unit, or `fallback` (default zero vector) if v is ~zero.
function Util.safeUnit(v, fallback)
	if v.Magnitude < 1e-4 then
		return fallback or Vector3.zero
	end
	return v.Unit
end

-- True if the value is a Vector3 with finite components (rejects NaN / inf
-- that an exploiter could send through a RemoteEvent).
function Util.isFiniteVector3(v)
	if typeof(v) ~= "Vector3" then
		return false
	end
	for _, c in ipairs({ v.X, v.Y, v.Z }) do
		if c ~= c or c == math.huge or c == -math.huge then
			return false
		end
	end
	return true
end

-- Shortest distance from point p to the segment a-b.
function Util.distanceToSegment(p, a, b)
	local ab = b - a
	local len2 = ab:Dot(ab)
	if len2 < 1e-6 then
		return (p - a).Magnitude
	end
	local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
	return (p - (a + ab * t)).Magnitude
end

-- Finds the character model a part belongs to (a Model containing a Humanoid).
function Util.getCharacterFromPart(part)
	local model = part and part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

-- Body-part category used for damage: "Head", "Body" or "Limb".
local BODY_PARTS = {
	UpperTorso = true,
	LowerTorso = true,
	Torso = true,
	HumanoidRootPart = true,
}
function Util.hitZone(partName)
	if partName == "Head" then
		return "Head"
	elseif BODY_PARTS[partName] then
		return "Body"
	end
	return "Limb"
end

-- True for server-side bots (plain tables standing in for a Player).
-- Never index .IsBot on a real Player: unknown properties throw.
function Util.isBot(player)
	return typeof(player) == "table" and player.IsBot == true
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">ArenaCrossfire</string>
          <string name="Source"><![CDATA[--[[
	ArenaCrossfire.lua  (ServerScriptService.Server.ArenaCrossfire)

	"Crossfire": a compact Rivals-style duel map. Small enough that you find
	each other fast, with three routes between the spawns:

	  NORTH  a covered market hall: close range inside (doorways and an
	         open end), a walkable roof on top (ramp up at each end)
	  MIDDLE a raised plaza with a big centrepiece that blocks the
	         spawn-to-spawn line, low cover around it
	  SOUTH  a container yard: climb the ramp onto a container for height

	Each spawn is a small building with a walkable roof (stairs on both
	sides) so you can hold your end from above. Mirrored across X = 0, so
	both sides are identical; spawns are tinted with the team colours.

	TOP VIEW (X = long axis)

	   +------------------------------------------------------------+
	   |  ramp> [=========== MARKET HALL (roof) ===========] <ramp  |
	   |        |door|             |door|              open end      |
	   | [SPAWN]   wall   pillar   /[PLAZA]\\   pillar   wall  [SPAWN]|
	   |  roof     wall           \\[centre]/            wall    roof |
	   |  ramp> [CONTAINER] crates  tall wall   crates [CONTAINER]  |
	   +------------------------------------------------------------+

	Only solid shapes collide; trims and floor markings are decor.
]]

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local P = Config.Palette
local C = Config.MapPalette
local V = Vector3.new

local ArenaCrossfire = {}

local LENGTH, WIDTH = 170, 120 -- floor size (X, Z)
local WALL_HEIGHT = 28

function ArenaCrossfire.Build(b)
	local X, Z, XZ = "X", "Z", "XZ"
	local halfL, halfW = LENGTH / 2, WIDTH / 2

	-- FLOOR + BOUNDARY -------------------------------------------------------
	b.block(V(LENGTH + 10, 4, WIDTH + 10), V(0, -2, 0), C.Sidewalk)
	b.block(V(LENGTH + 10, WALL_HEIGHT, 4), V(0, WALL_HEIGHT / 2, halfW + 2), C.BuildingB, Z)
	b.block(V(4, WALL_HEIGHT, WIDTH + 10), V(halfL + 2, WALL_HEIGHT / 2, 0), C.BuildingB, X)
	b.decor(function()
		b.block(V(LENGTH + 10, 1, 4.6), V(0, WALL_HEIGHT + 0.5, halfW + 2), P.AccentB, Z)
		b.block(V(4.6, 1, WIDTH + 10), V(halfL + 2, WALL_HEIGHT + 0.5, 0), P.AccentB, X)
		b.block(V(LENGTH, 1.2, 0.6), V(0, 0.6, halfW - 0.3), C.Trim, Z) -- skirting
		b.block(V(0.6, 1.2, WIDTH), V(halfL - 0.3, 0.6, 0), C.Trim, X)
		-- lane markings
		b.block(V(1, 0.06, WIDTH - 20), V(0, 0.03, 0), P.AccentB)
		b.block(V(LENGTH - 40, 0.06, 0.6), V(0, 0.03, 30), C.Curb, Z)
	end)

	-- SPAWN BUILDINGS (walkable roof, stairs on both sides) --------------------
	b.block(V(20, 12, 2), V(-74, 6, 15), C.BuildingA, XZ) -- side walls
	b.block(V(2, 12, 2), V(-65, 6, 7.5), C.BuildingA, XZ) -- front pillars
	b.block(V(21, 1.5, 32), V(-74.5, 12.75, 0), C.Roof, X) -- roof
	b.block(V(1, 2.5, 11), V(-64.5, 14.75, 10.5), C.BuildingA, XZ) -- roof cover (gap in the middle)
	b.ramp(V(-62, 0, 18), V(-1, 0, 0), 18, 13.5, 4, P.AccentA, XZ) -- stairs up to the roof
	b.decor(function()
		-- team-coloured floor and roof trim
		b.block(V(19, 0.08, 28), V(-74, 0.04, 0), P.PlayerA)
		b.block(V(19, 0.08, 28), V(74, 0.04, 0), P.PlayerB)
		b.block(V(21.4, 0.6, 32.4), V(-74.5, 13.8, 0), P.AccentB, X)
		b.block(V(0.4, 1.2, 12), V(-64.1, 10.4, 0), P.PlayerA) -- sign over the door
		b.block(V(0.4, 1.2, 12), V(64.1, 10.4, 0), P.PlayerB)
	end)
	b.block(V(4, 4, 4), V(-56, 2, 10), C.Wood, XZ) -- crates outside the door

	-- CENTRE PLAZA ---------------------------------------------------------------
	b.block(V(26, 3, 26), V(0, 1.5, 0), C.Stone)
	b.ramp(V(-21, 0, 0), V(1, 0, 0), 8, 3, 14, C.Stone, X)
	b.ramp(V(0, 0, -21), V(0, 0, 1), 8, 3, 14, C.Stone, Z)
	b.block(V(5, 8, 9), V(0, 7, 0), C.BuildingA) -- centrepiece (blocks the spawn-to-spawn line)
	b.block(V(6, 7, 1.5), V(-8, 6.5, 9), P.AccentA, XZ) -- walls on the plaza
	b.decor(function()
		b.block(V(26.4, 0.4, 26.4), V(0, 3.1, 0), C.Trim)
		b.block(V(5.6, 0.6, 9.6), V(0, 11.2, 0), P.AccentB)
		b.block(V(5.2, 1, 9.2), V(0, 3.5, 0), C.Trim)
	end)

	-- MID COVER --------------------------------------------------------------
	b.block(V(1.5, 14, 12), V(-38, 7, 14), C.BuildingA, XZ) -- tall walls
	b.block(V(4, 14, 4), V(-30, 7, 0), C.BuildingA, X) -- tall pillars
	b.decor(function()
		b.block(V(1.9, 0.5, 12.4), V(-38, 14.25, 14), P.AccentB, XZ)
		b.block(V(4.4, 0.6, 4.4), V(-30, 14.3, 0), P.AccentB, X)
	end)

	-- NORTH: MARKET HALL (close range inside, walkable roof) -------------------
	-- south wall with two doorways
	b.block(V(15, 10, 1), V(-22.5, 5, 40.5), C.BuildingA, X)
	b.block(V(18, 10, 1), V(0, 5, 40.5), C.BuildingA)
	b.block(V(6, 3, 1), V(-12, 8.5, 40.5), C.BuildingA, X) -- over the doors
	-- end walls: solid at the front, open at the back
	b.block(V(1, 10, 10), V(-30.5, 5, 45), C.BuildingA, X)
	b.block(V(1, 3, 8), V(-30.5, 8.5, 54), C.BuildingA, X)
	b.block(V(61, 1.5, 18.5), V(0, 10.75, 49.25), C.Roof) -- roof
	b.block(V(8, 2.5, 1), V(-12, 12.75, 40.75), P.AccentA, X) -- cover on the roof edge
	b.ramp(V(-48, 0, 45), V(1, 0, 0), 17, 11.5, 6, P.AccentA, X) -- ramp up to the roof
	b.block(V(4, 4, 4), V(-18, 2, 52), C.Wood, X) -- crates inside
	b.block(V(3, 3, 3), V(-6, 1.5, 47), C.Wood, X)
	b.decor(function()
		b.block(V(61.4, 0.6, 18.9), V(0, 11.8, 49.25), P.AccentB)
		b.block(V(60, 1.2, 1.2), V(0, 9.4, 39.9), P.AccentA) -- awning strip
		for x = -27, 27, 6 do
			b.block(V(0.3, 2, 0.4), V(x, 5.5, 39.8), C.Trim) -- window bars on the wall
		end
	end)

	-- SOUTH: CONTAINER YARD -------------------------------------------------------
	b.block(V(20, 8.5, 8), V(-28, 4.25, -46), C.Awning[2], X) -- container
	b.ramp(V(-52, 0, -46), V(1, 0, 0), 14, 8.5, 6, P.AccentA, X) -- ramp onto it
	b.block(V(4, 4, 4), V(-12, 2, -44), C.Wood, X) -- crates
	b.block(V(3, 3, 3), V(-8, 1.5, -51), C.Wood, X)
	b.block(V(12, 12, 1.5), V(0, 6, -40), C.BuildingA) -- tall wall in the middle of the yard
	b.block(V(8, 8.5, 16), V(-60, 4.25, -46), C.Awning[1], X) -- container by the spawn
	b.decor(function()
		for k = -4, 4 do
			b.block(V(0.4, 7.6, 8.1), V(-28 + k * 2.2, 4.25, -46), C.Dark:Lerp(C.Awning[2], 0.6), X) -- ribs
		end
		for k = -3, 3 do
			b.block(V(8.1, 7.6, 0.4), V(-60, 4.25, -46 + k * 2.2), C.Dark:Lerp(C.Awning[1], 0.6), X)
		end
		b.block(V(20.1, 0.5, 8.1), V(-28, 8.3, -46), C.Trim, X)
		b.block(V(8.1, 0.5, 16.1), V(-60, 8.3, -46), C.Trim, X)
		b.block(V(12.4, 0.5, 1.9), V(0, 12.25, -40), P.AccentB)
	end)

	-- Spawns (inside the spawn buildings, facing the middle)
	local spawnHeight = 3.2
	local spawns = {
		CFrame.lookAt(V(-76, spawnHeight, 0), V(0, spawnHeight, 0)),
		CFrame.lookAt(V(76, spawnHeight, 0), V(0, spawnHeight, 0)),
	}

	-- Practice dummies for the Playground (Position = the ground under them)
	local dummies = {
		{ Position = V(0, 3, 8), Face = V(-1, 0, 0) },
		{ Position = V(-74, 13.5, 4), Face = V(1, 0, 0) },
		{ Position = V(12, 11.5, 50), Face = V(0, 0, -1) },
		{ Position = V(-28, 8.5, -46), Face = V(1, 0, 0) },
		{ Position = V(10, 0, 48), Face = V(-1, 0, 0) },
		{ Position = V(-45, 0, 25), Motion = "Strafe", Amount = 8, Speed = 0.3, Face = V(1, 0, 0) },
		{ Position = V(45, 0, -25), Motion = "Strafe", Amount = 8, Speed = 0.3, Face = V(-1, 0, 0) },
		{ Position = V(20, 0, -30), Motion = "Bob", Amount = 6, Speed = 0.5, Face = V(-1, 0, 0) },
	}
	return spawns, dummies
end

return ArenaCrossfire
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">ArenaDowntown</string>
          <string name="Source"><![CDATA[--[[
	ArenaDowntown.lua  (ServerScriptService.Server.ArenaDowntown)

	"Downtown": a detailed city block built from flat-coloured parts.
	The map is mirrored across X = 0, so both spawns are identical.

	LAYOUT (top view, X = long axis, spawns at the far left / right)

	        N  skyline (perimeter buildings)
	   [Apartments]-catwalk-[Office tower]   [CITY HALL + clock tower]   (mirrored)
	   ==== sidewalk / lamps / trees ==========================================
	   SPAWN  >>>  bus, cars, barriers  >>>  PLAZA + FOUNTAIN  <<<  ...  SPAWN
	   ==== sidewalk ===========================================================
	   [park + billboard]                                     [park]
	   ===== ELEVATED TRAIN TRACK (parked train in the middle) =====  (stairs up at both ends)
	   [parking lot]   [market stalls]   [shop]
	        S  skyline

	Sightlines: the avenue (long, broken up by the bus/cars/fountain), the
	train deck (long, broken by the train), rooftops (high ground).
	Verticality: steel fire escapes up the apartments (24), office tower (48)
	and city hall (26), the clock tower (55), the train deck (22) and the
	train roof. Wall runs: building faces, the bus, the train, billboards.

	DETAIL vs COLLISION
	  Buildings are a solid box; pilasters, window frames, glass, cornices,
	  storefronts and signs are detail parts (builder.decor) that don't
	  collide or stop bullets, so walls stay flat and clean to wall run on
	  and nothing snags you. Fire escapes and stairs are an invisible smooth
	  ramp under the visible steps, with invisible railing walls so you
	  can't fall off the landings. Car bodies collide; their trim doesn't.
	  Tree leaves (builder.soft) block bullets and sight but not movement.

	Colours come from Config.MapPalette.
]]

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local C = Config.MapPalette
local P = Config.Palette
local V = Vector3.new
local rad = math.rad

local ArenaDowntown = {}

----------------------------------------------------------------------------
-- SMALL HELPERS
----------------------------------------------------------------------------

-- A bar from point a to point c (w wide, h tall), e.g. a handrail.
local function bar(b, a, c, w, h, color, m)
	return b.part(V(w, h, (c - a).Magnitude), CFrame.lookAt((a + c) / 2, c), color, m)
end

-- Invisible wall that only blocks players (not bullets, not raycasts).
local function playerWall(b, size, pos, m)
	local parts = b.invisible(b.block(size, pos, C.Metal, m))
	for _, part in ipairs(parts) do
		part.CanQuery = false
	end
	return parts
end

local function neon(b, parts)
	return b.material(parts, Enum.Material.Neon)
end

local function glass(b, parts)
	return b.material(parts, Enum.Material.SmoothPlastic, 0.18)
end

----------------------------------------------------------------------------
-- STAIRS (concrete or steel): an invisible ramp you walk on + real steps
----------------------------------------------------------------------------
--[[
	lowPoint: centre of the bottom edge (on the ground), dir: the way it
	climbs, length/height/width in studs.
	options.Solid   concrete steps filled down to the ground (default: steel treads)
	options.Rails   handrails on both sides (default true)
]]
local function stairs(b, lowPoint, dir, length, height, width, color, m, options)
	options = options or {}
	dir = V(dir.X, 0, dir.Z).Unit
	local side = V(-dir.Z, 0, dir.X)
	b.invisible(b.ramp(lowPoint, dir, length, height, width, color, m))

	local count = math.max(3, math.floor(height / 0.8 + 0.5))
	local run, rise = length / count, height / count
	local look = CFrame.lookAt(Vector3.zero, dir)
	b.decor(function()
		for j = 0, count - 1 do
			local along = lowPoint + dir * ((j + 0.5) * run)
			if options.Solid then
				local h = (j + 1) * rise
				b.part(V(width, h, run + 0.02), CFrame.new(along + V(0, h / 2, 0)) * look, color, m)
				b.part(V(width + 0.02, 0.12, 0.3), CFrame.new(along + dir * (run / 2 - 0.15) + V(0, h - 0.06, 0)) * look, C.Trim, m) -- nosing
			else
				local top = (j + 1) * rise
				b.part(V(width - 0.3, 0.25, run + 0.05), CFrame.new(along + V(0, top - 0.125, 0)) * look, color, m)
			end
		end
		local top = lowPoint + dir * length + V(0, height, 0)
		for _, s in ipairs({ -1, 1 }) do
			local edge = side * s * (width / 2)
			-- side stringer / cheek wall
			bar(b, lowPoint + edge + V(0, 0.1, 0), top + edge + V(0, 0.1, 0), 0.3, options.Solid and 1.4 or 0.9, options.Solid and C.Concrete or C.Dark, m)
			if options.Rails ~= false then
				local railLow = lowPoint + edge + V(0, 3.2, 0)
				local railTop = top + edge + V(0, 3.2, 0)
				bar(b, railLow, railTop, 0.22, 0.22, C.Dark, m)
				for t = 0, 1, 0.5 do
					local post = lowPoint:Lerp(top, t) + edge
					b.block(V(0.2, 3.2, 0.2), post + V(0, 1.6, 0), C.Dark, m)
				end
			end
		end
	end)
end

----------------------------------------------------------------------------
-- BUILDINGS
----------------------------------------------------------------------------

-- Position on a building face. u = along the face, out = distance out from the wall.
local function facePos(bd, face, u, y, out)
	if face == "N" then
		return V(bd.cx + u, y, bd.cz + bd.d / 2 + out)
	elseif face == "S" then
		return V(bd.cx + u, y, bd.cz - bd.d / 2 - out)
	elseif face == "E" then
		return V(bd.cx + bd.w / 2 + out, y, bd.cz + u)
	end
	return V(bd.cx - bd.w / 2 - out, y, bd.cz + u)
end

-- Size of a slab on a face: `along` the face, `height` tall, `thick` out from it.
local function faceSize(face, along, height, thick)
	if face == "N" or face == "S" then
		return V(along, height, thick)
	end
	return V(thick, height, along)
end

local function faceNormal(face)
	return ({ N = V(0, 0, 1), S = V(0, 0, -1), E = V(1, 0, 0), W = V(-1, 0, 0) })[face]
end

-- Shop fronts across the ground floor of one face: big glass windows, a
-- door, a sign band with "lettering" and striped awnings.
local function storefront(b, bd, face, count, start, spacing, m, seed)
	local n = faceNormal(face)
	local span = (count) * spacing
	b.block(faceSize(face, span + 1, 1.8, 0.7), facePos(bd, face, 0, 9.4, 0.35), C.Dark, m) -- sign band
	for i = 0, count - 1 do
		local u = start + i * spacing
		local isDoor = i == math.floor(count / 2)
		b.block(faceSize(face, spacing - 1.1, 6.6, 0.16), facePos(bd, face, u, 4.9, 0.08), C.FrameDark, m) -- frame
		if isDoor then
			b.block(faceSize(face, 3.4, 6.2, 0.3), facePos(bd, face, u, 4.7, 0.15), C.Dark, m)
			glass(b, b.block(faceSize(face, 2.6, 4, 0.34), facePos(bd, face, u, 5.2, 0.17), C.Glass, m))
			b.block(faceSize(face, 0.25, 0.9, 0.5), facePos(bd, face, u + 0.9, 4.2, 0.4), C.Rim, m) -- handle
		else
			glass(b, b.block(faceSize(face, spacing - 1.8, 5.6, 0.2), facePos(bd, face, u, 4.9, 0.14), C.Glass, m))
			b.block(faceSize(face, spacing - 1.8, 0.25, 0.3), facePos(bd, face, u, 6.3, 0.2), C.FrameDark, m) -- transom bar
			b.block(faceSize(face, spacing - 1, 0.6, 0.9), facePos(bd, face, u, 1.9, 0.45), C.Stone, m) -- stall riser
		end
		-- awning (sloping down and out)
		local awning = C.Awning[((seed + i) % #C.Awning) + 1]
		local pos = facePos(bd, face, u, 8.1, 1.7)
		local frame = CFrame.lookAt(pos, pos + n) * CFrame.Angles(rad(-22), 0, 0)
		b.part(V(spacing - 1.2, 0.3, 3.6), frame, awning, m)
		b.part(V(spacing - 1.2, 0.8, 0.15), frame * CFrame.new(0, -0.45, -1.8), C.RoadWhite, m) -- valance
		-- lettering on the sign band
		local letters = 2 + (seed + i) % 3
		for k = 1, letters do
			local lu = u - (letters - 1) * 0.8 + (k - 1) * 1.6
			neon(b, b.block(faceSize(face, 1.1, 0.9, 0.2), facePos(bd, face, lu, 9.4, 0.75), k == 1 and awning or C.LampLight, m))
		end
	end
end

-- Windows, pilasters and ledges on one face.
local function facade(b, bd, face, h, accent, m, options)
	local span = (face == "N" or face == "S") and bd.w or bd.d
	local spacing = options.WindowSpacing or 7
	local fh = options.FloorHeight or 8
	local count = math.floor((span - 6) / spacing)
	if count < 1 then
		return
	end
	local start = -(count - 1) * spacing / 2
	local floors = math.floor((h - 6) / fh)
	local shop = options.Storefront and table.find(options.Storefront, face) ~= nil
	local frameColor = C.FrameDark

	-- pilasters between the window bays (they give the wall its depth)
	for j = 0, count do
		local u = start + (j - 0.5) * spacing
		b.block(faceSize(face, 1.3, h - 1.6, 0.9), facePos(bd, face, u, 1.6 + (h - 1.6) / 2, 0.45), accent, m)
	end

	if shop then
		storefront(b, bd, face, count, start, spacing, m, math.floor(bd.cx + bd.cz) % 3)
	end

	for f = shop and 1 or 0, floors - 1 do
		local y = 6 + f * fh
		-- ledge under each floor of windows
		b.block(faceSize(face, count * spacing + 1.6, 0.5, 0.7), facePos(bd, face, 0, y - 2.5, 0.35), accent, m)
		if options.Simple then
			-- far buildings: one ribbon of glass per floor
			glass(b, b.block(faceSize(face, count * spacing - 0.4, 4, 0.2), facePos(bd, face, 0, y, 0.1), C.Window, m))
		else
			for i = 0, count - 1 do
				local u = start + i * spacing
				local lit = ((i * 7 + f * 3 + #face) % 5) == 0
				b.block(faceSize(face, 3.7, 4.7, 0.12), facePos(bd, face, u, y, 0.06), frameColor, m) -- frame
				glass(b, b.block(faceSize(face, 3.1, 4.1, 0.12), facePos(bd, face, u, y, 0.12), lit and C.WindowLit or C.Window, m))
				b.block(faceSize(face, 0.22, 4.1, 0.12), facePos(bd, face, u, y, 0.22), frameColor, m) -- mullion
				b.block(faceSize(face, 4.3, 0.5, 0.45), facePos(bd, face, u, y + 2.6, 0.22), accent, m) -- lintel
				b.block(faceSize(face, 4, 0.3, 0.8), facePos(bd, face, u, y - 2.25, 0.4), accent, m) -- sill
			end
		end
	end
end

--[[
	A building: solid box + roof + parapet (all collide), plus detail.
	faces: which faces ("N","S","E","W") get windows.
	options: WindowSpacing, FloorHeight, NoParapet, Simple (ribbon windows),
	         Storefront = { faces with shops on the ground floor }
]]
local function building(b, cx, cz, w, d, h, color, faces, m, options)
	options = options or {}
	local bd = { cx = cx, cz = cz, w = w, d = d }
	local accent = color:Lerp(C.Stone, 0.35)

	-- SOLID
	b.block(V(w, h, d), V(cx, h / 2, cz), color, m)
	b.block(V(w + 0.8, 0.8, d + 0.8), V(cx, h + 0.4, cz), C.Roof, m)
	if not options.NoParapet then
		b.block(V(w + 0.8, 1.6, 0.8), V(cx, h + 1.6, cz + d / 2), color, m)
		b.block(V(w + 0.8, 1.6, 0.8), V(cx, h + 1.6, cz - d / 2), color, m)
		b.block(V(0.8, 1.6, d - 0.8), V(cx + w / 2, h + 1.6, cz), color, m)
		b.block(V(0.8, 1.6, d - 0.8), V(cx - w / 2, h + 1.6, cz), color, m)
	end

	-- DETAIL
	b.decor(function()
		b.block(V(w + 1, 1.6, d + 1), V(cx, 0.8, cz), C.Trim, m) -- plinth
		-- two-step cornice under the roof edge
		b.block(V(w + 2.2, 0.7, d + 2.2), V(cx, h - 0.35, cz), accent, m)
		b.block(V(w + 1.4, 0.6, d + 1.4), V(cx, h - 1.0, cz), C.Trim, m)
		if not options.NoParapet then
			b.block(V(w + 1.3, 0.3, 1.3), V(cx, h + 2.55, cz + d / 2), C.Stone, m) -- coping
			b.block(V(w + 1.3, 0.3, 1.3), V(cx, h + 2.55, cz - d / 2), C.Stone, m)
			b.block(V(1.3, 0.3, d - 1.3), V(cx + w / 2, h + 2.55, cz), C.Stone, m)
			b.block(V(1.3, 0.3, d - 1.3), V(cx - w / 2, h + 2.55, cz), C.Stone, m)
		end
		-- belt courses every few floors
		for y = 18, h - 8, 24 do
			b.block(V(w + 1.2, 0.7, d + 1.2), V(cx, y, cz), C.Trim, m)
		end
		for _, face in ipairs(faces or {}) do
			facade(b, bd, face, h, accent, m, options)
		end
	end)
end

-- Rooftop clutter: stair bulkhead with a door, vents and pipes.
local function rooftop(b, x, z, h, m, flip)
	local s = flip and -1 or 1
	b.block(V(7, 5, 6), V(x, h + 3.3, z), C.Concrete, m) -- bulkhead (solid cover)
	b.decor(function()
		b.block(V(7.6, 0.5, 6.6), V(x, h + 6, z), C.Roof, m)
		b.block(V(2.8, 4, 0.2), V(x, h + 2.8, z + s * 3.05), C.Dark, m) -- door
		b.cylinder(3, 1, V(x + 6, h + 2.3, z - 2), C.Metal, m) -- vent stack
		b.cylinder(0.4, 1.6, V(x + 6, h + 3.9, z - 2), C.Dark, m)
		b.cylinder(1.6, 0.8, V(x - 5.5, h + 1.6, z + 3), C.Metal, m)
		b.block(V(10, 0.5, 0.5), V(x + 1, h + 1.25, z - 4.5), C.Metal, m) -- pipe run
	end)
end

local function acUnit(b, pos, m)
	b.block(V(4, 2.4, 3), pos + V(0, 1.2, 0), C.Metal, m)
	b.decor(function()
		b.cylinder(0.3, 2.2, pos + V(0, 2.55, 0), C.Dark, m)
		for k = -1, 1 do
			b.block(V(4.05, 0.15, 3.05), pos + V(0, 1.2 + k * 0.5, 0), C.Trim, m) -- grille slats
		end
	end)
end

local function waterTower(b, pos, m)
	b.decor(function()
		for _, o in ipairs({ V(2.6, 0, 2.6), V(-2.6, 0, 2.6), V(2.6, 0, -2.6), V(-2.6, 0, -2.6) }) do
			b.block(V(0.6, 8, 0.6), pos + o + V(0, 4, 0), C.Dark, m)
		end
		bar(b, pos + V(-2.6, 1, 2.6), pos + V(2.6, 7, 2.6), 0.3, 0.3, C.Dark, m) -- cross bracing
		bar(b, pos + V(-2.6, 1, -2.6), pos + V(2.6, 7, -2.6), 0.3, 0.3, C.Dark, m)
		b.cylinder(0.3, 7.6, pos + V(0, 8, 0), C.Dark, m)
	end)
	b.cylinder(7, 7.5, pos + V(0, 11.5, 0), C.Wood, m)
	b.decor(function()
		for y = 9, 14, 2.5 do
			b.cylinder(0.25, 7.7, pos + V(0, y, 0), C.Dark, m) -- hoops
		end
		b.cylinder(0.6, 8.2, pos + V(0, 15.3, 0), C.Trim, m)
		b.cylinder(1.2, 4, pos + V(0, 16.2, 0), C.Trim, m)
	end)
end

local function antenna(b, pos, height, m)
	b.decor(function()
		b.cylinder(height, 0.4, pos + V(0, height / 2, 0), C.Metal, m)
		b.block(V(3, 0.2, 0.2), pos + V(0, height * 0.7, 0), C.Metal, m)
		b.block(V(0.2, 0.2, 2.4), pos + V(0, height * 0.55, 0), C.Metal, m)
		neon(b, b.ball(0.9, pos + V(0, height, 0), P.PlayerB, m))
	end)
end

----------------------------------------------------------------------------
-- FIRE ESCAPE (steel switchback stairs on the side of a building)
----------------------------------------------------------------------------
--[[
	origin  : point on the wall (Y ignored) where it starts
	outward : unit vector away from the wall
	lateral : unit vector along the wall (the direction it extends)
	levels  : number of landings above the ground; rise = height per level

	Two lanes 3 studs wide sit side by side out from the wall. Flights
	alternate lanes (outer going +lateral, inner coming back), each landing
	has a hole above the flight that arrives there, so you can always run
	straight up. options.Extend lengthens the landings; options.Gap =
	{ Level, Center, Width } leaves an opening in the outer railing (for the
	catwalk between buildings).
]]
local function fireEscape(b, origin, outward, lateral, levels, rise, m, options)
	options = options or {}
	local run = rise * 1.3
	local length = run + 4 + (options.Extend or 0)
	local base = V(origin.X, 0, origin.Z)
	local alongX = math.abs(lateral.X) > 0.5
	local INNER, OUTER = 1.5, 4.5

	local function at(s, d, y)
		return base + lateral * s + outward * d + V(0, y, 0)
	end
	-- a box `sl` long along the wall, `h` tall, `sd` deep out from the wall
	local function size(sl, h, sd)
		return alongX and V(sl, h, sd) or V(sd, h, sl)
	end
	local function plate(s0, s1, lane, y)
		if s1 - s0 > 0.05 then
			b.block(size(s1 - s0, 0.4, 3), at((s0 + s1) / 2, lane, y - 0.2), C.Metal, m)
		end
	end

	for i = 0, levels - 1 do
		local y0 = rise * i
		local outerLane = i % 2 == 0
		local lane = outerLane and OUTER or INNER
		local s0 = outerLane and 2 or 2 + run
		local dir = outerLane and lateral or -lateral
		b.invisible(b.ramp(at(s0, lane, y0), dir, run, rise, 3, C.Metal, m))

		-- steel treads + stringers + handrail you actually see
		b.decor(function()
			local count = math.max(5, math.floor(rise / 0.75 + 0.5))
			for j = 0, count - 1 do
				local s = s0 + (outerLane and 1 or -1) * (j + 0.5) * run / count
				b.block(size(run / count + 0.04, 0.22, 2.7), at(s, lane, y0 + (j + 1) * rise / count - 0.11), C.Metal, m)
			end
			local sTop = s0 + (outerLane and run or -run)
			for _, d in ipairs({ lane - 1.45, lane + 1.45 }) do
				bar(b, at(s0, d, y0 - 0.1), at(sTop, d, y0 + rise - 0.1), 0.2, 0.8, C.Dark, m)
			end
			local railSide = outerLane and OUTER + 1.45 or INNER + 1.45
			bar(b, at(s0, railSide, y0 + 3), at(sTop, railSide, y0 + rise + 3), 0.18, 0.18, C.Dark, m)
			b.block(V(0.18, 3, 0.18), at(s0, railSide, y0 + 1.5), C.Dark, m)
		end)
	end

	for k = 1, levels do
		local y = rise * k
		-- the flight that arrives here needs a hole above it
		local arrivingOuter = (k - 1) % 2 == 0
		for _, lane in ipairs({ INNER, OUTER }) do
			if (lane == OUTER) == arrivingOuter then
				plate(0, 2, lane, y)
				plate(2 + run, length, lane, y)
			else
				plate(0, length, lane, y)
			end
		end

		-- railings: invisible walls you can't fall through + visible rails
		local gap = options.Gap and options.Gap.Level == k and options.Gap or nil
		local segments = { { 0, length } }
		if gap then
			segments = { { 0, gap.Center - gap.Width / 2 }, { gap.Center + gap.Width / 2, length } }
		end
		for _, seg in ipairs(segments) do
			local s0, s1 = seg[1], seg[2]
			if s1 - s0 > 0.2 then
				playerWall(b, size(s1 - s0, 3.4, 0.3), at((s0 + s1) / 2, 6.15, y + 1.7), m)
				b.decor(function()
					b.block(size(s1 - s0, 0.2, 0.2), at((s0 + s1) / 2, 6.1, y + 3.2), C.Dark, m)
					b.block(size(s1 - s0, 0.15, 0.15), at((s0 + s1) / 2, 6.1, y + 1.7), C.Dark, m)
					for s = s0, s1 + 0.01, 2.4 do
						b.block(V(0.18, 3.2, 0.18), at(s, 6.1, y + 1.6), C.Dark, m)
					end
				end)
			end
		end
		for _, s in ipairs({ -0.15, length + 0.15 }) do
			playerWall(b, size(0.3, 3.4, 6), at(s, 3, y + 1.7), m)
			b.decor(function()
				b.block(size(0.2, 0.2, 6), at(s, 3, y + 3.2), C.Dark, m)
			end)
		end

		-- brackets bolting the landing to the wall + an edge band
		b.decor(function()
			for _, s in ipairs({ 1, length - 1 }) do
				bar(b, at(s, 0.2, y - 3.2), at(s, 5.6, y - 0.45), 0.3, 0.3, C.Dark, m)
			end
			b.block(size(length, 0.5, 0.15), at(length / 2, 6.0, y - 0.2), C.Dark, m)
		end)
	end
end

----------------------------------------------------------------------------
-- STREET PROPS
----------------------------------------------------------------------------

-- Billboard on two legs (the board is solid: wall-runnable).
local function billboard(b, pos, width, height, legHeight, color, m)
	b.block(V(0.8, legHeight, 0.8), pos + V(-width / 2 + 2, legHeight / 2, 0), C.Metal, m)
	b.block(V(0.8, legHeight, 0.8), pos + V(width / 2 - 2, legHeight / 2, 0), C.Metal, m)
	b.block(V(width, height, 1.2), pos + V(0, legHeight + height / 2, 0), C.Dark, m)
	b.decor(function()
		b.block(V(width - 1.6, height - 1.6, 1.4), pos + V(0, legHeight + height / 2, 0), color, m)
		b.block(V(width * 0.5, 1.2, 1.5), pos + V(-width * 0.12, legHeight + height * 0.62, 0), C.RoadWhite, m)
		b.block(V(width * 0.3, 1.2, 1.5), pos + V(-width * 0.22, legHeight + height * 0.38, 0), C.RoadWhite, m)
		b.ball(height * 0.45, pos + V(width * 0.3, legHeight + height / 2, 0), C.RoadWhite, m)
		-- catwalk + spot lamps along the bottom
		b.block(V(width, 0.3, 2), pos + V(0, legHeight - 0.1, 0), C.Metal, m)
		for x = -width / 2 + 3, width / 2 - 3, (width - 6) / 3 do
			b.block(V(0.3, 1.2, 0.3), pos + V(x, legHeight + 0.5, -1.2), C.Dark, m)
			neon(b, b.block(V(0.8, 0.4, 0.5), pos + V(x, legHeight + 1.2, -1.4), C.LampLight, m))
		end
	end)
end

local function lamp(b, pos, armDir, m, banner)
	b.cylinder(13, 0.5, pos + V(0, 6.5, 0), C.Metal, m)
	b.decor(function()
		b.cylinder(1.4, 1.2, pos + V(0, 0.7, 0), C.Dark, m) -- base
		b.cylinder(0.3, 0.8, pos + V(0, 1.5, 0), C.Metal, m)
		b.cylinder(0.5, 0.7, pos + V(0, 13.1, 0), C.Dark, m)
		local root = pos + V(0, 12.7, 0)
		local tip = root + armDir * 3.4 + V(0, 0.5, 0)
		bar(b, root, tip, 0.25, 0.25, C.Metal, m)
		b.part(V(1.7, 0.5, 2.6), CFrame.lookAt(tip + armDir * 0.6, tip + armDir * 2), C.Dark, m)
		neon(b, b.part(V(1.2, 0.15, 2), CFrame.lookAt(tip + armDir * 0.6 - V(0, 0.3, 0), tip + armDir * 2), C.LampLight, m))
		if banner then
			local bp = pos + V(0, 9, 0) + armDir * 0.85
			b.part(V(0.12, 3, 1.3), CFrame.lookAt(bp, bp + armDir) * CFrame.Angles(0, rad(90), 0), banner, m)
		end
	end)
end

-- Variety for trees: rotate the leaf clusters by a stable per-tree angle.
local LEAVES = {
	{ V(0, 9.6, 0), 7.6, "Foliage" },
	{ V(2.7, 8.4, 1.3), 5.6, "FoliageDark" },
	{ V(-2.6, 8.7, -1.5), 5.8, "Foliage" },
	{ V(1.2, 11.4, -1.9), 5.2, "FoliageLight" },
	{ V(-1.5, 11.2, 1.9), 4.9, "FoliageLight" },
	{ V(0.3, 12.8, 0.2), 4.2, "FoliageLight" },
	{ V(-3, 7.4, 1.9), 4.4, "FoliageDark" },
	{ V(3, 7.3, -2.1), 4.2, "FoliageDark" },
}

local function tree(b, pos, scale, m)
	scale = scale or 1
	local spin = CFrame.Angles(0, (pos.X * 0.37 + pos.Z * 0.61) % (math.pi * 2), 0)
	b.block(V(5, 1.2, 5), pos + V(0, 0.6, 0), C.Curb, m) -- planter
	b.cylinder(6 * scale, 1.2 * scale, pos + V(0, 1.2 + 3 * scale, 0), C.Trunk, m) -- trunk
	b.decor(function()
		b.block(V(4.3, 0.2, 4.3), pos + V(0, 1.25, 0), C.Soil, m)
		b.block(V(5.3, 0.3, 5.3), pos + V(0, 1.15, 0), C.Concrete, m) -- planter lip
		b.cylinder(3.5 * scale, 0.85 * scale, pos + V(0, 1.2 + 7.5 * scale, 0), C.Trunk, m)
		-- branches
		for k = 0, 2 do
			local a = k * 2.1
			local from = pos + V(0, 1.2 + 5.2 * scale, 0)
			local to = from + (spin * CFrame.Angles(0, a, 0)).LookVector * 2.6 * scale + V(0, 2.6 * scale, 0)
			bar(b, from, to, 0.45 * scale, 0.45 * scale, C.Trunk, m)
		end
	end)
	b.soft(function()
		for _, leaf in ipairs(LEAVES) do
			local offset = (spin * CFrame.new(leaf[1])).Position * scale
			b.ball(leaf[2] * scale, pos + offset, C[leaf[3]], m)
		end
	end)
end

local function wheel(b, cf, diameter, width, m)
	b.cylinder(width, diameter, nil, C.Tire, m, cf)
	b.cylinder(width + 0.06, diameter * 0.55, nil, C.Rim, m, cf)
	b.cylinder(width + 0.1, diameter * 0.18, nil, C.Trim, m, cf)
end

-- A parked car. cf = position on the ground + facing (the front is -Z).
-- style: nil (sedan) or "Taxi" (roof sign).
local function car(b, cf, color, m, style)
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	-- SOLID: lower body + cabin
	b.part(V(4.6, 1.5, 10.2), at(0, 1.55, 0), color, m)
	b.invisible(b.part(V(4.1, 1.8, 4.8), at(0, 3.2, 0.5), color, m))

	b.decor(function()
		-- shape: hood and trunk lids, rocker panels, bumpers
		b.part(V(4.4, 0.25, 3.1), at(0, 2.4, -3.6), color, m)
		b.part(V(4.4, 0.25, 2.3), at(0, 2.4, 4), color, m)
		b.part(V(4.7, 0.4, 7.6), at(0, 0.95, 0), C.Dark, m)
		b.part(V(4.8, 0.6, 0.5), at(0, 1.2, -5.2), C.Trim, m)
		b.part(V(4.8, 0.6, 0.5), at(0, 1.2, 5.2), C.Trim, m)
		b.part(V(2.2, 0.5, 0.1), at(0, 1.9, -5.12), C.Dark, m) -- grille
		b.part(V(1.3, 0.45, 0.08), at(0, 1.2, -5.47), C.RoadWhite, m) -- plates
		b.part(V(1.3, 0.45, 0.08), at(0, 1.2, 5.47), C.RoadWhite, m)
		for _, x in ipairs({ -1.65, 1.65 }) do
			neon(b, b.part(V(1.05, 0.4, 0.1), at(x, 1.95, -5.12), C.LampLight, m))
			neon(b, b.part(V(1.1, 0.4, 0.1), at(x, 1.95, 5.12), C.TailLight, m))
		end
		-- cabin: sloped windscreen + rear window, roof, side glass, pillar
		glass(b, b.place("WedgePart", V(4, 1.6, 1.5), at(0, 3.1, -2.05), C.Glass, m))
		glass(b, b.place("WedgePart", V(4, 1.6, 1.3), at(0, 3.1, 2.95) * CFrame.Angles(0, math.pi, 0), C.Glass, m))
		b.part(V(4.1, 0.3, 3.6), at(0, 4.05, 0.5), color, m)
		glass(b, b.part(V(4.12, 1.45, 3.6), at(0, 3.15, 0.5), C.Glass, m))
		b.part(V(4.2, 1.5, 0.35), at(0, 3.15, 0.45), color, m)
		-- door seams, handles, mirrors
		for _, z in ipairs({ -1.25, 2.1 }) do
			b.part(V(4.64, 1.2, 0.08), at(0, 1.65, z), C.Dark, m)
		end
		for _, z in ipairs({ -0.4, 2.6 }) do
			b.part(V(4.66, 0.15, 0.55), at(0, 2.05, z), C.Rim, m)
		end
		for _, x in ipairs({ -2.45, 2.45 }) do
			b.part(V(0.45, 0.35, 0.5), at(x, 2.75, -1.7), color, m)
		end
		-- wheels with rims and dark wheel arches
		for _, o in ipairs({ V(2.05, 1.15, 3.3), V(-2.05, 1.15, 3.3), V(2.05, 1.15, -3.3), V(-2.05, 1.15, -3.3) }) do
			b.part(V(0.2, 1.4, 2.9), at(o.X > 0 and 2.31 or -2.31, 1.75, o.Z), C.Dark, m)
			wheel(b, at(o.X, o.Y, o.Z), 2.3, 0.9, m)
		end
		if style == "Taxi" then
			b.part(V(1.6, 0.6, 0.8), at(0, 4.5, 0.5), C.RoadWhite, m)
			b.part(V(4.66, 0.4, 7), at(0, 1.6, 0), C.Dark, m) -- checker stripe
		end
	end)
end

-- A city bus (big cover, and a wall to run along).
local function bus(b, cf, m)
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	b.part(V(8.5, 7.6, 30), at(0, 4.7, 0), C.Bus, m)
	b.decor(function()
		-- window band with pillars
		glass(b, b.part(V(8.62, 2.6, 26), at(0, 6.1, 1.4), C.Glass, m))
		for z = -11.4, 14.4, 2.6 do
			b.part(V(8.7, 2.7, 0.35), at(0, 6.1, z), C.Bus, m)
		end
		b.part(V(8.64, 0.7, 30.04), at(0, 3.7, 0), C.RoadWhite, m) -- stripe
		b.part(V(8.64, 0.3, 30.04), at(0, 4.2, 0), P.AccentA, m)
		-- front: windscreen, destination sign, lights, bumper
		glass(b, b.part(V(7.6, 3.6, 0.2), at(0, 5.9, -15.05), C.Glass, m))
		neon(b, b.part(V(5.4, 0.8, 0.15), at(0, 8.1, -15.08), C.LampLight, m))
		b.part(V(0.3, 3.6, 0.25), at(0, 5.9, -15.12), C.Dark, m) -- wiper divider
		for _, x in ipairs({ -3.2, 3.2 }) do
			neon(b, b.part(V(1.2, 0.6, 0.12), at(x, 2.5, -15.08), C.LampLight, m))
			neon(b, b.part(V(1.2, 0.8, 0.12), at(x, 2.8, 15.08), C.TailLight, m))
			b.part(V(0.3, 0.3, 1.6), at(x * 1.42, 7.2, -15.5), C.Dark, m) -- mirror arms
			b.part(V(0.5, 1.2, 0.3), at(x * 1.45, 6.6, -16.2), C.Dark, m)
		end
		b.part(V(8.7, 0.9, 0.6), at(0, 1.5, -15.2), C.Dark, m)
		b.part(V(8.7, 0.9, 0.6), at(0, 1.5, 15.2), C.Dark, m)
		-- doors (curb side) + roof unit + rear engine grille
		for _, z in ipairs({ -11, 2 }) do
			b.part(V(0.2, 5.8, 3.4), at(4.3, 3.9, z), C.Dark, m)
			glass(b, b.part(V(0.25, 4, 1.4), at(4.32, 4.6, z - 0.8), C.Glass, m))
			glass(b, b.part(V(0.25, 4, 1.4), at(4.32, 4.6, z + 0.8), C.Glass, m))
		end
		b.part(V(6.6, 1, 9), at(0, 9, 5), C.Trim, m)
		b.part(V(5, 1.4, 0.15), at(0, 3, 15.08), C.Dark, m)
		for _, z in ipairs({ -9.5, 9.5 }) do
			for _, x in ipairs({ 3.95, -3.95 }) do
				b.part(V(0.3, 2, 3.6), at(x > 0 and 4.3 or -4.3, 2.4, z), C.Dark, m)
				wheel(b, at(x, 1.4, z), 2.8, 0.9, m)
			end
		end
	end)
end

-- Concrete jersey barrier.
local function barrier(b, cf, m)
	b.part(V(2.4, 1.4, 8), cf * CFrame.new(0, 0.7, 0), C.Concrete, m)
	b.part(V(1.3, 1.8, 8), cf * CFrame.new(0, 2.3, 0), C.Concrete, m)
	b.decor(function()
		b.part(V(1.35, 0.5, 8.05), cf * CFrame.new(0, 2.6, 0), P.AccentB, m)
		for _, z in ipairs({ -2.5, 2.5 }) do
			b.part(V(1.6, 0.4, 0.4), cf * CFrame.new(0, 2, z), C.RoadWhite, m) -- reflectors
		end
	end)
end

local function bench(b, cf, m)
	b.decor(function()
		for k = -1, 1 do
			b.part(V(5, 0.22, 0.45), cf * CFrame.new(0, 1.45, k * 0.55), C.Wood, m)
		end
		b.part(V(5, 0.4, 0.2), cf * CFrame.new(0, 2.2, 0.8), C.Wood, m)
		b.part(V(5, 0.4, 0.2), cf * CFrame.new(0, 2.8, 0.8), C.Wood, m)
		for _, x in ipairs({ -2.1, 2.1 }) do
			b.part(V(0.25, 1.4, 1.6), cf * CFrame.new(x, 0.7, 0), C.Dark, m)
			b.part(V(0.25, 1.6, 0.25), cf * CFrame.new(x, 2.1, 0.8), C.Dark, m)
		end
	end)
end

local function crates(b, pos, m)
	b.block(V(4, 4, 4), pos + V(0, 2, 0), C.Wood, m)
	b.block(V(4, 4, 4), pos + V(4.2, 2, 0.5), C.Wood, m)
	b.block(V(3.6, 3.6, 3.6), pos + V(2, 5.8, 0.2), P.AccentB, m)
	b.decor(function()
		for _, o in ipairs({ V(0, 2, 0), V(4.2, 2, 0.5) }) do
			b.block(V(4.1, 0.4, 4.1), pos + o + V(0, 1.5, 0), C.Trunk, m) -- slats
			b.block(V(4.1, 0.4, 4.1), pos + o + V(0, -1.5, 0), C.Trunk, m)
			b.block(V(0.4, 4.1, 4.12), pos + o, C.Trunk, m)
		end
	end)
end

-- Market stall with a striped canopy.
local function stall(b, pos, color, m)
	b.block(V(10, 3.4, 4), pos + V(0, 1.7, 0), C.Wood, m)
	b.decor(function()
		b.block(V(10.4, 0.4, 4.4), pos + V(0, 3.6, 0), C.Trim, m)
		for _, x in ipairs({ -4.6, 4.6 }) do
			b.block(V(0.4, 8, 0.4), pos + V(x, 4, -1.8), C.Metal, m)
			b.block(V(0.4, 8, 0.4), pos + V(x, 4, 1.8), C.Metal, m)
		end
		for k = -2, 2 do -- striped canopy
			b.block(V(2.2, 0.5, 5.6), pos + V(k * 2.2, 8.2, 0), k % 2 == 0 and color or C.RoadWhite, m)
		end
		b.block(V(11, 1, 0.3), pos + V(0, 7.6, -2.8), C.RoadWhite, m)
		for k = -3, 3 do -- produce on the counter
			b.ball(0.9, pos + V(k * 1.3, 4.2, -0.8), C.Awning[(k % 3) + 1], m)
			b.ball(0.9, pos + V(k * 1.3 + 0.6, 4.2, 0.6), C.FoliageLight, m)
		end
	end)
end

local function hydrant(b, pos, m)
	b.decor(function()
		b.cylinder(2, 0.9, pos + V(0, 1, 0), C.Hydrant, m)
		b.cylinder(0.4, 1.1, pos + V(0, 2.1, 0), C.Hydrant, m)
		b.ball(0.9, pos + V(0, 2.3, 0), C.Hydrant, m)
		b.cylinder(1.4, 0.4, nil, C.Hydrant, m, CFrame.new(pos + V(0, 1.4, 0)))
	end)
end

local function trashCan(b, pos, m)
	b.decor(function()
		b.cylinder(2.4, 1.6, pos + V(0, 1.2, 0), C.Metal, m)
		b.cylinder(0.3, 1.8, pos + V(0, 2.5, 0), C.Dark, m)
		b.cylinder(0.12, 1.65, pos + V(0, 1.6, 0), P.AccentB, m)
	end)
end

-- Traffic light on a corner. faceDir = the way the lights face.
local function trafficLight(b, pos, faceDir, armDir, m)
	b.cylinder(12, 0.6, pos + V(0, 6, 0), C.Dark, m)
	b.decor(function()
		local top = pos + V(0, 11.4, 0)
		local tip = top + armDir * 8
		bar(b, top, tip, 0.35, 0.35, C.Dark, m)
		local head = tip - V(0, 1.8, 0)
		local frame = CFrame.lookAt(head, head + faceDir)
		b.part(V(1.3, 3.6, 1), frame, C.Dark, m)
		local lights = { { 1.1, C.TailLight }, { 0, P.AccentB }, { -1.1, C.SignalGreen } }
		for k, light in ipairs(lights) do
			local part = b.part(V(0.75, 0.75, 0.2), frame * CFrame.new(0, light[1], -0.55), k == 3 and light[2] or light[2]:Lerp(C.Dark, 0.65), m)
			if k == 3 then
				neon(b, part)
			end
		end
		-- pedestrian button + street sign
		b.block(V(0.5, 0.7, 0.5), pos + V(0, 3.6, 0) + faceDir * 0.4, P.AccentB, m)
		b.part(V(3.4, 0.7, 0.12), CFrame.lookAt(pos + V(0, 9.2, 0), pos + V(0, 9.2, 0) + faceDir) * CFrame.Angles(0, rad(90), 0), C.SignalGreen:Lerp(C.Dark, 0.4), m)
	end)
end

-- Practice dummies for the Playground (rooftops, train, avenue, park)
local PLAYGROUND_DUMMIES = {
	{ Position = V(-120, 0.5, 5), Motion = "Strafe", Amount = 10, Speed = 0.3, Face = V(1, 0, 0) },
	{ Position = V(60, 0.5, -5), Motion = "Strafe", Amount = 12, Speed = 0.25, Face = V(-1, 0, 0) },
	{ Position = V(-95, 48.8, 62), Face = V(0, 0, -1) },
	{ Position = V(95, 48.8, 62), Face = V(0, 0, -1) },
	{ Position = V(-152, 24.8, 60), Face = V(1, 0, -1) },
	{ Position = V(12, 26.8, 62), Face = V(0, 0, -1) },
	{ Position = V(0, 31.3, -75), Face = V(0, 0, 1) },
	{ Position = V(-60, 22, -75), Motion = "Strafe", Amount = 16, Speed = 0.2, Face = V(0, 0, 1) },
	{ Position = V(-90, 0.3, -47), Motion = "Bob", Amount = 9, Speed = 0.5, Face = V(0, 0, 1) },
	{ Position = V(150, 0.5, -100), Face = V(-1, 0, 0) },
	{ Position = V(30, 0.5, -112), Motion = "Strafe", Amount = 8, Speed = 0.4, Face = V(0, 0, 1) },
	{ Position = V(40, 0.5, 30), Face = V(0, 0, -1) },
}

----------------------------------------------------------------------------
-- BUILD
----------------------------------------------------------------------------
function ArenaDowntown.Build(b)
	local X = "X"
	local XZ = "XZ"

	-- GROUND ----------------------------------------------------------------
	b.block(V(460, 4, 320), V(0, -2, 0), C.Asphalt)
	b.decor(function()
		-- avenue centre dashes + edge lines
		for x = -200, -54, 14 do
			b.block(V(7, 0.08, 0.6), V(x, 0.04, 0), C.RoadLine, X)
		end
		b.block(V(150, 0.08, 0.5), V(-128, 0.04, 15.5), C.RoadWhite, XZ)
		-- crosswalks + stop lines at the plaza
		for z = -13, 13, 4 do
			b.block(V(6, 0.08, 2), V(-52, 0.04, z), C.RoadWhite, X)
		end
		b.block(V(0.8, 0.08, 15), V(-57, 0.04, -7.5), C.RoadWhite, X)
		-- manholes + drains
		for _, x in ipairs({ -176, -122, -92 }) do
			b.cylinder(0.1, 3, V(x, 0.05, -6), C.Dark, X)
			b.cylinder(0.12, 2.4, V(x, 0.06, -6), C.Metal, X)
			b.block(V(2.4, 0.08, 0.8), V(x + 10, 0.04, 16.8), C.Dark, XZ)
		end
	end)
	-- sidewalks + curbs (north and south of the avenue)
	b.block(V(158, 0.5, 12), V(-125, 0.25, 24), C.Sidewalk, XZ)
	b.block(V(158, 0.6, 0.6), V(-125, 0.3, 17.8), C.Curb, XZ)
	b.block(V(158, 0.5, 14), V(-125, 0.25, 37), C.Sidewalk, X) -- forecourt in front of the north buildings
	b.decor(function()
		for x = -200, -50, 6 do -- paving joints
			b.block(V(0.15, 0.04, 12), V(x, 0.52, 24), C.Curb, XZ)
		end
	end)

	-- CENTRAL PLAZA + FOUNTAIN ----------------------------------------------
	b.block(V(92, 0.5, 92), V(0, 0.25, 0), C.Sidewalk)
	b.decor(function()
		for i = -40, 40, 10 do
			b.block(V(92, 0.06, 0.3), V(0, 0.53, i), C.Curb)
			b.block(V(0.3, 0.06, 92), V(i, 0.53, 0), C.Curb)
		end
		b.cylinder(0.08, 40, V(0, 0.54, 0), C.Stone) -- ring of paving around the fountain
		b.cylinder(0.1, 34, V(0, 0.56, 0), C.Sidewalk)
	end)
	b.cylinder(2.6, 26, V(0, 1.8, 0), C.Stone)
	b.cylinder(7, 3, V(0, 6, 0), C.Stone)
	b.decor(function()
		glass(b, b.cylinder(0.4, 23.5, V(0, 3, 0), C.Water))
		b.cylinder(0.9, 10, V(0, 9.4, 0), C.Stone)
		glass(b, b.cylinder(0.3, 9, V(0, 9.9, 0), C.Water))
		b.cylinder(3, 1.6, V(0, 11.3, 0), C.Stone)
		b.cylinder(0.6, 5, V(0, 12.8, 0), C.Stone)
		neon(b, b.ball(1.8, V(0, 13.6, 0), C.Water))
		for k = 0, 5 do -- little jets in the basin
			local a = k * math.pi / 3
			local p = V(math.cos(a) * 8, 3.6, math.sin(a) * 8)
			neon(b, b.cylinder(1.6, 0.35, p + V(0, 0.6, 0), C.Water))
		end
	end)
	bench(b, CFrame.new(-30, 0.5, -30) * CFrame.Angles(0, rad(45), 0), XZ)
	tree(b, V(-38, 0.5, -38), 1, XZ)
	tree(b, V(-38, 0.5, 38), 1, X)
	lamp(b, V(-44, 0.5, -22), V(1, 0, 0), XZ, C.Awning[2])
	trafficLight(b, V(-48, 0.5, 20), V(-1, 0, 0), V(0, 0, -1), X)
	trafficLight(b, V(-48, 0.5, -20), V(-1, 0, 0), V(0, 0, 1), X)

	-- CITY HALL (north of the plaza, centred) --------------------------------
	building(b, 0, 72, 46, 32, 26, C.BuildingA, { "S", "E", "W" }, nil, { WindowSpacing = 8 })
	b.block(V(48, 2, 8), V(0, 1, 52), C.Stone) -- porch floor
	stairs(b, V(0, 0, 44.4), V(0, 0, 1), 3.6, 2, 40, C.Stone, nil, { Solid = true, Rails = false })
	for x = -18, 18, 7.2 do
		b.cylinder(20, 2.4, V(x, 12, 50), C.BuildingA)
		b.decor(function()
			b.block(V(3.4, 1, 3.4), V(x, 2.5, 50), C.Stone) -- column base + capital
			b.block(V(3.6, 1, 3.6), V(x, 21.5, 50), C.Stone)
			for k = 0, 3 do -- fluting
				local a = k * math.pi / 4
				b.part(V(0.3, 18, 2.5), CFrame.new(x, 12, 50) * CFrame.Angles(0, a, 0), C.Stone, nil)
			end
		end)
	end
	b.block(V(50, 1.6, 9), V(0, 22.8, 51.5), C.BuildingA) -- porch roof
	b.decor(function()
		b.block(V(50, 0.6, 9.4), V(0, 21.8, 51.5), C.Trim)
		-- pediment (triangle) above the porch
		b.place("WedgePart", V(1.4, 5, 25), CFrame.new(-12.5, 26.1, 47.6) * CFrame.Angles(0, rad(90), 0), C.Stone)
		b.place("WedgePart", V(1.4, 5, 25), CFrame.new(12.5, 26.1, 47.6) * CFrame.Angles(0, rad(-90), 0), C.Stone)
		b.block(V(30, 1.2, 1.2), V(0, 23.8, 47.4), C.Trim)
		b.block(V(10, 7, 0.4), V(0, 5.5, 55.9), C.Dark) -- doors
		b.block(V(0.3, 7, 0.5), V(0, 5.5, 55.75), C.Trim)
		glass(b, b.block(V(9, 2, 0.45), V(0, 10.2, 55.9), C.Glass))
		b.block(V(16, 1.6, 0.4), V(0, 17, 55.8), C.Dark) -- name plate
		for x = -6, 6, 2 do
			b.block(V(1.2, 0.8, 0.2), V(x, 17, 55.5), C.Rim)
		end
	end)
	-- clock tower
	b.block(V(12, 26, 12), V(0, 39, 74), C.BuildingA)
	b.decor(function()
		for _, x in ipairs({ -5.6, 5.6 }) do
			b.block(V(1.2, 26, 12.6), V(x, 39, 74), C.Stone, nil) -- corner pilasters
		end
		b.block(V(13, 0.8, 13), V(0, 46, 74), C.Trim)
		b.cylinder(0.4, 8, nil, C.RoadWhite, nil, CFrame.new(0, 40, 67.8) * CFrame.Angles(0, rad(90), 0))
		b.cylinder(0.3, 8.8, nil, C.Trim, nil, CFrame.new(0, 40, 67.85) * CFrame.Angles(0, rad(90), 0))
		for k = 0, 11 do -- hour marks
			local a = k * math.pi / 6
			b.part(V(0.3, 0.8, 0.15), CFrame.new(math.sin(a) * 3.3, 40 + math.cos(a) * 3.3, 67.5) * CFrame.Angles(0, 0, -a), C.Dark)
		end
		b.part(V(0.45, 2.8, 0.15), CFrame.new(0, 41.2, 67.4), C.Dark)
		b.part(V(2.2, 0.45, 0.15), CFrame.new(1, 40, 67.35), C.Dark)
		for x = -3, 3, 1.5 do -- belfry louvres
			b.block(V(0.6, 4, 0.3), V(x, 49.5, 67.9), C.Dark)
		end
	end)
	b.block(V(14, 1.2, 14), V(0, 52.6, 74), C.Roof)
	b.block(V(9, 4, 9), V(0, 55.2, 74), C.BuildingA)
	b.block(V(5, 4, 5), V(0, 59.2, 74), C.Roof)
	antenna(b, V(0, 61.2, 74), 6)
	-- fire escapes on both sides up to the roof
	fireEscape(b, V(-23, 0, 58), V(-1, 0, 0), V(0, 0, 1), 3, 26 / 3, X)
	acUnit(b, V(-14, 26.8, 84), X)
	rooftop(b, 10, 82, 26.8, nil, false)

	-- OFFICE TOWER (north, mirrored) ------------------------------------------
	building(b, -95, 69, 34, 46, 48, C.BuildingB, { "S", "E", "W" }, X)
	fireEscape(b, V(-112, 0, 50), V(-1, 0, 0), V(0, 0, 1), 6, 8, X, {
		Extend = 5,
		Gap = { Level = 3, Center = 2 + 10.4 + 4, Width = 4.4 },
	})
	acUnit(b, V(-102, 48.8, 80), X)
	acUnit(b, V(-88, 48.8, 82), X)
	antenna(b, V(-84, 48.8, 58), 14, X)
	rooftop(b, -100, 86, 48.8, X, true)
	-- rooftop sniper nest
	b.block(V(10, 2.4, 1.6), V(-95, 50, 48.6), P.AccentA, X)
	b.block(V(1.6, 2.4, 6), V(-80.6, 50, 52), P.AccentA, X)
	b.decor(function()
		b.block(V(10.2, 0.3, 1.8), V(-95, 51.3, 48.6), C.Dark, X)
		b.block(V(1.8, 0.3, 6.2), V(-80.6, 51.3, 52), C.Dark, X)
		-- office lobby: glass doors with a canopy
		glass(b, b.block(V(10, 7, 0.3), V(-95, 5.1, 45.8), C.Glass, X))
		b.block(V(14, 0.8, 4), V(-95, 9.2, 44), C.Dark, X)
		b.block(V(0.3, 7, 0.4), V(-95, 5.1, 45.7), C.Rim, X)
	end)

	-- APARTMENTS (north-west, mirrored) + catwalk to the office tower ---------
	building(b, -152.5, 72, 45, 56, 24, C.Brick, { "S", "E" }, X, { Storefront = { "S" } })
	fireEscape(b, V(-130, 0, 50), V(1, 0, 0), V(0, 0, 1), 3, 8, X, {
		Extend = 5,
		Gap = { Level = 3, Center = 2 + 10.4 + 4, Width = 4.4 },
	})
	-- catwalk between the two fire escapes (24 studs up)
	local catZ = 50 + 2 + 10.4 + 4
	b.block(V(6.4, 0.4, 4), V(-121, 23.8, catZ), C.Metal, X)
	playerWall(b, V(6, 3.4, 0.3), V(-121, 25.7, catZ + 2.1), X)
	playerWall(b, V(6, 3.4, 0.3), V(-121, 25.7, catZ - 2.1), X)
	b.decor(function()
		for _, dz in ipairs({ -2, 2 }) do
			b.block(V(6.4, 0.2, 0.2), V(-121, 27.2, catZ + dz), C.Dark, X)
			b.block(V(6.4, 0.15, 0.15), V(-121, 25.6, catZ + dz), C.Dark, X)
			for x = -124, -118, 2 do
				b.block(V(0.18, 3.2, 0.18), V(x, 25.6, catZ + dz), C.Dark, X)
			end
		end
		bar(b, V(-124, 20, catZ), V(-121, 23.6, catZ), 0.3, 0.3, C.Dark, X) -- braces
		bar(b, V(-118, 20, catZ), V(-121, 23.6, catZ), 0.3, 0.3, C.Dark, X)
	end)
	waterTower(b, V(-165, 24.8, 88), X)
	acUnit(b, V(-145, 24.8, 92), X)
	billboard(b, V(-152, 24.8, 99), 30, 10, 4, P.PlayerA, X)
	-- balconies on the apartment's east side
	for _, y in ipairs({ 14, 22 }) do
		for _, z in ipairs({ 78, 92 }) do
			b.block(V(3, 0.5, 7), V(-128.5, y - 4.3, z), C.Concrete, X)
			b.decor(function()
				b.block(V(0.2, 3, 7), V(-127.1, y - 2.6, z), C.Dark, X)
				b.block(V(3, 3, 0.2), V(-128.5, y - 2.6, z - 3.4), C.Dark, X)
				b.block(V(3, 3, 0.2), V(-128.5, y - 2.6, z + 3.4), C.Dark, X)
				b.block(V(0.3, 0.3, 7.2), V(-127.1, y - 1, z), C.Rim, X)
			end)
		end
	end

	-- SKYLINE (perimeter buildings, windows face the arena) -------------------
	local sideBlocks = {
		{ -132, 66, 70, C.BuildingD },
		{ -66, 66, 62, C.BuildingE },
		{ 0, 66, 78, C.BuildingD },
		{ 66, 66, 64, C.Stone },
		{ 132, 66, 72, C.BuildingD },
	}
	for _, seg in ipairs(sideBlocks) do
		building(b, -230, seg[1], 24, seg[2], seg[3], seg[4], { "E" }, X, {
			WindowSpacing = 9,
			FloorHeight = 9,
			NoParapet = true,
			Simple = true,
		})
	end
	local north = { { -189, 58, 76, C.BuildingD }, { -122, 76, 54, C.BuildingE }, { -42, 84, 66, C.Stone } }
	for _, seg in ipairs(north) do
		building(b, seg[1], 160, seg[2], 24, seg[3], seg[4], { "S" }, X, { WindowSpacing = 8, FloorHeight = 9, NoParapet = true, Simple = true })
	end
	local south = { { -189, 58, 58, C.BuildingE }, { -122, 76, 72, C.BuildingD }, { -42, 84, 50, C.Brick } }
	for _, seg in ipairs(south) do
		building(b, seg[1], -160, seg[2], 24, seg[3], seg[4], { "N" }, X, { WindowSpacing = 8, FloorHeight = 9, NoParapet = true, Simple = true })
	end
	waterTower(b, V(-122, 54.8, 165), X)
	waterTower(b, V(-189, 58.8, -165), X)
	antenna(b, V(-42, 66.8, 165), 16, X)
	antenna(b, V(-230, 78.8, 0), 18, X)

	-- SPAWN: TRANSIT STATIONS (mirrored) -------------------------------------
	b.block(V(30, 4, 40), V(-192, 2, 0), C.Concrete, X)
	b.block(V(30.4, 0.4, 40.4), V(-192, 4.2, 0), C.Sidewalk, X)
	stairs(b, V(-165, 0, 0), V(-1, 0, 0), 12, 4, 16, C.Concrete, X, { Solid = true })
	for _, z in ipairs({ -16, 16 }) do
		b.block(V(1, 10, 1), V(-182, 9.4, z), C.Metal, X)
		b.block(V(1, 10, 1), V(-202, 9.4, z), C.Metal, X)
	end
	b.block(V(26, 1, 38), V(-192, 14.9, 0), P.AccentA, X) -- canopy (ceiling to run on)
	b.decor(function()
		b.block(V(1.2, 0.1, 40), V(-178, 4.45, 0), P.AccentB, X) -- platform edge line
		for z = -18, 18, 1.5 do
			b.block(V(0.8, 0.12, 0.6), V(-179.2, 4.46, z), C.RoadLine, X) -- tactile strip
		end
		b.block(V(26.6, 0.6, 38.6), V(-192, 14.2, 0), C.Dark, X) -- canopy fascia
		for z = -14, 14, 7 do
			neon(b, b.block(V(18, 0.2, 0.6), V(-192, 14.3, z), C.LampLight, X)) -- strip lights
		end
		b.block(V(10, 4, 1), V(-192, 13, 19.2), C.Dark, X) -- station sign
		neon(b, b.block(V(8, 2, 1.1), V(-192, 13, 19.2), P.PlayerA, X))
		bench(b, CFrame.new(-198, 4.4, -12) * CFrame.Angles(0, rad(90), 0), X)
		bench(b, CFrame.new(-198, 4.4, 12) * CFrame.Angles(0, rad(90), 0), X)
		-- ticket machines
		b.block(V(2, 5, 1.6), V(-204, 6.9, -6), C.Metal, X)
		neon(b, b.block(V(1.4, 1.2, 0.2), V(-204, 7.8, -5.15), C.Glass, X))
	end)
	barrier(b, CFrame.new(-172, 0, 14), X)
	barrier(b, CFrame.new(-172, 0, -14), X)

	-- AVENUE COVER (mirrored) -----------------------------------------------
	bus(b, CFrame.new(-82, 0, -6) * CFrame.Angles(0, rad(90), 0), X)
	car(b, CFrame.new(-140, 0, 9) * CFrame.Angles(0, rad(90), 0), C.CarColors[1], X)
	car(b, CFrame.new(-118, 0, -9) * CFrame.Angles(0, rad(65), 0), P.AccentB, X, "Taxi")
	car(b, CFrame.new(-60, 0, 10) * CFrame.Angles(0, rad(100), 0), C.CarColors[3], X)
	barrier(b, CFrame.new(-47, 0, 9), X)
	barrier(b, CFrame.new(-47, 0, -9), X)
	-- street furniture along the sidewalks
	for i, x in ipairs({ -190, -155, -120, -85 }) do
		lamp(b, V(x, 0.5, 26), V(0, 0, -1), X, C.Awning[(i % 3) + 1])
		lamp(b, V(x, 0.5, -26), V(0, 0, 1), X, C.Awning[((i + 1) % 3) + 1])
	end
	for _, x in ipairs({ -172, -103, -68 }) do
		tree(b, V(x, 0.5, -26), 0.9, X)
	end
	tree(b, V(-160, 0.5, 26), 0.9, X)
	trashCan(b, V(-150, 0.5, -27), X)
	trashCan(b, V(-96, 0.5, 27), X)
	hydrant(b, V(-128, 0.5, 20), X)
	hydrant(b, V(-76, 0.5, -20), X)
	b.decor(function()
		for _, x in ipairs({ -134, -112 }) do -- parking meters
			b.cylinder(3, 0.25, V(x, 2, -19.5), C.Metal, X)
			b.block(V(0.6, 0.9, 0.5), V(x, 3.8, -19.5), C.Dark, X)
		end
		for x = -56, -44, 3 do -- bollards at the plaza
			b.cylinder(2.2, 0.7, V(x, 1.6, 19), C.Dark, X)
		end
	end)

	-- PARK (south of the avenue, mirrored) ------------------------------------
	b.block(V(84, 0.3, 26), V(-92, 0.15, -47), C.Grass, X)
	b.decor(function()
		b.block(V(84.6, 0.5, 0.4), V(-92, 0.25, -34), C.Curb, X) -- edging
		b.block(V(6, 0.32, 26), V(-108, 0.16, -47), C.Sidewalk, X) -- footpath
		for k = 0, 5 do -- flowers
			b.ball(0.8, V(-130 + k * 1.3, 0.6, -58), C.Awning[(k % 3) + 1], X)
		end
	end)
	for _, p in ipairs({ V(-120, 0.3, -42), V(-78, 0.3, -54), V(-58, 0.3, -40) }) do
		tree(b, p, 1.15, X)
	end
	b.block(V(16, 2.6, 2.4), V(-100, 1.3, -38), C.FoliageDark, X) -- hedges (cover)
	b.block(V(2.4, 2.6, 12), V(-66, 1.3, -50), C.FoliageDark, X)
	b.decor(function()
		b.block(V(16.3, 0.5, 2.7), V(-100, 2.4, -38), C.Foliage, X)
		b.block(V(2.7, 0.5, 12.3), V(-66, 2.4, -50), C.Foliage, X)
	end)
	bench(b, CFrame.new(-90, 0.3, -56), X)
	billboard(b, V(-92, 0, -33), 34, 12, 4, P.PlayerB, X) -- wall-runnable

	-- ELEVATED TRAIN TRACK (south, along the whole map) -----------------------
	b.block(V(440, 2, 14), V(0, 21, -75), C.Concrete)
	b.block(V(440, 0.6, 15), V(0, 20, -75), C.Trim)
	-- low walls with gaps where the stairs arrive (x = +-150)
	b.block(V(440, 1.6, 0.8), V(0, 22.8, -81.6), C.Curb)
	b.block(V(56, 1.6, 0.8), V(-182, 22.8, -68.4), C.Curb, X)
	b.block(V(292, 1.6, 0.8), V(0, 22.8, -68.4), C.Curb)
	b.decor(function()
		-- rails + sleepers
		b.block(V(440, 0.3, 0.4), V(0, 22.2, -77), C.Metal)
		b.block(V(440, 0.3, 0.4), V(0, 22.2, -73), C.Metal)
		for x = -216, -4, 4 do
			b.block(V(1, 0.15, 6), V(x, 22.05, -75), C.Trunk, X)
		end
		-- catenary masts + wire
		for x = -200, -20, 45 do
			b.block(V(0.6, 10, 0.6), V(x, 27, -81), C.Dark, X)
			b.block(V(0.4, 0.4, 7), V(x, 31.6, -77.8), C.Dark, X)
		end
		b.block(V(440, 0.12, 0.12), V(0, 31.2, -75), C.Dark)
		b.block(V(440, 1, 0.4), V(0, 20.3, -82.3), C.Dark) -- deck edge band
		b.block(V(440, 1, 0.4), V(0, 20.3, -67.7), C.Dark)
	end)
	-- pillars
	for _, x in ipairs({ -20, -70, -120, -170 }) do
		b.block(V(4, 20, 8), V(x, 10, -75), C.Concrete, X)
		b.decor(function()
			b.block(V(6, 1.5, 12), V(x, 19.25, -75), C.Trim, X)
			b.block(V(4.6, 1, 8.6), V(x, 0.5, -75), C.Trim, X)
			b.block(V(4.2, 0.4, 8.2), V(x, 12, -75), C.Curb, X)
		end)
	end
	-- stairs up (from the south sidewalk side), on steel supports
	stairs(b, V(-150, 0, -34), V(0, 0, -1), 34, 22, 6, C.Concrete, X)
	b.decor(function()
		for _, t in ipairs({ 0.3, 0.6, 0.85 }) do
			local z = -34 - 34 * t
			local h = 22 * t
			b.block(V(0.5, h, 0.5), V(-152.6, h / 2, z), C.Dark, X)
			b.block(V(0.5, h, 0.5), V(-147.4, h / 2, z), C.Dark, X)
		end
	end)
	-- the parked train (cover in the middle of the deck; stand on its roof)
	b.block(V(44, 8.5, 9), V(0, 26.5, -75), C.Train)
	b.decor(function()
		glass(b, b.block(V(44.2, 2.4, 9.2), V(0, 27.5, -75), C.Glass))
		for x = -20, 20, 4 do
			b.block(V(0.5, 2.5, 9.3), V(x, 27.5, -75), C.Train) -- window pillars
		end
		b.block(V(44.2, 0.6, 9.2), V(0, 24.4, -75), C.RoadWhite)
		b.block(V(44.2, 0.3, 9.2), V(0, 25.2, -75), P.AccentA)
		b.block(V(42, 0.6, 7), V(0, 31, -75), C.Trim)
		b.block(V(6, 1, 4), V(-10, 31.8, -75), C.Metal) -- roof units
		b.block(V(6, 1, 4), V(10, 31.8, -75), C.Metal)
		b.block(V(1.4, 2.4, 0.3), V(-14, 32.8, -75), C.Dark) -- pantograph
		for _, x in ipairs({ -8, 8 }) do -- doors
			b.block(V(3.2, 6.4, 9.3), V(x, 26, -75), C.Dark)
			glass(b, b.block(V(1.2, 2.4, 9.35), V(x - 0.8, 27.4, -75), C.Glass))
			glass(b, b.block(V(1.2, 2.4, 9.35), V(x + 0.8, 27.4, -75), C.Glass))
		end
		for _, x in ipairs({ -22.1, 22.1 }) do -- ends: doors + lights
			b.block(V(0.3, 6, 3), V(x, 25.4, -75), C.Dark)
			neon(b, b.block(V(0.3, 0.6, 1.2), V(x * 1.003, 24.4, -78), C.LampLight))
			neon(b, b.block(V(0.3, 0.6, 1.2), V(x * 1.003, 24.4, -72), C.LampLight))
		end
		for _, x in ipairs({ -15, 15 }) do -- bogies
			b.block(V(8, 1.2, 7), V(x, 22.6, -75), C.Dark)
			for _, dx in ipairs({ -2.5, 2.5 }) do
				for _, z in ipairs({ -78.3, -71.7 }) do
					wheel(b, CFrame.new(x + dx, 22.9, z) * CFrame.Angles(0, rad(90), 0), 1.8, 0.4, nil)
				end
			end
		end
	end)

	-- MARKET + SHOP (south, mirrored) -----------------------------------------
	stall(b, V(-62, 0, -100), C.Awning[1], X)
	stall(b, V(-34, 0, -100), C.Awning[2], X)
	stall(b, V(-34, 0, -116), C.Awning[3], X)
	crates(b, V(-50, 0, -110), X)
	building(b, -112, -122, 34, 26, 14, C.BuildingE, { "N", "E" }, X, { Storefront = { "N" } })
	crates(b, V(-92, 0, -112), X) -- climb onto the shop roof
	b.block(V(4, 8, 4), V(-91, 4, -118), C.Wood, X)
	acUnit(b, V(-118, 14.8, -128), X)

	-- SHIPPING CONTAINERS (climbable cover, mirrored): crate -> container -> stacked container
	local function container(cf, color)
		b.part(V(8, 8.5, 20), cf * CFrame.new(0, 4.25, 0), color, X)
		b.decor(function()
			for k = -3, 3 do
				b.part(V(8.1, 7.5, 0.4), cf * CFrame.new(0, 4.25, k * 2.6), C.Dark:Lerp(color, 0.6), X) -- ribs
			end
			b.part(V(8.1, 0.5, 20.1), cf * CFrame.new(0, 8.3, 0), C.Trim, X)
			b.part(V(8.1, 0.5, 20.1), cf * CFrame.new(0, 0.25, 0), C.Trim, X)
			b.part(V(7.4, 7.6, 0.2), cf * CFrame.new(0, 4.25, 10.05), C.Dark:Lerp(color, 0.4), X) -- doors
			for _, x in ipairs({ -1.2, 1.2 }) do
				b.part(V(0.2, 7.4, 0.3), cf * CFrame.new(x, 4.25, 10.15), C.Metal, X) -- lock bars
			end
		end)
	end
	container(CFrame.new(-150, 0, -98), C.Awning[1])
	container(CFrame.new(-140, 0, -98), C.Awning[2])
	container(CFrame.new(-145, 8.5, -101) * CFrame.Angles(0, rad(12), 0), C.Awning[3])
	crates(b, V(-158, 0, -88), X)

	-- WAREHOUSE (south, mirrored)
	building(b, -62, -132, 34, 20, 18, C.BuildingA, { "N" }, X, { WindowSpacing = 8 })
	b.decor(function()
		b.block(V(12, 10, 0.4), V(-62, 5, -121.9), C.Metal, X) -- roller door
		for y = 1, 9, 1.4 do
			b.block(V(12.1, 0.2, 0.5), V(-62, y, -121.8), C.Trim, X)
		end
		b.block(V(14, 1, 0.8), V(-62, 10.5, -121.6), P.AccentB, X)
		b.block(V(16, 0.4, 3), V(-62, 11.4, -120.6), C.Dark, X) -- loading canopy
	end)

	-- STATUE PLAZA (south centre)
	b.block(V(36, 0.5, 30), V(0, 0.25, -112), C.Sidewalk)
	b.block(V(8, 3, 8), V(0, 1.5, -112), C.Stone)
	b.decor(function()
		b.block(V(6, 0.6, 6), V(0, 3.3, -112), C.Trim)
		b.block(V(8.4, 0.4, 8.4), V(0, 0.7, -112), C.Trim)
		b.part(V(2.4, 9, 2.4), CFrame.new(0, 8, -112) * CFrame.Angles(0, rad(45), rad(12)), P.AccentA)
		b.ball(3.4, V(0.9, 12.8, -112), P.AccentB)
		b.block(V(4, 1, 0.2), V(0, 1.8, -107.9), C.Rim) -- plaque
	end)
	tree(b, V(-14, 0.5, -122), 0.9, X)
	tree(b, V(-14, 0.5, -102), 0.9, X)
	bench(b, CFrame.new(-8, 0.5, -125) * CFrame.Angles(0, rad(180), 0), X)

	-- PARKING LOT (south-west, mirrored) --------------------------------------
	b.decor(function()
		for i = 0, 4 do
			b.block(V(0.4, 0.08, 12), V(-198 + i * 8, 0.04, -112), C.RoadWhite, X)
		end
		for i = 0, 3 do -- wheel stops
			b.block(V(4, 0.4, 0.8), V(-194 + i * 8, 0.2, -117.5), C.Concrete, X)
		end
	end)
	car(b, CFrame.new(-194, 0, -112), C.CarColors[4], X)
	car(b, CFrame.new(-178, 0, -112), C.CarColors[5], X)
	car(b, CFrame.new(-170, 0, -96) * CFrame.Angles(0, rad(90), 0), C.CarColors[2], X)

	-- Spawns (on the station platforms, facing the city)
	local spawnHeight = 4.4 + 3.2
	return {
		CFrame.lookAt(V(-192, spawnHeight, 0), V(0, spawnHeight, 0)),
		CFrame.lookAt(V(192, spawnHeight, 0), V(0, spawnHeight, 0)),
	}, PLAYGROUND_DUMMIES
end

return ArenaDowntown
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ArenaNuketown</string>
          <string name="Source"><![CDATA[--[[
	ArenaNuketown.lua  (ServerScriptService.Server.ArenaNuketown)

	"Nuketown": the classic 1960s test-site cul-de-sac, rebuilt 1:1 in layout
	with flat colours (no textures). Point-symmetric: the green house's side
	is the yellow house's side turned 180 degrees, so both spawns are fair.

	TOP VIEW (X = long axis, spawns in the backyards at the far left / right)

	   +------------------------------------------------------------------+
	   |   rocks / mannequins / test-site fence       [BUS]                 |
	   |  BACKYARD  |alley        | fence  street                 |GARAGE| |
	   |  (spawn)   [ YELLOW  ]    lawn                   lawn    [ GREEN ] |
	   |   shed     [ HOUSE   ] porch          car    porch    [ HOUSE ] (spawn)
	   |  table     |GARAGE|   driveway        car                    alley|
	   |                [TRUCK]          rocks / mannequins / fence        |
	   +------------------------------------------------------------------+

	  * Houses: two floors you can go into (front door, back door, door to the
	    garage), windows downstairs and upstairs (the upstairs bedrooms look
	    over the street), stairs, a pitched roof, furniture.
	  * Garages: open roller door onto the driveway, a door into the house.
	  * Backyards: fenced, with a patio, picnic table, swing set and a shed.
	  * Street: the school bus on one side, the box truck on the other, cars,
	    barriers, picket fences and front lawns.
	  * Map ends: rocks, the test-site fence and mannequins.

	Detail (trim, shutters, siding, furniture...) is decor: it doesn't collide.
]]

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local C = Config.MapPalette
local P = Config.Palette
local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local ArenaNuketown = {}

local DIRT = RGB(204, 184, 148)
local LAWN = RGB(150, 190, 112)
local YELLOW = { Wall = RGB(236, 206, 128), Trim = RGB(250, 246, 236), Roof = RGB(96, 104, 118), Door = RGB(176, 72, 60), Shutter = RGB(120, 150, 196) }
local GREEN = { Wall = RGB(160, 196, 156), Trim = RGB(250, 246, 236), Roof = RGB(112, 88, 82), Door = RGB(70, 110, 160), Shutter = RGB(196, 120, 96) }
local FENCE = RGB(244, 240, 230)
local WOOD = RGB(170, 128, 90)

----------------------------------------------------------------------------
-- One side of the map (house, garage, yards, a vehicle). `xf` places it:
-- identity for the yellow side, turned 180 degrees for the green side.
----------------------------------------------------------------------------
local function buildSide(b, xf, colors, vehicle)
	local function at(x, y, z)
		return xf * CFrame.new(x, y, z)
	end
	local function box(size, x, y, z, color, rot)
		return b.part(size, at(x, y, z) * (rot or CFrame.identity), color)
	end
	local function ramp(low, dir, length, height, width, color)
		return b.ramp((xf * CFrame.new(low)).Position, xf:VectorToWorldSpace(dir), length, height, width, color)
	end

	-- A wall at x = `x` running along Z from z1 to z2 (y1..y2) with openings
	-- { a, b, bottom, top } (z range, y range). outSign = which way is outside.
	local function wallZ(x, z1, z2, y1, y2, color, openings, outSign)
		table.sort(openings, function(p, q)
			return p[1] < q[1]
		end)
		local cursor = z1
		local function piece(za, zb, ya, yb)
			if zb - za > 0.05 and yb - ya > 0.05 then
				box(V(1, yb - ya, zb - za), x, (ya + yb) / 2, (za + zb) / 2, color)
			end
		end
		for _, o in ipairs(openings) do
			piece(cursor, o[1], y1, y2)
			piece(o[1], o[2], y1, o[3])
			piece(o[1], o[2], o[4], y2)
			cursor = o[2]
		end
		piece(cursor, z2, y1, y2)
		-- frames + shutters on the outside
		if outSign then
			b.decor(function()
				for _, o in ipairs(openings) do
					local fx = x + outSign * 0.6
					local zc, w, yc, h = (o[1] + o[2]) / 2, o[2] - o[1], (o[3] + o[4]) / 2, o[4] - o[3]
					box(V(0.3, 0.5, w + 1), fx, o[4] + 0.25, zc, colors.Trim)
					box(V(0.3, h, 0.4), fx, yc, o[1] - 0.2, colors.Trim)
					box(V(0.3, h, 0.4), fx, yc, o[2] + 0.2, colors.Trim)
					if o[3] > y1 + 0.5 then -- a window: sill + shutters
						box(V(0.6, 0.4, w + 1.2), fx + outSign * 0.15, o[3] - 0.2, zc, colors.Trim)
						box(V(0.2, h, 1.6), fx, yc, o[1] - 1.3, colors.Shutter)
						box(V(0.2, h, 1.6), fx, yc, o[2] + 1.3, colors.Shutter)
					end
				end
			end)
		end
	end
	-- Same, for a wall at z = `z` running along X from x1 to x2.
	local function wallX(z, x1, x2, y1, y2, color, openings, outSign)
		table.sort(openings, function(p, q)
			return p[1] < q[1]
		end)
		local cursor = x1
		local function piece(xa, xb, ya, yb)
			if xb - xa > 0.05 and yb - ya > 0.05 then
				box(V(xb - xa, yb - ya, 1), (xa + xb) / 2, (ya + yb) / 2, z, color)
			end
		end
		for _, o in ipairs(openings) do
			piece(cursor, o[1], y1, y2)
			piece(o[1], o[2], y1, o[3])
			piece(o[1], o[2], o[4], y2)
			cursor = o[2]
		end
		piece(cursor, x2, y1, y2)
		if outSign then
			b.decor(function()
				for _, o in ipairs(openings) do
					local fz = z + outSign * 0.6
					local xc, w, yc, h = (o[1] + o[2]) / 2, o[2] - o[1], (o[3] + o[4]) / 2, o[4] - o[3]
					box(V(w + 1, 0.5, 0.3), xc, o[4] + 0.25, fz, colors.Trim)
					box(V(0.4, h, 0.3), o[1] - 0.2, yc, fz, colors.Trim)
					box(V(0.4, h, 0.3), o[2] + 0.2, yc, fz, colors.Trim)
					if o[3] > y1 + 0.5 then
						box(V(w + 1.2, 0.4, 0.6), xc, o[3] - 0.2, fz + outSign * 0.15, colors.Trim)
						box(V(1.6, h, 0.2), o[1] - 1.3, yc, fz, colors.Shutter)
						box(V(1.6, h, 0.2), o[2] + 1.3, yc, fz, colors.Shutter)
					end
				end
			end)
		end
	end

	------------------------------------------------------------------------
	-- THE HOUSE (front faces +X at x = -38; back at x = -64; z from -18 to 12)
	------------------------------------------------------------------------
	box(V(26, 1, 30), -51, 0.5, -3, C.Concrete) -- ground floor
	-- outer walls: ground floor (y 1-11) and upstairs (y 11-21)
	wallZ(-38.5, -18, 12, 1, 11, colors.Wall, { { -6, -1, 1, 8 }, { 3, 9, 4, 8 } }, 1) -- front: door + window
	wallZ(-38.5, -18, 12, 11, 21, colors.Wall, { { -14, -8, 14, 18 }, { 2, 8, 14, 18 } }, 1) -- bedrooms over the street
	wallZ(-63.5, -18, 12, 1, 11, colors.Wall, { { -14, -8, 4, 8 }, { 4, 9, 1, 8 } }, -1) -- back: window + back door
	wallZ(-63.5, -18, 12, 11, 21, colors.Wall, { { -6, 0, 14, 18 } }, -1)
	wallX(-17.5, -63, -39, 1, 11, colors.Wall, { { -58, -54, 1, 8 }, { -46, -41, 4, 8 } }) -- south: door to the garage
	wallX(-17.5, -63, -39, 11, 21, colors.Wall, { { -56, -50, 14, 18 } }, -1)
	wallX(11.5, -63, -39, 1, 11, colors.Wall, { { -58, -52, 4, 8 }, { -47, -42, 4, 8 } }, 1) -- north (side alley)
	wallX(11.5, -63, -39, 11, 21, colors.Wall, { { -52, -46, 14, 18 } }, 1)
	-- upstairs floor (with a hole over the stairs) + stairs along the north wall
	box(V(26, 1, 24.5), -51, 11.5, -5.75, C.Concrete)
	box(V(8, 1, 5.5), -60, 11.5, 9.25, C.Concrete)
	box(V(3, 1, 5.5), -39.5, 11.5, 9.25, C.Concrete)
	ramp(V(-42, 1, 9), V(-1, 0, 0), 14, 11, 4, WOOD)
	-- upstairs wall between the two bedrooms (with a doorway)
	wallX(-4, -63, -46, 12, 21, colors.Wall, { { -50, -47, 12, 19 } })
	-- roof: two slopes, ridge along Z, eaves overhanging
	ramp(V(-36.5, 21, -3), V(-1, 0, 0), 14.5, 7, 33, colors.Roof)
	ramp(V(-65.5, 21, -3), V(1, 0, 0), 14.5, 7, 33, colors.Roof)
	box(V(3, 9, 3), -58, 25.5, 6, RGB(150, 90, 76)) -- chimney

	-- house detail
	b.decor(function()
		-- siding lines + corner boards + base trim
		for y = 2.5, 20, 1.5 do
			box(V(0.12, 0.12, 30), -37.94, y, -3, colors.Trim)
			box(V(0.12, 0.12, 30), -64.06, y, -3, colors.Trim)
		end
		for _, z in ipairs({ -18.2, 12.2 }) do
			box(V(26.6, 0.8, 0.5), -51, 11, z, colors.Trim) -- floor band
			for _, x in ipairs({ -38.2, -63.8 }) do
				box(V(0.6, 20, 0.6), x, 11, z, colors.Trim)
			end
		end
		box(V(0.5, 0.8, 30.6), -37.9, 11, -3, colors.Trim)
		box(V(0.5, 0.8, 30.6), -64.1, 11, -3, colors.Trim)
		box(V(27, 0.8, 31), -51, 1.1, -3, RGB(140, 140, 136)) -- foundation band
		-- roof: fascia, gutters, ridge cap, antenna
		box(V(0.5, 0.8, 33.4), -36.3, 21, -3, colors.Trim)
		box(V(0.5, 0.8, 33.4), -65.7, 21, -3, colors.Trim)
		box(V(1.2, 0.6, 33.4), -51, 28.1, -3, colors.Roof)
		box(V(0.3, 7, 0.3), -48, 31.5, -10, C.Metal)
		box(V(4, 0.2, 0.2), -48, 34, -10, C.Metal)
		box(V(3, 0.2, 0.2), -48, 33, -10, C.Metal)
		-- front door + porch light
		box(V(0.3, 7, 5), -38, 4.5, -3.5, colors.Door)
		box(V(0.4, 0.4, 0.4), -37.7, 4.5, -2, C.Rim)
		b.material(box(V(0.5, 0.7, 0.5), -37.6, 8.7, -7, C.LampLight), Enum.Material.Neon)
		-- INSIDE (ground floor): couch, TV, table + chairs, kitchen counter, fridge
		box(V(3, 2, 8), -61, 2, -10, RGB(150, 70, 60))
		box(V(3, 3, 8), -62.3, 2.5, -10, RGB(130, 60, 52))
		box(V(1.2, 2.4, 3), -45, 2.2, -10, C.Dark)
		box(V(1, 1.6, 2.8), -44.5, 4.2, -10, C.Glass)
		box(V(5, 0.3, 4), -53, 3.6, 2, WOOD)
		for _, o in ipairs({ { -55.5, 2 }, { -50.5, 2 }, { -53, 0 }, { -53, 4 } }) do
			box(V(1.4, 2.2, 1.4), o[1], 2.1, o[2], WOOD)
		end
		box(V(2.4, 3.4, 10), -62.4, 2.7, 4, RGB(220, 216, 206)) -- kitchen counter
		box(V(2.6, 0.3, 10.2), -62.4, 4.5, 4, C.Stone)
		box(V(2.6, 7, 3), -62.2, 4.5, -2, RGB(206, 226, 222)) -- fridge
		-- UPSTAIRS: beds, dresser, lamp; stair rail
		for _, z in ipairs({ -12, 4 }) do
			box(V(7, 1.6, 5), -59, 12.8, z, RGB(236, 236, 240))
			box(V(1, 3, 5), -62.6, 13.5, z, WOOD)
			box(V(2.4, 3.4, 1.4), -45, 13.7, z - 4, WOOD)
		end
		box(V(15, 0.3, 0.3), -48.5, 15, 6.4, WOOD)
		for x = -55, -42, 3.25 do
			box(V(0.25, 3, 0.25), x, 13.5, 6.4, WOOD)
		end
	end)

	------------------------------------------------------------------------
	-- GARAGE (south of the house, open onto the driveway)
	------------------------------------------------------------------------
	box(V(16, 1, 14), -54, 0.5, -25, C.Concrete)
	wallZ(-61.5, -32, -18, 1, 11, colors.Wall, {}, -1)
	wallX(-31.5, -62, -46, 1, 11, colors.Wall, { { -58, -53, 4, 8 } }, -1)
	wallZ(-46.5, -32, -18, 1, 11, colors.Wall, { { -30.5, -19.5, 1, 9 } }, 1) -- roller door opening
	box(V(17, 1, 15), -54, 11.5, -25, colors.Roof)
	b.decor(function()
		box(V(1.4, 1.6, 11), -46.5, 9.6, -25, RGB(200, 200, 196)) -- rolled-up door
		box(V(17.4, 0.5, 15.4), -54, 12.1, -25, colors.Trim)
		box(V(2.4, 3.2, 8), -60, 2.6, -25, WOOD) -- workbench
		box(V(1, 5, 6), -60.8, 7.5, -25, WOOD) -- shelves
		for k = 0, 2 do
			b.cylinder(1, 2.4, nil, C.Tire, nil, at(-49, 1.6 + k * 1, -30.5) * CFrame.Angles(0, 0, rad(90)))
		end
		box(V(12, 0.12, 11), -40, 0.06, -25, C.Concrete) -- driveway
		box(V(3, 0.12, 4), -36, 0.06, -3.5, C.Concrete) -- front walk
	end)

	------------------------------------------------------------------------
	-- FRONT YARD: porch, picket fence, lawn, bushes, mailbox
	------------------------------------------------------------------------
	box(V(4, 1, 9), -36, 0.5, -3.5, C.Concrete) -- porch
	b.decor(function()
		box(V(7, 0.06, 30), -34.5, 0.03, -3, LAWN)
		for _, z in ipairs({ -7.6, 0.6 }) do
			box(V(0.5, 8, 0.5), -34.3, 5, z, colors.Trim) -- porch posts
		end
		box(V(5, 0.4, 10), -35.8, 9, -3.5, colors.Roof, CFrame.Angles(0, 0, rad(-12)))
		b.soft(function()
			for _, z in ipairs({ -15, -11, 5, 9 }) do
				b.ball(3, at(-37, 1.2, z).Position, C.FoliageDark)
			end
		end)
		box(V(0.3, 3.4, 0.3), -31, 1.7, 8, C.Metal) -- mailbox
		box(V(1.2, 0.9, 0.8), -31, 3.6, 8, colors.Shutter)
	end)
	-- picket fence (low: hop over it), gaps at the walk and the driveway
	for _, seg in ipairs({ { -18, -5 }, { -2, 13 } }) do
		local z1, z2 = seg[1], seg[2]
		box(V(0.4, 2.4, z2 - z1), -31.5, 1.2, (z1 + z2) / 2, FENCE)
		b.decor(function()
			for z = z1 + 0.5, z2 - 0.4, 1 do
				box(V(0.5, 0.6, 0.5), -31.5, 2.6, z, FENCE, CFrame.Angles(rad(45), 0, 0))
			end
		end)
	end
	box(V(0.4, 2.4, 2), -31.5, 1.2, -33, FENCE)

	------------------------------------------------------------------------
	-- SIDE ALLEY + BACKYARD (spawn)
	------------------------------------------------------------------------
	box(V(0.8, 7, 54), -92, 3.5, -7, WOOD) -- back fence
	box(V(54, 7, 0.8), -65, 3.5, 20, WOOD) -- north fence (alley + yard)
	box(V(46, 7, 0.8), -69, 3.5, -34, WOOD) -- south fence
	box(V(8, 8, 8), -86, 4, 13, colors.Roof) -- shed
	box(V(4, 2.4, 7), -76, 1.2, 8, WOOD) -- picnic table
	box(V(3, 4, 3), -88, 2, -28, C.Concrete) -- rock pile cover
	b.decor(function()
		box(V(28, 0.06, 54), -78, 0.03, -7, LAWN)
		box(V(10, 0.3, 12), -69, 0.15, 0, C.Concrete) -- patio
		for z = -33, 19, 2 do
			box(V(1, 7.6, 0.3), -92, 3.8, z, RGB(150, 110, 78)) -- fence boards
		end
		box(V(8.4, 1, 8.4), -86, 8.5, 13, colors.Trim)
		box(V(0.2, 5, 3), -81.9, 3.5, 13, colors.Door) -- shed door
		for _, z in ipairs({ 6, 10 }) do
			box(V(4, 0.4, 1.4), -76, 1.6, z, WOOD) -- benches
		end
		-- swing set
		for _, z in ipairs({ -24, -14 }) do
			b.part(V(0.3, 9, 0.3), at(-83, 4.3, z) * CFrame.Angles(0, 0, rad(12)), C.Metal)
			b.part(V(0.3, 9, 0.3), at(-79, 4.3, z) * CFrame.Angles(0, 0, rad(-12)), C.Metal)
		end
		box(V(0.3, 0.3, 11), -81, 8.6, -19, C.Metal)
		for _, z in ipairs({ -21, -17 }) do
			box(V(0.1, 5, 0.1), -81, 6, z - 0.8, C.Dark)
			box(V(0.1, 5, 0.1), -81, 6, z + 0.8, C.Dark)
			box(V(1, 0.2, 1.8), -81, 3.5, z, P.AccentB)
		end
		-- grill + trash cans
		b.cylinder(1, 2.2, at(-70, 3, -10).Position, C.Dark)
		box(V(0.2, 2.6, 0.2), -70, 1.3, -10, C.Dark)
		for _, z in ipairs({ 16, 17.8 }) do
			b.cylinder(2.6, 1.6, at(-62, 1.3, z).Position, C.Metal)
		end
	end)

	------------------------------------------------------------------------
	-- STREET SIDE: sidewalk, a car, a barrier, the bus or the truck
	------------------------------------------------------------------------
	b.decor(function()
		box(V(3, 0.2, 116), -29.5, 0.1, 0, C.Sidewalk)
		box(V(0.6, 0.3, 116), -27.8, 0.15, 0, C.Curb)
		box(V(0.4, 0.06, 6), 0, 0.07, -50, C.RoadLine) -- dashes (the other side adds the rest)
		for z = -42, -6, 9 do
			box(V(0.4, 0.06, 5), 0, 0.07, z, C.RoadLine)
		end
		b.cylinder(2, 1, at(-30, 1, 14).Position, C.Hydrant) -- hydrant
	end)
	-- car by the driveway
	local carCf = at(-20, 0, -14) * CFrame.Angles(0, rad(75), 0)
	b.part(V(4.6, 1.6, 10), carCf * CFrame.new(0, 1.6, 0), colors.Shutter)
	b.invisible(b.part(V(4.1, 1.8, 5), carCf * CFrame.new(0, 3.3, 0.6), colors.Shutter))
	b.decor(function()
		b.part(V(4.2, 1.6, 5.2), carCf * CFrame.new(0, 3.3, 0.6), C.Glass)
		b.part(V(4.3, 0.3, 5.2), carCf * CFrame.new(0, 4.2, 0.6), colors.Shutter)
		b.part(V(4.8, 0.6, 0.5), carCf * CFrame.new(0, 1.2, -5.2), C.Rim)
		b.part(V(4.8, 0.6, 0.5), carCf * CFrame.new(0, 1.2, 5.2), C.Rim)
		for _, o in ipairs({ V(2.1, 1.1, 3.2), V(-2.1, 1.1, 3.2), V(2.1, 1.1, -3.2), V(-2.1, 1.1, -3.2) }) do
			b.cylinder(0.9, 2.2, nil, C.Tire, nil, carCf * CFrame.new(o))
			b.cylinder(0.95, 1.2, nil, C.Rim, nil, carCf * CFrame.new(o))
		end
		b.part(V(1, 0.4, 0.1), carCf * CFrame.new(1.6, 2, -5.05), C.LampLight)
		b.part(V(1, 0.4, 0.1), carCf * CFrame.new(-1.6, 2, -5.05), C.LampLight)
	end)
	-- concrete barrier in mid
	box(V(8, 1.4, 2.4), -4, 0.7, 12, C.Concrete)
	box(V(8, 1.8, 1.3), -4, 2.3, 12, C.Concrete)

	if vehicle == "Bus" then
		local bx, bz = -6, 30
		box(V(30, 8.6, 9), bx - 2, 5.5, bz, RGB(244, 190, 60)) -- body
		box(V(5, 4.4, 8.6), bx + 15.5, 3.4, bz, RGB(244, 190, 60)) -- hood
		b.decor(function()
			b.material(box(V(26, 2.6, 9.1), bx - 1, 6.8, bz, C.Glass), Enum.Material.SmoothPlastic, 0.15)
			for x = -14, 12, 2.8 do
				box(V(0.4, 2.7, 9.2), bx + x, 6.8, bz, RGB(244, 190, 60))
			end
			box(V(30.1, 0.5, 9.1), bx - 2, 4.6, bz, C.Dark)
			box(V(30.1, 0.5, 9.1), bx - 2, 3.4, bz, C.Dark)
			box(V(0.2, 3, 8), bx + 13.05, 7, bz, C.Glass) -- windscreen
			box(V(5.2, 0.8, 9), bx + 15.5, 1.6, bz, C.Dark) -- bumper
			box(V(0.2, 6, 2.8), bx + 10, 4.8, bz - 4.55, C.Dark) -- door
			box(V(6, 1, 2), bx - 2, 10.3, bz, P.PlayerB) -- roof light bar
			for _, x in ipairs({ -12, 8, 15 }) do
				for _, z in ipairs({ -4, 4 }) do
					b.cylinder(1, 2.8, nil, C.Tire, nil, at(bx + x, 1.4, bz + z) * CFrame.Angles(0, rad(90), 0))
				end
			end
		end)
	else -- the moving truck
		local tx, tz = -10, 30
		box(V(22, 11, 9), tx, 6.8, tz, RGB(240, 240, 236)) -- cargo box
		box(V(8, 7, 8.6), tx + 15, 4.6, tz, RGB(200, 64, 56)) -- cab
		b.decor(function()
			box(V(22.1, 3, 9.1), tx, 8, tz, RGB(200, 64, 56)) -- stripe
			box(V(0.3, 9, 8), tx - 11.1, 6.8, tz, RGB(200, 200, 196)) -- rear door
			b.material(box(V(0.2, 3, 7.6), tx + 19.05, 6, tz, C.Glass), Enum.Material.SmoothPlastic, 0.15)
			box(V(8.2, 0.8, 8.8), tx + 15, 1.4, tz, C.Dark)
			for _, x in ipairs({ -7, 0, 15 }) do
				for _, z in ipairs({ -4, 4 }) do
					b.cylinder(1, 2.8, nil, C.Tire, nil, at(tx + x, 1.4, tz + z) * CFrame.Angles(0, rad(90), 0))
				end
			end
		end)
	end

	------------------------------------------------------------------------
	-- MAP END (this side's half): rocks, test-site fence, mannequins
	------------------------------------------------------------------------
	for i, pos in ipairs({ V(-40, 0, 52), V(-22, 0, 56), V(14, 0, 54), V(32, 0, 50), V(46, 0, 56), V(-58, 0, 48) }) do
		b.ball(5 + (i % 3) * 2, at(pos.X, 1.5, pos.Z).Position, RGB(170, 150, 120))
	end
	b.decor(function()
		box(V(196, 8, 0.2), 0, 4, 60, C.Metal) -- chain-link fence
		for x = -96, 96, 8 do
			box(V(0.4, 9, 0.4), x, 4.5, 60, C.Dark)
		end
		-- mannequins standing around
		for _, pos in ipairs({ V(-26, 0, 44), V(10, 0, 46), V(-44, 0, 40) }) do
			box(V(1.6, 2.4, 1), pos.X, 4.4, pos.Z, RGB(230, 210, 190))
			box(V(0.7, 2.8, 0.7), pos.X - 0.45, 1.4, pos.Z, RGB(80, 100, 140))
			box(V(0.7, 2.8, 0.7), pos.X + 0.45, 1.4, pos.Z, RGB(80, 100, 140))
			b.ball(1.4, at(pos.X, 6.4, pos.Z).Position, RGB(230, 210, 190))
		end
	end)
end

function ArenaNuketown.Build(b)
	-- ground (desert dirt), street, invisible boundary
	b.block(V(240, 4, 160), V(0, -2, 0), DIRT)
	b.decor(function()
		b.block(V(55, 0.06, 116), V(0, 0.03, 0), C.Asphalt)
	end)
	for _, wall in ipairs({ { V(4, 80, 130), V(98, 40, 0) }, { V(200, 80, 4), V(0, 40, 62) } }) do
		local parts = b.block(wall[1], wall[2], C.Metal, wall[1].X < 10 and "X" or "Z")
		b.invisible(parts)
	end

	buildSide(b, CFrame.identity, YELLOW, "Bus")
	buildSide(b, CFrame.Angles(0, math.pi, 0), GREEN, "Truck")

	-- the sign (once)
	local signPart = b.block(V(16, 5, 0.6), V(0, 8, -54), RGB(250, 246, 236))[1]
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = signPart
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Text = "NUKETOWN  -  POPULATION 40"
	text.TextScaled = true
	text.FontFace = Font.new(Config.UI.FontFamily, Enum.FontWeight.Heavy)
	text.TextColor3 = RGB(200, 64, 56)
	text.Parent = gui
	b.decor(function()
		b.block(V(0.5, 8, 0.5), V(-6, 4, -54), C.Metal)
		b.block(V(0.5, 8, 0.5), V(6, 4, -54), C.Metal)
	end)

	local spawnHeight = 3.2
	local spawns = {
		CFrame.lookAt(V(-82, spawnHeight, -6), V(0, spawnHeight, -6)),
		CFrame.lookAt(V(82, spawnHeight, 6), V(0, spawnHeight, 6)),
	}
	local dummies = {
		{ Position = V(-51, 12, -8), Face = V(1, 0, 0) },
		{ Position = V(51, 12, 8), Face = V(-1, 0, 0) },
		{ Position = V(-8, 9.8, 30), Face = V(0, 0, -1) },
		{ Position = V(0, 0, 0), Motion = "Strafe", Amount = 10, Speed = 0.3, Face = V(-1, 0, 0) },
		{ Position = V(-54, 1, -25), Face = V(1, 0, 0) },
		{ Position = V(54, 1, 25), Face = V(-1, 0, 0) },
		{ Position = V(-76, 0, -14), Motion = "Bob", Amount = 6, Speed = 0.5, Face = V(1, 0, 0) },
		{ Position = V(20, 0, -40), Motion = "Strafe", Amount = 8, Speed = 0.3, Face = V(0, 0, 1) },
	}
	return spawns, dummies
end

return ArenaNuketown
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ArenaSimple</string>
          <string name="Source"><![CDATA[--[[
	ArenaSimple.lua  (ServerScriptService.Server.ArenaSimple)

	"Simple": a clean, open 1v1 arena in the spirit of ROUNDS. Flat floor,
	a hill in the middle, high bridges on the sides, long walls and a few
	blocks to hide behind. No decoration: every part is a solid shape you
	can stand on, hide behind or wall run on. Mirrored across X = 0 (and mostly Z = 0), so both
	sides are identical.

	Built for flow: few, big shapes and long gentle ramps, so you can
	bunny hop, slide and wall run across the whole map without snagging.

	TOP VIEW (X = long axis, spawns at the far left / right)

	   +---------------------------------------------------------------+
	   |        /=====ramp=====[ BRIDGE ]=====ramp=====\               |
	   |      ======wall======              ======wall======           |
	   | SPAWN<=ramp    |cover|    /[ HILL ]\    |cover|    ramp=>SPAWN |
	   |      ======wall======              ======wall======           |
	   |        \=====ramp=====[ BRIDGE ]=====ramp=====/               |
	   +---------------------------------------------------------------+

	Colours come from Config.Palette (Snow floor, Light walls, Mid blocks,
	AccentA cover, AccentB ramps).
]]

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local P = Config.Palette
local V = Vector3.new

local ArenaSimple = {}

local LENGTH, WIDTH = 220, 140 -- floor size (X, Z)
local WALL_HEIGHT = 34

function ArenaSimple.Build(b)
	local X, Z, XZ = "X", "Z", "XZ"
	local halfL, halfW = LENGTH / 2, WIDTH / 2

	-- FLOOR + BOUNDARY -------------------------------------------------------
	b.block(V(LENGTH + 10, 4, WIDTH + 10), V(0, -2, 0), P.Snow)
	b.block(V(1.2, 0.1, WIDTH - 10), V(0, 0.05, 0), P.Mid) -- centre line
	b.block(V(LENGTH + 10, WALL_HEIGHT, 4), V(0, WALL_HEIGHT / 2, halfW + 2), P.Light, Z)
	b.block(V(4, WALL_HEIGHT, WIDTH + 10), V(halfL + 2, WALL_HEIGHT / 2, 0), P.Light, X)
	b.block(V(LENGTH + 10, 1, 4.6), V(0, WALL_HEIGHT + 0.5, halfW + 2), P.AccentB, Z) -- top trim
	b.block(V(4.6, 1, WIDTH + 10), V(halfL + 2, WALL_HEIGHT + 0.5, 0), P.AccentB, X)

	-- SPAWN DECKS: raised, with a wide ramp down toward the middle ----------------
	b.block(V(18, 6, 30), V(-98, 3, 0), P.Mid, X)
	b.ramp(V(-69, 0, 0), V(-1, 0, 0), 20, 6, 20, P.AccentB, X)

	-- CENTRE HILL: a low mesa with gentle ramps on all four sides (slide over it)
	b.block(V(28, 4, 28), V(0, 2, 0), P.Mid)
	b.ramp(V(-30, 0, 0), V(1, 0, 0), 16, 4, 28, P.AccentB, X)
	b.ramp(V(0, 0, -30), V(0, 0, 1), 16, 4, 28, P.AccentB, Z)
	b.block(V(2, 5, 12), V(0, 6.5, 0), P.AccentA) -- one spine of cover on top

	-- SIDE BRIDGES: long gentle ramps up to a high deck on each side --------------
	b.block(V(36, 12, 10), V(0, 6, 57), P.Light, Z)
	b.ramp(V(-58, 0, 57), V(1, 0, 0), 40, 12, 10, P.AccentB, XZ)
	b.block(V(36.4, 2, 0.8), V(0, 13, 52.4), P.AccentA, Z) -- low lip: cover at the edge

	-- WALL-RUN WALLS: long and tall, lined up with the lanes ----------------------
	b.block(V(40, 16, 2), V(-55, 8, 32), P.Light, XZ)
	b.block(V(40.2, 0.8, 2.2), V(-55, 16.4, 32), P.AccentB, XZ)

	-- A FEW PIECES OF COVER --------------------------------------------------------
	b.block(V(3, 5, 16), V(-50, 2.5, 0), P.AccentA, X) -- breaks the spawn-to-spawn sightline
	b.block(V(8, 8, 8), V(-80, 4, -26), P.Mid, XZ)

	-- Spawns (on the decks, facing the middle)
	local spawnHeight = 6 + 3.2
	local spawns = {
		CFrame.lookAt(V(-100, spawnHeight, 0), V(0, spawnHeight, 0)),
		CFrame.lookAt(V(100, spawnHeight, 0), V(0, spawnHeight, 0)),
	}

	-- Practice dummies for the Playground (Position = the ground under them)
	local dummies = {
		{ Position = V(0, 4, 9), Face = V(-1, 0, 0) },
		{ Position = V(0, 12, 57), Face = V(0, 0, -1) },
		{ Position = V(0, 12, -57), Face = V(0, 0, 1) },
		{ Position = V(40, 0, 0), Motion = "Strafe", Amount = 10, Speed = 0.3, Face = V(-1, 0, 0) },
		{ Position = V(-30, 0, -45), Motion = "Strafe", Amount = 12, Speed = 0.25, Face = V(1, 0, 0) },
		{ Position = V(30, 0, 45), Motion = "Strafe", Amount = 12, Speed = 0.25, Face = V(-1, 0, 0) },
		{ Position = V(-75, 0, 12), Motion = "Bob", Amount = 8, Speed = 0.5, Face = V(1, 0, 0) },
		{ Position = V(100, 6, 0), Face = V(-1, 0, 0) },
	}
	return spawns, dummies
end

return ArenaSimple
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source"><![CDATA[--[[
	BotService.lua  (ServerScriptService.Server.BotService)

	A computer opponent for testing (and for playing solo). Admins start one
	with N in the lobby or the chat command "/bot [easy|normal|hard]" (see
	MatchService and Config.Admin / Config.Bot).

	HOW IT FITS IN
	  A bot is a plain table that looks enough like a Player for the match
	  code: UserId (negative), Name, DisplayName, Parent, Character,
	  SetAttribute / GetAttribute and LoadCharacter. Match, CharacterService
	  and CombatService treat it like anyone else; remotes skip it (see
	  Remotes.Get on the server). Use Util.isBot(player) to tell them apart.

	THE AI (runs on the server every frame)
	  * Sight: raycasts from its head to your head and chest.
	  * Fighting (it can see you): faces you, strafes left/right, hops now
	    and then, keeps a comfortable distance, and shoots once it has
	    tracked you for its reaction time. Aim error shrinks the longer it
	    keeps you in view, and grows when you move fast.
	  * Hunting (it can't): walks a PathfindingService path to where it
	    last saw you, or to you if it lost you a while ago.
	  * Shots go through CombatService.BotFire, the same validation and
	    damage code players use, so power-ups work the same for it.
	  * When it loses a round it picks the rarest card offered.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PowerUps = require(ReplicatedStorage.Shared.PowerUps)
local CharacterService = require(script.Parent.CharacterService)

local B = Config.Bot

local BotService = {}

local CombatService -- set in Init (avoids a circular require)
local bots = {} -- [bot] = brain state
local nextId = 0
local folder

-- Roblox's default R15 animations
local ANIMATIONS = {
	Idle = "rbxassetid://507766388",
	Run = "rbxassetid://507767714",
	Jump = "rbxassetid://507765000",
	Fall = "rbxassetid://507767968",
}

----------------------------------------------------------------------------
-- The fake player
----------------------------------------------------------------------------
local Bot = {}
Bot.__index = Bot

function Bot:SetAttribute(name, value)
	self.Attributes[name] = value
end

function Bot:GetAttribute(name)
	return self.Attributes[name]
end

-- Builds a fresh R15 body (CharacterService.Spawn styles and places it).
function Bot:LoadCharacter()
	if self.Character then
		self.Character:Destroy()
		self.Character = nil
	end
	local description = Instance.new("HumanoidDescription")
	local ok, character = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	description:Destroy()
	if not ok or not character then
		warn("[Bot] couldn't build a character:", character)
		return
	end
	character.Name = "SniperBot" .. -self.UserId
	local animate = character:FindFirstChild("Animate")
	if animate then
		animate:Destroy() -- we animate it ourselves below
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = self.DisplayName
	humanoid.BreakJointsOnDeath = true
	humanoid.RequiresNeck = true
	character.Parent = folder
	self.Character = character

	local brain = bots[self]
	if brain then
		brain.Tracks = nil
		brain.Path = nil
		brain.SeenFor = 0
	end
end

-- Picks the rarest card offered (ties: random).
function Bot:ChooseCard(cards)
	local best, bestOrder = 1, -1
	for i, id in ipairs(cards) do
		local def = PowerUps.Get(id)
		local order = (def and Config.Rarity[def.Rarity] and Config.Rarity[def.Rarity].Order or 0) + math.random() * 0.5
		if order > bestOrder then
			best, bestOrder = i, order
		end
	end
	return best
end

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------
local function randomInCone(dir, degrees)
	if degrees <= 0 then
		return dir
	end
	local angle = math.rad(degrees) * math.sqrt(math.random())
	local spin = math.random() * math.pi * 2
	local frame = CFrame.lookAt(Vector3.zero, dir)
	return (frame * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function sightParams(character)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { character }
	for _, name in ipairs({ "Effects", "Dummies" }) do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(exclude, f)
		end
	end
	params.FilterDescendantsInstances = exclude
	return params
end

-- Returns the target part we can see (head first), or nil.
local function findVisiblePart(fromPos, character, targetCharacter)
	if targetCharacter:GetAttribute("Invisible") then
		return nil
	end
	local params = sightParams(character)
	for _, name in ipairs({ "Head", "UpperTorso", "LowerTorso" }) do
		local part = targetCharacter:FindFirstChild(name)
		if part then
			local result = workspace:Raycast(fromPos, part.Position - fromPos, params)
			if not result or result.Instance:IsDescendantOf(targetCharacter) then
				return part
			end
		end
	end
	return nil
end

----------------------------------------------------------------------------
-- Animation (server-side Animator replicates to every client)
----------------------------------------------------------------------------
local function animate(brain, humanoid, root)
	if not brain.Tracks then
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
		local tracks = {}
		for name, id in pairs(ANIMATIONS) do
			local animation = Instance.new("Animation")
			animation.AnimationId = id
			local ok, track = pcall(function()
				return animator:LoadAnimation(animation)
			end)
			if ok and track then
				track.Looped = name ~= "Jump"
				track.Priority = Enum.AnimationPriority.Core
				tracks[name] = track
			end
		end
		brain.Tracks = tracks
		brain.Playing = nil
	end

	local state = humanoid:GetState()
	local speed = flat(root.AssemblyLinearVelocity).Magnitude
	local want
	if state == Enum.HumanoidStateType.Jumping then
		want = "Jump"
	elseif state == Enum.HumanoidStateType.Freefall then
		want = "Fall"
	elseif speed > 2 then
		want = "Run"
	else
		want = "Idle"
	end
	local track = brain.Tracks[want]
	if want ~= brain.Playing and track then
		local old = brain.Playing and brain.Tracks[brain.Playing]
		if old then
			old:Stop(0.15)
		end
		track:Play(0.15)
		brain.Playing = want
	end
	if want == "Run" and track then
		track:AdjustSpeed(math.clamp(speed / 20, 0.6, 1.8))
	end
end

----------------------------------------------------------------------------
-- Pathfinding
----------------------------------------------------------------------------
local function requestPath(brain, root, goal)
	if brain.Computing then
		return
	end
	brain.Computing = true
	brain.PathAt = os.clock()
	local character = root.Parent
	task.spawn(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5.5,
			AgentCanJump = true,
			AgentCanClimb = true,
			WaypointSpacing = 6,
		})
		local ok = pcall(function()
			path:ComputeAsync(root.Position, goal)
		end)
		brain.Computing = false
		if not character.Parent or character ~= (brain.Owner and brain.Owner.Character) then
			return -- the bot respawned while this was computing
		end
		if ok and path.Status == Enum.PathStatus.Success then
			brain.Path = path:GetWaypoints()
			brain.PathIndex = 2
		else
			brain.Path = nil
		end
	end)
end

local function followPath(brain, humanoid, root)
	local path = brain.Path
	if not path then
		return false
	end
	local waypoint = path[brain.PathIndex]
	while waypoint and flat(waypoint.Position - root.Position).Magnitude < 3.5 do
		brain.PathIndex += 1
		waypoint = path[brain.PathIndex]
	end
	if not waypoint then
		brain.Path = nil
		return false
	end
	if waypoint.Action == Enum.PathWaypointAction.Jump then
		humanoid.Jump = true
	end
	humanoid:MoveTo(waypoint.Position)
	return true
end

----------------------------------------------------------------------------
-- Brain
----------------------------------------------------------------------------
local function think(bot, brain, dt)
	local match = brain.Match
	local character = bot.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local head = character and character:FindFirstChild("Head")
	if not humanoid or not root or not head or humanoid.Health <= 0 then
		return
	end
	animate(brain, humanoid, root)

	local difficulty = B.Difficulties[bot.Difficulty] or B.Difficulties.Normal
	humanoid.WalkSpeed = difficulty.WalkSpeed

	if not match:IsFighting() or character:GetAttribute("Frozen") then
		humanoid:Move(Vector3.zero)
		brain.SeenFor = 0
		brain.NextShot = os.clock() + 0.6 -- small grace period after the countdown
		return
	end

	-- knocked back (Shockwave): let physics carry it for a moment
	if os.clock() < (bot:GetAttribute("KnockedUntil") or 0) then
		humanoid:Move(Vector3.zero)
		return
	end

	local opponent = match:GetOpponent(bot)
	local _, targetCharacter = CharacterService.GetAliveHumanoid(opponent)
	local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
	if not targetRoot then
		humanoid:Move(Vector3.zero)
		return
	end

	local now = os.clock()
	local seenPart = findVisiblePart(head.Position, character, targetCharacter)
	local toTarget = targetRoot.Position - root.Position
	local distance = toTarget.Magnitude

	if seenPart then
		brain.SeenFor += dt
		brain.LastSeen = targetRoot.Position
		brain.LastSeenAt = now
		brain.Path = nil

		-- face the target (the server owns the bot's physics)
		humanoid.AutoRotate = false
		local look = flat(toTarget)
		if look.Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
		end
		local aimDir = (seenPart.Position - head.Position).Unit
		character:SetAttribute("AimPitch", math.clamp(math.asin(aimDir.Y), -1.4, 1.4))

		-- strafe, keep a sniping distance, hop now and then
		if now >= (brain.StrafeUntil or 0) then
			brain.StrafeSign = (brain.StrafeSign or 1) * (math.random() < 0.75 and -1 or 1)
			brain.StrafeUntil = now + B.StrafeTime[1] + math.random() * (B.StrafeTime[2] - B.StrafeTime[1])
			if math.random() < B.JumpChance then
				humanoid.Jump = true
			end
		end
		local forward = look.Magnitude > 0.1 and look.Unit or Vector3.zero
		local side = Vector3.new(-forward.Z, 0, forward.X) * brain.StrafeSign
		local approach = distance > 150 and 0.7 or (distance < 45 and -0.6 or 0)
		local move = side + forward * approach
		humanoid:Move(move.Magnitude > 0.01 and move.Unit or Vector3.zero)

		-- shoot
		if brain.SeenFor >= difficulty.ReactionTime and now >= (brain.NextShot or 0) then
			local aimHead = seenPart.Name == "Head" and math.random() < difficulty.HeadshotChance
			local aimPart = aimHead and seenPart
				or targetCharacter:FindFirstChild("UpperTorso")
				or seenPart
			-- settle: the longer it tracks you the steadier it gets; fast movers are harder
			local settle = math.clamp(1 - (brain.SeenFor - difficulty.ReactionTime) * 0.3, 0.45, 1)
			local moveError = targetRoot.AssemblyLinearVelocity.Magnitude * 0.025
			local errorDegrees = difficulty.AimError * settle + moveError
			local origin = head.Position
			local direction = randomInCone((aimPart.Position - origin).Unit, errorDegrees)
			CombatService.BotFire(bot, origin, direction)
			brain.NextShot = now
				+ CombatService.GetBoltTime(bot, match)
				+ difficulty.ExtraShotDelay * (0.7 + math.random() * 0.6)
		end
	else
		brain.SeenFor = math.max(0, brain.SeenFor - dt * 2)
		humanoid.AutoRotate = true
		character:SetAttribute("AimPitch", 0)

		-- hunt: where we last saw them, or straight to them after a while
		local goal = targetRoot.Position
		if brain.LastSeen and now - (brain.LastSeenAt or 0) < 5 then
			goal = brain.LastSeen
			if flat(goal - root.Position).Magnitude < 6 then
				brain.LastSeen = nil
			end
		end
		if not brain.Path or now - (brain.PathAt or 0) > B.PathInterval then
			requestPath(brain, root, goal)
		end
		if not followPath(brain, humanoid, root) then
			humanoid:MoveTo(goal)
		end
	end

	-- unstick: trying to move but not going anywhere -> jump and re-path
	local speed = flat(root.AssemblyLinearVelocity).Magnitude
	if humanoid.MoveDirection.Magnitude > 0.1 and speed < 3 then
		brain.StuckFor = (brain.StuckFor or 0) + dt
		if brain.StuckFor > 0.6 then
			humanoid.Jump = true
			brain.Path = nil
			brain.StuckFor = 0
			brain.StrafeSign = -(brain.StrafeSign or 1)
		end
	else
		brain.StuckFor = 0
	end
end

----------------------------------------------------------------------------
-- API
----------------------------------------------------------------------------

-- Creates a bot "player". difficulty: "Easy" / "Normal" / "Hard".
function BotService.Create(difficulty)
	nextId += 1
	local name = "BOT (" .. string.upper(difficulty) .. ")"
	local bot = setmetatable({
		IsBot = true,
		UserId = -(1000 + nextId), -- Studio test players use -1, -2, ...
		Name = name,
		DisplayName = name,
		Parent = Players,
		Character = nil,
		CameraMode = nil,
		Difficulty = difficulty,
		Attributes = {},
	}, Bot)
	bots[bot] = { SeenFor = 0, Owner = bot }
	CharacterService.Bots[bot] = true
	return bot
end

-- Gives the bot its match (the AI only plays while that match is fighting).
function BotService.Attach(bot, match)
	local brain = bots[bot]
	if brain then
		brain.Match = match
	end
end

function BotService.Remove(bot)
	if CombatService then
		CombatService.Forget(bot)
	end
	bots[bot] = nil
	CharacterService.Bots[bot] = nil
	bot.Parent = nil
	if bot.Character then
		bot.Character:Destroy()
		bot.Character = nil
	end
end

function BotService.Init(combatService)
	CombatService = combatService
	folder = Instance.new("Folder")
	folder.Name = "Bots" -- clients look bots' bodies up here
	folder.Parent = workspace

	RunService.Heartbeat:Connect(function(dt)
		for bot, brain in pairs(bots) do
			if brain.Match then
				local ok, err = pcall(think, bot, brain, dt)
				if not ok then
					warn("[Bot] error:", err)
				end
			end
		end
	end)
end

return BotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[--[[
	CharacterService.lua  (ServerScriptService.Server.CharacterService)

	Spawning and styling characters:
	  * Characters do NOT auto-respawn; the lobby and matches call Spawn().
	  * Every character is restyled to the flat look (single solid colour,
	    SmoothPlastic, no face/accessories) and gets a simple third-person
	    sniper so the enemy can see where your gun is.
	  * Freeze / unfreeze (used during countdowns and the pick screen).
	  * Temporary invisibility (Phantom Step).
	  * Falling into the void kills you.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local GunModel = require(ReplicatedStorage.Shared.GunModel)
local Util = require(ReplicatedStorage.Shared.Util)

local Palette = Config.Palette
local CharacterService = {}

-- Called with (player, character) when a character dies. Set by MatchService.
CharacterService.OnDied = nil

-- Bots (BotService) aren't in Players, so the void check tracks them here.
CharacterService.Bots = {} -- [bot] = true

----------------------------------------------------------------------------
-- Styling
----------------------------------------------------------------------------
local WORLD_GUN_SCALE = 0.8

-- The rifle other players see in your hands (same model as your viewmodel,
-- a bit smaller). The barrel points along the hand's -Y axis, so when the
-- client's aim pose raises the arm forward (CharacterPoser), the gun points
-- where you're looking.
-- powerUps ({ [id] = stacks }) adds each power-up's attachment + effects.
local function addWorldGun(character, powerUps)
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand then
		return
	end
	local old = character:FindFirstChild("WorldGun")
	if old then
		old:Destroy()
	end
	local gun = Instance.new("Model")
	gun.Name = "WorldGun"
	local built = GunModel.Build(gun, { Scale = WORLD_GUN_SCALE, CastShadow = true, PowerUps = powerUps })

	local grip = hand.CFrame * CFrame.new(0, -0.15, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	GunModel.Place(built, grip, WORLD_GUN_SCALE)
	for _, part in pairs(built.Parts) do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hand
		weld.Part1 = part
		weld.Parent = part
	end

	-- tracers seen by other players start here (WorldGun.Barrel.Muzzle)
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Parent = built.Parts.Barrel
	muzzle.WorldCFrame = grip * CFrame.new(built.Profile.Muzzle.Position * WORLD_GUN_SCALE)

	gun.Parent = character
end

-- AVATAR LOOK (Config.Player.UseAvatars): you play as your own Roblox
-- avatar. Hats and hair don't stop bullets (only the body counts), and a
-- coloured outline shows which side you're on in a match.
local function styleAvatar(character, color)
	for _, item in ipairs(character:GetDescendants()) do
		if item:IsA("BasePart") and item:FindFirstAncestorOfClass("Accessory") then
			item.CanQuery = false
			item.CanCollide = false
			item.CanTouch = false
			item.Massless = true
		end
	end
	local outline = character:FindFirstChild("TeamOutline") or Instance.new("Highlight")
	outline.Name = "TeamOutline"
	outline.FillTransparency = 1
	outline.OutlineColor = color
	outline.OutlineTransparency = color == Palette.LobbyPlayer and 1 or 0.15
	outline.DepthMode = Enum.HighlightDepthMode.Occluded
	outline.Parent = character
end

function CharacterService.Style(character, color, player)
	if Config.Player.UseAvatars and not Util.isBot(player) then
		styleAvatar(character, color)
		return
	end
	for _, item in ipairs(character:GetDescendants()) do
		if item:IsA("Accessory") or item:IsA("Clothing") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
			item:Destroy()
		elseif item:IsA("Decal") and item.Parent and item.Parent.Name == "Head" then
			item:Destroy() -- remove the face for the flat look
		end
	end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part:FindFirstAncestor("WorldGun") then
			part.Material = Enum.Material.SmoothPlastic
			part.Color = color
		end
	end
	-- Head a touch lighter so it reads clearly as the headshot target
	local head = character:FindFirstChild("Head")
	if head then
		head.Color = color:Lerp(Color3.new(1, 1, 1), 0.25)
	end
end

----------------------------------------------------------------------------
-- Spawning
----------------------------------------------------------------------------

-- Everyone's avatar is loaded at the same standard body size (no tiny or
-- giant hitboxes), keeping their look: skin, clothes, hair, face.
local descriptions = {} -- [player] = HumanoidDescription
local function standardDescription(player)
	if descriptions[player] then
		return descriptions[player]:Clone()
	end
	local ok, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(math.max(player.UserId, 1))
	end)
	if not ok or not description then
		return nil
	end
	description.HeightScale = 1
	description.WidthScale = 1
	description.DepthScale = 1
	description.HeadScale = 1
	description.BodyTypeScale = 0
	description.ProportionScale = 0
	descriptions[player] = description
	return description:Clone()
end

function CharacterService.LoadCharacter(player)
	if Util.isBot(player) or not Config.Player.UseAvatars then
		player:LoadCharacter()
		return
	end
	local description = player.UserId > 0 and standardDescription(player) or nil
	local ok = description and pcall(function()
		player:LoadCharacterWithHumanoidDescription(description)
	end)
	if not ok then
		player:LoadCharacter() -- (Studio test players have no avatar to fetch)
	end
end

--[[
	Spawns (or respawns) `player` at `cframe`.
	options:
		Color      body colour
		MaxHealth  starting max health
		Frozen     anchor the character in place
		KillY      falling below this Y kills you
		PowerUps   { [id] = stacks } shown as attachments on the rifle
]]
function CharacterService.Spawn(player, cframe, options)
	options = options or {}
	if not player.Parent then
		return nil
	end

	CharacterService.LoadCharacter(player)
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:WaitForChild("Humanoid", 5)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not humanoid or not root then
		return nil
	end

	CharacterService.Style(character, options.Color or Palette.LobbyPlayer, player)
	addWorldGun(character, options.PowerUps)

	humanoid.MaxHealth = options.MaxHealth or Config.Player.MaxHealth
	humanoid.Health = humanoid.MaxHealth
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.Movement.JumpPower
	humanoid.BreakJointsOnDeath = true

	character:PivotTo(cframe)
	character:SetAttribute("KillY", options.KillY or -100)
	CharacterService.SetFrozen(player, options.Frozen == true)

	humanoid.Died:Connect(function()
		if CharacterService.OnDied then
			CharacterService.OnDied(player, character)
		end
	end)

	return character
end

-- Anchors/unanchors the root part. The client's movement script also reads
-- the "Frozen" attribute so it stops applying velocity.
function CharacterService.SetFrozen(player, frozen)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	character:SetAttribute("Frozen", frozen)
	root.Anchored = frozen
	if not frozen then
		root.AssemblyLinearVelocity = Vector3.zero
		pcall(function()
			-- bots are simulated by the server
			root:SetNetworkOwner(if Util.isBot(player) then nil else player)
		end)
	end
end

-- Rebuilds the rifle in a player's hands (e.g. after trying power-ups in the lab).
function CharacterService.RefreshWorldGun(player, powerUps)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		addWorldGun(character, powerUps)
	end
end

-- Makes a character invisible to everyone for `duration` seconds.
function CharacterService.MakeInvisible(player, duration)
	local character = player.Character
	if not character or character:GetAttribute("Invisible") then
		return
	end
	character:SetAttribute("Invisible", true)
	local saved = {}
	local effects = {}
	for _, part in ipairs(character:GetDescendants()) do
		if (part:IsA("BasePart") and part.Name ~= "HumanoidRootPart") or part:IsA("Decal") then
			saved[part] = part.Transparency -- (decals: the face)
			part.Transparency = 1
		elseif (part:IsA("ParticleEmitter") or part:IsA("PointLight") or part:IsA("Highlight")) and part.Enabled then
			effects[part] = true -- rifle power-up effects would give you away
			part.Enabled = false
		end
	end
	task.delay(duration, function()
		for part, transparency in pairs(saved) do
			if part.Parent then
				part.Transparency = transparency
			end
		end
		for effect in pairs(effects) do
			if effect.Parent then
				effect.Enabled = true
			end
		end
		if character.Parent then
			character:SetAttribute("Invisible", false)
		end
	end)
end

function CharacterService.GetAliveHumanoid(player)
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid, character
	end
	return nil
end

function CharacterService.Init()
	Players.CharacterAutoLoads = false
	Players.PlayerRemoving:Connect(function(player)
		descriptions[player] = nil
	end)

	-- Void check: anything that falls below its KillY dies.
	RunService.Heartbeat:Connect(function()
		local everyone = Players:GetPlayers()
		for bot in pairs(CharacterService.Bots) do
			table.insert(everyone, bot)
		end
		for _, player in ipairs(everyone) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local killY = character and character:GetAttribute("KillY")
			if root and humanoid and killY and humanoid.Health > 0 and root.Position.Y < killY then
				humanoid.Health = 0
			end
		end
	end)
end

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--[[
	CombatService.lua  (ServerScriptService.Server.CombatService)

	Everything that deals damage is decided HERE, on the server:

	FIRE VALIDATION (anti-exploit)
	  1. Arguments must be real, finite Vector3s.
	  2. The shooter must be alive, and either in a live round or practising
	     in the lobby (where only the dummies can be hurt).
	  3. Fire rate: shots faster than the (power-up adjusted) bolt time are rejected.
	  4. Origin: the shot must start near the shooter's head on the server.
	  5. The server re-traces every bullet with Ballistics.Simulate (the same
	     code the client uses) and decides what was hit.

	LAG COMPENSATION (client "claims")
	  The client also says what it saw itself hit. Because the enemy moves
	  between the client's frame and the server receiving the shot, the server
	  accepts a claim only if:
	    * the claimed point lies on the server's own bullet path (so walls
	      really didn't block it), and
	    * the claimed point is close to where that body part really is
	      on the server (with a small allowance for the victim's speed).

	DAMAGE (how power-ups stack)
	  bullet damage = base (head / body / limb)
	                x Glass Cannon multiplier
	                x (1 + Sky Sniper bonus, if you're airborne)
	                x (1 + Momentum Rounds bonus, from your speed)
	                x (1 + Pinball bonus x bounces/wall passes before the hit)
	                x (1 + Marked bonus, if the target is marked)
	  Headshots are always an instant kill.
	  Explosions, Shrapnel and Static Charge use the same shot multiplier
	  (Glass Cannon, Sky Sniper, Momentum) and the Marked bonus.

	"Targets" are the enemy player in a match, or the practice dummies in the
	lobby, so every power-up works on the range too.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Ballistics = require(ReplicatedStorage.Shared.Ballistics)
local Util = require(ReplicatedStorage.Shared.Util)
local CharacterService = require(script.Parent.CharacterService)
local MatchService = require(script.Parent.MatchService)
local DummyService = require(script.Parent.DummyService)

local W = Config.Weapon
local PU = Config.PowerUps

local CombatService = {}

local lastFire = {} -- [player] = os.clock() of last accepted shot
local cooldowns = {} -- [player] = { [abilityName] = os.clock() ready time }
local bulletTimeUntil = {} -- [player] = os.clock()
local markedUntil = {} -- [player or dummy model] = os.clock()

local decoyFolder
local effectsFolder

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------
local function sendToMatch(match, remoteName, ...)
	local remote = Remotes.Get(remoteName)
	for _, player in ipairs(match.Players) do
		if player.Parent then
			remote:FireClient(player, ...)
		end
	end
end

-- Sends an effect to everyone who should see it: the match players, or
-- everyone in the lobby when `match` is nil (practice).
local function sendFx(match, data)
	if match then
		sendToMatch(match, "Effect", data)
		return
	end
	local remote = Remotes.Get("Effect")
	for _, other in ipairs(Players:GetPlayers()) do
		if not MatchService.GetMatch(other) then
			remote:FireClient(other, data)
		end
	end
end

-- Power-up stats for a player: their match stats, or their Power-Up Lab
-- picks when practising in the lobby.
local function getStats(player, match)
	if match then
		return match:GetStats(player)
	end
	return MatchService.GetPracticeStats(player)
end

-- Returns true (and starts the cooldown) if the ability is ready.
local function useCooldown(player, name, seconds)
	cooldowns[player] = cooldowns[player] or {}
	local now = os.clock()
	if (cooldowns[player][name] or 0) > now then
		return false
	end
	cooldowns[player][name] = now + seconds
	return true
end

-- Things a shooter's bullets ignore: their own body and their own decoys.
local function buildExclude(player)
	local list = { effectsFolder }
	if player.Character then
		table.insert(list, player.Character)
	end
	for _, decoy in ipairs(decoyFolder:GetChildren()) do
		if decoy:GetAttribute("OwnerUserId") == player.UserId then
			table.insert(list, decoy)
		end
	end
	return list
end

local function getTorso(model)
	return model
		and (
			model:FindFirstChild("UpperTorso")
			or model:FindFirstChild("Torso")
			or model:FindFirstChild("HumanoidRootPart")
		)
end

local function knockback(player, velocity)
	if Util.isBot(player) then
		-- the server simulates bots, so push them directly
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and not root.Anchored then
			root.AssemblyLinearVelocity += velocity * Config.Movement.KnockbackScale
			player:SetAttribute("KnockedUntil", os.clock() + 0.35) -- the AI stops steering for a moment
		end
	elseif player.Parent then
		Remotes.Get("Knockback"):FireClient(player, velocity * Config.Movement.KnockbackScale)
	end
end

local function popDecoy(decoy)
	if decoy.Parent then
		local owner = Players:GetPlayerByUserId(decoy:GetAttribute("OwnerUserId") or 0)
		local match = owner and MatchService.GetMatch(owner)
		sendFx(match, { Type = "DecoyPop", Position = decoy:GetPivot().Position })
		decoy:Destroy()
	end
end

-- Random direction within `degrees` of `dir`.
local function randomInCone(dir, degrees)
	local angle = math.rad(degrees) * math.sqrt(math.random())
	local spin = math.random() * math.pi * 2
	local cf = CFrame.lookAt(Vector3.zero, dir)
	return (cf * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

----------------------------------------------------------------------------
-- Targets: the enemy player in a match, or the dummies in the lobby
----------------------------------------------------------------------------
--[[
	A target record: { Player = Player?, Model = Model }
	(Player is nil for practice dummies.)
]]
local function getTargets(shooter, match)
	local list = {}
	if match then
		local opponent = match:GetOpponent(shooter)
		local humanoid, character = CharacterService.GetAliveHumanoid(opponent)
		if humanoid then
			table.insert(list, { Player = opponent, Model = character })
		end
	else
		for _, dummy in ipairs(DummyService.GetDummies()) do
			table.insert(list, { Model = dummy })
		end
	end
	return list
end

local function targetForModel(targets, model)
	for _, target in ipairs(targets) do
		if target.Model == model then
			return target
		end
	end
	return nil
end

local function markKey(target)
	return target.Player or target.Model
end

----------------------------------------------------------------------------
-- Damage to players
----------------------------------------------------------------------------

--[[
	Deals damage from `attacker` to the player `victim` inside `match`.
	info = { Headshot = bool, Splash = bool }
	Returns true if the victim died.
]]
function CombatService.Damage(match, attacker, victim, amount, info)
	info = info or {}
	if not match:IsFighting() then
		return false
	end
	local humanoid = CharacterService.GetAliveHumanoid(victim)
	if not humanoid then
		return false
	end

	local before = humanoid.Health
	local after = before - amount

	-- SECOND WIND: survive lethal hits (one save per stack, each round)
	if after <= 0 then
		local victimStats = match:GetStats(victim)
		local used = match.SecondWindUsed[victim] or 0
		if used < victimStats.SecondWindCharges then
			match.SecondWindUsed[victim] = used + 1
			after = 1
			Remotes.Get("Buff"):FireClient(victim, {
				Type = "SpeedBoost",
				Multiplier = PU.SecondWind.SpeedMultiplier,
				Duration = PU.SecondWind.BoostTime,
			})
			local root = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart")
			sendToMatch(match, "Effect", {
				Type = "SecondWind",
				UserId = victim.UserId,
				Position = root and root.Position or nil,
			})
		end
	end

	after = math.max(after, 0)
	local dealt = before - after
	match:NoteHit(attacker, victim, info.Headshot == true)
	humanoid.Health = after

	if attacker and attacker.Parent then
		-- VAMPIRE: heal for a fraction of the damage dealt
		local attackerStats = match:GetStats(attacker)
		local attackerHumanoid = CharacterService.GetAliveHumanoid(attacker)
		if attackerStats.LifeSteal > 0 and attackerHumanoid then
			attackerHumanoid.Health =
				math.min(attackerHumanoid.MaxHealth, attackerHumanoid.Health + dealt * attackerStats.LifeSteal)
		end
		Remotes.Get("HitConfirm"):FireClient(attacker, {
			Headshot = info.Headshot == true,
			Killed = after <= 0,
			Damage = dealt,
			Splash = info.Splash == true,
			Position = info.Position,
		})
	end

	-- kill effect: the body shatters (everyone in the match sees it)
	if after <= 0 then
		local root = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart")
		if root then
			sendToMatch(match, "Effect", {
				Type = "Kill",
				Position = root.Position,
				Color = match:ColorFor(victim),
				Headshot = info.Headshot == true,
			})
		end
	end

	local attackerRoot = attacker and attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
	Remotes.Get("Damaged"):FireClient(victim, {
		From = attackerRoot and attackerRoot.Position or nil,
		Damage = dealt,
		Killed = after <= 0,
	})
	return after <= 0
end

--[[
	Damages any target (player or dummy) and handles Marked.
	info = { Headshot, Splash }
]]
local function damageTarget(match, attacker, stats, target, amount, info)
	info = info or {}
	-- MARKED: bonus damage against a target you hit recently
	local key = markKey(target)
	if stats.MarkBonus > 0 and (markedUntil[key] or 0) > os.clock() then
		amount *= 1 + stats.MarkBonus
	end

	if target.Player then
		CombatService.Damage(match, attacker, target.Player, amount, info)
	else
		local torso = getTorso(target.Model)
		local killed = DummyService.Damage(target.Model, amount)
		Remotes.Get("HitConfirm"):FireClient(attacker, {
			Headshot = info.Headshot == true,
			Killed = killed,
			Damage = amount,
			Splash = info.Splash == true,
			Position = info.Position,
		})
		if killed and torso then
			sendFx(nil, { Type = "Kill", Position = torso.Position, Color = Config.Palette.PlayerB, Headshot = info.Headshot == true })
		end
	end

	if stats.MarkBonus > 0 then
		markedUntil[key] = os.clock() + PU.Marked.Duration
		Remotes.Get("Effect"):FireClient(attacker, {
			Type = "Mark",
			Target = target.Model,
			Duration = PU.Marked.Duration,
		})
	end
end

-- The part of the damage formula shared by everything a shot causes:
-- Glass Cannon x Sky Sniper (airborne) x Momentum Rounds (speed).
local function shotMultiplier(stats, shooterCharacter)
	local mult = stats.DamageMultiplier
	local root = shooterCharacter and shooterCharacter:FindFirstChild("HumanoidRootPart")
	if root then
		if stats.AirDamageBonus > 0 then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { shooterCharacter, effectsFolder, decoyFolder }
			local airborne = workspace:Raycast(root.Position, Vector3.new(0, -4.5, 0), params) == nil
			if airborne then
				mult *= 1 + stats.AirDamageBonus
			end
		end
		if stats.SpeedDamageBonus > 0 then
			local cfg = PU.MomentumRounds
			local speed = Util.flat(root.AssemblyLinearVelocity).Magnitude
			local bonus = math.clamp((speed - cfg.FreeSpeed) * cfg.BonusPerSpeed, 0, cfg.MaxBonus)
			mult *= 1 + bonus * stats.SpeedDamageBonus
		end
	end
	return mult
end

local function bulletDamage(part, hops, stats, mult)
	local zone = Util.hitZone(part.Name)
	if zone == "Head" then
		return W.HeadDamage, true -- always an instant kill
	end
	local base = zone == "Body" and W.BodyDamage or W.LimbDamage
	-- PINBALL: more damage for every bounce / wall pass before the hit
	return base * mult * (1 + stats.HopDamageBonus * (hops or 0)), false
end

----------------------------------------------------------------------------
-- Shot effects: explosions, shrapnel, static charge
----------------------------------------------------------------------------

-- EXPLOSIVE ROUNDS: splash damage + knockback around `position`.
-- `directModel` is the model the bullet hit directly (it doesn't take splash).
local function explode(match, attacker, stats, mult, targets, position, directModel)
	local radius = stats.ExplosionRadius
	local cfg = PU.ExplosiveRounds
	sendFx(match, { Type = "Explosion", Position = position, Radius = radius })

	for _, target in ipairs(targets) do
		local torso = getTorso(target.Model)
		if torso and target.Model ~= directModel then
			local offset = torso.Position - position
			local distance = offset.Magnitude
			if distance <= radius then
				local falloff = 1 - (distance / radius) * 0.5
				damageTarget(match, attacker, stats, target, stats.ExplosionDamage * falloff * mult, {
					Splash = true,
					Position = torso.Position,
				})
				if target.Player then
					local away = Util.safeUnit(offset + Vector3.new(0, 2, 0), Vector3.yAxis)
					knockback(target.Player, away * cfg.Knockback * falloff)
				end
			end
		end
	end

	-- self knockback (no self damage): explosive rocket jumps!
	local root = attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
	if root then
		local offset = root.Position - position
		if offset.Magnitude <= radius then
			local away = Util.safeUnit(offset + Vector3.new(0, 2, 0), Vector3.yAxis)
			knockback(attacker, away * cfg.SelfKnockback * (1 - (offset.Magnitude / radius) * 0.5))
		end
	end

	for _, decoy in ipairs(decoyFolder:GetChildren()) do
		if decoy:GetAttribute("OwnerUserId") ~= attacker.UserId then
			if (decoy:GetPivot().Position - position).Magnitude <= radius then
				popDecoy(decoy)
			end
		end
	end
end

-- SHRAPNEL: shards fly out of every surface a bullet touched.
-- Returns the shard segments for the visual effect.
local function shrapnel(match, attacker, stats, mult, targets, impacts, exclude, budget)
	local cfg = PU.Shrapnel
	local segments = {}
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude

	for _, impact in ipairs(impacts) do
		for _ = 1, stats.ShrapnelCount do
			if budget.Left <= 0 then
				return segments
			end
			budget.Left -= 1
			local dir = randomInCone(impact.Direction, cfg.SpreadDegrees)
			local start = impact.Position + impact.Normal * 0.1
			local ray = workspace:Raycast(start, dir * cfg.Range, params)
			local finish = ray and ray.Position or start + dir * cfg.Range
			table.insert(segments, { From = start, To = finish })
			if ray then
				local target = targetForModel(targets, Ballistics.FindTargetModel(ray.Instance))
				if target then
					damageTarget(match, attacker, stats, target, cfg.Damage * mult, { Splash = true, Position = ray.Position })
				end
			end
		end
	end
	return segments
end

-- STATIC CHARGE: a bullet that passes close to a target zaps it.
local function staticCharge(match, attacker, stats, mult, targets, sim, exclude, zapped)
	for _, target in ipairs(targets) do
		local torso = getTorso(target.Model)
		if torso and not zapped[target.Model] then
			local point, distance = Ballistics.ClosestOnPath(sim, torso.Position)
			if point and distance <= stats.StaticChargeRadius then
				-- needs a clear line from the bullet to the target
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				local list = table.clone(exclude)
				table.insert(list, target.Model)
				params.FilterDescendantsInstances = list
				if not workspace:Raycast(point, torso.Position - point, params) then
					zapped[target.Model] = true
					damageTarget(match, attacker, stats, target, stats.StaticChargeDamage * mult, {
						Splash = true,
						Position = torso.Position,
					})
					sendFx(match, { Type = "Zap", From = point, To = torso.Position })
				end
			end
		end
	end
end

----------------------------------------------------------------------------
-- Fire
----------------------------------------------------------------------------

-- Checks a client's hit claim. Returns the target's BasePart if it's believable.
local function validateClaim(claim, model, worldPath, homing)
	if typeof(claim) ~= "table" or typeof(claim.Part) ~= "string" then
		return nil
	end
	if not Util.isFiniteVector3(claim.Point) then
		return nil
	end
	local part = model:FindFirstChild(claim.Part)
	if not part or not part:IsA("BasePart") then
		return nil
	end

	-- 1) the claimed point must be on the server's bullet path
	local pathTolerance = W.ClaimPathTolerance + (homing and 2 or 0)
	if Ballistics.DistanceToPath(worldPath, claim.Point) > pathTolerance then
		return nil
	end

	-- 2) and near where the body part actually is right now
	local root = model:FindFirstChild("HumanoidRootPart")
	local speed = root and root.AssemblyLinearVelocity.Magnitude or 0
	local targetTolerance = W.ClaimTargetTolerance + speed * W.ClaimSpeedAllowance + part.Size.Magnitude * 0.5
	if (claim.Point - part.Position).Magnitude > targetTolerance then
		return nil
	end
	return part
end

local function onFire(player, origin, direction, claims)
	-- 1) argument sanity
	if not Util.isFiniteVector3(origin) or not Util.isFiniteVector3(direction) then
		return
	end
	if direction.Magnitude < 0.5 or direction.Magnitude > 1.5 then
		return
	end
	-- client hit claims arrive as a list of { Index, Model, Part, Point }
	local claimByBullet = {}
	if typeof(claims) == "table" then
		for _, claim in ipairs(claims) do
			if typeof(claim) == "table" and typeof(claim.Index) == "number" then
				claimByBullet[claim.Index] = claim
			end
		end
	end

	-- 2) shooter state. No match = lobby practice range (dummies only).
	local match = MatchService.GetMatch(player)
	if match and not match:IsFighting() then
		return
	end
	local humanoid, character = CharacterService.GetAliveHumanoid(player)
	if not humanoid or character:GetAttribute("Frozen") then
		return
	end
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not head or not root then
		return
	end
	local stats = getStats(player, match)

	-- 3) fire rate
	local now = os.clock()
	local boltTime = stats.BoltTime
	if (bulletTimeUntil[player] or 0) > now then
		boltTime /= PU.BulletTime.BoltSpeedScale
	end
	if lastFire[player] and now - lastFire[player] < boltTime * W.FireRateTolerance then
		return
	end

	-- 4) origin must be near the head
	local tolerance = W.OriginTolerance + root.AssemblyLinearVelocity.Magnitude * W.OriginSpeedAllowance
	if (origin - head.Position).Magnitude > tolerance then
		if Config.Debug.LogRejectedShots then
			warn(("[Combat] rejected shot from %s: origin %.1f studs from head"):format(
				player.Name,
				(origin - head.Position).Magnitude
			))
		end
		return
	end
	lastFire[player] = now

	-- 5) trace every bullet on the server
	local targets = getTargets(player, match)
	local homingTargets = {}
	for _, target in ipairs(targets) do
		local torso = getTorso(target.Model)
		if torso then
			table.insert(homingTargets, torso.Position)
		end
	end
	local exclude = buildExclude(player)
	local mult = shotMultiplier(stats, character)
	local shardBudget = { Left = PU.Shrapnel.MaxShardsPerShot }
	local shardSegments = {}
	local zapped = {}
	local anyHit = false

	local fx = {}
	for i, dir in ipairs(Ballistics.GetShotDirections(direction.Unit, stats.Bullets)) do
		local sim = Ballistics.Simulate({
			Origin = origin,
			Direction = dir,
			Stats = stats,
			Exclude = exclude,
			HomingTargets = homingTargets,
		})

		local hitTarget, hitPart, hitPos, hops
		if sim.Hit then
			local model = sim.Hit.Model
			if model:GetAttribute("Decoy") then
				popDecoy(model)
			else
				hitTarget = targetForModel(targets, model)
				if hitTarget then
					hitPart, hitPos, hops = sim.Hit.Part, sim.Hit.Position, sim.Hit.Hops
				end
			end
		end

		-- Lag compensation: trust a believable client claim over a server
		-- miss or body shot (never over a server headshot).
		local claim = claimByBullet[i]
		local claimTarget = claim and typeof(claim.Model) == "Instance" and targetForModel(targets, claim.Model)
		local worldPath
		if claimTarget and not (hitPart and Util.hitZone(hitPart.Name) == "Head") then
			worldPath = Ballistics.Simulate({
				Origin = origin,
				Direction = dir,
				Stats = stats,
				Exclude = exclude,
				HomingTargets = homingTargets,
				IgnoreTargets = true,
			})
			local claimed = validateClaim(claim, claimTarget.Model, worldPath, stats.Homing)
			if claimed then
				local _, _, claimHops = Ballistics.ClosestOnPath(worldPath, claim.Point)
				hitTarget, hitPart, hitPos, hops = claimTarget, claimed, claim.Point, claimHops
			end
		end

		if hitTarget then
			anyHit = true
			local damage, headshot = bulletDamage(hitPart, hops, stats, mult)
			damageTarget(match, player, stats, hitTarget, damage, { Headshot = headshot, Position = hitPos })
		elseif stats.StaticChargeDamage > 0 then
			staticCharge(match, player, stats, mult, targets, sim, exclude, zapped)
		end

		if stats.Explosive then
			explode(match, player, stats, mult, targets, hitPos or sim.EndPosition, hitTarget and hitTarget.Model)
		end
		if stats.ShrapnelCount > 0 then
			for _, seg in ipairs(shrapnel(match, player, stats, mult, targets, sim.Impacts, exclude, shardBudget)) do
				table.insert(shardSegments, seg)
			end
		end

		table.insert(fx, {
			Segments = sim.Segments,
			Passes = sim.Passes,
			EndPosition = hitPos or sim.EndPosition,
			EndNormal = sim.EndNormal,
			HitPlayer = hitPart ~= nil,
		})
	end

	if #shardSegments > 0 then
		sendFx(match, { Type = "Shards", Segments = shardSegments })
	end

	-- HAIR TRIGGER: any hit re-chambers the rifle straight away
	if anyHit and stats.HairTrigger then
		lastFire[player] = now - boltTime
		Remotes.Get("Buff"):FireClient(player, { Type = "Rechamber" })
	end

	-- Let others draw this shot (the shooter already drew it locally):
	-- the opponent in a match, everyone else in the lobby when practising.
	local shotFx = Remotes.Get("ShotFx")
	if match then
		local opponent = match:GetOpponent(player)
		if opponent.Parent then
			shotFx:FireClient(opponent, player.UserId, fx, stats.Explosive)
		end
	else
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and not MatchService.GetMatch(other) then
				shotFx:FireClient(other, player.UserId, fx, stats.Explosive)
			end
		end
	end
end

-- Players send where they're looking (up/down) so others see them aim.
local function onAim(player, pitch)
	if typeof(pitch) ~= "number" or pitch ~= pitch then
		return
	end
	local character = player.Character
	if character then
		character:SetAttribute("AimPitch", math.clamp(pitch, -1.4, 1.4))
	end
end

----------------------------------------------------------------------------
-- Abilities
----------------------------------------------------------------------------
local function spawnDecoy(player, match, direction)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local cfg = PU.Decoy

	character.Archivable = true
	local decoy = character:Clone()
	character.Archivable = false
	decoy.Name = "Decoy"
	decoy:SetAttribute("Decoy", true)
	decoy:SetAttribute("OwnerUserId", player.UserId)

	for _, item in ipairs(decoy:GetDescendants()) do
		if item:IsA("Script") or item:IsA("LocalScript") or item:IsA("Humanoid") or item:IsA("Constraint") then
			item:Destroy()
		end
	end
	for _, part in ipairs(decoy:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.Material = Enum.Material.SmoothPlastic
			if part.Name ~= "HumanoidRootPart" then
				part.Color = Config.Palette.Hologram
				part.Transparency = 0.3
				part.CanQuery = part.Parent == decoy -- body parts can be shot
			end
		end
	end
	decoy.Parent = decoyFolder

	local dir = Util.safeUnit(Util.flat(direction), Util.flat(root.CFrame.LookVector).Unit)
	local pivot = CFrame.lookAt(root.Position, root.Position + dir)
	decoy:PivotTo(pivot)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { decoyFolder, effectsFolder, character }

	local alive = 0
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		alive += dt
		local roundOver = match and (match.Finished or match.Phase ~= "Fight")
		local leftLobby = not match and MatchService.GetMatch(player) ~= nil
		if not decoy.Parent or alive > cfg.Lifetime or roundOver or leftLobby then
			connection:Disconnect()
			popDecoy(decoy)
			return
		end
		local position = pivot.Position
		-- stop at walls
		local wall = workspace:Raycast(position, dir * (cfg.Speed * dt + 1.5), params)
		if not wall then
			position += dir * cfg.Speed * dt
		end
		-- follow the floor (and fall off ledges)
		local floor = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -40, 0), params)
		if floor then
			position = Vector3.new(position.X, floor.Position.Y + 3, position.Z)
		end
		local bob = math.abs(math.sin(alive * 12)) * 0.35
		pivot = CFrame.lookAt(position, position + dir)
		decoy:PivotTo(pivot + Vector3.new(0, bob, 0))
	end)
end

-- Several decoys fan out around the chosen direction (one per stack).
local function spawnDecoys(player, match, direction, count)
	for _, d in ipairs(decoyFolder:GetChildren()) do
		if d:GetAttribute("OwnerUserId") == player.UserId then
			d:Destroy()
		end
	end
	local spread = math.rad(PU.Decoy.SpreadDegrees)
	for i = 1, count do
		local offset = (i - (count + 1) / 2) * spread
		local dir = CFrame.fromAxisAngle(Vector3.yAxis, offset):VectorToWorldSpace(direction)
		spawnDecoy(player, match, dir)
	end
end

local function onAbility(player, name, data)
	if typeof(name) ~= "string" then
		return
	end
	if typeof(data) ~= "table" then
		data = {}
	end
	-- abilities work in a live round, or in the lobby with Power-Up Lab picks
	local match = MatchService.GetMatch(player)
	if match and not match:IsFighting() then
		return
	end
	local humanoid, character = CharacterService.GetAliveHumanoid(player)
	if not humanoid then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local stats = getStats(player, match)
	local opponent = match and match:GetOpponent(player)

	if name == "PhantomDash" and stats.PhantomDash then
		if useCooldown(player, name, 0.5) then
			CharacterService.MakeInvisible(player, stats.PhantomTime)
		end
	elseif name == "Decoy" and stats.Decoy then
		if Util.isFiniteVector3(data.Direction) and useCooldown(player, name, PU.Decoy.Cooldown * 0.95) then
			spawnDecoys(player, match, Util.safeUnit(Util.flat(data.Direction), Vector3.zAxis), stats.DecoyCount)
		end
	elseif name == "BulletTime" and stats.BulletTime then
		if useCooldown(player, name, PU.BulletTime.Cooldown * 0.9) then
			bulletTimeUntil[player] = os.clock() + stats.BulletTimeDuration + 0.25
		end
	elseif name == "Shockwave" and stats.ShockwaveLanding and root then
		if useCooldown(player, name, PU.ShockwaveLanding.Cooldown * 0.9) then
			local radius = stats.ShockwaveRadius
			sendFx(match, { Type = "Shockwave", Position = root.Position, Radius = radius })
			for _, target in ipairs(getTargets(player, match)) do
				local torso = getTorso(target.Model)
				if torso then
					local offset = torso.Position - root.Position
					if offset.Magnitude <= radius then
						if stats.ShockwaveDamage > 0 then
							damageTarget(match, player, stats, target, stats.ShockwaveDamage * stats.DamageMultiplier, {
								Splash = true,
								Position = torso.Position,
							})
						end
						if target.Player then
							local away = Util.safeUnit(Util.flat(offset), Vector3.xAxis)
							knockback(target.Player, (away + Vector3.new(0, 0.7, 0)).Unit * stats.ShockwaveKnockback)
						end
					end
				end
			end
		end
	elseif name == "Blink" and stats.Blink and root then
		-- the client moves itself (it owns its character); we just check it's
		-- plausible and show the effect to everyone else
		if Util.isFiniteVector3(data.From) and Util.isFiniteVector3(data.To) then
			if (data.To - data.From).Magnitude <= stats.BlinkDistance + 12 and useCooldown(player, name, stats.BlinkCooldown * 0.85) then
				local fxData = { Type = "Blink", From = data.From, To = data.To, UserId = player.UserId }
				if match then
					if opponent.Parent then
						Remotes.Get("Effect"):FireClient(opponent, fxData)
					end
				else
					sendFx(nil, fxData)
				end
			end
		end
	elseif name == "GrappleStart" and stats.Grapple and root then
		if Util.isFiniteVector3(data.Point) and (data.Point - root.Position).Magnitude < Config.Movement.GrappleRange + 30 then
			if opponent and opponent.Parent then
				Remotes.Get("Effect"):FireClient(opponent, { Type = "Grapple", UserId = player.UserId, Point = data.Point })
			end
		end
	elseif name == "GrappleEnd" then
		if opponent and opponent.Parent then
			Remotes.Get("Effect"):FireClient(opponent, { Type = "GrappleEnd", UserId = player.UserId })
		end
	end
end

-- Forget everything about a player / bot (bots aren't in PlayerRemoving).
function CombatService.Forget(player)
	lastFire[player] = nil
	cooldowns[player] = nil
	bulletTimeUntil[player] = nil
	markedUntil[player] = nil
end

-- Bots shoot through the exact same validation and damage code as players.
function CombatService.BotFire(bot, origin, direction)
	onFire(bot, origin, direction, nil)
end

-- Seconds a shooter must wait between shots (their power-ups included).
function CombatService.GetBoltTime(player, match)
	return getStats(player, match).BoltTime
end

----------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------
function CombatService.Init()
	effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "Effects"
	effectsFolder.Parent = workspace

	decoyFolder = Instance.new("Folder")
	decoyFolder.Name = "Decoys"
	decoyFolder.Parent = workspace

	Remotes.Get("Fire").OnServerEvent:Connect(onFire)
	Remotes.Get("Ability").OnServerEvent:Connect(onAbility)
	Remotes.Get("Aim").OnServerEvent:Connect(onAim)

	Players.PlayerRemoving:Connect(function(player)
		lastFire[player] = nil
		cooldowns[player] = nil
		bulletTimeUntil[player] = nil
		markedUntil[player] = nil
		for _, d in ipairs(decoyFolder:GetChildren()) do
			if d:GetAttribute("OwnerUserId") == player.UserId then
				d:Destroy()
			end
		end
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DummyService</string>
          <string name="Source"><![CDATA[--[[
	DummyService.lua  (ServerScriptService.Server.DummyService)

	Practice dummies on the lobby shooting range, so you can test the sniper
	and your aim on your own. Some stand still, some strafe left and right,
	one bobs up and down like a player bunny hopping.

	Dummies are simple flat-coloured models with the attribute Dummy = true,
	and body parts named like a real character (Head, UpperTorso, ...) so
	headshots and body shots work exactly the same as on a player.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Palette = Config.Palette
local DummyService = {}

local folder
local dummies = {} -- { Model, Base = CFrame, Motion, Amount, Speed, Phase }

-- name, size, position (relative to the feet, facing +Z)
local BODY = {
	{ "LeftUpperLeg", Vector3.new(0.9, 2, 0.9), Vector3.new(-0.5, 1, 0) },
	{ "RightUpperLeg", Vector3.new(0.9, 2, 0.9), Vector3.new(0.5, 1, 0) },
	{ "LowerTorso", Vector3.new(2, 0.6, 1), Vector3.new(0, 2.3, 0) },
	{ "UpperTorso", Vector3.new(2, 1.6, 1), Vector3.new(0, 3.4, 0) },
	{ "LeftUpperArm", Vector3.new(0.8, 2, 0.8), Vector3.new(-1.45, 3.2, 0) },
	{ "RightUpperArm", Vector3.new(0.8, 2, 0.8), Vector3.new(1.45, 3.2, 0) },
	{ "Head", Vector3.new(1.15, 1.15, 1.15), Vector3.new(0, 4.85, 0) },
}

local function makeDummy(base)
	local model = Instance.new("Model")
	model.Name = "Dummy"
	model:SetAttribute("Dummy", true)
	model:SetAttribute("Health", Config.Lobby.DummyHealth)

	for _, spec in ipairs(BODY) do
		local part = Instance.new("Part")
		part.Name = spec[1]
		part.Size = spec[2]
		part.CFrame = base * CFrame.new(spec[3])
		part.Color = spec[1] == "Head" and Palette.PlayerB:Lerp(Color3.new(1, 1, 1), 0.25) or Palette.PlayerB
		part:SetAttribute("BaseColor", part.Color)
		part.Material = Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.Parent = model
	end
	model.WorldPivot = base

	-- health bar
	local bar = Instance.new("BillboardGui")
	bar.Name = "HealthBar"
	bar.Size = UDim2.fromScale(3.2, 0.32)
	bar.StudsOffsetWorldSpace = Vector3.new(0, 6.2, 0)
	bar.Adornee = model.Head
	bar.Parent = model
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Palette.UIBackground
	back.BorderSizePixel = 0
	back.Parent = bar
	Instance.new("UICorner").Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Palette.UIText
	fill.BorderSizePixel = 0
	fill.Parent = back
	Instance.new("UICorner").Parent = fill

	model.Parent = folder
	return model
end

local function setHealth(model, health)
	model:SetAttribute("Health", health)
	local fill = model:FindFirstChild("HealthBar") and model.HealthBar:FindFirstChild("Fill", true)
	if fill then
		local fraction = math.clamp(health / Config.Lobby.DummyHealth, 0, 1)
		fill.Size = UDim2.fromScale(fraction, 1)
		fill.BackgroundColor3 = fraction < 0.35 and Palette.UIDanger or Palette.UIText
	end
end

local function setShown(model, shown)
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") then
			part.Transparency = shown and 0 or 1
			part.CanQuery = shown
		end
	end
	if model:FindFirstChild("HealthBar") then
		model.HealthBar.Enabled = shown
	end
end

-- Deals damage to a dummy. Returns true if this hit "killed" it.
function DummyService.Damage(model, amount)
	if not model:GetAttribute("Dummy") or model:GetAttribute("Down") then
		return false
	end
	local health = (model:GetAttribute("Health") or Config.Lobby.DummyHealth) - amount
	setHealth(model, math.max(health, 0))

	-- flash white
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") then
			part.Color = Color3.new(1, 1, 1)
			TweenService:Create(part, TweenInfo.new(0.2), { Color = part:GetAttribute("BaseColor") }):Play()
		end
	end

	if health <= 0 then
		model:SetAttribute("Down", true)
		setShown(model, false)
		task.delay(Config.Lobby.DummyRespawnTime, function()
			if model.Parent then
				model:SetAttribute("Down", false)
				setHealth(model, Config.Lobby.DummyHealth)
				setShown(model, true)
			end
		end)
		return true
	end
	return false
end

-- All dummies that can currently be shot.
function DummyService.GetDummies()
	local list = {}
	for _, d in ipairs(dummies) do
		if d.Model.Parent and not d.Model:GetAttribute("Down") then
			table.insert(list, d.Model)
		end
	end
	return list
end

-- Torso positions of live dummies (for Homing Rounds in practice).
function DummyService.GetTargets()
	local list = {}
	for _, model in ipairs(DummyService.GetDummies()) do
		local torso = model:FindFirstChild("UpperTorso")
		if torso then
			table.insert(list, torso.Position)
		end
	end
	return list
end

--[[
	spots: list of { Position = Vector3 (feet), Motion = "Static"|"Strafe"|"Bob",
	                 Amount = studs, Speed = cycles per second }
	Dummies face +Z (toward the lobby).
]]
-- Adds dummies at `spots` (positions are offset by `origin`, e.g. an arena).
function DummyService.AddSpots(spots, origin)
	origin = origin or Vector3.zero
	for _, spot in ipairs(spots or {}) do
		local position = origin + spot.Position
		local face = spot.Face or Vector3.new(0, 0, 1)
		local base = CFrame.lookAt(position, position + face)
		table.insert(dummies, {
			Model = makeDummy(base),
			Base = base,
			Motion = spot.Motion or "Static",
			Amount = spot.Amount or 0,
			Speed = spot.Speed or 0.5,
			Phase = #dummies * 1.3,
		})
	end
end

function DummyService.Init(spots)
	folder = Instance.new("Folder")
	folder.Name = "Dummies"
	folder.Parent = workspace

	DummyService.AddSpots(spots)

	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, d in ipairs(dummies) do
			if d.Motion ~= "Static" and d.Model.Parent then
				local wave = math.sin(t * d.Speed * math.pi * 2 + d.Phase)
				-- strafe sideways (relative to the way the dummy faces) or bob up and down
				local offset = d.Motion == "Strafe" and d.Base.RightVector * (wave * d.Amount)
					or Vector3.new(0, (wave + 1) * 0.5 * d.Amount, 0)
				d.Model:PivotTo(d.Base + offset)
			end
		end
	end)
end

return DummyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">LightingSetup</string>
          <string name="Source"><![CDATA[--[[
	LightingSetup.lua  (ServerScriptService.Server.LightingSetup)

	Sets up Lighting from Config.Lighting: time of day, ambient colours and the
	post effects (Atmosphere, Bloom, ColorCorrection, SunRays) and clouds.

	NOTE: Lighting.Technology = Future cannot be set from a script; it is set in
	default.project.json (and you can double check it in Studio: Lighting >
	Technology).
]]

local Lighting = game:GetService("Lighting")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local LightingSetup = {}

local function getOrCreate(className, name)
	local existing = Lighting:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

function LightingSetup.Apply()
	local L = Config.Lighting

	Lighting.GlobalShadows = true
	Lighting.ClockTime = L.ClockTime
	Lighting.GeographicLatitude = L.GeographicLatitude
	Lighting.Brightness = L.Brightness
	Lighting.Ambient = L.Ambient
	Lighting.OutdoorAmbient = L.OutdoorAmbient
	Lighting.EnvironmentDiffuseScale = L.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = L.EnvironmentSpecularScale
	Lighting.ShadowSoftness = L.ShadowSoftness

	local atmosphere = getOrCreate("Atmosphere", "Atmosphere")
	for key, value in pairs(L.Atmosphere) do
		atmosphere[key] = value
	end

	local bloom = getOrCreate("BloomEffect", "Bloom")
	for key, value in pairs(L.Bloom) do
		bloom[key] = value
	end

	local cc = getOrCreate("ColorCorrectionEffect", "ColorCorrection")
	for key, value in pairs(L.ColorCorrection) do
		cc[key] = value
	end

	local sunRays = getOrCreate("SunRaysEffect", "SunRays")
	for key, value in pairs(L.SunRays) do
		sunRays[key] = value
	end

	if L.Clouds then
		local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		for key, value in pairs(L.Clouds) do
			clouds[key] = value
		end
		clouds.Parent = workspace.Terrain
	end

	workspace.Gravity = Config.Movement.Gravity
end

return LightingSetup
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[--[[
	LobbyBuilder.lua  (ServerScriptService.Server.LobbyBuilder)

	The lobby: a round, enclosed hall (a rotunda) where everyone waits
	between matches. Paved paths lead from the centre to everything there is
	to do, set in alcoves around the curved wall.

	TOP VIEW (-Z = north)

	                     [ SHOOTING RANGE ]
	                            ||  tunnel
	              .-'''''''''''''''''''''''''''-.
	         .-' PORTAL       |       GARDEN    '-.
	       /         \        |        /           \
	      |  CRATE ====== ( SUNKEN CENTRE ) ====== DUEL |
	      |  SHOP          (rifle statue,          AREA |
	       \         /     skylight dome)  \           /
	         '-. WALL RUN     |      PARKOUR      .-'
	              '-.______ STAGE ___________.-'

	  * Centre: a sunken ring with smooth steps down, the giant rifle statue
	    (the imported PGM 338 if you have it, otherwise the VX-7) and a ring
	    of columns holding up a glass skylight dome. You spawn here.
	  * The wall: panels with glowing trims, a plinth, a cornice and lit
	    sconces. The ceiling has radial beams and hanging lights.
	  * North: a tunnel with a gate into the shooting range.
	  * East: the duel area, a raised dais with team-coloured pads.
	  * West: the crate shop, a storefront with arches, an awning, a counter,
	    shelves and three crates on pedestals. It's a placeholder: each pedestal
	    has a marker in Lobby.CrateSpots with a "Rarity" attribute, for the
	    future crate / rifle skin system.
	  * South: the stage with the title sign.
	  * Diagonals: the Playground portal, an indoor garden, a parkour corner and
	    a wall-run wall with a low ceiling (Magnetic Boots).

	Detail parts use builder.decor (no collision), so paths stay smooth.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapBuilder = require(script.Parent.MapBuilder)

local P = Config.Palette
local C = Config.MapPalette
local V = Vector3.new
local rad = math.rad

local LobbyBuilder = {}

local R = 64 -- inner radius of the hall
local WALL_H = 26 -- ceiling height
local PIT_R = 22 -- the sunken centre
local PIT_DEPTH = 2.5
local COLUMN_R = 31 -- the ring of columns holding up the skylight
local SEGMENTS = 72 -- more segments = smoother circles

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------

-- A point at `radius` from the centre, `deg` degrees clockwise from north.
local function polar(radius, deg, y)
	local a = rad(deg)
	return V(math.sin(a) * radius, y or 0, -math.cos(a) * radius)
end

-- Unit vector pointing outward at `deg`.
local function outward(deg)
	local a = rad(deg)
	return V(math.sin(a), 0, -math.cos(a))
end

-- A CFrame at polar(radius, deg, y) whose -Z faces the centre.
local function facingIn(radius, deg, y)
	local pos = polar(radius, deg, y)
	return CFrame.lookAt(pos, V(0, y or 0, 0))
end

-- A sign board with a title and a subtitle (the text is on the board's front, -Z).
local function sign(model, size, cf, title, subtitle, accent)
	local board = Instance.new("Part")
	board.Anchored = true
	board.Size = size
	board.CFrame = cf
	board.Color = P.UIPanel
	board.Material = Enum.Material.SmoothPlastic
	board.CanCollide = false
	board.Parent = model
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = board
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, subtitle and 0.6 or 1)
	t.Text = title
	t.TextScaled = true
	t.FontFace = Font.new(Config.UI.FontFamily, Enum.FontWeight.Heavy)
	t.TextColor3 = P.UIText
	t.Parent = gui
	if subtitle then
		local s = t:Clone()
		s.Position = UDim2.fromScale(0.05, 0.62)
		s.Size = UDim2.fromScale(0.9, 0.3)
		s.Text = subtitle
		s.FontFace = Font.new(Config.UI.FontFamily, Enum.FontWeight.Bold)
		s.TextColor3 = accent or P.UIAccent
		s.Parent = gui
	end
	return board
end

local function neon(b, parts)
	return b.material(parts, Enum.Material.Neon)
end

-- Adds a light to the first part (indoor lighting).
-- Plain accent trim (not glowing; Neon + bloom everywhere looked harsh).
local function accent(_b, parts)
	return parts
end

-- Indoor lights are kept soft: LIGHT_SCALE dims every light in the hall.
local LIGHT_SCALE = 0.45
local function light(parts, color, range, brightness)
	local part = parts and parts[1]
	if part then
		local l = Instance.new("PointLight")
		l.Color = color
		l.Range = (range or 24) * 0.75
		l.Brightness = (brightness or 1.4) * LIGHT_SCALE
		l.Shadows = false
		l.Parent = part
	end
	return parts
end

local function bar(b, a, c, w, color)
	return b.part(V(w, w, (c - a).Magnitude), CFrame.lookAt((a + c) / 2, c), color)
end

local function plant(b, pos, scale)
	scale = scale or 1
	b.block(V(6, 1.4, 6), pos + V(0, 0.7, 0), C.Stone)
	b.cylinder(6 * scale, 1.2 * scale, pos + V(0, 1.4 + 3 * scale, 0), C.Trunk)
	b.decor(function()
		b.block(V(5.2, 0.2, 5.2), pos + V(0, 1.45, 0), C.Soil)
		b.block(V(6.4, 0.3, 6.4), pos + V(0, 1.3, 0), C.Trim)
		for k = 0, 2 do
			local a = k * 2.1 + pos.X
			local from = pos + V(0, 1.4 + 5 * scale, 0)
			bar(b, from, from + V(math.cos(a) * 2.4, 2.4, math.sin(a) * 2.4) * scale, 0.45 * scale, C.Trunk)
		end
	end)
	b.soft(function()
		b.ball(7.4 * scale, pos + V(0, 9 * scale, 0), C.Foliage)
		b.ball(5.4 * scale, pos + V(2.4, 8, 1.2) * scale, C.FoliageDark)
		b.ball(5.4 * scale, pos + V(-2.2, 8.4, -1.6) * scale, C.FoliageLight)
		b.ball(4.6 * scale, pos + V(0.6, 11.6, 0.4) * scale, C.FoliageLight)
	end)
end

local function lampPost(b, pos)
	b.cylinder(9, 0.45, pos + V(0, 4.5, 0), C.Metal)
	b.decor(function()
		b.cylinder(1.2, 1.1, pos + V(0, 0.6, 0), C.Dark)
		b.block(V(1.5, 0.35, 1.5), pos + V(0, 9.1, 0), C.Dark)
		light(neon(b, b.block(V(1, 1.2, 1), pos + V(0, 9.9, 0), C.LampLight)), C.LampLight, 22, 1.2)
		b.block(V(1.7, 0.35, 1.7), pos + V(0, 10.65, 0), C.Dark)
	end)
end

local function bench(b, cf)
	b.decor(function()
		for k = -1, 1 do
			b.part(V(6, 0.22, 0.5), cf * CFrame.new(0, 1.45, k * 0.6), C.Wood)
		end
		b.part(V(6, 0.4, 0.22), cf * CFrame.new(0, 2.2, 0.85), C.Wood)
		b.part(V(6, 0.4, 0.22), cf * CFrame.new(0, 2.8, 0.85), C.Wood)
		for _, x in ipairs({ -2.6, 2.6 }) do
			b.part(V(0.3, 1.4, 1.8), cf * CFrame.new(x, 0.7, 0), C.Dark)
			b.part(V(0.3, 1.6, 0.3), cf * CFrame.new(x, 2.2, 0.85), C.Dark)
		end
	end)
end

local function flowers(b, pos)
	b.decor(function()
		for k = 0, 6 do
			local a = k * 0.9 + pos.Z
			local r = 0.6 + (k % 3) * 0.7
			b.ball(0.7, pos + V(math.cos(a) * r, 0.5, math.sin(a) * r), C.Awning[(k % 3) + 1])
		end
		b.ball(1.6, pos + V(0, 0.3, 0), C.FoliageDark)
	end)
end

-- A loot crate (placeholder art).
local function crate(b, pos, color, size)
	size = size or 1
	b.block(V(4.4, 3, 4.4) * size, pos + V(0, 1.5 * size, 0), C.Dark)
	b.decor(function()
		b.block(V(4.6, 0.9, 4.6) * size, pos + V(0, 3.4 * size, 0), color)
		neon(b, b.block(V(4.5, 0.18, 4.5) * size, pos + V(0, 3 * size, 0), color))
		for _, x in ipairs({ -1.5, 1.5 }) do
			b.block(V(0.35, 3.1, 4.5) * size, pos + V(x * size, 1.5 * size, 0), C.Metal)
		end
		b.block(V(0.3, 1, 1) * size, pos + V(2.3 * size, 2.3 * size, 0), P.UIText)
		neon(b, b.ball(0.5 * size, pos + V(2.45 * size, 2.3 * size, 0), color))
	end)
end

-- A ring of blocks between radii ri and ro (an annulus), `thick` tall, top at yTop.
-- skip(deg) can leave gaps.
local function ring(b, ri, ro, yTop, thick, color, count, skip)
	local parts = {}
	for i = 0, count - 1 do
		local deg = (i + 0.5) * 360 / count
		if not (skip and skip(deg)) then
			local mid = (ri + ro) / 2
			local width = 2 * math.pi * ro / count * 1.06
			local pos = polar(mid, deg, yTop - thick / 2)
			for _, part in ipairs(b.part(V(width, thick, ro - ri), CFrame.lookAt(pos, pos + outward(deg)), color)) do
				table.insert(parts, part)
			end
		end
	end
	return parts
end

-- A radial paved path from radius r1 to r2 at `deg`, `width` wide.
local function path(b, r1, r2, deg, width, color)
	local a, c = polar(r1, deg), polar(r2, deg)
	local mid = (a + c) / 2
	local len = r2 - r1
	local frame = CFrame.lookAt(mid, c)
	b.decor(function()
		b.part(V(width, 0.12, len), frame * CFrame.new(0, 0.06, 0), color or C.Sidewalk)
		for _, s in ipairs({ -1, 1 }) do
			b.part(V(0.5, 0.25, len), frame * CFrame.new(s * (width / 2 + 0.25), 0.12, 0), C.Trim)
			accent(b, b.part(V(0.18, 0.06, len), frame * CFrame.new(s * (width / 2 - 0.4), 0.13, 0), C.Trim))
		end
		for z = -len / 2 + 3, len / 2 - 3, 3 do
			b.part(V(width - 1, 0.02, 0.12), frame * CFrame.new(0, 0.13, z), C.Curb)
		end
	end)
	return frame, len
end

----------------------------------------------------------------------------
-- Build
----------------------------------------------------------------------------
function LobbyBuilder.Build()
	local model = Instance.new("Model")
	model.Name = "Lobby"
	local b = MapBuilder.MakeBuilder(Vector3.zero, model)
	local isRangeGap = function(deg)
		return deg < 8 or deg > 352
	end

	-- FLOOR: main ring, smooth steps down into the sunken centre ---------------------
	ring(b, PIT_R + 5.5, R + 4, 0, 3, C.Stone, SEGMENTS)
	b.cylinder(1, PIT_R * 2 + 0.6, V(0, -PIT_DEPTH - 0.5, 0), C.Sidewalk) -- pit floor
	for i = 0, SEGMENTS - 1 do -- the steps: an invisible smooth ramp ring...
		local deg = (i + 0.5) * 360 / SEGMENTS
		local width = 2 * math.pi * (PIT_R + 6) / SEGMENTS * 1.08
		b.invisible(b.ramp(polar(PIT_R, deg, -PIT_DEPTH), outward(deg), 6, PIT_DEPTH, width, C.Stone))
	end
	b.decor(function()
		-- ...and the steps you see
		for k = 0, 2 do
			ring(b, PIT_R + k * 2, PIT_R + 6, -PIT_DEPTH + (k + 1) * PIT_DEPTH / 3, PIT_DEPTH / 3 + 0.02, k % 2 == 0 and C.Stone or C.Sidewalk, SEGMENTS)
			ring(b, PIT_R + k * 2, PIT_R + k * 2 + 0.3, -PIT_DEPTH + (k + 1) * PIT_DEPTH / 3 + 0.03, 0.06, C.Trim, SEGMENTS) -- step nosing
		end
		-- floor pattern: radial joints and rings
		for i = 0, 23 do
			local deg = i * 15
			local a, c = polar(PIT_R + 6, deg, 0.02), polar(R, deg, 0.02)
			b.part(V(0.15, 0.04, (c - a).Magnitude), CFrame.lookAt((a + c) / 2, c), C.Curb)
		end
		for _, r in ipairs({ 40, 52 }) do
			ring(b, r, r + 0.3, 0.04, 0.04, C.Curb, SEGMENTS)
		end
		-- pit floor: inlaid rings
		b.cylinder(0.1, PIT_R * 2 - 2, V(0, -PIT_DEPTH + 0.05, 0), C.Stone)
		b.cylinder(0.12, 30, V(0, -PIT_DEPTH + 0.06, 0), C.Trim)
		b.cylinder(0.14, 29.2, V(0, -PIT_DEPTH + 0.07, 0), C.Sidewalk)
		-- star inlay: alternating tiles around the statue
		for i = 0, 15 do
			local deg = i * 22.5
			local pos = polar(11, deg, -PIT_DEPTH + 0.1)
			b.part(V(3.2, 0.1, 6), CFrame.lookAt(pos, pos + outward(deg)), i % 2 == 0 and C.Stone or C.Concrete)
		end
	end)

	-- OUTER WALL (with the tunnel gap to the north) + detail --------------------------
	ring(b, R, R + 3, WALL_H, WALL_H, C.BuildingA, SEGMENTS, isRangeGap)
	b.decor(function()
		ring(b, R - 1, R, 1.6, 1.6, C.Trim, SEGMENTS, isRangeGap) -- plinth
		ring(b, R - 1.4, R, WALL_H - 1, 1.2, C.Stone, SEGMENTS, isRangeGap) -- cornice
		ring(b, R - 0.8, R, 10.4, 0.6, C.Stone, SEGMENTS, isRangeGap) -- band
		for i = 0, SEGMENTS - 1 do
			local deg = (i + 0.5) * 360 / SEGMENTS
			if not isRangeGap(deg) then
				local w = 2 * math.pi * R / SEGMENTS
				-- recessed panel with a glowing outline (lower), lit window strip (upper)
				local cf = facingIn(R - 0.1, deg, 5.8)
				b.part(V(w * 0.78, 7, 0.2), cf, C.FrameDark)
				b.part(V(w * 0.68, 6.2, 0.3), cf * CFrame.new(0, 0, -0.1), C.BuildingB)
				b.part(V(w * 0.7, 0.15, 0.32), cf * CFrame.new(0, -3.2, -0.1), C.Trim)
				local up = facingIn(R - 0.1, deg, 17)
				b.part(V(w * 0.7, 9, 0.2), up, C.FrameDark)
				b.material(b.part(V(w * 0.6, 8.2, 0.3), up * CFrame.new(0, 0, -0.1), C.Window), Enum.Material.SmoothPlastic, 0.15)
				-- pilaster between panels
				local edge = facingIn(R - 0.5, deg + 180 / SEGMENTS, WALL_H / 2)
				b.part(V(1.4, WALL_H - 2, 1), edge, C.Stone)
				-- a lit sconce on every third pilaster
				if i % 3 == 0 then
					local sconce = facingIn(R - 1.3, deg + 180 / SEGMENTS, 12.5)
					b.part(V(1.2, 1.6, 0.8), sconce, C.Dark)
					light(neon(b, b.part(V(0.8, 1, 0.5), sconce * CFrame.new(0, 0.2, -0.4), C.LampLight)), C.LampLight, 30, 1.3)
				end
			end
		end
	end)

	-- CEILING: ring roof, radial beams, hanging lights; skylight over the centre ------
	ring(b, COLUMN_R - 1.5, R + 3, WALL_H + 1.5, 1.5, C.Roof, SEGMENTS)
	for i = 0, 11 do
		local deg = i * 30 + 15
		b.cylinder(WALL_H, 2.6, polar(COLUMN_R, deg, WALL_H / 2), C.BuildingA) -- columns
	end
	b.decor(function()
		for i = 0, 11 do
			local deg = i * 30 + 15
			local base = polar(COLUMN_R, deg, 0)
			b.block(V(3.6, 1.2, 3.6), base + V(0, 0.6, 0), C.Stone)
			b.block(V(3.8, 1.2, 3.8), base + V(0, WALL_H - 0.6, 0), C.Stone)
			b.cylinder(0.3, 2.9, base + V(0, 3, 0), C.Trim)
			for f = 0, 3 do -- fluting
				b.part(V(0.3, WALL_H - 4, 2.75), CFrame.new(base + V(0, WALL_H / 2, 0)) * CFrame.Angles(0, f * math.pi / 4, 0), C.Stone)
			end
			if i % 2 == 0 then -- potted plant at the base
				local pot = polar(COLUMN_R - 3, deg, 0)
				b.cylinder(1.6, 2.4, pot + V(0, 0.8, 0), C.Trim)
				b.ball(2.6, pot + V(0, 2.4, 0), C.FoliageDark)
				b.ball(1.8, pot + V(0.5, 3.2, 0.3), C.Foliage)
			end
			-- banners between columns, alternating team colours
			local mid = polar(COLUMN_R, deg + 15, 17)
			b.part(V(4.5, 9, 0.3), CFrame.lookAt(mid, V(0, 17, 0)), i % 2 == 0 and P.PlayerA or P.PlayerB)
			-- radial beams under the ceiling
			local a, c = polar(COLUMN_R, deg, WALL_H - 0.8), polar(R, deg, WALL_H - 0.8)
			b.part(V(1.2, 1.4, (c - a).Magnitude), CFrame.lookAt((a + c) / 2, c), C.Trim)
			-- hanging light halfway along each beam
			local hang = polar((COLUMN_R + R) / 2, deg + 15, WALL_H)
			b.block(V(0.15, 5, 0.15), hang - V(0, 2.5, 0), C.Metal)
			b.block(V(2.6, 0.6, 2.6), hang - V(0, 5.2, 0), C.Dark)
			light(neon(b, b.block(V(2, 0.3, 2), hang - V(0, 5.6, 0), C.LampLight)), C.LampLight, 32, 1.4)
		end
		ring(b, R - 2, R + 3, WALL_H + 0.2, 0.4, C.Trim, SEGMENTS) -- ceiling edge trim
		for _, r in ipairs({ 40, 52 }) do -- ceiling beam rings (coffers)
			ring(b, r, r + 1.2, WALL_H - 0.1, 1.2, C.Trim, SEGMENTS)
		end
		-- skylight drum + glass dome over the centre
		ring(b, COLUMN_R - 1.5, COLUMN_R, WALL_H + 7, 7, C.BuildingA, SEGMENTS)
		local glass = b.cylinder(0.5, (COLUMN_R - 0.5) * 2, V(0, WALL_H + 7.25, 0), C.Glass)
		b.material(glass, Enum.Material.Glass, 0.1)
		for _, part in ipairs(glass) do
			part.Transparency = 0.6
		end
		for i = 0, 7 do -- dome ribs
			local deg = i * 45
			bar(b, polar(COLUMN_R - 1, deg, WALL_H + 7.5), V(0, WALL_H + 9, 0), 0.6, C.Trim)
		end
		ring(b, COLUMN_R - 2, COLUMN_R, WALL_H + 0.2, 0.4, C.Trim, SEGMENTS)
	end)
	-- the ceiling also covers everything outside the dome edge (no gaps to the sky)
	ring(b, COLUMN_R - 2, COLUMN_R, WALL_H + 7.5, 0.5, C.Roof, 24)

	-- CENTRE: RIFLE STATUE ------------------------------------------------------------
	local pitY = -PIT_DEPTH
	b.cylinder(0.8, 12, V(0, pitY + 0.4, 0), C.Stone) -- statue step
	b.cylinder(3, 8, V(0, pitY + 2.3, 0), C.BuildingA) -- pedestal
	b.decor(function()
		b.cylinder(0.5, 8.6, V(0, pitY + 3.6, 0), C.Trim)
		b.cylinder(0.2, 8.8, V(0, pitY + 1.2, 0), C.Trim)
		b.block(V(0.9, 4.2, 0.9), V(0, pitY + 5.6, 0), C.Metal) -- support post
	end)
	local okStatue, GunModel = pcall(require, ReplicatedStorage.Shared.GunModel)
	if okStatue and type(GunModel) == "table" and GunModel.Build then
		local statue = Instance.new("Model")
		statue.Name = "RifleStatue"
		local scale = 3
		local built = GunModel.Build(statue, { Scale = scale, Anchored = true, CastShadow = true, Effects = false })
		GunModel.Place(built, CFrame.new(0, pitY + 7.2, 0) * CFrame.Angles(0, rad(40), 0) * CFrame.Angles(rad(28), 0, 0), scale)
		for _, part in pairs(built.Parts) do
			part.CanCollide = false
		end
		statue.Parent = model
	end
	-- benches around the pit, facing the statue
	for k = 0, 3 do
		local deg = 45 + k * 90
		bench(b, facingIn(PIT_R - 4, deg, pitY))
	end

	-- GLASS RAILING around the top of the steps (gaps where the paths are)
	local function onPath(deg)
		for _, d in ipairs({ 0, 90, 180, 270 }) do
			if math.abs((deg - d + 180) % 360 - 180) < 11 then
				return true
			end
		end
		for _, d in ipairs({ 45, 135, 225, 315 }) do
			if math.abs((deg - d + 180) % 360 - 180) < 7 then
				return true
			end
		end
		return false
	end
	local railR = PIT_R + 6.6
	for i = 0, SEGMENTS - 1 do
		local deg = (i + 0.5) * 360 / SEGMENTS
		if not onPath(deg) then
			local w = 2 * math.pi * railR / SEGMENTS * 1.04
			local cf = facingIn(railR, deg, 1.6)
			local panel = b.part(V(w, 2.6, 0.25), cf, C.Glass)
			b.material(panel, Enum.Material.Glass, 0.1)
			for _, part in ipairs(panel) do
				part.Transparency = 0.55
			end
			b.decor(function()
				b.part(V(w + 0.05, 0.3, 0.45), cf * CFrame.new(0, 1.45, 0), C.Trim) -- handrail
				if i % 3 == 0 then
					b.part(V(0.3, 3.1, 0.3), cf * CFrame.new(-w / 2, 0, 0), C.Metal) -- post
				end
			end)
		end
	end

	-- PATHS (from the top of the steps out to each place) ------------------------------
	local stepTop = PIT_R + 6
	for _, deg in ipairs({ 0, 90, 180, 270 }) do
		local frame, len = path(b, stepTop, 50, deg, 10)
		for _, s in ipairs({ -1, 1 }) do
			lampPost(b, (frame * CFrame.new(s * 7, 0, 0)).Position)
		end
	end
	for _, deg in ipairs({ 45, 135, 225, 315 }) do
		path(b, stepTop, 46, deg, 6, C.Stone)
	end
	-- planters + flowers between the paths
	for k = 0, 7 do
		local deg = 22.5 + k * 45
		local pos = polar(38, deg)
		b.part(V(7, 1.2, 3), CFrame.lookAt(pos + V(0, 0.6, 0), V(0, 0.6, 0)), C.Stone)
		b.decor(function()
			b.part(V(6.4, 0.2, 2.4), CFrame.lookAt(pos + V(0, 1.25, 0), V(0, 1.25, 0)), C.Soil)
		end)
		flowers(b, pos + V(1.5, 1.1, 0))
		flowers(b, pos + V(-1.5, 1.1, 0))
	end

	-- NORTH: TUNNEL TO THE SHOOTING RANGE -----------------------------------------------
	b.block(V(18, 3, 14), V(0, -1.5, -R - 4), C.Stone) -- tunnel floor
	b.block(V(2, WALL_H, 14), V(-9, WALL_H / 2, -R - 4), C.BuildingA, "X") -- tunnel sides
	b.block(V(20, 2, 14), V(0, 15, -R - 4), C.BuildingA) -- tunnel ceiling
	b.block(V(20, WALL_H - 14, 2), V(0, (WALL_H + 14) / 2 + 1, -R + 2), C.BuildingA) -- wall above the gate
	b.decor(function()
		neon(b, b.block(V(16, 0.4, 0.4), V(0, 13.6, -R + 2.8), P.AccentA))
		for _, x in ipairs({ -7.6, 7.6 }) do
			b.block(V(1.2, 14, 1.2), V(x, 7, -R + 2.6), C.Stone) -- gate frame
			light(neon(b, b.block(V(0.3, 10, 0.3), V(x * 1.06, 6, -R - 4), P.AccentA)), P.AccentA, 16, 0.8)
		end
		for z = -R - 9, -R + 1, 3.3 do
			b.block(V(17.6, 0.6, 0.6), V(0, 13.7, z), C.Trim) -- ceiling ribs
		end
	end)
	sign(model, V(16, 3, 0.5), CFrame.new(0, 17.5, -R + 0.8) * CFrame.Angles(0, math.pi, 0), "SHOOTING RANGE", nil)

	-- EAST: DUEL AREA -----------------------------------------------------------------------
	b.block(V(12, 1.4, 30), V(56, 0.7, 0), C.Stone)
	b.ramp(V(48, 0, 0), V(1, 0, 0), 2.5, 1.4, 12, C.Stone)
	b.decor(function()
		accent(b, b.block(V(12.2, 0.2, 30.2), V(56, 1.45, 0), P.AccentA))
		for i, z in ipairs({ -7.5, 7.5 }) do
			local color = i == 1 and P.PlayerA or P.PlayerB
			neon(b, b.cylinder(0.15, 10, V(56, 1.5, z), color))
			b.cylinder(0.18, 8.2, V(56, 1.53, z), C.Dark)
			neon(b, b.cylinder(0.2, 2, V(56, 1.56, z), color))
			light(neon(b, b.block(V(1, 12, 0.6), V(61, 7.4, z * 1.9), color)), color, 18, 1)
		end
		-- canopy on two posts
		for _, z in ipairs({ -14, 14 }) do
			b.block(V(1, 14, 1), V(50.5, 8.4, z), C.Metal)
		end
		b.block(V(13, 0.8, 30), V(56.5, 15.6, 0), C.BuildingA)
		accent(b, b.block(V(13.2, 0.25, 30.2), V(56.5, 15.1, 0), P.AccentA))
	end)
	sign(model, V(24, 8, 1), CFrame.new(R - 1.6, 9, 0) * CFrame.Angles(0, math.pi / 2, 0), "1v1 DUEL", "FIND MATCH [F]  -  DUEL A PLAYER [U]")

	-- WEST: CRATE SHOP ------------------------------------------------------------------------
	local front = -48
	b.block(V(14, 1, 30), V(-55, 0.5, 0), C.Dark) -- shop floor
	b.block(V(14, 14, 1.4), V(-55, 7, 15), C.BuildingC, "Z") -- side walls
	b.block(V(15, 1.4, 31.4), V(-55.5, 14.7, 0), C.Roof) -- shop roof
	for _, z in ipairs({ -15, -5, 5, 15 }) do
		b.block(V(1.6, 13.4, 1.6), V(front, 7.7, z), C.BuildingC) -- arch pillars
	end
	b.block(V(1.6, 2.2, 31.6), V(front, 13.1, 0), C.BuildingC) -- lintel
	b.block(V(3, 3.4, 18), V(-60.5, 2.7, 0), C.Wood) -- counter
	b.decor(function()
		accent(b, b.block(V(14.2, 0.2, 30.2), V(-55, 1.05, 0), P.AccentB))
		b.block(V(15.6, 0.9, 32), V(-55.5, 15.8, 0), C.Stone) -- cornice
		b.block(V(3.2, 0.4, 18.2), V(-60.5, 4.55, 0), C.Stone)
		neon(b, b.block(V(0.2, 0.3, 18), V(-58.9, 4.2, 0), P.AccentB))
		for _, y in ipairs({ 5.6, 9.4 }) do -- shelves of crates
			b.block(V(1.6, 0.3, 24), V(-61.8, y, 0), C.Wood)
			for k = -2, 2 do
				local rarity = ({ "Common", "Rare", "Epic", "Legendary" })[(k + 3) % 4 + 1]
				local color = Config.Rarity[rarity].Color
				b.block(V(1.4, 1.4, 1.4), V(-61.8, y + 0.85, k * 4.4), C.Dark)
				neon(b, b.block(V(1.45, 0.15, 1.45), V(-61.8, y + 1.2, k * 4.4), color))
			end
		end
		for k = -7, 7 do -- striped awning
			b.part(V(4, 0.3, 2), CFrame.new(-46.4, 11.8, k * 2) * CFrame.Angles(0, 0, rad(18)), k % 2 == 0 and P.AccentB or C.RoadWhite)
		end
		light(neon(b, b.block(V(10, 0.25, 0.25), V(-55, 13.8, 0), C.LampLight)), C.LampLight, 24, 1.2)
	end)
	sign(model, V(16, 3.6, 0.6), CFrame.new(front + 0.6, 18.2, 0) * CFrame.Angles(0, -math.pi / 2, 0), "CRATES", "RIFLE SKINS - COMING SOON", P.AccentB)
	local spots = Instance.new("Folder")
	spots.Name = "CrateSpots"
	spots.Parent = model
	for i, info in ipairs({ { -9, "Rare" }, { 0, "Legendary" }, { 9, "Epic" } }) do
		local z, rarity = info[1], info[2]
		local color = Config.Rarity[rarity].Color
		local base = V(-52.5, 1, z)
		b.cylinder(1.4, 5.4, base + V(0, 0.7, 0), C.Stone)
		b.decor(function()
			light(neon(b, b.cylinder(0.2, 5.7, base + V(0, 1.4, 0), color)), color, 10, 1)
		end)
		crate(b, base + V(0, 1.4, 0), color, 0.9)
		local spot = Instance.new("Part")
		spot.Name = "CrateSpot" .. i
		spot.Anchored = true
		spot.CanCollide = false
		spot.CanQuery = false
		spot.Transparency = 1
		spot.Size = V(4, 0.2, 4)
		spot.CFrame = CFrame.new(base + V(0, 1.5, 0))
		spot:SetAttribute("Rarity", rarity)
		spot.Parent = spots
	end

	-- VENDING MACHINES + BINS ---------------------------------------------------------------
	local function vending(cf, color)
		b.part(V(4, 7, 3), cf * CFrame.new(0, 3.5, 0), color)
		b.decor(function()
			b.material(b.part(V(2.6, 4, 0.2), cf * CFrame.new(-0.4, 4.2, -1.55), C.Glass), Enum.Material.Glass, 0.2)
			for row = 0, 3 do
				for col = 0, 2 do
					b.part(V(0.5, 0.6, 0.3), cf * CFrame.new(-1.2 + col * 0.8, 2.8 + row * 0.9, -1.35), C.Awning[((row + col) % 3) + 1])
				end
			end
			b.part(V(0.6, 2, 0.2), cf * CFrame.new(1.4, 4.4, -1.55), C.Dark) -- keypad
			light(neon(b, b.part(V(3.6, 0.6, 0.2), cf * CFrame.new(0, 6.5, -1.55), C.LampLight)), color, 10, 0.6)
		end)
	end
	vending(facingIn(R - 3, 243, 0), P.PlayerB)
	vending(facingIn(R - 3, 297, 0), P.AccentA)
	vending(facingIn(R - 3, 117, 0), P.PlayerA)
	for _, deg in ipairs({ 20, 160, 200, 340 }) do -- bins by the paths
		local pos = polar(31, deg, 0)
		b.decor(function()
			b.cylinder(2.4, 1.6, pos + V(0, 1.2, 0), C.Metal)
			b.cylinder(0.3, 1.8, pos + V(0, 2.5, 0), C.Dark)
		end)
	end

	-- SOUTH: STAGE --------------------------------------------------------------------------
	b.block(V(36, 3, 12), V(0, 1.5, 55), C.Stone)
	b.ramp(V(0, 0, 44), V(0, 0, 1), 5, 3, 16, C.Stone)
	b.decor(function()
		accent(b, b.block(V(36.4, 0.3, 12.4), V(0, 3.05, 55), P.AccentA))
		for _, x in ipairs({ -15, 15 }) do
			b.block(V(4, 5, 3), V(x, 5.5, 58), C.Dark) -- speakers
			b.block(V(3.4, 3, 2.6), V(x, 9.5, 58), C.Dark)
			b.cylinder(0.2, 2.4, nil, C.Metal, nil, CFrame.new(x, 5.5, 56.4) * CFrame.Angles(0, rad(90), 0))
			b.cylinder(0.2, 1.6, nil, C.Metal, nil, CFrame.new(x, 9.5, 56.6) * CFrame.Angles(0, rad(90), 0))
		end
		for x = -12, 12, 6 do -- light rig hanging from the ceiling
			b.block(V(0.15, 4, 0.15), V(x, WALL_H - 2, 51), C.Metal)
			b.block(V(1.2, 1.4, 1.2), V(x, WALL_H - 4.6, 51), C.Dark)
			light(neon(b, b.block(V(0.9, 0.3, 0.9), V(x, WALL_H - 5.4, 51), x % 12 == 0 and P.AccentA or P.AccentB)), x % 12 == 0 and P.AccentA or P.AccentB, 20, 1)
		end
		b.block(V(30, 0.5, 0.5), V(0, WALL_H - 4, 51), C.Metal)
	end)
	sign(model, V(28, 10, 1), CFrame.new(0, 14, R - 2.2), "SNIPER DUEL", ("1v1  -  FIRST TO %d"):format(Config.Match.RoundsToWin))

	-- NORTH-EAST: INDOOR GARDEN ------------------------------------------------------------
	plant(b, polar(52, 55), 1)
	plant(b, polar(56, 66), 0.85)
	b.cylinder(0.8, 12, polar(50, 28, 0.4), C.Stone) -- pond
	b.decor(function()
		b.material(b.cylinder(0.3, 10.4, polar(50, 28, 0.75), C.Water), Enum.Material.SmoothPlastic, 0.3)
		b.cylinder(0.12, 2, polar(49, 26, 0.95), C.Foliage)
		b.cylinder(0.12, 1.6, polar(52, 31, 0.95), C.Foliage)
		for k = 0, 5 do
			local pos = polar(50, 28) + V(math.cos(k * 1.05) * 6.4, 0.6, math.sin(k * 1.05) * 6.4)
			b.ball(1.4 + (k % 2) * 0.6, pos, C.Concrete) -- rocks
		end
	end)
	bench(b, facingIn(44, 40, 0))

	-- NORTH-WEST: PLAYGROUND PORTAL -----------------------------------------------------------
	local portalDeg = 315
	local portalBase = polar(52, portalDeg, 0)
	local facing = -outward(portalDeg)
	local across = V(-facing.Z, 0, facing.X)
	b.cylinder(1, 14, portalBase + V(0, 0.5, 0), C.Stone)
	b.decor(function()
		accent(b, b.cylinder(0.12, 14.4, portalBase + V(0, 1.02, 0), P.AccentA))
		local centre = portalBase + V(0, 7.5, 0)
		for k = 0, 23 do
			local a = k / 24 * math.pi * 2
			local pos = centre + across * math.cos(a) * 6 + V(0, math.sin(a) * 6, 0)
			local tangent = across * -math.sin(a) + V(0, math.cos(a), 0)
			b.part(V(1.3, 1.3, 1.9), CFrame.lookAt(pos, pos + tangent), k % 2 == 0 and C.BuildingA or C.Trim)
		end
		local disc = b.cylinder(0.2, 11.2, nil, P.AccentA, nil, CFrame.lookAt(centre, centre + facing) * CFrame.Angles(0, rad(90), 0))
		light(neon(b, disc), P.AccentA, 20, 1.2)
		for _, part in ipairs(disc) do
			part.Transparency = 0.55
		end
	end)
	sign(model, V(10, 2.2, 0.4), CFrame.lookAt(portalBase + facing * 5.5 + V(0, 2.2, 0), portalBase + facing * 12 + V(0, 2.2, 0)), "PLAYGROUND  [G]", nil)

	-- SOUTH-EAST: PARKOUR -----------------------------------------------------------------------
	local pk = function(r, deg, y)
		return polar(r, deg, y)
	end
	b.ramp(pk(44, 125), outward(125), 6, 3, 6, P.AccentB)
	b.part(V(6, 3, 6), CFrame.lookAt(pk(53, 125, 1.5), pk(53, 125, 1.5) + outward(125)), P.AccentA)
	b.part(V(6, 6, 6), CFrame.lookAt(pk(53, 140, 3), pk(53, 140, 3) + outward(140)), P.Mid)
	b.part(V(6, 9, 6), CFrame.lookAt(pk(55, 155, 4.5), pk(55, 155, 4.5) + outward(155)), P.AccentA)
	b.decor(function()
		for _, info in ipairs({ { 53, 125, 3 }, { 53, 140, 6 }, { 55, 155, 9 } }) do
			local pos = pk(info[1], info[2], info[3] + 0.1)
			accent(b, b.part(V(6.2, 0.25, 6.2), CFrame.lookAt(pos, pos + outward(info[2])), P.AccentA))
		end
	end)

	-- SOUTH-WEST: WALL-RUN WALL + LOW CEILING ----------------------------------------------------
	local wallDeg = 225
	local wallCf = facingIn(50, wallDeg, 7) * CFrame.Angles(0, rad(90), 0)
	b.part(V(24, 14, 1.4), wallCf, P.Light)
	b.decor(function()
		accent(b, b.part(V(24.2, 0.4, 1.6), wallCf * CFrame.new(0, 7.1, 0), P.AccentA))
		for x = -10, 10, 4 do
			b.part(V(0.5, 12, 1.5), wallCf * CFrame.new(x, 0, 0), C.Stone)
		end
	end)
	local ceil = polar(42, 245, 14)
	b.part(V(14, 1.2, 10), CFrame.lookAt(ceil, ceil + outward(245)), P.Mid)
	for _, dx in ipairs({ -6.2, 6.2 }) do
		for _, dz in ipairs({ -4.2, 4.2 }) do
			local post = CFrame.lookAt(ceil, ceil + outward(245)) * CFrame.new(dx, -7, dz)
			b.part(V(0.9, 13.4, 0.9), post, C.Metal)
		end
	end

	-- SHOOTING RANGE (north, through the tunnel) --------------------------------------------
	local rangeStart = -70
	b.block(V(64, 4, 344), V(0, -2, rangeStart - 172), P.Snow)
	b.block(V(2, 8, 344), V(32, 4, rangeStart - 172), P.Light, "X")
	b.block(V(64, 46, 4), V(0, 23, rangeStart - 346), P.Light)
	b.decor(function()
		for _, z in ipairs({ -120, -170, -270, -370 }) do
			b.block(V(60, 0.1, 1), V(0, 0.05, z), P.Mid)
		end
		neon(b, b.block(V(2.4, 0.5, 344), V(32, 8.25, rangeStart - 172), P.AccentA, "X"))
	end)
	b.block(V(16, 20, 10), V(12, 10, -300), P.AccentA)
	b.block(V(8, 5, 3), V(-8, 2.5, -150), P.AccentA)
	b.block(V(6, 8, 3), V(14, 4, -215), P.Mid)
	b.block(V(10, 4, 3), V(-6, 2, -330), P.AccentA)

	model.Parent = workspace
	return {
		Model = model,
		SpawnCFrame = function()
			local angle = math.random() * math.pi * 2
			local radius = 9 + math.random() * 9
			local offset = Vector3.new(math.cos(angle) * radius, pitY + 3.5, math.sin(angle) * radius)
			return CFrame.lookAt(offset, Vector3.new(offset.X * 2, pitY + 3.5, offset.Z * 2))
		end,
		KillY = -60,
		CrateSpots = spots,
		DummySpots = {
			{ Position = V(-10, 0, -110), Motion = "Static" },
			{ Position = V(8, 0, -135), Motion = "Strafe", Amount = 8, Speed = 0.35 },
			{ Position = V(0, 0, -185), Motion = "Strafe", Amount = 14, Speed = 0.25 },
			{ Position = V(-14, 0, -235), Motion = "Static" },
			{ Position = V(-12, 4, -260), Motion = "Bob", Amount = 10, Speed = 0.6 },
			{ Position = V(12, 20, -300), Motion = "Static" },
			{ Position = V(0, 0, -370), Motion = "Strafe", Amount = 18, Speed = 0.2 },
		},
	}
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Main  (ServerScriptService.Server.Main)

	Server entry point. Starts every service in order.

	Server layout:
		LightingSetup     lighting + post effects from Config.Lighting
		MapBuilder        builds the lobby and arenas from parts
		CharacterService  spawning, flat styling, freeze, invisibility, void
		SettingsService   saves mouse sensitivity settings (DataStore)
		Match             one 1v1 match: rounds, scoring, power-up picks
		MatchService      lobby, queue, matchmaking
		CombatService     server-side hit validation, damage, abilities
		BotService        computer opponent for admin "/bot" matches
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
Remotes.Init() -- create every RemoteEvent before anything else

-- The imported rifle (Studio's 3D Importer drops it in the Workspace):
-- keep it in ReplicatedStorage where the server and every client can clone it.
local Config = require(ReplicatedStorage.Shared.Config)
local rifleName = Config.Viewmodel.MeshTemplate or "SniperRifle"
local importedRifle = workspace:FindFirstChild(rifleName)
if importedRifle and not ReplicatedStorage:FindFirstChild(rifleName) then
	importedRifle.Parent = ReplicatedStorage
end

local LightingSetup = require(script.Parent.LightingSetup)
local CharacterService = require(script.Parent.CharacterService)
local SettingsService = require(script.Parent.SettingsService)
local MatchService = require(script.Parent.MatchService)
local CombatService = require(script.Parent.CombatService)
local BotService = require(script.Parent.BotService)

LightingSetup.Apply()
CharacterService.Init()
SettingsService.Init()
CombatService.Init()
BotService.Init(CombatService)
MatchService.Init()

print("[Sniper Duel] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--[[
	MapBuilder.lua  (ServerScriptService.Server.MapBuilder)

	Builds the lobby and the arena out of simple flat-coloured parts.
	Everything is SmoothPlastic and takes its colour from Config.Palette.

	The arena is built from a HALF map that gets mirrored, so both spawns are
	perfectly fair. Coordinates below are LOCAL to the arena centre:
		X = long axis (spawns at -X and +X)
		Y = up (floor top is at Y = 0)
		Z = width

	Mirror flags on each piece:
		nil   place once
		"X"   also place a copy mirrored across X = 0 (other team's side)
		"Z"   also place a copy mirrored across Z = 0
		"XZ"  place 4 copies (both mirrors)
		"R"   also place a copy turned 180 degrees around the centre (point symmetry)

	Collision (clean hitboxes): only the big solid shapes collide. Detail
	parts (window frames, railings, steps, car trim...) are built inside
	builder.decor(...) and neither collide nor stop bullets, so they can't
	snag you or eat shots. Stairs are an invisible smooth ramp under the
	visible steps. builder.soft(...) parts (tree leaves) don't collide but
	still block bullets and sight.
]]

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local Palette = Config.Palette
local MapBuilder = {}

----------------------------------------------------------------------------
-- Part helpers
----------------------------------------------------------------------------

-- Reflects a CFrame across the world X=0 plane. The rotation M*R*M is still a
-- proper rotation, and the result looks like a true mirror image for any part
-- that is symmetric across its own X axis (blocks, wedges, cylinders).
local function mirrorX(cf)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(-x, y, z, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
end

-- Mirror across Z = 0 is "mirror across X, then spin 180 degrees around Y".
local function mirrorZ(cf)
	return CFrame.Angles(0, math.pi, 0) * mirrorX(cf)
end

local function newPart(className, size, cf, color, parent, shape)
	local part = Instance.new(className)
	if shape then
		part.Shape = shape
	end
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CastShadow = true
	part.Parent = parent
	return part
end

-- A builder places parts relative to an origin, with optional mirroring.
local function makeBuilder(origin, parent)
	local base = CFrame.new(origin)
	local builder = {}
	local mode = nil -- nil (solid) / "decor" / "soft"

	local function applyMode(part)
		if mode == "decor" or mode == "soft" then
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = mode == "soft"
		end
	end

	-- Runs fn with every part it places marked as detail (no collision, no hits).
	function builder.decor(fn)
		local old = mode
		mode = "decor"
		fn()
		mode = old
	end

	-- Like decor, but bullets and line of sight still stop at these parts.
	function builder.soft(fn)
		local old = mode
		mode = "soft"
		fn()
		mode = old
	end

	-- Makes parts invisible (collision-only shapes).
	function builder.invisible(parts)
		for _, part in ipairs(parts) do
			part.Transparency = 1
			part.CastShadow = false
		end
		return parts
	end

	-- Sets a material (e.g. Neon for lights) on the parts.
	function builder.material(parts, material, reflectance)
		for _, part in ipairs(parts) do
			part.Material = material
			if reflectance then
				part.Reflectance = reflectance
			end
		end
		return parts
	end

	function builder.place(className, size, localCF, color, mirror, shape)
		local cfs = { localCF }
		if mirror == "R" then
			-- point symmetry: a copy turned 180 degrees around the centre
			table.insert(cfs, CFrame.Angles(0, math.pi, 0) * localCF)
		end
		if mirror == "X" or mirror == "XZ" then
			table.insert(cfs, mirrorX(localCF))
		end
		if mirror == "Z" or mirror == "XZ" then
			for i = 1, #cfs do
				table.insert(cfs, mirrorZ(cfs[i]))
			end
		end
		local parts = {}
		for _, cf in ipairs(cfs) do
			local part = newPart(className, size, base * cf, color, parent, shape)
			applyMode(part)
			table.insert(parts, part)
		end
		return parts
	end

	function builder.block(size, pos, color, mirror)
		return builder.place("Part", size, CFrame.new(pos), color, mirror)
	end

	-- A block with any CFrame (rotated)
	function builder.part(size, cf, color, mirror)
		return builder.place("Part", size, cf, color, mirror)
	end

	-- A cylinder `length` long, `diameter` wide. By default it stands UP
	-- (vertical); pass a CFrame with rotation to lay it down.
	function builder.cylinder(length, diameter, pos, color, mirror, cf)
		local placeCF = cf or (CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2))
		return builder.place("Part", Vector3.new(length, diameter, diameter), placeCF, color, mirror, Enum.PartType.Cylinder)
	end

	function builder.ball(diameter, pos, color, mirror)
		return builder.place("Part", Vector3.one * diameter, CFrame.new(pos), color, mirror, Enum.PartType.Ball)
	end

	-- A ramp whose LOW edge is centred at `lowPoint` (on the ground) and that
	-- rises toward horizontal direction `dir`.
	-- A WedgePart rises toward its local +Z, so we look along -dir.
	function builder.ramp(lowPoint, dir, length, height, width, color, mirror)
		dir = Vector3.new(dir.X, 0, dir.Z).Unit
		local center = lowPoint + dir * (length / 2) + Vector3.new(0, height / 2, 0)
		local cf = CFrame.lookAt(center, center - dir)
		return builder.place("WedgePart", Vector3.new(width, height, length), cf, color, mirror)
	end

	-- A free-standing wall made for wall running, with an accent trim on top.
	function builder.runWall(size, pos, mirror)
		builder.block(size, pos, Palette.Light, mirror)
		local trim = Vector3.new(size.X + 0.2, 0.6, size.Z + 0.2)
		builder.block(trim, pos + Vector3.new(0, size.Y / 2 + 0.3, 0), Palette.AccentB, mirror)
	end

	return builder
end

-- Other map modules (e.g. ArenaDowntown) use the same builder.
MapBuilder.MakeBuilder = makeBuilder

----------------------------------------------------------------------------
-- ARENA
----------------------------------------------------------------------------
local ARENA_LENGTH = 360 -- X
local ARENA_WIDTH = 250 -- Z
local WALL_HEIGHT = 70

-- The original simple arena ("Classic"). Set Config.Match.Map = "Classic" to use it.
local function buildClassicArena(index)
	local origin = Vector3.new(0, 0, index * Config.Match.ArenaSpacing)
	local model = Instance.new("Model")
	model.Name = "Arena" .. index

	local b = makeBuilder(origin, model)
	local V = Vector3.new

	-- Floor + subtle lane stripes
	b.block(V(ARENA_LENGTH, 4, ARENA_WIDTH), V(0, -2, 0), Palette.Snow)
	b.block(V(ARENA_LENGTH - 20, 0.1, 1.2), V(0, 0.05, 70), Palette.Mid, "Z")
	b.block(V(1.2, 0.1, ARENA_WIDTH - 20), V(0, 0.05, 0), Palette.Mid)

	-- Outer walls
	local halfL, halfW = ARENA_LENGTH / 2, ARENA_WIDTH / 2
	b.block(V(ARENA_LENGTH + 8, WALL_HEIGHT, 4), V(0, WALL_HEIGHT / 2, halfW + 2), Palette.Light, "Z")
	b.block(V(4, WALL_HEIGHT, ARENA_WIDTH), V(halfL + 2, WALL_HEIGHT / 2, 0), Palette.Light, "X")
	-- Wall base trim
	b.block(V(ARENA_LENGTH, 1.5, 1), V(0, 0.75, halfW - 0.5), Palette.Mid, "Z")

	-- SPAWN DECKS (one per side) -----------------------------------------
	b.block(V(36, 8, 46), V(-158, 4, 0), Palette.Mid, "X")
	b.block(V(36.2, 0.4, 46.2), V(-158, 8.2, 0), Palette.Snow, "X") -- deck top
	b.ramp(V(-120, 0, 0), V(-1, 0, 0), 20, 8, 14, Palette.AccentB, "X")
	b.ramp(V(-158, 0, 43), V(0, 0, -1), 20, 8, 12, Palette.AccentB, "XZ")
	-- Spawn cover on the deck edge
	b.block(V(3, 5, 12), V(-143, 10.5, 15), Palette.AccentA, "XZ")
	-- Canopy above spawn (a ceiling to run on with Magnetic Boots)
	b.block(V(28, 2, 30), V(-162, 26, 0), Palette.Mid, "X")
	b.block(V(2, 18, 2), V(-149, 17, 14), Palette.Dark, "XZ")

	-- CENTER TOWER --------------------------------------------------------
	b.block(V(22, 40, 22), V(0, 20, 0), Palette.Light)
	b.block(V(34, 2, 34), V(0, 41, 0), Palette.Mid) -- overhanging top (ceiling run)
	b.block(V(3, 4, 10), V(-11, 44, 0), Palette.AccentA, "X")
	-- Stair blocks to the top (double jump between them)
	b.block(V(12, 13, 12), V(-25, 6.5, -25), Palette.Mid, "XZ")
	b.block(V(10, 28, 10), V(-15, 14, -25), Palette.Light, "XZ")

	-- MID TOWERS ----------------------------------------------------------
	b.block(V(16, 26, 16), V(-75, 13, -70), Palette.Light, "XZ")
	b.block(V(22, 2, 22), V(-75, 27, -70), Palette.Mid, "XZ")
	b.block(V(3, 4, 8), V(-75, 30, -79), Palette.AccentA, "XZ")
	-- Step + ramp up to the step
	b.block(V(12, 14, 12), V(-59, 7, -70), Palette.Mid, "XZ")
	b.ramp(V(-31, 0, -70), V(-1, 0, 0), 22, 14, 10, Palette.AccentB, "XZ")
	-- Bridge between the two mid towers on the same side (crosses the centre lane)
	b.block(V(8, 1.5, 124), V(-75, 27.25, 0), Palette.Mid, "X")
	b.block(V(0.6, 1.2, 124), V(-78.7, 28.6, 0), Palette.AccentB, "X")
	b.block(V(0.6, 1.2, 124), V(-71.3, 28.6, 0), Palette.AccentB, "X")

	-- WALL-RUN WALLS ------------------------------------------------------
	-- Long lanes: walls separating the side lanes from the middle
	b.runWall(V(70, 26, 2), V(-50, 13, -90), "XZ")
	-- Near spawn: a pair of walls to run along out of spawn
	b.runWall(V(46, 22, 2), V(-112, 11, -34), "XZ")
	-- Near centre: blocks the middle lane sightline and gives a wall to run
	b.runWall(V(2, 22, 40), V(-38, 11, 0), "X")
	-- Tall wall in the side lane for big wall runs
	b.runWall(V(40, 34, 2), V(0, 17, -108), "Z")

	-- COVER ----------------------------------------------------------------
	b.block(V(4, 6, 12), V(-95, 3, 0), Palette.AccentA, "X")
	b.block(V(14, 4, 3), V(-65, 2, 0), Palette.AccentA, "X")
	b.block(V(10, 5, 4), V(-122, 2.5, -62), Palette.AccentA, "XZ")
	b.block(V(6, 8, 6), V(-28, 4, -52), Palette.AccentA, "XZ")
	b.block(V(6, 5, 10), V(-100, 2.5, -108), Palette.AccentA, "XZ")
	b.block(V(8, 4, 8), V(-40, 2, -110), Palette.AccentA, "XZ")
	b.block(V(5, 10, 5), V(-140, 5, -95), Palette.Mid, "XZ")

	local folder = workspace:FindFirstChild("Arenas")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Arenas"
		folder.Parent = workspace
	end
	model.Parent = folder

	local spawnHeight = 8.4 + 3.2
	return {
		Model = model,
		Index = index,
		Origin = origin,
		FloorY = origin.Y,
		-- Spawns face the centre of the map
		Spawns = {
			CFrame.lookAt(origin + V(-160, spawnHeight, 0), origin + V(0, spawnHeight, 0)),
			CFrame.lookAt(origin + V(160, spawnHeight, 0), origin + V(0, spawnHeight, 0)),
		},
	}
end

-- Builds the arena for match slot `index` (each slot gets its own copy).
function MapBuilder.BuildArena(index)
	if Config.Match.Map == "Classic" then
		return buildClassicArena(index)
	end
	-- Config.Match.Map picks the module ArenaCrossfire / ArenaSimple / ArenaDowntown
	-- (each returns its spawns and playground dummy spots)
	local mapName = Config.Match.Map
	if not script.Parent:FindFirstChild("Arena" .. tostring(mapName)) then
		mapName = "Crossfire"
	end
	local mapModule = require(script.Parent["Arena" .. mapName])
	local origin = Vector3.new(0, 0, index * Config.Match.ArenaSpacing)
	local model = Instance.new("Model")
	model.Name = "Arena" .. index .. "_" .. mapName
	local spawns, dummySpots = mapModule.Build(makeBuilder(origin, model))

	local folder = workspace:FindFirstChild("Arenas")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Arenas"
		folder.Parent = workspace
	end
	model.Parent = folder

	local base = CFrame.new(origin)
	return {
		Model = model,
		Index = index,
		Origin = origin,
		FloorY = origin.Y,
		Spawns = { base * spawns[1], base * spawns[2] },
		DummySpots = dummySpots or {}, -- for the Playground (local to Origin)
	}
end

----------------------------------------------------------------------------
-- LOBBY (built by LobbyBuilder)
----------------------------------------------------------------------------
function MapBuilder.BuildLobby()
	-- the lobby lives in its own module (required here, after MapBuilder has loaded)
	return require(script.Parent.LobbyBuilder).Build()
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Match</string>
          <string name="Source"><![CDATA[--[[
	Match.lua  (ServerScriptService.Server.Match)

	One 1v1 match between two players in one arena. Runs the whole flow:

		Countdown -> Fight -> RoundEnd -> Pick -> PickReveal -> (next round)
		                                  \-> Victory (someone reached 4 wins)

	State is sent to both players as a "snapshot" table on every phase change
	(see Match:Snapshot). The client UI is drawn purely from that snapshot.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PowerUps = require(ReplicatedStorage.Shared.PowerUps)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local CharacterService = require(script.Parent.CharacterService)

local Match = {}
Match.__index = Match

local nextMatchId = 0

function Match.new(p1, p2, arena, onFinished)
	nextMatchId += 1
	local self = setmetatable({}, Match)
	self.Id = nextMatchId
	self.Players = { p1, p2 }
	self.Arena = arena
	self.OnFinished = onFinished

	self.Wins = { [p1] = 0, [p2] = 0 }
	self.Owned = { [p1] = {}, [p2] = {} } -- { [player] = { [powerUpId] = stacks } }
	self.StatsCache = {}
	self.SecondWindUsed = {} -- reset every round
	self.LastHit = {} -- [victim] = { Attacker, Headshot }

	self.Phase = "Starting"
	self.Round = 0
	self.PhaseEndsAt = nil
	self.Message = nil
	self.Aborted = false
	self.Finished = false
	return self
end

----------------------------------------------------------------------------
-- Queries used by other services
----------------------------------------------------------------------------
function Match:GetSlot(player)
	return self.Players[1] == player and 1 or 2
end

function Match:GetOpponent(player)
	return self.Players[1] == player and self.Players[2] or self.Players[1]
end

function Match:IsFighting()
	return self.Phase == "Fight" and not self.Aborted
end

-- Power-up stats for a player (cached until they pick a new card).
function Match:GetStats(player)
	local stats = self.StatsCache[player]
	if not stats then
		stats = PowerUps.ComputeStats(self.Owned[player])
		self.StatsCache[player] = stats
	end
	return stats
end

function Match:ColorFor(player)
	return self:GetSlot(player) == 1 and Config.Palette.PlayerA or Config.Palette.PlayerB
end

----------------------------------------------------------------------------
-- Networking
----------------------------------------------------------------------------
function Match:Snapshot()
	local players = {}
	for slot, player in ipairs(self.Players) do
		players[slot] = {
			UserId = player.UserId,
			Name = player.DisplayName,
			Slot = slot,
			Wins = self.Wins[player],
			PowerUps = table.clone(self.Owned[player]),
			-- bots aren't real Players, so clients find their body by name
			IsBot = Util.isBot(player) or nil,
			CharacterName = Util.isBot(player) and player.Character and player.Character.Name or nil,
		}
	end
	return {
		InMatch = true,
		MatchId = self.Id,
		Phase = self.Phase,
		Round = self.Round,
		RoundsToWin = Config.Match.RoundsToWin,
		PhaseEndsAt = self.PhaseEndsAt,
		Players = players,
		Cards = self.Cards,
		PickerUserId = self.Picker and self.Picker.UserId or nil,
		PickedIndex = self.PickedIndex,
		RoundWinnerUserId = self.RoundWinner and self.RoundWinner.UserId or nil,
		MatchWinnerUserId = self.MatchWinner and self.MatchWinner.UserId or nil,
		Message = self.Message,
	}
end

function Match:Broadcast()
	local snapshot = self:Snapshot()
	local remote = Remotes.Get("MatchState")
	for _, player in ipairs(self.Players) do
		if player.Parent then
			remote:FireClient(player, snapshot)
		end
	end
end

function Match:SetPhase(phase, duration, message)
	self.Phase = phase
	self.Message = message
	self.PhaseEndsAt = duration and (workspace:GetServerTimeNow() + duration) or nil
	self:Broadcast()
end

-- Waits up to `seconds`, returning early if `stopWhen()` becomes true.
-- Returns false if the match was aborted (someone left).
function Match:Wait(seconds, stopWhen)
	local deadline = os.clock() + seconds
	while os.clock() < deadline do
		if self.Aborted then
			return false
		end
		if stopWhen and stopWhen() then
			break
		end
		task.wait(0.05)
	end
	return not self.Aborted
end

----------------------------------------------------------------------------
-- Spawning
----------------------------------------------------------------------------
function Match:SpawnPlayers()
	local done = 0
	for slot, player in ipairs(self.Players) do
		task.spawn(function()
			local stats = self:GetStats(player)
			CharacterService.Spawn(player, self.Arena.Spawns[slot], {
				Color = self:ColorFor(player),
				MaxHealth = stats.MaxHealth,
				Frozen = true,
				KillY = self.Arena.FloorY - Config.Match.VoidDepth,
				PowerUps = self.Owned[player],
			})
			done += 1
			-- a slow spawn (avatar download) can finish after the round started
			if self.Phase == "Fight" and not self.Aborted then
				CharacterService.SetFrozen(player, false)
			end
		end)
	end
	-- wait for both LoadCharacter calls (with a safety timeout)
	self:Wait(6, function()
		return done >= #self.Players
	end)
end

function Match:SetAllFrozen(frozen)
	for _, player in ipairs(self.Players) do
		CharacterService.SetFrozen(player, frozen)
	end
end

----------------------------------------------------------------------------
-- Events from other services
----------------------------------------------------------------------------
function Match:OnPlayerDied(player)
	if self.Phase == "Fight" and not self.RoundLoser then
		self.RoundLoser = player
	end
end

function Match:OnPlayerLeft(player)
	if self.Finished then
		return
	end
	self.Aborted = true
	self.ForfeitWinner = self:GetOpponent(player)
end

function Match:NoteHit(attacker, victim, headshot)
	self.LastHit[victim] = { Attacker = attacker, Headshot = headshot }
end

-- Ends the match straight away with no winner (e.g. "/endbot").
function Match:Cancel()
	if not self.Finished then
		self.Aborted = true
		self.ForfeitWinner = nil
	end
end

function Match:OnPickCard(player, index)
	if self.Phase ~= "Pick" or player ~= self.Picker or self.PickedIndex then
		return
	end
	if typeof(index) ~= "number" or index ~= math.floor(index) then
		return
	end
	if index < 1 or index > #self.Cards then
		return
	end
	self.PickedIndex = index
end

----------------------------------------------------------------------------
-- Main loop
----------------------------------------------------------------------------
function Match:Start()
	for _, player in ipairs(self.Players) do
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player:SetAttribute("InMatch", true)
	end
	task.spawn(function()
		local ok, err = pcall(function()
			self:Run()
		end)
		if not ok then
			warn("[Match] error:", err)
		end
		self:Finish()
	end)
end

function Match:Run()
	while true do
		self.Round += 1
		self.RoundLoser = nil
		self.RoundWinner = nil
		self.Cards = nil
		self.Picker = nil
		self.PickedIndex = nil
		self.SecondWindUsed = {}
		self.LastHit = {}

		-- COUNTDOWN (frozen at spawns)
		self:SpawnPlayers()
		if self.Aborted then
			return
		end
		self:SetPhase("Countdown", Config.Match.CountdownTime)
		if not self:Wait(Config.Match.CountdownTime) then
			return
		end

		-- FIGHT
		self:SetAllFrozen(false)
		self:SetPhase("Fight", Config.Match.MaxRoundTime)
		if not self:Wait(Config.Match.MaxRoundTime, function()
			return self.RoundLoser ~= nil
		end) then
			return
		end

		local loser = self.RoundLoser
		local message
		if not loser then
			-- Time ran out: higher health percentage wins.
			local fractions = {}
			for _, player in ipairs(self.Players) do
				local humanoid = CharacterService.GetAliveHumanoid(player)
				fractions[player] = humanoid and (humanoid.Health / humanoid.MaxHealth) or 0
			end
			local a, b = self.Players[1], self.Players[2]
			if math.abs(fractions[a] - fractions[b]) < 0.001 then
				self:SetAllFrozen(true)
				self:SetPhase("RoundEnd", Config.Match.RoundEndTime, "DRAW - REPLAYING ROUND")
				if not self:Wait(Config.Match.RoundEndTime) then
					return
				end
				self.Round -= 1
				continue
			end
			loser = fractions[a] < fractions[b] and a or b
			message = "TIME - MORE HEALTH WINS"
		else
			local hit = self.LastHit[loser]
			if hit and hit.Headshot then
				message = "HEADSHOT"
			end
		end

		local winner = self:GetOpponent(loser)
		self.RoundWinner = winner
		self.Wins[winner] += 1
		CharacterService.SetFrozen(winner, true)
		self:SetPhase("RoundEnd", Config.Match.RoundEndTime, message)
		if not self:Wait(Config.Match.RoundEndTime) then
			return
		end

		if self.Wins[winner] >= Config.Match.RoundsToWin then
			self.MatchWinner = winner
			return
		end

		-- POWER-UP PICK: the player who died picks 1 of 5
		local cards = PowerUps.DrawCards(self.Owned[loser], Config.Match.CardsPerPick)
		if #cards > 0 then
			self.Cards = cards
			self.Picker = loser
			self.PickedIndex = nil
			self:SetPhase("Pick", Config.Match.PickTime)
			if Util.isBot(loser) then
				-- bots "think" for a moment, then take the rarest card
				task.delay(1.5 + math.random() * 1.5, function()
					if self.Picker == loser and not self.PickedIndex and self.Phase == "Pick" then
						self:OnPickCard(loser, loser:ChooseCard(cards))
					end
				end)
			end
			if not self:Wait(Config.Match.PickTime + 0.3, function()
				return self.PickedIndex ~= nil
			end) then
				return
			end
			if not self.PickedIndex then
				self.PickedIndex = math.random(1, #cards) -- timer ran out
			end
			local id = cards[self.PickedIndex]
			self.Owned[loser][id] = (self.Owned[loser][id] or 0) + 1
			self.StatsCache[loser] = nil
			self:SetPhase("PickReveal", Config.Match.PickRevealTime)
			if not self:Wait(Config.Match.PickRevealTime) then
				return
			end
		end
	end
end

-- Victory screen, then everyone back to the lobby.
function Match:Finish()
	if self.Finished then
		return
	end
	if self.Aborted and self.ForfeitWinner then
		self.MatchWinner = self.ForfeitWinner
	end
	self.Finished = true

	if self.MatchWinner then
		self:SetAllFrozen(true)
		self:SetPhase("Victory", Config.Match.VictoryTime, self.Aborted and "OPPONENT LEFT" or nil)
		task.wait(Config.Match.VictoryTime)
	end

	for _, player in ipairs(self.Players) do
		if player.Parent == Players then
			player:SetAttribute("InMatch", false)
		end
	end
	if self.OnFinished then
		self.OnFinished(self)
	end
end

return Match
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source"><![CDATA[--[[
	MatchService.lua  (ServerScriptService.Server.MatchService)

	Lobby + matchmaking:
	  * Players spawn in the lobby (normal camera).
	  * Pressing PLAY puts you in the queue; the first two queued players are
	    matched into a free arena.
	  * When a match ends, both players come back to the lobby.
	  * Admin commands: "/bot [easy|normal|hard]" (or N in the lobby) starts a
	    match against a bot, "/endbot" ends it (see Config.Admin).

	Other services use MatchService.GetMatch(player) to find a player's match.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PowerUps = require(ReplicatedStorage.Shared.PowerUps)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local CharacterService = require(script.Parent.CharacterService)
local MapBuilder = require(script.Parent.MapBuilder)
local DummyService = require(script.Parent.DummyService)
local Match = require(script.Parent.Match)
local BotService = require(script.Parent.BotService)

local MatchService = {}

local lobby
local queue = {} -- ordered list of players waiting
local matchByPlayer = {} -- [player] = Match
local arenas = {} -- [index] = arena info (built on first use)
local arenaInUse = {} -- [index] = true
local practiceOwned = {} -- [player] = { [powerUpId] = stacks }  (lobby Power-Up Lab)
local practiceStats = {} -- [player] = cached stats
local inPlayground = {} -- [player] = true while free-roaming the Playground
local invites = {} -- [target] = { [challenger] = os.clock() expiry }
local rematches = {} -- [player] = { Opponent, BotDifficulty, Name, Until, Wants }
local playground -- arena info for the Playground (built the first time someone enters)

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------
function MatchService.GetMatch(player)
	return matchByPlayer[player]
end

local function isQueued(player)
	return table.find(queue, player) ~= nil
end

-- Power-ups a player is trying out in the lobby (Power-Up Lab).
function MatchService.GetPracticeStats(player)
	local stats = practiceStats[player]
	if not stats then
		stats = PowerUps.ComputeStats(practiceOwned[player] or {})
		practiceStats[player] = stats
	end
	return stats
end

local function lobbySnapshot(player)
	return {
		InMatch = false,
		Phase = "Lobby",
		Queued = isQueued(player),
		QueueCount = #queue,
		PlayersOnline = #Players:GetPlayers(),
		PowerUps = table.clone(practiceOwned[player] or {}),
		Playground = inPlayground[player] == true,
		Rematch = (function()
			local r = rematches[player]
			if not r or os.clock() > r.Until then
				return nil
			end
			local theirs = r.Opponent and rematches[r.Opponent]
			return {
				Name = r.Name,
				Requested = r.Wants == true,
				TheyRequested = theirs ~= nil and theirs.Opponent == player and theirs.Wants == true,
			}
		end)(),
	}
end

local function sendLobbyState(player)
	if player.Parent and not matchByPlayer[player] then
		Remotes.Get("MatchState"):FireClient(player, lobbySnapshot(player))
	end
end

local function broadcastLobby()
	for _, player in ipairs(Players:GetPlayers()) do
		sendLobbyState(player)
	end
end

-- PLAYGROUND: a free-roam copy of the match map with dummies everywhere and
-- the Power-Up Lab, for trying movement and builds without an opponent.
-- (Each map lists its own dummy spots.)
local function getPlayground()
	if not playground then
		playground = MapBuilder.BuildArena(Config.Match.MaxArenas + 2)
		playground.Model.Name = "Playground"
		DummyService.AddSpots(playground.DummySpots or {}, playground.Origin)
	end
	return playground
end

local function spawnInLobby(player)
	if not player.Parent or matchByPlayer[player] then
		return
	end
	if inPlayground[player] then
		local arena = getPlayground()
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		CharacterService.Spawn(player, arena.Spawns[math.random(1, 2)], {
			Color = Config.Palette.LobbyPlayer,
			MaxHealth = MatchService.GetPracticeStats(player).MaxHealth,
			PowerUps = practiceOwned[player],
			KillY = arena.FloorY - Config.Match.VoidDepth,
		})
		sendLobbyState(player)
		return
	end
	player.CameraMode = Config.Camera.FirstPersonInLobby and Enum.CameraMode.LockFirstPerson
		or Enum.CameraMode.Classic
	CharacterService.Spawn(player, lobby.SpawnCFrame(), {
		Color = Config.Palette.LobbyPlayer,
		MaxHealth = MatchService.GetPracticeStats(player).MaxHealth,
		KillY = lobby.KillY,
		PowerUps = practiceOwned[player],
	})
	sendLobbyState(player)
end

local function getFreeArena()
	for i = 1, Config.Match.MaxArenas do
		if not arenaInUse[i] then
			if not arenas[i] then
				arenas[i] = MapBuilder.BuildArena(i)
			end
			arenaInUse[i] = true
			return arenas[i]
		end
	end
	return nil
end

----------------------------------------------------------------------------
-- Matchmaking
----------------------------------------------------------------------------
local function onMatchFinished(match)
	arenaInUse[match.Arena.Index] = nil
	-- remember who you just played so you can ask for a rematch
	local a, b = match.Players[1], match.Players[2]
	for _, pair in ipairs({ { a, b }, { b, a } }) do
		local me, them = pair[1], pair[2]
		if not Util.isBot(me) and me.Parent and (Util.isBot(them) or them.Parent) then
			rematches[me] = {
				Opponent = not Util.isBot(them) and them or nil,
				BotDifficulty = Util.isBot(them) and them.Difficulty or nil,
				Name = them.DisplayName,
				Until = os.clock() + Config.Match.RematchWindow,
				Wants = false,
			}
		end
	end
	for _, player in ipairs(match.Players) do
		if matchByPlayer[player] == match then
			matchByPlayer[player] = nil
		end
		if Util.isBot(player) then
			BotService.Remove(player)
		elseif player.Parent then
			task.spawn(spawnInLobby, player)
		end
	end
	broadcastLobby()
end

local function tryStartMatches()
	-- drop anyone who left
	for i = #queue, 1, -1 do
		if not queue[i].Parent then
			table.remove(queue, i)
		end
	end
	while #queue >= 2 do
		local arena = getFreeArena()
		if not arena then
			break
		end
		local p1 = table.remove(queue, 1)
		local p2 = table.remove(queue, 1)
		local match = Match.new(p1, p2, arena, onMatchFinished)
		inPlayground[p1] = nil
		inPlayground[p2] = nil
		matchByPlayer[p1] = match
		matchByPlayer[p2] = match
		match:Start()
	end
	broadcastLobby()
end

----------------------------------------------------------------------------
-- Admin commands (bot matches)
----------------------------------------------------------------------------
local function notify(player, text)
	Remotes.Get("Notify"):FireClient(player, text)
end

local function isAdmin(player)
	local admin = Config.Admin
	if admin.BotForEveryone then
		return true
	end
	if admin.AllowEveryoneInStudio and RunService:IsStudio() then
		return true
	end
	if table.find(admin.UserIds, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank >= 255 -- group owner
end

-- "hard" -> "Hard" (falls back to the default difficulty)
local function difficultyName(text)
	if typeof(text) == "string" and #text > 0 then
		local name = string.upper(text:sub(1, 1)) .. string.lower(text:sub(2))
		if Config.Bot.Difficulties[name] then
			return name
		end
	end
	return Config.Bot.DefaultDifficulty
end

function MatchService.StartBotMatch(player, difficulty)
	if matchByPlayer[player] then
		notify(player, "Finish your current match first")
		return
	end
	local arena = getFreeArena()
	if not arena then
		notify(player, "All arenas are busy - try again soon")
		return
	end
	local index = table.find(queue, player)
	if index then
		table.remove(queue, index)
	end
	difficulty = difficultyName(difficulty)
	local bot = BotService.Create(difficulty)
	inPlayground[player] = nil
	local match = Match.new(player, bot, arena, onMatchFinished)
	matchByPlayer[player] = match
	matchByPlayer[bot] = match
	BotService.Attach(bot, match)
	notify(player, "Bot match - " .. difficulty)
	match:Start()
	broadcastLobby()
end

local function endBotMatch(player)
	local match = matchByPlayer[player]
	if match and (Util.isBot(match.Players[1]) or Util.isBot(match.Players[2])) then
		match:Cancel()
		notify(player, "Bot match ended")
	else
		notify(player, "You're not in a bot match")
	end
end

local function onAdminCommand(player, command, arg)
	if typeof(command) ~= "string" then
		return
	end
	if not isAdmin(player) then
		notify(player, "Admins only")
		return
	end
	command = string.lower(command)
	if command == "bot" then
		MatchService.StartBotMatch(player, arg)
	elseif command == "endbot" then
		endBotMatch(player)
	end
end

-- "/bot hard" -> onAdminCommand(player, "bot", "hard")
local function onChat(player, text)
	local command, arg = string.match(string.lower(text), "^[/!](%a+)%s*(%a*)")
	if command == "bot" or command == "endbot" then
		onAdminCommand(player, command, arg)
	end
end

local function setupChatCommands()
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		-- new chat: registered commands (they never show up as messages)
		local commands = TextChatService:FindFirstChild("TextChatCommands") or TextChatService
		for _, alias in ipairs({ "/bot", "/endbot" }) do
			local command = Instance.new("TextChatCommand")
			command.Name = "SniperDuel" .. alias:sub(2)
			command.PrimaryAlias = alias
			command.Parent = commands
			command.Triggered:Connect(function(source, text)
				local player = Players:GetPlayerByUserId(source.UserId)
				if player then
					onChat(player, text)
				end
			end)
		end
	else
		-- legacy chat
		local function hook(player)
			player.Chatted:Connect(function(text)
				onChat(player, text)
			end)
		end
		Players.PlayerAdded:Connect(hook)
		for _, player in ipairs(Players:GetPlayers()) do
			hook(player)
		end
	end
end

----------------------------------------------------------------------------
-- Duels: challenge a player from the lobby, and rematches
----------------------------------------------------------------------------
local function startPrivateMatch(p1, p2)
	if matchByPlayer[p1] or matchByPlayer[p2] or not p1.Parent or not p2.Parent then
		return false
	end
	local arena = getFreeArena()
	if not arena then
		notify(p1, "All arenas are busy - try again soon")
		notify(p2, "All arenas are busy - try again soon")
		return false
	end
	for _, p in ipairs({ p1, p2 }) do
		local index = table.find(queue, p)
		if index then
			table.remove(queue, index)
		end
		inPlayground[p] = nil
		invites[p] = nil
		rematches[p] = nil
	end
	local match = Match.new(p1, p2, arena, onMatchFinished)
	matchByPlayer[p1] = match
	matchByPlayer[p2] = match
	match:Start()
	broadcastLobby()
	return true
end

local function inviteValid(target, from)
	local list = invites[target]
	return list and list[from] and os.clock() < list[from]
end

local function onDuel(player, action, arg)
	if typeof(action) ~= "string" or matchByPlayer[player] then
		return
	end
	local inviteRemote = Remotes.Get("DuelInvite")
	if action == "Challenge" then
		local target = typeof(arg) == "number" and Players:GetPlayerByUserId(arg) or nil
		if not target or target == player then
			return
		end
		if matchByPlayer[target] then
			notify(player, target.DisplayName .. " is in a match")
			return
		end
		if inviteValid(target, player) then
			return -- already waiting
		end
		invites[target] = invites[target] or {}
		invites[target][player] = os.clock() + Config.Match.InviteTime
		inviteRemote:FireClient(target, { From = player.UserId, Name = player.DisplayName, Kind = "Challenge", Time = Config.Match.InviteTime })
		notify(player, "Challenge sent to " .. target.DisplayName)
	elseif action == "Accept" then
		local from = typeof(arg) == "number" and Players:GetPlayerByUserId(arg) or nil
		if from and inviteValid(player, from) then
			invites[player][from] = nil
			startPrivateMatch(from, player)
		else
			notify(player, "That challenge expired")
		end
	elseif action == "Decline" then
		local from = typeof(arg) == "number" and Players:GetPlayerByUserId(arg) or nil
		if from and invites[player] then
			invites[player][from] = nil
			notify(from, player.DisplayName .. " declined your challenge")
		end
	elseif action == "Rematch" then
		local r = rematches[player]
		if not r or os.clock() > r.Until then
			notify(player, "No rematch available")
			return
		end
		if r.BotDifficulty then
			rematches[player] = nil
			MatchService.StartBotMatch(player, r.BotDifficulty)
			return
		end
		local opponent = r.Opponent
		if not opponent or not opponent.Parent then
			notify(player, r.Name .. " left")
			rematches[player] = nil
			sendLobbyState(player)
			return
		end
		r.Wants = true
		local theirs = rematches[opponent]
		if theirs and theirs.Opponent == player and theirs.Wants then
			startPrivateMatch(opponent, player)
			return
		end
		if matchByPlayer[opponent] then
			notify(player, r.Name .. " is already in another match")
			return
		end
		inviteRemote:FireClient(opponent, { From = player.UserId, Name = player.DisplayName, Kind = "Rematch", Time = Config.Match.InviteTime })
		notify(player, "Rematch requested")
		sendLobbyState(player)
		sendLobbyState(opponent)
	end
end

local function onQueueToggle(player)
	if matchByPlayer[player] then
		return
	end
	local index = table.find(queue, player)
	if index then
		table.remove(queue, index)
	else
		table.insert(queue, player)
	end
	tryStartMatches()
end

----------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------
function MatchService.Init()
	lobby = MapBuilder.BuildLobby()
	DummyService.Init(lobby.DummySpots)

	CharacterService.OnDied = function(player)
		local match = matchByPlayer[player]
		if match then
			match:OnPlayerDied(player)
		elseif not Util.isBot(player) then
			-- died in the lobby (fell off): respawn shortly
			task.delay(1.5, spawnInLobby, player)
		end
	end

	Remotes.Get("QueueToggle").OnServerEvent:Connect(onQueueToggle)
	Remotes.Get("AdminCommand").OnServerEvent:Connect(onAdminCommand)
	Remotes.Get("Duel").OnServerEvent:Connect(onDuel)
	setupChatCommands()

	-- enter / leave the Playground
	Remotes.Get("PlaygroundToggle").OnServerEvent:Connect(function(player)
		if matchByPlayer[player] then
			return
		end
		inPlayground[player] = not inPlayground[player] or nil
		task.spawn(spawnInLobby, player)
	end)

	-- POWER-UP LAB: try any power-up in the lobby
	Remotes.Get("Practice").OnServerEvent:Connect(function(player, action, id)
		if matchByPlayer[player] then
			return
		end
		local owned = practiceOwned[player] or {}
		local def = typeof(id) == "string" and PowerUps.Get(id) or nil
		if action == "Add" and def then
			owned[id] = math.min((owned[id] or 0) + 1, def.MaxStacks or 1)
		elseif action == "Remove" and def then
			owned[id] = (owned[id] or 0) > 1 and owned[id] - 1 or nil
		elseif action == "Clear" then
			owned = {}
		else
			return
		end
		practiceOwned[player] = owned
		practiceStats[player] = nil
		-- Thick Skin etc. apply right away
		local humanoid = CharacterService.GetAliveHumanoid(player)
		if humanoid then
			humanoid.MaxHealth = MatchService.GetPracticeStats(player).MaxHealth
			humanoid.Health = humanoid.MaxHealth
		end
		CharacterService.RefreshWorldGun(player, owned)
		sendLobbyState(player)
	end)

	Remotes.Get("PickCard").OnServerEvent:Connect(function(player, index)
		local match = matchByPlayer[player]
		if match then
			match:OnPickCard(player, index)
		end
	end)

	local function onPlayerAdded(player)
		player:SetAttribute("InMatch", false)
		spawnInLobby(player)
		broadcastLobby()
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		practiceOwned[player] = nil
		practiceStats[player] = nil
		inPlayground[player] = nil
		invites[player] = nil
		rematches[player] = nil
		for _, list in pairs(invites) do
			list[player] = nil
		end
		local index = table.find(queue, player)
		if index then
			table.remove(queue, index)
		end
		local match = matchByPlayer[player]
		if match then
			match:OnPlayerLeft(player)
			matchByPlayer[player] = nil
		end
		task.defer(broadcastLobby)
	end)
end

return MatchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">SettingsService</string>
          <string name="Source"><![CDATA[--[[
	SettingsService.lua  (ServerScriptService.Server.SettingsService)

	Saves each player's settings (mouse sensitivity, scoped sensitivity,
	hold/toggle scope) in a DataStore so they persist between sessions.

	In Studio, DataStores only work if you enable:
	Game Settings > Security > "Enable Studio Access to API Services".
	If they're disabled, settings still work for the session, they just
	won't be saved.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local SettingsService = {}

local store
pcall(function()
	store = DataStoreService:GetDataStore("PlayerSettings_v1")
end)

local lastSave = {}

-- Only accept known keys with sane values from the client.
local function sanitize(data)
	local clean = table.clone(Config.SettingsDefaults)
	if typeof(data) ~= "table" then
		return clean
	end
	for key, limits in pairs(Config.SettingsLimits) do
		local value = data[key]
		if typeof(value) == "number" and value == value then
			clean[key] = math.clamp(value, limits.Min, limits.Max)
		end
	end
	if typeof(data.ToggleScope) == "boolean" then
		clean.ToggleScope = data.ToggleScope
	end
	if typeof(data.AimAssist) == "boolean" then
		clean.AimAssist = data.AimAssist
	end
	if typeof(data.InvertY) == "boolean" then
		clean.InvertY = data.InvertY
	end
	-- key binds: { Keyboard = { Action = "KeyName" }, Gamepad = { ... } }
	if typeof(data.Binds) == "table" then
		local binds = {}
		for _, device in ipairs({ "Keyboard", "Gamepad" }) do
			local list = data.Binds[device]
			if typeof(list) == "table" then
				binds[device] = {}
				for action, key in pairs(list) do
					if typeof(action) == "string" and typeof(key) == "string" and #action <= 32 and #key <= 32 then
						if key:match("^%w+$") and action:match("^%w+$") then
							binds[device][action] = key
						end
					end
				end
			end
		end
		clean.Binds = binds
	end
	return clean
end

local function load(player)
	local data
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("u" .. player.UserId)
		end)
		if ok then
			data = result
		end
	end
	Remotes.Get("SettingsLoad"):FireClient(player, sanitize(data))
end

function SettingsService.Init()
	Players.PlayerAdded:Connect(load)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(load, player)
	end

	Remotes.Get("SettingsSave").OnServerEvent:Connect(function(player, data)
		-- simple rate limit: one save every 3 seconds per player
		local now = os.clock()
		if lastSave[player] and now - lastSave[player] < 3 then
			return
		end
		lastSave[player] = now
		if not store then
			return
		end
		local clean = sanitize(data)
		task.spawn(function()
			pcall(function()
				store:SetAsync("u" .. player.UserId, clean)
			end)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastSave[player] = nil
	end)
end

return SettingsService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="27">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="28">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">18</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <bool name="EnableMouseLockOption">false</bool>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="29">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Health  (StarterPlayer.StarterCharacterScripts.Health)

	An (almost) empty script named "Health" REPLACES Roblox's default health
	regeneration script. In a sniper duel, health should only change from
	damage and power-ups (Vampire), never regenerate on its own.
]]
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="31">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">AimAssist</string>
            <string name="Source"><![CDATA[--[[
	AimAssist.lua  (Client.AimAssist)

	Light aim assist for CONTROLLER players only (mouse users never get it).
	Two small effects, both only when the crosshair is already close to a
	target you can actually see:

	  1. Slowdown: your aim turns a bit slower while it's over / near the
	     target, so it's easier to stay on them.
	  2. Gentle pull: while you're moving or using the right stick, the aim
	     drifts slightly toward the target's body (never the head, so
	     headshots still take skill). Standing still with no input = no pull.

	Targets: the enemy in a match (not while invisible), the practice
	dummies in the lobby / playground. All numbers are in Config.AimAssist,
	and players can turn it off in the settings menu.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local ClientState = require(script.Parent.ClientState)

local A = Config.AimAssist
local player = Players.LocalPlayer

local AimAssist = {}

local rightStick = Vector2.zero
local lastLook -- our look direction at the end of last frame

-- Controller and touch players get the assist (mouse players never do).
local function usingController()
	local last = UserInputService:GetLastInputType()
	return last.Name:find("Gamepad") ~= nil or last == Enum.UserInputType.Touch
end

-- Points we may assist toward: the enemy's torso, or the dummies' torsos.
local function getTargets()
	local list = {}
	if ClientState.InMatch() then
		if not ClientState.IsFighting() then
			return list
		end
		local opponent = ClientState.GetOpponentPlayer()
		local character = opponent and opponent.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 and not character:GetAttribute("Invisible") then
			local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
			if torso then
				table.insert(list, { Point = torso.Position, Model = character })
			end
		end
	else
		local folder = workspace:FindFirstChild("Dummies")
		for _, dummy in ipairs(folder and folder:GetChildren() or {}) do
			local torso = dummy:FindFirstChild("UpperTorso")
			if torso and not dummy:GetAttribute("Down") then
				table.insert(list, { Point = torso.Position, Model = dummy })
			end
		end
	end
	return list
end

local function canSee(origin, target)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { workspace.CurrentCamera, target.Model }
	if player.Character then
		table.insert(exclude, player.Character)
	end
	for _, name in ipairs({ "Effects", "Decoys" }) do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(exclude, f)
		end
	end
	params.FilterDescendantsInstances = exclude
	return workspace:Raycast(origin, target.Point - origin, params) == nil
end

-- Angle in radians between two unit vectors.
local function angleBetween(a, b)
	return math.acos(math.clamp(a:Dot(b), -1, 1))
end

-- Rotates unit vector `from` toward `to` by at most `maxAngle` radians.
local function rotateToward(from, to, maxAngle)
	local angle = angleBetween(from, to)
	if angle < 1e-5 then
		return from
	end
	local t = math.min(1, maxAngle / angle)
	return from:Lerp(to, t).Unit
end

--[[
	Called by the CameraController every frame AFTER Roblox's camera has
	applied this frame's stick input and BEFORE recoil / roll.
	scopeAlpha: 0 = hip fire, 1 = fully scoped.
]]
function AimAssist.Update(camera, dt, scopeAlpha)
	local look = camera.CFrame.LookVector
	local enabled = A.Enabled
		and ClientState.Settings.AimAssist ~= false
		and usingController()
		and not ClientState.MenuOpen
		and ClientState.HasGun()
	if not enabled then
		lastLook = look
		return
	end

	local origin = camera.CFrame.Position
	-- the assist cone shrinks with the field of view (smaller when scoped)
	local cone = math.rad(A.ConeDegrees) * (camera.FieldOfView / Config.Camera.BaseFOV)

	-- closest visible target inside the cone
	local best, bestAngle, bestDir
	for _, target in ipairs(getTargets()) do
		local toTarget = target.Point - origin
		local distance = toTarget.Magnitude
		if distance > 1 and distance <= A.Range then
			local dir = toTarget / distance
			local angle = angleBetween(look, dir)
			if angle <= cone and (not best or angle < bestAngle) and canSee(origin, target) then
				best, bestAngle, bestDir = target, angle, dir
			end
		end
	end

	if best then
		local closeness = 1 - bestAngle / cone -- 1 = dead centre, 0 = edge of the cone

		-- 1) SLOWDOWN: undo part of this frame's turn while near the target
		if lastLook then
			local slow = A.Slowdown * closeness
			local turned = angleBetween(lastLook, look)
			if turned > 1e-5 and slow > 0 then
				look = rotateToward(look, lastLook, turned * slow)
			end
		end

		-- 2) PULL: a gentle drift toward the body, only while you're moving
		--    or actively aiming (never when idle)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local moving = humanoid and humanoid.MoveDirection.Magnitude > 0.1
		local aiming = rightStick.Magnitude > 0.15
		if moving or aiming then
			local strength = math.rad(A.PullDegreesPerSecond) * closeness * dt
			if scopeAlpha > 0.5 then
				strength *= A.ScopedPullMultiplier
			end
			look = rotateToward(look, bestDir, strength)
		end

		camera.CFrame = CFrame.lookAt(origin, origin + look)
	end
	lastLook = look
end

function AimAssist.Start()
	UserInputService.InputChanged:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			rightStick = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
end

return AimAssist
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--[[
	CameraController.lua  (Client.CameraController)

	* Locks the camera in first person during matches (CameraMode =
	  LockFirstPerson, max zoom 0.5 so you can never zoom out).
	* Hides your own body so it never clips into the camera.
	* FOV: base FOV + movement kicks (sprint / slide / dash / wall run / speed),
	  zooms in while scoped.
	* Camera roll during wall runs and slides, lowered camera while sliding.
	* Aim recoil (kicks your aim up a little each shot).
	* Mouse sensitivity from settings (separate scoped sensitivity).
	* Frees the mouse while a menu is open (pick screen, settings, victory).

	Runs right AFTER Roblox's default camera each frame, so it only adds
	small offsets on top of the normal first-person camera.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local ClientState = require(script.Parent.ClientState)
local AimAssist = require(script.Parent.AimAssist)

local C = Config.Camera
local player = Players.LocalPlayer

local CameraController = {}
local Controllers

local currentFov = C.BaseFOV
local rightStick = Vector2.zero -- controller look stick (we handle it ourselves)
local touchLook = Vector2.zero -- pixels dragged on the touch look pad since last frame
local currentRoll = 0
local currentDrop = 0
local recoilLeft = 0 -- degrees of pitch still to apply
local fovPunch = 0
local shake = 0
local bobTime = 0
local bobAmount = 0
local landDip = 0 -- current camera dip from landing (studs)
local landDipVelocity = 0
local hiddenParts = {}
local firstPerson = false

----------------------------------------------------------------------------
-- Public API (used by other controllers)
----------------------------------------------------------------------------
-- Mobile: the look pad (ui/MobileControls) adds finger movement here.
function CameraController.AddTouchLook(delta)
	touchLook += delta
end

function CameraController.AddRecoil(degrees)
	recoilLeft += degrees
end

function CameraController.AddFovPunch(amount)
	fovPunch = math.max(fovPunch, amount)
end

function CameraController.Shake(amount)
	shake = math.max(shake, amount)
end

-- Camera dips down on landing (bigger fall = bigger dip), then springs back.
function CameraController.LandingDip(fallSpeed)
	-- normal jumps / bunny hops land at ~50 u/s and only get a tiny dip
	local dip = math.min(0.04 + math.max(fallSpeed - 45, 0) * C.LandingDip, C.MaxLandingDip)
	landDipVelocity -= dip * 14
end

function CameraController.IsFirstPerson()
	return firstPerson
end

-- Turns the camera to look the way the character faces (used at spawn).
function CameraController.FaceCharacterForward()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	if root and camera then
		local eye = root.Position + Vector3.new(0, 1.5, 0)
		camera.CFrame = CFrame.lookAt(eye, eye + root.CFrame.LookVector)
	end
end

----------------------------------------------------------------------------
-- Body hiding
----------------------------------------------------------------------------
local function trackCharacter(character)
	table.clear(hiddenParts)
	local function add(item)
		if item:IsA("BasePart") then
			table.insert(hiddenParts, item)
		end
	end
	for _, item in ipairs(character:GetDescendants()) do
		add(item)
	end
	character.DescendantAdded:Connect(add)
end

local function setBodyHidden(hidden)
	local value = hidden and 1 or 0
	for _, part in ipairs(hiddenParts) do
		if part.Parent then
			part.LocalTransparencyModifier = value
		end
	end
end

----------------------------------------------------------------------------
-- Camera mode
----------------------------------------------------------------------------
local function wantsFirstPerson()
	return ClientState.InMatch() or C.FirstPersonInLobby
end

local function applyCameraMode()
	firstPerson = wantsFirstPerson()
	if firstPerson then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMaxZoomDistance = 0.5
		player.CameraMinZoomDistance = 0.5
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 18
	end
end

----------------------------------------------------------------------------
-- Per-frame update (after the default camera)
----------------------------------------------------------------------------
local suspended = false

-- The kill cam takes over the camera while it plays.
function CameraController.SetSuspended(value)
	suspended = value
end

local function update(dt)
	local camera = workspace.CurrentCamera
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not camera or suspended then
		return
	end

	-- Keep enforcing the mode (respawns can reset it)
	if wantsFirstPerson() ~= firstPerson or (firstPerson and player.CameraMode ~= Enum.CameraMode.LockFirstPerson) then
		applyCameraMode()
	end

	local movement = Controllers.Movement
	local weapon = Controllers.Weapon
	local hints = movement.GetCameraHints()
	local scopeAlpha = weapon.GetScopeAlpha()

	-- FIELD OF VIEW
	local targetFov = (ClientState.Settings.FieldOfView or C.BaseFOV) + hints.FovKick
	targetFov = Util.lerp(targetFov, C.ScopeFOV, scopeAlpha)
	fovPunch = Util.approach(fovPunch, 0, 40 * dt)
	currentFov = Util.lerp(currentFov, targetFov, Util.smooth(C.FOVLerpSpeed, dt))
	camera.FieldOfView = math.clamp(currentFov + fovPunch * (1 - scopeAlpha), 1, 120)

	-- SENSITIVITY
	local settings = ClientState.Settings
	local sensitivity = settings.Sensitivity
	if scopeAlpha > 0.5 then
		sensitivity = settings.ScopedSensitivity
	end
	if movement.IsBulletTime() then
		sensitivity *= Config.PowerUps.BulletTime.SensitivityScale
	end
	UserInputService.MouseDeltaSensitivity = sensitivity

	-- CAMERA OFFSET: slide drop + running head bob + landing dip
	-- (CameraOffset is used by the default camera next frame)
	currentDrop = Util.lerp(currentDrop, hints.Drop, Util.smooth(C.CameraDropLerpSpeed, dt))
	local speed = movement.GetSpeed()
	local running = movement.IsGrounded() and movement.GetMode() == "Ground" and speed > 4
	bobAmount = Util.lerp(bobAmount, running and math.clamp(speed / Config.Movement.RunSpeed, 0, 1.3) or 0, Util.smooth(10, dt))
	bobTime += dt * (7 + speed * 0.18)
	local bobY = math.sin(bobTime * 2) * C.HeadBob * bobAmount * (1 - scopeAlpha)
	-- landing dip spring
	landDipVelocity += (-landDip * 180 - landDipVelocity * 18) * dt
	landDip += landDipVelocity * dt
	if humanoid then
		humanoid.CameraOffset = Vector3.new(0, -currentDrop + bobY + landDip, 0)
	end

	-- CONTROLLER LOOK: right stick, with its own sensitivity / deadzone / curve
	if not ClientState.MenuOpen then
		local dz = settings.ControllerDeadzone or 0.15
		local mag = rightStick.Magnitude
		if mag > dz then
			local CC = Config.Controller
			local amount = ((math.min(mag, 1) - dz) / (1 - dz)) ^ CC.ResponseCurve
			local dir = rightStick.Unit * amount
			local sens = scopeAlpha > 0.5 and settings.ControllerScopedSensitivity or settings.ControllerSensitivity
			if movement.IsBulletTime() then
				sens *= Config.PowerUps.BulletTime.SensitivityScale
			end
			local rate = math.rad(CC.TurnSpeed) * (sens or 1) * dt
			local cf = camera.CFrame
			local look = cf.LookVector
			local pitch = math.asin(math.clamp(look.Y, -1, 1))
			local newPitch = math.clamp(pitch + dir.Y * rate * CC.VerticalScale * (settings.InvertY and -1 or 1), -1.4, 1.4)
			local flat = Util.safeUnit(Vector3.new(look.X, 0, look.Z), Vector3.new(0, 0, -1))
			flat = CFrame.Angles(0, -dir.X * rate, 0):VectorToWorldSpace(flat)
			local newLook = flat * math.cos(newPitch) + Vector3.new(0, math.sin(newPitch), 0)
			camera.CFrame = CFrame.lookAt(cf.Position, cf.Position + newLook)
		end
	end

	-- TOUCH LOOK: drag on the right side of the screen
	if touchLook.Magnitude > 0 then
		if not ClientState.MenuOpen then
			local sens = scopeAlpha > 0.5 and (settings.TouchScopedSensitivity or 0.4) or (settings.TouchSensitivity or 1)
			if movement.IsBulletTime() then
				sens *= Config.PowerUps.BulletTime.SensitivityScale
			end
			local k = math.rad(Config.Touch.DegreesPerPixel) * sens
			local cf = camera.CFrame
			local look = cf.LookVector
			local pitch = math.asin(math.clamp(look.Y, -1, 1))
			local newPitch = math.clamp(pitch - touchLook.Y * k * (settings.InvertY and -1 or 1), -1.4, 1.4)
			local flat = Util.safeUnit(Vector3.new(look.X, 0, look.Z), Vector3.new(0, 0, -1))
			flat = CFrame.Angles(0, -touchLook.X * k, 0):VectorToWorldSpace(flat)
			local newLook = flat * math.cos(newPitch) + Vector3.new(0, math.sin(newPitch), 0)
			camera.CFrame = CFrame.lookAt(cf.Position, cf.Position + newLook)
		end
		touchLook = Vector2.zero
	end

	if firstPerson then
		-- AIM ASSIST (controller only): slowdown + gentle pull near a target
		AimAssist.Update(camera, dt, scopeAlpha)

		-- RECOIL: apply the kick over a few frames (this really moves your aim)
		if recoilLeft > 0.001 then
			local step = recoilLeft * math.min(1, dt * 25)
			recoilLeft -= step
			camera.CFrame *= CFrame.Angles(math.rad(step), 0, 0)
		end

		-- ROLL (wall run / slide / strafe tilt). Roll doesn't change the look
		-- direction, so it never affects aim.
		currentRoll = Util.lerp(currentRoll, hints.Roll, Util.smooth(C.TiltLerpSpeed, dt))
		local shakeOffset = CFrame.identity
		if shake > 0.01 then
			shakeOffset = CFrame.Angles(
				math.rad((math.random() - 0.5) * shake),
				math.rad((math.random() - 0.5) * shake),
				0
			)
			shake = Util.approach(shake, 0, 12 * dt)
		end
		camera.CFrame *= CFrame.Angles(0, 0, math.rad(currentRoll)) * shakeOffset

		setBodyHidden(true)

		-- MOUSE: free it while a menu is open, hide the cursor otherwise
		if ClientState.MenuOpen then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		else
			UserInputService.MouseIconEnabled = false
		end
	else
		currentRoll = 0
		UserInputService.MouseIconEnabled = true
	end
end

function CameraController.Init(controllers)
	Controllers = controllers
end

function CameraController.Start()
	if player.Character then
		trackCharacter(player.Character)
	end
	player.CharacterAdded:Connect(trackCharacter)

	applyCameraMode()
	ClientState.Changed:Connect(function(snapshot, old)
		applyCameraMode()
		if snapshot.Phase == "Countdown" and old.Phase ~= "Countdown" then
			-- new round: look toward the arena centre
			task.delay(0.05, CameraController.FaceCharacterForward)
		end
	end)

	Controllers.Movement.Landed:Connect(CameraController.LandingDip)

	AimAssist.Start()
	-- take the right stick away from Roblox's camera so our controller
	-- sensitivity / deadzone settings are used instead
	ContextActionService:BindActionAtPriority("SniperControllerLook", function(_, state, input)
		if state == Enum.UserInputState.Cancel or state == Enum.UserInputState.End then
			rightStick = Vector2.zero
		else
			rightStick = Vector2.new(input.Position.X, input.Position.Y)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 50, Enum.KeyCode.Thumbstick2)
	RunService:BindToRenderStep("SniperCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">CharacterPoser</string>
            <string name="Source"><![CDATA[--[[
	CharacterPoser.lua  (Client.CharacterPoser)

	Third-person "holding a sniper" pose for every OTHER player you can see:
	arms raised holding the rifle, pointing where that player is looking (up
	or down), head and chest following the aim. Legs keep Roblox's normal
	run / jump / fall animations.

	How: each frame, after Roblox's Animator has posed the character, we
	override the arm / neck / waist Motor6D.Transform values (R15 rigs).
	Your own look pitch is sent to the server a few times a second and stored
	as the character attribute "AimPitch", so everyone sees it.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer
local rad = math.rad

local CharacterPoser = {}

local SEND_INTERVAL = 0.1
local cache = {} -- [character] = { motors }

local function getMotors(character)
	local motors = cache[character]
	if motors then
		return motors
	end
	local function find(partName, motorName)
		local part = character:FindFirstChild(partName)
		return part and part:FindFirstChild(motorName)
	end
	motors = {
		RightShoulder = find("RightUpperArm", "RightShoulder"),
		RightElbow = find("RightLowerArm", "RightElbow"),
		LeftShoulder = find("LeftUpperArm", "LeftShoulder"),
		LeftElbow = find("LeftLowerArm", "LeftElbow"),
		Waist = find("UpperTorso", "Waist"),
		Neck = find("Head", "Neck"),
	}
	if not motors.RightShoulder then
		return nil -- not an R15 rig (yet)
	end
	cache[character] = motors
	character.AncestryChanged:Connect(function(_, parent)
		if not parent then
			cache[character] = nil
		end
	end)
	return motors
end

local function pose(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or not character:FindFirstChild("WorldGun") then
		return
	end
	local motors = getMotors(character)
	if not motors then
		return
	end
	local pitch = character:GetAttribute("AimPitch") or 0
	local armPitch = pitch * 0.75 -- the waist adds the rest

	-- right arm: straight forward holding the grip
	motors.RightShoulder.Transform = CFrame.Angles(0, rad(12), 0) * CFrame.Angles(rad(90) + armPitch, 0, 0)
	if motors.RightElbow then
		motors.RightElbow.Transform = CFrame.Angles(rad(12), 0, 0)
	end
	-- left arm: reaches across to hold the handguard
	if motors.LeftShoulder then
		motors.LeftShoulder.Transform = CFrame.Angles(0, rad(-42), 0) * CFrame.Angles(rad(96) + armPitch, 0, 0)
	end
	if motors.LeftElbow then
		motors.LeftElbow.Transform = CFrame.Angles(rad(28), 0, 0)
	end
	if motors.Waist then
		motors.Waist.Transform = CFrame.Angles(pitch * 0.25, 0, 0)
	end
	if motors.Neck then
		motors.Neck.Transform = CFrame.Angles(pitch * 0.5, 0, 0)
	end
end

function CharacterPoser.Init() end

function CharacterPoser.Start()
	-- override the animation pose every frame (Stepped runs after the Animator)
	RunService.Stepped:Connect(function()
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and other.Character then
				pose(other.Character)
			end
		end
		-- and the bot, if you're fighting one
		local opponent = ClientState.Snapshot.InMatch and ClientState.GetOpponentPlayer()
		if typeof(opponent) == "table" and opponent.Character then
			pose(opponent.Character)
		end
	end)

	-- send our own look pitch
	local aim = Remotes.Get("Aim")
	local lastSent = 0
	task.spawn(function()
		while true do
			task.wait(SEND_INTERVAL)
			local camera = workspace.CurrentCamera
			if camera and player.Character then
				local pitch = math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))
				if math.abs(pitch - lastSent) > 0.03 then
					lastSent = pitch
					aim:FireServer(pitch)
				end
			end
		end
	end)
end

return CharacterPoser
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--[[
	ClientState.lua  (Client.ClientState)

	The client's copy of "what's going on": the latest match snapshot from the
	server, this player's power-up stats, and their settings. Other client
	modules read from here and listen to the Changed signals.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local player = Players.LocalPlayer

local ClientState = {}

ClientState.Snapshot = { Phase = "Lobby", InMatch = false }
ClientState.Stats = PowerUps.ComputeStats({})
ClientState.Owned = {} -- { [powerUpId] = stacks } you have right now (match or Power-Up Lab)
ClientState.Settings = table.clone(Config.SettingsDefaults)
ClientState.MenuOpen = false -- true while a menu needs the mouse (settings / pick / victory)

ClientState.Changed = Signal.new() -- (newSnapshot, oldSnapshot)
ClientState.SettingsChanged = Signal.new() -- (settings)
ClientState.MenuChanged = Signal.new() -- (isOpen)

local menuReasons = {}

----------------------------------------------------------------------------
-- Queries
----------------------------------------------------------------------------
function ClientState.InMatch()
	return ClientState.Snapshot.InMatch == true
end

function ClientState.Phase()
	return ClientState.Snapshot.Phase
end

function ClientState.IsFighting()
	return ClientState.Snapshot.InMatch == true and ClientState.Snapshot.Phase == "Fight"
end

-- Phases where you are in the arena with your gun out.
function ClientState.IsInArena()
	local phase = ClientState.Snapshot.Phase
	return ClientState.Snapshot.InMatch == true
		and (phase == "Countdown" or phase == "Fight" or phase == "RoundEnd")
end

-- True when you should be holding your sniper: in the lobby (practice range)
-- or in the arena during a round.
function ClientState.HasGun()
	return not ClientState.Snapshot.InMatch or ClientState.IsInArena()
end

-- True when shots are allowed: practice in the lobby, or a live round.
function ClientState.CanShoot()
	return not ClientState.Snapshot.InMatch or ClientState.IsFighting()
end

-- Positions bullets may home in on: the enemy's torso, or the practice dummies.
function ClientState.GetHomingTargets()
	if ClientState.Snapshot.InMatch then
		local opponent = ClientState.GetOpponentPlayer()
		local character = opponent and opponent.Character
		local torso = character and (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"))
		return torso and { torso.Position } or {}
	end
	local targets = {}
	local folder = workspace:FindFirstChild("Dummies")
	for _, dummy in ipairs(folder and folder:GetChildren() or {}) do
		local torso = dummy:FindFirstChild("UpperTorso")
		if torso and not dummy:GetAttribute("Down") then
			table.insert(targets, torso.Position)
		end
	end
	return targets
end

-- This player's entry in the snapshot's Players list.
function ClientState.GetMe()
	for _, entry in ipairs(ClientState.Snapshot.Players or {}) do
		if entry.UserId == player.UserId then
			return entry
		end
	end
	return nil
end

function ClientState.GetOpponentEntry()
	for _, entry in ipairs(ClientState.Snapshot.Players or {}) do
		if entry.UserId ~= player.UserId then
			return entry
		end
	end
	return nil
end

-- The Player with this UserId, or for a bot (server AI, not a real Player)
-- a stand-in table { UserId, Name, DisplayName, Character, IsBot }.
function ClientState.FindPlayer(userId)
	local real = Players:GetPlayerByUserId(userId)
	if real then
		return real
	end
	for _, entry in ipairs(ClientState.Snapshot.Players or {}) do
		if entry.UserId == userId and entry.IsBot then
			local bots = workspace:FindFirstChild("Bots")
			return {
				UserId = entry.UserId,
				Name = entry.Name,
				DisplayName = entry.Name,
				IsBot = true,
				Character = bots and entry.CharacterName and bots:FindFirstChild(entry.CharacterName) or nil,
			}
		end
	end
	return nil
end

-- Your opponent (a Player, or a bot stand-in - see FindPlayer).
function ClientState.GetOpponentPlayer()
	local entry = ClientState.GetOpponentEntry()
	return entry and ClientState.FindPlayer(entry.UserId) or nil
end

function ClientState.GetSlotColor(slot)
	return slot == 1 and Config.Palette.PlayerA or Config.Palette.PlayerB
end

-- Seconds left in the current phase (based on the server clock).
function ClientState.TimeLeft()
	local endsAt = ClientState.Snapshot.PhaseEndsAt
	if not endsAt then
		return nil
	end
	return math.max(0, endsAt - workspace:GetServerTimeNow())
end

----------------------------------------------------------------------------
-- Menus (anything that needs a free mouse registers a reason here)
----------------------------------------------------------------------------
function ClientState.SetMenu(reason, open)
	menuReasons[reason] = open or nil
	local isOpen = next(menuReasons) ~= nil
	if isOpen ~= ClientState.MenuOpen then
		ClientState.MenuOpen = isOpen
		ClientState.MenuChanged:Fire(isOpen)
	end
end

----------------------------------------------------------------------------
-- Settings
----------------------------------------------------------------------------
function ClientState.SetSetting(key, value)
	ClientState.Settings[key] = value
	ClientState.SettingsChanged:Fire(ClientState.Settings)
end

function ClientState.SaveSettings()
	Remotes.Get("SettingsSave"):FireServer(ClientState.Settings)
end

----------------------------------------------------------------------------
function ClientState.Init()
	Remotes.Get("MatchState").OnClientEvent:Connect(function(snapshot)
		local old = ClientState.Snapshot
		ClientState.Snapshot = snapshot
		-- in a match: your match power-ups; in the lobby: your Power-Up Lab picks
		local me = ClientState.GetMe()
		local owned = snapshot.InMatch and (me and me.PowerUps) or snapshot.PowerUps
		ClientState.Owned = owned or {}
		ClientState.Stats = PowerUps.ComputeStats(ClientState.Owned)
		ClientState.Changed:Fire(snapshot, old)
	end)

	Remotes.Get("SettingsLoad").OnClientEvent:Connect(function(settings)
		for key, value in pairs(settings) do
			ClientState.Settings[key] = value
		end
		ClientState.SettingsChanged:Fire(ClientState.Settings)
	end)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">EffectsController</string>
            <string name="Source"><![CDATA[--[[
	EffectsController.lua  (Client.EffectsController)

	All local visual effects. Effects are built from glowing flat parts
	(Neon, so they bloom), Roblox's built-in particle textures (sparks and
	smoke) and short light flashes. Everything can be toned down in
	Config.Effects.

		shots       glowing tracers with a travelling bullet head, muzzle flash
		            light, impact sparks + smoke + light, ricochet / ghost marks
		explosions  fireball, shockwave ring, sparks, smoke, light, camera shake
		kills       the body shatters into flat shards, headshots get a red burst
		movement    landing dust ring, jump puff, slide dust
		powers      shrapnel, static zaps, blink trail, grapple rope, marks,
		            wallhack pulse, Bullet Time / Phantom Step tints

	Local effects live in a folder inside the camera so they never block
	bullets or movement raycasts.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.ClientState)
local Sfx = require(script.Parent.Sfx)

local Palette = Config.Palette
local FX = Config.Effects
local player = Players.LocalPlayer

local Effects = {}
local Controllers

local folder
local localRope = { Point = nil, Part = nil }
local enemyRopes = {} -- [userId] = { Point, Part }
local bulletTimeCC
local bulletTimeOn = false

----------------------------------------------------------------------------
-- Building blocks
----------------------------------------------------------------------------
local function getFolder()
	local camera = workspace.CurrentCamera
	if not folder or folder.Parent ~= camera then
		folder = Instance.new("Folder")
		folder.Name = "LocalEffects"
		folder.Parent = camera
	end
	return folder
end

-- An effect part. `glow` = Neon (blooms) when Config.Effects.NeonEffects is on.
local function fxPart(size, cf, color, shape, glow)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = (glow and FX.NeonEffects) and Enum.Material.Neon or Enum.Material.SmoothPlastic
	part.Size = size
	part.CFrame = cf
	part.Color = color
	if shape then
		part.Shape = shape
	end
	part.Parent = getFolder()
	return part
end

local function fadeOut(part, time, extraGoals, style)
	local goals = { Transparency = 1 }
	if extraGoals then
		for k, v in pairs(extraGoals) do
			goals[k] = v
		end
	end
	TweenService:Create(part, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goals):Play()
	Debris:AddItem(part, time + 0.1)
end

-- An invisible anchor at a world position (for particles, lights, sounds).
local function anchorAt(position, life)
	local attachment = Instance.new("Attachment")
	attachment.WorldPosition = position
	attachment.Parent = workspace.Terrain
	Debris:AddItem(attachment, life or 3)
	return attachment
end

--[[
	Particle burst using Roblox's built-in textures.
	kind: "Sparks" | "Smoke" | "Dust"
]]
local function emit(position, kind, color, count, direction)
	if not FX.Particles or count <= 0 then
		return
	end
	local attachment = anchorAt(position, 3)
	if direction and direction.Magnitude > 0.01 then
		attachment.WorldCFrame = CFrame.lookAt(position, position + direction) * CFrame.Angles(-math.pi / 2, 0, 0)
	end
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Color = ColorSequence.new(color)
	e.LightInfluence = 0
	if kind == "Sparks" then
		e.Texture = FX.SparkTexture
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) })
		e.Speed = NumberRange.new(18, 42)
		e.Lifetime = NumberRange.new(0.15, 0.4)
		e.SpreadAngle = direction and Vector2.new(55, 55) or Vector2.new(180, 180)
		e.Acceleration = Vector3.new(0, -60, 0)
		e.Drag = 3
	else -- Smoke / Dust
		e.Texture = FX.SmokeTexture
		e.LightEmission = 0
		local big = kind == "Smoke" and 3.5 or 2.2
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, big * 0.4), NumberSequenceKeypoint.new(1, big) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		e.Speed = NumberRange.new(2, kind == "Smoke" and 8 or 5)
		e.Lifetime = NumberRange.new(0.5, 1.1)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-40, 40)
		e.Drag = 2
	end
	e.Parent = attachment
	e:Emit(count)
end

-- A brief point-light flash (looks great with Future lighting).
local function lightFlash(position, color, brightness, range, time)
	if not FX.Lights then
		return
	end
	local attachment = anchorAt(position, time + 0.2)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness
	light.Range = range
	light.Shadows = false
	light.Parent = attachment
	TweenService:Create(light, TweenInfo.new(time, Enum.EasingStyle.Quad), { Brightness = 0 }):Play()
end

-- A glowing tracer line from a to b (thin hot core + soft outer glow).
local function tracer(a, b, color, thickness, life)
	local length = (b - a).Magnitude
	if length < 0.05 then
		return
	end
	local cf = CFrame.lookAt((a + b) / 2, b)
	local core = fxPart(Vector3.new(thickness, thickness, length), cf, color:Lerp(Color3.new(1, 1, 1), 0.4), nil, true)
	fadeOut(core, life, { Size = Vector3.new(0.02, 0.02, length) })
	local glow = fxPart(Vector3.new(thickness * 3.5, thickness * 3.5, length), cf, color, nil, true)
	glow.Transparency = 0.82
	fadeOut(glow, life * 0.6)
end

-- A glowing ball that flies along a path (the "bullet").
local function bulletHead(points, color)
	if #points < 2 then
		return
	end
	local head = fxPart(Vector3.new(0.35, 0.35, 2.2), CFrame.lookAt(points[1], points[2]), color, nil, true)
	task.spawn(function()
		for i = 1, #points - 1 do
			local a, b = points[i], points[i + 1]
			local time = math.min((b - a).Magnitude / 1400, 0.4)
			head.CFrame = CFrame.lookAt(a, b)
			local tween = TweenService:Create(head, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(b, b + (b - a)) })
			tween:Play()
			tween.Completed:Wait()
		end
		head:Destroy()
	end)
end

local function puff(position, color, size, life, glow)
	local ball = fxPart(Vector3.one * size, CFrame.new(position), color, Enum.PartType.Ball, glow)
	ball.Transparency = 0.15
	fadeOut(ball, life, { Size = Vector3.one * size * 3 })
end

local function ring(position, color, radius, life, glow)
	local disc = fxPart(
		Vector3.new(0.3, 2, 2),
		CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		Enum.PartType.Cylinder,
		glow
	)
	disc.Transparency = 0.25
	fadeOut(disc, life, { Size = Vector3.new(0.1, radius * 2, radius * 2) }, Enum.EasingStyle.Quint)
end

----------------------------------------------------------------------------
-- Shots
----------------------------------------------------------------------------

--[[
	Draws one bullet path.
	segments  list of { From, To, Kind }   (from Ballistics)
	passes    points where the bullet went through a wall (Ghost Round)
	startPos  where the tracer visually starts (gun muzzle)
	options   { Explosive = bool, HitPlayer = bool }
]]
function Effects.DrawShot(segments, passes, endPosition, endNormal, startPos, options)
	options = options or {}
	local headPoints = {}
	for i, seg in ipairs(segments) do
		local from = seg.From
		if i == 1 and startPos then
			from = startPos
		end
		table.insert(headPoints, from)
		local color = Palette.Tracer
		local thickness = 0.1
		if seg.Kind == "Bounce" then
			color = Palette.TracerBounce
			thickness = 0.16
		elseif options.Explosive then
			color = Palette.TracerExplosive
		end
		tracer(from, seg.To, color, thickness, seg.Kind == "Bounce" and 0.7 or 0.5)
		-- ricochet flash
		if segments[i + 1] and segments[i + 1].Kind == "Bounce" and (segments[i + 1].Hops or 0) > (seg.Hops or 0) then
			puff(seg.To, Palette.TracerBounce, 0.9, 0.3, true)
			emit(seg.To, "Sparks", Palette.TracerBounce, 10)
			lightFlash(seg.To, Palette.TracerBounce, 3, 10, 0.2)
		end
	end
	if #segments > 0 then
		table.insert(headPoints, segments[#segments].To)
		bulletHead(headPoints, options.Explosive and Palette.TracerExplosive or Palette.Tracer)
	end
	for _, p in ipairs(passes or {}) do
		puff(p, Palette.Hologram, 1.4, 0.4, true)
		emit(p, "Dust", Palette.Light, 6)
	end
	if endPosition then
		if options.HitPlayer then
			emit(endPosition, "Sparks", Color3.fromRGB(255, 120, 120), 16)
			lightFlash(endPosition, Color3.fromRGB(255, 120, 120), 3, 10, 0.2)
		else
			-- impact on the world: sparks bouncing off the surface + a dust puff
			emit(endPosition, "Sparks", Color3.fromRGB(255, 220, 160), 12, endNormal)
			emit(endPosition, "Dust", Palette.Light, 4)
			puff(endPosition, Palette.Tracer, 0.5, 0.2, true)
			lightFlash(endPosition, Color3.fromRGB(255, 220, 170), 2, 8, 0.15)
		end
	end
end

-- Muzzle flash light + smoke at a world position (your own gun or theirs).
function Effects.MuzzleFlash(position, direction)
	lightFlash(position, Palette.MuzzleFlash, 6, 16, 0.08)
	emit(position, "Smoke", Color3.fromRGB(220, 220, 225), 3, direction)
end

-- Enemy shot from the server: start tracers at their gun's muzzle.
local function onEnemyShot(userId, bullets, explosive)
	local shooter = ClientState.FindPlayer(userId)
	local character = shooter and shooter.Character
	local muzzleAttachment = character
		and character:FindFirstChild("WorldGun")
		and character.WorldGun:FindFirstChild("Barrel")
		and character.WorldGun.Barrel:FindFirstChild("Muzzle")
	local muzzle = muzzleAttachment and muzzleAttachment.WorldPosition
	for _, bullet in ipairs(bullets) do
		Effects.DrawShot(bullet.Segments, bullet.Passes, bullet.EndPosition, bullet.EndNormal, muzzle, {
			Explosive = explosive,
			HitPlayer = bullet.HitPlayer,
		})
	end
	if muzzleAttachment then
		Sfx.Play("Fire", { Parent = muzzleAttachment, Volume = 1.4 })
		puff(muzzle, Palette.MuzzleFlash, 0.9, 0.12, true)
		Effects.MuzzleFlash(muzzle)
	end
end

----------------------------------------------------------------------------
-- Kills: the body shatters into flat shards
----------------------------------------------------------------------------
local function shatter(position, color, headshot)
	if not FX.KillShatter then
		return
	end
	puff(position, Color3.new(1, 1, 1), 3, 0.35, true)
	lightFlash(position, Color3.new(1, 1, 1), 4, 18, 0.3)
	emit(position, "Sparks", color, 24)
	for _ = 1, 14 do
		local size = 0.5 + math.random() * 0.8
		local shard = Instance.new("Part")
		shard.Size = Vector3.new(size, size, size)
		shard.CFrame = CFrame.new(position + Vector3.new(math.random() - 0.5, math.random() * 2 - 1, math.random() - 0.5) * 2)
			* CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		shard.Color = color
		shard.Material = Enum.Material.SmoothPlastic
		shard.CanCollide = true
		shard.CanQuery = false
		shard.CanTouch = false
		shard.CastShadow = true
		-- in workspace.Effects (ignored by bullets + movement) so physics runs
		shard.Parent = workspace:FindFirstChild("Effects") or getFolder()
		shard.AssemblyLinearVelocity = Vector3.new(math.random() - 0.5, 0.6 + math.random(), math.random() - 0.5).Unit
			* (25 + math.random() * 30)
		shard.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 30
		task.delay(1.4, function()
			if shard.Parent then
				fadeOut(shard, 0.6, { Size = Vector3.new(0.05, 0.05, 0.05) })
			end
		end)
	end
	if headshot then
		ring(position + Vector3.new(0, 1.5, 0), Palette.UIHeadshot, 7, 0.45, true)
	end
end

----------------------------------------------------------------------------
-- Movement dust (your own character)
----------------------------------------------------------------------------
local function feetPosition()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and (root.Position - Vector3.new(0, 3, 0)) or nil
end

local function onLanded(fallSpeed)
	local feet = feetPosition()
	if not feet or fallSpeed < 40 then
		return
	end
	local strength = math.clamp((fallSpeed - 40) / 60, 0, 1)
	ring(feet + Vector3.new(0, 0.2, 0), Palette.Light, 4 + strength * 7, 0.45)
	emit(feet, "Dust", Palette.Light, math.floor(4 + strength * 10))
end

local function onJumped()
	local feet = feetPosition()
	if feet then
		emit(feet, "Dust", Palette.Light, 3)
	end
end

local slideDustTimer = 0
local function updateMovementFx(dt)
	if Controllers.Movement.GetMode() ~= "Slide" then
		return
	end
	slideDustTimer += dt
	if slideDustTimer > 0.06 then
		slideDustTimer = 0
		local feet = feetPosition()
		if feet then
			emit(feet, "Dust", Palette.Light, 1)
			emit(feet, "Sparks", Color3.fromRGB(255, 220, 170), 2)
		end
	end
end

----------------------------------------------------------------------------
-- Grapple ropes
----------------------------------------------------------------------------
local function updateRope(rope, fromPos)
	if not rope.Point or not fromPos then
		if rope.Part then
			rope.Part:Destroy()
			rope.Part = nil
		end
		return
	end
	if not rope.Part then
		rope.Part = fxPart(Vector3.new(0.12, 0.12, 1), CFrame.identity, Palette.Grapple, nil, true)
	end
	local length = (rope.Point - fromPos).Magnitude
	rope.Part.Size = Vector3.new(0.12, 0.12, length)
	rope.Part.CFrame = CFrame.lookAt((rope.Point + fromPos) / 2, rope.Point)
end

function Effects.SetLocalGrapple(point)
	localRope.Point = point
	if point then
		puff(point, Palette.Grapple, 1.2, 0.3, true)
		emit(point, "Sparks", Palette.Grapple, 10)
	else
		updateRope(localRope, nil)
	end
end

----------------------------------------------------------------------------
-- Screen tints + power visuals
----------------------------------------------------------------------------
function Effects.SetBulletTime(on)
	bulletTimeOn = on
	if not bulletTimeCC then
		bulletTimeCC = Instance.new("ColorCorrectionEffect")
		bulletTimeCC.Name = "BulletTimeTint"
		bulletTimeCC.Parent = workspace.CurrentCamera
	end
	local goals = on
			and { Saturation = -0.45, Contrast = 0.15, TintColor = Color3.fromRGB(205, 225, 255) }
		or { Saturation = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) }
	TweenService:Create(bulletTimeCC, TweenInfo.new(on and 0.15 or 0.4), goals):Play()
	if on then
		Sfx.Play("Ability", { Pitch = 0.5, Volume = 1.5 })
	end
end

-- BLINK: a flash where you left and where you arrived, joined by a streak.
function Effects.Blink(from, to)
	if not from or not to then
		return
	end
	local color = Color3.fromRGB(190, 160, 255)
	puff(from, Palette.Hologram, 3, 0.35, true)
	puff(to, color, 3.5, 0.4, true)
	tracer(from, to, color, 0.5, 0.4)
	emit(from, "Sparks", Palette.Hologram, 14)
	emit(to, "Sparks", color, 18)
	lightFlash(to, color, 4, 16, 0.3)
	Sfx.PlayAt("Dash", to, { Pitch = 1.6 })
end

function Effects.IsBulletTimeVisible()
	return bulletTimeOn
end

function Effects.PhantomFlash()
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = Color3.fromRGB(190, 230, 255)
	cc.Saturation = -0.3
	cc.Parent = workspace.CurrentCamera
	local time = math.max(ClientState.Stats.PhantomTime, 0.3)
	TweenService:Create(cc, TweenInfo.new(time), { TintColor = Color3.new(1, 1, 1), Saturation = 0 }):Play()
	Debris:AddItem(cc, time + 0.1)
	local feet = feetPosition()
	if feet then
		emit(feet + Vector3.new(0, 2, 0), "Smoke", Palette.Hologram, 6)
	end
end

----------------------------------------------------------------------------
-- Wallhack Pulse
----------------------------------------------------------------------------
local function wallhackLoop()
	local elapsed = 0
	while true do
		elapsed += task.wait(0.25)
		-- Wallhack Pulse stacks pulse more often and for longer
		local stats = ClientState.Stats
		if not stats.WallhackPulse then
			elapsed = 0
		elseif elapsed >= stats.WallhackInterval and ClientState.CanShoot() then
			elapsed = 0
			-- the enemy in a match, the practice dummies in the lobby
			local targets = {}
			if ClientState.InMatch() then
				local opponent = ClientState.GetOpponentPlayer()
				table.insert(targets, opponent and opponent.Character)
			else
				local dummies = workspace:FindFirstChild("Dummies")
				for _, dummy in ipairs(dummies and dummies:GetChildren() or {}) do
					table.insert(targets, dummy)
				end
			end
			for _, target in ipairs(targets) do
				local highlight = Instance.new("Highlight")
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillColor = Palette.UIDanger
				highlight.FillTransparency = 0.6
				highlight.OutlineColor = Color3.new(1, 1, 1)
				highlight.OutlineTransparency = 0
				highlight.Adornee = target
				highlight.Parent = getFolder()
				Debris:AddItem(highlight, stats.WallhackDuration)
			end
			if #targets > 0 then
				Sfx.Play("Ability", { Pitch = 1.6, Volume = 0.5 })
			end
		end
	end
end

----------------------------------------------------------------------------
-- Server effects
----------------------------------------------------------------------------
local function onEffect(data)
	local t = data.Type
	if t == "Explosion" then
		local radius = data.Radius or 10
		local p = data.Position
		local ball = fxPart(Vector3.one * 2, CFrame.new(p), Palette.Explosion, Enum.PartType.Ball, true)
		ball.Transparency = 0.05
		fadeOut(ball, 0.5, { Size = Vector3.one * radius * 2 }, Enum.EasingStyle.Quint)
		local core = fxPart(Vector3.one * 2, CFrame.new(p), Color3.fromRGB(255, 240, 200), Enum.PartType.Ball, true)
		fadeOut(core, 0.25, { Size = Vector3.one * radius })
		ring(p, Palette.Explosion, radius * 1.4, 0.5, true)
		emit(p, "Sparks", Palette.Explosion, 36)
		emit(p, "Smoke", Color3.fromRGB(90, 92, 100), 14)
		lightFlash(p, Palette.Explosion, 8, radius * 3, 0.45)
		Sfx.PlayAt("Explosion", p)
		local camera = workspace.CurrentCamera
		local distance = (camera.CFrame.Position - p).Magnitude
		if distance < radius * 4 then
			Controllers.Camera.Shake(5 * (1 - distance / (radius * 4)))
		end
	elseif t == "Shockwave" then
		local ground = data.Position - Vector3.new(0, 2.5, 0)
		ring(ground, Palette.AccentB, data.Radius or 20, 0.55, true)
		ring(ground, Color3.new(1, 1, 1), (data.Radius or 20) * 0.6, 0.35, true)
		emit(ground, "Dust", Palette.Light, 18)
		lightFlash(ground, Palette.AccentB, 4, 24, 0.3)
		Sfx.PlayAt("Explosion", data.Position, { Pitch = 0.6 })
	elseif t == "DecoyPop" then
		puff(data.Position, Palette.Hologram, 3, 0.4, true)
		emit(data.Position, "Sparks", Palette.Hologram, 16)
	elseif t == "Kill" then
		shatter(data.Position, data.Color or Palette.PlayerB, data.Headshot)
	elseif t == "SecondWind" then
		if data.Position then
			puff(data.Position, Color3.fromRGB(90, 230, 140), 4, 0.6, true)
			emit(data.Position, "Sparks", Color3.fromRGB(90, 230, 140), 24)
		end
		if data.UserId == player.UserId then
			Controllers.HUD.Flash(Color3.fromRGB(90, 230, 140), "SECOND WIND")
		end
	elseif t == "Grapple" then
		enemyRopes[data.UserId] = enemyRopes[data.UserId] or {}
		enemyRopes[data.UserId].Point = data.Point
	elseif t == "Shards" then
		-- SHRAPNEL
		for _, seg in ipairs(data.Segments or {}) do
			tracer(seg.From, seg.To, Palette.TracerExplosive, 0.05, 0.3)
			emit(seg.To, "Sparks", Palette.TracerExplosive, 3)
		end
		if data.Segments and data.Segments[1] then
			Sfx.PlayAt("Hit", data.Segments[1].From, { Pitch = 2.2, Volume = 0.4 })
		end
	elseif t == "Zap" then
		-- STATIC CHARGE: a jagged bolt from the bullet path to the target
		local points = { data.From }
		for i = 1, 4 do
			local p = data.From:Lerp(data.To, i / 5)
			table.insert(points, p + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 1.8)
		end
		table.insert(points, data.To)
		for i = 1, #points - 1 do
			tracer(points[i], points[i + 1], Palette.Hologram, 0.12, 0.3)
		end
		puff(data.To, Palette.Hologram, 1.4, 0.3, true)
		emit(data.To, "Sparks", Palette.Hologram, 14)
		lightFlash(data.To, Palette.Hologram, 4, 14, 0.25)
		Sfx.PlayAt("Hit", data.To, { Pitch = 2.6, Volume = 0.6 })
	elseif t == "Mark" then
		-- MARKED: the target glows for you while the mark lasts
		if data.Target and data.Target.Parent then
			local existing = getFolder():FindFirstChild("Mark")
			if existing then
				existing:Destroy()
			end
			local highlight = Instance.new("Highlight")
			highlight.Name = "Mark"
			highlight.DepthMode = Enum.HighlightDepthMode.Occluded
			highlight.FillColor = Color3.fromRGB(255, 80, 80)
			highlight.FillTransparency = 0.55
			highlight.OutlineColor = Color3.fromRGB(255, 220, 220)
			highlight.Adornee = data.Target
			highlight.Parent = getFolder()
			Debris:AddItem(highlight, data.Duration or 4)
		end
	elseif t == "Blink" then
		Effects.Blink(data.From, data.To)
	elseif t == "GrappleEnd" then
		local rope = enemyRopes[data.UserId]
		if rope then
			rope.Point = nil
			updateRope(rope, nil)
		end
	end
end

local function updateRopes(dt)
	if not ClientState.IsFighting() then
		for _, rope in pairs(enemyRopes) do
			rope.Point = nil
			updateRope(rope, nil)
		end
	end
	if localRope.Point then
		updateRope(localRope, Controllers.Viewmodel.GetLeftHandPosition())
	end
	for userId, rope in pairs(enemyRopes) do
		local other = ClientState.FindPlayer(userId)
		local hand = other and other.Character and (other.Character:FindFirstChild("LeftHand") or other.Character:FindFirstChild("Left Arm"))
		updateRope(rope, hand and hand.Position or nil)
	end
	updateMovementFx(dt)
end

function Effects.Init(controllers)
	Controllers = controllers
end

function Effects.Start()
	Remotes.Get("ShotFx").OnClientEvent:Connect(onEnemyShot)
	Remotes.Get("Effect").OnClientEvent:Connect(onEffect)
	Controllers.Movement.Landed:Connect(onLanded)
	Controllers.Movement.Jumped:Connect(onJumped)
	RunService:BindToRenderStep("SniperEffects", Enum.RenderPriority.Camera.Value + 3, updateRopes)
	task.spawn(wallhackLoop)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Keybinds</string>
            <string name="Source"><![CDATA[--[[
	Keybinds.lua  (Client.Keybinds)

	Every rebindable action with its default KEYBOARD and CONTROLLER
	binding. Players change them in Settings (P) > Keyboard / Controller,
	and they're saved with the other settings.

	A binding is the name of an Enum.KeyCode ("Space", "ButtonA") or of a
	mouse Enum.UserInputType ("MouseButton1").

	Moving (WASD / left stick) and looking (mouse / right stick) are not
	rebindable.

	Usage:  if Keybinds.Matches("Jump", input) then ... end
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.ClientState)
local Signal = require(ReplicatedStorage:WaitForChild("Shared").Signal)

local Keybinds = {}

-- On-screen buttons (mobile) press actions through these. Every place that
-- listens to UserInputService.InputBegan/Ended for an action also listens
-- here, so a button press runs exactly the same code as the key.
Keybinds.VirtualBegan = Signal.new() -- (fakeInput, processed)
Keybinds.VirtualEnded = Signal.new()

function Keybinds.Press(actionId, down)
	local fake = {
		Action = actionId,
		UserInputType = Enum.UserInputType.Touch,
		KeyCode = Enum.KeyCode.Unknown,
		Position = Vector3.zero,
		Delta = Vector3.zero,
	}
	if down then
		Keybinds.VirtualBegan:Fire(fake, false)
	else
		Keybinds.VirtualEnded:Fire(fake, false)
	end
end

Keybinds.Actions = {
	{ Id = "Fire", Name = "Fire", Keyboard = "MouseButton1", Gamepad = "ButtonR2" },
	{ Id = "Scope", Name = "Scope", Keyboard = "MouseButton2", Gamepad = "ButtonL2" },
	{ Id = "Jump", Name = "Jump / Bunny hop", Keyboard = "Space", Gamepad = "ButtonA" },
	{ Id = "Slide", Name = "Slide", Keyboard = "C", Gamepad = "ButtonB" },
	{ Id = "Sprint", Name = "Sprint", Keyboard = "LeftShift", Gamepad = "ButtonL3" },
	{ Id = "Grapple", Name = "Grapple (power-up)", Keyboard = "E", Gamepad = "ButtonY" },
	{ Id = "Blink", Name = "Blink (power-up)", Keyboard = "R", Gamepad = "ButtonX" },
	{ Id = "Decoy", Name = "Decoy (power-up)", Keyboard = "Q", Gamepad = "DPadUp" },
	{ Id = "Inspect", Name = "Inspect rifle", Keyboard = "V", Gamepad = "DPadDown" },
	{ Id = "PowerUpLab", Name = "Power-Up Lab", Keyboard = "B", Gamepad = "DPadLeft" },
	{ Id = "FindMatch", Name = "Find match", Keyboard = "F", Gamepad = "DPadRight" },
	{ Id = "Playground", Name = "Playground", Keyboard = "G", Gamepad = "ButtonL1" },
	{ Id = "BotMatch", Name = "Play vs bot (admin)", Keyboard = "N", Gamepad = "ButtonR1" },
	{ Id = "DuelFriend", Name = "Duel a player", Keyboard = "U", Gamepad = "ButtonR3" },
	{ Id = "Rematch", Name = "Rematch", Keyboard = "T", Gamepad = "DPadUp" },
	{ Id = "Settings", Name = "Settings", Keyboard = "P", Gamepad = "ButtonSelect" },
}

Keybinds.ById = {}
for _, action in ipairs(Keybinds.Actions) do
	Keybinds.ById[action.Id] = action
end

-- The current binding name for an action on a device ("Keyboard" or "Gamepad").
function Keybinds.Get(actionId, device)
	local binds = ClientState.Settings.Binds
	local custom = binds and binds[device] and binds[device][actionId]
	local action = Keybinds.ById[actionId]
	return custom or (action and action[device])
end

local function inputName(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
		return t.Name
	end
	return input.KeyCode.Name
end
Keybinds.InputName = inputName

local function isGamepad(input)
	return input.UserInputType.Name:find("Gamepad") ~= nil
end
Keybinds.IsGamepad = isGamepad

-- True if `input` is the key / button bound to `actionId`.
function Keybinds.Matches(actionId, input)
	if typeof(input) == "table" then
		return input.Action == actionId -- a virtual (on-screen button) press
	end
	local device = isGamepad(input) and "Gamepad" or "Keyboard"
	local bound = Keybinds.Get(actionId, device)
	return bound ~= nil and bound == inputName(input)
end

-- Short label for a binding ("MouseButton1" -> "LMB", "ButtonA" -> "A").
function Keybinds.Label(name)
	local labels = {
		MouseButton1 = "LMB",
		MouseButton2 = "RMB",
		MouseButton3 = "MMB",
		LeftShift = "L-SHIFT",
		RightShift = "R-SHIFT",
		LeftControl = "L-CTRL",
		RightControl = "R-CTRL",
		ButtonR2 = "RT / R2",
		ButtonL2 = "LT / L2",
		ButtonR1 = "RB / R1",
		ButtonL1 = "LB / L1",
		ButtonR3 = "R-STICK",
		ButtonL3 = "L-STICK",
		ButtonA = "A / X",
		ButtonB = "B / O",
		ButtonX = "X / []",
		ButtonY = "Y / ^",
		ButtonSelect = "SELECT",
		DPadUp = "D-UP",
		DPadDown = "D-DOWN",
		DPadLeft = "D-LEFT",
		DPadRight = "D-RIGHT",
	}
	return labels[name] or string.upper(name or "-")
end

return Keybinds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">KillCamController</string>
            <string name="Source"><![CDATA[--[[
	KillCamController.lua  (Client.KillCamController)

	When your opponent kills you in a match, you watch the last few seconds
	again through THEIR eyes: where they were, where they were aiming, their
	shot flying at a ghost of you, ending in slow motion on the kill.

	How it works (all on your client, nothing extra is sent):
	  * Every frame of a round we record your opponent's head position,
	    facing and aim pitch (the "AimPitch" attribute everyone already
	    shares), plus your own position, into a short rolling buffer.
	  * Their shots (the ShotFx remote) are recorded with a timestamp.
	  * When the server tells you that you died from a hit (Damaged with
	    Killed = true), we replay the buffer: the camera rides along their
	    head, a translucent copy of you stands where you were, and their
	    shot tracers are drawn again at the right moment.

	Press Space / tap the screen to skip. Tune it in Config.KillCam.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.ClientState)
local Theme = require(script.Parent.ui.Theme)

local K = Config.KillCam
local Palette = Config.Palette
local player = Players.LocalPlayer

local KillCam = {}
local Controllers

local BUFFER_SECONDS = 4
local samples = {} -- { T, Head (Vector3), Yaw, Pitch, Me (CFrame) }
local shots = {} -- { T, Bullets, Explosive }
local playing = false
local stopRequested = false
local gui, banner, killerLabel, vignette
local ghostTemplate -- a copy of you made at the start of each round (before you can die)

local function now()
	return os.clock()
end

local function trim(list)
	local cutoff = now() - BUFFER_SECONDS
	while list[1] and list[1].T < cutoff do
		table.remove(list, 1)
	end
end

local function opponentCharacter()
	local opponent = ClientState.GetOpponentPlayer()
	return opponent and opponent.Character
end

local function record()
	if playing or not ClientState.InMatch() or not ClientState.IsFighting() then
		return
	end
	local enemy = opponentCharacter()
	local head = enemy and enemy:FindFirstChild("Head")
	local enemyRoot = enemy and enemy:FindFirstChild("HumanoidRootPart")
	local me = player.Character
	local myRoot = me and me:FindFirstChild("HumanoidRootPart")
	if not head or not enemyRoot or not myRoot then
		return
	end
	local look = enemyRoot.CFrame.LookVector
	table.insert(samples, {
		T = now(),
		Head = head.Position + Vector3.new(0, 0.3, 0),
		Yaw = math.atan2(-look.X, -look.Z),
		Pitch = enemy:GetAttribute("AimPitch") or 0,
		Me = myRoot.CFrame,
	})
	trim(samples)
end

-- The recorded state at time t (blended between the two nearest samples).
local function sampleAt(t)
	local count = #samples
	if count == 0 then
		return nil
	end
	if t <= samples[1].T then
		return samples[1]
	end
	for i = 2, count do
		local b = samples[i]
		if b.T >= t then
			local a = samples[i - 1]
			local alpha = (t - a.T) / math.max(b.T - a.T, 1e-4)
			local yawDelta = (b.Yaw - a.Yaw + math.pi) % (2 * math.pi) - math.pi
			return {
				Head = a.Head:Lerp(b.Head, alpha),
				Yaw = a.Yaw + yawDelta * alpha,
				Pitch = a.Pitch + (b.Pitch - a.Pitch) * alpha,
				Me = a.Me:Lerp(b.Me, alpha),
			}
		end
	end
	return samples[count]
end

-- A see-through copy of you, posed where you stood.
local function makeGhost()
	local character = player.Character
	if not character then
		return nil
	end
	local wasArchivable = character.Archivable
	character.Archivable = true
	local ok, ghost = pcall(function()
		return character:Clone()
	end)
	character.Archivable = wasArchivable
	if not ok or not ghost then
		return nil
	end
	for _, item in ipairs(ghost:GetDescendants()) do
		if item:IsA("Script") or item:IsA("LocalScript") or item:IsA("Highlight") or item:IsA("ParticleEmitter") then
			item:Destroy()
		elseif item:IsA("BasePart") then
			item.Anchored = true
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
			item.LocalTransparencyModifier = 0
		end
	end
	local humanoid = ghost:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.EvaluateStateMachine = false
	end
	local outline = Instance.new("Highlight")
	outline.FillColor = Palette.PlayerB
	outline.FillTransparency = 0.6
	outline.OutlineColor = Color3.new(1, 1, 1)
	outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	outline.Parent = ghost
	ghost.Name = "KillCamGhost"
	return ghost
end

local function setCharacterHidden(character, hidden)
	if not character then
		return
	end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") then
			part.LocalTransparencyModifier = hidden and 1 or 0
		end
	end
end

local function play(deathTime, killerName)
	if playing or #samples < 5 then
		return
	end
	playing = true
	stopRequested = false
	local camera = workspace.CurrentCamera
	local enemy = opponentCharacter()
	local ghost = ghostTemplate and ghostTemplate:Clone()
	if ghost then
		ghost.Parent = workspace
	end
	local recordedShots = table.clone(shots)
	local drawn = {}

	Controllers.Camera.SetSuspended(true)
	local oldType, oldFov = camera.CameraType, camera.FieldOfView
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = K.FieldOfView
	setCharacterHidden(enemy, true) -- we're inside their head
	setCharacterHidden(player.Character, true)

	killerLabel.Text = "KILLED BY " .. string.upper(killerName or "YOUR OPPONENT")
	gui.Enabled = true
	banner.Position = UDim2.new(0.5, 0, 0, -80)
	Theme.tween(banner, 0.35, { Position = UDim2.new(0.5, 0, 0, 40) }, Enum.EasingStyle.Back)

	local replayT = deathTime - K.Length
	local finish = deathTime + 0.5
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		local slow = replayT > deathTime - K.SlowMoTime and replayT < deathTime + 0.3
		replayT += dt * (slow and K.SlowMoSpeed or 1)
		vignette.BackgroundTransparency = slow and 0.6 or 0.85
		local s = sampleAt(math.min(replayT, deathTime))
		if s then
			camera.CFrame = CFrame.new(s.Head) * CFrame.fromOrientation(s.Pitch, s.Yaw, 0)
			if ghost and ghost.PrimaryPart then
				ghost:PivotTo(s.Me)
			elseif ghost then
				local root = ghost:FindFirstChild("HumanoidRootPart")
				if root then
					ghost:PivotTo(s.Me * root.CFrame:ToObjectSpace(ghost:GetPivot()))
				end
			end
		end
		for i, shot in ipairs(recordedShots) do
			if not drawn[i] and shot.T <= replayT and shot.T >= deathTime - K.Length then
				drawn[i] = true
				local muzzle = camera.CFrame.Position + camera.CFrame.LookVector * 1.5 - camera.CFrame.UpVector * 0.4
				for _, bullet in ipairs(shot.Bullets) do
					Controllers.Effects.DrawShot(bullet.Segments, bullet.Passes, bullet.EndPosition, bullet.EndNormal, muzzle, {
						Explosive = shot.Explosive,
						HitPlayer = bullet.HitPlayer,
					})
				end
			end
		end
		local phase = ClientState.Snapshot.Phase
		if replayT >= finish or stopRequested or not ClientState.InMatch() or (phase ~= "RoundEnd" and phase ~= "Fight") then
			connection:Disconnect()
			if ghost then
				ghost:Destroy()
			end
			setCharacterHidden(enemy, false)
			gui.Enabled = false
			camera.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
			camera.FieldOfView = oldFov
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				camera.CameraSubject = humanoid
			end
			Controllers.Camera.SetSuspended(false)
			playing = false
		end
	end)
end

function KillCam.IsPlaying()
	return playing
end

function KillCam.Init(controllers)
	Controllers = controllers
end

function KillCam.Start()
	local playerGui = player:WaitForChild("PlayerGui")
	gui = Theme.screen("KillCam", 6, playerGui)
	gui.Enabled = false
	vignette = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		Parent = gui,
	})
	for _, y in ipairs({ 0, 1 }) do -- letterbox bars
		Theme.new("Frame", {
			AnchorPoint = Vector2.new(0, y),
			Position = UDim2.fromScale(0, y),
			Size = UDim2.new(1, 0, 0.07, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			Parent = gui,
		})
	end
	banner = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		Size = UDim2.fromOffset(420, 70),
		BackgroundColor3 = Palette.UIPanel,
		Parent = gui,
	})
	Theme.stroke(banner, Palette.PlayerB, 2, 0.1)
	Theme.label({
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromOffset(0, 8),
		Text = "KILL CAM",
		TextSize = 16,
		TextColor3 = Palette.PlayerB,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = banner,
	})
	killerLabel = Theme.label({
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 30),
		TextSize = 24,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = banner,
	})
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(300, 20),
		Text = "SPACE / TAP TO SKIP",
		TextSize = 14,
		TextColor3 = Palette.UISubText,
		Parent = gui,
	})
	-- crosshair dot: their aim
	local dot = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Palette.PlayerB,
		Parent = gui,
	})
	Theme.corner(dot, UDim.new(0.5, 0))

	RunService.RenderStepped:Connect(record)

	-- record the opponent's shots
	Remotes.Get("ShotFx").OnClientEvent:Connect(function(userId, bullets, explosive)
		local opponent = ClientState.GetOpponentEntry()
		if opponent and opponent.UserId == userId and typeof(bullets) == "table" then
			table.insert(shots, { T = now(), Bullets = bullets, Explosive = explosive })
			trim(shots)
		end
	end)

	-- you died from a hit in a match -> play it back
	Remotes.Get("Damaged").OnClientEvent:Connect(function(data)
		if not K.Enabled or typeof(data) ~= "table" or not data.Killed or not ClientState.InMatch() then
			return
		end
		local deathTime = now()
		local opponent = ClientState.GetOpponentEntry()
		task.delay(K.Delay, function()
			if ClientState.InMatch() then
				play(deathTime + 0.1, opponent and opponent.Name)
			end
		end)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not playing then
			return
		end
		if input.KeyCode == Enum.KeyCode.Space or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.ButtonA then
			stopRequested = true
		end
	end)

	-- a new round clears the buffers
	ClientState.Changed:Connect(function(snapshot, old)
		if snapshot.Phase == "Countdown" and (not old or old.Phase ~= "Countdown") then
			samples = {}
			shots = {}
		end
		if snapshot.Phase == "Fight" and (not old or old.Phase ~= "Fight") then
			if ghostTemplate then
				ghostTemplate:Destroy()
			end
			ghostTemplate = makeGhost()
		end
	end)
end

return KillCam
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="40">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Main  (StarterPlayerScripts.Client.Main)

	Client entry point. Requires every controller, gives each one a shared
	`controllers` table (so they can call each other without circular
	requires), then starts them.

	Client layout:
		ClientState          latest match snapshot, my power-up stats, settings
		CameraController     first-person lock, FOV, tilt, recoil, sensitivity
		MovementController   bhop / sprint / slide / wall run (power-up) / grapple
		ViewmodelController  arms + sniper attached to the camera
		WeaponController     scope + fire (sends shots to the server)
		EffectsController    tracers, explosions, ropes, screen tints
		UIController         all screens (ui/ folder)
		CharacterPoser       third-person rifle-holding pose for other players
		AimAssist            light controller aim assist (used by CameraController)
		KillCamController    replays your death through your killer's eyes
]]

local Client = script.Parent

local ClientState = require(Client.ClientState)
local CameraController = require(Client.CameraController)
local MovementController = require(Client.MovementController)
local ViewmodelController = require(Client.ViewmodelController)
local WeaponController = require(Client.WeaponController)
local EffectsController = require(Client.EffectsController)
local UIController = require(Client.UIController)
local CharacterPoser = require(Client.CharacterPoser)
local KillCamController = require(Client.KillCamController)

local controllers = {
	Camera = CameraController,
	Movement = MovementController,
	Viewmodel = ViewmodelController,
	Weapon = WeaponController,
	Effects = EffectsController,
	UI = UIController,
	Poser = CharacterPoser,
	KillCam = KillCamController,
}

ClientState.Init()

local order = {
	CameraController,
	MovementController,
	ViewmodelController,
	WeaponController,
	EffectsController,
	UIController,
	CharacterPoser,
	KillCamController,
}
for _, controller in ipairs(order) do
	controller.Init(controllers)
end
for _, controller in ipairs(order) do
	controller.Start()
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">MovementController</string>
            <string name="Source"><![CDATA[--[[
	MovementController.lua  (Client.MovementController)

	Fast, momentum-based movement with BUNNY HOPPING.

	CONTROLS
		WASD           move
		Space          jump. HOLD it to bunny hop (you re-jump the instant you
		               land and keep all your speed). Wall jump too.
		A/D + mouse    air strafe: hold A and turn the mouse left (or D + right)
		               while in the air to GAIN speed, like CS / TF2
		Left Shift     sprint (hold)
		C or L-Ctrl    slide (tap; tap again to stand). Press it in the air =
		               slide the moment you land. Jump out of a slide any time.
		E              Grapple Hook (power-up)
		R              Blink (power-up)
		Q              Decoy (power-up)

	HOW IT WORKS
	The ground and air physics copy the Source engine (Half-Life, CS, TF2):
	  * ground: friction, then accelerate toward your input direction
	  * air:    the acceleration can only add a tiny bit of speed IN the
	            direction you're pressing, but there's no limit on total speed.
	            Turning the mouse while strafing keeps your input sideways to
	            your velocity, which bends and grows it. That's air strafing.
	  * landing with Space held jumps again on the same frame, before any
	            friction is applied, so no speed is lost. That's bunny hopping.

	We keep our own horizontal velocity (`momentum`) and drive the character
	with a LinearVelocity in Plane mode (horizontal only), so gravity and
	jumping still use normal Roblox physics.

	Modes: Ground, Air, Slide, WallRun, Grapple, Ceiling.
	Other scripts can listen to Movement.Jumped / Landed / Slid.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)
local Util = require(Shared.Util)
local ClientState = require(script.Parent.ClientState)
local Sfx = require(script.Parent.Sfx)
local Keybinds = require(script.Parent.Keybinds)

local M = Config.Movement
local C = Config.Camera
local PU = Config.PowerUps
local player = Players.LocalPlayer

local Movement = {}
local Controllers

Movement.Jumped = Signal.new() -- ()
Movement.Landed = Signal.new() -- (fallSpeed)
Movement.Slid = Signal.new() -- () a slide started

-- Character references
local character, humanoid, root, linearVelocity

-- Movement state
local mode = "Ground"
local momentum = Vector3.zero -- horizontal velocity we are driving
local lastDrive = Vector3.zero -- what we actually commanded last frame
local pendingImpulse = Vector3.zero -- knockback etc. added next frame
local pendingLift = nil -- vertical velocity to set next frame
local airJumpsLeft = 0

local sprintHeld, slideHeld, jumpHeld = false, false, false
local jumpPressedAt = -10 -- for the jump buffer
local slidePressedAt = -10 -- slide pressed in the air = slide on landing
local lastGroundedTime = 0 -- for coyote time
local forceJumpUntil = 0 -- keep re-applying jump velocity for a moment

local now = os.clock
local lastGroundJumpTime = 0
local lastLiftTime = 0
local lastSlideTime = 0
local lastPhantomTime = 0
local peakY = 0
local lowestVelocityY = 0 -- fastest fall speed this air time (for landing effects)

local wall = { Normal = Vector3.zero, Side = 0, Timer = 0, Y = 0, LastNormal = nil, LastTime = 0, Recharged = true, ReadyAt = 0 }
local grapple = { Point = nil, Timer = 0, ReadyAt = 0 }
local speedBoost = { Until = 0, Multiplier = 1 }
local bulletTime = { Until = 0, ReadyAt = 0, UsedThisAir = false }
local decoyReadyAt = 0
local blinkReadyAt = 0

local fovKick = 0

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------
local function stats()
	return ClientState.Stats
end

local function canMove()
	if not (character and humanoid and root and linearVelocity) then
		return false
	end
	if humanoid.Health <= 0 or root.Anchored or character:GetAttribute("Frozen") then
		return false
	end
	return true
end

local function approachVector(current, target, maxDelta)
	local delta = target - current
	if delta.Magnitude <= maxDelta then
		return target
	end
	return current + delta.Unit * maxDelta
end

-- Rotates the direction of `v` toward `dir` by fraction t, keeping its length.
local function steer(v, dir, t)
	if v.Magnitude < 0.1 or dir.Magnitude < 0.1 then
		return v
	end
	local newDir = v.Unit:Lerp(dir.Unit, math.clamp(t, 0, 1))
	if newDir.Magnitude < 0.05 then
		return v
	end
	return newDir.Unit * v.Magnitude
end

--[[
	Source-engine acceleration.
	Adds speed along `wishDir` until the speed IN THAT DIRECTION reaches
	`addCap`. In the air addCap is tiny (AirSpeedCap), which is exactly what
	makes air strafing gain speed when you turn while strafing.
]]
local function accelerate(v, wishDir, wishSpeed, accel, dt, addCap)
	local current = v:Dot(wishDir)
	local addSpeed = (addCap or wishSpeed) - current
	if addSpeed <= 0 then
		return v
	end
	local accelSpeed = math.min(accel * dt * wishSpeed, addSpeed)
	return v + wishDir * accelSpeed
end

-- Source-engine ground friction.
local function applyFriction(v, friction, dt)
	local speed = v.Magnitude
	if speed < 0.05 then
		return Vector3.zero
	end
	local control = math.max(speed, M.StopSpeed)
	local newSpeed = math.max(speed - control * friction * dt, 0)
	return v * (newSpeed / speed)
end

-- Second Wind boost x Adrenaline power-up
local function speedMultiplier()
	local boost = now() < speedBoost.Until and speedBoost.Multiplier or 1
	return boost * stats().MoveSpeedMultiplier
end

-- Spring Legs power-up
local function jumpPower()
	return M.JumpPower * stats().JumpMultiplier
end

local function wishDirection()
	local dir = humanoid and humanoid.MoveDirection or Vector3.zero
	dir = Util.flat(dir)
	if dir.Magnitude > 1 then
		dir = dir.Unit
	end
	return dir
end

local function cameraFlatLook()
	local camera = workspace.CurrentCamera
	return Util.safeUnit(Util.flat(camera.CFrame.LookVector), Vector3.new(0, 0, -1))
end

local function makeRaycastParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true -- leaves and other non-solid detail aren't walls or floors
	local exclude = { character, workspace.CurrentCamera }
	for _, name in ipairs({ "Effects", "Decoys", "Dummies", "Bots" }) do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	-- other players are not walls
	for _, other in ipairs(Players:GetPlayers()) do
		if other.Character then
			table.insert(exclude, other.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	return params
end

local function setVerticalVelocity(y)
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, y, v.Z)
end

--[[
	ANTI-CLIPPING: before we push the character, sweep a body-sized box in the
	direction we're about to move. If a wall is in the way, remove the part of
	the velocity that points into it, so we slide along walls instead of
	shoving into (and sometimes through) them. The box starts a little above
	the feet so curbs, steps and ramps don't count as walls.
]]
local function clipAgainstWalls(v, dt)
	local speed = v.Magnitude
	if speed < 0.5 then
		return v
	end
	local params = makeRaycastParams()
	for _ = 1, 2 do -- twice, for corners
		speed = v.Magnitude
		if speed < 0.5 then
			break
		end
		local dir = v / speed
		local start = root.Position + Vector3.new(0, 0.4, 0) - dir * 0.6
		local result = workspace:Blockcast(
			CFrame.lookAt(start, start + dir),
			Vector3.new(1.9, 3.6, 1),
			dir * (speed * dt + 1.4),
			params
		)
		if not result or math.abs(result.Normal.Y) > 0.6 then
			break
		end
		local n = Util.flat(result.Normal)
		if n.Magnitude < 0.01 then
			break
		end
		n = n.Unit
		local into = v:Dot(n)
		if into >= 0 then
			break
		end
		v -= n * into
	end
	return v
end

-- True if we are falling and the ground is just below (so a Space press now
-- should be a buffered bunny hop, not a double jump).
local function groundIsClose()
	local vy = root.AssemblyLinearVelocity.Y
	if vy > 0 then
		return false
	end
	local reach = 3.6 + math.min(-vy * M.JumpBuffer, 8)
	return workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), makeRaycastParams()) ~= nil
end

----------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------

-- Push the character (knockback, rocket jump). Horizontal part is added to
-- momentum, vertical part sets the upward speed.
function Movement.ApplyImpulse(velocity)
	pendingImpulse += Util.flat(velocity)
	if velocity.Y > 1 then
		pendingLift = math.max(pendingLift or 0, velocity.Y)
	end
end

function Movement.IsBulletTime()
	return now() < bulletTime.Until
end

function Movement.GetMode()
	return mode
end

function Movement.GetSpeed()
	return momentum.Magnitude
end

function Movement.GetWallSide()
	return mode == "WallRun" and wall.Side or 0
end

function Movement.GetGrapplePoint()
	return grapple.Point
end

function Movement.GetCooldowns()
	return {
		Grapple = math.max(0, grapple.ReadyAt - now()),
		Blink = math.max(0, blinkReadyAt - now()),
		Decoy = math.max(0, decoyReadyAt - now()),
		BulletTime = math.max(0, bulletTime.ReadyAt - now()),
	}
end

function Movement.IsGrounded()
	return humanoid ~= nil and humanoid.FloorMaterial ~= Enum.Material.Air
end

function Movement.IsSprinting()
	return mode == "Ground" and sprintHeld and momentum.Magnitude > M.RunSpeed * 0.8
end

-- FOV kick / roll / camera drop for the CameraController.
function Movement.GetCameraHints()
	local hints = { FovKick = fovKick, Roll = 0, Drop = 0 }
	if not humanoid then
		return hints
	end
	if mode == "WallRun" then
		hints.Roll = wall.Side * C.WallRunTilt
	elseif mode == "Slide" then
		hints.Roll = C.SlideTilt
		hints.Drop = C.SlideCameraDrop
	else
		-- tiny strafe tilt
		local camera = workspace.CurrentCamera
		local strafe = wishDirection():Dot(camera.CFrame.RightVector)
		hints.Roll = -strafe * C.StrafeTilt
	end
	return hints
end

----------------------------------------------------------------------------
-- Moves
----------------------------------------------------------------------------
-- PHANTOM STEP power-up: slides and wall jumps turn you invisible briefly.
local function phantomStep()
	if stats().PhantomDash and now() - lastPhantomTime > 0.6 then
		lastPhantomTime = now()
		Remotes.Get("Ability"):FireServer("PhantomDash", {})
		Controllers.Effects.PhantomFlash()
	end
end

local function startSlide()
	if now() - lastSlideTime < M.SlideCooldown then
		return
	end
	local speed = momentum.Magnitude
	if speed < M.SlideMinSpeed then
		return
	end
	lastSlideTime = now()
	mode = "Slide"
	-- boost, but never above the cap (so slide spam can't snowball)
	if speed < M.SlideBoostCap then
		speed = math.min(speed + M.SlideBoost, M.SlideBoostCap)
	end
	momentum = momentum.Unit * speed
	Sfx.Play("Dash", { Pitch = 0.7, Volume = 0.6 })
	Movement.Slid:Fire()
	phantomStep()
end

local function onLanded()
	local fell = peakY - root.Position.Y
	local fallSpeed = -lowestVelocityY
	peakY = root.Position.Y
	lowestVelocityY = 0
	mode = "Ground"
	airJumpsLeft = stats().AirJumps
	bulletTime.UsedThisAir = false
	if fallSpeed > 30 then
		Sfx.Play("Land", { Volume = math.clamp(fallSpeed / 80, 0.3, 1.2) })
	end
	Movement.Landed:Fire(fallSpeed)
	lastGroundedTime = now()
	-- SHOCKWAVE LANDING power-up
	if stats().ShockwaveLanding and fell >= PU.ShockwaveLanding.MinFallHeight then
		Remotes.Get("Ability"):FireServer("Shockwave", {})
		Controllers.Camera.Shake(2.5)
	end
	if (M.SlideHold and slideHeld) or now() - slidePressedAt < 0.35 then
		startSlide()
	end
end

-- Jump off the ground (or out of a slide). Called from the step so it can
-- happen on the exact landing frame (bunny hop).
local function groundJump()
	if mode == "Slide" and momentum.Magnitude < M.SlideBoostCap then
		momentum += Util.safeUnit(momentum) * M.SlideJumpBoost
	end
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	setVerticalVelocity(jumpPower())
	-- the Humanoid can briefly hold us down (e.g. right after landing or
	-- mid-slide); re-apply the jump velocity for a few frames so jumps never fail
	forceJumpUntil = now() + 0.08
	lastGroundJumpTime = now()
	lastGroundedTime = -10
	jumpPressedAt = -10
	mode = "Air"
	peakY = root.Position.Y
	Sfx.Play("Jump", { Pitch = 0.95 + math.random() * 0.1 })
	Movement.Jumped:Fire()
end

local function endGrapple(popUp)
	if not grapple.Point then
		return
	end
	grapple.Point = nil
	grapple.ReadyAt = now() + stats().GrappleCooldown
	Remotes.Get("Ability"):FireServer("GrappleEnd", {})
	Controllers.Effects.SetLocalGrapple(nil)
	mode = "Air"
	if popUp then
		pendingLift = math.max(pendingLift or 0, 32)
	end
end

local function startGrapple()
	if not stats().Grapple or now() < grapple.ReadyAt or grapple.Point then
		return
	end
	local camera = workspace.CurrentCamera
	local result = workspace:Raycast(
		camera.CFrame.Position,
		camera.CFrame.LookVector * M.GrappleRange,
		makeRaycastParams()
	)
	if not result then
		grapple.ReadyAt = now() + 0.3 -- small penalty for a miss
		return
	end
	grapple.Point = result.Position
	grapple.Timer = 0
	mode = "Grapple"
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	Remotes.Get("Ability"):FireServer("GrappleStart", { Point = result.Position })
	Controllers.Effects.SetLocalGrapple(result.Position)
	Sfx.Play("Ability")
end

-- BLINK power-up: teleport where you're looking, keeping your momentum.
local function startBlink()
	local s = stats()
	if not s.Blink or now() < blinkReadyAt then
		return
	end
	blinkReadyAt = now() + s.BlinkCooldown
	local camera = workspace.CurrentCamera
	local look = camera.CFrame.LookVector
	-- mostly horizontal: you can blink up or down a little, not straight into the floor
	local dir = Vector3.new(look.X, math.clamp(look.Y, -0.35, 0.6), look.Z).Unit
	local from = root.Position
	-- sweep a body-sized box so you can never end up inside a wall
	local hit = workspace:Blockcast(CFrame.lookAt(from, from + dir), Vector3.new(2, 4.6, 1), dir * s.BlinkDistance, makeRaycastParams())
	local to = hit and (from + dir * math.max(hit.Distance - 0.4, 0)) or (from + dir * s.BlinkDistance)
	-- don't end up inside the floor
	local floor = workspace:Raycast(to + Vector3.new(0, 3, 0), Vector3.new(0, -6, 0), makeRaycastParams())
	if floor then
		to = Vector3.new(to.X, math.max(to.Y, floor.Position.Y + 3), to.Z)
	end
	root.CFrame = CFrame.new(to) * root.CFrame.Rotation
	if mode == "Ground" or mode == "Slide" then
		mode = "Air"
	end
	Controllers.Camera.AddFovPunch(C.BlinkFOVKick)
	Controllers.Effects.Blink(from, to)
	Remotes.Get("Ability"):FireServer("Blink", { From = from, To = to })
	Sfx.Play("Dash", { Pitch = 1.7 })
end

local function startDecoy()
	if not stats().Decoy or now() < decoyReadyAt then
		return
	end
	decoyReadyAt = now() + PU.Decoy.Cooldown
	local wish = wishDirection()
	local dir = wish.Magnitude > 0.1 and wish.Unit or cameraFlatLook()
	Remotes.Get("Ability"):FireServer("Decoy", { Direction = dir })
	Sfx.Play("Ability", { Pitch = 1.3 })
end

local function wallJump()
	local along = Util.flat(momentum - wall.Normal * momentum:Dot(wall.Normal))
	momentum = along + wall.Normal * M.WallJumpOut
	pendingLift = M.WallJumpUp
	wall.LastNormal = wall.Normal
	wall.LastTime = now()
	mode = "Air"
	Sfx.Play("Jump", { Pitch = 1.15 })
	Movement.Jumped:Fire()
	phantomStep()
end

local function airJump()
	airJumpsLeft -= 1
	pendingLift = M.AirJumpVelocity * stats().JumpMultiplier
	-- re-aim momentum toward your keys (keeps your speed)
	local wish = wishDirection()
	if wish.Magnitude > 0.1 then
		momentum = wish.Unit * math.max(momentum.Magnitude, M.AirJumpMinSpeed * speedMultiplier())
	end
	mode = "Air"
	Sfx.Play("Jump", { Pitch = 1.25 })
	Movement.Jumped:Fire()
end

local function onJumpPressed()
	jumpPressedAt = now()
	if not canMove() then
		return
	end
	if mode == "WallRun" then
		wallJump()
	elseif mode == "Grapple" then
		endGrapple(true)
	elseif mode == "Air" and now() - lastGroundedTime < M.CoyoteTime then
		groundJump() -- just ran or slid off a ledge: still counts as a ground jump
	elseif mode == "Air" then
		if now() - lastGroundJumpTime < 0.12 then
			return -- we only just left the ground
		end
		if groundIsClose() then
			return -- about to land: the jump buffer turns this into a bunny hop
		end
		if airJumpsLeft > 0 then
			airJump()
		end
	end
	-- Ground / Slide jumps happen in the step (so they line up with landing)
end

----------------------------------------------------------------------------
-- Per-mode updates
----------------------------------------------------------------------------
local function updateGround(dt, wish)
	local wishSpeed = (sprintHeld and M.SprintSpeed or M.RunSpeed) * speedMultiplier()
	momentum = applyFriction(momentum, M.Friction, dt)
	if wish.Magnitude > 0.05 then
		momentum = accelerate(momentum, wish.Unit, wishSpeed * math.min(wish.Magnitude, 1), M.GroundAccel, dt)
	end
	humanoid.WalkSpeed = math.max(wishSpeed, 1)
end

local function updateAir(dt, wish)
	if wish.Magnitude < 0.05 then
		return
	end
	local dir = wish.Unit
	local mult = speedMultiplier()
	-- 1) Source air strafing: a small cap in the pressed direction but no
	--    limit on total speed (A/D + turning the mouse = more speed)
	momentum = accelerate(momentum, dir, M.AirControlSpeed * mult, M.AirAccel, dt, M.AirSpeedCap * mult)
	-- 2) Air steering: holding forward turns your momentum toward where you
	--    look, keeping your speed (easy, snappy control in the air)
	local forwardness = math.max(0, dir:Dot(cameraFlatLook()))
	if forwardness > 0 then
		momentum = steer(momentum, dir, M.AirSteer * forwardness * dt)
	end
	-- 3) When you're slow you can always get up to running speed in the air
	if momentum.Magnitude < M.AirMinSpeed * mult then
		momentum = accelerate(momentum, dir, M.AirMinSpeed * mult, M.AirLowSpeedAccel, dt)
	end
end

local function tryStartWallRun(wish)
	-- Wall Runner power-up only, once per jump, with a cooldown
	if not stats().WallRun or not wall.Recharged or now() < wall.ReadyAt then
		return false
	end
	if momentum.Magnitude < M.WallRunMinSpeed or wish.Magnitude < 0.1 then
		return false
	end
	local params = makeRaycastParams()
	-- need some air under us
	if workspace:Raycast(root.Position, Vector3.new(0, -4, 0), params) then
		return false
	end
	local right = root.CFrame.RightVector
	for _, side in ipairs({ 1, -1 }) do
		local result = workspace:Raycast(root.Position, right * side * M.WallCheckDistance, params)
		if result and math.abs(result.Normal.Y) < 0.3 then
			local normal = Util.flat(result.Normal).Unit
			local recentlyLeft = wall.LastNormal
				and now() - wall.LastTime < M.WallReattachDelay
				and wall.LastNormal:Dot(normal) > 0.9
			local runningInto = math.abs(momentum.Unit:Dot(normal)) > 0.85
			if not recentlyLeft and not runningInto then
				mode = "WallRun"
				wall.Normal = normal
				wall.Side = side
				wall.Timer = 0
				wall.Y = math.max(root.AssemblyLinearVelocity.Y * 0.2, M.WallRunStartLift)
				wall.Recharged = false
				wall.ReadyAt = now() + stats().WallRunCooldown
							return true
			end
		end
	end
	return false
end

local function updateWallRun(dt, wish)
	local result =
		workspace:Raycast(root.Position, -wall.Normal * (M.WallCheckDistance + 1.5), makeRaycastParams())
	wall.Timer += dt
	local expired = wall.Timer > stats().WallRunTime
	if not result or math.abs(result.Normal.Y) > 0.3 or expired or wish.Magnitude < 0.1 then
		wall.LastNormal = wall.Normal
		wall.LastTime = now()
		mode = "Air"
		return
	end
	wall.Normal = Util.flat(result.Normal).Unit

	local along = Util.flat(momentum - wall.Normal * momentum:Dot(wall.Normal))
	if along.Magnitude < 1 then
		local look = cameraFlatLook()
		along = look - wall.Normal * look:Dot(wall.Normal)
	end
	-- no speed boost: capped, and the wall slowly drags you down
	local speed = math.min(momentum.Magnitude, M.WallRunMaxSpeed * speedMultiplier()) * (1 - M.WallRunDrag * dt)
	momentum = Util.safeUnit(along) * speed - wall.Normal * 3 -- press into the wall

	wall.Y -= M.WallRunGravity * dt
	setVerticalVelocity(wall.Y)
end

local function updateSlide(dt, wish)
	momentum = applyFriction(momentum, M.SlideFriction, dt)
	momentum = steer(momentum, wish, M.SlideSteer * dt)
	if momentum.Magnitude < M.SlideEndSpeed or (M.SlideHold and not slideHeld) then
		mode = "Ground"
		return
	end
	humanoid.WalkSpeed = 4 -- calm the run animation while sliding
end

local function updateGrapple(dt)
	grapple.Timer += dt
	local toPoint = grapple.Point - root.Position
	if toPoint.Magnitude < M.GrappleReleaseDistance or grapple.Timer > M.GrappleMaxTime then
		endGrapple(false)
		return
	end
	local velocity = Vector3.new(momentum.X, root.AssemblyLinearVelocity.Y, momentum.Z)
	local pull = M.GrapplePullSpeed * stats().GrapplePull
	velocity = approachVector(velocity, toPoint.Unit * pull, M.GrappleAccel * stats().GrapplePull * dt)
	momentum = Util.flat(velocity)
	setVerticalVelocity(velocity.Y)
end

local function tryStartCeiling()
	if not (stats().CeilingRun and jumpHeld) then
		return false
	end
	local result = workspace:Raycast(root.Position, Vector3.new(0, 5, 0), makeRaycastParams())
	if result and result.Normal.Y < -0.7 then
		mode = "Ceiling"
		return true
	end
	return false
end

local function updateCeiling(dt, wish)
	local result = workspace:Raycast(root.Position, Vector3.new(0, 5.5, 0), makeRaycastParams())
	if not jumpHeld or not result then
		mode = "Air"
		return
	end
	-- runs like the ground, but with no friction so you keep your speed
	if wish.Magnitude > 0.05 then
		momentum = accelerate(momentum, wish.Unit, M.SprintSpeed * speedMultiplier(), M.GroundAccel, dt)
	end
	setVerticalVelocity(3) -- keep pressed against the ceiling
	airJumpsLeft = stats().AirJumps
end

----------------------------------------------------------------------------
-- Bullet Time (power-up): scoped in mid-air -> slow time for yourself
----------------------------------------------------------------------------
local function updateBulletTime(dt, grounded)
	local cfg = PU.BulletTime
	local scoped = Controllers.Weapon.IsScoped()
	if Movement.IsBulletTime() then
		if grounded or not scoped then
			bulletTime.Until = 0
			Controllers.Effects.SetBulletTime(false)
			return
		end
		-- fall much slower
		local v = root.AssemblyLinearVelocity
		local y = v.Y + workspace.Gravity * (1 - cfg.GravityScale) * dt
		if y < 0 then
			y *= (1 - math.min(1, 6 * dt))
		end
		setVerticalVelocity(y)
		return
	end
	if Controllers.Effects.IsBulletTimeVisible() then
		Controllers.Effects.SetBulletTime(false)
	end
	if stats().BulletTime and scoped and not grounded and not bulletTime.UsedThisAir and now() >= bulletTime.ReadyAt then
		bulletTime.UsedThisAir = true
		bulletTime.Until = now() + stats().BulletTimeDuration
		bulletTime.ReadyAt = now() + cfg.Cooldown
		Remotes.Get("Ability"):FireServer("BulletTime", {})
		Controllers.Effects.SetBulletTime(true)
	end
end

----------------------------------------------------------------------------
-- Main step
----------------------------------------------------------------------------
local function step(dt)
	if not canMove() then
		if linearVelocity then
			linearVelocity.Enabled = false
		end
		momentum = Vector3.zero
		lastDrive = Vector3.zero
		pendingImpulse = Vector3.zero
		pendingLift = nil
		fovKick = 0
		if grapple.Point then
			grapple.Point = nil
			Controllers.Effects.SetLocalGrapple(nil)
		end
		return
	end
	linearVelocity.Enabled = true

	local velocity = root.AssemblyLinearVelocity
	local horizontal = Util.flat(velocity)

	-- If something blocked us (a wall), the real velocity is lower than what
	-- we commanded last frame: swap that part of our momentum for the real
	-- velocity. Changes made since then (slide boost, wall jump...) are kept.
	if mode ~= "Grapple" and mode ~= "WallRun" and not Movement.IsBulletTime() then
		if horizontal.Magnitude < lastDrive.Magnitude - 3 then
			momentum = horizontal + (momentum - lastDrive)
		end
	end

	-- External impulses (knockback / rocket jump / double jump)
	if pendingImpulse.Magnitude > 0 then
		momentum += pendingImpulse
		pendingImpulse = Vector3.zero
	end
	if pendingLift then
		setVerticalVelocity(pendingLift)
		if mode == "Ground" or mode == "Slide" or mode == "WallRun" or mode == "Ceiling" then
			mode = "Air"
		end
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		pendingLift = nil
		lastLiftTime = now()
	end

	-- "grounded" ignores the first moments after any jump/launch, so the
	-- floor we just left doesn't instantly count as a landing
	local justLaunched = now() - math.max(lastGroundJumpTime, lastLiftTime) < 0.12
	local grounded = Movement.IsGrounded() and not justLaunched
	local wish = wishDirection()
	if now() < forceJumpUntil and root.AssemblyLinearVelocity.Y < jumpPower() * 0.75 then
		setVerticalVelocity(jumpPower())
	end
	if not grounded then
		peakY = math.max(peakY, root.Position.Y) -- for Shockwave Landing
		lowestVelocityY = math.min(lowestVelocityY, velocity.Y)
	end

	-- Ground <-> air transitions
	if grounded and (mode == "Air" or mode == "WallRun" or mode == "Ceiling") then
		onLanded()
	elseif not grounded and (mode == "Ground" or mode == "Slide") then
		mode = "Air"
		peakY = root.Position.Y
	end

	-- JUMP / BUNNY HOP: holding Space (or a buffered press) jumps on the very
	-- frame we touch the ground, BEFORE friction runs, so no speed is lost.
	if grounded and (mode == "Ground" or mode == "Slide") then
		lastGroundedTime = now()
		wall.Recharged = true -- touching the ground recharges your wall run
		local wantsJump = (M.AutoBhop and jumpHeld) or (now() - jumpPressedAt < M.JumpBuffer)
		if wantsJump then
			groundJump()
		end
	end

	if mode == "Ground" then
		updateGround(dt, wish)
	elseif mode == "Slide" then
		updateSlide(dt, wish)
	elseif mode == "Air" then
		updateAir(dt, wish)
		if not tryStartCeiling() then
			tryStartWallRun(wish)
		end
	elseif mode == "WallRun" then
		updateWallRun(dt, wish)
	elseif mode == "Grapple" then
		updateGrapple(dt)
	elseif mode == "Ceiling" then
		updateCeiling(dt, wish)
	end

	-- hard speed limit
	local maxSpeed = M.MaxSpeed * stats().MoveSpeedMultiplier
	if momentum.Magnitude > maxSpeed then
		momentum = momentum.Unit * maxSpeed
	end

	-- never push into walls (prevents clipping / phasing through thin walls)
	if mode ~= "WallRun" then
		momentum = clipAgainstWalls(momentum, dt)
	end

	-- FEATHERWEIGHT power-up: cancel part of gravity while airborne
	local gravityScale = stats().GravityScale
	if gravityScale < 1 and mode == "Air" and not Movement.IsBulletTime() then
		local v = root.AssemblyLinearVelocity
		setVerticalVelocity(v.Y + workspace.Gravity * (1 - gravityScale) * dt)
	end

	updateBulletTime(dt, grounded)

	-- Drive the character
	local drive = momentum
	if Movement.IsBulletTime() then
		drive *= PU.BulletTime.MoveScale
	end
	linearVelocity.PlaneVelocity = Vector2.new(drive.X, drive.Z)
	lastDrive = drive
	humanoid.JumpPower = 0 -- jumps are done by this script (so the Jump key can be rebound)

	-- FOV kick from movement
	local speed = momentum.Magnitude
	local kick = 0
	if mode == "Slide" then
		kick = C.SlideFOVKick
	elseif mode == "WallRun" then
		kick = C.WallRunFOVKick
	elseif speed > M.RunSpeed + 2 then
		kick = C.SprintFOVKick
	end
	kick += math.clamp((speed - M.SprintSpeed) * C.SpeedFOVPerStud, 0, C.MaxSpeedFOV)
	fovKick = Util.lerp(fovKick, kick, Util.smooth(8, dt))
end

----------------------------------------------------------------------------
-- Character setup
----------------------------------------------------------------------------
local function onCharacterAdded(newCharacter)
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	root = newCharacter:WaitForChild("HumanoidRootPart")

	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0 -- jumps are done by this script (so the Jump key can be rebound)
	-- Roblox's own jump is always on Space; turn it off so only our Jump bind jumps
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	humanoid.WalkSpeed = M.RunSpeed

	local attachment = root:FindFirstChild("RootAttachment") or root:FindFirstChild("RootRigAttachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "MoveAttachment"
		attachment.Parent = root
	end

	linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.Name = "MoveVelocity"
	linearVelocity.Attachment0 = attachment
	linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	linearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	linearVelocity.PrimaryTangentAxis = Vector3.xAxis
	linearVelocity.SecondaryTangentAxis = Vector3.zAxis
	linearVelocity.MaxForce = 200000
	linearVelocity.Enabled = false
	linearVelocity.Parent = root

	mode = "Ground"
	momentum = Vector3.zero
	lastDrive = Vector3.zero
	airJumpsLeft = stats().AirJumps
	grapple.Point = nil
	speedBoost.Until = 0
	bulletTime.Until = 0
	peakY = root.Position.Y
	lowestVelocityY = 0

	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping and (mode == "Ground" or mode == "Slide") then
			lastGroundJumpTime = now()
		end
	end)
end

----------------------------------------------------------------------------
-- Input
----------------------------------------------------------------------------

-- Roblox's own control scripts bind Space (and some mouse buttons) with
-- ContextActionService, which marks those inputs as "processed". So we only
-- ignore input while the player is typing in a text box (e.g. chat).
local function isTyping(processed)
	return processed and UserInputService:GetFocusedTextBox() ~= nil
end

local function onInputBegan(input, processed)
	if isTyping(processed) then
		return
	end
	if Keybinds.Matches("Jump", input) then
		jumpHeld = true
		onJumpPressed()
	elseif Keybinds.Matches("Sprint", input) then
		sprintHeld = true
	elseif Keybinds.Matches("Slide", input) then
		slideHeld = true
		if canMove() then
			if mode == "Ground" then
				startSlide()
			elseif mode == "Slide" and not M.SlideHold then
				mode = "Ground" -- tap again to stand up
			elseif mode == "Air" then
				slidePressedAt = now() -- slide as soon as we land
			end
		end
	elseif Keybinds.Matches("Grapple", input) then
		if canMove() then
			if grapple.Point then
				endGrapple(false)
			else
				startGrapple()
			end
		end
	elseif Keybinds.Matches("Blink", input) then
		if canMove() and ClientState.CanShoot() then
			startBlink()
		end
	elseif Keybinds.Matches("Decoy", input) then
		if canMove() and ClientState.CanShoot() then
			startDecoy()
		end
	end
end

local function onInputEnded(input)
	if Keybinds.Matches("Jump", input) then
		jumpHeld = false
	elseif Keybinds.Matches("Sprint", input) then
		sprintHeld = false
	elseif Keybinds.Matches("Slide", input) then
		slideHeld = false
	end
end

function Movement.Init(controllers)
	Controllers = controllers
end

function Movement.Start()
	workspace.Gravity = M.Gravity

	if player.Character then
		task.spawn(onCharacterAdded, player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	Keybinds.VirtualBegan:Connect(onInputBegan) -- on-screen buttons (mobile)
	Keybinds.VirtualEnded:Connect(onInputEnded)

	Remotes.Get("Knockback").OnClientEvent:Connect(function(velocity)
		if typeof(velocity) == "Vector3" then
			Movement.ApplyImpulse(velocity)
			Controllers.Camera.Shake(2)
		end
	end)

	Remotes.Get("Buff").OnClientEvent:Connect(function(buff)
		if buff.Type == "SpeedBoost" then
			speedBoost.Until = now() + buff.Duration
			speedBoost.Multiplier = buff.Multiplier
		end
	end)

	RunService.Heartbeat:Connect(step)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--[[
	Sfx.lua  (Client.Sfx)
	Plays the sounds listed in Config.Sounds.

		Sfx.Play("Fire")                         -- 2D (UI / your own gun)
		Sfx.Play("Explosion", { Parent = part }) -- 3D at a part/attachment
		Sfx.Play("Hit", { Pitch = 1.2 })         -- pitch multiplier
]]

local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Sfx = {}

function Sfx.Play(name, options)
	local def = Config.Sounds[name]
	if not def then
		return nil
	end
	options = options or {}
	local sound = Instance.new("Sound")
	sound.SoundId = def.Id
	sound.Volume = (def.Volume or 0.5) * (options.Volume or 1)
	sound.PlaybackSpeed = (def.Pitch or 1) * (options.Pitch or 1)
	if options.Parent then
		sound.RollOffMaxDistance = 600
		sound.RollOffMinDistance = 12
		sound.Parent = options.Parent
	else
		sound.Parent = SoundService
	end
	sound:Play()
	Debris:AddItem(sound, 5)
	return sound
end

-- Plays a 3D sound at a world position (creates a tiny invisible anchor).
function Sfx.PlayAt(name, position, options)
	local anchor = Instance.new("Attachment")
	anchor.WorldPosition = position
	anchor.Parent = workspace.Terrain
	Debris:AddItem(anchor, 5)
	options = options or {}
	options.Parent = anchor
	return Sfx.Play(name, options)
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Spring</string>
            <string name="Source"><![CDATA[--[[
	Spring.lua  (Client.Spring)
	A damped spring for Vector3 values, used for viewmodel sway and recoil.

		local s = Spring.new(stiffness, damping)
		s.Target = Vector3.new(...)
		s:Impulse(Vector3.new(...))  -- kick the velocity
		s:Update(dt)                 -- returns s.Position
]]

local Spring = {}
Spring.__index = Spring

function Spring.new(stiffness, damping)
	return setmetatable({
		Stiffness = stiffness,
		Damping = damping,
		Position = Vector3.zero,
		Velocity = Vector3.zero,
		Target = Vector3.zero,
	}, Spring)
end

function Spring:Impulse(v)
	self.Velocity += v
end

function Spring:Update(dt)
	-- small fixed sub-steps keep it stable at low frame rates
	local steps = math.max(1, math.ceil(dt / (1 / 120)))
	local h = dt / steps
	for _ = 1, steps do
		local force = (self.Target - self.Position) * self.Stiffness - self.Velocity * self.Damping
		self.Velocity += force * h
		self.Position += self.Velocity * h
	end
	return self.Position
end

return Spring
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--[[
	UIController.lua  (Client.UIController)
	Creates every screen and forwards match-state changes to them.

	Screens (Client/ui):
		HUD           crosshair, scope, scoreboard, health, banners, hitmarkers
		PickScreen    power-up cards between rounds
		VictoryScreen end of match
		LobbyUI       find match / playground / bot buttons
		SettingsMenu  sliders + keybinds for mouse and controller (P)
		PowerUpLab    try power-ups solo in the lobby (B)
		Toast         short server messages (admin commands)
		DuelUI        challenge a player, duel / rematch invites
		MobileControls on-screen buttons + look pad for touch screens
]]

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local ClientState = require(script.Parent.ClientState)
local ui = script.Parent:WaitForChild("ui")
local HUD = require(ui.HUD)
local PickScreen = require(ui.PickScreen)
local VictoryScreen = require(ui.VictoryScreen)
local LobbyUI = require(ui.LobbyUI)
local SettingsMenu = require(ui.SettingsMenu)
local PowerUpLab = require(ui.PowerUpLab)
local Toast = require(ui.Toast)
local DuelUI = require(ui.DuelUI)
local MobileControls = require(ui.MobileControls)

local UIController = {}

UIController.HUD = HUD
UIController.Settings = SettingsMenu

function UIController.Init(controllers)
	controllers.HUD = HUD
	controllers.Settings = SettingsMenu
	controllers.Duel = DuelUI
	MobileControls.Init(controllers)
	HUD.Init(controllers)
	LobbyUI.Init(controllers)
	SettingsMenu.Init(controllers)
	VictoryScreen.Init(controllers)
end

function UIController.Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	-- No reset button (dying on purpose would skip rounds) and a clean screen
	task.spawn(function()
		for _ = 1, 10 do
			local ok = pcall(function()
				StarterGui:SetCore("ResetButtonCallback", false)
			end)
			if ok then
				break
			end
			task.wait(1)
		end
	end)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)

	HUD.Start(playerGui)
	PickScreen.Start(playerGui)
	VictoryScreen.Start(playerGui)
	LobbyUI.Start(playerGui)
	SettingsMenu.Start(playerGui)
	PowerUpLab.Start(playerGui)
	Toast.Start(playerGui)
	DuelUI.Start(playerGui)
	MobileControls.Start(playerGui)

	ClientState.Changed:Connect(function(snapshot, old)
		HUD.OnState(snapshot, old)
		PickScreen.OnState(snapshot, old)
		VictoryScreen.OnState(snapshot, old)
		LobbyUI.OnState(snapshot, old)
	end)
end

return UIController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ViewmodelController</string>
            <string name="Source"><![CDATA[--[[
	ViewmodelController.lua  (Client.ViewmodelController)

	First-person arms + sniper, built from flat-coloured parts and attached to
	the camera. Only YOU see it (it lives inside workspace.CurrentCamera).
	The rifle itself comes from Shared/GunModel (same model other players see).

	All animation is procedural (no animation assets needed):
		equip     gun swings up into view when you spawn
		sway      lags behind mouse movement
		bob       figure-8 walk/run bob, stronger when sprinting
		jump/land gun dips when you jump and slams down when you land hard
		dash      gun pulls back
		poses     lowered while sprinting, canted while sliding, tilted on wall runs
		recoil    kick back + up, muzzle flash
		bolt      right hand leaves the grip, works the bolt, comes back
		aim       slides to the centre when scoping, then hides behind the scope
		inspect   press V to admire the rifle
	power-ups your power-ups change how it moves (see "Power-up animation
	          styles" below): spin-cocking, heavy kicks, twirls, kill flourishes...

	Gun space: origin = right hand on the grip, +X right, +Y up, -Z forward.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GunModel = require(Shared.GunModel)
local Util = require(Shared.Util)
local ClientState = require(script.Parent.ClientState)
local Spring = require(script.Parent.Spring)
local Sfx = require(script.Parent.Sfx)
local Keybinds = require(script.Parent.Keybinds)
local Remotes = require(Shared.Remotes)

local Palette = Config.Palette
local VM = Config.Viewmodel
local player = Players.LocalPlayer

local Viewmodel = {}
local Controllers

local rad = math.rad

-- Where the grip sits in camera space when hip-firing / aiming down the scope.
local HIP_OFFSET = CFrame.new(0.62, -0.7, -1.1)
local SPRINT_POSE = CFrame.new(-0.1, -0.22, 0.15) * CFrame.Angles(rad(-16), rad(38), rad(14))
local EQUIP_POSE = CFrame.new(0.15, -1.2, 0.45) * CFrame.Angles(rad(-55), rad(25), rad(20))

-- Hands (gun space)
local RIGHT_GRIP = CFrame.new(0, -0.22, 0.18) * CFrame.Angles(rad(-18), 0, 0)
-- Arm joints (gun space). Shoulders sit behind the camera, out of view.
local RIGHT_ELBOW = Vector3.new(0.42, -0.62, 0.78)
local RIGHT_SHOULDER = Vector3.new(0.95, -1.1, 1.9)
local LEFT_ELBOW = Vector3.new(-0.42, -0.62, -0.55)
local LEFT_SHOULDER = Vector3.new(-1.0, -1.05, 0.95)

local model
local gun -- result of GunModel.Build
local parts = {} -- extra parts: hands, arms, flash
local visible = false

local swaySpring = Spring.new(140, 16) -- rotation (degrees)
local recoilSpring = Spring.new(220, 18) -- X = pitch, Y = push back, Z = roll
local moveSpring = Spring.new(150, 13) -- position offset from jumps / landings / dashes
local bobTime = 0
local sprintAlpha, slideAlpha, wallAlpha, airOffset = 0, 0, 0, 0
local wallRetract = 0 -- studs the gun is pulled back because a wall is in front of you
local retractParams = RaycastParams.new()
retractParams.FilterType = Enum.RaycastFilterType.Exclude
local boltStart, boltDuration = 0, 0
local boltSoundPlayed = true
local equipStart = -10
local inspectStart, inspecting = 0, false
local flashUntil = 0
local lastCharacter
local hadGun = false

----------------------------------------------------------------------------
-- Building
----------------------------------------------------------------------------
local function addPart(name, size, color, shape)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	if shape then
		part.Shape = shape
	end
	part.Parent = model
	parts[name] = part
	return part
end

-- A string that changes whenever your power-ups change.
local function ownedSignature(owned)
	local list = {}
	for id, stacks in pairs(owned) do
		table.insert(list, id .. "=" .. stacks)
	end
	table.sort(list)
	return table.concat(list, ",")
end
local builtSignature = nil
local builtLevel = 0

local function setGunEffects(on)
	for _, part in pairs(gun.Parts) do
		for _, child in ipairs(part:GetChildren()) do
			if child:IsA("ParticleEmitter") or child:IsA("PointLight") then
				child.Enabled = on
			end
		end
	end
end

-- (Re)builds the rifle with an attachment for every power-up you own.
-- Returns true if you gained something (so we can show it off).
local function buildGun()
	local owned = ClientState.Owned or {}
	local signature = ownedSignature(owned) .. (GunModel.FindTemplate() and "|mesh" or "")
	if gun and signature == builtSignature then
		return false
	end
	if gun then
		for _, part in pairs(gun.Parts) do
			part:Destroy()
		end
	end
	builtSignature = signature
	gun = GunModel.Build(model, { Anchored = true, PowerUps = owned })
	for _, part in pairs(gun.Parts) do
		part.LocalTransparencyModifier = visible and 0 or 1
	end
	setGunEffects(visible)
	local level = GunModel.PowerLevel(owned)
	local gained = level > builtLevel
	builtLevel = level
	return gained
end

local function build()
	model = Instance.new("Model")
	model.Name = "Viewmodel"
	buildGun()

	-- Gloved hands
	for _, side in ipairs({ "Right", "Left" }) do
		addPart(side .. "Palm", Vector3.new(0.21, 0.27, 0.25), Palette.Glove)
		addPart(side .. "Fingers", Vector3.new(0.22, 0.23, 0.08), Palette.Glove)
		addPart(side .. "Thumb", Vector3.new(0.07, 0.07, 0.19), Palette.Glove)
		addPart(side .. "Cuff", Vector3.new(0.3, 0.3, 0.14), Palette.SleeveCuff)
		addPart(side .. "Forearm", Vector3.new(0.27, 0.27, 1), Palette.Sleeve)
		addPart(side .. "Elbow", Vector3.new(0.3, 0.3, 0.3), Palette.Sleeve, Enum.PartType.Ball)
		addPart(side .. "UpperArm", Vector3.new(0.32, 0.32, 1), Palette.Sleeve)
	end
	-- the left palm lies flat under the handguard
	parts.LeftPalm.Size = Vector3.new(0.27, 0.1, 0.33)
	parts.LeftFingers.Size = Vector3.new(0.06, 0.2, 0.28)
	parts.LeftThumb.Size = Vector3.new(0.06, 0.14, 0.2)

	-- Muzzle flash (a flat star)
	addPart("FlashCore", Vector3.new(0.4, 0.4, 0.4), Palette.MuzzleFlash, Enum.PartType.Ball)
	addPart("FlashA", Vector3.new(0.07, 0.9, 0.07), Palette.MuzzleFlash)
	addPart("FlashB", Vector3.new(0.9, 0.07, 0.07), Palette.MuzzleFlash)
	addPart("FlashLong", Vector3.new(0.12, 0.12, 0.7), Palette.MuzzleFlash)
	for _, name in ipairs({ "FlashCore", "FlashA", "FlashB", "FlashLong" }) do
		if Config.Effects.NeonEffects then
			parts[name].Material = Enum.Material.Neon -- glows with bloom
		end
	end
	-- a light that flashes with each shot (lights up your arms and the room)
	local light = Instance.new("PointLight")
	light.Name = "MuzzleLight"
	light.Color = Palette.MuzzleFlash
	light.Range = 14
	light.Brightness = 0
	light.Shadows = false
	light.Parent = parts.FlashCore

	model.Parent = workspace.CurrentCamera
end

----------------------------------------------------------------------------
-- Avatar arms (Config.Viewmodel.UseAvatarArms)
----------------------------------------------------------------------------
--[[
	Your first-person arms are a copy of your own avatar's arms: skin
	colour, shirt and all. The copy sits in a little model with a Humanoid
	(that's what makes the shirt show up), is scaled down to
	ArmThickness so it fits the rifle, and each part is stretched between
	the same shoulder / elbow / hand points the plain arms use. If your
	character has no R15 arms, the plain gloved arms are used instead.
]]
local ARM_NAMES = { "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperArm", "LeftLowerArm", "LeftHand" }
local BLOCK_PIECES = { "Palm", "Fingers", "Thumb", "Cuff", "Forearm", "Elbow", "UpperArm" }
local avatarArms -- { Model, Parts = {[name] = part}, Base = {[name] = original size} }

local function setBlockArms(shown)
	for _, side in ipairs({ "Right", "Left" }) do
		for _, piece in ipairs(BLOCK_PIECES) do
			local part = parts[side .. piece]
			if part then
				part.Transparency = shown and 0 or 1
			end
		end
	end
end

local function buildAvatarArms(character)
	if avatarArms then
		avatarArms.Model:Destroy()
		avatarArms = nil
	end
	if not Config.Viewmodel.UseAvatarArms or not character then
		setBlockArms(true)
		return
	end
	for _, name in ipairs(ARM_NAMES) do
		if not character:FindFirstChild(name) then
			setBlockArms(true)
			return
		end
	end
	local rig = Instance.new("Model")
	rig.Name = "AvatarArms"
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.EvaluateStateMachine = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = rig
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Shirt") or item:IsA("BodyColors") then
			item:Clone().Parent = rig
		end
	end
	local armParts, base = {}, {}
	for _, name in ipairs(ARM_NAMES) do
		local source = character[name]
		local ok, part = pcall(function()
			return source:Clone()
		end)
		if not ok or not part then
			rig:Destroy()
			setBlockArms(true)
			return
		end
		for _, child in ipairs(part:GetChildren()) do
			if not (child:IsA("SurfaceAppearance") or child:IsA("SpecialMesh") or child:IsA("Decal") or child:IsA("Texture")) then
				child:Destroy()
			end
		end
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Massless = true
		part.Transparency = 0
		part.Parent = rig
		armParts[name] = part
		base[name] = source.Size
	end
	for _, part in pairs(armParts) do
		part.LocalTransparencyModifier = visible and 0 or 1
	end
	rig.Parent = model
	avatarArms = { Model = rig, Parts = armParts, Base = base }
	setBlockArms(false)
end

-- CFrame (gun space) for an avatar limb stretched from a to b, `thick` studs wide.
local function avatarLimb(name, a, b, thick)
	local part, base = avatarArms.Parts[name], avatarArms.Base[name]
	-- rounded so the mesh isn't resized every frame (that can hitch)
	local length = math.max(math.floor((b - a).Magnitude * 20 + 0.5) / 20, 0.05)
	local k = thick / math.max(base.X, 0.01)
	local size = Vector3.new(base.X * k, length, base.Z * k)
	if (part.Size - size).Magnitude > 0.001 then
		part.Size = size
	end
	-- the limb's -Y runs from a (shoulder end) to b (hand end)
	return CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(rad(90), 0, 0)
end

-- CFrame-free helper: scales an avatar hand to fit and returns its size.
local function avatarHandSize(name, width)
	local part, base = avatarArms.Parts[name], avatarArms.Base[name]
	local size = base * (width / math.max(base.X, 0.01))
	if (part.Size - size).Magnitude > 0.001 then
		part.Size = size
	end
	return size
end

-- CFrame for a limb part stretched between points a and b.
local function limbBetween(part, a, b)
	local length = math.max((b - a).Magnitude, 0.05)
	if math.abs(part.Size.Z - length) > 0.001 then
		part.Size = Vector3.new(part.Size.X, part.Size.Y, length)
	end
	return CFrame.lookAt((a + b) / 2, b)
end

----------------------------------------------------------------------------
-- Animation helpers
----------------------------------------------------------------------------
local function easeOutBack(t)
	local c1, c3 = 1.4, 2.4
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end

local function seg(t, a, b)
	return math.clamp((t - a) / (b - a), 0, 1)
end

local function smoothstep(t)
	return t * t * (3 - 2 * t)
end

-- Bolt cycle for progress t (0-1).
-- Returns: bolt pivot CFrame (gun space), right hand CFrame (gun space), gun roll.
local function boltPose(t)
	-- reach (0-.15) lift (.15-.3) pull (.3-.5) push (.5-.68) lower (.68-.8) return (.8-1)
	local lift = smoothstep(seg(t, 0.15, 0.3)) - smoothstep(seg(t, 0.68, 0.8))
	local pull = smoothstep(seg(t, 0.3, 0.5)) - smoothstep(seg(t, 0.5, 0.68))
	-- the bolt turns up around the bore line, then slides back and forward
	local profile = gun.Profile
	local pivot = profile.BoltPivot
		* CFrame.new(0, 0, pull * profile.BoltTravel)
		* CFrame.Angles(0, 0, rad(profile.BoltLift) * lift)
	local onKnob = pivot * profile.KnobHold * CFrame.Angles(0, 0, rad(-25))
	local reach = smoothstep(seg(t, 0, 0.15))
	local back = smoothstep(seg(t, 0.8, 1))
	local hand
	if t <= 0 or t >= 1 then
		hand = RIGHT_GRIP
	elseif t < 0.15 then
		hand = RIGHT_GRIP:Lerp(onKnob, reach)
	elseif t < 0.8 then
		hand = onKnob
	else
		hand = onKnob:Lerp(RIGHT_GRIP, back)
	end
	local roll = math.sin(math.clamp(t, 0, 1) * math.pi) * rad(16)
	return pivot, hand, roll
end

----------------------------------------------------------------------------
-- Power-up animation styles
----------------------------------------------------------------------------
--[[
	Your power-ups change how the rifle moves:
	  fire     Explosive Rounds / Glass Cannon: heavy kick that shoves the rifle back
	           Split Shot: double kick   Hair Trigger / Quickdraw: short snappy kick
	           Static Charge: the rifle buzzes with electricity for a moment
	  bolt     Hair Trigger / Quickdraw: spin-cock (the rifle spins round the barrel)
	           Bullet Time: smooth bolt with the rifle tilted up to admire it
	           Explosive Rounds / Split Shot: heavy pump, pulled back toward you
	           Ricochet / Pinball: the rifle bounces while you work the bolt
	  equip    Quickdraw: twirls into your hands   Ghost Round: phases in
	  idle     Ghost Round: floats   Momentum Rounds: leans with your speed
	           Static Charge: random twitches   Vampire: heartbeat pulse
	  kills    Ricochet / Pinball: barrel spin   Explosive Rounds: tilts up to blow
	           the smoke away   Vampire: pulls the rifle in   otherwise: a nod
	  inspect  with power-ups: turns the rifle both ways to show the attachments
]]
local function has(id)
	return (ClientState.Owned[id] or 0) > 0
end

local boltStyle, equipStyle = "Normal", "Normal"
local flourish, flourishStart = nil, -10
local jitterUntil, nextTwitch = 0, 0

local function chooseBoltStyle()
	if has("HairTrigger") or has("Quickdraw") then
		return "Spin"
	elseif has("BulletTime") then
		return "Admire"
	elseif has("ExplosiveRounds") or has("SplitShot") then
		return "Heavy"
	elseif has("Ricochet") or has("Pinball") then
		return "Bounce"
	end
	return "Normal"
end

-- Rotation around the barrel (gun space)
local function aroundBarrel(angle)
	local axis = CFrame.new(0, gun.Profile.BarrelY, 0)
	return axis * CFrame.Angles(0, 0, angle) * axis:Inverse()
end

----------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------
function Viewmodel.PlayFire(scoped)
	local kick = scoped and 0.5 or 1
	if has("ExplosiveRounds") or has("GlassCannon") then
		kick *= 1.5
		moveSpring:Impulse(Vector3.new(0, 0.8, scoped and 1.5 or 4.5))
	elseif has("HairTrigger") or has("Quickdraw") then
		kick *= 0.7
	end
	recoilSpring:Impulse(Vector3.new(22 * kick, 9 * kick, (math.random() - 0.5) * 8))
	if has("SplitShot") then
		task.delay(0.07, function()
			recoilSpring:Impulse(Vector3.new(12 * kick, 5 * kick, (math.random() - 0.5) * 12))
		end)
	end
	if has("StaticCharge") then
		jitterUntil = os.clock() + 0.3
	end
	flashUntil = os.clock() + 0.05
	inspecting = false
end

function Viewmodel.PlayBolt(duration)
	boltStart = os.clock()
	boltDuration = duration
	boltSoundPlayed = false
	boltStyle = chooseBoltStyle()
end

function Viewmodel.PlayEquip()
	equipStart = os.clock()
	inspecting = false
	equipStyle = has("Quickdraw") and "Twirl" or (has("GhostRound") and "Phase" or "Normal")
	Sfx.Play("Bolt", { Pitch = 1.3, Volume = 0.6 })
end

-- A little flourish after a kill (plays once the bolt is cycled).
function Viewmodel.PlayKill()
	if has("Ricochet") or has("Pinball") then
		flourish = "Spin"
	elseif has("ExplosiveRounds") then
		flourish = "Blow"
	elseif has("Vampire") then
		flourish = "Feed"
	else
		flourish = "Nod"
	end
	flourishStart = math.max(os.clock() + 0.1, boltStart + boltDuration)
end

function Viewmodel.GetMuzzlePosition()
	if gun and gun.Parts.Receiver then
		local grip = gun.Parts.Receiver.CFrame * gun.Offsets.Receiver:Inverse()
		return (grip * gun.Profile.Muzzle).Position
	end
	return workspace.CurrentCamera.CFrame.Position
end

function Viewmodel.GetLeftHandPosition()
	return parts.LeftPalm and parts.LeftPalm.Position or workspace.CurrentCamera.CFrame.Position
end

local function setVisible(v)
	if v == visible then
		return
	end
	visible = v
	for _, part in pairs(gun.Parts) do
		part.LocalTransparencyModifier = v and 0 or 1
	end
	setGunEffects(v)
	for name, part in pairs(parts) do
		if not name:find("Flash") then
			part.LocalTransparencyModifier = v and 0 or 1
		end
	end
	if avatarArms then
		for _, part in pairs(avatarArms.Parts) do
			part.LocalTransparencyModifier = v and 0 or 1
		end
	end
end

----------------------------------------------------------------------------
-- Per-frame update
----------------------------------------------------------------------------
local function update(dt)
	local camera = workspace.CurrentCamera
	if model.Parent ~= camera then
		model.Parent = camera
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local alive = humanoid ~= nil and humanoid.Health > 0
	local hasGun = ClientState.HasGun()
	local scopeAlpha = Controllers.Weapon.GetScopeAlpha()

	-- replay the equip animation on a new life / when the gun comes back
	if alive and hasGun and (character ~= lastCharacter or not hadGun) then
		Viewmodel.PlayEquip()
	end
	lastCharacter = character
	hadGun = alive and hasGun

	local shouldShow = alive and hasGun and Controllers.Camera.IsFirstPerson() and scopeAlpha < 0.92
	setVisible(shouldShow)
	if not shouldShow then
		for name, part in pairs(parts) do
			if name:find("Flash") then
				part.LocalTransparencyModifier = 1
			end
		end
		if not hasGun then
			return
		end
	end

	local movement = Controllers.Movement
	local mode = movement.GetMode()
	local speed = movement.GetSpeed()
	local grounded = movement.IsGrounded()
	local t = os.clock()

	-- SWAY from mouse movement
	local delta = UserInputService:GetMouseDelta()
	local swayScale = (1 - scopeAlpha * 0.85) * VM.SwayAmount
	swaySpring.Target = Vector3.new(
		math.clamp(-delta.Y * swayScale, -5, 5),
		math.clamp(-delta.X * swayScale, -5, 5),
		math.clamp(-delta.X * swayScale * 0.7, -4, 4)
	)
	local sway = swaySpring:Update(dt)

	-- BOB: figure-8 while running on the ground
	local running = grounded and speed > 2 and mode == "Ground"
	if running then
		bobTime += dt * (7 + speed * 0.2)
	end
	local bobAmount = running and math.clamp(speed / Config.Movement.RunSpeed, 0, 1.4) * (1 - scopeAlpha * 0.9) * VM.BobAmount or 0
	local idle = math.sin(t * 1.7) * 0.012
	local bobPos = Vector3.new(math.sin(bobTime) * 0.05, math.sin(bobTime * 2) * 0.035 + idle, 0) * bobAmount
	local bobRoll = math.sin(bobTime) * rad(2.2) * bobAmount

	-- POSES
	local boltT = boltDuration > 0 and (t - boltStart) / boltDuration or 1
	local cycling = boltT < 1
	local sprinting = movement.IsSprinting() and scopeAlpha < 0.1 and not cycling
	sprintAlpha = Util.lerp(sprintAlpha, sprinting and 1 or 0, Util.smooth(10, dt))
	slideAlpha = Util.lerp(slideAlpha, mode == "Slide" and 1 or 0, Util.smooth(12, dt))
	wallAlpha = Util.lerp(wallAlpha, movement.GetWallSide(), Util.smooth(10, dt))
	local vy = root and root.AssemblyLinearVelocity.Y or 0
	airOffset = Util.lerp(airOffset, grounded and 0 or math.clamp(-vy * 0.0025, -0.1, 0.1), Util.smooth(8, dt))

	-- EQUIP
	local equipTime = equipStyle == "Twirl" and VM.EquipTime * 1.4 or VM.EquipTime
	local equipT = math.clamp((t - equipStart) / equipTime, 0, 1)
	local equipPose = EQUIP_POSE:Lerp(CFrame.identity, easeOutBack(equipT))
	if equipStyle == "Twirl" then
		equipPose *= CFrame.Angles(0, (1 - smoothstep(equipT)) * math.pi * 2, 0)
	end
	local phaseFade = equipStyle == "Phase" and (1 - smoothstep(equipT)) or 0

	-- INSPECT (V)
	local inspectPose = CFrame.identity
	if inspecting then
		local it = (t - inspectStart) / 2.4
		if it >= 1 or scopeAlpha > 0.05 or cycling then
			inspecting = false
		else
			local w = math.sin(it * math.pi) ^ 0.7
			local wiggle = math.sin(it * math.pi * 3) * 0.08 * w
			if GunModel.PowerLevel(ClientState.Owned) > 0 then
				-- show off the attachments: turn it one way, then the other
				local turn = math.sin(it * math.pi * 2)
				inspectPose = CFrame.new(-0.4 * w, 0.22 * w, 0.35 * w)
					* CFrame.Angles(rad(14) * w + wiggle, rad(70) * turn * w, rad(-30) * w)
			else
				inspectPose = CFrame.new(-0.4 * w, 0.2 * w, 0.3 * w)
					* CFrame.Angles(rad(12) * w + wiggle, rad(55) * w, rad(-40) * w)
			end
		end
	end

	-- SPRINGS
	local recoil = recoilSpring:Update(dt)
	local kick = moveSpring:Update(dt)

	-- BOLT
	local boltPivot, rightHand, boltRoll = boltPose(math.clamp(boltT, 0, 1))

	-- POWER-UP STYLES (see the table above PlayFire)
	local styleOffset = CFrame.identity
	if cycling then
		local bt = math.clamp(boltT, 0, 1)
		local w = math.sin(bt * math.pi)
		if boltStyle == "Spin" then
			-- no hand on the bolt: the rifle spins once round the barrel instead
			rightHand, boltPivot, boltRoll = RIGHT_GRIP, gun.Profile.BoltPivot, 0
			styleOffset = aroundBarrel(-smoothstep(bt) * math.pi * 2)
		elseif boltStyle == "Admire" then
			styleOffset = CFrame.new(-0.1 * w, 0.14 * w, 0.12 * w) * CFrame.Angles(rad(16) * w, rad(-14) * w, 0)
		elseif boltStyle == "Heavy" then
			styleOffset = CFrame.new(0, -0.1 * w, 0.4 * w) * CFrame.Angles(rad(-10) * w, 0, 0)
		elseif boltStyle == "Bounce" then
			styleOffset = CFrame.new(0, math.abs(math.sin(bt * math.pi * 3)) * 0.14 * (1 - bt), 0)
		end
	end
	local calm = 1 - scopeAlpha
	local idlePose = CFrame.identity
	if has("GhostRound") then
		idlePose *= CFrame.new(math.sin(t * 0.9) * 0.03 * calm, math.sin(t * 1.3) * 0.035 * calm, 0)
			* CFrame.Angles(0, 0, math.sin(t * 0.7) * rad(2) * calm)
	end
	if has("MomentumRounds") then
		local lean = math.clamp((speed - 30) / 40, 0, 1) * calm
		idlePose *= CFrame.Angles(rad(-6) * lean, 0, rad(6) * lean)
	end
	if has("Vampire") then
		local beat = t % 1.1
		local pulse = math.exp(-((beat - 0.1) / 0.05) ^ 2) + 0.6 * math.exp(-((beat - 0.32) / 0.05) ^ 2)
		idlePose *= CFrame.new(0, 0, -0.035 * pulse * calm)
	end
	if has("StaticCharge") and t > nextTwitch then
		nextTwitch = t + 1.2 + math.random() * 2
		recoilSpring:Impulse(Vector3.new((math.random() - 0.5) * 8, 0, (math.random() - 0.5) * 14) * calm)
	end
	if t < jitterUntil then
		idlePose *= CFrame.Angles(rad((math.random() - 0.5) * 3), rad((math.random() - 0.5) * 3), 0)
	end
	-- kill flourish
	local flourishPose = CFrame.identity
	if flourish and t >= flourishStart then
		local ft = (t - flourishStart) / 0.75
		if ft >= 1 then
			flourish = nil
		else
			local w = math.sin(ft * math.pi) * calm
			if flourish == "Spin" then
				flourishPose = aroundBarrel(smoothstep(ft) * math.pi * 2 * calm)
			elseif flourish == "Blow" then
				flourishPose = CFrame.new(-0.25 * w, 0.28 * w, 0.3 * w) * CFrame.Angles(rad(38) * w, rad(25) * w, 0)
			elseif flourish == "Feed" then
				flourishPose = CFrame.new(-0.22 * w, -0.05 * w, 0.4 * w) * CFrame.Angles(0, rad(30) * w, rad(-22) * w)
			else
				flourishPose = CFrame.Angles(rad(-9) * w, 0, rad(4) * w)
			end
		end
	end
	if cycling and not boltSoundPlayed and boltT > 0.3 then
		boltSoundPlayed = true
		Sfx.Play("Bolt")
	end

	-- Combine everything into the grip CFrame (camera space -> world)
	-- WALL RETRACT: if a wall is closer than the end of the barrel, pull the
	-- rifle back and tilt it up so it never pokes through walls
	local exclude = { camera }
	if character then
		table.insert(exclude, character)
	end
	local effects = workspace:FindFirstChild("Effects")
	if effects then
		table.insert(exclude, effects)
	end
	retractParams.FilterDescendantsInstances = exclude
	local reach = 5.4
	local wallHit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * reach, retractParams)
	local wantRetract = wallHit and math.clamp(reach - wallHit.Distance, 0, 3.6) or 0
	wallRetract = Util.lerp(wallRetract, wantRetract * (1 - scopeAlpha), Util.smooth(14, dt))
	local retractAlpha = wallRetract / 3.6

	local eye = gun.Profile.ScopeEye
	local adsOffset = CFrame.new(-eye.X, -eye.Y, -0.55 - eye.Z)
	local base = HIP_OFFSET:Lerp(adsOffset, scopeAlpha)
		* CFrame.new(0.1 * retractAlpha, -0.15 * retractAlpha, wallRetract)
		* CFrame.Angles(rad(28) * retractAlpha, rad(12) * retractAlpha, rad(-10) * retractAlpha)
	local pose = CFrame.identity:Lerp(SPRINT_POSE, sprintAlpha)
		* CFrame.new(0, -0.14 * slideAlpha, 0.05 * slideAlpha)
		* CFrame.Angles(0, 0, rad(-18) * slideAlpha)
		* CFrame.Angles(0, 0, rad(9) * wallAlpha)
	local grip = camera.CFrame
		* base
		* equipPose
		* inspectPose
		* pose
		* CFrame.new(bobPos.X + kick.X, bobPos.Y + airOffset + kick.Y, kick.Z + recoil.Y * 0.02)
		* CFrame.Angles(rad(sway.X + recoil.X * 0.35), rad(sway.Y), rad(sway.Z + recoil.Z * 0.3) + bobRoll)
		* CFrame.Angles(0, 0, -boltRoll)
		* idlePose
		* flourishPose
		* styleOffset

	local list, cframes = {}, {}
	local function put(part, cf)
		table.insert(list, part)
		table.insert(cframes, cf)
	end

	-- Gun (bolt parts follow the animated bolt pivot; power-up parts animate)
	local boltWorld = grip * boltPivot
	local fast = math.clamp((speed - 30) / 40, 0, 1)
	for name, part in pairs(gun.Parts) do
		local offset = gun.Offsets[name]
		local anim = gun.Anims[name]
		if anim then
			local base = gun.BaseTransparency[name]
			local fade = 0
			if anim == "Spin" then
				offset = aroundBarrel(t * 3) * offset
			elseif anim == "Tick" then
				offset = offset * CFrame.Angles(-t * 2, 0, 0)
			elseif anim == "Turn" then
				offset = CFrame.new(offset.Position) * CFrame.Angles(0, t * 2.5, 0) * offset.Rotation
			elseif anim == "Pulse" then
				fade = 0.3 * (1 + math.sin(t * 4)) / 2
			elseif anim == "Ghost" then
				fade = 0.5 * (1 + math.sin(t * 6 + offset.Position.Z * 8)) / 2
			elseif anim == "Flicker" then
				fade = math.random() < 0.25 and 0.85 or 0
			elseif anim == "Speed" then
				fade = 0.85 * (1 - fast)
			end
			if shouldShow then
				part.LocalTransparencyModifier = math.min(1, math.max(fade / math.max(1 - base, 0.01), phaseFade))
			end
		elseif shouldShow and (phaseFade > 0 or part.LocalTransparencyModifier ~= 0) then
			part.LocalTransparencyModifier = phaseFade -- Ghost Round equip: phase in
		end
		put(part, (gun.Bolt[name] and boltWorld or grip) * offset)
	end
	-- glow lines breathe, and flare white for a moment when you fire
	local flare = math.clamp((flashUntil - t) / 0.05, 0, 1)
	local glow = gun.GlowColor:Lerp(Color3.new(1, 1, 1), 0.12 * (1 + math.sin(t * 2.4)) / 2 + flare * 0.6)
	for _, part in ipairs(gun.Glow) do
		part.Color = glow
	end

	-- Right hand + arm
	local rh = grip * rightHand
	put(parts.RightPalm, rh)
	put(parts.RightFingers, rh * CFrame.new(0, -0.02, -0.15))
	put(parts.RightThumb, rh * CFrame.new(-0.12, 0.07, -0.06))
	local rWrist = (rightHand * CFrame.new(0, -0.04, 0.17)).Position
	put(parts.RightCuff, grip * limbBetween(parts.RightCuff, rWrist, rWrist + (RIGHT_ELBOW - rWrist).Unit * 0.14))
	put(parts.RightForearm, grip * limbBetween(parts.RightForearm, RIGHT_ELBOW, rWrist))
	put(parts.RightElbow, grip * CFrame.new(RIGHT_ELBOW))
	put(parts.RightUpperArm, grip * limbBetween(parts.RightUpperArm, RIGHT_SHOULDER, RIGHT_ELBOW))

	-- Left hand + arm (holds the handguard)
	local LEFT_HOLD = gun.Profile.LeftHold
	local lh = grip * LEFT_HOLD
	put(parts.LeftPalm, lh)
	put(parts.LeftFingers, lh * CFrame.new(0.155, 0.09, 0))
	put(parts.LeftThumb, lh * CFrame.new(-0.155, 0.07, 0.02))
	local lWrist = (LEFT_HOLD * CFrame.new(-0.05, -0.06, 0.2)).Position
	put(parts.LeftCuff, grip * limbBetween(parts.LeftCuff, lWrist, lWrist + (LEFT_ELBOW - lWrist).Unit * 0.14))
	put(parts.LeftForearm, grip * limbBetween(parts.LeftForearm, LEFT_ELBOW, lWrist))
	put(parts.LeftElbow, grip * CFrame.new(LEFT_ELBOW))
	put(parts.LeftUpperArm, grip * limbBetween(parts.LeftUpperArm, LEFT_SHOULDER, LEFT_ELBOW))

	-- Avatar arms (replace the plain arms above when available)
	if avatarArms then
		local thick = Config.Viewmodel.ArmThickness or 0.3
		local hide = visible and 0 or 1
		for _, part in pairs(avatarArms.Parts) do
			part.LocalTransparencyModifier = hide
		end
		-- right: hand on the grip (or the bolt), wrist at the top of the hand
		local rSize = avatarHandSize("RightHand", thick * 0.95)
		local rHandCF = rightHand * CFrame.new(0, -0.02, 0)
		local rWristA = (rHandCF * CFrame.new(0, rSize.Y / 2, 0)).Position
		put(avatarArms.Parts.RightHand, grip * rHandCF)
		put(avatarArms.Parts.RightLowerArm, grip * avatarLimb("RightLowerArm", RIGHT_ELBOW, rWristA, thick * 0.9))
		put(avatarArms.Parts.RightUpperArm, grip * avatarLimb("RightUpperArm", RIGHT_SHOULDER, RIGHT_ELBOW, thick))
		-- left: palm up under the handguard, fingers curled toward the right
		local lSize = avatarHandSize("LeftHand", thick * 0.95)
		local lHandCF = LEFT_HOLD * CFrame.new(0, -0.03, 0) * CFrame.Angles(0, 0, rad(90))
		local lWristA = (lHandCF * CFrame.new(0, lSize.Y / 2, 0)).Position
		put(avatarArms.Parts.LeftHand, grip * lHandCF)
		put(avatarArms.Parts.LeftLowerArm, grip * avatarLimb("LeftLowerArm", LEFT_ELBOW, lWristA, thick * 0.9))
		put(avatarArms.Parts.LeftUpperArm, grip * avatarLimb("LeftUpperArm", LEFT_SHOULDER, LEFT_ELBOW, thick))
	end

	-- Muzzle flash
	local flashing = shouldShow and t < flashUntil
	local muzzle = grip * gun.Profile.Muzzle * CFrame.Angles(0, 0, math.random() * math.pi)
	for _, name in ipairs({ "FlashCore", "FlashA", "FlashB", "FlashLong" }) do
		parts[name].LocalTransparencyModifier = flashing and 0 or 1
	end
	if Config.Effects.Lights then
		parts.FlashCore.MuzzleLight.Brightness = flashing and 7 or 0
	end
	put(parts.FlashCore, muzzle * CFrame.new(0, 0, -0.15))
	put(parts.FlashA, muzzle * CFrame.new(0, 0, -0.15))
	put(parts.FlashB, muzzle * CFrame.new(0, 0, -0.15))
	put(parts.FlashLong, muzzle * CFrame.new(0, 0, -0.45))

	workspace:BulkMoveTo(list, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

function Viewmodel.Init(controllers)
	Controllers = controllers
end

function Viewmodel.Start()
	build()
	visible = true
	setVisible(false)

	-- movement reactions
	Controllers.Movement.Jumped:Connect(function()
		moveSpring:Impulse(Vector3.new(0, -2.2, 0))
	end)
	Controllers.Movement.Landed:Connect(function(fallSpeed)
		local strength = math.clamp((fallSpeed - 25) / 60, 0.08, 1.6)
		moveSpring:Impulse(Vector3.new(0, -3.5 * strength, 0))
		recoilSpring:Impulse(Vector3.new(-10 * strength, 0, 0))
	end)
	Controllers.Movement.Slid:Connect(function()
		moveSpring:Impulse(Vector3.new(0, -1.5, 2.5))
	end)

	local function onActionInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if Keybinds.Matches("Inspect", input) and visible and not inspecting then
			inspecting = true
			inspectStart = os.clock()
			Sfx.Play("CardHover", { Pitch = 0.8, Volume = 1.5 })
		end
	end
	UserInputService.InputBegan:Connect(onActionInput)
	Keybinds.VirtualBegan:Connect(onActionInput)

	-- your avatar's arms (rebuilt for every new character / appearance)
	local function refreshArms()
		task.defer(buildAvatarArms, player.Character)
	end
	player.CharacterAppearanceLoaded:Connect(refreshArms)
	player.CharacterAdded:Connect(function()
		task.delay(1, refreshArms) -- in case the appearance event already fired
	end)
	if player.Character then
		refreshArms()
	end

	-- kills play a flourish
	Remotes.Get("HitConfirm").OnClientEvent:Connect(function(info)
		if typeof(info) == "table" and info.Killed and visible then
			Viewmodel.PlayKill()
		end
	end)

	-- the imported rifle can arrive a moment after we start
	local function onRifleChanged(child)
		if child.Name == (Config.Viewmodel.MeshTemplate or "SniperRifle") then
			task.defer(buildGun)
			task.delay(1, buildGun) -- its meshes may replicate a moment later
		end
	end
	ReplicatedStorage.ChildAdded:Connect(onRifleChanged)
	ReplicatedStorage.ChildRemoved:Connect(onRifleChanged)

	-- new power-up = new attachment on the rifle; show it off with an inspect
	ClientState.Changed:Connect(function()
		if buildGun() and visible and not inspecting then
			inspecting = true
			inspectStart = os.clock()
			Sfx.Play("CardPick", { Pitch = 1.3, Volume = 0.6 })
		end
	end)

	-- after the camera controller (Camera + 1) so we use the final camera CFrame
	RunService:BindToRenderStep("SniperViewmodel", Enum.RenderPriority.Camera.Value + 2, update)
end

return Viewmodel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">WeaponController</string>
            <string name="Source"><![CDATA[--[[
	WeaponController.lua  (Client.WeaponController)

	The sniper:
		Right mouse  scope (hold, or toggle in settings)
		Left mouse   fire

	When you fire, the client:
	  1. traces the bullet(s) locally with Ballistics (same code as the server)
	     so tracers appear instantly,
	  2. sends the shot + what it saw itself hit ("claims") to the server,
	  3. plays recoil, the bolt animation and sound.
	The SERVER decides the real damage (see CombatService).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Ballistics = require(Shared.Ballistics)
local Util = require(Shared.Util)
local ClientState = require(script.Parent.ClientState)
local Sfx = require(script.Parent.Sfx)
local Keybinds = require(script.Parent.Keybinds)

local W = Config.Weapon
local player = Players.LocalPlayer

local Weapon = {}
local Controllers

local scopeHeld = false
local scopeAlpha = 0
local boltReadyAt = 0

----------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------
function Weapon.GetScopeAlpha()
	return scopeAlpha
end

function Weapon.IsScoped()
	return scopeAlpha > 0.9
end

-- 0 = ready, 1 = just fired
function Weapon.GetBoltProgress()
	local stats = ClientState.Stats
	local remaining = boltReadyAt - os.clock()
	return math.clamp(remaining / stats.BoltTime, 0, 1)
end

----------------------------------------------------------------------------
-- Firing
----------------------------------------------------------------------------
local function canShoot()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return ClientState.CanShoot()
		and not ClientState.MenuOpen
		and humanoid
		and humanoid.Health > 0
		and not character:GetAttribute("Frozen")
end

-- Random direction inside a cone of `degrees` around `dir`.
local function applySpread(dir, degrees)
	if degrees <= 0 then
		return dir
	end
	local angle = math.rad(degrees) * math.sqrt(math.random())
	local spin = math.random() * math.pi * 2
	local cf = CFrame.lookAt(Vector3.zero, dir)
	return (cf * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function buildExclude()
	local list = { workspace.CurrentCamera }
	if player.Character then
		table.insert(list, player.Character)
	end
	local effects = workspace:FindFirstChild("Effects")
	if effects then
		table.insert(list, effects)
	end
	local decoys = workspace:FindFirstChild("Decoys")
	if decoys then
		for _, decoy in ipairs(decoys:GetChildren()) do
			if decoy:GetAttribute("OwnerUserId") == player.UserId then
				table.insert(list, decoy)
			end
		end
	end
	return list
end

local function fire()
	if not canShoot() or os.clock() < boltReadyAt then
		return
	end
	local camera = workspace.CurrentCamera
	local stats = ClientState.Stats
	local scoped = Weapon.IsScoped()

	local origin = camera.CFrame.Position
	local direction = applySpread(camera.CFrame.LookVector, scoped and W.ScopedSpreadDegrees or W.HipSpreadDegrees)

	local opponent = ClientState.GetOpponentPlayer()
	local opponentCharacter = opponent and opponent.Character
	local homingTargets = ClientState.GetHomingTargets()
	local exclude = buildExclude()

	local muzzle = Controllers.Viewmodel.GetMuzzlePosition()
	if scoped then
		-- tracer starts slightly below the screen centre when scoped
		muzzle = origin + camera.CFrame.LookVector * 1.5 - camera.CFrame.UpVector * 0.4
	end

	-- dense list (sparse arrays don't survive RemoteEvents): { {Index, Part, Point} }
	local claims = {}
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	for i, dir in ipairs(Ballistics.GetShotDirections(direction, stats.Bullets)) do
		local sim = Ballistics.Simulate({
			Origin = origin,
			Direction = dir,
			Stats = stats,
			Exclude = exclude,
			HomingTargets = homingTargets,
		})
		-- the enemy in a match, or a practice dummy in the lobby
		local hitModel = sim.Hit and sim.Hit.Model
		local hitEnemy = hitModel ~= nil
			and ((opponentCharacter ~= nil and hitModel == opponentCharacter) or hitModel:GetAttribute("Dummy") == true)
		if hitEnemy then
			table.insert(claims, { Index = i, Model = hitModel, Part = sim.Hit.Part.Name, Point = sim.Hit.Position })
		end
		Controllers.Effects.DrawShot(sim.Segments, sim.Passes, sim.EndPosition, sim.EndNormal, muzzle, {
			Explosive = stats.Explosive,
			HitPlayer = hitEnemy,
		})

		-- ROCKET JUMP: shooting near your own feet launches you
		if stats.RocketJump and i == 1 and root and sim.EndPosition then
			local offset = root.Position - sim.EndPosition
			local cfg = Config.PowerUps.RocketJump
			if offset.Magnitude <= cfg.Radius then
				local away = Util.safeUnit(Util.flat(offset))
				local power = stats.RocketJumpPower
				Controllers.Movement.ApplyImpulse((away * cfg.LaunchAway + Vector3.new(0, cfg.LaunchUp, 0)) * power)
				Controllers.Camera.Shake(3)
			end
		end
	end

	Remotes.Get("Fire"):FireServer(origin, direction, claims)
	Controllers.Effects.MuzzleFlash(Controllers.Viewmodel.GetMuzzlePosition(), camera.CFrame.LookVector)

	-- Bolt delay (Quickdraw is already in stats.BoltTime; Bullet Time speeds it up)
	local boltTime = stats.BoltTime
	if Controllers.Movement.IsBulletTime() then
		boltTime /= Config.PowerUps.BulletTime.BoltSpeedScale
	end
	boltReadyAt = os.clock() + boltTime

	Sfx.Play("Fire", { Pitch = 0.95 + math.random() * 0.1 })
	Controllers.Viewmodel.PlayFire(scoped)
	Controllers.Viewmodel.PlayBolt(boltTime)
	Controllers.Camera.AddRecoil(scoped and Config.Camera.ScopedRecoilPitch or Config.Camera.RecoilPitch)
	Controllers.Camera.Shake(scoped and 0.6 or 1.2)
end

----------------------------------------------------------------------------
-- Input
----------------------------------------------------------------------------
-- Roblox's own control scripts bind Space (and some mouse buttons) with
-- ContextActionService, which marks those inputs as "processed". So we only
-- ignore input while the player is typing in a text box (e.g. chat).
local function isTyping(processed)
	return processed and UserInputService:GetFocusedTextBox() ~= nil
end

local function onInputBegan(input, processed)
	if isTyping(processed) then
		return
	end
	if Keybinds.Matches("Fire", input) then
		fire()
	elseif Keybinds.Matches("Scope", input) then
		if ClientState.Settings.ToggleScope then
			scopeHeld = not scopeHeld
		else
			scopeHeld = true
		end
	end
end

local function onInputEnded(input)
	if Keybinds.Matches("Scope", input) then
		if not ClientState.Settings.ToggleScope then
			scopeHeld = false
		end
	end
end

local function update(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local allowed = ClientState.HasGun() and not ClientState.MenuOpen and humanoid and humanoid.Health > 0
	if not allowed then
		scopeHeld = false
	end
	local target = scopeHeld and 1 or 0
	local scopeTime = ClientState.Stats.ScopeInTime
	scopeAlpha = Util.approach(scopeAlpha, target, dt / math.max(scopeTime, 0.01))
end

function Weapon.Init(controllers)
	Controllers = controllers
end

function Weapon.Start()
	-- HAIR TRIGGER power-up: the server tells us a hit re-chambered the rifle
	Remotes.Get("Buff").OnClientEvent:Connect(function(buff)
		if typeof(buff) == "table" and buff.Type == "Rechamber" then
			boltReadyAt = math.min(boltReadyAt, os.clock() + 0.1)
			Controllers.Viewmodel.PlayBolt(0.18)
		end
	end)

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	Keybinds.VirtualBegan:Connect(onInputBegan) -- on-screen buttons (mobile)
	Keybinds.VirtualEnded:Connect(onInputEnded)
	RunService:BindToRenderStep("SniperWeapon", Enum.RenderPriority.Input.Value + 1, update)
end

return Weapon
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="47">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">DuelUI</string>
              <string name="Source"><![CDATA[--[[
	DuelUI.lua  (Client.ui.DuelUI)

	Playing a specific person instead of the random queue:

	  DUEL A PLAYER (U / controller R-stick click / DUEL button on mobile)
	      a list of everyone in the server; CHALLENGE sends them an invite.
	  INVITES
	      when someone challenges you (or asks for a rematch) a card pops up
	      at the top: ACCEPT or DECLINE (it expires after Config.Match.InviteTime).
	  REMATCH
	      the lobby shows a REMATCH button after a match (LobbyUI); the other
	      player gets an invite card here. Against a bot, rematch starts right away.

	The server checks everything (Remotes "Duel" / "DuelInvite", MatchService).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Keybinds = require(script.Parent.Parent.Keybinds)
local ClientState = require(script.Parent.Parent.ClientState)

local Palette = Config.Palette
local player = Players.LocalPlayer

local DuelUI = {}

local gui, panel, list, unlocker, inviteHolder
local isOpen = false
local openInvites = 0

local function updateMouse()
	local need = isOpen or openInvites > 0
	unlocker.Visible = need
	ClientState.SetMenu("Duel", need)
end

local function refreshList()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local count = 0
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			count += 1
			local row = Theme.panel({
				Size = UDim2.new(1, 0, 0, 44),
				BackgroundColor3 = Palette.UIPanelLight,
				LayoutOrder = count,
				Parent = list,
			})
			Theme.label({
				Position = UDim2.fromOffset(14, 0),
				Size = UDim2.new(1, -170, 1, 0),
				Text = other.DisplayName,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
				FontFace = Theme.Font(Enum.FontWeight.Bold),
				Parent = row,
			})
			local busy = other:GetAttribute("InMatch") == true
			local button = Theme.button({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(140, 32),
				Text = busy and "IN A MATCH" or "CHALLENGE",
				TextSize = 15,
				BackgroundColor3 = busy and Palette.UIPanel or Palette.UIAccent,
				TextColor3 = busy and Palette.UISubText or Palette.UIBackground,
				AutoButtonColor = not busy,
				Parent = row,
			})
			if not busy then
				button.Activated:Connect(function()
					Remotes.Get("Duel"):FireServer("Challenge", other.UserId)
					Sfx.Play("CardPick", { Volume = 0.6 })
					button.Text = "SENT"
					button.BackgroundColor3 = Palette.UIPanel
					button.TextColor3 = Palette.UISubText
				end)
			end
		end
	end
	if count == 0 then
		local row = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = list })
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = "Nobody else is here yet. Invite a friend to the server!",
			TextSize = 15,
			TextColor3 = Palette.UISubText,
			Parent = row,
		})
	end
end

function DuelUI.Open()
	if isOpen or ClientState.InMatch() then
		return
	end
	isOpen = true
	panel.Visible = true
	refreshList()
	updateMouse()
	Theme.pop(panel, 0.05)
end

function DuelUI.Close()
	if not isOpen then
		return
	end
	isOpen = false
	panel.Visible = false
	updateMouse()
end

-- An invite card: "<name> challenges you" with ACCEPT / DECLINE.
local function showInvite(data)
	if typeof(data) ~= "table" then
		return
	end
	local isRematch = data.Kind == "Rematch"
	local card = Theme.panel({
		Size = UDim2.fromOffset(440, 96),
		BackgroundColor3 = Palette.UIPanel,
		Parent = inviteHolder,
	})
	Theme.stroke(card, Palette.UIAccent, 2, 0.1)
	Theme.label({
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 26),
		Text = isRematch and (tostring(data.Name) .. " wants a rematch!") or (tostring(data.Name) .. " challenges you to a duel!"),
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = card,
	})
	local timer = Theme.new("Frame", {
		Position = UDim2.new(0, 16, 0, 40),
		Size = UDim2.new(1, -32, 0, 4),
		BackgroundColor3 = Palette.UIAccent,
		Parent = card,
	})
	local accept = Theme.button({
		Position = UDim2.new(0, 16, 1, -44),
		Size = UDim2.new(0.5, -22, 0, 34),
		Text = "ACCEPT",
		TextSize = 16,
		Parent = card,
	})
	local decline = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 1, -44),
		Size = UDim2.new(0.5, -22, 0, 34),
		Text = "DECLINE",
		TextSize = 16,
		BackgroundColor3 = Palette.UIPanelLight,
		TextColor3 = Palette.UIText,
		Parent = card,
	})
	openInvites += 1
	updateMouse()
	Sfx.Play("CardPick", { Volume = 0.8, Pitch = 1.4 })
	Theme.pop(card, 0.1)

	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		openInvites -= 1
		updateMouse()
		card:Destroy()
	end
	accept.Activated:Connect(function()
		if isRematch then
			Remotes.Get("Duel"):FireServer("Rematch")
		else
			Remotes.Get("Duel"):FireServer("Accept", data.From)
		end
		close()
	end)
	decline.Activated:Connect(function()
		if not isRematch then
			Remotes.Get("Duel"):FireServer("Decline", data.From)
		end
		close()
	end)
	local life = tonumber(data.Time) or Config.Match.InviteTime
	Theme.tween(timer, life, { Size = UDim2.new(0, 0, 0, 4) }, Enum.EasingStyle.Linear)
	task.delay(life, close)
	-- a match starting (you accepted, or they did) clears it too
	local connection
	connection = ClientState.Changed:Connect(function(snapshot)
		if snapshot.InMatch then
			close()
		end
		if closed then
			connection.Disconnect()
		end
	end)
end

function DuelUI.Start(playerGui)
	gui = Theme.screen("Duel", 7, playerGui)
	unlocker = Theme.mouseUnlocker(gui)

	panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 420),
		BackgroundColor3 = Palette.UIBackground,
		Visible = false,
		Parent = gui,
	})
	Theme.padding(panel, 18)
	Theme.label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = "DUEL A PLAYER",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})
	list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 1, -96),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	local close = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(160, 40),
		Text = "CLOSE",
		TextSize = 17,
		Parent = panel,
	})
	close.Activated:Connect(DuelUI.Close)

	inviteHolder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 170),
		Size = UDim2.fromOffset(440, 320),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.new("UIListLayout", {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		Parent = inviteHolder,
	})

	Remotes.Get("DuelInvite").OnClientEvent:Connect(showInvite)

	local function onActionInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if Keybinds.Matches("DuelFriend", input) then
			if isOpen then
				DuelUI.Close()
			else
				DuelUI.Open()
			end
		elseif input.KeyCode == Enum.KeyCode.Escape and isOpen then
			DuelUI.Close()
		end
	end
	UserInputService.InputBegan:Connect(onActionInput)
	Keybinds.VirtualBegan:Connect(onActionInput)

	Players.PlayerAdded:Connect(function()
		if isOpen then
			refreshList()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if isOpen then
			task.defer(refreshList)
		end
	end)
	ClientState.Changed:Connect(function(snapshot)
		if snapshot.InMatch then
			DuelUI.Close()
		end
	end)
end

return DuelUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	HUD.lua  (Client.ui.HUD)

	In-match heads-up display:
		crosshair (hidden while scoped) + bolt reload bar
		hitmarkers (red for headshots, bigger on kills) + kill sound
		scope overlay (black outside a circle, thin reticle)
		scoreboard (names, round wins, round timer) with each player's
		    collected power-up icons underneath
		health bar, ability hints with cooldowns
		big centre banner (countdown, GO, round won/lost)
		damage vignette + direction indicator
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local Keybinds = require(script.Parent.Parent.Keybinds)

local Palette = Config.Palette
local player = Players.LocalPlayer

local HUD = {}
local Controllers

local gui
local crosshair, boltBar, boltFill
local hitmarker
local scope
local scoreboard, nameLabels, winLabels, timerLabel, roundLabel, iconRows
local healthBar, healthFill, healthText
local abilityList
local banner, bannerTitle, bannerSub
local vignette, indicator
local lastCountdownNumber
local bannerToken = 0
local bannerLine
local speedLines = {}
local speedLinesFrame
local lastWins = {}
local speedLabel

----------------------------------------------------------------------------
-- Building
----------------------------------------------------------------------------
local function buildCrosshair()
	crosshair = Theme.new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local function line(pos, size)
		local f = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = pos,
			Size = size,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = crosshair,
		})
		Theme.stroke(f, Palette.UIBackground, 1, 0.5)
		return f
	end
	line(UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(3, 3)) -- centre dot
	line(UDim2.new(0.5, 0, 0.5, -9), UDim2.fromOffset(2, 6))
	line(UDim2.new(0.5, 0, 0.5, 9), UDim2.fromOffset(2, 6))
	line(UDim2.new(0.5, -9, 0.5, 0), UDim2.fromOffset(6, 2))
	line(UDim2.new(0.5, 9, 0.5, 0), UDim2.fromOffset(6, 2))

	boltBar = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 26),
		Size = UDim2.fromOffset(34, 3),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.5,
		Visible = false,
		Parent = gui,
	})
	Theme.corner(boltBar, 2)
	boltFill = Theme.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = boltBar,
	})
	Theme.corner(boltFill, 2)

	hitmarker = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	})
	for i = 0, 3 do
		local angle = math.rad(45 + i * 90)
		Theme.new("Frame", {
			Name = "Tick",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.cos(angle) * 11, 0.5, math.sin(angle) * 11),
			Size = UDim2.fromOffset(9, 2),
			Rotation = 45 + i * 90,
			BackgroundColor3 = Palette.UIHitmarker,
			ZIndex = 5,
			Parent = hitmarker,
		})
	end
end

local function buildScope()
	scope = Theme.new("Frame", {
		Name = "Scope",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	-- The lens: a circle whose huge outer stroke paints everything outside it black.
	local lens = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.92),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundTransparency = 1,
		Parent = scope,
	})
	Theme.corner(lens, UDim.new(0.5, 0))

	-- Black surround: four panels cover everything outside the lens's square,
	-- and a ring outline covers the square's corners outside the circle.
	local black = Color3.fromRGB(8, 9, 12)
	local panels = {}
	for i = 1, 4 do
		panels[i] = Theme.new("Frame", { BackgroundColor3 = black, Parent = scope })
	end
	local mask = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = scope,
	})
	Theme.corner(mask, UDim.new(0.5, 0))
	local maskStroke = Theme.stroke(mask, black, 1, 0)
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		local d = math.floor(viewport.Y * 0.92)
		local left = math.floor((viewport.X - d) / 2)
		local top = math.floor((viewport.Y - d) / 2)
		panels[1].Position, panels[1].Size = UDim2.fromOffset(0, 0), UDim2.new(0, left + 1, 1, 0) -- left
		panels[2].Position, panels[2].Size = UDim2.new(0, left + d - 1, 0, 0), UDim2.new(1, -(left + d - 1), 1, 0) -- right
		panels[3].Position, panels[3].Size = UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, top + 1) -- top
		panels[4].Position, panels[4].Size = UDim2.new(0, 0, 0, top + d - 1), UDim2.new(1, 0, 1, -(top + d - 1)) -- bottom
		-- the corners between a circle and its square are ~0.21 x diameter deep
		mask.Size = UDim2.fromOffset(d, d)
		maskStroke.Thickness = math.ceil(d * 0.22) + 2
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	-- inner ring
	local ring = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = lens,
	})
	Theme.corner(ring, UDim.new(0.5, 0))
	Theme.stroke(ring, Color3.fromRGB(30, 34, 44), 10, 0)
	-- reticle lines
	local dark = Color3.fromRGB(12, 12, 16)
	Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = dark, Parent = lens })
	Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 1, 0), BackgroundColor3 = dark, Parent = lens })
	-- thicker outer posts
	Theme.new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0.3, 0, 0, 6), BackgroundColor3 = dark, Parent = lens })
	Theme.new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.new(0.3, 0, 0, 6), BackgroundColor3 = dark, Parent = lens })
	Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.new(0, 6, 0.3, 0), BackgroundColor3 = dark, Parent = lens })
	-- centre dot
	local dot = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(5, 5),
		BackgroundColor3 = Palette.UIDanger,
		Parent = lens,
	})
	Theme.corner(dot, UDim.new(0.5, 0))
end

local function buildScoreboard()
	scoreboard = Theme.new("Frame", {
		Name = "Scoreboard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(520, 110),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(420, 54),
		Parent = scoreboard,
	})
	nameLabels, winLabels, iconRows = {}, {}, {}
	for slot = 1, 2 do
		local left = slot == 1
		nameLabels[slot] = Theme.label({
			AnchorPoint = Vector2.new(left and 0 or 1, 0.5),
			Position = UDim2.new(left and 0 or 1, left and 16 or -16, 0.5, 0),
			Size = UDim2.fromOffset(130, 24),
			TextXAlignment = left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
			TextSize = 17,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = panel,
		})
		local chip = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, left and -36 or 36, 0.5, 0),
			Size = UDim2.fromOffset(46, 40),
			BackgroundColor3 = ClientState.GetSlotColor(slot),
			Parent = panel,
		})
		Theme.corner(chip, 8)
		winLabels[slot] = Theme.label({
			Size = UDim2.fromScale(1, 1),
			TextSize = 26,
			FontFace = Theme.Font(Enum.FontWeight.Heavy),
			Text = "0",
			Parent = chip,
		})
		-- collected power-ups under each player (5 per row, up to 3 rows)
		iconRows[slot] = Theme.new("Frame", {
			AnchorPoint = Vector2.new(left and 0 or 1, 0),
			Position = UDim2.new(0.5, left and -210 or 210, 0, 60),
			Size = UDim2.fromOffset(140, 80),
			BackgroundTransparency = 1,
			Parent = scoreboard,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(24, 24),
				CellPadding = UDim2.fromOffset(4, 4),
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = left and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20),
		Text = "-",
		TextSize = 22,
		TextColor3 = Palette.UISubText,
		Parent = panel,
	})
	roundLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(120, 16),
		TextSize = 12,
		TextColor3 = Palette.UISubText,
		Parent = scoreboard,
	})
	timerLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.fromOffset(120, 20),
		TextSize = 18,
		Parent = scoreboard,
	})
end

local function buildHealth()
	local panel = Theme.panel({
		Name = "Health",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 22, 1, -22),
		Size = UDim2.fromOffset(260, 46),
		Visible = false,
		Parent = gui,
	})
	healthBar = panel
	Theme.padding(panel, 10)
	local track = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, -64, 0, 10),
		BackgroundColor3 = Palette.UIPanelLight,
		Parent = panel,
	})
	Theme.corner(track, 5)
	healthFill = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIText,
		Parent = track,
	})
	Theme.corner(healthFill, 5)
	healthText = Theme.label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(56, 26),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 24,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})
end

local function buildAbilities()
	abilityList = Theme.new("Frame", {
		Name = "Abilities",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -22, 1, -22),
		Size = UDim2.fromOffset(220, 140),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", {
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function buildBanner()
	banner = Theme.new("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(700, 140),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	bannerTitle = Theme.label({
		Size = UDim2.new(1, 0, 0, 90),
		TextSize = 78,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = banner,
	})
	Theme.new("UIStroke", { Thickness = 2, Transparency = 0.55, Color = Palette.UIBackground, Parent = bannerTitle })
	bannerLine = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 88),
		Size = UDim2.fromOffset(0, 4),
		BackgroundColor3 = Palette.UIAccent,
		Parent = banner,
	})
	Theme.corner(bannerLine, 2)
	bannerSub = Theme.label({
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(1, 0, 0, 30),
		TextSize = 22,
		TextColor3 = Palette.UISubText,
		Parent = banner,
	})
end

-- Speedometer (bottom centre): your horizontal speed, handy for bunny hopping.
local function buildSpeedometer()
	speedLabel = Theme.label({
		Name = "Speed",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(160, 24),
		TextSize = 20,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		TextTransparency = 0.15,
		Parent = gui,
	})
	Theme.new("UIStroke", { Thickness = 1.5, Transparency = 0.6, Color = Palette.UIBackground, Parent = speedLabel })
end

-- Speed lines: thin streaks at the screen edges when you're moving fast.
local function buildSpeedLines()
	speedLinesFrame = Theme.new("Frame", {
		Name = "SpeedLines",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	for i = 1, 18 do
		local line = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			Parent = speedLinesFrame,
		})
		Theme.new("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) }),
			Parent = line,
		})
		speedLines[i] = { Frame = line, Angle = (i / 18) * math.pi * 2 }
	end
end

local function updateSpeedLines(speed, scoped)
	if not speedLinesFrame then
		return
	end
	local from = Config.Effects.SpeedLinesFrom
	local alpha = Config.Effects.SpeedLines and not scoped and math.clamp((speed - from) / 45, 0, 1) or 0
	speedLinesFrame.Visible = alpha > 0
	if alpha <= 0 then
		return
	end
	local viewport = workspace.CurrentCamera.ViewportSize
	local center = viewport / 2
	local radius = math.min(viewport.X, viewport.Y) * 0.42
	for _, l in ipairs(speedLines) do
		local angle = l.Angle + (math.random() - 0.5) * 0.12
		local r = radius + math.random() * radius * 0.5
		local length = 60 + math.random() * 140 * alpha
		local dir = Vector2.new(math.cos(angle), math.sin(angle))
		local pos = center + dir * (r + length / 2)
		l.Frame.Position = UDim2.fromOffset(pos.X, pos.Y)
		l.Frame.Size = UDim2.fromOffset(length, 2)
		l.Frame.Rotation = math.deg(angle)
		l.Frame.BackgroundTransparency = 1 - alpha * (0.25 + math.random() * 0.35)
	end
end

local function buildDamage()
	vignette = Theme.new("Frame", {
		Name = "DamageVignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	-- four soft edges made with gradients
	local edges = {
		{ UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0), 90 },
		{ UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0.75), -90 },
		{ UDim2.fromScale(0.2, 1), UDim2.fromScale(0, 0), 0 },
		{ UDim2.fromScale(0.2, 1), UDim2.fromScale(0.8, 0), 180 },
	}
	for _, e in ipairs(edges) do
		local f = Theme.new("Frame", {
			Size = e[1],
			Position = e[2],
			BackgroundColor3 = Palette.UIDanger,
			Parent = vignette,
		})
		Theme.new("UIGradient", {
			Rotation = e[3],
			Transparency = NumberSequence.new(0, 1),
			Parent = f,
		})
	end
	vignette.Visible = false

	indicator = Theme.new("Frame", {
		Name = "DamageIndicator",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(240, 240),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local arrow = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(60, 6),
		BackgroundColor3 = Palette.UIDanger,
		Parent = indicator,
	})
	Theme.corner(arrow, 3)
end

----------------------------------------------------------------------------
-- Banner
----------------------------------------------------------------------------
local function showBanner(title, sub, color, duration)
	bannerToken += 1
	local token = bannerToken
	banner.Visible = true
	bannerTitle.Text = title
	bannerTitle.TextColor3 = color or Palette.UIText
	bannerSub.Text = sub or ""
	-- punch in: big + transparent -> normal, underline wipes open, subtitle fades in
	bannerTitle.TextTransparency = 1
	bannerTitle.Size = UDim2.new(1, 0, 0, 90)
	bannerTitle.TextSize = 110
	Theme.tween(bannerTitle, 0.3, { TextSize = 78, TextTransparency = 0 }, Enum.EasingStyle.Back)
	bannerLine.BackgroundColor3 = color or Palette.UIAccent
	bannerLine.BackgroundTransparency = 0
	bannerLine.Size = UDim2.fromOffset(0, 4)
	Theme.tween(bannerLine, 0.4, { Size = UDim2.fromOffset(title == "" and 0 or 260, 4) }, Enum.EasingStyle.Quint)
	bannerSub.TextTransparency = 1
	Theme.tween(bannerSub, 0.5, { TextTransparency = 0 })
	if duration then
		task.delay(duration, function()
			if bannerToken == token then
				Theme.tween(bannerTitle, 0.25, { TextTransparency = 1 })
				Theme.tween(bannerSub, 0.25, { TextTransparency = 1 })
				Theme.tween(bannerLine, 0.25, { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 4) })
				task.wait(0.25)
				if bannerToken == token then
					banner.Visible = false
				end
			end
		end)
	end
end

local function hideBanner()
	bannerToken += 1
	banner.Visible = false
end

-- Short coloured flash + text (Second Wind etc.)
function HUD.Flash(color, text)
	local flash = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.6,
		Parent = gui,
	})
	Theme.tween(flash, 0.6, { BackgroundTransparency = 1 })
	task.delay(0.65, function()
		flash:Destroy()
	end)
	if text then
		showBanner(text, nil, color, 1.2)
	end
end

----------------------------------------------------------------------------
-- Hits and damage
----------------------------------------------------------------------------
function HUD.Hitmarker(headshot, killed)
	local color = headshot and Palette.UIHeadshot or Palette.UIHitmarker
	for _, tick in ipairs(hitmarker:GetChildren()) do
		tick.BackgroundColor3 = color
		tick.BackgroundTransparency = 0
		tick.Size = UDim2.fromOffset(killed and 14 or 9, killed and 3 or 2)
		Theme.tween(tick, 0.35, { BackgroundTransparency = 1 })
	end
	hitmarker.Visible = true
	hitmarker.Size = UDim2.fromOffset(killed and 44 or 30, killed and 44 or 30)
	Theme.tween(hitmarker, 0.2, { Size = UDim2.fromOffset(30, 30) })
end

local function onDamaged(data)
	Sfx.Play("Hurt")
	vignette.Visible = true
	for _, edge in ipairs(vignette:GetChildren()) do
		edge.BackgroundTransparency = 0.3
		Theme.tween(edge, 0.7, { BackgroundTransparency = 1 })
	end
	Controllers.Camera.Shake(1.5)
	-- point toward the attacker
	if data.From then
		local camera = workspace.CurrentCamera
		local toAttacker = data.From - camera.CFrame.Position
		local localDir = camera.CFrame:VectorToObjectSpace(toAttacker)
		local angle = math.deg(math.atan2(localDir.X, -localDir.Z))
		indicator.Rotation = angle
		indicator.Visible = true
		local arrow = indicator:FindFirstChildOfClass("Frame")
		arrow.BackgroundTransparency = 0
		Theme.tween(arrow, 1.2, { BackgroundTransparency = 1 })
	end
end

-- Floating damage number at the hit position (rises, pops and fades).
local function damageNumber(position, amount, headshot, splash, killed)
	if not Config.Effects.DamageNumbers or not position or not amount then
		return
	end
	local anchor = Instance.new("Attachment")
	anchor.WorldPosition = position
	anchor.Parent = workspace.Terrain
	local billboard = Theme.new("BillboardGui", {
		Adornee = anchor,
		Size = UDim2.fromOffset(160, 50),
		AlwaysOnTop = true,
		LightInfluence = 0,
		StudsOffsetWorldSpace = Vector3.new((math.random() - 0.5) * 1.5, 1, 0),
		Parent = gui.Parent, -- BillboardGuis live directly in PlayerGui
	})
	local color = headshot and Palette.UIHeadshot or splash and Palette.TracerExplosive or killed and Palette.UIAccent or Palette.UIText
	local label = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = headshot and "HEADSHOT" or tostring(math.floor(amount + 0.5)),
		TextSize = headshot and 30 or math.clamp(18 + amount * 0.12, 18, 34),
		TextColor3 = color,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = billboard,
	})
	Theme.new("UIStroke", { Thickness = 2, Color = Palette.UIBackground, Transparency = 0.2, Parent = label })
	Theme.pop(label, 0.5)
	Theme.tween(billboard, 0.8, { StudsOffsetWorldSpace = billboard.StudsOffsetWorldSpace + Vector3.new(0, 3, 0) }, Enum.EasingStyle.Quint)
	task.delay(0.45, function()
		Theme.tween(label, 0.35, { TextTransparency = 1 })
	end)
	task.delay(0.85, function()
		billboard:Destroy()
		anchor:Destroy()
	end)
end

local function onHitConfirm(data)
	HUD.Hitmarker(data.Headshot, data.Killed)
	damageNumber(data.Position, data.Damage, data.Headshot, data.Splash, data.Killed)
	if data.Killed then
		local viewport = workspace.CurrentCamera.ViewportSize
		Theme.burst(gui, viewport / 2, data.Headshot and Palette.UIHeadshot or Palette.UIAccent, 18, 120, 7)
		Theme.ring(gui, viewport / 2, data.Headshot and Palette.UIHeadshot or Color3.new(1, 1, 1), 160, 5)
		Sfx.Play("Kill")
		showBanner(data.Headshot and "HEADSHOT" or "ELIMINATED", nil, data.Headshot and Palette.UIHeadshot or Palette.UIText, 1.2)
	elseif data.Headshot then
		Sfx.Play("Headshot")
	else
		Sfx.Play("Hit", { Pitch = data.Splash and 0.8 or 1 })
	end
end

----------------------------------------------------------------------------
-- State updates
----------------------------------------------------------------------------
local function rebuildIcons(snapshot)
	for slot = 1, 2 do
		local row = iconRows[slot]
		for _, child in ipairs(row:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local entry = snapshot.Players and snapshot.Players[slot]
		if entry then
			local order = 0
			for _, def in ipairs(PowerUps.Definitions) do
				local stacks = entry.PowerUps[def.Id]
				if stacks and stacks > 0 then
					order += 1
					local icon = Icons.Create(def, 24)
					icon.LayoutOrder = order
					Theme.stroke(icon, Config.Rarity[def.Rarity].Color, 1.5, 0)
					if stacks > 1 then
						Theme.label({
							AnchorPoint = Vector2.new(1, 1),
							Position = UDim2.new(1, 3, 1, 3),
							Size = UDim2.fromOffset(14, 12),
							Text = "x" .. stacks,
							TextSize = 10,
							FontFace = Theme.Font(Enum.FontWeight.Heavy),
							Parent = icon,
						})
					end
					icon.Parent = row
				end
			end
		end
	end
end

local function rebuildAbilities()
	for _, child in ipairs(abilityList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local stats = ClientState.Stats
	local entries = {}
	local device = game:GetService("UserInputService"):GetLastInputType().Name:find("Gamepad") and "Gamepad" or "Keyboard"
	local function key(actionId)
		return Keybinds.Label(Keybinds.Get(actionId, device))
	end
	if stats.Grapple then
		table.insert(entries, { Key = key("Grapple"), Name = "Grapple", Cooldown = "Grapple" })
	end
	if stats.Blink then
		table.insert(entries, { Key = key("Blink"), Name = "Blink", Cooldown = "Blink" })
	end
	if stats.Decoy then
		table.insert(entries, { Key = key("Decoy"), Name = "Decoy", Cooldown = "Decoy" })
	end
	if stats.BulletTime then
		table.insert(entries, { Key = key("Scope"), Name = "Bullet Time (air)", Cooldown = "BulletTime" })
	end
	for i, e in ipairs(entries) do
		local row = Theme.panel({
			Name = e.Name,
			Size = UDim2.fromOffset(210, 30),
			LayoutOrder = i,
			Parent = abilityList,
		})
		local key = Theme.new("Frame", {
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.fromOffset(52, 22),
			BackgroundColor3 = Palette.UIPanelLight,
			Parent = row,
		})
		Theme.corner(key, 6)
		Theme.label({ Size = UDim2.fromScale(1, 1), Text = e.Key, TextSize = 13, Parent = key })
		Theme.label({
			Position = UDim2.fromOffset(64, 0),
			Size = UDim2.new(1, -70, 1, 0),
			Text = e.Name,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		if e.Cooldown then
			local fill = Theme.new("Frame", {
				Name = "CooldownFill",
				Size = UDim2.fromScale(0, 1),
				BackgroundColor3 = Palette.UIBackground,
				BackgroundTransparency = 0.4,
				ZIndex = 2,
				Parent = row,
			})
			Theme.corner(fill)
			fill:SetAttribute("Cooldown", e.Cooldown)
		end
	end
end

function HUD.OnState(snapshot, old)
	local inMatch = snapshot.InMatch
	scoreboard.Visible = inMatch
	healthBar.Visible = inMatch
	abilityList.Visible = true -- also shows Power-Up Lab abilities in the lobby
	rebuildAbilities()
	if not inMatch then
		if old.InMatch then
			hideBanner()
		end
		return
	end

	for slot = 1, 2 do
		local entry = snapshot.Players[slot]
		nameLabels[slot].Text = entry and entry.Name or "-"
		nameLabels[slot].TextColor3 = (entry and entry.UserId == player.UserId) and Palette.UIAccent or Palette.UIText
		winLabels[slot].Text = entry and tostring(entry.Wins) or "0"
		-- pop + burst when a score goes up
		if entry and lastWins[slot] and entry.Wins > lastWins[slot] then
			local chip = winLabels[slot].Parent
			Theme.pop(chip, 0.4)
			local center = chip.AbsolutePosition + chip.AbsoluteSize / 2
			Theme.burst(gui, center, ClientState.GetSlotColor(slot), 12, 70, 6)
		end
		lastWins[slot] = entry and entry.Wins or 0
	end
	roundLabel.Text = ("ROUND %d  -  FIRST TO %d"):format(snapshot.Round or 1, snapshot.RoundsToWin or 5)
	rebuildIcons(snapshot)

	local phase = snapshot.Phase
	if phase ~= old.Phase or snapshot.Round ~= old.Round then
		if phase == "Countdown" then
			lastCountdownNumber = nil
			showBanner("", "ROUND " .. tostring(snapshot.Round), Palette.UIText)
		elseif phase == "Fight" then
			Sfx.Play("Go")
			showBanner("GO", nil, Palette.UIAccent, 0.7)
		elseif phase == "RoundEnd" then
			local won = snapshot.RoundWinnerUserId == player.UserId
			local me, opp = ClientState.GetMe(), ClientState.GetOpponentEntry()
			local score = me and opp and ("%d  -  %d"):format(me.Wins, opp.Wins) or ""
			local sub = snapshot.Message and (snapshot.Message .. "   " .. score) or score
			if snapshot.RoundWinnerUserId == nil then
				showBanner("DRAW", snapshot.Message, Palette.UISubText, 2.2)
			else
				showBanner(won and "ROUND WON" or "ROUND LOST", sub, won and Palette.UIAccent or Palette.UIDanger, 2.3)
			end
		elseif phase == "Pick" or phase == "PickReveal" or phase == "Victory" then
			hideBanner()
		end
	end
end

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

local function update()
	local inArena = ClientState.HasGun() -- lobby practice range or a live round
	local scopeAlpha = Controllers.Weapon.GetScopeAlpha()
	local firstPerson = Controllers.Camera.IsFirstPerson()

	crosshair.Visible = inArena and firstPerson and scopeAlpha < 0.3 and not ClientState.MenuOpen
	scope.Visible = inArena and scopeAlpha > 0.85
	local bolt = Controllers.Weapon.GetBoltProgress()
	boltBar.Visible = inArena and bolt > 0
	boltFill.Size = UDim2.fromScale(1 - bolt, 1)

	-- speedometer: white at normal speed, teal when bunny hopping fast
	local speed = Controllers.Movement.GetSpeed()
	speedLabel.Visible = inArena and scopeAlpha < 0.85 and not ClientState.MenuOpen
	speedLabel.Text = tostring(math.floor(speed + 0.5)) .. " u/s"
	speedLabel.TextColor3 = speed > Config.Movement.SprintSpeed + 6 and Palette.UIAccent or Palette.UIText
	updateSpeedLines(inArena and speed or 0, scopeAlpha > 0.3)

	-- health
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local fraction = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
		healthFill.Size = UDim2.fromScale(fraction, 1)
		healthFill.BackgroundColor3 = fraction < 0.35 and Palette.UIDanger or Palette.UIText
		healthText.Text = tostring(math.ceil(humanoid.Health))
	end

	-- timers
	local snapshot = ClientState.Snapshot
	local timeLeft = ClientState.TimeLeft()
	if snapshot.InMatch then
		if snapshot.Phase == "Fight" and timeLeft then
			timerLabel.Text = formatTime(timeLeft)
			timerLabel.TextColor3 = timeLeft < 15 and Palette.UIDanger or Palette.UIText
		else
			timerLabel.Text = ""
		end
		if snapshot.Phase == "Countdown" and timeLeft then
			local n = math.ceil(timeLeft)
			if n ~= lastCountdownNumber and n > 0 then
				lastCountdownNumber = n
				bannerTitle.Text = tostring(n)
				bannerTitle.TextSize = 110
				Theme.tween(bannerTitle, 0.3, { TextSize = 78 }, Enum.EasingStyle.Back)
				Sfx.Play("Countdown")
			end
		end
	end

	-- ability cooldowns
	local cooldowns = Controllers.Movement.GetCooldowns()
	for _, row in ipairs(abilityList:GetChildren()) do
		local fill = row:IsA("Frame") and row:FindFirstChild("CooldownFill")
		if fill then
			local name = fill:GetAttribute("Cooldown")
			local stats = ClientState.Stats
			local total = name == "Grapple" and stats.GrappleCooldown
				or name == "Blink" and math.max(stats.BlinkCooldown, 0.1)
				or name == "Decoy" and Config.PowerUps.Decoy.Cooldown
				or Config.PowerUps.BulletTime.Cooldown
			fill.Size = UDim2.fromScale(math.clamp((cooldowns[name] or 0) / total, 0, 1), 1)
		end
	end
end

function HUD.Init(controllers)
	Controllers = controllers
end

function HUD.Start(playerGui)
	gui = Theme.screen("HUD", 1, playerGui)
	buildScope()
	buildCrosshair()
	buildScoreboard()
	buildHealth()
	buildAbilities()
	buildBanner()
	buildDamage()
	buildSpeedometer()
	buildSpeedLines()

	Remotes.Get("HitConfirm").OnClientEvent:Connect(onHitConfirm)
	Remotes.Get("Damaged").OnClientEvent:Connect(onDamaged)
	RunService.RenderStepped:Connect(update)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Icons</string>
              <string name="Source"><![CDATA[--[[
	Icons.lua  (Client.ui.Icons)
	Draws a power-up's flat icon from the simple shape list in PowerUps.lua.
	No images needed: every icon is a few rounded frames on a coloured tile.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(script.Parent.Theme)

local Icons = {}

--[[
	def   power-up definition (PowerUps.Get(id))
	size  pixel size of the square icon
	Returns a Frame (not parented).
]]
function Icons.Create(def, size)
	local tile = Theme.new("Frame", {
		Name = "Icon_" .. def.Id,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = def.IconColor,
	})
	Theme.corner(tile, math.floor(size * 0.22))

	local scale = size / 64
	for _, shape in ipairs(def.Icon or {}) do
		local kind, x, y = shape[1], shape[2], shape[3]
		local color = shape.Dark and def.IconColor:Lerp(Config.Palette.UIBackground, 0.75) or Color3.new(1, 1, 1)
		local frame = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, y),
			BackgroundColor3 = color,
			BackgroundTransparency = shape.A or 0,
			Parent = tile,
		})
		if kind == "Circle" then
			frame.Size = UDim2.fromScale(shape[4], shape[4])
			Theme.corner(frame, UDim.new(0.5, 0))
		elseif kind == "Ring" then
			frame.Size = UDim2.fromScale(shape[4], shape[4])
			frame.BackgroundTransparency = 1
			Theme.corner(frame, UDim.new(0.5, 0))
			Theme.stroke(frame, color, math.max(1, (shape[5] or 3) * scale), shape.A or 0)
		else -- "Rect"
			frame.Size = UDim2.fromScale(shape[4], shape[5])
			frame.Rotation = shape[6] or 0
			Theme.corner(frame, UDim.new(shape.Round or 0.15, 0))
		end
	end
	return tile
end

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">LobbyUI</string>
              <string name="Source"><![CDATA[--[[
	LobbyUI.lua  (Client.ui.LobbyUI)

	The lobby / playground screen (hidden while you're in a match). Kept
	minimal on purpose:
		Find match (animated "searching" state while queued)
		Playground (free roam on the match map)
		Play vs bot (admins)
	The mouse is locked in first person, so each button has a key / controller
	button (rebindable in Settings > Keyboard / Controller).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Keybinds = require(script.Parent.Parent.Keybinds)
local ClientState = require(script.Parent.Parent.ClientState)

local Palette = Config.Palette

local LobbyUI = {}
local Controllers

local gui, root, title, subtitle, playButton, playgroundButton, statusLabel, modeChip, spinner, rematchButton
local shown = false
local queued = false
local lastSnapshot = { InMatch = false, Phase = "Lobby" }

local function styleButton(button, active)
	button.BackgroundColor3 = active and Palette.UIAccent or Palette.UIPanelLight
	button.TextColor3 = active and Palette.UIBackground or Palette.UIText
end

-- "[F]" or "[D-RIGHT]" depending on the device you're using
local function keyLabel(actionId)
	local device = UserInputService:GetLastInputType().Name:find("Gamepad") and "Gamepad" or "Keyboard"
	return "[" .. Keybinds.Label(Keybinds.Get(actionId, device)) .. "]"
end

function LobbyUI.OnState(snapshot)
	lastSnapshot = snapshot
	local visible = not snapshot.InMatch
	if visible and not shown then
		-- fade + slide the whole screen in
		gui.Enabled = true
		root.GroupTransparency = 1
		root.Position = UDim2.fromOffset(0, 24)
		Theme.tween(root, 0.45, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
	elseif not visible then
		gui.Enabled = false
	end
	shown = visible
	if not visible then
		return
	end

	queued = snapshot.Queued == true
	if queued then
		playButton.Text = "SEARCHING...   " .. keyLabel("FindMatch") .. " CANCEL"
		styleButton(playButton, false)
		statusLabel.Text = "Waiting for an opponent  (" .. tostring(snapshot.QueueCount or 1) .. " in queue)"
	else
		playButton.Text = keyLabel("FindMatch") .. "  FIND MATCH"
		styleButton(playButton, true)
		local count = snapshot.QueueCount or 0
		statusLabel.Text = count > 0 and (tostring(count) .. " player(s) waiting")
			or ""
	end
	spinner.Visible = queued

	-- REMATCH (after a match, for a little while)
	local rematch = snapshot.Rematch
	rematchButton.Visible = rematch ~= nil
	if rematch then
		if rematch.Requested then
			rematchButton.Text = "WAITING FOR " .. string.upper(rematch.Name) .. "..."
			styleButton(rematchButton, false)
		elseif rematch.TheyRequested then
			rematchButton.Text = keyLabel("Rematch") .. "  ACCEPT REMATCH VS " .. string.upper(rematch.Name)
			styleButton(rematchButton, true)
		else
			rematchButton.Text = keyLabel("Rematch") .. "  REMATCH " .. string.upper(rematch.Name)
			styleButton(rematchButton, true)
		end
	end

	if snapshot.Playground then
		title.Text = "PLAYGROUND"
		subtitle.Text = "Free roam on the match map."
		playgroundButton.Text = keyLabel("Playground") .. "  BACK TO LOBBY"
		modeChip.Visible = true
	else
		title.Text = "SNIPER DUEL"
		subtitle.Text = ""
		playgroundButton.Text = keyLabel("Playground") .. "  PLAYGROUND"
		modeChip.Visible = false
	end
end

function LobbyUI.Init(controllers)
	Controllers = controllers
end

function LobbyUI.Start(playerGui)
	gui = Theme.screen("Lobby", 2, playerGui)
	root = Theme.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})

	-- Title
	title = Theme.label({
		Position = UDim2.fromOffset(28, 64),
		Size = UDim2.fromOffset(500, 48),
		Text = "SNIPER DUEL",
		TextSize = 44,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = root,
	})
	local underline = Theme.new("Frame", {
		Position = UDim2.fromOffset(30, 112),
		Size = UDim2.fromOffset(70, 4),
		BackgroundColor3 = Palette.UIAccent,
		Parent = root,
	})
	Theme.corner(underline, 2)
	subtitle = Theme.label({
		Position = UDim2.fromOffset(30, 122),
		Size = UDim2.fromOffset(600, 20),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = root,
	})

	-- "PLAYGROUND" chip at the top
	modeChip = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 64),
		Size = UDim2.fromOffset(220, 34),
		BackgroundColor3 = Palette.UIAccent,
		Visible = false,
		Parent = root,
	})
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "PLAYGROUND MODE",
		TextSize = 16,
		TextColor3 = Palette.UIBackground,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = modeChip,
	})

	-- Buttons + status
	playButton = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, -180, 1, -64),
		Size = UDim2.fromOffset(340, 60),
		TextSize = 24,
		Parent = root,
	})
	playgroundButton = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 180, 1, -64),
		Size = UDim2.fromOffset(340, 60),
		TextSize = 24,
		BackgroundColor3 = Palette.UIPanelLight,
		TextColor3 = Palette.UIText,
		Parent = root,
	})
	rematchButton = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -136),
		Size = UDim2.fromOffset(420, 50),
		TextSize = 20,
		Visible = false,
		Parent = root,
	})
	spinner = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = playButton,
	})
	Theme.corner(spinner, UDim.new(0.5, 0))
	local spinStroke = Theme.stroke(spinner, Palette.UIAccent, 3, 0)
	Theme.new("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		Parent = spinStroke,
	})
	statusLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(700, 22),
		TextSize = 15,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = root,
	})

	local function toggleQueue()
		Sfx.Play("CardPick", { Volume = 0.6 })
		Theme.pop(playButton)
		Remotes.Get("QueueToggle"):FireServer()
	end
	local function togglePlayground()
		Sfx.Play("CardPick", { Volume = 0.6, Pitch = 0.8 })
		Theme.pop(playgroundButton)
		Remotes.Get("PlaygroundToggle"):FireServer()
	end
	local function requestRematch()
		Sfx.Play("CardPick", { Volume = 0.6, Pitch = 1.1 })
		Theme.pop(rematchButton)
		Remotes.Get("Duel"):FireServer("Rematch")
	end
	rematchButton.Activated:Connect(requestRematch)

	local function botMatch()
		Sfx.Play("CardPick", { Volume = 0.6, Pitch = 1.2 })
		Remotes.Get("AdminCommand"):FireServer("bot")
	end
	playButton.Activated:Connect(toggleQueue)
	playgroundButton.Activated:Connect(togglePlayground)

	local function onActionInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if Controllers and Controllers.Settings and Controllers.Settings.IsOpen() then
			return -- rebinding keys / moving sliders in Settings
		end
		if not gui.Enabled then
			return
		end
		if Keybinds.Matches("FindMatch", input) then
			toggleQueue()
		elseif Keybinds.Matches("Playground", input) then
			togglePlayground()
		elseif Keybinds.Matches("BotMatch", input) then
			botMatch()
		elseif Keybinds.Matches("Rematch", input) and rematchButton.Visible then
			requestRematch()
		end
	end
	UserInputService.InputBegan:Connect(onActionInput)
	Keybinds.VirtualBegan:Connect(onActionInput)

	-- Settings button
	local settingsButton = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -24, 0, 64),
		Size = UDim2.fromOffset(150, 40),
		Text = "SETTINGS",
		TextSize = 15,
		BackgroundColor3 = Palette.UIPanel,
		TextColor3 = Palette.UIText,
		Parent = root,
	})
	settingsButton.Activated:Connect(function()
		Controllers.Settings.Toggle()
	end)
	local duelButton = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -24, 0, 112),
		Size = UDim2.fromOffset(150, 40),
		Text = "DUEL A PLAYER",
		TextSize = 15,
		BackgroundColor3 = Palette.UIPanel,
		TextColor3 = Palette.UIText,
		Parent = root,
	})
	duelButton.Activated:Connect(function()
		Controllers.Duel.Open()
	end)

	-- idle animations: spinner while searching, a soft pulse on the find button
	RunService.RenderStepped:Connect(function()
		if not gui.Enabled then
			return
		end
		local t = os.clock()
		spinner.Rotation = (t * 360) % 360
		if not queued then
			local pulse = (math.sin(t * 3) + 1) / 2
			playButton.BackgroundColor3 = Palette.UIAccent:Lerp(Color3.new(1, 1, 1), pulse * 0.12)
		end
	end)

	-- button labels follow your keybinds and the device you're using
	ClientState.SettingsChanged:Connect(function()
		LobbyUI.OnState(lastSnapshot)
	end)
	UserInputService.LastInputTypeChanged:Connect(function()
		if shown then
			LobbyUI.OnState(lastSnapshot)
		end
	end)

	LobbyUI.OnState({ InMatch = false, Phase = "Lobby" })
end

return LobbyUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">MobileControls</string>
              <string name="Source"><![CDATA[--[[
	MobileControls.lua  (Client.ui.MobileControls)

	On-screen controls for phones and tablets. Shown while you're using a
	touch screen (hidden as soon as you use a keyboard, mouse or controller).

	  left side    Roblox's own thumbstick moves you; a small FIRE button
	               above it lets you shoot with your left thumb
	  right side   drag anywhere to look (sensitivity in Settings > Touch),
	               FIRE (you can keep dragging on it to aim), SCOPE, JUMP
	               (hold to bunny hop), SLIDE, SPRINT (toggle) and your
	               ability buttons (Grapple / Blink / Decoy, when you have them)
	  top          LAB (Power-Up Lab, in the lobby), DUEL (challenge a player)
	               and a settings button

	Buttons don't do anything themselves: they press the same actions as
	the keys (Keybinds.Press), so every rule (cooldowns, menus...) applies.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(script.Parent.Theme)
local Keybinds = require(script.Parent.Parent.Keybinds)
local ClientState = require(script.Parent.Parent.ClientState)

local Palette = Config.Palette
local player = Players.LocalPlayer

local MobileControls = {}
local Controllers

local gui, root, lookPad
local buttons = {} -- [name] = button
local lookTouches = {} -- [InputObject] = true: touches that turn the camera
local sprintOn = false

local function isTouch()
	return UserInputService.TouchEnabled
		and (UserInputService:GetLastInputType() == Enum.UserInputType.Touch or not UserInputService.KeyboardEnabled)
end

-- A round button. onDown/onUp get called on press / release.
local function roundButton(name, text, size, anchorPos, color, onDown, onUp, dragToLook)
	local button = Theme.new("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = anchorPos,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color or Palette.UIPanel,
		BackgroundTransparency = 0.25,
		Text = text,
		TextColor3 = Palette.UIText,
		TextSize = math.floor(size * 0.2),
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		AutoButtonColor = false,
		Parent = root,
	})
	Theme.corner(button, UDim.new(0.5, 0))
	Theme.stroke(button, Palette.UIText, 2, 0.6)
	button.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		button.BackgroundTransparency = 0.05
		Theme.pop(button, 0.08)
		if dragToLook then
			lookTouches[input] = true
		end
		if onDown then
			onDown()
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		button.BackgroundTransparency = 0.25
		if onUp then
			onUp()
		end
	end)
	buttons[name] = button
	return button
end

local function pill(name, text, pos, onPress)
	local button = Theme.button({
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = pos,
		Size = UDim2.fromOffset(78, 34),
		Text = text,
		TextSize = 14,
		BackgroundColor3 = Palette.UIPanel,
		TextColor3 = Palette.UIText,
		Parent = root,
	})
	button.Activated:Connect(onPress)
	buttons[name] = button
	return button
end

local function hold(action)
	return function()
		Keybinds.Press(action, true)
	end, function()
		Keybinds.Press(action, false)
	end
end

local function tap(action)
	return function()
		Keybinds.Press(action, true)
		Keybinds.Press(action, false)
	end
end

local function refresh()
	local show = isTouch() and not ClientState.MenuOpen
	gui.Enabled = show
	if not show then
		return
	end
	local stats = ClientState.Stats
	local inMatch = ClientState.InMatch()
	buttons.Grapple.Visible = stats.Grapple == true
	buttons.Blink.Visible = stats.Blink == true
	buttons.Decoy.Visible = stats.Decoy == true
	buttons.Lab.Visible = not inMatch
	buttons.Duel.Visible = not inMatch
	buttons.Sprint.BackgroundColor3 = sprintOn and Palette.UIAccent or Palette.UIPanel
end

function MobileControls.Init(controllers)
	Controllers = controllers
end

function MobileControls.Start(playerGui)
	gui = Theme.screen("MobileControls", 1, playerGui)
	root = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local scale = Theme.scaleOf(root)

	-- look pad: the right part of the screen (behind the buttons). It's
	-- Active, so Roblox's camera ignores these touches and we turn instead.
	lookPad = Theme.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(0.55, 1),
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = 0,
		Parent = gui,
	})
	lookPad.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			lookTouches[input] = true
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if lookTouches[input] and Controllers and Controllers.Camera.AddTouchLook then
			Controllers.Camera.AddTouchLook(Vector2.new(input.Delta.X, input.Delta.Y))
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		lookTouches[input] = nil
	end)

	local T = Config.Touch
	local function br(x, y)
		return UDim2.new(1, -x, 1, -y) -- from the bottom-right corner
	end
	roundButton("Fire", "FIRE", T.FireButtonSize, br(200, 175), Palette.PlayerB, function()
		Keybinds.Press("Fire", true)
	end, function()
		Keybinds.Press("Fire", false)
	end, true)
	roundButton("FireLeft", "FIRE", 70, UDim2.new(0, 120, 1, -270), Palette.PlayerB, function()
		Keybinds.Press("Fire", true)
	end, function()
		Keybinds.Press("Fire", false)
	end)
	local scopeDown, scopeUp = hold("Scope")
	roundButton("Scope", "SCOPE", 72, br(85, 215), Palette.UIPanel, scopeDown, scopeUp, true)
	local jumpDown, jumpUp = hold("Jump")
	roundButton("Jump", "JUMP", 84, br(80, 95), Palette.UIPanel, jumpDown, jumpUp)
	roundButton("Slide", "SLIDE", 64, br(190, 65), Palette.UIPanel, tap("Slide"))
	roundButton("Sprint", "RUN", 56, br(290, 60), Palette.UIPanel, function()
		sprintOn = not sprintOn
		Keybinds.Press("Sprint", sprintOn)
		refresh()
	end)
	roundButton("Grapple", "HOOK", 58, br(80, 310), Palette.UIPanel, tap("Grapple"))
	roundButton("Blink", "BLINK", 58, br(150, 300), Palette.UIPanel, tap("Blink"))
	roundButton("Decoy", "DECOY", 58, br(220, 300), Palette.UIPanel, tap("Decoy"))

	pill("Lab", "LAB", UDim2.new(0, 60, 0, 120), tap("PowerUpLab"))
	pill("Duel", "DUEL", UDim2.new(0, 150, 0, 120), tap("DuelFriend"))
	pill("Settings", "MENU", UDim2.new(1, -60, 0, 64), tap("Settings"))

	-- smaller on small screens
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(viewport.X / 900, viewport.Y / 500), 0.65, 1.2)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	UserInputService.LastInputTypeChanged:Connect(refresh)
	ClientState.Changed:Connect(refresh)
	ClientState.MenuChanged:Connect(refresh)
	player.CharacterAdded:Connect(function()
		sprintOn = false
		refresh()
	end)
	refresh()
end

return MobileControls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">PickScreen</string>
              <string name="Source"><![CDATA[--[[
	PickScreen.lua  (Client.ui.PickScreen)

	Between rounds the player who DIED picks 1 of 5 power-up cards.

	CARD LAYOUT (top to bottom)
		rarity pill + "owned x1 > x2" badge
		icon on a glowing disc
		name, tag chips (Bullets / Damage / Movement ...)
		description
		STACKS footer: what another copy adds

	ANIMATION
		open     background fades in, title slides down
		deal     cards rise from below one after another, face down
		flip     each card flips over with a white flash; Legendary cards burst
		         with gold particles, a ring and a looping shine
		idle     cards float gently, glows breathe
		hover    lift + tilt toward the mouse + brighter glow (picker only)
		pick     chosen card flies to the centre with a burst; the rest fall away
		timer    bar drains, ticks and turns red in the last 5 seconds

	The winner sees the same cards but can't pick. The mouse is unlocked.
	Also used solo by the Power-Up Lab ("practice pick").
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Palette = Config.Palette
local player = Players.LocalPlayer

local CARD_W, CARD_H = 210, 318
local GAP = 22

local PickScreen = {}

local gui, overlay, title, subtitle, timerTrack, timerFill, timerText, row, unlocker
local cards = {} -- card records
local isOpen = false
local isPicker = false
local pickedIndex = nil
local openToken = 0
local practiceCallback = nil -- set when opened from the Power-Up Lab (solo practice)
local lastTimerSecond = nil

----------------------------------------------------------------------------
-- Card construction
----------------------------------------------------------------------------
local function chip(parent, text, color)
	local c = Theme.new("Frame", {
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 18),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.82,
		Parent = parent,
	})
	Theme.corner(c, 9)
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = c })
	Theme.label({
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		Text = string.upper(text),
		TextSize = 10,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.45),
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = c,
	})
	return c
end

local function makeCard(index, def, ownedStacks)
	local rarity = Config.Rarity[def.Rarity]
	local color = rarity.Color
	local rec = { Index = index, Def = def, Flipped = false, Phase = index * 0.9 }

	-- holder: fixed slot in the row layout
	local holder = Theme.new("Frame", {
		Name = "Card" .. index,
		Size = UDim2.fromOffset(CARD_W, CARD_H),
		BackgroundTransparency = 1,
		LayoutOrder = index,
		Parent = row,
	})
	-- mover: everything that animates (position / rotation / scale)
	local mover = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 160),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local scale = Theme.new("UIScale", { Parent = mover })

	-- soft glow (two layers) behind the card
	local glow = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 26, 1, 26),
		BackgroundColor3 = color,
		BackgroundTransparency = 1,
		Parent = mover,
	})
	Theme.corner(glow, 26)
	local glowInner = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 10, 1, 10),
		BackgroundColor3 = color,
		BackgroundTransparency = 1,
		Parent = mover,
	})
	Theme.corner(glowInner, 20)

	-- flipper: its width animates for the card flip
	local flipper = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = mover,
	})

	-- the card face (a CanvasGroup so it fades and clips as one piece)
	local card = Theme.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIPanel,
		GroupTransparency = 1,
		Parent = flipper,
	})
	Theme.corner(card, 16)
	local stroke = Theme.stroke(card, color, 2.5, 0)

	-- FRONT -----------------------------------------------------------
	local front = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = card })
	-- colour wash from the top
	local wash = Theme.new("Frame", { Size = UDim2.new(1, 0, 0.55, 0), BackgroundColor3 = color, Parent = front })
	Theme.new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.72), NumberSequenceKeypoint.new(1, 1) }),
		Parent = wash,
	})
	-- rarity pill
	local pill = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 12),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 20),
		BackgroundColor3 = color,
		Parent = front,
	})
	Theme.corner(pill, 10)
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9), Parent = pill })
	Theme.label({
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		Text = string.upper(def.Rarity),
		TextSize = 11,
		TextColor3 = Palette.UIBackground,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = pill,
	})
	if ownedStacks > 0 then
		local badge = Theme.new("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 12),
			Size = UDim2.fromOffset(64, 20),
			BackgroundColor3 = Palette.UIBackground,
			BackgroundTransparency = 0.3,
			Parent = front,
		})
		Theme.corner(badge, 10)
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = ("x%d > x%d"):format(ownedStacks, ownedStacks + 1),
			TextSize = 11,
			TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.4),
			FontFace = Theme.Font(Enum.FontWeight.Heavy),
			Parent = badge,
		})
	end
	-- icon on a glowing disc
	local disc = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(112, 112),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.82,
		Parent = front,
	})
	Theme.corner(disc, UDim.new(0.5, 0))
	Theme.stroke(disc, color, 1.5, 0.55)
	local icon = Icons.Create(def, 74)
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.Parent = disc
	-- name
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 166),
		Size = UDim2.new(1, -24, 0, 26),
		Text = def.Name,
		TextSize = 21,
		TextTruncate = Enum.TextTruncate.AtEnd,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = front,
	})
	-- tag chips
	local tags = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 194),
		Size = UDim2.new(1, -24, 0, 18),
		BackgroundTransparency = 1,
		Parent = front,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 5),
		}),
	})
	for _, tag in ipairs(def.Tags or {}) do
		chip(tags, tag, color)
	end
	-- description
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 220),
		Size = UDim2.new(1, -28, 0, 52),
		Text = def.Description,
		TextSize = 13,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = front,
	})
	-- stacking footer
	local footer = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.35,
		Parent = front,
	})
	Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = color, BackgroundTransparency = 0.5, Parent = footer })
	Theme.label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = "STACKS  " .. (def.Stacking or "-"),
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35),
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		Parent = footer,
	})

	-- BACK ------------------------------------------------------------
	local back = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color:Lerp(Palette.UIBackground, 0.7),
		Parent = card,
	})
	for i = -4, 4 do
		Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, i * 34, 0.5, 0),
			Size = UDim2.new(0, 10, 1.6, 0),
			Rotation = 30,
			BackgroundColor3 = color,
			BackgroundTransparency = 0.85,
			Parent = back,
		})
	end
	local diamond = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(70, 70),
		Rotation = 45,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.2,
		Parent = back,
	})
	Theme.corner(diamond, 12)
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(60, 60),
		Text = "?",
		TextSize = 42,
		TextColor3 = Palette.UIBackground,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = back,
	})

	-- white flash layer used when the card flips / is picked
	local flash = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 9,
		Parent = card,
	})

	local button = Theme.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 11,
		Parent = mover,
	})

	rec.Holder, rec.Mover, rec.Scale, rec.Glow, rec.GlowInner = holder, mover, scale, glow, glowInner
	rec.Flipper, rec.Card, rec.Stroke, rec.Front, rec.Back = flipper, card, stroke, front, back
	rec.Flash, rec.Button, rec.Color = flash, button, color
	rec.BaseGlow = def.Rarity == "Legendary" and 0.6 or def.Rarity == "Epic" and 0.72 or 0.82
	return rec
end

local function cardCenter(rec)
	local p, s = rec.Mover.AbsolutePosition, rec.Mover.AbsoluteSize
	return p + s / 2
end

----------------------------------------------------------------------------
-- Animations
----------------------------------------------------------------------------
local function dealAndFlip(rec, delay, token)
	task.delay(delay, function()
		if token ~= openToken then
			return
		end
		rec.Mover.Rotation = (rec.Index % 2 == 0) and 6 or -6
		-- 1) rise in, face down
		Theme.tween(rec.Card, 0.35, { GroupTransparency = 0 })
		Theme.tween(rec.Mover, 0.5, { Position = UDim2.fromScale(0.5, 0.5), Rotation = 0 }, Enum.EasingStyle.Back)
		Sfx.Play("CardHover", { Pitch = 0.7 + rec.Index * 0.08, Volume = 1.2 })
		task.wait(0.55)
		if token ~= openToken then
			return
		end
		-- 2) flip: squash to edge-on...
		Theme.tween(rec.Flipper, 0.12, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.12)
		if token ~= openToken then
			return
		end
		-- ...swap faces and open up with a flash
		rec.Back.Visible = false
		rec.Front.Visible = true
		rec.Flash.BackgroundTransparency = 0.2
		Theme.tween(rec.Flash, 0.45, { BackgroundTransparency = 1 })
		Theme.tween(rec.Flipper, 0.24, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back)
		rec.Flipped = true
		rec.GlowInner.BackgroundTransparency = 0.4
		Theme.tween(rec.GlowInner, 0.6, { BackgroundTransparency = rec.BaseGlow })

		local rarity = rec.Def.Rarity
		if rarity == "Legendary" then
			Sfx.Play("CardLegendary")
			task.wait(0.05)
			local center = cardCenter(rec)
			Theme.burst(gui, center, rec.Color, 22, 200, 9)
			Theme.ring(gui, center, rec.Color, 380, 8)
			Theme.shine(rec.Card, 1.4, true, 0.4)
			Theme.pop(rec.Mover, 0.1)
		elseif rarity == "Epic" then
			Sfx.Play("CardFlip", { Pitch = 1.25 })
			Theme.burst(gui, cardCenter(rec), rec.Color, 10, 130, 7)
			Theme.shine(rec.Card, 0.7, false, 0.35)
		else
			Sfx.Play("CardFlip", { Pitch = 1 + Config.Rarity[rarity].Order * 0.08 })
			Theme.shine(rec.Card, 0.6, false, 0.25)
		end
	end)
end

local function setHover(rec, hovered)
	if not isPicker or pickedIndex or not rec.Flipped then
		return
	end
	rec.Hovered = hovered
	if hovered then
		Sfx.Play("CardHover")
		Theme.tween(rec.Mover, 0.18, { Position = UDim2.new(0.5, 0, 0.5, -20) }, Enum.EasingStyle.Back)
		Theme.tween(rec.Scale, 0.18, { Scale = 1.07 }, Enum.EasingStyle.Back)
		Theme.tween(rec.Stroke, 0.18, { Thickness = 4.5 })
		Theme.tween(rec.Glow, 0.18, { BackgroundTransparency = 0.7 })
	else
		Theme.tween(rec.Mover, 0.2, { Position = UDim2.fromScale(0.5, 0.5), Rotation = 0 })
		Theme.tween(rec.Scale, 0.2, { Scale = 1 })
		Theme.tween(rec.Stroke, 0.2, { Thickness = 2.5 })
		Theme.tween(rec.Glow, 0.2, { BackgroundTransparency = 1 })
	end
end

local function playPickAnimation(index)
	if pickedIndex == index and cards[index] and cards[index].Animated then
		return
	end
	pickedIndex = index
	local chosen = cards[index]
	if not chosen then
		return
	end
	chosen.Animated = true
	Sfx.Play("CardPick")

	-- the chosen card flies to the centre of the screen
	local viewport = workspace.CurrentCamera.ViewportSize
	local center = cardCenter(chosen)
	local rowScale = row:FindFirstChildOfClass("UIScale")
	local s = rowScale and rowScale.Scale or 1
	local dx = (viewport.X / 2 - center.X) / s
	chosen.Back.Visible = false
	chosen.Front.Visible = true
	chosen.Card.GroupTransparency = 0
	chosen.Flipper.Size = UDim2.fromScale(1, 1)
	chosen.Holder.ZIndex = 5
	Theme.tween(chosen.Mover, 0.45, { Position = UDim2.new(0.5, dx, 0.5, -10), Rotation = 0 }, Enum.EasingStyle.Quint)
	chosen.Scale.Scale = 1.3
	Theme.tween(chosen.Scale, 0.5, { Scale = 1.18 }, Enum.EasingStyle.Back)
	Theme.tween(chosen.Stroke, 0.2, { Thickness = 5, Color = Color3.new(1, 1, 1) })
	chosen.Flash.BackgroundTransparency = 0
	Theme.tween(chosen.Flash, 0.5, { BackgroundTransparency = 1 })
	chosen.Glow.BackgroundTransparency = 0.35
	Theme.tween(chosen.Glow, 0.8, { BackgroundTransparency = 0.6 })
	task.delay(0.3, function()
		if not chosen.Mover.Parent then
			return
		end
		local c = cardCenter(chosen)
		Theme.burst(gui, c, chosen.Color, 26, 260, 10)
		Theme.burst(gui, c, Color3.new(1, 1, 1), 12, 180, 6)
		Theme.ring(gui, c, chosen.Color, 520, 10)
		Theme.tween(chosen.Stroke, 0.4, { Color = chosen.Color })
		Theme.shine(chosen.Card, 0.6, false, 0.5)
	end)

	-- the others fall away
	for i, rec in ipairs(cards) do
		if i ~= index then
			task.delay(math.abs(i - index) * 0.05, function()
				Theme.tween(rec.Mover, 0.55, {
					Position = UDim2.new(0.5, 0, 0.5, 420),
					Rotation = (i < index) and -18 or 18,
				}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
				Theme.tween(rec.Card, 0.45, { GroupTransparency = 1 })
				Theme.tween(rec.Glow, 0.3, { BackgroundTransparency = 1 })
				Theme.tween(rec.GlowInner, 0.3, { BackgroundTransparency = 1 })
			end)
		end
	end

	local def = chosen.Def
	if isPicker then
		title.Text = "YOU PICKED " .. string.upper(def.Name)
	else
		local opp = ClientState.GetOpponentEntry()
		title.Text = (opp and string.upper(opp.Name) or "OPPONENT") .. " PICKED " .. string.upper(def.Name)
	end
	title.TextColor3 = chosen.Color
	Theme.pop(title, 0.2)
	subtitle.Text = "STACKS  " .. (def.Stacking or "")
end

----------------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------------
local function clearCards()
	for _, rec in ipairs(cards) do
		rec.Holder:Destroy()
	end
	table.clear(cards)
end

local function open(snapshot)
	openToken += 1
	local token = openToken
	clearCards()
	isOpen = true
	pickedIndex = nil
	lastTimerSecond = nil
	isPicker = snapshot.PickerUserId == player.UserId

	gui.Enabled = true
	unlocker.Visible = true
	ClientState.SetMenu("Pick", true)
	overlay.BackgroundTransparency = 1
	Theme.tween(overlay, 0.35, { BackgroundTransparency = 0.3 })
	-- title slides down
	title.Position = UDim2.new(0.5, 0, 0.1, -40)
	title.TextTransparency = 1
	subtitle.TextTransparency = 1
	Theme.tween(title, 0.5, { Position = UDim2.fromScale(0.5, 0.1), TextTransparency = 0 }, Enum.EasingStyle.Quint)
	Theme.tween(subtitle, 0.6, { TextTransparency = 0 })

	if isPicker then
		title.Text = "PICK A POWER-UP"
		title.TextColor3 = Palette.UIText
		subtitle.Text = "You lost the round. Choose one card - it stacks for the rest of the match."
	else
		local opp = ClientState.GetOpponentEntry()
		title.Text = (opp and string.upper(opp.Name) or "OPPONENT") .. " IS CHOOSING"
		title.TextColor3 = Palette.UISubText
		subtitle.Text = "You won the round. Here's what they could get..."
	end

	-- whose power-ups are we showing stacks for?
	local pickerEntry
	for _, entry in ipairs(snapshot.Players or {}) do
		if entry.UserId == snapshot.PickerUserId then
			pickerEntry = entry
		end
	end
	local owned = pickerEntry and pickerEntry.PowerUps or {}

	for i, id in ipairs(snapshot.Cards or {}) do
		local def = PowerUps.Get(id)
		if def then
			local rec = makeCard(i, def, owned[id] or 0)
			table.insert(cards, rec)
			rec.Button.MouseEnter:Connect(function()
				setHover(rec, true)
			end)
			rec.Button.MouseLeave:Connect(function()
				setHover(rec, false)
			end)
			rec.Button.Activated:Connect(function()
				if isPicker and not pickedIndex and rec.Flipped then
					if practiceCallback then
						local callback = practiceCallback
						playPickAnimation(i)
						callback(id)
						task.delay(1.8, function()
							if practiceCallback == callback then
								PickScreen.Close()
							end
						end)
					else
						Remotes.Get("PickCard"):FireServer(i)
						playPickAnimation(i)
					end
				end
			end)
			dealAndFlip(rec, 0.2 + (i - 1) * 0.16, token)
		end
	end
end

local function close()
	if not isOpen then
		return
	end
	practiceCallback = nil
	isOpen = false
	openToken += 1
	local token = openToken
	unlocker.Visible = false
	ClientState.SetMenu("Pick", false)
	Theme.tween(overlay, 0.3, { BackgroundTransparency = 1 })
	Theme.tween(title, 0.25, { TextTransparency = 1 })
	Theme.tween(subtitle, 0.25, { TextTransparency = 1 })
	for _, rec in ipairs(cards) do
		Theme.tween(rec.Card, 0.25, { GroupTransparency = 1 })
		Theme.tween(rec.Scale, 0.25, { Scale = 0.85 })
		Theme.tween(rec.Glow, 0.2, { BackgroundTransparency = 1 })
		Theme.tween(rec.GlowInner, 0.2, { BackgroundTransparency = 1 })
	end
	task.delay(0.35, function()
		if token == openToken then
			clearCards()
			gui.Enabled = false
		end
	end)
end

function PickScreen.Close()
	close()
end

function PickScreen.IsPracticeOpen()
	return isOpen and practiceCallback ~= nil
end

--[[
	Opens the real pick screen with `cardIds` for solo practice (from the
	Power-Up Lab). `onPick(id)` is called with the chosen power-up.
]]
function PickScreen.OpenPractice(cardIds, owned, onPick)
	open({
		Cards = cardIds,
		PickerUserId = player.UserId,
		Players = { { UserId = player.UserId, PowerUps = owned or {} } },
	})
	practiceCallback = onPick
	title.Text = "PICK A POWER-UP"
	title.TextColor3 = Palette.UIText
	subtitle.Text = "Practice pick - the card gets added to your Power-Up Lab.  (B to close)"
end

function PickScreen.OnState(snapshot, old)
	if practiceCallback then
		if not snapshot.InMatch then
			return -- practice pick stays open in the lobby
		end
		close()
	end
	local phase = snapshot.Phase
	if phase == "Pick" then
		if not isOpen or old.Phase ~= "Pick" then
			open(snapshot)
		end
	elseif phase == "PickReveal" then
		local wasOpen = isOpen
		if not wasOpen then
			open(snapshot)
		end
		if snapshot.PickedIndex then
			-- wait for the deal + flip if we opened late
			task.delay(wasOpen and 0 or 1.6, function()
				playPickAnimation(snapshot.PickedIndex)
			end)
		end
	elseif isOpen then
		close()
	end
end

----------------------------------------------------------------------------
-- Per-frame: idle float, hover tilt, timer
----------------------------------------------------------------------------
local function update()
	if not isOpen then
		return
	end
	local t = os.clock()
	local mouse = UserInputService:GetMouseLocation()
	for _, rec in ipairs(cards) do
		if rec.Flipped and not pickedIndex then
			-- gentle float + breathing glow
			local bob = UDim2.new(0.5, 0, 0.5, math.sin(t * 2 + rec.Phase) * 3)
			rec.Flipper.Position = bob
			rec.Glow.Position = bob
			rec.GlowInner.Position = bob
			rec.GlowInner.BackgroundTransparency = rec.BaseGlow + math.sin(t * 2.4 + rec.Phase) * 0.06
			-- tilt toward the mouse while hovered
			if rec.Hovered then
				local center = cardCenter(rec)
				local dx = math.clamp((mouse.X - center.X) / (CARD_W / 2), -1, 1)
				rec.Mover.Rotation = dx * 3
			end
		end
	end

	local snapshot = ClientState.Snapshot
	if snapshot.Phase == "Pick" and not practiceCallback then
		local left = ClientState.TimeLeft() or 0
		timerTrack.Visible = true
		timerFill.Size = UDim2.fromScale(math.clamp(left / Config.Match.PickTime, 0, 1), 1)
		local urgent = left < 5
		timerFill.BackgroundColor3 = urgent and Palette.UIDanger or Palette.UIAccent
		local second = math.ceil(left)
		timerText.Text = tostring(second)
		timerText.TextColor3 = urgent and Palette.UIDanger or Palette.UIText
		if second ~= lastTimerSecond then
			lastTimerSecond = second
			if urgent and not pickedIndex then
				Theme.pop(timerText, 0.35)
				Sfx.Play("Countdown", { Pitch = 1.4, Volume = 0.5 })
			end
		end
	else
		timerTrack.Visible = false
		timerText.Text = ""
	end
end

function PickScreen.Start(playerGui)
	gui = Theme.screen("PickScreen", 5, playerGui)
	gui.Enabled = false

	overlay = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)

	title = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.1),
		Size = UDim2.fromOffset(1000, 56),
		TextSize = 46,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = gui,
	})
	subtitle = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 58),
		Size = UDim2.fromOffset(1000, 24),
		TextSize = 17,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = gui,
	})

	row = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.54),
		Size = UDim2.fromOffset(5 * CARD_W + 4 * GAP, CARD_H + 80),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	-- shrink the cards on small screens
	local rowScale = Theme.new("UIScale", { Parent = row })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		rowScale.Scale = math.min(1, (viewport.X - 40) / row.Size.X.Offset, (viewport.Y * 0.62) / row.Size.Y.Offset)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	timerTrack = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.88),
		Size = UDim2.fromOffset(460, 6),
		BackgroundColor3 = Palette.UIPanelLight,
		Parent = gui,
	})
	Theme.corner(timerTrack, 3)
	timerFill = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIAccent,
		Parent = timerTrack,
	})
	Theme.corner(timerFill, 3)
	timerText = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.88, 12),
		Size = UDim2.fromOffset(80, 30),
		TextSize = 26,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = gui,
	})

	RunService.RenderStepped:Connect(update)
end

return PickScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">PowerUpLab</string>
              <string name="Source"><![CDATA[--[[
	PowerUpLab.lua  (Client.ui.PowerUpLab)

	Solo testing for power-ups. In the lobby, press B to open the lab:
		* left click a power-up to add a stack, right click to remove one
		* DRAW 5 CARDS opens the real pick screen with random cards
		* CLEAR ALL removes everything
	Then close the lab and try them on the shooting range dummies.

	The server keeps your lab picks, so server-checked effects like Explosive
	Rounds, Ricochet, Decoy and Phantom Step really work. Lab picks never
	carry into a match (matches always start with no power-ups).
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local PickScreen = require(script.Parent.PickScreen)
local Keybinds = require(script.Parent.Parent.Keybinds)

local Palette = Config.Palette

local PowerUpLab = {}

local gui, panel, grid, unlocker
local tiles = {} -- [id] = { Stacks = TextLabel, Stroke = UIStroke }
local isOpen = false

local function owned()
	return ClientState.Snapshot.PowerUps or {}
end

local function send(action, id)
	Remotes.Get("Practice"):FireServer(action, id)
end

local function refresh()
	local current = owned()
	for id, tile in pairs(tiles) do
		local stacks = current[id] or 0
		local def = PowerUps.Get(id)
		tile.Stacks.Text = stacks > 0 and ("x%d / %d"):format(stacks, def.MaxStacks or 1) or ""
		tile.Stroke.Thickness = stacks > 0 and 3 or 1
		tile.Stroke.Transparency = stacks > 0 and 0 or 0.6
		tile.Frame.BackgroundColor3 = stacks > 0 and Palette.UIPanelLight or Palette.UIPanel
	end
end

function PowerUpLab.Open()
	if isOpen or ClientState.InMatch() then
		return
	end
	isOpen = true
	gui.Enabled = true
	unlocker.Visible = true
	ClientState.SetMenu("Lab", true)
	refresh()
	panel.Size = UDim2.fromOffset(820, 520)
	Theme.tween(panel, 0.2, { Size = UDim2.fromOffset(860, 560) }, Enum.EasingStyle.Back)
end

function PowerUpLab.Close()
	if not isOpen then
		return
	end
	isOpen = false
	gui.Enabled = false
	unlocker.Visible = false
	ClientState.SetMenu("Lab", false)
end

local function drawCards()
	local cards = PowerUps.DrawCards(owned(), Config.Match.CardsPerPick)
	if #cards == 0 then
		return
	end
	PowerUpLab.Close()
	PickScreen.OpenPractice(cards, owned(), function(id)
		send("Add", id)
	end)
end

local function makeTile(def, order)
	local rarity = Config.Rarity[def.Rarity]
	local frame = Theme.new("TextButton", {
		Name = def.Id,
		Text = "",
		AutoButtonColor = true,
		BackgroundColor3 = Palette.UIPanel,
		LayoutOrder = rarity.Order * 100 + order,
		Parent = grid,
	})
	Theme.corner(frame, 10)
	local stroke = Theme.stroke(frame, rarity.Color, 1, 0.6)

	local icon = Icons.Create(def, 40)
	icon.Position = UDim2.fromOffset(8, 8)
	icon.Parent = frame
	Theme.label({
		Position = UDim2.fromOffset(56, 6),
		Size = UDim2.new(1, -60, 0, 20),
		Text = def.Name,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	Theme.label({
		Position = UDim2.fromOffset(56, 26),
		Size = UDim2.new(1, -60, 0, 16),
		Text = string.upper(def.Rarity),
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = rarity.Color,
		Parent = frame,
	})
	local stacks = Theme.label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -4),
		Size = UDim2.fromOffset(60, 16),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Palette.UIAccent,
		Parent = frame,
	})
	-- description on hover
	frame.MouseEnter:Connect(function()
		panel.Description.Text = def.Name .. ":  " .. def.Description .. "   (Stacks: " .. (def.Stacking or "-") .. ")"
	end)
	frame.Activated:Connect(function()
		Sfx.Play("CardHover")
		send("Add", def.Id)
	end)
	frame.MouseButton2Click:Connect(function()
		Sfx.Play("CardHover", { Pitch = 0.8 })
		send("Remove", def.Id)
	end)
	tiles[def.Id] = { Frame = frame, Stacks = stacks, Stroke = stroke }
end

function PowerUpLab.Init() end

function PowerUpLab.Start(playerGui)
	gui = Theme.screen("PowerUpLab", 9, playerGui)
	gui.Enabled = false
	Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.4,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)

	panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(860, 560),
		BackgroundTransparency = 0,
		Parent = gui,
	})
	Theme.padding(panel, 20)
	-- shrink on small screens
	local scale = Theme.new("UIScale", { Parent = panel })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.min(1, (viewport.X - 40) / 860, (viewport.Y - 40) / 560)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	Theme.label({
		Size = UDim2.new(1, 0, 0, 34),
		Text = "POWER-UP LAB",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})
	Theme.label({
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 20),
		Text = "Try any power-up on the range.  Left click: add  -  Right click: remove  -  B: close",
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = panel,
	})

	-- scrolls (mouse wheel) when there are more power-ups than fit
	grid = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 1, -150),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Palette.UISubText,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(196, 56),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, def in ipairs(PowerUps.Definitions) do
		makeTile(def, i)
	end

	local description = Theme.label({
		Name = "Description",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -52),
		Size = UDim2.new(1, 0, 0, 22),
		Text = "Hover a power-up to read what it does.",
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UIText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = panel,
	})
	description.Name = "Description"

	local draw = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(240, 42),
		Text = "DRAW 5 CARDS",
		TextSize = 18,
		Parent = panel,
	})
	draw.Activated:Connect(drawCards)
	local clear = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 252, 1, 0),
		Size = UDim2.fromOffset(160, 42),
		Text = "CLEAR ALL",
		TextSize = 18,
		BackgroundColor3 = Palette.UIPanelLight,
		TextColor3 = Palette.UIText,
		Parent = panel,
	})
	clear.Activated:Connect(function()
		send("Clear")
	end)
	local done = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(160, 42),
		Text = "DONE",
		TextSize = 18,
		Parent = panel,
	})
	done.Activated:Connect(PowerUpLab.Close)

	ClientState.Changed:Connect(function(snapshot)
		if snapshot.InMatch then
			PowerUpLab.Close()
		else
			refresh()
		end
	end)

	local function onActionInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if require(script.Parent.SettingsMenu).IsOpen() then
			return -- rebinding keys / moving sliders in Settings
		end
		if Keybinds.Matches("PowerUpLab", input) then
			if PickScreen.IsPracticeOpen() then
				PickScreen.Close()
			elseif isOpen then
				PowerUpLab.Close()
			elseif not ClientState.InMatch() then
				PowerUpLab.Open()
			end
		end
	end
	UserInputService.InputBegan:Connect(onActionInput)
	Keybinds.VirtualBegan:Connect(onActionInput)
end

return PowerUpLab
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">SettingsMenu</string>
              <string name="Source"><![CDATA[--[[
	SettingsMenu.lua  (Client.ui.SettingsMenu)

	Three tabs:
		GENERAL     sliders: mouse + scoped mouse sensitivity, controller +
		            scoped controller sensitivity, controller deadzone, field
		            of view. Toggles: scope mode, invert Y (controller), aim
		            assist (controller).
		KEYBOARD    rebind every action: click a binding, then press a key or
		            mouse button (Esc cancels).
		CONTROLLER  same for controller buttons.

	Open / close with the Settings bind (P / Select). Everything saves to the
	server (DataStore) when the menu closes.
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local ClientState = require(script.Parent.Parent.ClientState)
local Keybinds = require(script.Parent.Parent.Keybinds)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)

local Palette = Config.Palette

local SettingsMenu = {}

local gui, panel, unlocker, pages, tabButtons
local refreshers = {} -- functions that redraw values from ClientState.Settings
local isOpen = false
local capturing = nil -- { Device, Action, Button } while waiting for a key press
local PANEL_W, PANEL_H = 560, 520

----------------------------------------------------------------------------
-- Controls
----------------------------------------------------------------------------
local function sectionTitle(parent, order, text)
	Theme.label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UIAccent,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		LayoutOrder = order,
		Parent = parent,
	})
end

-- A horizontal slider bound to ClientState.Settings[key].
local function slider(parent, order, key, labelText, decimals)
	local limits = Config.SettingsLimits[key]
	local holder = Theme.new("Frame", {
		Size = UDim2.new(1, -8, 0, 50),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	Theme.label({
		Size = UDim2.new(0.7, 0, 0, 20),
		Text = labelText,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = holder,
	})
	local valueLabel = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.3, 0, 0, 20),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Palette.UIAccent,
		Parent = holder,
	})
	local track = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Palette.UIPanelLight,
		Parent = holder,
	})
	Theme.corner(track, 4)
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = Palette.UIAccent, Parent = track })
	Theme.corner(fill, 4)
	local knob = Theme.new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Palette.UIText,
		Text = "",
		AutoButtonColor = false,
		Parent = track,
	})
	Theme.corner(knob, UDim.new(0.5, 0))

	local function show(value)
		value = value or Config.SettingsDefaults[key]
		local alpha = (value - limits.Min) / (limits.Max - limits.Min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = decimals == 0 and tostring(math.floor(value + 0.5)) or ("%.2f"):format(value)
	end

	local dragging = false
	local function setFromX(x)
		local alpha = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local value = limits.Min + alpha * (limits.Max - limits.Min)
		local factor = decimals == 0 and 1 or 100
		value = math.floor(value * factor + 0.5) / factor
		ClientState.SetSetting(key, value)
		show(value)
	end
	local function begin(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end
	knob.InputBegan:Connect(begin)
	track.InputBegan:Connect(begin)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	-- controller: select the knob and press left / right on the D-pad
	knob.SelectionGained:Connect(function()
		knob.BackgroundColor3 = Palette.UIAccent
	end)
	knob.SelectionLost:Connect(function()
		knob.BackgroundColor3 = Palette.UIText
	end)
	UserInputService.InputBegan:Connect(function(input)
		if not isOpen or game:GetService("GuiService").SelectedObject ~= knob then
			return
		end
		local step = (limits.Max - limits.Min) / 40
		local current = ClientState.Settings[key] or Config.SettingsDefaults[key]
		if input.KeyCode == Enum.KeyCode.DPadRight then
			ClientState.SetSetting(key, math.clamp(current + step, limits.Min, limits.Max))
		elseif input.KeyCode == Enum.KeyCode.DPadLeft then
			ClientState.SetSetting(key, math.clamp(current - step, limits.Min, limits.Max))
		end
	end)

	table.insert(refreshers, function(settings)
		show(settings[key])
	end)
end

-- An ON/OFF style toggle row. `labels` = { onText, offText }.
local function toggle(parent, order, key, labelText, labels)
	local row = Theme.new("Frame", {
		Size = UDim2.new(1, -8, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	Theme.label({
		Size = UDim2.new(0.65, 0, 1, 0),
		Text = labelText,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = row,
	})
	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(120, 30),
		TextSize = 14,
		Parent = row,
	})
	local function show(settings)
		local on = settings[key]
		if on == nil then
			on = Config.SettingsDefaults[key]
		end
		button.Text = on and labels[1] or labels[2]
		button.BackgroundColor3 = on and Palette.UIAccent or Palette.UIPanelLight
		button.TextColor3 = on and Palette.UIBackground or Palette.UIText
	end
	button.Activated:Connect(function()
		local current = ClientState.Settings[key]
		if current == nil then
			current = Config.SettingsDefaults[key]
		end
		ClientState.SetSetting(key, not current)
		Theme.pop(button)
		Sfx.Play("CardHover")
	end)
	table.insert(refreshers, show)
end

----------------------------------------------------------------------------
-- Key binding rows
----------------------------------------------------------------------------
local function setBind(device, actionId, keyName)
	local binds = ClientState.Settings.Binds or {}
	binds = { Keyboard = table.clone(binds.Keyboard or {}), Gamepad = table.clone(binds.Gamepad or {}) }
	binds[device][actionId] = keyName
	ClientState.SetSetting("Binds", binds)
end

local function bindRow(parent, order, device, action)
	local row = Theme.new("Frame", {
		Size = UDim2.new(1, -8, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	Theme.label({
		Size = UDim2.new(0.6, 0, 1, 0),
		Text = action.Name,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = row,
	})
	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(150, 30),
		TextSize = 14,
		BackgroundColor3 = Palette.UIPanelLight,
		TextColor3 = Palette.UIText,
		Parent = row,
	})
	button.Activated:Connect(function()
		-- (ReadyAt: ignore the very button press that started the rebind)
		capturing = { Device = device, Action = action.Id, Button = button, ReadyAt = os.clock() + 0.15 }
		button.Text = device == "Gamepad" and "PRESS A BUTTON..." or "PRESS A KEY..."
		button.BackgroundColor3 = Palette.UIAccent
		button.TextColor3 = Palette.UIBackground
		Sfx.Play("CardHover")
	end)
	table.insert(refreshers, function()
		if capturing and capturing.Button == button then
			return
		end
		button.Text = Keybinds.Label(Keybinds.Get(action.Id, device))
		button.BackgroundColor3 = Palette.UIPanelLight
		button.TextColor3 = Palette.UIText
	end)
end

local function refreshAll()
	for _, fn in ipairs(refreshers) do
		fn(ClientState.Settings)
	end
end

-- Finishes a rebind with the pressed input (called from InputBegan).
local function tryCapture(input)
	if not capturing then
		return false
	end
	if os.clock() < (capturing.ReadyAt or 0) then
		return true
	end
	if input.KeyCode == Enum.KeyCode.Escape then
		capturing = nil
		refreshAll()
		return true
	end
	local name = Keybinds.InputName(input)
	local isPad = Keybinds.IsGamepad(input)
	local wantPad = capturing.Device == "Gamepad"
	if name == "Unknown" or name == "Thumbstick1" or name == "Thumbstick2" or isPad ~= wantPad then
		return true -- wrong kind of input: keep waiting
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.MouseWheel then
		return true
	end
	local device = capturing.Device
	local action = capturing.Action
	capturing = nil
	setBind(device, action, name)
	Sfx.Play("CardPick", { Volume = 0.5 })
	return true
end

----------------------------------------------------------------------------
-- Tabs + panel
----------------------------------------------------------------------------
local function makePage(name)
	local page = Theme.new("ScrollingFrame", {
		Name = name,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -110),
		BackgroundTransparency = 1,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Palette.UISubText,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = panel,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	pages[name] = page
	return page
end

local function showTab(name)
	for tabName, page in pairs(pages) do
		page.Visible = tabName == name
		local button = tabButtons[tabName]
		button.BackgroundColor3 = tabName == name and Palette.UIAccent or Palette.UIPanelLight
		button.TextColor3 = tabName == name and Palette.UIBackground or Palette.UIText
	end
end

function SettingsMenu.Open()
	if isOpen then
		return
	end
	isOpen = true
	gui.Enabled = true
	unlocker.Visible = true
	ClientState.SetMenu("Settings", true)
	refreshAll()
	local scale = Theme.scaleOf(panel)
	scale.Scale = 0.92
	Theme.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end

function SettingsMenu.Close()
	if not isOpen then
		return
	end
	isOpen = false
	capturing = nil
	gui.Enabled = false
	unlocker.Visible = false
	ClientState.SetMenu("Settings", false)
	ClientState.SaveSettings()
end

function SettingsMenu.IsOpen()
	return isOpen
end

function SettingsMenu.Toggle()
	if isOpen then
		SettingsMenu.Close()
	else
		SettingsMenu.Open()
	end
end

function SettingsMenu.Init() end

function SettingsMenu.Start(playerGui)
	gui = Theme.screen("Settings", 10, playerGui)
	gui.Enabled = false
	pages, tabButtons = {}, {}

	Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.45,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)

	panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(PANEL_W, PANEL_H),
		BackgroundTransparency = 0,
		Parent = gui,
	})
	Theme.padding(panel, 20)

	Theme.label({
		Size = UDim2.new(0.5, 0, 0, 34),
		Text = "SETTINGS",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})

	-- tabs
	local tabs = Theme.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(330, 34),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 6),
		}),
	})
	for i, name in ipairs({ "GENERAL", "KEYBOARD", "CONTROLLER" }) do
		local button = Theme.button({
			Size = UDim2.fromOffset(i == 1 and 96 or 108, 32),
			Text = name,
			TextSize = 13,
			LayoutOrder = i,
			Parent = tabs,
		})
		tabButtons[name] = button
		button.Activated:Connect(function()
			capturing = nil
			refreshAll()
			showTab(name)
			Sfx.Play("CardHover")
		end)
	end

	-- GENERAL
	local general = makePage("GENERAL")
	sectionTitle(general, 1, "MOUSE")
	slider(general, 2, "Sensitivity", "Mouse sensitivity")
	slider(general, 3, "ScopedSensitivity", "Scoped mouse sensitivity")
	sectionTitle(general, 4, "CONTROLLER")
	slider(general, 5, "ControllerSensitivity", "Controller sensitivity")
	slider(general, 6, "ControllerScopedSensitivity", "Scoped controller sensitivity")
	slider(general, 7, "ControllerDeadzone", "Stick deadzone")
	toggle(general, 8, "InvertY", "Invert look (Y)", { "ON", "OFF" })
	toggle(general, 9, "AimAssist", "Aim assist", { "ON", "OFF" })
	sectionTitle(general, 10, "TOUCH")
	slider(general, 11, "TouchSensitivity", "Touch sensitivity")
	slider(general, 12, "TouchScopedSensitivity", "Scoped touch sensitivity")
	sectionTitle(general, 13, "GAME")
	slider(general, 14, "FieldOfView", "Field of view", 0)
	toggle(general, 15, "ToggleScope", "Scope mode", { "TOGGLE", "HOLD" })

	-- KEYBOARD / CONTROLLER
	local keyboard = makePage("KEYBOARD")
	local controller = makePage("CONTROLLER")
	for i, action in ipairs(Keybinds.Actions) do
		bindRow(keyboard, i, "Keyboard", action)
		bindRow(controller, i, "Gamepad", action)
	end
	Theme.label({
		Size = UDim2.new(1, -8, 0, 20),
		Text = "Move with WASD / left stick and look with the mouse / right stick (not rebindable).",
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UISubText,
		LayoutOrder = 99,
		Parent = keyboard,
	})

	-- bottom buttons
	local reset = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(180, 40),
		Text = "RESET DEFAULTS",
		TextSize = 14,
		BackgroundColor3 = Palette.UIPanelLight,
		TextColor3 = Palette.UIText,
		Parent = panel,
	})
	reset.Activated:Connect(function()
		capturing = nil
		for key, value in pairs(Config.SettingsDefaults) do
			ClientState.Settings[key] = value
		end
		ClientState.SetSetting("Binds", { Keyboard = {}, Gamepad = {} })
		Theme.pop(reset)
	end)
	local done = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(160, 40),
		Text = "DONE",
		Parent = panel,
	})
	done.Activated:Connect(SettingsMenu.Close)

	showTab("GENERAL")
	refreshAll()
	ClientState.SettingsChanged:Connect(refreshAll)

	-- shrink the panel on small screens
	local scale = Theme.scaleOf(panel)
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.min(1, (viewport.X - 30) / PANEL_W, (viewport.Y - 30) / PANEL_H)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	UserInputService.InputBegan:Connect(function(input, processed)
		if isOpen and tryCapture(input) then
			return
		end
		if processed and UserInputService:GetFocusedTextBox() then
			return -- typing in chat
		end
		if Keybinds.Matches("Settings", input) then
			SettingsMenu.Toggle()
		elseif input.KeyCode == Enum.KeyCode.Escape and isOpen then
			SettingsMenu.Close()
		end
	end)
	-- on-screen Settings button (mobile)
	Keybinds.VirtualBegan:Connect(function(input)
		if Keybinds.Matches("Settings", input) then
			SettingsMenu.Toggle()
		end
	end)
end

return SettingsMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme.lua  (Client.ui.Theme)
	Shared UI helpers so every screen looks the same:
	flat colours from Config.Palette, rounded corners, one clean font.
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Theme = {}
Theme.Palette = Config.Palette

function Theme.Font(weight)
	return Font.new(Config.UI.FontFamily, weight or Enum.FontWeight.Medium)
end

-- Creates an instance with properties and children:
-- Theme.new("Frame", { Size = ..., Parent = ... }, { child1, child2 })
function Theme.new(className, props, children)
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	local parent
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end

function Theme.corner(parent, radius)
	return Theme.new("UICorner", {
		CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius or Config.UI.CornerRadius),
		Parent = parent,
	})
end

function Theme.stroke(parent, color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Theme.padding(parent, px)
	return Theme.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = Config.Palette.UIText,
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		TextSize = 18,
		Text = "",
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return Theme.new("TextLabel", defaults)
end

function Theme.panel(props)
	local defaults = {
		BackgroundColor3 = Config.Palette.UIPanel,
		BackgroundTransparency = 0.08,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local frame = Theme.new("Frame", defaults)
	Theme.corner(frame)
	return frame
end

function Theme.button(props)
	local defaults = {
		BackgroundColor3 = Config.Palette.UIAccent,
		TextColor3 = Config.Palette.UIBackground,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		TextSize = 20,
		AutoButtonColor = true,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local button = Theme.new("TextButton", defaults)
	Theme.corner(button)
	return button
end

function Theme.tween(inst, time, goals, style, direction)
	local tween = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goals
	)
	tween:Play()
	return tween
end

-- Returns the UIScale of a GUI object (creates one if needed).
function Theme.scaleOf(inst)
	local scale = inst:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Theme.new("UIScale", { Parent = inst })
	end
	return scale
end

-- Quick "pop" animation (grow a little, spring back).
function Theme.pop(inst, amount)
	local scale = Theme.scaleOf(inst)
	scale.Scale = 1 + (amount or 0.12)
	Theme.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

--[[
	UI particle burst: `count` little flat squares fly out from `center`
	(absolute screen position, Vector2) inside `parent`, then fade away.
]]
function Theme.burst(parent, center, color, count, distance, size)
	count = count or 14
	distance = distance or 140
	size = size or 8
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + math.random() * 0.4
		local reach = distance * (0.55 + math.random() * 0.6)
		local bit = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X, center.Y),
			Size = UDim2.fromOffset(size, size),
			Rotation = math.random(0, 90),
			BackgroundColor3 = color,
			ZIndex = 20,
			Parent = parent,
		})
		Theme.corner(bit, 2)
		local target = center + Vector2.new(math.cos(angle), math.sin(angle)) * reach
		local time = 0.5 + math.random() * 0.35
		Theme.tween(bit, time, {
			Position = UDim2.fromOffset(target.X, target.Y),
			Size = UDim2.fromOffset(2, 2),
			Rotation = bit.Rotation + math.random(-180, 180),
			BackgroundTransparency = 1,
		}, Enum.EasingStyle.Quint)
		task.delay(time + 0.05, function()
			bit:Destroy()
		end)
	end
end

-- An expanding ring (UI shockwave) at an absolute screen position.
function Theme.ring(parent, center, color, size, thickness)
	local ring = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(center.X, center.Y),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		ZIndex = 19,
		Parent = parent,
	})
	Theme.corner(ring, UDim.new(0.5, 0))
	local stroke = Theme.stroke(ring, color, thickness or 6, 0)
	Theme.tween(ring, 0.55, { Size = UDim2.fromOffset(size, size) }, Enum.EasingStyle.Quint)
	Theme.tween(stroke, 0.55, { Transparency = 1, Thickness = 1 })
	task.delay(0.6, function()
		ring:Destroy()
	end)
end

-- A diagonal white shine that sweeps across `inst` once (or forever).
function Theme.shine(inst, duration, loop, strength)
	local band = Theme.new("Frame", {
		Name = "Shine",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 8,
		Parent = inst,
	})
	local corner = inst:FindFirstChildOfClass("UICorner")
	if corner then
		Theme.corner(band, corner.CornerRadius)
	end
	local peak = 1 - (strength or 0.45)
	local gradient = Theme.new("UIGradient", {
		Rotation = 25,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 1),
			NumberSequenceKeypoint.new(0.5, peak),
			NumberSequenceKeypoint.new(0.6, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Offset = Vector2.new(-1, 0),
		Parent = band,
	})
	local tween = TweenService:Create(
		gradient,
		TweenInfo.new(duration or 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, loop and -1 or 0, false, loop and 0.9 or 0),
		{ Offset = Vector2.new(1, 0) }
	)
	tween:Play()
	if not loop then
		task.delay((duration or 0.8) + 0.05, function()
			band:Destroy()
		end)
	end
	return band, tween
end

-- A ScreenGui that ignores the top bar inset and survives respawns.
function Theme.screen(name, displayOrder, parent)
	return Theme.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		Parent = parent,
	})
end

-- An invisible button with Modal = true: while it's visible, Roblox frees
-- the mouse even in first person. Toggle `.Visible` to lock/unlock.
function Theme.mouseUnlocker(parent)
	return Theme.new("TextButton", {
		Name = "MouseUnlock",
		Modal = true,
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromOffset(0, 0),
		Visible = false,
		Parent = parent,
	})
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Toast</string>
              <string name="Source"><![CDATA[--[[
	Toast.lua  (Client.ui.Toast)

	Small message that slides in at the top of the screen for a few seconds
	(server "Notify" remote: admin command results, e.g. "BOT MATCH - HARD").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)

local Palette = Config.Palette

local Toast = {}

local gui, holder
local SHOW_TIME = 3

function Toast.Show(text)
	local card = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Palette.UIPanel,
		Parent = holder,
	})
	Theme.stroke(card, Palette.UIAccent, 2, 0.2)
	Theme.new("UIPadding", {
		PaddingLeft = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 18),
		Parent = card,
	})
	local label = Theme.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = string.upper(tostring(text)),
		TextSize = 17,
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		Parent = card,
	})
	local scale = Theme.scaleOf(card)
	scale.Scale = 0.6
	card.BackgroundTransparency = 1
	label.TextTransparency = 1
	Theme.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Theme.tween(card, 0.2, { BackgroundTransparency = 0 })
	Theme.tween(label, 0.2, { TextTransparency = 0 })
	Sfx.Play("CardPick", { Volume = 0.4, Pitch = 1.3 })

	task.delay(SHOW_TIME, function()
		Theme.tween(scale, 0.25, { Scale = 0.8 })
		Theme.tween(card, 0.25, { BackgroundTransparency = 1 })
		Theme.tween(label, 0.25, { TextTransparency = 1 })
		task.wait(0.3)
		card:Destroy()
	end)
end

function Toast.Start(playerGui)
	gui = Theme.screen("Toast", 50, playerGui)
	holder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.fromOffset(600, 200),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.new("UIListLayout", {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = holder,
	})
	Remotes.Get("Notify").OnClientEvent:Connect(Toast.Show)
end

return Toast
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">VictoryScreen</string>
              <string name="Source"><![CDATA[--[[
	VictoryScreen.lua  (Client.ui.VictoryScreen)
	Shown when a player reaches 4 round wins: VICTORY / DEFEAT, the final
	score, and the power-ups each player ended with. Then back to the lobby.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Palette = Config.Palette
local player = Players.LocalPlayer

local VictoryScreen = {}

local gui, overlay, title, scoreLabel, messageLabel, columns, footer, unlocker
local isOpen = false

local function buildColumn(entry, slot)
	local column = Theme.panel({
		Size = UDim2.fromOffset(300, 300),
		LayoutOrder = slot,
		Parent = columns,
	})
	Theme.padding(column, 14)
	Theme.stroke(column, ClientState.GetSlotColor(slot), 2, 0)
	Theme.label({
		Size = UDim2.new(1, 0, 0, 26),
		Text = entry.Name .. "  -  " .. tostring(entry.Wins),
		TextSize = 20,
		TextColor3 = ClientState.GetSlotColor(slot),
		Parent = column,
	})
	local grid = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 1, -36),
		BackgroundTransparency = 1,
		Parent = column,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(130, 26),
			CellPadding = UDim2.fromOffset(8, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local count = 0
	for _, def in ipairs(PowerUps.Definitions) do
		local stacks = entry.PowerUps[def.Id]
		if stacks and stacks > 0 then
			count += 1
			local cell = Theme.new("Frame", { BackgroundTransparency = 1, LayoutOrder = count, Parent = grid })
			local icon = Icons.Create(def, 26)
			icon.Parent = cell
			Theme.label({
				Position = UDim2.fromOffset(32, 0),
				Size = UDim2.new(1, -32, 1, 0),
				Text = def.Name .. (stacks > 1 and (" x" .. stacks) or ""),
				TextSize = 12,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = Config.Rarity[def.Rarity].Color,
				Parent = cell,
			})
		end
	end
	if count == 0 then
		Theme.label({ Text = "No power-ups", TextSize = 14, TextColor3 = Palette.UISubText, Parent = grid })
	end
end

local function open(snapshot)
	isOpen = true
	gui.Enabled = true
	unlocker.Visible = true
	ClientState.SetMenu("Victory", true)

	local won = snapshot.MatchWinnerUserId == player.UserId
	title.Text = won and "VICTORY" or "DEFEAT"
	title.TextColor3 = won and Palette.UIAccent or Palette.UIDanger
	title.TextSize = 140
	Theme.tween(title, 0.5, { TextSize = 96 }, Enum.EasingStyle.Back)
	Sfx.Play(won and "Victory" or "Hurt", { Pitch = won and 1 or 0.6 })

	local me, opp = ClientState.GetMe(), ClientState.GetOpponentEntry()
	scoreLabel.Text = (me and opp) and ("%d  -  %d"):format(me.Wins, opp.Wins) or ""
	messageLabel.Text = snapshot.Message or ""

	for _, child in ipairs(columns:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for slot, entry in ipairs(snapshot.Players or {}) do
		buildColumn(entry, slot)
	end
	overlay.BackgroundTransparency = 1
	Theme.tween(overlay, 0.4, { BackgroundTransparency = 0.15 })
	-- columns slide up, then confetti / embers
	columns.Position = UDim2.new(0.5, 0, 0.1, 260)
	Theme.tween(columns, 0.6, { Position = UDim2.new(0.5, 0, 0.1, 210) }, Enum.EasingStyle.Quint)
	task.spawn(function()
		local viewport = workspace.CurrentCamera.ViewportSize
		local colors = won and { Palette.UIAccent, Palette.AccentB, Palette.PlayerA, Palette.PlayerB, Color3.new(1, 1, 1) }
			or { Palette.UIDanger, Palette.UIPanelLight }
		for i = 1, won and 10 or 4 do
			if not isOpen then
				break
			end
			local x = viewport.X * (0.15 + math.random() * 0.7)
			local y = viewport.Y * (0.12 + math.random() * 0.25)
			Theme.burst(gui, Vector2.new(x, y), colors[(i % #colors) + 1], 16, 220, 9)
			task.wait(0.18)
		end
	end)
end

local function close()
	if not isOpen then
		return
	end
	isOpen = false
	gui.Enabled = false
	unlocker.Visible = false
	ClientState.SetMenu("Victory", false)
end

function VictoryScreen.OnState(snapshot)
	if snapshot.InMatch and snapshot.Phase == "Victory" then
		if not isOpen then
			open(snapshot)
		end
	else
		close()
	end
end

function VictoryScreen.Init() end

function VictoryScreen.Start(playerGui)
	gui = Theme.screen("Victory", 8, playerGui)
	gui.Enabled = false
	overlay = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.15,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)

	title = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.1),
		Size = UDim2.fromOffset(800, 110),
		TextSize = 96,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = overlay,
	})
	scoreLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 112),
		Size = UDim2.fromOffset(400, 50),
		TextSize = 44,
		Parent = overlay,
	})
	messageLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 164),
		Size = UDim2.fromOffset(600, 24),
		TextSize = 16,
		TextColor3 = Palette.UISubText,
		Parent = overlay,
	})
	columns = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 210),
		Size = UDim2.fromOffset(640, 310),
		BackgroundTransparency = 1,
		Parent = overlay,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 24),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	footer = Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(400, 22),
		TextSize = 16,
		TextColor3 = Palette.UISubText,
		Parent = overlay,
	})

	RunService.RenderStepped:Connect(function()
		if isOpen then
			local left = ClientState.TimeLeft()
			footer.Text = left and ("Returning to lobby in %d..."):format(math.ceil(left)) or ""
		end
	end)
end

return VictoryScreen
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>