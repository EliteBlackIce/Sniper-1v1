    </Item>
    <Item class="StarterPlayerScripts" referent="43">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">AimAssist</string>
            <string name="Source"><![CDATA[--[[
	AimAssist.lua  (Client.AimAssist)

	Light aim assist for CONTROLLER players only (mouse users never get it).
	Two small effects, both only when the crosshair is already close to a
	target you can actually see:

	  1. Slowdown: your aim turns a bit slower while it's over / near the
	     target, so it's easier to stay on them.
	  2. Gentle pull: while you're moving or using the right stick, the aim
	     drifts slightly toward the target's body (never the head, so
	     headshots still take skill). Standing still with no input = no pull.

	Targets: the enemy in a match (not while invisible), the practice
	dummies in the lobby / playground. All numbers are in Config.AimAssist,
	and players can turn it off in the settings menu.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local ClientState = require(script.Parent.ClientState)

local A = Config.AimAssist
local player = Players.LocalPlayer

local AimAssist = {}

local rightStick = Vector2.zero
local lastLook -- our look direction at the end of last frame

-- Controller and touch players get the assist (mouse players never do).
local function usingController()
	local last = UserInputService:GetLastInputType()
	return last.Name:find("Gamepad") ~= nil or last == Enum.UserInputType.Touch
end

-- Points we may assist toward: the enemy's torso, or the dummies' torsos.
local function getTargets()
	local list = {}
	if ClientState.InMatch() then
		if not ClientState.IsFighting() then
			return list
		end
		local opponent = ClientState.GetOpponentPlayer()
		local character = opponent and opponent.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 and not character:GetAttribute("Invisible") then
			local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
			if torso then
				table.insert(list, { Point = torso.Position, Model = character })
			end
		end
	else
		local folder = workspace:FindFirstChild("Dummies")
		for _, dummy in ipairs(folder and folder:GetChildren() or {}) do
			local torso = dummy:FindFirstChild("UpperTorso")
			if torso and not dummy:GetAttribute("Down") then
				table.insert(list, { Point = torso.Position, Model = dummy })
			end
		end
	end
	return list
end

local function canSee(origin, target)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { workspace.CurrentCamera, target.Model }
	if player.Character then
		table.insert(exclude, player.Character)
	end
	for _, name in ipairs({ "Effects", "Decoys" }) do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(exclude, f)
		end
	end
	params.FilterDescendantsInstances = exclude
	return workspace:Raycast(origin, target.Point - origin, params) == nil
end

-- Angle in radians between two unit vectors.
local function angleBetween(a, b)
	return math.acos(math.clamp(a:Dot(b), -1, 1))
end

-- Rotates unit vector `from` toward `to` by at most `maxAngle` radians.
local function rotateToward(from, to, maxAngle)
	local angle = angleBetween(from, to)
	if angle < 1e-5 then
		return from
	end
	local t = math.min(1, maxAngle / angle)
	return from:Lerp(to, t).Unit
end

--[[
	Called by the CameraController every frame AFTER Roblox's camera has
	applied this frame's stick input and BEFORE recoil / roll.
	scopeAlpha: 0 = hip fire, 1 = fully scoped.
]]
function AimAssist.Update(camera, dt, scopeAlpha)
	local look = camera.CFrame.LookVector
	local enabled = A.Enabled
		and ClientState.Settings.AimAssist ~= false
		and usingController()
		and not ClientState.MenuOpen
		and ClientState.HasGun()
	if not enabled then
		lastLook = look
		return
	end

	local origin = camera.CFrame.Position
	-- the assist cone shrinks with the field of view (smaller when scoped)
	local cone = math.rad(A.ConeDegrees) * (camera.FieldOfView / Config.Camera.BaseFOV)

	-- closest visible target inside the cone
	local best, bestAngle, bestDir
	for _, target in ipairs(getTargets()) do
		local toTarget = target.Point - origin
		local distance = toTarget.Magnitude
		if distance > 1 and distance <= A.Range then
			local dir = toTarget / distance
			local angle = angleBetween(look, dir)
			if angle <= cone and (not best or angle < bestAngle) and canSee(origin, target) then
				best, bestAngle, bestDir = target, angle, dir
			end
		end
	end

	if best then
		local closeness = 1 - bestAngle / cone -- 1 = dead centre, 0 = edge of the cone

		-- 1) SLOWDOWN: undo part of this frame's turn while near the target
		if lastLook then
			local slow = A.Slowdown * closeness
			local turned = angleBetween(lastLook, look)
			if turned > 1e-5 and slow > 0 then
				look = rotateToward(look, lastLook, turned * slow)
			end
		end

		-- 2) PULL: a gentle drift toward the body, only while you're moving
		--    or actively aiming (never when idle)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local moving = humanoid and humanoid.MoveDirection.Magnitude > 0.1
		local aiming = rightStick.Magnitude > 0.15
		if moving or aiming then
			local strength = math.rad(A.PullDegreesPerSecond) * closeness * dt
			if scopeAlpha > 0.5 then
				strength *= A.ScopedPullMultiplier
			end
			look = rotateToward(look, bestDir, strength)
		end

		camera.CFrame = CFrame.lookAt(origin, origin + look)
	end
	lastLook = look
end

function AimAssist.Start()
	UserInputService.InputChanged:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			rightStick = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
end

return AimAssist
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">BodyAnimator</string>
            <string name="Source"><![CDATA[--[[
	BodyAnimator.lua  (Client.BodyAnimator)

	Your real character holds and animates the weapons: everyone else sees
	every move on your whole character. In first person you see slim copies
	of your own arms and weapon playing the same animation
	(FirstPersonView), so your full-size arms don't fill the screen.

	Every frame (RunService.Stepped, right after Roblox's walk / run
	animations) for every character near you:
	  1. work out where its eyes are and where it's looking
	       you            the camera (first person)
	       other players  their head + the "AimPitch" they send (smoothed)
	  2. WeaponAnim says where the weapon, the hands and the body go
	  3. BodyRig twists the torso, bends the real arms (IK) and puts the
	     weapon (jointed to the right hand) exactly in place
	Other players' shots, knife swings, inspects and weapon switches come in
	as character attributes (set by the server), so everyone plays the same
	moves at the same time.

	This module also keeps the old Controllers.Viewmodel API (PlayFire,
	PlayBolt, SetWeapon, PlayKnife, GetMuzzlePosition, SetHidden...).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GunModel = require(Shared.GunModel)
local KnifeModel = require(Shared.KnifeModel)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local ClientState = require(script.Parent.ClientState)
local Spring = require(script.Parent.Spring)
local Sfx = require(script.Parent.Sfx)
local Keybinds = require(script.Parent.Keybinds)
local WeaponAnim = require(script.Parent.WeaponAnim)
local BodyRig = require(script.Parent.BodyRig)
local FirstPersonView = require(script.Parent.FirstPersonView)

local B = Config.Body
local VM = Config.Viewmodel
local player = Players.LocalPlayer
local rad = math.rad

local BodyAnimator = {}
local Controllers

local entries = setmetatable({}, { __mode = "k" }) -- [character] = entry
local warnedRig = setmetatable({}, { __mode = "k" })
local warnedErrors = {} -- each error message once (not every frame)
local extra = {} -- extra models to animate (the kill cam's copy of you)
local hiddenBy = {} -- [reason] = true: hide your first-person arms + weapon
local localState = WeaponAnim.New()
local puppet -- { Character, State } while the kill cam plays through someone's eyes

-- Roblox's first-person camera sits 0.5 studs behind the head (its minimum
-- zoom), plus Config.Body.CameraBack; the eyes are that far in front of it.
local EYE_BACK = 0.5 + (B.CameraBack or 0)
BodyAnimator.EyeBack = EYE_BACK

local swaySpring = Spring.new(140, 16)
local bobTime, sprintAlpha = 0, 0
local lastScoped = false

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------
local function now()
	return os.clock()
end

local function getEntry(model)
	local entry = entries[model]
	if entry then
		return entry
	end
	local rig, why = BodyRig.Find(model)
	if not rig then
		if model == player.Character and not warnedRig[model] then
			warnedRig[model] = true
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			warn(("[BodyAnimator] can't animate your character (%s, rig type %s). Make sure Game Settings > Avatar is set to R15."):format(
				tostring(why),
				humanoid and humanoid.RigType.Name or "?"
			))
		end
		return nil
	end
	if model == player.Character then
		print(("[BodyAnimator] animating your character (%s joints)"):format(rig.Kind))
	end
	entry = { Rig = rig, State = WeaponAnim.New(), Pitch = 0, Seen = {}, Weapons = {} }
	entry.State.EquipStart = -10
	entries[model] = entry
	return entry
end

local function weaponFor(entry, name)
	local cached = entry.Weapons[name]
	if cached and cached.Model.Parent and cached.Root.Parent then
		return cached
	end
	cached = BodyRig.FindWeapon(entry.Rig, name)
	entry.Weapons[name] = cached
	return cached
end

local function profileFor(entry)
	local gun = weaponFor(entry, "WorldGun")
	local kind = gun and gun.Root:GetAttribute("Profile")
	return kind == "Mesh" and GunModel.MeshProfile or GunModel.PartsProfile
end

local function stateFor(model)
	if puppet and model == puppet.Character then
		return puppet.State
	end
	if model == player.Character then
		return localState
	end
	local entry = entries[model]
	return entry and entry.State
end

-- The state the API calls act on: the kill cam's puppet, or you.
local function activeState()
	return puppet and puppet.State or localState
end

-- Shots, swings, inspects and switches of OTHER characters, from attributes.
local function syncEvents(entry, model, t)
	local state = entry.State
	local seen = entry.Seen
	local weapon = model:GetAttribute("Weapon") or "Sniper"
	if seen.Weapon == nil then
		state.Weapon = weapon == "Knife" and "Knife" or "Sniper"
	elseif weapon ~= seen.Weapon then
		WeaponAnim.SetWeapon(state, weapon, t)
	end
	seen.Weapon = weapon

	local swing = model:GetAttribute("Swing")
	if seen.Swing ~= nil and swing ~= seen.Swing and state.Weapon == "Knife" then
		local kind = model:GetAttribute("SwingKind") or "Slash"
		WeaponAnim.Knife(state, kind, t, (swing or 0) % 2 == 0 and 1 or -1)
	end
	seen.Swing = swing

	local shot = model:GetAttribute("Shot")
	if seen.Shot ~= nil and shot ~= seen.Shot then
		WeaponAnim.Fire(state, t)
		local bolt = model:GetAttribute("BoltTime") or 1
		WeaponAnim.Bolt(state, t + 0.12, math.max(bolt - 0.12, 0.2))
	end
	seen.Shot = shot

	local inspect = model:GetAttribute("Inspect")
	if seen.Inspect ~= nil and inspect ~= seen.Inspect then
		WeaponAnim.Inspect(state, t, model:GetAttribute("InspectVariant"))
	end
	seen.Inspect = inspect
end

-- Eyes looking the way a character's root faces, pitched by its aim.
local function headView(rig, pitch)
	local root = rig.Root.CFrame
	local look = root.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	return CFrame.new(root.Position + root.UpVector * 1.5) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

local function isAlive(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

----------------------------------------------------------------------------
-- Per frame: pose every character
----------------------------------------------------------------------------
local function animate(model, dt, t, camera)
	local entry = getEntry(model)
	if not entry then
		return
	end
	local rig = entry.Rig
	local isLocal = model == player.Character
	local isPuppet = puppet ~= nil and model == puppet.Character
	local state = stateFor(model)
	if not isLocal and not isPuppet then
		syncEvents(entry, model, t)
	end

	local view, pitch
	local ctx = { Profile = profileFor(entry) }
	local firstPerson = isLocal and Controllers.Camera.IsFirstPerson() and not puppet
	if firstPerson or isPuppet then
		local cam = camera.CFrame
		pitch = math.asin(math.clamp(cam.LookVector.Y, -1, 1))
		view = cam * CFrame.new(0, 0, -EYE_BACK) -- the eyes, in front of the camera
		if firstPerson then
			-- face exactly where you look (before physics, so arms and camera agree);
			-- not while frozen or while a cutscene owns the camera
			local root = rig.Root
			local look = Util.flat(cam.LookVector)
			local free = not root.Anchored and not model:GetAttribute("Frozen") and camera.CameraType == Enum.CameraType.Custom
			if look.Magnitude > 0.05 and free then
				root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
			end
			ctx.Sprint = sprintAlpha
			ctx.Scope = Controllers.Weapon.GetScopeAlpha()
		end
	else
		-- seen from outside: the aim they send, smoothed
		local target = model:GetAttribute("AimPitch") or 0
		entry.Pitch = Util.lerp(entry.Pitch, target, Util.smooth(B.PitchSmoothing, dt))
		pitch = entry.Pitch
		view = headView(rig, pitch) * B.ThirdPersonOffset
		local vel = rig.Root.AssemblyLinearVelocity
		local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
		entry.Sprint = Util.lerp(entry.Sprint or 0, speed > Config.Movement.RunSpeed * 1.08 and 1 or 0, Util.smooth(6, dt))
		ctx.Sprint = entry.Sprint
		ctx.Scope = model:GetAttribute("Scoped") and 1 or 0
	end

	local anim = WeaponAnim.Evaluate(state, t, ctx)
	local weapon = weaponFor(entry, state.Weapon == "Knife" and "WorldKnife" or "WorldGun")
	BodyRig.Solve(rig, view, anim, { Pitch = pitch, Weapon = weapon })
end

local function step(dt)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local t = now()
	for model in pairs(entries) do
		if not model.Parent then
			entries[model] = nil -- (the entry points back at its model, so it'd never be collected)
		end
	end
	local done = {}
	local function try(model)
		if not model or done[model] or not model.Parent then
			return
		end
		done[model] = true
		if not isAlive(model) and not extra[model] then
			return
		end
		local root = model:FindFirstChild("HumanoidRootPart")
		if not root or (root.Position - camera.CFrame.Position).Magnitude > B.MaxDistance then
			return
		end
		local ok, err = pcall(animate, model, dt, t, camera)
		if not ok and not warnedErrors[err] then
			warnedErrors[err] = true
			warn("[BodyAnimator] " .. tostring(err))
		end
	end
	for _, other in ipairs(Players:GetPlayers()) do
		try(other.Character)
	end
	local opponent = ClientState.Snapshot.InMatch and ClientState.GetOpponentPlayer()
	if typeof(opponent) == "table" then
		try(opponent.Character) -- a bot
	end
	for model in pairs(extra) do
		try(model)
	end
end

-- Your real arms and weapon are hidden in first person (Roblox hides your
-- character there anyway); the kill cam's copy of your killer too, while
-- you watch through its eyes. You see FirstPersonView's copies instead.
local ARM_PARTS = { "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperArm", "LeftLowerArm", "LeftHand" }
local weaponParts = setmetatable({}, { __mode = "k" }) -- [weapon model] = its parts
local function weaponCache(weapon)
	local cache = weaponParts[weapon]
	if not cache then
		cache = { Parts = {}, Fx = {} }
		for _, item in ipairs(weapon:GetDescendants()) do
			if item:IsA("BasePart") then
				table.insert(cache.Parts, item)
			elseif item:IsA("ParticleEmitter") or item:IsA("Light") then
				table.insert(cache.Fx, item) -- (sparkles / glow: hidden parts don't hide these)
			end
		end
		weaponParts[weapon] = cache
	end
	return cache
end

local realHidden = false -- your real weapons' particles are switched off (first person)

local function hideReal(model)
	for _, name in ipairs(ARM_PARTS) do
		local part = model:FindFirstChild(name)
		if part then
			part.LocalTransparencyModifier = 1
		end
	end
	local state = stateFor(model)
	local weaponName = state and state.Weapon == "Knife" and "WorldKnife" or "WorldGun"
	local isCopy = puppet ~= nil and model == puppet.Character -- (a local copy: we may set Transparency)
	for _, name in ipairs({ "WorldGun", "WorldKnife" }) do
		local weapon = model:FindFirstChild(name)
		if weapon then
			local cache = weaponCache(weapon)
			local held = name == weaponName
			for _, part in ipairs(cache.Parts) do
				part.LocalTransparencyModifier = 1
				if isCopy then
					part.Transparency = held and (part:GetAttribute("BaseTransparency") or 0) or 1
				end
			end
			for _, fx in ipairs(cache.Fx) do
				if fx.Enabled then
					fx.Enabled = false
				end
			end
		end
	end
	if model == player.Character then
		realHidden = true
	end
end

-- Back out of first person: your real weapon's particles on again (the held one).
local function showRealFx(model)
	realHidden = false
	local knifeOut = model:GetAttribute("Weapon") == "Knife"
	for name, held in pairs({ WorldGun = not knifeOut, WorldKnife = knifeOut }) do
		local weapon = model:FindFirstChild(name)
		if weapon then
			for _, fx in ipairs(weaponCache(weapon).Fx) do
				fx.Enabled = held and not model:GetAttribute("Invisible")
			end
		end
	end
end

-- Sway (the weapon lags behind the mouse) and walk bob, on top of the eyes.
local function swayAndBob(dt)
	local movement = Controllers.Movement
	local delta = UserInputService:GetMouseDelta()
	local scope = Controllers.Weapon.GetScopeAlpha()
	local swayScale = (1 - scope * 0.9) * VM.SwayAmount
	swaySpring.Target = Vector3.new(
		math.clamp(-delta.Y * swayScale, -5, 5),
		math.clamp(-delta.X * swayScale, -5, 5),
		math.clamp(-delta.X * swayScale * 0.7, -4, 4)
	)
	local sway = swaySpring:Update(dt)
	local speed = movement.GetSpeed()
	local running = movement.IsGrounded() and speed > 2 and movement.GetMode() == "Ground"
	if running then
		bobTime += dt * (7 + speed * 0.2)
	end
	local bob = running and math.clamp(speed / Config.Movement.RunSpeed, 0, 1.4) * (1 - scope) * VM.BobAmount or 0
	sprintAlpha = Util.lerp(sprintAlpha, movement.IsSprinting() and scope < 0.1 and 1 or 0, Util.smooth(10, dt))
	return CFrame.new(math.sin(bobTime) * 0.05 * bob, math.sin(bobTime * 2) * 0.035 * bob, 0)
		* CFrame.Angles(rad(sway.X), rad(sway.Y), rad(sway.Z) + math.sin(bobTime) * rad(2) * bob), scope
end

-- Each frame, after the camera: draw the first-person arms + weapon.
local function drawFirstPerson(dt)
	local camera = workspace.CurrentCamera
	local character = player.Character
	local source, state, view
	local ctx = {}
	if puppet and puppet.Character and puppet.Character.Parent then
		hideReal(puppet.Character)
		if next(hiddenBy) == nil then
			source, state = puppet.Character, puppet.State
			view = camera.CFrame * CFrame.new(0, 0, -EYE_BACK)
		end
	elseif character and Controllers.Camera.IsFirstPerson() then
		hideReal(character)
		local offset, scope = swayAndBob(dt)
		if isAlive(character) and next(hiddenBy) == nil and scope < 0.92 and ClientState.HasGun() then
			source, state = character, localState
			view = camera.CFrame * CFrame.new(0, 0, -EYE_BACK) * offset
			ctx.Sprint, ctx.Scope = sprintAlpha, scope
		end
	elseif character and realHidden then
		showRealFx(character)
	end
	local entry = source and getEntry(source)
	if not entry then
		FirstPersonView.Hide()
		return
	end
	ctx.Profile = profileFor(entry)
	local anim = WeaponAnim.Evaluate(state, now(), ctx)
	FirstPersonView.Draw(source, view, anim, anim.Body, state.Weapon == "Knife" and "WorldKnife" or "WorldGun")
end

local function updateVisibility(dt)
	local ok, err = pcall(drawFirstPerson, dt)
	if not ok then
		FirstPersonView.Hide()
		if not warnedErrors[err] then
			warnedErrors[err] = true
			warn("[BodyAnimator] first person: " .. tostring(err))
		end
	end
	-- tell everyone when you're aiming down the scope
	local scoped = Controllers.Weapon.GetScopeAlpha() > 0.5
	if scoped ~= lastScoped then
		lastScoped = scoped
		Remotes.Get("Anim"):FireServer("Scope", scoped)
	end
end

----------------------------------------------------------------------------
-- API (the old Viewmodel API, so everything else keeps working)
----------------------------------------------------------------------------
function BodyAnimator.SetHidden(reason, hidden)
	hiddenBy[reason] = hidden or nil
end

function BodyAnimator.PlayFire()
	WeaponAnim.Fire(activeState(), now())
end

function BodyAnimator.PlayBolt(duration)
	local delay = math.min(0.12, duration * 0.3)
	WeaponAnim.Bolt(activeState(), now() + delay, math.max(duration - delay, 0.15))
end

function BodyAnimator.PlayEquip()
	local state = activeState()
	if state.Weapon ~= "Knife" then
		state.EquipStart = now()
	end
end

function BodyAnimator.PlayKill() end

-- The victory pose on a tracked model (the kill cam's copy of the winner).
function BodyAnimator.PlayVictory(model)
	local entry = getEntry(model)
	if entry then
		entry.State.Weapon = model:GetAttribute("Weapon") == "Knife" and "Knife" or "Sniper"
		WeaponAnim.Victory(entry.State, now())
	end
end

function BodyAnimator.SetWeapon(name)
	local state = activeState()
	if WeaponAnim.SetWeapon(state, name, now()) and not puppet then
		if state.Weapon == "Knife" then
			Sfx.Play("CardPick", { Pitch = 1.15, Volume = 0.7 }) -- unsheathe
			task.delay(0.15, Sfx.Play, "CardFlip", { Pitch = 1.3, Volume = 0.5 }) -- the flip
			task.delay(0.39, Sfx.Play, "Bolt", { Pitch = 1.6, Volume = 0.5 }) -- caught
		else
			Sfx.Play("Bolt", { Pitch = 1.3, Volume = 0.6 })
		end
	end
end

function BodyAnimator.GetWeapon()
	return activeState().Weapon
end

-- "Slash", "Stab" or "Inspect"
function BodyAnimator.PlayKnife(kind)
	local state = activeState()
	local t = now()
	if kind == "Inspect" then
		if WeaponAnim.Inspect(state, t) and not puppet then
			local length = WeaponAnim.Clips.Inspect.Length
			Sfx.Play("CardHover", { Pitch = 0.8, Volume = 1.2 })
			task.delay(length * 0.42, Sfx.Play, "CardFlip", { Pitch = 1.1, Volume = 0.8 }) -- tossed
			task.delay(length * 0.6, Sfx.Play, "Bolt", { Pitch = 1.5, Volume = 0.7 }) -- caught
		end
		return
	end
	WeaponAnim.Knife(state, kind, t)
end

local function weaponRootOf(model, name)
	local weapon = model and model:FindFirstChild(name)
	return weapon and weapon:FindFirstChild("WeaponRoot")
end

function BodyAnimator.GetKnifeTip()
	local tip = FirstPersonView.GetKnifeTip()
	if tip then
		return tip
	end
	local root = weaponRootOf(puppet and puppet.Character or player.Character, "WorldKnife")
	if root then
		return (root.CFrame * CFrame.new(KnifeModel.Tip * Config.Knife.WorldScale)).Position
	end
	return workspace.CurrentCamera.CFrame.Position
end

function BodyAnimator.GetMuzzlePosition()
	local fp = FirstPersonView.GetMuzzle()
	if fp then
		return fp
	end
	local model = puppet and puppet.Character or player.Character
	local gun = model and model:FindFirstChild("WorldGun")
	local barrel = gun and gun:FindFirstChild("Barrel")
	local muzzle = barrel and barrel:FindFirstChild("Muzzle")
	if muzzle then
		return muzzle.WorldPosition
	end
	return workspace.CurrentCamera.CFrame.Position
end

function BodyAnimator.GetLeftHandPosition()
	local fp = FirstPersonView.GetLeftHand()
	if fp then
		return fp
	end
	local hand = player.Character and player.Character:FindFirstChild("LeftHand")
	return hand and hand.Position or workspace.CurrentCamera.CFrame.Position
end

-- Kill cam: play through someone's eyes, their real arms in view.
-- info = { Character = Model, Owned = {...} } or nil to stop.
function BodyAnimator.SetPuppet(info)
	if info and info.Character then
		local state = WeaponAnim.New()
		state.Weapon = info.Character:GetAttribute("Weapon") == "Knife" and "Knife" or "Sniper"
		puppet = { Character = info.Character, State = state }
	else
		puppet = nil
	end
end

function BodyAnimator.SetPuppetSpeed() end

-- Animate an extra model (e.g. the kill cam's copy of you). It reads its
-- "AimPitch" / "Weapon" attributes like any other character.
function BodyAnimator.Track(model)
	extra[model] = true
end

function BodyAnimator.Untrack(model)
	extra[model] = nil
	entries[model] = nil
end

function BodyAnimator.Init(controllers)
	Controllers = controllers
end

function BodyAnimator.Start()
	-- after Roblox's Animator has posed everyone this frame
	RunService.Stepped:Connect(function(_, dt)
		step(dt)
	end)

	-- send where you're looking up / down, so others see your aim (AimPitch)
	task.spawn(function()
		local aim = Remotes.Get("Aim")
		local lastSent = 0
		while true do
			task.wait(0.1)
			local camera = workspace.CurrentCamera
			if camera and player.Character then
				local pitch = math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))
				if math.abs(pitch - lastSent) > 0.03 then
					lastSent = pitch
					aim:FireServer(pitch)
				end
			end
		end
	end)
	-- after the camera (and its first-person hiding) each frame
	RunService:BindToRenderStep("BodyFirstPerson", Enum.RenderPriority.Camera.Value + 5, updateVisibility)

	-- inspect (V): the rifle or the knife; everyone sees it
	local function onInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if Keybinds.Matches("Inspect", input) and not puppet and not ClientState.MenuOpen and ClientState.HasGun() then
			local state = localState
			if state.Weapon == "Knife" then
				BodyAnimator.PlayKnife("Inspect")
				Remotes.Get("Anim"):FireServer("Inspect", "Knife")
			else
				local ok, variant = WeaponAnim.Inspect(state, now())
				if ok then
					Sfx.Play("CardHover", { Pitch = 0.8, Volume = 1.2 })
					if variant == 3 then -- the bolt, eased open and shut
						task.delay(0.6, Sfx.Play, "Bolt", { Pitch = 0.9, Volume = 0.5 })
						task.delay(1.7, Sfx.Play, "Bolt", { Pitch = 1.1, Volume = 0.5 })
					elseif variant == 2 then -- two taps on the scope
						task.delay(1.05, Sfx.Play, "CardFlip", { Pitch = 1.6, Volume = 0.4 })
						task.delay(1.25, Sfx.Play, "CardFlip", { Pitch = 1.7, Volume = 0.4 })
					end
					Remotes.Get("Anim"):FireServer("Inspect", "Rifle", variant)
				end
			end
		end
	end
	UserInputService.InputBegan:Connect(onInput)
	Keybinds.VirtualBegan:Connect(onInput)

	-- a new life: rifle out, equip from the hip
	player.CharacterAdded:Connect(function()
		localState = WeaponAnim.New()
		localState.EquipStart = now()
	end)
end

return BodyAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">BodyRig</string>
            <string name="Source"><![CDATA[--[[
	BodyRig.lua  (Client.BodyRig)

	Bends a real R15 character (the one you spawn in) to hold a weapon: the
	maths only, no RunService, so it also runs in previews.

		local rig = BodyRig.Find(character)        -- nil if it isn't R15
		BodyRig.Solve(rig, view, anim, weights)    -- sets every Motor6D.Transform

	view   = where the eyes are and where they look (CFrame)
	anim   = WeaponAnim.Evaluate output (view-space weapon + hands + body)

	How it works:
	  1. Hips + waist + neck: twist / lean / dip from anim.Body, plus the aim
	     pitch shared between waist and neck.
	  2. Both arms: two-bone IK from the real shoulder to the hand target
	     (elbows bend out and down), then the wrist turns the hand to match.
	     Bone lengths come from the character's own joints, so any R15
	     avatar works.
	  3. The weapon is jointed to the right hand (Motor6D "WeaponGrip" made
	     by the server); its Transform puts it exactly where the animation
	     says, wherever the hand ended up.
	  4. Legs: only during a lunge (anim.Body.Step), blended over the walk.

	Motor6D maths: Part1 = Part0 * C0 * Transform * C1:Inverse().
]]

local BodyRig = {}

local V = Vector3.new
local rad = math.rad

local MOTORS = {
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	RightWrist = "RightHand",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	LeftWrist = "LeftHand",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
}

-- A joint we can pose: a Motor6D as is, or one of Roblox's newer
-- AnimationConstraints (same maths: Part1 = Part0 * Att0 * Transform * Att1:Inverse()).
local function joint(inst)
	if inst:IsA("Motor6D") then
		return inst
	end
	return setmetatable({ Instance = inst }, {
		__index = function(_, key)
			if key == "C0" then
				return inst.Attachment0 and inst.Attachment0.CFrame or CFrame.new()
			elseif key == "C1" then
				return inst.Attachment1 and inst.Attachment1.CFrame or CFrame.new()
			elseif key == "Transform" then
				return inst.Transform
			end
			return nil
		end,
		__newindex = function(_, key, value)
			if key == "Transform" then
				inst.Transform = value
			end
		end,
	})
end

-- Finds the joint called `name` that moves `part`.
local function findJoint(part, name)
	if not part then
		return nil
	end
	local inst = part:FindFirstChild(name)
	if inst and (inst:IsA("Motor6D") or inst:IsA("AnimationConstraint")) then
		return joint(inst)
	end
	-- newer avatars: an AnimationConstraint anywhere in the part, joining it to its parent part
	for _, item in ipairs(part:GetChildren()) do
		if item:IsA("AnimationConstraint") and item.Attachment1 and item.Attachment1.Parent == part then
			return joint(item)
		end
	end
	return nil
end

local R6_JOINTS = {
	Root = { "HumanoidRootPart", "RootJoint" },
	RightShoulder = { "Torso", "Right Shoulder" },
	LeftShoulder = { "Torso", "Left Shoulder" },
	Neck = { "Torso", "Neck" },
}

-- The rig's joints, or nil (and a reason) if we can't pose this character.
function BodyRig.Find(character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil, "no HumanoidRootPart"
	end
	local motors = {}
	local missing
	for motorName, partName in pairs(MOTORS) do
		local found = findJoint(character:FindFirstChild(partName), motorName)
		if not found then
			missing = missing or (partName .. "." .. motorName)
		end
		motors[motorName] = found
	end
	if not missing then
		local rig = { Kind = "R15", Character = character, Root = root, Motors = motors, Base = {}, Set = {} }
		local function length(a, b)
			return (a.C1.Position - b.C0.Position).Magnitude -- joint to joint inside one part
		end
		rig.Upper = length(motors.RightShoulder, motors.RightElbow)
		rig.Lower = length(motors.RightElbow, motors.RightWrist)
		rig.LeftUpper = length(motors.LeftShoulder, motors.LeftElbow)
		rig.LeftLower = length(motors.LeftElbow, motors.LeftWrist)
		return rig
	end
	-- R6: one-piece arms that point at the weapon
	local r6 = {}
	for name, where in pairs(R6_JOINTS) do
		local part = character:FindFirstChild(where[1])
		local inst = part and part:FindFirstChild(where[2])
		if not (inst and inst:IsA("Motor6D")) then
			return nil, "missing joint " .. missing
		end
		r6[name] = inst
	end
	return { Kind = "R6", Character = character, Root = root, Motors = r6, Base = {}, Set = {} }
end

-- The current weapon joint on the right hand (made by CharacterService).
function BodyRig.FindWeapon(rig, name)
	local model = rig.Character:FindFirstChild(name)
	local root = model and model:FindFirstChild("WeaponRoot")
	if not root then
		return nil
	end
	local grip = root:FindFirstChild("WeaponGrip")
	if not grip or not grip:IsA("Motor6D") then
		return nil
	end
	return {
		Model = model,
		Root = root,
		Grip = grip,
		GripToRoot = root:GetAttribute("GripToRoot") or CFrame.new(),
		Bolt = root:FindFirstChild("BoltJoint"),
	}
end

-- An orthonormal frame whose Y is `along` and whose X is as close to `x` as possible.
local function frame(along, x)
	local y = along.Unit
	local xx = x - y * x:Dot(y)
	if xx.Magnitude < 1e-4 then
		xx = math.abs(y.X) < 0.9 and V(1, 0, 0) or V(0, 0, 1)
		xx = xx - y * xx:Dot(y)
	end
	xx = xx.Unit
	return CFrame.fromMatrix(Vector3.zero, xx, y, xx:Cross(y))
end

-- Child part CFrame -> the motor Transform that puts it there.
local function place(motor, parentCF, childCF)
	motor.Transform = (parentCF * motor.C0):Inverse() * childCF * motor.C1
end
BodyRig.Place = place

-- World CFrame of a motor's Part1 given its Part0 CFrame and its Transform.
local function child(motor, parentCF, transform)
	return parentCF * motor.C0 * (transform or motor.Transform) * motor.C1:Inverse()
end
BodyRig.Child = child

--[[
	Two-bone IK for one arm. Returns the hand's world CFrame.
	torso: UpperTorso CFrame; target: where the hand should be (world);
	pole: which way the elbow should point (world direction).
]]
local function solveArm(torso, shoulder, elbow, wrist, upperLen, lowerLen, target, pole)
	local S = (torso * shoulder.C0).Position
	local W = (target * wrist.C1).Position -- where the wrist joint has to be
	local toW = W - S
	local d = math.clamp(toW.Magnitude, math.abs(upperLen - lowerLen) + 0.01, upperLen + lowerLen - 0.002)
	local dir = toW.Magnitude > 1e-4 and toW.Unit or V(0, -1, 0)
	local cosA = math.clamp((upperLen * upperLen + d * d - lowerLen * lowerLen) / (2 * upperLen * d), -1, 1)
	local sinA = math.sqrt(1 - cosA * cosA)
	local side = pole - dir * pole:Dot(dir)
	side = side.Magnitude > 1e-4 and side.Unit or V(0, -1, 0)
	local E = S + dir * upperLen * cosA + side * upperLen * sinA
	local Wr = E + (S + dir * d - E).Unit * lowerLen -- the wrist we can actually reach

	-- the elbow hinges round each arm part's X axis: positive bends the forearm forward
	local upperDir = (E - S).Unit
	local lowerDir = (Wr - E).Unit
	local hinge = upperDir:Cross(lowerDir)
	if hinge.Magnitude < 1e-3 then
		hinge = upperDir:Cross(pole)
	end
	hinge = hinge.Magnitude > 1e-4 and hinge.Unit or V(1, 0, 0)

	-- upper arm: its shoulder->elbow line along upperDir, X along the hinge
	local boneU = elbow.C0.Position - shoulder.C1.Position -- (upper arm space)
	local R1 = frame(-upperDir, hinge) * frame(-boneU, V(1, 0, 0)):Inverse()
	local upperCF = CFrame.new(S) * R1 * CFrame.new(-shoulder.C1.Position)
	place(shoulder, torso, upperCF)

	-- lower arm
	local Ea = (upperCF * elbow.C0).Position
	local boneL = wrist.C0.Position - elbow.C1.Position
	local R2 = frame(-lowerDir, hinge) * frame(-boneL, V(1, 0, 0)):Inverse()
	local lowerCF = CFrame.new(Ea) * R2 * CFrame.new(-elbow.C1.Position)
	place(elbow, upperCF, lowerCF)

	-- hand: the target's rotation, hung from the wrist we reached
	local Wa = (lowerCF * wrist.C0).Position
	local handCF = CFrame.new(Wa) * target.Rotation * CFrame.new(-wrist.C1.Position)
	place(wrist, lowerCF, handCF)
	return handCF
end

-- What the walk / idle animation wants for a joint this frame. (If nothing
-- animated it since we last wrote it, that's still our own value, so use the
-- base we saved instead of stacking on top of ourselves.)
local function base(rig, name)
	local motor = rig.Motors[name]
	if rig.Set[name] and motor.Transform == rig.Set[name] then
		return rig.Base[name]
	end
	rig.Base[name] = motor.Transform
	return motor.Transform
end

local function set(rig, name, transform)
	rig.Motors[name].Transform = transform
	rig.Set[name] = transform
end

--[[
	view: eye CFrame (world); anim: WeaponAnim output; opts:
	  Pitch       aim pitch (radians) shared out to the waist and neck
	  Weapon      BodyRig.FindWeapon result for the weapon in hand (or nil)
	  LegWeight   0..1 how much the lunge pose replaces the walk (default anim.Body.Step)
	Returns { RightHand = CFrame, LeftHand = CFrame, Weapon = CFrame }
]]
local function solveR6(rig, view, anim, opts)
	local m = rig.Motors
	local rootCF = rig.Root.CFrame
	local torso = child(m.Root, rootCF)
	local function aimArm(motor, target)
		local S = (torso * motor.C0).Position
		local dir = target.Position - S
		dir = dir.Magnitude > 1e-3 and dir.Unit or -view.UpVector
		local armCF = CFrame.new(S) * frame(-dir, target.RightVector) * CFrame.new(-motor.C1.Position)
		place(motor, torso, armCF) -- (the arm hangs along its -Y, so -Y points at the weapon)
		return armCF
	end
	local rightArm = aimArm(m.RightShoulder, view * anim.Right)
	aimArm(m.LeftShoulder, view * anim.Left)
	local weaponCF = view * anim.Weapon
	local weapon = opts.Weapon
	if weapon then
		weapon.Grip.Transform = (rightArm * weapon.Grip.C0):Inverse() * (weaponCF * weapon.GripToRoot) * weapon.Grip.C1
		if weapon.Bolt then
			weapon.Bolt.Transform = anim.Bolt or CFrame.new()
		end
	end
	return { RightHand = rightArm, LeftHand = rightArm, Weapon = weaponCF }
end

function BodyRig.Solve(rig, view, anim, opts)
	opts = opts or {}
	if rig.Kind == "R6" then
		return solveR6(rig, view, anim, opts)
	end
	local m = rig.Motors
	local body = anim.Body or {}
	local pitch = opts.Pitch or 0
	local rootCF = rig.Root.CFrame

	-- hips: dip, push forward, lean (on top of the walk animation)
	local step = math.clamp(body.Step or 0, 0, 1)
	local rootT = base(rig, "Root")
		* CFrame.new(0, -(body.Dip or 0), -(body.Forward or 0))
		* CFrame.Angles(-rad(body.Lean or 0) * 0.5, 0, 0)
	set(rig, "Root", rootT)
	local lower = child(m.Root, rootCF, rootT)

	-- waist: twist (+Yaw = turn right), lean forward, and part of the aim pitch
	local waistT = CFrame.Angles(pitch * 0.35 - rad(body.Lean or 0) * 0.5 + rad(body.Pitch or 0), -rad(body.Yaw or 0), rad(body.Roll or 0))
	m.Waist.Transform = waistT
	local torso = child(m.Waist, lower, waistT)

	-- neck: the rest of the pitch, turned back against the waist twist
	local neckT = CFrame.Angles(pitch * 0.45 + rad(body.NeckPitch or 0), rad(body.Yaw or 0) * 0.7 + rad(body.NeckYaw or 0), -rad(body.Roll or 0) * 0.7)
	m.Neck.Transform = neckT

	-- arms
	local rightTarget = view * anim.Right
	local leftTarget = view * anim.Left
	local down = -view.UpVector
	local rightPole = (view.RightVector * 0.7 + down - view.LookVector * 0.15).Unit
	local leftPole = (-view.RightVector * 0.7 + down - view.LookVector * 0.15).Unit
	local rightHand = solveArm(torso, m.RightShoulder, m.RightElbow, m.RightWrist, rig.Upper, rig.Lower, rightTarget, rightPole)
	local leftHand = solveArm(torso, m.LeftShoulder, m.LeftElbow, m.LeftWrist, rig.LeftUpper, rig.LeftLower, leftTarget, leftPole)

	-- the weapon, exactly where the animation wants it
	local weaponCF = view * anim.Weapon
	local weapon = opts.Weapon
	if weapon then
		local rootCFW = weaponCF * weapon.GripToRoot
		weapon.Grip.Transform = (rightHand * weapon.Grip.C0):Inverse() * rootCFW * weapon.Grip.C1
		if weapon.Bolt then
			weapon.Bolt.Transform = anim.Bolt or CFrame.new()
		end
	end

	-- legs: step into a lunge (front leg forward and bent, back leg trailing)
	local legs = {
		RightHip = CFrame.Angles(rad(38), 0, 0),
		RightKnee = CFrame.Angles(rad(-40), 0, 0),
		LeftHip = CFrame.Angles(rad(-28), 0, 0),
		LeftKnee = CFrame.Angles(rad(-25), 0, 0),
	}
	for name, pose in pairs(legs) do
		if step > 0.01 then
			set(rig, name, base(rig, name):Lerp(pose, step * (opts.LegWeight or 1)))
		elseif rig.Set[name] then
			-- lunge over: hand the leg back to the walk animation
			m[name].Transform = base(rig, name)
			rig.Set[name] = nil
		end
	end

	return { RightHand = rightHand, LeftHand = leftHand, Weapon = weaponCF, Torso = torso, Lower = lower }
end

-- Every part's world CFrame from the root and the current Transforms
-- (for previews; Roblox does this itself in game).
function BodyRig.Pose(rig)
	local out = { HumanoidRootPart = rig.Root.CFrame }
	local m = rig.Motors
	local order = {
		{ "Root", "HumanoidRootPart", "LowerTorso" },
		{ "Waist", "LowerTorso", "UpperTorso" },
		{ "Neck", "UpperTorso", "Head" },
		{ "RightShoulder", "UpperTorso", "RightUpperArm" },
		{ "RightElbow", "RightUpperArm", "RightLowerArm" },
		{ "RightWrist", "RightLowerArm", "RightHand" },
		{ "LeftShoulder", "UpperTorso", "LeftUpperArm" },
		{ "LeftElbow", "LeftUpperArm", "LeftLowerArm" },
		{ "LeftWrist", "LeftLowerArm", "LeftHand" },
		{ "RightHip", "LowerTorso", "RightUpperLeg" },
		{ "RightKnee", "RightUpperLeg", "RightLowerLeg" },
		{ "LeftHip", "LowerTorso", "LeftUpperLeg" },
		{ "LeftKnee", "LeftUpperLeg", "LeftLowerLeg" },
	}
	for _, j in ipairs(order) do
		out[j[3]] = child(m[j[1]], out[j[2]])
	end
	return out
end

return BodyRig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--[[
	CameraController.lua  (Client.CameraController)

	* Locks the camera in first person during matches (CameraMode =
	  LockFirstPerson, max zoom 0.5 so you can never zoom out).
	* Hides your own body so it never clips into the camera.
	* FOV: base FOV + movement kicks (sprint / slide / dash / wall run / speed),
	  zooms in while scoped.
	* Camera roll during wall runs and slides, lowered camera while sliding.
	* Aim recoil (kicks your aim up a little each shot).
	* Mouse sensitivity from settings (separate scoped sensitivity).
	* Frees the mouse while a menu is open (pick screen, settings, victory).

	Runs right AFTER Roblox's default camera each frame, so it only adds
	small offsets on top of the normal first-person camera.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local ClientState = require(script.Parent.ClientState)
local AimAssist = require(script.Parent.AimAssist)

local C = Config.Camera
local player = Players.LocalPlayer

local CameraController = {}
local Controllers

local currentFov = C.BaseFOV
local rightStick = Vector2.zero -- controller look stick (we handle it ourselves)
local touchLook = Vector2.zero -- pixels dragged on the touch look pad since last frame
local currentRoll = 0
local currentDrop = 0
local recoilLeft = 0 -- degrees of pitch still to apply
local fovPunch = 0
local shake = 0
local bobTime = 0
local bobAmount = 0
local landDip = 0 -- current camera dip from landing (studs)
local landDipVelocity = 0
local hiddenParts = {}
local firstPerson = false

----------------------------------------------------------------------------
-- Public API (used by other controllers)
----------------------------------------------------------------------------
-- Mobile: the look pad (ui/MobileControls) adds finger movement here.
function CameraController.AddTouchLook(delta)
	touchLook += delta
end

function CameraController.AddRecoil(degrees)
	recoilLeft += degrees
end

function CameraController.AddFovPunch(amount)
	fovPunch = math.max(fovPunch, amount)
end

function CameraController.Shake(amount)
	shake = math.max(shake, amount)
end

-- Camera dips down on landing (bigger fall = bigger dip), then springs back.
function CameraController.LandingDip(fallSpeed)
	-- normal jumps / bunny hops land at ~50 u/s and only get a tiny dip
	local dip = math.min(0.04 + math.max(fallSpeed - 45, 0) * C.LandingDip, C.MaxLandingDip)
	landDipVelocity -= dip * 14
end

function CameraController.IsFirstPerson()
	return firstPerson
end

-- Turns the camera to look the way the character faces (used at spawn).
function CameraController.FaceCharacterForward()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	if root and camera then
		local eye = root.Position + Vector3.new(0, 1.5, 0)
		camera.CFrame = CFrame.lookAt(eye, eye + root.CFrame.LookVector)
	end
end

----------------------------------------------------------------------------
-- Body hiding
----------------------------------------------------------------------------
local function trackCharacter(character)
	table.clear(hiddenParts)
	local function add(item)
		if item:IsA("BasePart") then
			table.insert(hiddenParts, item)
		end
	end
	for _, item in ipairs(character:GetDescendants()) do
		add(item)
	end
	character.DescendantAdded:Connect(add)
end

local function setBodyHidden(hidden)
	local value = hidden and 1 or 0
	for _, part in ipairs(hiddenParts) do
		if part.Parent then
			part.LocalTransparencyModifier = value
		end
	end
end

----------------------------------------------------------------------------
-- Camera mode
----------------------------------------------------------------------------
local function wantsFirstPerson()
	return ClientState.InMatch() or C.FirstPersonInLobby
end

local function applyCameraMode()
	firstPerson = wantsFirstPerson()
	if firstPerson then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMaxZoomDistance = 0.5
		player.CameraMinZoomDistance = 0.5
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 18
	end
end

----------------------------------------------------------------------------
-- Per-frame update (after the default camera)
----------------------------------------------------------------------------
local suspended = false

-- The kill cam takes over the camera while it plays.
function CameraController.SetSuspended(value)
	suspended = value
end

local function update(dt)
	local camera = workspace.CurrentCamera
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not camera or suspended then
		return
	end

	-- Keep enforcing the mode (respawns can reset it)
	if wantsFirstPerson() ~= firstPerson or (firstPerson and player.CameraMode ~= Enum.CameraMode.LockFirstPerson) then
		applyCameraMode()
	end

	local movement = Controllers.Movement
	local weapon = Controllers.Weapon
	local hints = movement.GetCameraHints()
	local scopeAlpha = weapon.GetScopeAlpha()

	-- FIELD OF VIEW
	local targetFov = (ClientState.Settings.FieldOfView or C.BaseFOV) + hints.FovKick
	targetFov = Util.lerp(targetFov, C.ScopeFOV, scopeAlpha)
	fovPunch = Util.approach(fovPunch, 0, 40 * dt)
	currentFov = Util.lerp(currentFov, targetFov, Util.smooth(C.FOVLerpSpeed, dt))
	camera.FieldOfView = math.clamp(currentFov + fovPunch * (1 - scopeAlpha), 1, 120)

	-- SENSITIVITY
	local settings = ClientState.Settings
	local sensitivity = settings.Sensitivity
	if scopeAlpha > 0.5 then
		sensitivity = settings.ScopedSensitivity
	end
	if movement.IsBulletTime() then
		sensitivity *= Config.PowerUps.BulletTime.SensitivityScale
	end
	UserInputService.MouseDeltaSensitivity = sensitivity

	-- CAMERA OFFSET: slide drop + running head bob + landing dip
	-- (CameraOffset is used by the default camera next frame)
	currentDrop = Util.lerp(currentDrop, hints.Drop, Util.smooth(C.CameraDropLerpSpeed, dt))
	local speed = movement.GetSpeed()
	local running = movement.IsGrounded() and movement.GetMode() == "Ground" and speed > 4
	bobAmount = Util.lerp(bobAmount, running and math.clamp(speed / Config.Movement.RunSpeed, 0, 1.3) or 0, Util.smooth(10, dt))
	bobTime += dt * (7 + speed * 0.18)
	local bobY = math.sin(bobTime * 2) * C.HeadBob * bobAmount * (1 - scopeAlpha)
	-- landing dip spring
	landDipVelocity += (-landDip * 180 - landDipVelocity * 18) * dt
	landDip += landDipVelocity * dt
	if humanoid then
		-- (first person sits a little behind your eyes so your real arms aren't in your face)
		local back = firstPerson and (Config.Body.CameraBack or 0) or 0
		humanoid.CameraOffset = Vector3.new(0, -currentDrop + bobY + landDip, back)
	end

	-- CONTROLLER LOOK: right stick, with its own sensitivity / deadzone / curve
	if not ClientState.MenuOpen then
		local dz = settings.ControllerDeadzone or 0.15
		local mag = rightStick.Magnitude
		if mag > dz then
			local CC = Config.Controller
			local amount = ((math.min(mag, 1) - dz) / (1 - dz)) ^ CC.ResponseCurve
			local dir = rightStick.Unit * amount
			local sens = scopeAlpha > 0.5 and settings.ControllerScopedSensitivity or settings.ControllerSensitivity
			if movement.IsBulletTime() then
				sens *= Config.PowerUps.BulletTime.SensitivityScale
			end
			local rate = math.rad(CC.TurnSpeed) * (sens or 1) * dt
			local cf = camera.CFrame
			local look = cf.LookVector
			local pitch = math.asin(math.clamp(look.Y, -1, 1))
			local newPitch = math.clamp(pitch + dir.Y * rate * CC.VerticalScale * (settings.InvertY and -1 or 1), -1.4, 1.4)
			local flat = Util.safeUnit(Vector3.new(look.X, 0, look.Z), Vector3.new(0, 0, -1))
			flat = CFrame.Angles(0, -dir.X * rate, 0):VectorToWorldSpace(flat)
			local newLook = flat * math.cos(newPitch) + Vector3.new(0, math.sin(newPitch), 0)
			camera.CFrame = CFrame.lookAt(cf.Position, cf.Position + newLook)
		end
	end

	-- TOUCH LOOK: drag on the right side of the screen
	if touchLook.Magnitude > 0 then
		if not ClientState.MenuOpen then
			local sens = scopeAlpha > 0.5 and (settings.TouchScopedSensitivity or 0.4) or (settings.TouchSensitivity or 1)
			if movement.IsBulletTime() then
				sens *= Config.PowerUps.BulletTime.SensitivityScale
			end
			local k = math.rad(Config.Touch.DegreesPerPixel) * sens
			local cf = camera.CFrame
			local look = cf.LookVector
			local pitch = math.asin(math.clamp(look.Y, -1, 1))
			local newPitch = math.clamp(pitch - touchLook.Y * k * (settings.InvertY and -1 or 1), -1.4, 1.4)
			local flat = Util.safeUnit(Vector3.new(look.X, 0, look.Z), Vector3.new(0, 0, -1))
			flat = CFrame.Angles(0, -touchLook.X * k, 0):VectorToWorldSpace(flat)
			local newLook = flat * math.cos(newPitch) + Vector3.new(0, math.sin(newPitch), 0)
			camera.CFrame = CFrame.lookAt(cf.Position, cf.Position + newLook)
		end
		touchLook = Vector2.zero
	end

	if firstPerson then
		-- AIM ASSIST (controller only): slowdown + gentle pull near a target
		AimAssist.Update(camera, dt, scopeAlpha)

		-- RECOIL: apply the kick over a few frames (this really moves your aim)
		if recoilLeft > 0.001 then
			local step = recoilLeft * math.min(1, dt * 25)
			recoilLeft -= step
			camera.CFrame *= CFrame.Angles(math.rad(step), 0, 0)
		end

		-- ROLL (wall run / slide / strafe tilt). Roll doesn't change the look
		-- direction, so it never affects aim.
		currentRoll = Util.lerp(currentRoll, hints.Roll, Util.smooth(C.TiltLerpSpeed, dt))
		local shakeOffset = CFrame.identity
		if shake > 0.01 then
			shakeOffset = CFrame.Angles(
				math.rad((math.random() - 0.5) * shake),
				math.rad((math.random() - 0.5) * shake),
				0
			)
			shake = Util.approach(shake, 0, 12 * dt)
		end
		camera.CFrame *= CFrame.Angles(0, 0, math.rad(currentRoll)) * shakeOffset

		setBodyHidden(true)

		-- MOUSE: free it while a menu is open, hide the cursor otherwise
		if ClientState.MenuOpen then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		else
			UserInputService.MouseIconEnabled = false
		end
	else
		currentRoll = 0
		UserInputService.MouseIconEnabled = true
	end
end

function CameraController.Init(controllers)
	Controllers = controllers
end

function CameraController.Start()
	if player.Character then
		trackCharacter(player.Character)
	end
	player.CharacterAdded:Connect(trackCharacter)

	applyCameraMode()
	ClientState.Changed:Connect(function(snapshot, old)
		applyCameraMode()
		if snapshot.Phase == "Countdown" and old.Phase ~= "Countdown" then
			-- new round: look toward the arena centre
			task.delay(0.05, CameraController.FaceCharacterForward)
		end
	end)

	Controllers.Movement.Landed:Connect(CameraController.LandingDip)

	AimAssist.Start()
	-- take the right stick away from Roblox's camera so our controller
	-- sensitivity / deadzone settings are used instead
	ContextActionService:BindActionAtPriority("SniperControllerLook", function(_, state, input)
		if state == Enum.UserInputState.Cancel or state == Enum.UserInputState.End then
			rightStick = Vector2.zero
		else
			rightStick = Vector2.new(input.Position.X, input.Position.Y)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 50, Enum.KeyCode.Thumbstick2)
	RunService:BindToRenderStep("SniperCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--[[
	ClientState.lua  (Client.ClientState)

	The client's copy of "what's going on": the latest match snapshot from the
	server, this player's power-up stats, and their settings. Other client
	modules read from here and listen to the Changed signals.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local player = Players.LocalPlayer

local ClientState = {}

ClientState.Snapshot = { Phase = "Lobby", InMatch = false }
ClientState.Stats = PowerUps.ComputeStats({})
ClientState.Owned = {} -- { [powerUpId] = stacks } you have right now (match or Power-Up Lab)
ClientState.Settings = table.clone(Config.SettingsDefaults)
ClientState.MenuOpen = false -- true while a menu needs the mouse (settings / pick / victory)
ClientState.Weapon = "Sniper" -- what's in your hands: "Sniper" or "Knife" (KnifeController)
ClientState.OwnedSkins = {} -- { [skinId] = count } (from the server's "Crates" messages)

ClientState.Changed = Signal.new() -- (newSnapshot, oldSnapshot)
ClientState.SettingsChanged = Signal.new() -- (settings)
ClientState.MenuChanged = Signal.new() -- (isOpen)
ClientState.SkinsChanged = Signal.new() -- () your owned skins changed

local menuReasons = {}

----------------------------------------------------------------------------
-- Queries
----------------------------------------------------------------------------
function ClientState.InMatch()
	return ClientState.Snapshot.InMatch == true
end

function ClientState.Phase()
	return ClientState.Snapshot.Phase
end

function ClientState.IsFighting()
	return ClientState.Snapshot.InMatch == true and ClientState.Snapshot.Phase == "Fight"
end

-- Phases where you are in the arena with your gun out.
function ClientState.IsInArena()
	local phase = ClientState.Snapshot.Phase
	return ClientState.Snapshot.InMatch == true
		and (phase == "Countdown" or phase == "Fight" or phase == "RoundEnd")
end

-- True when you should be holding your sniper: in the lobby (practice range)
-- or in the arena during a round.
function ClientState.HasGun()
	return not ClientState.Snapshot.InMatch or ClientState.IsInArena()
end

-- True when shots are allowed: practice in the lobby, or a live round.
function ClientState.CanShoot()
	return not ClientState.Snapshot.InMatch or ClientState.IsFighting()
end

-- Positions bullets may home in on: the enemy's torso, or the practice dummies.
function ClientState.GetHomingTargets()
	if ClientState.Snapshot.InMatch then
		local opponent = ClientState.GetOpponentPlayer()
		local character = opponent and opponent.Character
		local torso = character and (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"))
		return torso and { torso.Position } or {}
	end
	local targets = {}
	local folder = workspace:FindFirstChild("Dummies")
	for _, dummy in ipairs(folder and folder:GetChildren() or {}) do
		local torso = dummy:FindFirstChild("UpperTorso")
		if torso and not dummy:GetAttribute("Down") then
			table.insert(targets, torso.Position)
		end
	end
	return targets
end

-- This player's entry in the snapshot's Players list.
function ClientState.GetMe()
	for _, entry in ipairs(ClientState.Snapshot.Players or {}) do
		if entry.UserId == player.UserId then
			return entry
		end
	end
	return nil
end

function ClientState.GetOpponentEntry()
	for _, entry in ipairs(ClientState.Snapshot.Players or {}) do
		if entry.UserId ~= player.UserId then
			return entry
		end
	end
	return nil
end

-- The Player with this UserId, or for a bot (server AI, not a real Player)
-- a stand-in table { UserId, Name, DisplayName, Character, IsBot }.
function ClientState.FindPlayer(userId)
	local real = Players:GetPlayerByUserId(userId)
	if real then
		return real
	end
	for _, entry in ipairs(ClientState.Snapshot.Players or {}) do
		if entry.UserId == userId and entry.IsBot then
			local bots = workspace:FindFirstChild("Bots")
			return {
				UserId = entry.UserId,
				Name = entry.Name,
				DisplayName = entry.Name,
				IsBot = true,
				Character = bots and entry.CharacterName and bots:FindFirstChild(entry.CharacterName) or nil,
			}
		end
	end
	return nil
end

-- Your opponent (a Player, or a bot stand-in - see FindPlayer).
function ClientState.GetOpponentPlayer()
	local entry = ClientState.GetOpponentEntry()
	return entry and ClientState.FindPlayer(entry.UserId) or nil
end

function ClientState.GetSlotColor(slot)
	return slot == 1 and Config.Palette.PlayerA or Config.Palette.PlayerB
end

-- Seconds left in the current phase (based on the server clock).
function ClientState.TimeLeft()
	local endsAt = ClientState.Snapshot.PhaseEndsAt
	if not endsAt then
		return nil
	end
	return math.max(0, endsAt - workspace:GetServerTimeNow())
end

----------------------------------------------------------------------------
-- Menus (anything that needs a free mouse registers a reason here)
----------------------------------------------------------------------------
function ClientState.SetMenu(reason, open)
	menuReasons[reason] = open or nil
	local isOpen = next(menuReasons) ~= nil
	if isOpen ~= ClientState.MenuOpen then
		ClientState.MenuOpen = isOpen
		ClientState.MenuChanged:Fire(isOpen)
	end
end

----------------------------------------------------------------------------
-- Settings
----------------------------------------------------------------------------
function ClientState.SetSetting(key, value)
	ClientState.Settings[key] = value
	ClientState.SettingsChanged:Fire(ClientState.Settings)
end

function ClientState.SaveSettings()
	Remotes.Get("SettingsSave"):FireServer(ClientState.Settings)
end

----------------------------------------------------------------------------
function ClientState.Init()
	Remotes.Get("MatchState").OnClientEvent:Connect(function(snapshot)
		local old = ClientState.Snapshot
		ClientState.Snapshot = snapshot
		-- in a match: your match power-ups; in the lobby: your Power-Up Lab picks
		local me = ClientState.GetMe()
		local owned = snapshot.InMatch and (me and me.PowerUps) or snapshot.PowerUps
		ClientState.Owned = owned or {}
		ClientState.Stats = PowerUps.ComputeStats(ClientState.Owned)
		ClientState.Changed:Fire(snapshot, old)
	end)

	Remotes.Get("SettingsLoad").OnClientEvent:Connect(function(settings)
		for key, value in pairs(settings) do
			ClientState.Settings[key] = value
		end
		ClientState.SettingsChanged:Fire(ClientState.Settings)
	end)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">CrateController</string>
            <string name="Source"><![CDATA[--[[
	CrateController.lua  (Client.CrateController)

	The crate in the lobby's crate vault, and the opening cinematic.

	Idle: the crate floats over the altar, slowly turning, its glow cycling
	through the rarity colours.

	Opening (when the server sends a result over the "Crates" remote):
	  1. INTRO    the camera swoops in, letterbox bars slide on
	  2. CHARGE   the crate lifts and spins faster and faster, shaking, while
	              sparks get sucked in over a quickening heartbeat; its glow
	              climbs the rarity ladder (COMMON > UNCOMMON > ..., slower
	              each step) and stops on what you got, flickers toward the
	              next rarity (the tease) and falls back, then everything
	              stops dead for a breath before the blast.
	              Secret fakes you out: it stalls on Legendary, goes dark,
	              then cracks red.
	  3. BURST    the lid blasts off, a flash, a pillar of light, a shockwave
	              ring and a shower of sparks in the rarity colour
	  4. REVEAL   the rifle (or knife) rises out of the crate in the skin's colours and
	              spins while ui/CrateReveal shows the rarity + skin
	Everything is local to you; the roll itself happened on the server.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local CrateModel = require(Shared.CrateModel)
local GunModel = require(Shared.GunModel)
local KnifeModel = require(Shared.KnifeModel)
local Skins = require(Shared.Skins)
local ClientState = require(script.Parent.ClientState)
local Sfx = require(script.Parent.Sfx)
local CrateReveal = require(script.Parent.ui.CrateReveal)

local CR = Config.Crates
local player = Players.LocalPlayer

local CrateController = {}
local Controllers

local rarityById, tierOf, skinById = {}, {}, {}
for i, rarity in ipairs(CR.Rarities) do
	rarityById[rarity.Id] = rarity
	tierOf[rarity.Id] = i
end
for _, skin in ipairs(CR.Skins) do
	skinById[skin.Id] = skin
end

local CRATE_SCALE = 1.3
local HOVER = 0.5

local altar, prompt, ring
local crate -- CrateModel table (local to this client)
local idleT = 0
local lastColorSet = 0

-- cinematic state
local playing = false
local scene -- per-opening objects (cleaned up by clearScene)
local saved -- what we changed on the player (restored by finish)
local pendingResult -- a result that arrived while we were busy
local waitingAgain = false
local finishing = false
local againToken = 0
local lastCrateType = "Standard"

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------
local function ease(x)
	x = math.clamp(x, 0, 1)
	return 1 - (1 - x) ^ 3
end

local function newPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		part[key] = value
	end
	part.Parent = props.Parent or workspace
	return part
end

-- flat ring on the floor that grows and fades
local function shockRing(center, color, size, time)
	local part = newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, 1, 1),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.15,
	})
	TweenService:Create(part, TweenInfo.new(time or 0.6, Enum.EasingStyle.Quint), {
		Size = Vector3.new(0.12, size, size),
		Transparency = 1,
	}):Play()
	task.delay((time or 0.6) + 0.1, function()
		part:Destroy()
	end)
end

local function cameraShake(amount)
	return Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * amount
end

----------------------------------------------------------------------------
-- The display crate + idle animation
----------------------------------------------------------------------------
local function restPose(t)
	return altar.CFrame * CFrame.new(0, HOVER + math.sin(t * 1.6) * 0.16, 0) * CFrame.Angles(0, math.sin(t * 0.45) * 0.4, 0)
end

local function idleColor(t)
	-- hold each rarity colour for a moment, then blend to the next
	local n = #CR.Rarities
	local f = (t * 0.32) % n
	local i = math.floor(f) + 1
	local a = math.clamp((f - math.floor(f) - 0.65) / 0.35, 0, 1)
	return CR.Rarities[i].Color:Lerp(CR.Rarities[i % n + 1].Color, a)
end

local function setupAltar()
	local lobby = workspace:WaitForChild("Lobby", 60)
	altar = lobby and lobby:WaitForChild("CrateAltar", 30)
	if not altar then
		return false
	end
	prompt = altar:FindFirstChildOfClass("ProximityPrompt")
	for _, part in ipairs(lobby:GetDescendants()) do
		if part.Name == "AltarRing" and part:IsA("BasePart") then
			ring = part
			break
		end
	end
	crate = CrateModel.Build({ CFrame = restPose(0), Scale = CRATE_SCALE, Color = CR.Rarities[1].Color, Parent = workspace, Name = "LobbyCrate" })
	return true
end

local function idle(dt)
	if playing or not crate then
		return
	end
	local camera = workspace.CurrentCamera
	if (camera.CFrame.Position - altar.Position).Magnitude > 220 then
		return
	end
	idleT += dt
	crate.Model:PivotTo(restPose(idleT))
	local now = os.clock()
	if now - lastColorSet > 0.08 then
		lastColorSet = now
		local color = idleColor(idleT)
		CrateModel.SetColor(crate, color)
		if ring then
			ring.Color = color
		end
	end
	if prompt then
		local keys = player:GetAttribute("Keys") or 0
		prompt.ObjectText = (CR.FreeInStudio and RunService:IsStudio()) and "Free in Studio"
			or ("Standard crate: %d keys (you have %d)"):format(CR.Types.Standard.Cost, keys)
	end
end

----------------------------------------------------------------------------
-- The rifle (or knife) in the skin's colours
----------------------------------------------------------------------------
local function buildRifle(skin, rarity)
	local model = Instance.new("Model")
	model.Name = "CrateReward"
	local isKnife = skin.Weapon == "Knife"
	local scale = isKnife and 2.6 or 1.7
	local built = Skins.Build(skin.Weapon or "Rifle", model, skin, { Scale = scale, Anchored = true, CastShadow = false, Effects = false })
	for _, part in pairs(built.Parts) do
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
	end
	-- a soft outline in the rarity colour
	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 1
	highlight.OutlineColor = rarity.Color
	highlight.OutlineTransparency = 0.3
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	model.Parent = workspace
	return { Model = model, Built = built, Scale = scale, IsKnife = isKnife }
end

local function placeRifle(rifle, cf)
	if rifle.IsKnife then
		-- the knife's origin is mid-handle: shift so it spins around its middle
		KnifeModel.Place(rifle.Built, cf * CFrame.new(0, 0, 0.47 * rifle.Scale))
	else
		-- GunModel's grip is near the back: shift so it spins around its middle
		GunModel.Place(rifle.Built, cf * CFrame.new(0, 0, 1.4 * rifle.Scale), rifle.Scale)
	end
end

----------------------------------------------------------------------------
-- Take over / give back the player's view
----------------------------------------------------------------------------
local function takeOver()
	local camera = workspace.CurrentCamera
	saved = {
		CameraType = camera.CameraType,
		Fov = camera.FieldOfView,
		Guis = {},
	}
	Controllers.Camera.SetSuspended(true)
	Controllers.Viewmodel.SetHidden("Crate", true)
	ClientState.SetMenu("Crate", true)
	camera.CameraType = Enum.CameraType.Scriptable
	-- hide the other screens (HUD, lobby, touch controls) for a clean shot
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	for _, screen in ipairs(playerGui and playerGui:GetChildren() or {}) do
		if screen:IsA("ScreenGui") and screen.Enabled and screen.Name ~= "CrateReveal" then
			screen.Enabled = false
			table.insert(saved.Guis, screen)
		end
	end
	-- stand still
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		saved.Root = root
		saved.RootAnchored = root.Anchored
		root.Anchored = true
	end
	if prompt then
		prompt.Enabled = false
	end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "CrateFX"
	cc.Parent = Lighting
	saved.CC = cc
	CrateReveal.Show()
end

local function giveBack()
	local camera = workspace.CurrentCamera
	if saved then
		for _, screen in ipairs(saved.Guis) do
			if screen.Parent then
				screen.Enabled = true
			end
		end
		if saved.Root and saved.Root.Parent then
			saved.Root.Anchored = saved.RootAnchored
		end
		if saved.CC then
			saved.CC:Destroy()
		end
		camera.FieldOfView = saved.Fov
	end
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
	Controllers.Camera.SetSuspended(false)
	Controllers.Viewmodel.SetHidden("Crate", false)
	ClientState.SetMenu("Crate", false)
	if prompt then
		prompt.Enabled = true
	end
	saved = nil
end

local function clearScene()
	if not scene then
		return
	end
	if scene.Connection then
		scene.Connection:Disconnect()
	end
	for _, item in ipairs(scene.Trash) do
		item:Destroy()
	end
	if scene.Rifle then
		scene.Rifle.Model:Destroy()
	end
	CrateModel.SetFade(crate, 0)
	CrateModel.SetLid(crate, 0)
	crate.Light.Brightness = 1.1
	scene = nil
end

local function finish()
	if not playing or finishing then
		return
	end
	finishing = true
	waitingAgain = false
	CrateReveal.HideCard()
	local black = CrateReveal.Black(1, 0.22)
	black.Completed:Wait()
	clearScene()
	giveBack()
	playing = false
	crate.Model:PivotTo(restPose(idleT))
	if ClientState.InMatch() then
		-- a match started: don't bring the lobby screen back over it
		local playerGui = player:FindFirstChildOfClass("PlayerGui")
		local lobbyGui = playerGui and playerGui:FindFirstChild("Lobby")
		if lobbyGui then
			lobbyGui.Enabled = false
		end
	end
	CrateReveal.Black(0, 0.3).Completed:Wait()
	if not playing then
		CrateReveal.Hide()
	end
	finishing = false
end

----------------------------------------------------------------------------
-- The cinematic
----------------------------------------------------------------------------
local function play(result, continuing)
	local rarity = rarityById[result.Rarity] or CR.Rarities[1]
	local skin = skinById[result.Skin] or CR.Skins[1]
	local tier = tierOf[rarity.Id] or 1
	local isSecret = rarity.Id == "Secret"
	local big = tier >= 5

	playing = true
	waitingAgain = false
	if not continuing then
		takeOver()
	end
	local camera = workspace.CurrentCamera
	local altarCf = altar.CFrame
	local center = (altarCf * CFrame.new(0, HOVER + 1.6 * CRATE_SCALE, 0)).Position
	local camFrom = camera.CFrame
	local fov0 = saved.Fov

	scene = { Trash = {} }
	local function trash(item)
		table.insert(scene.Trash, item)
		return item
	end

	-- particles: sparks sucked in during the charge, a burst on the blast
	local fxPart = trash(newPart({ Transparency = 1, Size = Vector3.new(16, 16, 16), CFrame = CFrame.new(center) }))
	local inward, burst
	if Config.Effects.Particles then
		inward = Instance.new("ParticleEmitter")
		inward.Texture = Config.Effects.SparkTexture
		inward.Shape = Enum.ParticleEmitterShape.Sphere
		inward.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		inward.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		inward.Speed = NumberRange.new(12, 15)
		inward.Lifetime = NumberRange.new(0.5, 0.6)
		inward.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.45) })
		inward.LightEmission = 1
		inward.Rate = 0
		inward.Parent = fxPart
		local attachment = Instance.new("Attachment")
		attachment.Parent = fxPart
		burst = Instance.new("ParticleEmitter")
		burst.Texture = Config.Effects.SparkTexture
		burst.Speed = NumberRange.new(25, 60)
		burst.SpreadAngle = Vector2.new(180, 180)
		burst.Drag = 3
		burst.Acceleration = Vector3.new(0, -18, 0)
		burst.Lifetime = NumberRange.new(0.8, 1.8)
		burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
		burst.LightEmission = 1
		burst.Rate = 0
		burst.Parent = attachment
	end

	-- timeline: the climb slows down as it goes up (every step is a "will
	-- it go higher?"), then a tease where it flickers toward the next rarity
	-- and falls back, then a breath of silence before the blast
	local tIntro = continuing and 0.45 or 1.3
	local steps = {} -- { time, rarity, final }
	local climbTo = isSecret and 5 or tier
	-- (the Elite crate has no Common / Uncommon: its climb starts at Rare)
	local firstTier = result.CrateType == "Elite" and math.min(3, climbTo) or 1
	local stepCount = math.max(climbTo - firstTier + 1, 2) -- always build a little suspense
	local stepT = tIntro
	for k = 1, stepCount do
		local r = CR.Rarities[math.min(firstTier + k - 1, climbTo)]
		table.insert(steps, { T = stepT, Rarity = r, Final = (k == stepCount) and not isSecret })
		stepT += 0.55 + k * 0.14
	end
	local lastStep = steps[#steps].T
	local nextRarity = not isSecret and CR.Rarities[math.min(tier + 1, #CR.Rarities - 1)] or nil
	local teaseStart, teaseEnd
	if nextRarity and nextRarity ~= rarity then
		teaseStart = lastStep + 0.5
		teaseEnd = teaseStart + 0.9
	end
	local chargeEnd = (teaseEnd or lastStep + 0.6) + (big and 0.75 or 0.55)
	local stallStart, crackTime
	if isSecret then
		stallStart = lastStep + 0.5
		crackTime = stallStart + 1.3
		chargeEnd = crackTime + 0.7
	end
	local holdStart = chargeEnd - 0.5 -- everything stops, then BOOM
	local nextBeat = tIntro
	local tBurst = chargeEnd
	local tReveal = tBurst + 0.35
	local fired = {}
	local function once(key, t, now)
		if now >= t and not fired[key] then
			fired[key] = true
			return true
		end
		return false
	end

	local color = CR.Rarities[1].Color
	local spin, yaw = 0, 0
	local lidStart, lidVel, lidSpin
	local beam
	local rifle
	local shotFrom = altarCf * CFrame.new(3, 4.2, -12)
	local start = os.clock()
	if not continuing then
		Sfx.Play("CardFlip", { Pitch = 0.6, Volume = 1.4 })
	end

	scene.Connection = RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - start
		CrateReveal.Update(dt)

		-- rarity climb
		for i, step in ipairs(steps) do
			if once("step" .. i, step.T, t) then
				color = step.Rarity.Color
				CrateModel.SetColor(crate, color)
				if ring then
					ring.Color = color
				end
				CrateReveal.Tier(step.Rarity, step.Final)
				Sfx.Play("CardHover", { Pitch = 0.8 + i * 0.18, Volume = 2.2 })
				shockRing(altarCf.Position + Vector3.new(0, 0.2, 0), color, 10 + i * 3, 0.55)
				crate.Light.Brightness = 3
			end
		end
		crate.Light.Brightness = math.max(1.2, crate.Light.Brightness - dt * 6)
		-- a heartbeat that speeds up
		if t >= nextBeat and t < holdStart then
			local c = math.clamp((t - tIntro) / math.max(holdStart - tIntro, 0.1), 0, 1)
			Sfx.Play("KillThump", { Pitch = 0.75 + c * 0.25, Volume = 0.6 + c * 0.6 })
			nextBeat = t + (0.85 - c * 0.55)
		end
		-- the tease: flickers toward the next rarity... and falls back
		if teaseStart and t >= teaseStart and t < teaseEnd then
			local u = (t - teaseStart) / (teaseEnd - teaseStart)
			local on = math.sin(u * u * 70) > 0.2
			CrateModel.SetColor(crate, on and nextRarity.Color or rarity.Color)
			if ring then
				ring.Color = on and nextRarity.Color or rarity.Color
			end
			crate.Light.Brightness = on and 2.5 or 1.4
		end
		if teaseEnd and once("teaseEnd", teaseEnd, t) then
			CrateModel.SetColor(crate, rarity.Color)
			if ring then
				ring.Color = rarity.Color
			end
			Sfx.Play("Countdown", { Pitch = 0.6, Volume = 1.3 })
		end
		if once("hold", holdStart, t) then
			Sfx.Play("CardHover", { Pitch = 0.5, Volume = 2.5 })
		end
		if isSecret then
			if once("stall", stallStart, t) then
				-- "it's over"... everything goes dark
				CrateReveal.Stall()
				Sfx.Play("Countdown", { Pitch = 0.5, Volume = 1.5 })
			end
			if t >= stallStart and t < crackTime then
				local dim = Color3.fromRGB(30, 26, 30):Lerp(CR.Rarities[5].Color, math.random() < 0.08 and 0.6 or 0)
				CrateModel.SetColor(crate, dim)
				crate.Light.Brightness = 0
			end
			if once("crack", crackTime, t) then
				color = rarity.Color
				CrateModel.SetColor(crate, color)
				if ring then
					ring.Color = color
				end
				CrateReveal.Tier(rarity, true)
				CrateReveal.Flash(color, 0.35)
				Sfx.Play("Explosion", { Pitch = 0.5, Volume = 1.5 })
				shockRing(altarCf.Position + Vector3.new(0, 0.2, 0), color, 36, 0.7)
			end
		end

		-- the crate: lift, spin up, shake
		local charge = math.clamp((t - tIntro) / (chargeEnd - tIntro), 0, 1)
		local lift, shake = 0, 0
		if t < tBurst then
			lift = ease(charge) * 2.2
			shake = (charge ^ 2) * (big and 0.32 or 0.22)
			spin = 0.6 + charge ^ 2 * 14
			if isSecret and t >= stallStart and t < crackTime then
				spin, shake = 0.3, 0.02 -- the fake-out: it all winds down
			end
			local holding = t >= holdStart
			if holding then
				-- the breath before the blast: it stops dead and trembles
				local h = (t - holdStart) / (chargeEnd - holdStart)
				spin = 14 * (1 - h) ^ 3
				shake = 0.05 + h * 0.12
				lift += h * 0.4
			end
			if inward then
				inward.Color = ColorSequence.new(color)
				inward.Rate = (t > tIntro and not holding) and (20 + charge * 120) or 0
			end
		else
			local after = t - tBurst
			lift = 2.2 - ease(after / 0.8) * 1.4
			spin = math.max(0.5, 14 * (1 - after * 1.5))
		end
		yaw += spin * dt
		local pose = altarCf * CFrame.new(cameraShake(shake)) * CFrame.new(0, HOVER + lift, 0) * CFrame.Angles(0, yaw, 0)
		crate.Model:PivotTo(pose)
		if t < tBurst then
			CrateModel.SetLid(crate, charge > 0.3 and math.random() * charge * 9 or 0)
		end

		-- BURST
		if once("burst", tBurst, t) then
			if inward then
				inward.Rate = 0
			end
			if burst then
				burst.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
				burst:Emit(60 + tier * 25)
			end
			lidStart = crate.Lid:GetPivot()
			-- up and back, away from the camera (the crate's front faces the camera)
			lidVel = Vector3.new(math.random(-4, 4), 26, 0) + altarCf.LookVector * -9
			lidSpin = Vector3.new(math.random(4, 7), math.random(-3, 3), math.random(-2, 2))
			CrateReveal.Flash(Color3.new(1, 1, 1), big and 0.9 or 0.6)
			Sfx.Play("Explosion", { Pitch = 1.1, Volume = 1.3 })
			if tier >= 4 then
				Sfx.Play("CardLegendary", { Pitch = isSecret and 0.45 or 0.8, Volume = 1.2 })
			end
			shockRing(altarCf.Position + Vector3.new(0, 0.3, 0), color, 30 + tier * 8, 0.8)
			saved.CC.TintColor = color:Lerp(Color3.new(1, 1, 1), 0.5)
			saved.CC.Brightness = 0.5
			saved.CC.Saturation = 0.4
			TweenService:Create(saved.CC, TweenInfo.new(1.2), {
				TintColor = Color3.new(1, 1, 1),
				Brightness = 0,
				Saturation = 0.1,
			}):Play()
			-- pillar of light
			beam = trash(newPart({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(80, 0.5, 0.5),
				CFrame = CFrame.new(center + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.pi / 2),
				Color = color,
				Material = Enum.Material.Neon,
				Transparency = 0.1,
			}))
			TweenService:Create(beam, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { Size = Vector3.new(80, big and 6 or 4, big and 6 or 4) }):Play()
			task.delay(0.3, function()
				if beam.Parent then
					TweenService:Create(beam, TweenInfo.new(0.9), { Size = Vector3.new(80, 1.2, 1.2), Transparency = 0.45 }):Play()
				end
			end)
			-- light shafts for the top tiers
			if big then
				for k = 1, 6 do
					local shaft = trash(newPart({
						Size = Vector3.new(0.4, 30, 0.4),
						Color = color,
						Material = Enum.Material.Neon,
						Transparency = 0.35,
					}))
					shaft:SetAttribute("Angle", k * 60)
				end
			end
			local burstLight = Instance.new("PointLight")
			burstLight.Color = color
			burstLight.Range = 40
			burstLight.Brightness = 8
			burstLight.Parent = fxPart
			TweenService:Create(burstLight, TweenInfo.new(1.5), { Brightness = 1.5, Range = 24 }):Play()
		end
		if lidStart then
			local tau = t - tBurst
			local pos = lidStart.Position + lidVel * tau + Vector3.new(0, -45, 0) * tau * tau * 0.5
			crate.Lid:PivotTo(CFrame.new(pos) * lidStart.Rotation * CFrame.Angles(lidSpin.X * tau, lidSpin.Y * tau, lidSpin.Z * tau))
			if tau > 0.45 then
				CrateModel.SetFade(crate, math.clamp((tau - 0.45) / 0.4, 0, 1), true)
			end
		end
		-- spinning light shafts
		for _, item in ipairs(scene.Trash) do
			local angle = item:GetAttribute("Angle")
			if angle then
				local a = math.rad(angle) + t * 0.8
				item.CFrame = CFrame.new(center) * CFrame.Angles(0, a, 0) * CFrame.Angles(math.rad(28), 0, 0) * CFrame.new(0, 15, 0)
			end
		end

		-- REVEAL: the rifle (or knife) rises out of the crate and spins
		if once("reveal", tReveal, t) then
			rifle = buildRifle(skin, rarity)
			scene.Rifle = rifle
			CrateReveal.Reveal({
				Rarity = rarity,
				Skin = skin,
				New = result.New,
				Count = result.Count,
				Keys = result.Keys,
				Credits = result.Credits,
				CrateType = result.CrateType,
				Free = result.Free,
				CanAgain = result.CanAgain == true,
			})
			Sfx.Play(isSecret and "Victory" or "CardPick", { Pitch = 1, Volume = 1.2 })
		end
		if rifle then
			local r = t - tReveal
			local rise = ease(r / 0.9)
			local rifleCf = CFrame.new(center + Vector3.new(0, 0.5 + rise * 3.6 + math.sin(t * 2) * 0.15, 0))
				* CFrame.Angles(0, t * 1.1, 0)
				* CFrame.Angles(math.rad(-8), 0, math.rad(math.sin(t * 1.4) * 6))
			placeRifle(rifle, rifleCf)
		end

		-- CAMERA
		local shotCf
		if t < tIntro then
			local a = ease(t / tIntro)
			local target = CFrame.lookAt(shotFrom.Position, center)
			shotCf = camFrom:Lerp(target, a)
		elseif t < tBurst then
			local dolly = ease(charge) * 3.2
			local p = (altarCf * CFrame.new(3 - charge * 1.2, 4.2 - charge * 0.6, -12 + dolly)).Position
			shotCf = CFrame.lookAt(p, center + Vector3.new(0, lift * 0.6, 0))
		else
			-- pull back and drift round while the rifle shows off
			local after = t - tBurst
			local back = ease(after / 0.6)
			local orbit = math.rad(math.sin(after * 0.35) * 16)
			local local0 = CFrame.Angles(0, orbit, 0) * CFrame.new(2.2 - back * 1, 4.6 + back * 1.6, -9 - back * 4.5)
			local p = (altarCf * local0).Position
			shotCf = CFrame.lookAt(p, center + Vector3.new(0, 2.6 * math.min(1, after), 0))
		end
		local camShake = 0
		if t < tBurst then
			camShake = charge ^ 3 * (big and 0.18 or 0.1)
		else
			camShake = math.max(0, (big and 1.0 or 0.6) * (1 - (t - tBurst) / 0.7))
		end
		camera.CFrame = shotCf * CFrame.new(cameraShake(camShake))
		local fov = fov0
		if t < tBurst then
			fov = fov0 - charge * 12
		else
			local after = t - tBurst
			fov = fov0 + 10 * math.exp(-after * 3) - 2
		end
		camera.FieldOfView = fov
	end)
end

----------------------------------------------------------------------------
-- Input during the reveal
----------------------------------------------------------------------------
local function openAgain()
	if not playing or finishing or waitingAgain or not CrateReveal.CanAgain() then
		return
	end
	waitingAgain = true
	CrateReveal.HideCard()
	clearScene()
	crate.Model:PivotTo(restPose(idleT))
	Remotes.Get("CrateOpen"):FireServer(lastCrateType)
	-- no answer at all: give the view back (a stale timer can't end a later opening)
	againToken += 1
	local token = againToken
	task.delay(3, function()
		if waitingAgain and token == againToken then
			finish()
		end
	end)
end

local function onResult(result)
	if typeof(result) ~= "table" then
		return
	end
	if result.CrateType then
		lastCrateType = result.CrateType -- (OPEN ANOTHER opens the same kind)
	end
	if typeof(result.Skins) == "table" then
		ClientState.OwnedSkins = result.Skins -- (the Locker reads these)
		ClientState.SkinsChanged:Fire()
	end
	if result.Type == "Denied" then
		if waitingAgain then
			task.spawn(finish)
		end
		return
	end
	if result.Type ~= "Result" or not crate or ClientState.InMatch() then
		return
	end
	if playing and waitingAgain then
		waitingAgain = false
		play(result, true)
	elseif not playing and not finishing then
		play(result, false)
	else
		pendingResult = result
	end
end

function CrateController.Init(controllers)
	Controllers = controllers
end

function CrateController.Start()
	local playerGui = player:WaitForChild("PlayerGui")
	CrateReveal.Start(playerGui)
	CrateReveal.Again:Connect(openAgain)
	CrateReveal.Done:Connect(finish)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not playing or finishing or not CrateReveal.IsShowingButtons() then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.X or key == Enum.KeyCode.ButtonX then
			openAgain()
		elseif key == Enum.KeyCode.Space or key == Enum.KeyCode.Return or key == Enum.KeyCode.ButtonA or key == Enum.KeyCode.ButtonB then
			finish()
		end
	end)

	Remotes.Get("Crates").OnClientEvent:Connect(onResult)

	-- a match starting (or dying) mid-opening ends it at once
	ClientState.Changed:Connect(function(snapshot)
		if playing and snapshot.InMatch then
			task.spawn(finish)
		end
	end)

	task.spawn(function()
		if setupAltar() then
			RunService.RenderStepped:Connect(idle)
			RunService.RenderStepped:Connect(function()
				if not playing and not finishing and pendingResult and not ClientState.InMatch() then
					local result = pendingResult
					pendingResult = nil
					play(result, false)
				end
			end)
		end
	end)
end

return CrateController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">EffectsController</string>
            <string name="Source"><![CDATA[--[[
	EffectsController.lua  (Client.EffectsController)

	All local visual effects. Effects are built from glowing flat parts
	(Neon, so they bloom), Roblox's built-in particle textures (sparks and
	smoke) and short light flashes. Everything can be toned down in
	Config.Effects.

		shots       glowing tracers with a travelling bullet head, muzzle flash
		            light, impact sparks + smoke + light, ricochet / ghost marks
		explosions  fireball, shockwave ring, sparks, smoke, light, camera shake
		kills       the body shatters into flat shards, headshots get a red burst
		movement    landing dust ring, jump puff, slide dust
		powers      shrapnel, static zaps, blink trail, grapple rope, marks,
		            wallhack pulse, Bullet Time / Phantom Step tints

	Local effects live in a folder inside the camera so they never block
	bullets or movement raycasts.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.ClientState)
local Sfx = require(script.Parent.Sfx)

local Palette = Config.Palette
local FX = Config.Effects
local player = Players.LocalPlayer

local Effects = {}
local Controllers

local folder
local localRope = { Point = nil, Part = nil }
local enemyRopes = {} -- [userId] = { Point, Part }
local bulletTimeCC
local bulletTimeOn = false

----------------------------------------------------------------------------
-- Building blocks
----------------------------------------------------------------------------
local function getFolder()
	local camera = workspace.CurrentCamera
	if not folder or folder.Parent ~= camera then
		folder = Instance.new("Folder")
		folder.Name = "LocalEffects"
		folder.Parent = camera
	end
	return folder
end

-- An effect part. `glow` = Neon (blooms) when Config.Effects.NeonEffects is on.
local function fxPart(size, cf, color, shape, glow)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = (glow and FX.NeonEffects) and Enum.Material.Neon or Enum.Material.SmoothPlastic
	part.Size = size
	part.CFrame = cf
	part.Color = color
	if shape then
		part.Shape = shape
	end
	part.Parent = getFolder()
	return part
end

local function fadeOut(part, time, extraGoals, style)
	local goals = { Transparency = 1 }
	if extraGoals then
		for k, v in pairs(extraGoals) do
			goals[k] = v
		end
	end
	TweenService:Create(part, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goals):Play()
	Debris:AddItem(part, time + 0.1)
end

-- An invisible anchor at a world position (for particles, lights, sounds).
local function anchorAt(position, life)
	local attachment = Instance.new("Attachment")
	attachment.WorldPosition = position
	attachment.Parent = workspace.Terrain
	Debris:AddItem(attachment, life or 3)
	return attachment
end

--[[
	Particle burst using Roblox's built-in textures.
	kind: "Sparks" | "Smoke" | "Dust"
]]
local function emit(position, kind, color, count, direction)
	if not FX.Particles or count <= 0 then
		return
	end
	local attachment = anchorAt(position, 3)
	if direction and direction.Magnitude > 0.01 then
		attachment.WorldCFrame = CFrame.lookAt(position, position + direction) * CFrame.Angles(-math.pi / 2, 0, 0)
	end
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Color = ColorSequence.new(color)
	e.LightInfluence = 0
	if kind == "Sparks" then
		e.Texture = FX.SparkTexture
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) })
		e.Speed = NumberRange.new(18, 42)
		e.Lifetime = NumberRange.new(0.15, 0.4)
		e.SpreadAngle = direction and Vector2.new(55, 55) or Vector2.new(180, 180)
		e.Acceleration = Vector3.new(0, -60, 0)
		e.Drag = 3
	else -- Smoke / Dust
		e.Texture = FX.SmokeTexture
		e.LightEmission = 0
		local big = kind == "Smoke" and 3.5 or 2.2
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, big * 0.4), NumberSequenceKeypoint.new(1, big) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		e.Speed = NumberRange.new(2, kind == "Smoke" and 8 or 5)
		e.Lifetime = NumberRange.new(0.5, 1.1)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-40, 40)
		e.Drag = 2
	end
	e.Parent = attachment
	e:Emit(count)
end

-- A brief point-light flash (looks great with Future lighting).
local function lightFlash(position, color, brightness, range, time)
	if not FX.Lights then
		return
	end
	local attachment = anchorAt(position, time + 0.2)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness
	light.Range = range
	light.Shadows = false
	light.Parent = attachment
	TweenService:Create(light, TweenInfo.new(time, Enum.EasingStyle.Quad), { Brightness = 0 }):Play()
end

-- A glowing tracer line from a to b (thin hot core + soft outer glow).
local function tracer(a, b, color, thickness, life)
	local length = (b - a).Magnitude
	if length < 0.05 then
		return
	end
	local cf = CFrame.lookAt((a + b) / 2, b)
	local core = fxPart(Vector3.new(thickness, thickness, length), cf, color:Lerp(Color3.new(1, 1, 1), 0.4), nil, true)
	fadeOut(core, life, { Size = Vector3.new(0.02, 0.02, length) })
	local glow = fxPart(Vector3.new(thickness * 3.5, thickness * 3.5, length), cf, color, nil, true)
	glow.Transparency = 0.82
	fadeOut(glow, life * 0.6)
end

-- A glowing ball that flies along a path (the "bullet").
local function bulletHead(points, color)
	if #points < 2 then
		return
	end
	local head = fxPart(Vector3.new(0.35, 0.35, 2.2), CFrame.lookAt(points[1], points[2]), color, nil, true)
	task.spawn(function()
		for i = 1, #points - 1 do
			local a, b = points[i], points[i + 1]
			local time = math.min((b - a).Magnitude / 1400, 0.4)
			head.CFrame = CFrame.lookAt(a, b)
			local tween = TweenService:Create(head, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(b, b + (b - a)) })
			tween:Play()
			tween.Completed:Wait()
		end
		head:Destroy()
	end)
end

local function puff(position, color, size, life, glow)
	local ball = fxPart(Vector3.one * size, CFrame.new(position), color, Enum.PartType.Ball, glow)
	ball.Transparency = 0.15
	fadeOut(ball, life, { Size = Vector3.one * size * 3 })
end

local function ring(position, color, radius, life, glow)
	local disc = fxPart(
		Vector3.new(0.3, 2, 2),
		CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		Enum.PartType.Cylinder,
		glow
	)
	disc.Transparency = 0.25
	fadeOut(disc, life, { Size = Vector3.new(0.1, radius * 2, radius * 2) }, Enum.EasingStyle.Quint)
end

----------------------------------------------------------------------------
-- Shots
----------------------------------------------------------------------------

--[[
	Draws one bullet path.
	segments  list of { From, To, Kind }   (from Ballistics)
	passes    points where the bullet went through a wall (Ghost Round)
	startPos  where the tracer visually starts (gun muzzle)
	options   { Explosive = bool, HitPlayer = bool }
]]
function Effects.DrawShot(segments, passes, endPosition, endNormal, startPos, options)
	options = options or {}
	local headPoints = {}
	for i, seg in ipairs(segments) do
		local from = seg.From
		if i == 1 and startPos then
			from = startPos
		end
		table.insert(headPoints, from)
		local color = Palette.Tracer
		local thickness = 0.1
		if seg.Kind == "Bounce" then
			color = Palette.TracerBounce
			thickness = 0.16
		elseif options.Explosive then
			color = Palette.TracerExplosive
		end
		tracer(from, seg.To, color, thickness, seg.Kind == "Bounce" and 0.7 or 0.5)
		-- ricochet flash
		if segments[i + 1] and segments[i + 1].Kind == "Bounce" and (segments[i + 1].Hops or 0) > (seg.Hops or 0) then
			puff(seg.To, Palette.TracerBounce, 0.9, 0.3, true)
			emit(seg.To, "Sparks", Palette.TracerBounce, 10)
			lightFlash(seg.To, Palette.TracerBounce, 3, 10, 0.2)
		end
	end
	if #segments > 0 then
		table.insert(headPoints, segments[#segments].To)
		bulletHead(headPoints, options.Explosive and Palette.TracerExplosive or Palette.Tracer)
	end
	for _, p in ipairs(passes or {}) do
		puff(p, Palette.Hologram, 1.4, 0.4, true)
		emit(p, "Dust", Palette.Light, 6)
	end
	if endPosition then
		if options.HitPlayer then
			emit(endPosition, "Sparks", Color3.fromRGB(255, 120, 120), 16)
			lightFlash(endPosition, Color3.fromRGB(255, 120, 120), 3, 10, 0.2)
		else
			-- impact on the world: sparks bouncing off the surface + a dust puff
			emit(endPosition, "Sparks", Color3.fromRGB(255, 220, 160), 12, endNormal)
			emit(endPosition, "Dust", Palette.Light, 4)
			puff(endPosition, Palette.Tracer, 0.5, 0.2, true)
			lightFlash(endPosition, Color3.fromRGB(255, 220, 170), 2, 8, 0.15)
		end
	end
end

-- Muzzle flash light + smoke at a world position (your own gun or theirs).
-- Knife hits: sparks off a wall, a red burst on a body.
function Effects.KnifeImpact(position, normal, flesh)
	if flesh then
		emit(position, "Sparks", Color3.fromRGB(255, 70, 80), 14, normal)
		puff(position, Color3.fromRGB(255, 90, 100), 0.5, 0.18, true)
	else
		emit(position, "Sparks", Color3.fromRGB(255, 236, 190), 10, normal)
		lightFlash(position, Color3.fromRGB(255, 230, 180), 2, 8, 0.12)
	end
end

function Effects.MuzzleFlash(position, direction)
	lightFlash(position, Palette.MuzzleFlash, 6, 16, 0.08)
	emit(position, "Smoke", Color3.fromRGB(220, 220, 225), 3, direction)
end

-- Enemy shot from the server: start tracers at their gun's muzzle.
local function onEnemyShot(userId, bullets, explosive)
	local shooter = ClientState.FindPlayer(userId)
	local character = shooter and shooter.Character
	local muzzleAttachment = character
		and character:FindFirstChild("WorldGun")
		and character.WorldGun:FindFirstChild("Barrel")
		and character.WorldGun.Barrel:FindFirstChild("Muzzle")
	local muzzle = muzzleAttachment and muzzleAttachment.WorldPosition
	for _, bullet in ipairs(bullets) do
		Effects.DrawShot(bullet.Segments, bullet.Passes, bullet.EndPosition, bullet.EndNormal, muzzle, {
			Explosive = explosive,
			HitPlayer = bullet.HitPlayer,
		})
	end
	if muzzleAttachment then
		Sfx.Play("Fire", { Parent = muzzleAttachment, Volume = 1.4 })
		puff(muzzle, Palette.MuzzleFlash, 0.9, 0.12, true)
		Effects.MuzzleFlash(muzzle)
	end
end

----------------------------------------------------------------------------
-- Kills: the body shatters into flat shards
----------------------------------------------------------------------------
local function shatter(position, color, headshot)
	if not FX.KillShatter then
		return
	end
	puff(position, Color3.new(1, 1, 1), 3, 0.35, true)
	lightFlash(position, Color3.new(1, 1, 1), 4, 18, 0.3)
	emit(position, "Sparks", color, 24)
	for _ = 1, 14 do
		local size = 0.5 + math.random() * 0.8
		local shard = Instance.new("Part")
		shard.Size = Vector3.new(size, size, size)
		shard.CFrame = CFrame.new(position + Vector3.new(math.random() - 0.5, math.random() * 2 - 1, math.random() - 0.5) * 2)
			* CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		shard.Color = color
		shard.Material = Enum.Material.SmoothPlastic
		shard.CanCollide = true
		shard.CanQuery = false
		shard.CanTouch = false
		shard.CastShadow = true
		-- in workspace.Effects (ignored by bullets + movement) so physics runs
		shard.Parent = workspace:FindFirstChild("Effects") or getFolder()
		shard.AssemblyLinearVelocity = Vector3.new(math.random() - 0.5, 0.6 + math.random(), math.random() - 0.5).Unit
			* (25 + math.random() * 30)
		shard.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 30
		task.delay(1.4, function()
			if shard.Parent then
				fadeOut(shard, 0.6, { Size = Vector3.new(0.05, 0.05, 0.05) })
			end
		end)
	end
	if headshot then
		ring(position + Vector3.new(0, 1.5, 0), Palette.UIHeadshot, 7, 0.45, true)
	end
end

----------------------------------------------------------------------------
-- Movement dust (your own character)
----------------------------------------------------------------------------
local function feetPosition()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and (root.Position - Vector3.new(0, 3, 0)) or nil
end

local function onLanded(fallSpeed)
	local feet = feetPosition()
	if not feet or fallSpeed < 40 then
		return
	end
	local strength = math.clamp((fallSpeed - 40) / 60, 0, 1)
	ring(feet + Vector3.new(0, 0.2, 0), Palette.Light, 4 + strength * 7, 0.45)
	emit(feet, "Dust", Palette.Light, math.floor(4 + strength * 10))
end

local function onJumped()
	local feet = feetPosition()
	if feet then
		emit(feet, "Dust", Palette.Light, 3)
	end
end

local slideDustTimer = 0
local function updateMovementFx(dt)
	if Controllers.Movement.GetMode() ~= "Slide" then
		return
	end
	slideDustTimer += dt
	if slideDustTimer > 0.06 then
		slideDustTimer = 0
		local feet = feetPosition()
		if feet then
			emit(feet, "Dust", Palette.Light, 1)
			emit(feet, "Sparks", Color3.fromRGB(255, 220, 170), 2)
		end
	end
end

----------------------------------------------------------------------------
-- Grapple ropes
----------------------------------------------------------------------------
local function updateRope(rope, fromPos)
	if not rope.Point or not fromPos then
		if rope.Part then
			rope.Part:Destroy()
			rope.Part = nil
		end
		return
	end
	if not rope.Part then
		rope.Part = fxPart(Vector3.new(0.12, 0.12, 1), CFrame.identity, Palette.Grapple, nil, true)
	end
	local length = (rope.Point - fromPos).Magnitude
	rope.Part.Size = Vector3.new(0.12, 0.12, length)
	rope.Part.CFrame = CFrame.lookAt((rope.Point + fromPos) / 2, rope.Point)
end

function Effects.SetLocalGrapple(point)
	localRope.Point = point
	if point then
		puff(point, Palette.Grapple, 1.2, 0.3, true)
		emit(point, "Sparks", Palette.Grapple, 10)
	else
		updateRope(localRope, nil)
	end
end

----------------------------------------------------------------------------
-- Screen tints + power visuals
----------------------------------------------------------------------------
function Effects.SetBulletTime(on)
	bulletTimeOn = on
	if not bulletTimeCC then
		bulletTimeCC = Instance.new("ColorCorrectionEffect")
		bulletTimeCC.Name = "BulletTimeTint"
		bulletTimeCC.Parent = workspace.CurrentCamera
	end
	local goals = on
			and { Saturation = -0.45, Contrast = 0.15, TintColor = Color3.fromRGB(205, 225, 255) }
		or { Saturation = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) }
	TweenService:Create(bulletTimeCC, TweenInfo.new(on and 0.15 or 0.4), goals):Play()
	if on then
		Sfx.Play("Ability", { Pitch = 0.5, Volume = 1.5 })
	end
end

-- BLINK: a flash where you left and where you arrived, joined by a streak.
function Effects.Blink(from, to)
	if not from or not to then
		return
	end
	local color = Color3.fromRGB(190, 160, 255)
	puff(from, Palette.Hologram, 3, 0.35, true)
	puff(to, color, 3.5, 0.4, true)
	tracer(from, to, color, 0.5, 0.4)
	emit(from, "Sparks", Palette.Hologram, 14)
	emit(to, "Sparks", color, 18)
	lightFlash(to, color, 4, 16, 0.3)
	Sfx.PlayAt("Dash", to, { Pitch = 1.6 })
end

function Effects.IsBulletTimeVisible()
	return bulletTimeOn
end

function Effects.PhantomFlash()
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = Color3.fromRGB(190, 230, 255)
	cc.Saturation = -0.3
	cc.Parent = workspace.CurrentCamera
	local time = math.max(ClientState.Stats.PhantomTime, 0.3)
	TweenService:Create(cc, TweenInfo.new(time), { TintColor = Color3.new(1, 1, 1), Saturation = 0 }):Play()
	Debris:AddItem(cc, time + 0.1)
	local feet = feetPosition()
	if feet then
		emit(feet + Vector3.new(0, 2, 0), "Smoke", Palette.Hologram, 6)
	end
end

----------------------------------------------------------------------------
-- Wallhack Pulse
----------------------------------------------------------------------------
local function wallhackLoop()
	local elapsed = 0
	while true do
		elapsed += task.wait(0.25)
		-- Wallhack Pulse stacks pulse more often and for longer
		local stats = ClientState.Stats
		if not stats.WallhackPulse then
			elapsed = 0
		elseif elapsed >= stats.WallhackInterval and ClientState.CanShoot() then
			elapsed = 0
			-- the enemy in a match, the practice dummies in the lobby
			local targets = {}
			if ClientState.InMatch() then
				local opponent = ClientState.GetOpponentPlayer()
				table.insert(targets, opponent and opponent.Character)
			else
				local dummies = workspace:FindFirstChild("Dummies")
				for _, dummy in ipairs(dummies and dummies:GetChildren() or {}) do
					table.insert(targets, dummy)
				end
			end
			for _, target in ipairs(targets) do
				local highlight = Instance.new("Highlight")
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillColor = Palette.UIDanger
				highlight.FillTransparency = 0.6
				highlight.OutlineColor = Color3.new(1, 1, 1)
				highlight.OutlineTransparency = 0
				highlight.Adornee = target
				highlight.Parent = getFolder()
				Debris:AddItem(highlight, stats.WallhackDuration)
			end
			if #targets > 0 then
				Sfx.Play("Ability", { Pitch = 1.6, Volume = 0.5 })
			end
		end
	end
end

----------------------------------------------------------------------------
-- Server effects
----------------------------------------------------------------------------
local function onEffect(data)
	local t = data.Type
	if t == "Explosion" then
		local radius = data.Radius or 10
		local p = data.Position
		local ball = fxPart(Vector3.one * 2, CFrame.new(p), Palette.Explosion, Enum.PartType.Ball, true)
		ball.Transparency = 0.05
		fadeOut(ball, 0.5, { Size = Vector3.one * radius * 2 }, Enum.EasingStyle.Quint)
		local core = fxPart(Vector3.one * 2, CFrame.new(p), Color3.fromRGB(255, 240, 200), Enum.PartType.Ball, true)
		fadeOut(core, 0.25, { Size = Vector3.one * radius })
		ring(p, Palette.Explosion, radius * 1.4, 0.5, true)
		emit(p, "Sparks", Palette.Explosion, 36)
		emit(p, "Smoke", Color3.fromRGB(90, 92, 100), 14)
		lightFlash(p, Palette.Explosion, 8, radius * 3, 0.45)
		Sfx.PlayAt("Explosion", p)
		local camera = workspace.CurrentCamera
		local distance = (camera.CFrame.Position - p).Magnitude
		if distance < radius * 4 then
			Controllers.Camera.Shake(5 * (1 - distance / (radius * 4)))
		end
	elseif t == "Shockwave" then
		local ground = data.Position - Vector3.new(0, 2.5, 0)
		ring(ground, Palette.AccentB, data.Radius or 20, 0.55, true)
		ring(ground, Color3.new(1, 1, 1), (data.Radius or 20) * 0.6, 0.35, true)
		emit(ground, "Dust", Palette.Light, 18)
		lightFlash(ground, Palette.AccentB, 4, 24, 0.3)
		Sfx.PlayAt("Explosion", data.Position, { Pitch = 0.6 })
	elseif t == "DecoyPop" then
		puff(data.Position, Palette.Hologram, 3, 0.4, true)
		emit(data.Position, "Sparks", Palette.Hologram, 16)
	elseif t == "Kill" then
		shatter(data.Position, data.Color or Palette.PlayerB, data.Headshot)
	elseif t == "SecondWind" then
		if data.Position then
			puff(data.Position, Color3.fromRGB(90, 230, 140), 4, 0.6, true)
			emit(data.Position, "Sparks", Color3.fromRGB(90, 230, 140), 24)
		end
		if data.UserId == player.UserId then
			Controllers.HUD.Flash(Color3.fromRGB(90, 230, 140), "SECOND WIND")
		end
	elseif t == "Grapple" then
		enemyRopes[data.UserId] = enemyRopes[data.UserId] or {}
		enemyRopes[data.UserId].Point = data.Point
	elseif t == "Shards" then
		-- SHRAPNEL
		for _, seg in ipairs(data.Segments or {}) do
			tracer(seg.From, seg.To, Palette.TracerExplosive, 0.05, 0.3)
			emit(seg.To, "Sparks", Palette.TracerExplosive, 3)
		end
		if data.Segments and data.Segments[1] then
			Sfx.PlayAt("Hit", data.Segments[1].From, { Pitch = 2.2, Volume = 0.4 })
		end
	elseif t == "Zap" then
		-- STATIC CHARGE: a jagged bolt from the bullet path to the target
		local points = { data.From }
		for i = 1, 4 do
			local p = data.From:Lerp(data.To, i / 5)
			table.insert(points, p + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 1.8)
		end
		table.insert(points, data.To)
		for i = 1, #points - 1 do
			tracer(points[i], points[i + 1], Palette.Hologram, 0.12, 0.3)
		end
		puff(data.To, Palette.Hologram, 1.4, 0.3, true)
		emit(data.To, "Sparks", Palette.Hologram, 14)
		lightFlash(data.To, Palette.Hologram, 4, 14, 0.25)
		Sfx.PlayAt("Hit", data.To, { Pitch = 2.6, Volume = 0.6 })
	elseif t == "Mark" then
		-- MARKED: the target glows for you while the mark lasts
		if data.Target and data.Target.Parent then
			local existing = getFolder():FindFirstChild("Mark")
			if existing then
				existing:Destroy()
			end
			local highlight = Instance.new("Highlight")
			highlight.Name = "Mark"
			highlight.DepthMode = Enum.HighlightDepthMode.Occluded
			highlight.FillColor = Color3.fromRGB(255, 80, 80)
			highlight.FillTransparency = 0.55
			highlight.OutlineColor = Color3.fromRGB(255, 220, 220)
			highlight.Adornee = data.Target
			highlight.Parent = getFolder()
			Debris:AddItem(highlight, data.Duration or 4)
		end
	elseif t == "Blink" then
		Effects.Blink(data.From, data.To)
	elseif t == "GrappleEnd" then
		local rope = enemyRopes[data.UserId]
		if rope then
			rope.Point = nil
			updateRope(rope, nil)
		end
	end
end

local function updateRopes(dt)
	if not ClientState.IsFighting() then
		for _, rope in pairs(enemyRopes) do
			rope.Point = nil
			updateRope(rope, nil)
		end
	end
	if localRope.Point then
		updateRope(localRope, Controllers.Viewmodel.GetLeftHandPosition())
	end
	for userId, rope in pairs(enemyRopes) do
		local other = ClientState.FindPlayer(userId)
		local hand = other and other.Character and (other.Character:FindFirstChild("LeftHand") or other.Character:FindFirstChild("Left Arm"))
		updateRope(rope, hand and hand.Position or nil)
	end
	updateMovementFx(dt)
end

-- Legendary skins: their glowing trims pulse between two colours (parts
-- tagged "SkinPulse" by Skins.Apply, with PulseA / PulseB attributes).
local function pulseSkins()
	local k = (math.sin(os.clock() * 3) + 1) / 2
	for _, part in ipairs(CollectionService:GetTagged("SkinPulse")) do
		local a, b = part:GetAttribute("PulseA"), part:GetAttribute("PulseB")
		if part:IsA("BasePart") and typeof(a) == "Color3" and typeof(b) == "Color3" then
			part.Color = a:Lerp(b, k)
		end
	end
end

function Effects.Init(controllers)
	Controllers = controllers
end

function Effects.Start()
	Remotes.Get("ShotFx").OnClientEvent:Connect(onEnemyShot)
	Remotes.Get("Effect").OnClientEvent:Connect(onEffect)
	Controllers.Movement.Landed:Connect(onLanded)
	Controllers.Movement.Jumped:Connect(onJumped)
	RunService:BindToRenderStep("SniperEffects", Enum.RenderPriority.Camera.Value + 3, updateRopes)
	task.spawn(wallhackLoop)
	RunService.Heartbeat:Connect(pulseSkins)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">FirstPersonView</string>
            <string name="Source"><![CDATA[--[[
	FirstPersonView.lua  (Client.FirstPersonView)

	What you see in first person: slim copies of your own avatar's arms
	(skin colour, shirt and all) holding a copy of your own weapon (with
	your power-ups), drawn on the camera every frame so nothing lags.

	Your real character still does every move at full size; that's what
	everyone else sees (BodyAnimator). The copies play the SAME animation
	(WeaponAnim): the weapon goes exactly where it goes on your real body,
	and the arms reach it from shoulders just under the camera.

		FirstPersonView.Draw(source, view, anim, body)   -- each frame
		FirstPersonView.Hide()
		FirstPersonView.GetMuzzle() / GetKnifeTip()      -- (nil while hidden)

	source = the character whose arms and weapon to copy (you, or the kill
	cam's copy of your killer); view = the eyes (CFrame); anim = the
	WeaponAnim.Evaluate output.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local KnifeModel = require(Shared.KnifeModel)

local FP = Config.Body.FirstPerson
local V = Vector3.new
local rad = math.rad

local FirstPersonView = {}

local ARM_NAMES = { "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperArm", "LeftLowerArm", "LeftHand" }
local R6_ARMS = { Right = "Right Arm", Left = "Left Arm" }
local KEEP = { SurfaceAppearance = true, SpecialMesh = true, Decal = true, Texture = true }

local folder -- in the camera
local arms -- { Source, Model, Parts = {[name] = part}, Base = {[name] = size}, Dirty }
local weapons = {} -- [name] = { Source, Model, Root, Items = { {Part, Offset, Bolt} }, BoltRest, Muzzle, Tip }
local shown = false
local current -- the weapon copy drawn this frame

----------------------------------------------------------------------------
-- Building the copies
----------------------------------------------------------------------------
local function setup(part)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.LocalTransparencyModifier = 0
end

local function strip(part, keep)
	for _, child in ipairs(part:GetChildren()) do
		if not keep(child) then
			child:Destroy()
		end
	end
end

local function ensureFolder()
	local camera = workspace.CurrentCamera
	if not folder or folder.Parent ~= camera then
		if folder then
			folder:Destroy()
		end
		folder = Instance.new("Folder")
		folder.Name = "FirstPerson"
		folder.Parent = camera
		arms = nil
		table.clear(weapons)
	end
	return folder
end

-- plain blocks in the avatar's skin colour (characters without R15 arms)
local function plainArms(source, model)
	local colors = source:FindFirstChildOfClass("BodyColors")
	local parts, base = {}, {}
	for _, name in ipairs(ARM_NAMES) do
		local side = name:sub(1, 1) == "R" and "Right" or "Left"
		local part = Instance.new("Part")
		part.Name = name
		part.Size = V(1, 1, 1)
		local arm = source:FindFirstChild(R6_ARMS[side])
		part.Color = colors and colors[side .. "ArmColor3"] or (arm and arm.Color) or Color3.fromRGB(234, 184, 146)
		part.Material = Enum.Material.SmoothPlastic
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		setup(part)
		part.Parent = model
		parts[name] = part
		base[name] = V(1, name:find("Hand") and 0.35 or 1, 1)
	end
	return parts, base
end

local function buildArms(source)
	if arms then
		arms.Model:Destroy()
		if arms.Connection then
			arms.Connection:Disconnect()
		end
	end
	local model = Instance.new("Model")
	model.Name = "Arms"
	-- (a Humanoid in the model is what makes the shirt show up on the copies)
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.EvaluateStateMachine = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = model
	for _, item in ipairs(source:GetChildren()) do
		if item:IsA("Shirt") or item:IsA("BodyColors") then
			item:Clone().Parent = model
		end
	end
	local parts, base = {}, {}
	local ok = true
	for _, name in ipairs(ARM_NAMES) do
		local original = source:FindFirstChild(name)
		local copied, part = false, nil
		if original and original:IsA("BasePart") then
			copied, part = pcall(original.Clone, original)
		end
		if not copied or not part then
			ok = false
			break
		end
		strip(part, function(child)
			return KEEP[child.ClassName] == true
		end)
		setup(part)
		part.Transparency = 0
		part.Parent = model
		parts[name] = part
		base[name] = original.Size
	end
	if not ok then
		for _, part in pairs(parts) do
			part:Destroy()
		end
		parts, base = plainArms(source, model)
	end
	model.Parent = ensureFolder()
	arms = { Source = source, Model = model, Parts = parts, Base = base }
	-- the avatar's look can arrive after the character does: rebuild then
	local entry = arms
	entry.Connection = source.ChildAdded:Connect(function(child)
		if child:IsA("Shirt") or child:IsA("BodyColors") or table.find(ARM_NAMES, child.Name) then
			entry.Dirty = true
		end
	end)
end

local function weldedToBolt(part, boltRoot)
	if not boltRoot then
		return false
	end
	for _, item in ipairs(part:GetChildren()) do
		if item:IsA("WeldConstraint") or item:IsA("JointInstance") then
			if item.Part0 == boltRoot or item.Part1 == boltRoot then
				return true
			end
		end
	end
	return false
end

-- A copy of a held weapon (WorldGun / WorldKnife), every part at its offset
-- from the weapon's root (bolt parts from the bolt).
local function buildWeapon(source)
	local root = source:FindFirstChild("WeaponRoot")
	if not root then
		return nil
	end
	local boltRoot = source:FindFirstChild("BoltRoot")
	local boltJoint = root:FindFirstChild("BoltJoint")
	local model = Instance.new("Model")
	model.Name = source.Name
	local copy = { Source = source, Model = model, Items = {}, BoltRest = boltJoint and boltJoint.C0 or CFrame.new() }
	local count = 0
	for _, part in ipairs(source:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root and part ~= boltRoot then
			count += 1
			local onBolt = weldedToBolt(part, boltRoot)
			local from = onBolt and boltRoot.CFrame or root.CFrame
			local clone = part:Clone()
			strip(clone, function(child)
				return not (child:IsA("JointInstance") or child:IsA("WeldConstraint") or child:IsA("Constraint") or child:IsA("BasePart") or child:IsA("LuaSourceContainer"))
			end)
			setup(clone)
			clone.Transparency = part:GetAttribute("BaseTransparency") or part.Transparency
			clone.Parent = model
			table.insert(copy.Items, { Part = clone, Offset = from:ToObjectSpace(part.CFrame), Bolt = onBolt })
			if part.Name == "Barrel" then
				copy.Muzzle = clone:FindFirstChild("Muzzle")
			end
		end
	end
	copy.Count = count
	copy.Parts = table.create(#copy.Items)
	for i, item in ipairs(copy.Items) do
		copy.Parts[i] = item.Part
	end
	copy.CFrames = table.create(#copy.Items)
	copy.Fx = {} -- skin sparkles / power-up particles (switched on only while held)
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("ParticleEmitter") or item:IsA("Light") then
			table.insert(copy.Fx, item)
		end
	end
	model.Parent = ensureFolder()
	return copy
end

local function weaponCopy(source, name)
	local original = source:FindFirstChild(name)
	local copy = weapons[name]
	if copy and (copy.Source ~= original or not original) then
		copy.Model:Destroy()
		copy, weapons[name] = nil, nil
	end
	if original and not copy then
		copy = buildWeapon(original)
		weapons[name] = copy
	end
	return copy
end

----------------------------------------------------------------------------
-- Placing the arms
----------------------------------------------------------------------------
-- Where the elbow goes for a shoulder S and a wrist W (bending toward `pole`).
local function solveElbow(S, W, pole, upper, lower)
	local toW = W - S
	local d = math.clamp(toW.Magnitude, math.abs(upper - lower) + 0.01, upper + lower - 0.002)
	local dir = toW.Magnitude > 1e-4 and toW.Unit or V(0, -1, 0)
	local cosA = math.clamp((upper * upper + d * d - lower * lower) / (2 * upper * d), -1, 1)
	local sinA = math.sqrt(1 - cosA * cosA)
	local side = pole - dir * pole:Dot(dir)
	side = side.Magnitude > 1e-4 and side.Unit or V(0, -1, 0)
	return S + dir * upper * cosA + side * upper * sinA, side
end

-- Resizes a copied limb (rounded, so meshes aren't resized every frame).
local function resize(part, size)
	if (part.Size - size).Magnitude > 0.004 then
		part.Size = size
	end
end

-- A limb from a to b (its -Y runs a -> b), its front (-Z) facing `front`.
local function limb(name, a, b, front, thick)
	local part, base = arms.Parts[name], arms.Base[name]
	local length = math.max(math.floor((b - a).Magnitude * 20 + 0.5) / 20, 0.05)
	local k = thick / math.max(base.X, 0.01)
	resize(part, V(base.X * k, length, base.Z * k))
	local down = (b - a).Unit
	local z = -(front - down * front:Dot(down))
	z = z.Magnitude > 1e-3 and z.Unit or (math.abs(down.Y) < 0.9 and V(0, 1, 0):Cross(down).Unit or V(1, 0, 0))
	local y = -down
	return CFrame.fromMatrix((a + b) / 2, y:Cross(z), y, z)
end

local function placeArm(side, view, handCF, body, parts, cframes)
	local sx = side == "Right" and 1 or -1
	local look, down = view.LookVector, -view.UpVector
	-- the shoulders turn and lean with the body
	local lean = rad(body.Lean or 0)
	local chest = view
		* CFrame.new(0, FP.Shoulder.Y, FP.Shoulder.Z - (body.Forward or 0) - math.sin(lean) * 1.3)
		* CFrame.Angles(0, -rad(body.Yaw or 0), 0)
	local shoulder = (chest * CFrame.new(FP.Shoulder.X * sx, 0, 0)).Position

	local handName = side .. "Hand"
	local handBase = arms.Base[handName]
	-- a fist, not a flat plate: at least as deep and tall as most of its width
	local k = FP.HandWidth / math.max(handBase.X, 0.01)
	local w = FP.HandWidth
	local handSize = V(w, math.max(handBase.Y * k, w * 0.85), math.max(handBase.Z * k, w * 0.9))
	resize(arms.Parts[handName], handSize)
	local wrist = (handCF * CFrame.new(0, handSize.Y / 2, 0)).Position
	local pole = (view.RightVector * (0.7 * sx) + down - look * 0.15).Unit
	local elbow, bend = solveElbow(shoulder, wrist, pole, FP.UpperLength, FP.LowerLength)

	local upperDir = (elbow - shoulder).Unit
	local lowerDir = (wrist - elbow).Unit
	-- inner elbows face each other (falls back to away from the bend when straight)
	local upperFront = lowerDir - upperDir * lowerDir:Dot(upperDir)
	upperFront = upperFront.Magnitude > 0.05 and upperFront or -bend
	local lowerFront = -upperDir + lowerDir * upperDir:Dot(lowerDir)
	lowerFront = lowerFront.Magnitude > 0.05 and lowerFront or -bend

	local thick = FP.ArmThickness
	table.insert(parts, arms.Parts[handName])
	table.insert(cframes, handCF)
	table.insert(parts, arms.Parts[side .. "LowerArm"])
	table.insert(cframes, limb(side .. "LowerArm", elbow, wrist, lowerFront, thick * 0.92))
	table.insert(parts, arms.Parts[side .. "UpperArm"])
	table.insert(cframes, limb(side .. "UpperArm", shoulder, elbow, upperFront, thick))
end

----------------------------------------------------------------------------
-- API
----------------------------------------------------------------------------
local function setShown(value)
	if shown == value then
		return
	end
	shown = value
	if folder then
		for _, part in ipairs(folder:GetDescendants()) do
			if part:IsA("BasePart") then
				part.LocalTransparencyModifier = value and 0 or 1
			elseif not value and (part:IsA("ParticleEmitter") or part:IsA("Light")) then
				part.Enabled = false -- (Draw turns the held weapon's back on)
			end
		end
	end
end

function FirstPersonView.Hide()
	setShown(false)
	current = nil
end

-- weaponName: "WorldGun" or "WorldKnife"
function FirstPersonView.Draw(source, view, anim, body, weaponName)
	ensureFolder()
	if not arms or arms.Source ~= source or arms.Dirty or not arms.Model.Parent then
		buildArms(source) -- (new parts start visible)
	end
	setShown(true)
	local parts, cframes = {}, {}
	placeArm("Right", view, view * anim.Right, body or {}, parts, cframes)
	placeArm("Left", view, view * anim.Left, body or {}, parts, cframes)

	-- the weapon in hand; the other one is put away
	current = nil
	for _, name in ipairs({ "WorldGun", "WorldKnife" }) do
		local copy = weaponCopy(source, name)
		if copy then
			local held = name == weaponName
			for _, part in ipairs(copy.Parts) do
				part.LocalTransparencyModifier = held and 0 or 1
			end
			for _, fx in ipairs(copy.Fx) do
				if fx.Enabled ~= held then
					fx.Enabled = held
				end
			end
			if held then
				current = copy
				local root = view * anim.Weapon
				local bolt = root * copy.BoltRest * (anim.Bolt or CFrame.new())
				for i, item in ipairs(copy.Items) do
					copy.CFrames[i] = (item.Bolt and bolt or root) * item.Offset
				end
				copy.Root = root
				workspace:BulkMoveTo(copy.Parts, copy.CFrames, Enum.BulkMoveMode.FireCFrameChanged)
			end
		end
	end
	workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

function FirstPersonView.IsShown()
	return shown
end

function FirstPersonView.GetMuzzle()
	if shown and current and current.Muzzle then
		return current.Muzzle.WorldPosition
	end
	return nil
end

function FirstPersonView.GetKnifeTip()
	if shown and current and current.Source.Name == "WorldKnife" and current.Root then
		return (current.Root * CFrame.new(KnifeModel.Tip * Config.Knife.WorldScale)).Position
	end
	return nil
end

function FirstPersonView.GetLeftHand()
	if shown and arms and arms.Parts.LeftHand then
		return arms.Parts.LeftHand.Position
	end
	return nil
end

return FirstPersonView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Keybinds</string>
            <string name="Source"><![CDATA[--[[
	Keybinds.lua  (Client.Keybinds)

	Every rebindable action with its default KEYBOARD and CONTROLLER
	binding. Players change them in Settings (P) > Keyboard / Controller,
	and they're saved with the other settings.

	A binding is the name of an Enum.KeyCode ("Space", "ButtonA") or of a
	mouse Enum.UserInputType ("MouseButton1").

	Moving (WASD / left stick) and looking (mouse / right stick) are not
	rebindable.

	Usage:  if Keybinds.Matches("Jump", input) then ... end
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.ClientState)
local Signal = require(ReplicatedStorage:WaitForChild("Shared").Signal)

local Keybinds = {}

-- On-screen buttons (mobile) press actions through these. Every place that
-- listens to UserInputService.InputBegan/Ended for an action also listens
-- here, so a button press runs exactly the same code as the key.
Keybinds.VirtualBegan = Signal.new() -- (fakeInput, processed)
Keybinds.VirtualEnded = Signal.new()

function Keybinds.Press(actionId, down)
	local fake = {
		Action = actionId,
		UserInputType = Enum.UserInputType.Touch,
		KeyCode = Enum.KeyCode.Unknown,
		Position = Vector3.zero,
		Delta = Vector3.zero,
	}
	if down then
		Keybinds.VirtualBegan:Fire(fake, false)
	else
		Keybinds.VirtualEnded:Fire(fake, false)
	end
end

Keybinds.Actions = {
	{ Id = "Fire", Name = "Fire", Keyboard = "MouseButton1", Gamepad = "ButtonR2" },
	{ Id = "Scope", Name = "Scope", Keyboard = "MouseButton2", Gamepad = "ButtonL2" },
	{ Id = "Jump", Name = "Jump / Bunny hop", Keyboard = "Space", Gamepad = "ButtonA" },
	{ Id = "Slide", Name = "Slide", Keyboard = "C", Gamepad = "ButtonB" },
	{ Id = "Sprint", Name = "Sprint", Keyboard = "LeftShift", Gamepad = "ButtonL3" },
	{ Id = "Grapple", Name = "Grapple (power-up)", Keyboard = "E", Gamepad = "ButtonY" },
	{ Id = "Blink", Name = "Blink (power-up)", Keyboard = "R", Gamepad = "ButtonX" },
	{ Id = "Decoy", Name = "Decoy (power-up)", Keyboard = "Q", Gamepad = "DPadUp" },
	{ Id = "Inspect", Name = "Inspect weapon", Keyboard = "V", Gamepad = "DPadDown" },
	{ Id = "Primary", Name = "Sniper", Keyboard = "One", Gamepad = "ButtonR1" },
	{ Id = "Knife", Name = "Knife", Keyboard = "Two", Gamepad = "ButtonR1" },
	{ Id = "PowerUpLab", Name = "Power-Up Lab", Keyboard = "B", Gamepad = "DPadLeft" },
	{ Id = "Locker", Name = "Locker (skins)", Keyboard = "L", Gamepad = "None" },
	{ Id = "Shop", Name = "Shop (crates, credits, VIP)", Keyboard = "M", Gamepad = "None" },
	{ Id = "FindMatch", Name = "Find match", Keyboard = "F", Gamepad = "DPadRight" },
	{ Id = "Playground", Name = "Playground", Keyboard = "G", Gamepad = "ButtonL1" },
	{ Id = "BotMatch", Name = "Play vs bot (admin)", Keyboard = "N", Gamepad = "None" }, -- (RB is the knife)
	{ Id = "DuelFriend", Name = "Duel a player", Keyboard = "U", Gamepad = "ButtonR3" },
	{ Id = "Rematch", Name = "Rematch", Keyboard = "T", Gamepad = "DPadUp" },
	{ Id = "Settings", Name = "Settings", Keyboard = "P", Gamepad = "ButtonSelect" },
}

Keybinds.ById = {}
for _, action in ipairs(Keybinds.Actions) do
	Keybinds.ById[action.Id] = action
end

-- The current binding name for an action on a device ("Keyboard" or "Gamepad").
function Keybinds.Get(actionId, device)
	local binds = ClientState.Settings.Binds
	local custom = binds and binds[device] and binds[device][actionId]
	local action = Keybinds.ById[actionId]
	return custom or (action and action[device])
end

local function inputName(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
		return t.Name
	end
	return input.KeyCode.Name
end
Keybinds.InputName = inputName

local function isGamepad(input)
	return input.UserInputType.Name:find("Gamepad") ~= nil
end
Keybinds.IsGamepad = isGamepad

-- True if `input` is the key / button bound to `actionId`.
function Keybinds.Matches(actionId, input)
	if typeof(input) == "table" then
		return input.Action == actionId -- a virtual (on-screen button) press
	end
	local device = isGamepad(input) and "Gamepad" or "Keyboard"
	local bound = Keybinds.Get(actionId, device)
	return bound ~= nil and bound == inputName(input)
end

-- Short label for a binding ("MouseButton1" -> "LMB", "ButtonA" -> "A").
function Keybinds.Label(name)
	local labels = {
		MouseButton1 = "LMB",
		MouseButton2 = "RMB",
		MouseButton3 = "MMB",
		LeftShift = "L-SHIFT",
		RightShift = "R-SHIFT",
		LeftControl = "L-CTRL",
		RightControl = "R-CTRL",
		ButtonR2 = "RT / R2",
		ButtonL2 = "LT / L2",
		ButtonR1 = "RB / R1",
		ButtonL1 = "LB / L1",
		ButtonR3 = "R-STICK",
		ButtonL3 = "L-STICK",
		ButtonA = "A / X",
		ButtonB = "B / O",
		ButtonX = "X / []",
		ButtonY = "Y / ^",
		ButtonSelect = "SELECT",
		DPadUp = "D-UP",
		DPadDown = "D-DOWN",
		DPadLeft = "D-LEFT",
		DPadRight = "D-RIGHT",
		None = "-",
	}
	return labels[name] or string.upper(name or "-")
end

return Keybinds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">KillCamController</string>
            <string name="Source"><![CDATA[--[[
	KillCamController.lua  (Client.KillCamController)

	When your opponent kills you in a match, you watch the last few seconds
	again through THEIR eyes: where they were, where they were aiming, their
	shot flying at a ghost of you, ending in slow motion on the kill. Then
	the camera cuts round to face the winner, who strikes a victory pose
	(rifle up on the shoulder or knife raised, fist in the air).

	How it works (all on your client, nothing extra is sent):
	  * Every frame of a round we record your opponent's head position,
	    facing and aim pitch (the "AimPitch" attribute everyone already
	    shares), plus your own position, into a short rolling buffer.
	  * Their shots (the ShotFx remote) are recorded with a timestamp.
	  * When the server tells you that you died from a hit (Damaged with
	    Killed = true), we replay the buffer: the camera rides along their
	    head, with THEIR arms (a copy of their avatar's arms) holding THEIR
	    rifle (with their power-ups) in view, kicking and cycling the bolt on
	    every shot. A copy of your real character runs, jumps and aims where
	    you did, with Roblox's normal animations and the rifle-holding pose,
	    and their shot tracers are drawn again at the right moment.

	Press Space / tap the screen to skip. Tune it in Config.KillCam.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local PowerUps = require(Shared.PowerUps)
local ClientState = require(script.Parent.ClientState)
local Theme = require(script.Parent.ui.Theme)

local K = Config.KillCam
local Palette = Config.Palette
local player = Players.LocalPlayer

local KillCam = {}
local Controllers

local BUFFER_SECONDS = 4
local samples = {} -- { T, Head (Vector3), Yaw, Pitch, Me (CFrame), MyPitch, MyAir }
local shots = {} -- { T, Bullets, Explosive }
local playing = false
local stopRequested = false
local gui, banner, killerLabel, vignette
local ghostTemplate -- a copy of you made at the start of each round (before you can die)
local ghostAnims = {} -- { idle = id, run = id, fall = id, ... } from your character's Animate script

-- Roblox's default R15 animations, in case your character has no Animate script
local DEFAULT_ANIMS = {
	idle = "rbxassetid://507766388",
	walk = "rbxassetid://507777826",
	run = "rbxassetid://507767714",
	jump = "rbxassetid://507765000",
	fall = "rbxassetid://507767968",
}

local function now()
	return os.clock()
end

local function trim(list)
	local cutoff = now() - BUFFER_SECONDS
	while list[1] and list[1].T < cutoff do
		table.remove(list, 1)
	end
end

local function opponentCharacter()
	local opponent = ClientState.GetOpponentPlayer()
	return opponent and opponent.Character
end

local function record()
	if playing or not ClientState.InMatch() or not ClientState.IsFighting() then
		return
	end
	local enemy = opponentCharacter()
	local head = enemy and enemy:FindFirstChild("Head")
	local enemyRoot = enemy and enemy:FindFirstChild("HumanoidRootPart")
	local me = player.Character
	local myRoot = me and me:FindFirstChild("HumanoidRootPart")
	if not head or not enemyRoot or not myRoot then
		return
	end
	local look = enemyRoot.CFrame.LookVector
	local myHumanoid = me:FindFirstChildOfClass("Humanoid")
	table.insert(samples, {
		T = now(),
		Head = head.Position + Vector3.new(0, 0.3, 0),
		Yaw = math.atan2(-look.X, -look.Z),
		Pitch = enemy:GetAttribute("AimPitch") or 0,
		Me = myRoot.CFrame,
		MyPitch = me:GetAttribute("AimPitch") or 0,
		MyAir = myHumanoid ~= nil and myHumanoid.FloorMaterial == Enum.Material.Air,
		Weapon = enemy:GetAttribute("Weapon") or "Sniper",
		Swing = enemy:GetAttribute("Swing"),
		SwingKind = enemy:GetAttribute("SwingKind"),
	})
	trim(samples)
end

-- The recorded state at time t (blended between the two nearest samples).
local function sampleAt(t)
	local count = #samples
	if count == 0 then
		return nil
	end
	if t <= samples[1].T then
		return samples[1]
	end
	for i = 2, count do
		local b = samples[i]
		if b.T >= t then
			local a = samples[i - 1]
			local alpha = (t - a.T) / math.max(b.T - a.T, 1e-4)
			local yawDelta = (b.Yaw - a.Yaw + math.pi) % (2 * math.pi) - math.pi
			return {
				Head = a.Head:Lerp(b.Head, alpha),
				Yaw = a.Yaw + yawDelta * alpha,
				Pitch = a.Pitch + (b.Pitch - a.Pitch) * alpha,
				Me = a.Me:Lerp(b.Me, alpha),
				MyPitch = a.MyPitch + (b.MyPitch - a.MyPitch) * alpha,
				MyAir = alpha < 0.5 and a.MyAir or b.MyAir,
				Weapon = b.Weapon,
				Swing = b.Swing,
				SwingKind = b.SwingKind,
			}
		end
	end
	return samples[count]
end

-- The animation ids your character uses (its Animate script's values).
local function readAnimations(character)
	local found = {}
	local animate = character:FindFirstChild("Animate")
	if animate then
		for name in pairs(DEFAULT_ANIMS) do
			local value = animate:FindFirstChild(name)
			local animation = value and value:FindFirstChildOfClass("Animation")
			if animation and animation.AnimationId ~= "" then
				found[name] = animation.AnimationId
			end
		end
	end
	for name, id in pairs(DEFAULT_ANIMS) do
		found[name] = found[name] or id
	end
	return found
end

-- A copy of your real character (avatar, clothes, rifle), still rigged so it
-- can be animated. Only the root is anchored; the kill cam moves it.
local function copyCharacter(character)
	if not character then
		return nil
	end
	local wasArchivable = character.Archivable
	character.Archivable = true
	local ok, ghost = pcall(function()
		return character:Clone()
	end)
	character.Archivable = wasArchivable
	if not ok or not ghost then
		return nil
	end
	for _, item in ipairs(ghost:GetDescendants()) do
		if item:IsA("Script") or item:IsA("LocalScript") or item:IsA("Highlight") or item:IsA("ParticleEmitter") or item:IsA("Sound") then
			item:Destroy()
		elseif item:IsA("BasePart") then
			item.Anchored = item.Name == "HumanoidRootPart"
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
			item.Massless = true
			item.LocalTransparencyModifier = 0
		end
	end
	local humanoid = ghost:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.EvaluateStateMachine = false
		humanoid.BreakJointsOnDeath = false
		if not humanoid:FindFirstChildOfClass("Animator") then
			Instance.new("Animator").Parent = humanoid
		end
	end
	-- a thin outline so you can spot yourself, but it's still your character
	local outline = Instance.new("Highlight")
	outline.FillTransparency = 1
	outline.OutlineColor = Palette.PlayerB
	outline.OutlineTransparency = 0.25
	outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	outline.Parent = ghost
	ghost.Name = "KillCamGhost"
	return ghost
end

-- A copy of you made at round start (before you can die).
local function makeGhost()
	if not player.Character then
		return nil
	end
	ghostAnims = readAnimations(player.Character)
	return copyCharacter(player.Character)
end

-- Loads idle / run / fall tracks on the ghost. Returns a function that picks
-- the right one for the current speed.
local function animateGhost(ghost)
	local humanoid = ghost:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return function() end
	end
	local tracks = {}
	for _, name in ipairs({ "idle", "run", "fall" }) do
		local animation = Instance.new("Animation")
		animation.AnimationId = ghostAnims[name] or DEFAULT_ANIMS[name]
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			track.Looped = true
			tracks[name] = track
		end
	end
	local current
	return function(speed, inAir, rate)
		local want = inAir and "fall" or (speed > 2 and "run" or "idle")
		local track = tracks[want]
		if want ~= current then
			if current and tracks[current] then
				tracks[current]:Stop(0.15)
			end
			if track then
				track:Play(0.15)
			end
			current = want
		end
		if track then
			local base = want == "run" and math.clamp(speed / 16, 0.5, 2.2) or 1
			track:AdjustSpeed(base * rate)
		end
	end
end

local function setCharacterHidden(character, hidden)
	if not character then
		return
	end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") then
			part.LocalTransparencyModifier = hidden and 1 or 0
		end
	end
end

local function play(deathTime, killerName)
	if playing or #samples < 5 then
		return
	end
	playing = true
	stopRequested = false
	local camera = workspace.CurrentCamera
	local enemy = opponentCharacter()
	local ghost = ghostTemplate and ghostTemplate:Clone()
	local setGhostAnim = function() end
	if ghost then
		ghost:PivotTo(samples[1].Me) -- don't flash at the round-start spot
		ghost.Parent = workspace
		setGhostAnim = animateGhost(ghost)
	end
	local recordedShots = table.clone(shots)
	local drawn = {}

	-- the killer: a copy of their real character, placed where they were,
	-- seen from inside their head (only their arms + weapon show)
	local killerCopy = copyCharacter(enemy)
	if killerCopy then
		killerCopy.Name = "KillCamKiller"
		local outline = killerCopy:FindFirstChildOfClass("Highlight")
		if outline then
			outline:Destroy()
		end
		for _, part in ipairs(killerCopy:GetDescendants()) do
			if part:IsA("BasePart") then
				part.LocalTransparencyModifier = 1
			elseif part:IsA("Decal") then
				part.Transparency = 1
			end
		end
		killerCopy:PivotTo(CFrame.new(samples[1].Head - Vector3.new(0, 1.5, 0)))
		killerCopy.Parent = workspace
		Controllers.Viewmodel.Track(killerCopy)
	end
	if ghost then
		Controllers.Viewmodel.Track(ghost) -- your copy holds its weapon + aims like you did
	end

	-- the killer's arms + rifle on our camera (built before we hide them)
	local entry = ClientState.GetOpponentEntry()
	local owned = entry and entry.PowerUps or {}
	local boltTime = PowerUps.ComputeStats(owned).BoltTime or 1
	local okPuppet, puppetErr = pcall(Controllers.Viewmodel.SetPuppet, { Character = killerCopy, Owned = owned })
	if not okPuppet then
		warn("[KillCam]", puppetErr)
	end

	Controllers.Camera.SetSuspended(true)
	local oldType, oldFov = camera.CameraType, camera.FieldOfView
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = K.FieldOfView
	setCharacterHidden(enemy, true) -- we're inside their head
	setCharacterHidden(player.Character, true)

	killerLabel.Text = "KILLED BY " .. string.upper(killerName or "YOUR OPPONENT")
	gui.Enabled = true
	banner.Position = UDim2.new(0.5, 0, 0, -80)
	Theme.tween(banner, 0.35, { Position = UDim2.new(0.5, 0, 0, 40) }, Enum.EasingStyle.Back)

	-- the killer's weapon + knife swings, as recorded
	local shownWeapon = Controllers.Viewmodel.GetWeapon() -- (you may have died holding the knife)
	local lastSwing = nil
	local function showWeapon(name)
		if name ~= shownWeapon then
			shownWeapon = name
			pcall(Controllers.Viewmodel.SetWeapon, name)
		end
	end
	local replayT = deathTime - K.Length
	local finish = deathTime + 0.5
	local victoryAt -- os.clock() when the victory pose started
	local rate = 1
	local current -- the sample for this frame


	local function stop()
		RunService:UnbindFromRenderStep("SniperKillCam")
		-- give the camera back first, so nothing below can leave it stuck
		camera.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
		camera.FieldOfView = oldFov
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
		Controllers.Camera.SetSuspended(false)
		playing = false
		gui.Enabled = false
		if ghost then
			Controllers.Viewmodel.Untrack(ghost)
			ghost:Destroy()
		end
		if killerCopy then
			Controllers.Viewmodel.Untrack(killerCopy)
			killerCopy:Destroy()
		end
		setCharacterHidden(enemy, false)
		local ok, err = pcall(Controllers.Viewmodel.SetPuppet, nil)
		if not ok then
			warn("[KillCam]", err)
		end
		pcall(Controllers.Viewmodel.SetWeapon, ClientState.Weapon or "Sniper") -- (yours, now the puppet is gone)
	end

	-- runs just before the viewmodel (Camera + 2), so the arms use this frame's camera
	local frame
	RunService:BindToRenderStep("SniperKillCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
		-- an error mid-replay must never leave the camera stuck
		local ok, err = pcall(frame, dt)
		if not ok then
			warn("[KillCam]", err)
			stop()
		end
	end)
	-- the cut to the winner's victory pose (their copy, seen from the front)
	local function startVictory()
		victoryAt = os.clock()
		pcall(Controllers.Viewmodel.SetPuppet, nil) -- (now it's seen from outside)
		for _, part in ipairs(killerCopy:GetDescendants()) do
			if part:IsA("BasePart") then
				part.LocalTransparencyModifier = 0
			elseif part:IsA("Decal") then
				part.Transparency = 0
			end
		end
		killerCopy:SetAttribute("AimPitch", 0)
		Controllers.Viewmodel.PlayVictory(killerCopy)
		vignette.BackgroundTransparency = 0.8
		killerLabel.Text = string.upper(killerName or "YOUR OPPONENT") .. " TAKES THE ROUND"
	end

	frame = function(dt)
		if victoryAt then
			local v = os.clock() - victoryAt
			local root = killerCopy:GetPivot()
			local head = root.Position + Vector3.new(0, 1.3, 0)
			local a = math.min(v / K.VictoryTime, 1)
			local from = root * CFrame.new(2.2 - a * 0.6, 2.2 - a * 0.3, -7.5 + a * 1.4) -- in front, slowly pushing in
			camera.CFrame = CFrame.lookAt(from.Position, head)
			camera.FieldOfView = 50
			local phase = ClientState.Snapshot.Phase
			if v >= K.VictoryTime or stopRequested or not ClientState.InMatch() or (phase ~= "RoundEnd" and phase ~= "Fight") then
				stop()
			end
			return
		end
		local slow = replayT > deathTime - K.SlowMoTime and replayT < deathTime + 0.3
		rate = slow and K.SlowMoSpeed or 1
		replayT += dt * rate
		vignette.BackgroundTransparency = slow and 0.6 or 0.85
		local at = math.min(replayT, deathTime)
		local s = sampleAt(at)
		current = s
		if s then
			showWeapon(s.Weapon or "Sniper")
			if s.Swing ~= lastSwing then
				if lastSwing ~= nil and s.Weapon == "Knife" then
					Controllers.Viewmodel.PlayKnife(s.SwingKind or "Slash")
				end
				lastSwing = s.Swing
			end
			local eye = CFrame.new(s.Head) * CFrame.fromOrientation(s.Pitch, s.Yaw, 0)
			camera.CFrame = eye * CFrame.new(0, 0, Controllers.Viewmodel.EyeBack or 0.5) -- framed like first person
			if killerCopy then
				killerCopy:PivotTo(CFrame.new(s.Head - Vector3.new(0, 1.5, 0)) * CFrame.fromOrientation(0, s.Yaw, 0))
			end
			-- how fast they were moving (walk bob on their arms)
			local before = sampleAt(at - 0.1)
			if before then
				local d = (s.Head - before.Head) * Vector3.new(1, 0, 1)
				Controllers.Viewmodel.SetPuppetSpeed(d.Magnitude / 0.1)
			end
			if ghost then
				ghost:PivotTo(s.Me)
				ghost:SetAttribute("AimPitch", s.MyPitch or 0)
				local prev = sampleAt(at - 0.1)
				local speed = prev and ((s.Me.Position - prev.Me.Position) * Vector3.new(1, 0, 1)).Magnitude / 0.1 or 0
				setGhostAnim(speed, s.MyAir, rate)
			end
		end
		for i, shot in ipairs(recordedShots) do
			if not drawn[i] and shot.T <= replayT and shot.T >= deathTime - K.Length then
				drawn[i] = true
				Controllers.Viewmodel.PlayFire(false)
				task.delay(0.12 / rate, function()
					if playing then
						Controllers.Viewmodel.PlayBolt(boltTime / rate)
					end
				end)
				local muzzle = Controllers.Viewmodel.GetMuzzlePosition()
					or (camera.CFrame.Position + camera.CFrame.LookVector * 1.5 - camera.CFrame.UpVector * 0.4)
				for _, bullet in ipairs(shot.Bullets) do
					Controllers.Effects.DrawShot(bullet.Segments, bullet.Passes, bullet.EndPosition, bullet.EndNormal, muzzle, {
						Explosive = shot.Explosive,
						HitPlayer = bullet.HitPlayer,
					})
				end
			end
		end
		local phase = ClientState.Snapshot.Phase
		if killerCopy and not stopRequested and replayT >= deathTime + 0.15 and (K.VictoryTime or 0) > 0 then
			startVictory()
		elseif replayT >= finish or stopRequested or not ClientState.InMatch() or (phase ~= "RoundEnd" and phase ~= "Fight") then
			stop()
		end
	end
end

function KillCam.IsPlaying()
	return playing
end

function KillCam.Init(controllers)
	Controllers = controllers
end

function KillCam.Start()
	local playerGui = player:WaitForChild("PlayerGui")
	gui = Theme.screen("KillCam", 6, playerGui)
	gui.Enabled = false
	vignette = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		Parent = gui,
	})
	for _, y in ipairs({ 0, 1 }) do -- letterbox bars
		Theme.new("Frame", {
			AnchorPoint = Vector2.new(0, y),
			Position = UDim2.fromScale(0, y),
			Size = UDim2.new(1, 0, 0.07, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			Parent = gui,
		})
	end
	banner = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		Size = UDim2.fromOffset(420, 70),
		BackgroundColor3 = Palette.UIPanel,
		Parent = gui,
	})
	Theme.stroke(banner, Palette.PlayerB, 2, 0.1)
	Theme.label({
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromOffset(0, 8),
		Text = "KILL CAM",
		TextSize = 16,
		TextColor3 = Palette.PlayerB,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = banner,
	})
	killerLabel = Theme.label({
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 30),
		TextSize = 24,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = banner,
	})
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(300, 20),
		Text = "SPACE / TAP TO SKIP",
		TextSize = 14,
		TextColor3 = Palette.UISubText,
		Parent = gui,
	})
	-- crosshair dot: their aim
	local dot = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Palette.PlayerB,
		Parent = gui,
	})
	Theme.corner(dot, UDim.new(0.5, 0))

	RunService.RenderStepped:Connect(record)

	-- record the opponent's shots
	Remotes.Get("ShotFx").OnClientEvent:Connect(function(userId, bullets, explosive)
		local opponent = ClientState.GetOpponentEntry()
		if opponent and opponent.UserId == userId and typeof(bullets) == "table" then
			table.insert(shots, { T = now(), Bullets = bullets, Explosive = explosive })
			trim(shots)
		end
	end)

	-- you died from a hit in a match -> play it back
	Remotes.Get("Damaged").OnClientEvent:Connect(function(data)
		if not K.Enabled or typeof(data) ~= "table" or not data.Killed or not ClientState.InMatch() then
			return
		end
		local deathTime = now()
		local opponent = ClientState.GetOpponentEntry()
		task.delay(K.Delay, function()
			if ClientState.InMatch() then
				play(deathTime + 0.1, opponent and opponent.Name)
			end
		end)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not playing then
			return
		end
		if input.KeyCode == Enum.KeyCode.Space or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.ButtonA then
			stopRequested = true
		end
	end)

	-- a new round clears the buffers
	ClientState.Changed:Connect(function(snapshot, old)
		if snapshot.Phase == "Countdown" and (not old or old.Phase ~= "Countdown") then
			samples = {}
			shots = {}
		end
		if snapshot.Phase == "Fight" and (not old or old.Phase ~= "Fight") then
			if ghostTemplate then
				ghostTemplate:Destroy()
			end
			ghostTemplate = makeGhost()
		end
	end)
end

return KillCam
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">KnifeController</string>
            <string name="Source"><![CDATA[--[[
	KnifeController.lua  (Client.KnifeController)

	Your second weapon: the combat knife (Config.Knife).
		1 / 2 / mouse wheel   switch rifle <-> knife (ButtonR1 on a controller)
		Left click            slash (alternates left / right, leaves a trail)
		Right click           stab: wind up, then a short lunge forward
		V                     inspect: look it over, toss it and catch it

	With the knife out you run a little faster (MovementController) and the
	rifle can't fire (WeaponController / the server both check).

	Hits: at the right moment in the swing we look for the enemy (or a
	practice dummy) in front of you, within range and in sight, and tell the
	server; the server re-checks everything (CombatService onMelee) and
	deals the damage. A hit from behind is a backstab: always a kill.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local ClientState = require(script.Parent.ClientState)
local Keybinds = require(script.Parent.Keybinds)
local Sfx = require(script.Parent.Sfx)

local K = Config.Knife
local player = Players.LocalPlayer

local KnifeController = {}
local Controllers

local equippedAt = 0
local busyUntil = 0 -- no new swing before this
local pending = {} -- scheduled hit checks { At, Kind, Done }
local trailUntil = 0
local lastTip

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------
local function alive()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0 and not character:GetAttribute("Frozen")
end

local function canAttack()
	return K.Enabled
		and ClientState.Weapon == "Knife"
		and ClientState.CanShoot()
		and not ClientState.MenuOpen
		and alive()
		and os.clock() >= busyUntil
		and os.clock() - equippedAt >= K.EquipTime
end

local function setWeapon(name)
	if not K.Enabled then
		name = "Sniper"
	end
	if name == ClientState.Weapon then
		return
	end
	if name == "Knife" and not ClientState.HasGun() then
		return -- (between rounds / pick screen)
	end
	if ClientState.MenuOpen or not alive() or (Controllers.KillCam and Controllers.KillCam.IsPlaying()) then
		return -- menus, the crate cinematic, the kill cam
	end
	ClientState.Weapon = name
	equippedAt = os.clock()
	busyUntil = 0
	table.clear(pending)
	Controllers.Viewmodel.SetWeapon(name)
	Remotes.Get("Equip"):FireServer(name)
end

function KnifeController.Toggle()
	setWeapon(ClientState.Weapon == "Knife" and "Sniper" or "Knife")
end

function KnifeController.IsOut()
	return ClientState.Weapon == "Knife"
end

-- What's in front of us: the enemy in a match, the dummies in the lobby.
local function candidates()
	local list = {}
	if ClientState.InMatch() then
		local opponent = ClientState.GetOpponentPlayer()
		if opponent and opponent.Character then
			table.insert(list, opponent.Character)
		end
	else
		local folder = workspace:FindFirstChild("Dummies")
		for _, dummy in ipairs(folder and folder:GetChildren() or {}) do
			if not dummy:GetAttribute("Down") then
				table.insert(list, dummy)
			end
		end
	end
	return list
end

local function torsoOf(model)
	return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
end

local function excludeList()
	local list = { workspace.CurrentCamera }
	if player.Character then
		table.insert(list, player.Character)
	end
	local effects = workspace:FindFirstChild("Effects")
	if effects then
		table.insert(list, effects)
	end
	return list
end

-- The target the swing connects with (nearest in range + in the cone + in sight).
local function findTarget(kind)
	local camera = workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local range = kind == "Stab" and K.StabRange or K.SlashRange
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = excludeList()
	local best, bestDist
	for _, model in ipairs(candidates()) do
		local torso = torsoOf(model)
		if torso then
			local offset = torso.Position - origin
			local dist = offset.Magnitude
			local inCone = dist < 2.5 or look:Dot(offset.Unit) >= math.cos(math.rad(K.HitAngle))
			if dist <= range and inCone then
				local hit = workspace:Raycast(origin, offset, params)
				if (not hit or hit.Instance:IsDescendantOf(model)) and (not bestDist or dist < bestDist) then
					best, bestDist = model, dist
				end
			end
		end
	end
	return best
end

----------------------------------------------------------------------------
-- Attacks
----------------------------------------------------------------------------
local function attack(kind)
	if not canAttack() then
		return
	end
	local now = os.clock()
	local length = kind == "Stab" and K.StabTime or K.SlashTime
	busyUntil = now + length
	Controllers.Viewmodel.PlayKnife(kind)
	table.insert(pending, { At = now + (kind == "Stab" and K.StabHitAt or K.SlashHitAt), Kind = kind })
	if kind == "Slash" then
		trailUntil = now + 0.3
		Sfx.Play("Dash", { Pitch = 1.5 + math.random() * 0.2, Volume = 0.9 })
	else
		-- wind up, then lunge
		task.delay(K.StabTime * 0.26, function()
			if ClientState.Weapon ~= "Knife" or not alive() then
				return
			end
			trailUntil = os.clock() + 0.2
			Sfx.Play("Dash", { Pitch = 1.15, Volume = 1.1 })
			local look = Util.flat(workspace.CurrentCamera.CFrame.LookVector)
			if look.Magnitude > 0.1 and Controllers.Movement.IsGrounded() then
				Controllers.Movement.ApplyImpulse(look.Unit * K.LungeSpeed)
			end
			Controllers.Camera.AddFovPunch(4)
		end)
	end
end

local function resolve(hitCheck)
	local camera = workspace.CurrentCamera
	local look = camera.CFrame.LookVector
	local target = findTarget(hitCheck.Kind)
	Remotes.Get("Melee"):FireServer(hitCheck.Kind, target, look)
	if target then
		local torso = torsoOf(target)
		Controllers.Effects.KnifeImpact(torso.Position - look * 0.6, -look, true)
		Controllers.Camera.Shake(hitCheck.Kind == "Stab" and 1.6 or 0.9)
		return
	end
	-- no body: did we hit a wall? (sparks + a clink)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = excludeList()
	local reach = (hitCheck.Kind == "Stab" and K.StabRange or K.SlashRange) * 0.7
	local hit = workspace:Raycast(camera.CFrame.Position, look * reach, params)
	if hit then
		Controllers.Effects.KnifeImpact(hit.Position, hit.Normal, false)
		Sfx.PlayAt("Bolt", hit.Position, { Pitch = 1.8, Volume = 0.8 })
		Controllers.Camera.Shake(0.6)
	end
end

----------------------------------------------------------------------------
-- Slash trail: thin glowing streaks along the tip's path
----------------------------------------------------------------------------
local trailFolder
local function drawTrail()
	local tip = Controllers.Viewmodel.GetKnifeTip()
	if os.clock() < trailUntil and lastTip and (tip - lastTip).Magnitude > 0.02 and Config.Effects.NeonEffects then
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = Color3.fromRGB(235, 240, 255)
		part.Transparency = 0.45
		part.Size = Vector3.new(0.025, 0.025, (tip - lastTip).Magnitude)
		part.CFrame = CFrame.lookAt((tip + lastTip) / 2, tip)
		part.Parent = trailFolder
		task.spawn(function()
			for i = 1, 6 do
				task.wait(0.02)
				part.Transparency = 0.45 + i * 0.09
				part.Size = Vector3.new(0.025 * (1 - i / 7), 0.025 * (1 - i / 7), part.Size.Z)
			end
			part:Destroy()
		end)
	end
	lastTip = tip
end

----------------------------------------------------------------------------
-- Input
----------------------------------------------------------------------------
local function onInput(input, processed)
	if processed and UserInputService:GetFocusedTextBox() then
		return
	end
	local primary, knife = Keybinds.Matches("Primary", input), Keybinds.Matches("Knife", input)
	if primary and knife then
		KnifeController.Toggle() -- the same button for both (controller): toggle
		return
	elseif knife then
		setWeapon("Knife")
		return
	elseif primary then
		setWeapon("Sniper")
		return
	end
	if ClientState.Weapon ~= "Knife" then
		return
	end
	if Keybinds.Matches("Fire", input) then
		attack("Slash")
	elseif Keybinds.Matches("Scope", input) then
		attack("Stab")
	end
end

function KnifeController.Init(controllers)
	Controllers = controllers
end

function KnifeController.Start()
	trailFolder = Instance.new("Folder")
	trailFolder.Name = "KnifeTrail"
	trailFolder.Parent = workspace.CurrentCamera

	UserInputService.InputBegan:Connect(onInput)
	Keybinds.VirtualBegan:Connect(onInput)
	-- mouse wheel switches too
	local lastWheel = 0
	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseWheel and not processed and not ClientState.MenuOpen then
			if not Controllers.Weapon.IsScoped() and os.clock() - lastWheel > 0.3 then
				lastWheel = os.clock()
				KnifeController.Toggle()
			end
		end
	end)

	-- every life starts with the rifle
	local function reset()
		if ClientState.Weapon ~= "Sniper" then
			ClientState.Weapon = "Sniper"
			Controllers.Viewmodel.SetWeapon("Sniper")
			Remotes.Get("Equip"):FireServer("Sniper") -- in case a late switch reached the server
		end
		table.clear(pending)
		busyUntil = 0
	end
	player.CharacterAdded:Connect(reset)
	ClientState.Changed:Connect(function()
		if not ClientState.HasGun() then
			reset()
		end
	end)

	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for i = #pending, 1, -1 do
			local check = pending[i]
			if now >= check.At then
				table.remove(pending, i)
				if ClientState.Weapon == "Knife" and alive() then
					resolve(check)
				end
			end
		end
		if ClientState.Weapon == "Knife" then
			drawTrail()
		else
			lastTip = nil
		end
	end)
end

return KnifeController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">LightingController</string>
            <string name="Source"><![CDATA[--[[
	LightingController.lua  (Client.LightingController)

	Blends Lighting between the two profiles in Config.Lighting: the arena
	(the base values, also set by the server) and the indoor lobby
	(Config.Lighting.Lobby). Lighting changes made on the client only affect
	this player, so each player gets the profile for where they are.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local ClientState = require(script.Parent.ClientState)

local LightingController = {}

local L = Config.Lighting
local LIGHTING_KEYS = {
	"ClockTime",
	"Brightness",
	"Ambient",
	"OutdoorAmbient",
	"EnvironmentDiffuseScale",
	"EnvironmentSpecularScale",
	"ShadowSoftness",
}
local EFFECTS = {
	Atmosphere = "Atmosphere",
	Bloom = "BloomEffect",
	ColorCorrection = "ColorCorrectionEffect",
	SunRays = "SunRaysEffect",
}

local current -- "Arena" / "Lobby"
local tweens = {}

-- the property table for one profile: the arena base, with the lobby's overrides
local function profile(name)
	local over = name == "Lobby" and L.Lobby or {}
	local props = {}
	for _, key in ipairs(LIGHTING_KEYS) do
		props[key] = over[key] ~= nil and over[key] or L[key]
	end
	local effects = {}
	for key in pairs(EFFECTS) do
		local merged = table.clone(L[key])
		for k, v in pairs(over[key] or {}) do
			merged[k] = v
		end
		effects[key] = merged
	end
	return props, effects
end

local function apply(name, instant)
	if name == current then
		return
	end
	current = name
	for _, t in ipairs(tweens) do
		t:Cancel()
	end
	table.clear(tweens)

	local info = TweenInfo.new(instant and 0 or (L.BlendTime or 1), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local function to(inst, goal)
		if instant then
			for k, v in pairs(goal) do
				inst[k] = v
			end
		else
			local t = TweenService:Create(inst, info, goal)
			table.insert(tweens, t)
			t:Play()
		end
	end

	local props, effects = profile(name)
	to(Lighting, props)
	for key, className in pairs(EFFECTS) do
		local inst = Lighting:FindFirstChild(key)
		if inst and inst.ClassName == className then
			to(inst, effects[key])
		end
	end
end

local function wanted()
	local s = ClientState.Snapshot
	return (s.InMatch or s.Playground) and "Arena" or "Lobby"
end

function LightingController.Init() end

function LightingController.Start()
	-- the server creates the effects at startup; wait briefly so we can blend them too
	Lighting:WaitForChild("ColorCorrection", 5)
	apply(wanted(), true)
	ClientState.Changed:Connect(function()
		apply(wanted(), false)
	end)
end

return LightingController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="57">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Main  (StarterPlayerScripts.Client.Main)

	Client entry point. Requires every controller, gives each one a shared
	`controllers` table (so they can call each other without circular
	requires), then starts them.

	Client layout:
		ClientState          latest match snapshot, my power-up stats, settings
		CameraController     first-person lock, FOV, tilt, recoil, sensitivity
		MovementController   bhop / sprint / slide / wall run (power-up) / grapple
		BodyAnimator         your real character holds + animates the weapons (everyone's, every frame)
		WeaponController     scope + fire (sends shots to the server)
		EffectsController    tracers, explosions, ropes, screen tints
		UIController         all screens (ui/ folder)
		AimAssist            light controller aim assist (used by CameraController)
		KillCamController    replays your death through your killer's eyes
		LightingController   arena / indoor lobby lighting profiles
		CrateController      the lobby crate + its opening cinematic
		KnifeController      the combat knife: switching, slashes, stabs, hit checks
]]

local Client = script.Parent

local ClientState = require(Client.ClientState)
local CameraController = require(Client.CameraController)
local MovementController = require(Client.MovementController)
local BodyAnimator = require(Client.BodyAnimator)
local WeaponController = require(Client.WeaponController)
local EffectsController = require(Client.EffectsController)
local UIController = require(Client.UIController)
local KillCamController = require(Client.KillCamController)
local LightingController = require(Client.LightingController)
local CrateController = require(Client.CrateController)
local KnifeController = require(Client.KnifeController)

local controllers = {
	Camera = CameraController,
	Movement = MovementController,
	Viewmodel = BodyAnimator, -- (the old name; everything calls it this)
	Body = BodyAnimator,
	Weapon = WeaponController,
	Effects = EffectsController,
	UI = UIController,
	KillCam = KillCamController,
	Lighting = LightingController,
	Crates = CrateController,
	Knife = KnifeController,
}

ClientState.Init()

local order = {
	CameraController,
	MovementController,
	BodyAnimator,
	WeaponController,
	EffectsController,
	UIController,
	KillCamController,
	LightingController,
	CrateController,
	KnifeController,
}
for _, controller in ipairs(order) do
	controller.Init(controllers)
end
for _, controller in ipairs(order) do
	controller.Start()
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">MovementController</string>
            <string name="Source"><![CDATA[--[[
	MovementController.lua  (Client.MovementController)

	Fast, momentum-based movement with BUNNY HOPPING.

	CONTROLS
		WASD           move
		Space          jump. HOLD it to bunny hop (you re-jump the instant you
		               land and keep all your speed). Wall jump too.
		A/D + mouse    air strafe: hold A and turn the mouse left (or D + right)
		               while in the air to GAIN speed, like CS / TF2
		Left Shift     sprint (hold)
		C or L-Ctrl    slide (tap; tap again to stand). Press it in the air =
		               slide the moment you land. Jump out of a slide any time.
		E              Grapple Hook (power-up)
		R              Blink (power-up)
		Q              Decoy (power-up)

	HOW IT WORKS
	The ground and air physics copy the Source engine (Half-Life, CS, TF2):
	  * ground: friction, then accelerate toward your input direction
	  * air:    the acceleration can only add a tiny bit of speed IN the
	            direction you're pressing, but there's no limit on total speed.
	            Turning the mouse while strafing keeps your input sideways to
	            your velocity, which bends and grows it. That's air strafing.
	  * landing with Space held jumps again on the same frame, before any
	            friction is applied, so no speed is lost. That's bunny hopping.

	We keep our own horizontal velocity (`momentum`) and drive the character
	with a LinearVelocity in Plane mode (horizontal only), so gravity and
	jumping still use normal Roblox physics.

	Modes: Ground, Air, Slide, WallRun, Grapple, Ceiling.
	Other scripts can listen to Movement.Jumped / Landed / Slid.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)
local Util = require(Shared.Util)
local ClientState = require(script.Parent.ClientState)
local Sfx = require(script.Parent.Sfx)
local Keybinds = require(script.Parent.Keybinds)

local M = Config.Movement
local C = Config.Camera
local PU = Config.PowerUps
local player = Players.LocalPlayer

local Movement = {}
local Controllers

Movement.Jumped = Signal.new() -- ()
Movement.Landed = Signal.new() -- (fallSpeed)
Movement.Slid = Signal.new() -- () a slide started

-- Character references
local character, humanoid, root, linearVelocity

-- Movement state
local mode = "Ground"
local momentum = Vector3.zero -- horizontal velocity we are driving
local lastDrive = Vector3.zero -- what we actually commanded last frame
local pendingImpulse = Vector3.zero -- knockback etc. added next frame
local pendingLift = nil -- vertical velocity to set next frame
local airJumpsLeft = 0

local sprintHeld, slideHeld, jumpHeld = false, false, false
local jumpPressedAt = -10 -- for the jump buffer
local slidePressedAt = -10 -- slide pressed in the air = slide on landing
local lastGroundedTime = 0 -- for coyote time
local forceJumpUntil = 0 -- keep re-applying jump velocity for a moment

local now = os.clock
local lastGroundJumpTime = 0
local lastLiftTime = 0
local lastSlideTime = 0
local lastPhantomTime = 0
local peakY = 0
local lowestVelocityY = 0 -- fastest fall speed this air time (for landing effects)

local wall = { Normal = Vector3.zero, Side = 0, Timer = 0, Y = 0, LastNormal = nil, LastTime = 0, Recharged = true, ReadyAt = 0 }
local grapple = { Point = nil, Timer = 0, ReadyAt = 0 }
local speedBoost = { Until = 0, Multiplier = 1 }
local bulletTime = { Until = 0, ReadyAt = 0, UsedThisAir = false }
local decoyReadyAt = 0
local blinkReadyAt = 0

local fovKick = 0

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------
local function stats()
	return ClientState.Stats
end

local function canMove()
	if not (character and humanoid and root and linearVelocity) then
		return false
	end
	if humanoid.Health <= 0 or root.Anchored or character:GetAttribute("Frozen") then
		return false
	end
	return true
end

local function approachVector(current, target, maxDelta)
	local delta = target - current
	if delta.Magnitude <= maxDelta then
		return target
	end
	return current + delta.Unit * maxDelta
end

-- Rotates the direction of `v` toward `dir` by fraction t, keeping its length.
local function steer(v, dir, t)
	if v.Magnitude < 0.1 or dir.Magnitude < 0.1 then
		return v
	end
	local newDir = v.Unit:Lerp(dir.Unit, math.clamp(t, 0, 1))
	if newDir.Magnitude < 0.05 then
		return v
	end
	return newDir.Unit * v.Magnitude
end

--[[
	Source-engine acceleration.
	Adds speed along `wishDir` until the speed IN THAT DIRECTION reaches
	`addCap`. In the air addCap is tiny (AirSpeedCap), which is exactly what
	makes air strafing gain speed when you turn while strafing.
]]
local function accelerate(v, wishDir, wishSpeed, accel, dt, addCap)
	local current = v:Dot(wishDir)
	local addSpeed = (addCap or wishSpeed) - current
	if addSpeed <= 0 then
		return v
	end
	local accelSpeed = math.min(accel * dt * wishSpeed, addSpeed)
	return v + wishDir * accelSpeed
end

-- Source-engine ground friction.
local function applyFriction(v, friction, dt)
	local speed = v.Magnitude
	if speed < 0.05 then
		return Vector3.zero
	end
	local control = math.max(speed, M.StopSpeed)
	local newSpeed = math.max(speed - control * friction * dt, 0)
	return v * (newSpeed / speed)
end

-- Second Wind boost x Adrenaline power-up
local function speedMultiplier()
	local boost = now() < speedBoost.Until and speedBoost.Multiplier or 1
	local knife = ClientState.Weapon == "Knife" and Config.Knife.MoveSpeedMultiplier or 1
	return boost * stats().MoveSpeedMultiplier * knife
end

-- Spring Legs power-up
local function jumpPower()
	return M.JumpPower * stats().JumpMultiplier
end

local function wishDirection()
	local dir = humanoid and humanoid.MoveDirection or Vector3.zero
	dir = Util.flat(dir)
	if dir.Magnitude > 1 then
		dir = dir.Unit
	end
	return dir
end

local function cameraFlatLook()
	local camera = workspace.CurrentCamera
	return Util.safeUnit(Util.flat(camera.CFrame.LookVector), Vector3.new(0, 0, -1))
end

local function makeRaycastParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true -- leaves and other non-solid detail aren't walls or floors
	local exclude = { character, workspace.CurrentCamera }
	for _, name in ipairs({ "Effects", "Decoys", "Dummies", "Bots" }) do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	-- other players are not walls
	for _, other in ipairs(Players:GetPlayers()) do
		if other.Character then
			table.insert(exclude, other.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	return params
end

local function setVerticalVelocity(y)
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, y, v.Z)
end

--[[
	ANTI-CLIPPING: before we push the character, sweep a body-sized box in the
	direction we're about to move. If a wall is in the way, remove the part of
	the velocity that points into it, so we slide along walls instead of
	shoving into (and sometimes through) them. The box starts a little above
	the feet so curbs, steps and ramps don't count as walls.
]]
local function clipAgainstWalls(v, dt)
	local speed = v.Magnitude
	if speed < 0.5 then
		return v
	end
	local params = makeRaycastParams()
	for _ = 1, 2 do -- twice, for corners
		speed = v.Magnitude
		if speed < 0.5 then
			break
		end
		local dir = v / speed
		local start = root.Position + Vector3.new(0, 0.4, 0) - dir * 0.6
		local result = workspace:Blockcast(
			CFrame.lookAt(start, start + dir),
			Vector3.new(1.9, 3.6, 1),
			dir * (speed * dt + 1.4),
			params
		)
		if not result or math.abs(result.Normal.Y) > 0.6 then
			break
		end
		local n = Util.flat(result.Normal)
		if n.Magnitude < 0.01 then
			break
		end
		n = n.Unit
		local into = v:Dot(n)
		if into >= 0 then
			break
		end
		v -= n * into
	end
	return v
end

-- True if we are falling and the ground is just below (so a Space press now
-- should be a buffered bunny hop, not a double jump).
local function groundIsClose()
	local vy = root.AssemblyLinearVelocity.Y
	if vy > 0 then
		return false
	end
	local reach = 3.6 + math.min(-vy * M.JumpBuffer, 8)
	return workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), makeRaycastParams()) ~= nil
end

----------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------

-- Push the character (knockback, rocket jump). Horizontal part is added to
-- momentum, vertical part sets the upward speed.
function Movement.ApplyImpulse(velocity)
	pendingImpulse += Util.flat(velocity)
	if velocity.Y > 1 then
		pendingLift = math.max(pendingLift or 0, velocity.Y)
	end
end

function Movement.IsBulletTime()
	return now() < bulletTime.Until
end

function Movement.GetMode()
	return mode
end

function Movement.GetSpeed()
	return momentum.Magnitude
end

function Movement.GetWallSide()
	return mode == "WallRun" and wall.Side or 0
end

function Movement.GetGrapplePoint()
	return grapple.Point
end

function Movement.GetCooldowns()
	return {
		Grapple = math.max(0, grapple.ReadyAt - now()),
		Blink = math.max(0, blinkReadyAt - now()),
		Decoy = math.max(0, decoyReadyAt - now()),
		BulletTime = math.max(0, bulletTime.ReadyAt - now()),
	}
end

function Movement.IsGrounded()
	return humanoid ~= nil and humanoid.FloorMaterial ~= Enum.Material.Air
end

function Movement.IsSprinting()
	return mode == "Ground" and sprintHeld and momentum.Magnitude > M.RunSpeed * 0.8
end

-- FOV kick / roll / camera drop for the CameraController.
function Movement.GetCameraHints()
	local hints = { FovKick = fovKick, Roll = 0, Drop = 0 }
	if not humanoid then
		return hints
	end
	if mode == "WallRun" then
		hints.Roll = wall.Side * C.WallRunTilt
	elseif mode == "Slide" then
		hints.Roll = C.SlideTilt
		hints.Drop = C.SlideCameraDrop
	else
		-- tiny strafe tilt
		local camera = workspace.CurrentCamera
		local strafe = wishDirection():Dot(camera.CFrame.RightVector)
		hints.Roll = -strafe * C.StrafeTilt
	end
	return hints
end

----------------------------------------------------------------------------
-- Moves
----------------------------------------------------------------------------
-- PHANTOM STEP power-up: slides and wall jumps turn you invisible briefly.
local function phantomStep()
	if stats().PhantomDash and now() - lastPhantomTime > 0.6 then
		lastPhantomTime = now()
		Remotes.Get("Ability"):FireServer("PhantomDash", {})
		Controllers.Effects.PhantomFlash()
	end
end

local function startSlide()
	if now() - lastSlideTime < M.SlideCooldown then
		return
	end
	local speed = momentum.Magnitude
	if speed < M.SlideMinSpeed then
		return
	end
	lastSlideTime = now()
	mode = "Slide"
	-- boost, but never above the cap (so slide spam can't snowball)
	if speed < M.SlideBoostCap then
		speed = math.min(speed + M.SlideBoost, M.SlideBoostCap)
	end
	momentum = momentum.Unit * speed
	Sfx.Play("Dash", { Pitch = 0.7, Volume = 0.6 })
	Movement.Slid:Fire()
	phantomStep()
end

local function onLanded()
	local fell = peakY - root.Position.Y
	local fallSpeed = -lowestVelocityY
	peakY = root.Position.Y
	lowestVelocityY = 0
	mode = "Ground"
	airJumpsLeft = stats().AirJumps
	bulletTime.UsedThisAir = false
	if fallSpeed > 30 then
		Sfx.Play("Land", { Volume = math.clamp(fallSpeed / 80, 0.3, 1.2) })
	end
	Movement.Landed:Fire(fallSpeed)
	lastGroundedTime = now()
	-- SHOCKWAVE LANDING power-up
	if stats().ShockwaveLanding and fell >= PU.ShockwaveLanding.MinFallHeight then
		Remotes.Get("Ability"):FireServer("Shockwave", {})
		Controllers.Camera.Shake(2.5)
	end
	if (M.SlideHold and slideHeld) or now() - slidePressedAt < 0.35 then
		startSlide()
	end
end

-- Jump off the ground (or out of a slide). Called from the step so it can
-- happen on the exact landing frame (bunny hop).
local function groundJump()
	if mode == "Slide" and momentum.Magnitude < M.SlideBoostCap then
		momentum += Util.safeUnit(momentum) * M.SlideJumpBoost
	end
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	setVerticalVelocity(jumpPower())
	-- the Humanoid can briefly hold us down (e.g. right after landing or
	-- mid-slide); re-apply the jump velocity for a few frames so jumps never fail
	forceJumpUntil = now() + 0.08
	lastGroundJumpTime = now()
	lastGroundedTime = -10
	jumpPressedAt = -10
	mode = "Air"
	peakY = root.Position.Y
	Sfx.Play("Jump", { Pitch = 0.95 + math.random() * 0.1 })
	Movement.Jumped:Fire()
end

local function endGrapple(popUp)
	if not grapple.Point then
		return
	end
	grapple.Point = nil
	grapple.ReadyAt = now() + stats().GrappleCooldown
	Remotes.Get("Ability"):FireServer("GrappleEnd", {})
	Controllers.Effects.SetLocalGrapple(nil)
	mode = "Air"
	if popUp then
		pendingLift = math.max(pendingLift or 0, 32)
	end
end

local function startGrapple()
	if not stats().Grapple or now() < grapple.ReadyAt or grapple.Point then
		return
	end
	local camera = workspace.CurrentCamera
	local result = workspace:Raycast(
		camera.CFrame.Position,
		camera.CFrame.LookVector * M.GrappleRange,
		makeRaycastParams()
	)
	if not result then
		grapple.ReadyAt = now() + 0.3 -- small penalty for a miss
		return
	end
	grapple.Point = result.Position
	grapple.Timer = 0
	mode = "Grapple"
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	Remotes.Get("Ability"):FireServer("GrappleStart", { Point = result.Position })
	Controllers.Effects.SetLocalGrapple(result.Position)
	Sfx.Play("Ability")
end

-- BLINK power-up: teleport where you're looking, keeping your momentum.
local function startBlink()
	local s = stats()
	if not s.Blink or now() < blinkReadyAt then
		return
	end
	blinkReadyAt = now() + s.BlinkCooldown
	local camera = workspace.CurrentCamera
	local look = camera.CFrame.LookVector
	-- mostly horizontal: you can blink up or down a little, not straight into the floor
	local dir = Vector3.new(look.X, math.clamp(look.Y, -0.35, 0.6), look.Z).Unit
	local from = root.Position
	-- sweep a body-sized box so you can never end up inside a wall
	local hit = workspace:Blockcast(CFrame.lookAt(from, from + dir), Vector3.new(2, 4.6, 1), dir * s.BlinkDistance, makeRaycastParams())
	local to = hit and (from + dir * math.max(hit.Distance - 0.4, 0)) or (from + dir * s.BlinkDistance)
	-- don't end up inside the floor
	local floor = workspace:Raycast(to + Vector3.new(0, 3, 0), Vector3.new(0, -6, 0), makeRaycastParams())
	if floor then
		to = Vector3.new(to.X, math.max(to.Y, floor.Position.Y + 3), to.Z)
	end
	root.CFrame = CFrame.new(to) * root.CFrame.Rotation
	if mode == "Ground" or mode == "Slide" then
		mode = "Air"
	end
	Controllers.Camera.AddFovPunch(C.BlinkFOVKick)
	Controllers.Effects.Blink(from, to)
	Remotes.Get("Ability"):FireServer("Blink", { From = from, To = to })
	Sfx.Play("Dash", { Pitch = 1.7 })
end

local function startDecoy()
	if not stats().Decoy or now() < decoyReadyAt then
		return
	end
	decoyReadyAt = now() + PU.Decoy.Cooldown
	local wish = wishDirection()
	local dir = wish.Magnitude > 0.1 and wish.Unit or cameraFlatLook()
	Remotes.Get("Ability"):FireServer("Decoy", { Direction = dir })
	Sfx.Play("Ability", { Pitch = 1.3 })
end

local function wallJump()
	local along = Util.flat(momentum - wall.Normal * momentum:Dot(wall.Normal))
	momentum = along + wall.Normal * M.WallJumpOut
	pendingLift = M.WallJumpUp
	wall.LastNormal = wall.Normal
	wall.LastTime = now()
	mode = "Air"
	Sfx.Play("Jump", { Pitch = 1.15 })
	Movement.Jumped:Fire()
	phantomStep()
end

local function airJump()
	airJumpsLeft -= 1
	pendingLift = M.AirJumpVelocity * stats().JumpMultiplier
	-- re-aim momentum toward your keys (keeps your speed)
	local wish = wishDirection()
	if wish.Magnitude > 0.1 then
		momentum = wish.Unit * math.max(momentum.Magnitude, M.AirJumpMinSpeed * speedMultiplier())
	end
	mode = "Air"
	Sfx.Play("Jump", { Pitch = 1.25 })
	Movement.Jumped:Fire()
end

local function onJumpPressed()
	jumpPressedAt = now()
	if not canMove() then
		return
	end
	if mode == "WallRun" then
		wallJump()
	elseif mode == "Grapple" then
		endGrapple(true)
	elseif mode == "Air" and now() - lastGroundedTime < M.CoyoteTime then
		groundJump() -- just ran or slid off a ledge: still counts as a ground jump
	elseif mode == "Air" then
		if now() - lastGroundJumpTime < 0.12 then
			return -- we only just left the ground
		end
		if groundIsClose() then
			return -- about to land: the jump buffer turns this into a bunny hop
		end
		if airJumpsLeft > 0 then
			airJump()
		end
	end
	-- Ground / Slide jumps happen in the step (so they line up with landing)
end

----------------------------------------------------------------------------
-- Per-mode updates
----------------------------------------------------------------------------
local function updateGround(dt, wish)
	local wishSpeed = (sprintHeld and M.SprintSpeed or M.RunSpeed) * speedMultiplier()
	momentum = applyFriction(momentum, M.Friction, dt)
	if wish.Magnitude > 0.05 then
		momentum = accelerate(momentum, wish.Unit, wishSpeed * math.min(wish.Magnitude, 1), M.GroundAccel, dt)
	end
	humanoid.WalkSpeed = math.max(wishSpeed, 1)
end

local function updateAir(dt, wish)
	if wish.Magnitude < 0.05 then
		return
	end
	local dir = wish.Unit
	local mult = speedMultiplier()
	-- 1) Source air strafing: a small cap in the pressed direction but no
	--    limit on total speed (A/D + turning the mouse = more speed)
	momentum = accelerate(momentum, dir, M.AirControlSpeed * mult, M.AirAccel, dt, M.AirSpeedCap * mult)
	-- 2) Air steering: holding forward turns your momentum toward where you
	--    look, keeping your speed (easy, snappy control in the air)
	local forwardness = math.max(0, dir:Dot(cameraFlatLook()))
	if forwardness > 0 then
		momentum = steer(momentum, dir, M.AirSteer * forwardness * dt)
	end
	-- 3) When you're slow you can always get up to running speed in the air
	if momentum.Magnitude < M.AirMinSpeed * mult then
		momentum = accelerate(momentum, dir, M.AirMinSpeed * mult, M.AirLowSpeedAccel, dt)
	end
end

local function tryStartWallRun(wish)
	-- Wall Runner power-up only, once per jump, with a cooldown
	if not stats().WallRun or not wall.Recharged or now() < wall.ReadyAt then
		return false
	end
	if momentum.Magnitude < M.WallRunMinSpeed or wish.Magnitude < 0.1 then
		return false
	end
	local params = makeRaycastParams()
	-- need some air under us
	if workspace:Raycast(root.Position, Vector3.new(0, -4, 0), params) then
		return false
	end
	local right = root.CFrame.RightVector
	for _, side in ipairs({ 1, -1 }) do
		local result = workspace:Raycast(root.Position, right * side * M.WallCheckDistance, params)
		if result and math.abs(result.Normal.Y) < 0.3 then
			local normal = Util.flat(result.Normal).Unit
			local recentlyLeft = wall.LastNormal
				and now() - wall.LastTime < M.WallReattachDelay
				and wall.LastNormal:Dot(normal) > 0.9
			local runningInto = math.abs(momentum.Unit:Dot(normal)) > 0.85
			if not recentlyLeft and not runningInto then
				mode = "WallRun"
				wall.Normal = normal
				wall.Side = side
				wall.Timer = 0
				wall.Y = math.max(root.AssemblyLinearVelocity.Y * 0.2, M.WallRunStartLift)
				wall.Recharged = false
				wall.ReadyAt = now() + stats().WallRunCooldown
							return true
			end
		end
	end
	return false
end

local function updateWallRun(dt, wish)
	local result =
		workspace:Raycast(root.Position, -wall.Normal * (M.WallCheckDistance + 1.5), makeRaycastParams())
	wall.Timer += dt
	local expired = wall.Timer > stats().WallRunTime
	if not result or math.abs(result.Normal.Y) > 0.3 or expired or wish.Magnitude < 0.1 then
		wall.LastNormal = wall.Normal
		wall.LastTime = now()
		mode = "Air"
		return
	end
	wall.Normal = Util.flat(result.Normal).Unit

	local along = Util.flat(momentum - wall.Normal * momentum:Dot(wall.Normal))
	if along.Magnitude < 1 then
		local look = cameraFlatLook()
		along = look - wall.Normal * look:Dot(wall.Normal)
	end
	-- no speed boost: capped, and the wall slowly drags you down
	local speed = math.min(momentum.Magnitude, M.WallRunMaxSpeed * speedMultiplier()) * (1 - M.WallRunDrag * dt)
	momentum = Util.safeUnit(along) * speed - wall.Normal * 3 -- press into the wall

	wall.Y -= M.WallRunGravity * dt
	setVerticalVelocity(wall.Y)
end

local function updateSlide(dt, wish)
	momentum = applyFriction(momentum, M.SlideFriction, dt)
	momentum = steer(momentum, wish, M.SlideSteer * dt)
	if momentum.Magnitude < M.SlideEndSpeed or (M.SlideHold and not slideHeld) then
		mode = "Ground"
		return
	end
	humanoid.WalkSpeed = 4 -- calm the run animation while sliding
end

local function updateGrapple(dt)
	grapple.Timer += dt
	local toPoint = grapple.Point - root.Position
	if toPoint.Magnitude < M.GrappleReleaseDistance or grapple.Timer > M.GrappleMaxTime then
		endGrapple(false)
		return
	end
	local velocity = Vector3.new(momentum.X, root.AssemblyLinearVelocity.Y, momentum.Z)
	local pull = M.GrapplePullSpeed * stats().GrapplePull
	velocity = approachVector(velocity, toPoint.Unit * pull, M.GrappleAccel * stats().GrapplePull * dt)
	momentum = Util.flat(velocity)
	setVerticalVelocity(velocity.Y)
end

local function tryStartCeiling()
	if not (stats().CeilingRun and jumpHeld) then
		return false
	end
	local result = workspace:Raycast(root.Position, Vector3.new(0, 5, 0), makeRaycastParams())
	if result and result.Normal.Y < -0.7 then
		mode = "Ceiling"
		return true
	end
	return false
end

local function updateCeiling(dt, wish)
	local result = workspace:Raycast(root.Position, Vector3.new(0, 5.5, 0), makeRaycastParams())
	if not jumpHeld or not result then
		mode = "Air"
		return
	end
	-- runs like the ground, but with no friction so you keep your speed
	if wish.Magnitude > 0.05 then
		momentum = accelerate(momentum, wish.Unit, M.SprintSpeed * speedMultiplier(), M.GroundAccel, dt)
	end
	setVerticalVelocity(3) -- keep pressed against the ceiling
	airJumpsLeft = stats().AirJumps
end

----------------------------------------------------------------------------
-- Bullet Time (power-up): scoped in mid-air -> slow time for yourself
----------------------------------------------------------------------------
local function updateBulletTime(dt, grounded)
	local cfg = PU.BulletTime
	local scoped = Controllers.Weapon.IsScoped()
	if Movement.IsBulletTime() then
		if grounded or not scoped then
			bulletTime.Until = 0
			Controllers.Effects.SetBulletTime(false)
			return
		end
		-- fall much slower
		local v = root.AssemblyLinearVelocity
		local y = v.Y + workspace.Gravity * (1 - cfg.GravityScale) * dt
		if y < 0 then
			y *= (1 - math.min(1, 6 * dt))
		end
		setVerticalVelocity(y)
		return
	end
	if Controllers.Effects.IsBulletTimeVisible() then
		Controllers.Effects.SetBulletTime(false)
	end
	if stats().BulletTime and scoped and not grounded and not bulletTime.UsedThisAir and now() >= bulletTime.ReadyAt then
		bulletTime.UsedThisAir = true
		bulletTime.Until = now() + stats().BulletTimeDuration
		bulletTime.ReadyAt = now() + cfg.Cooldown
		Remotes.Get("Ability"):FireServer("BulletTime", {})
		Controllers.Effects.SetBulletTime(true)
	end
end

----------------------------------------------------------------------------
-- Main step
----------------------------------------------------------------------------
local function step(dt)
	if not canMove() then
		if linearVelocity then
			linearVelocity.Enabled = false
		end
		momentum = Vector3.zero
		lastDrive = Vector3.zero
		pendingImpulse = Vector3.zero
		pendingLift = nil
		fovKick = 0
		if grapple.Point then
			grapple.Point = nil
			Controllers.Effects.SetLocalGrapple(nil)
		end
		return
	end
	linearVelocity.Enabled = true

	local velocity = root.AssemblyLinearVelocity
	local horizontal = Util.flat(velocity)

	-- If something blocked us (a wall), the real velocity is lower than what
	-- we commanded last frame: swap that part of our momentum for the real
	-- velocity. Changes made since then (slide boost, wall jump...) are kept.
	if mode ~= "Grapple" and mode ~= "WallRun" and not Movement.IsBulletTime() then
		if horizontal.Magnitude < lastDrive.Magnitude - 3 then
			momentum = horizontal + (momentum - lastDrive)
		end
	end

	-- External impulses (knockback / rocket jump / double jump)
	if pendingImpulse.Magnitude > 0 then
		momentum += pendingImpulse
		pendingImpulse = Vector3.zero
	end
	if pendingLift then
		setVerticalVelocity(pendingLift)
		if mode == "Ground" or mode == "Slide" or mode == "WallRun" or mode == "Ceiling" then
			mode = "Air"
		end
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		pendingLift = nil
		lastLiftTime = now()
	end

	-- "grounded" ignores the first moments after any jump/launch, so the
	-- floor we just left doesn't instantly count as a landing
	local justLaunched = now() - math.max(lastGroundJumpTime, lastLiftTime) < 0.12
	local grounded = Movement.IsGrounded() and not justLaunched
	local wish = wishDirection()
	if now() < forceJumpUntil and root.AssemblyLinearVelocity.Y < jumpPower() * 0.75 then
		setVerticalVelocity(jumpPower())
	end
	if not grounded then
		peakY = math.max(peakY, root.Position.Y) -- for Shockwave Landing
		lowestVelocityY = math.min(lowestVelocityY, velocity.Y)
	end

	-- Ground <-> air transitions
	if grounded and (mode == "Air" or mode == "WallRun" or mode == "Ceiling") then
		onLanded()
	elseif not grounded and (mode == "Ground" or mode == "Slide") then
		mode = "Air"
		peakY = root.Position.Y
	end

	-- JUMP / BUNNY HOP: holding Space (or a buffered press) jumps on the very
	-- frame we touch the ground, BEFORE friction runs, so no speed is lost.
	if grounded and (mode == "Ground" or mode == "Slide") then
		lastGroundedTime = now()
		wall.Recharged = true -- touching the ground recharges your wall run
		local wantsJump = (M.AutoBhop and jumpHeld) or (now() - jumpPressedAt < M.JumpBuffer)
		if wantsJump then
			groundJump()
		end
	end

	if mode == "Ground" then
		updateGround(dt, wish)
	elseif mode == "Slide" then
		updateSlide(dt, wish)
	elseif mode == "Air" then
		updateAir(dt, wish)
		if not tryStartCeiling() then
			tryStartWallRun(wish)
		end
	elseif mode == "WallRun" then
		updateWallRun(dt, wish)
	elseif mode == "Grapple" then
		updateGrapple(dt)
	elseif mode == "Ceiling" then
		updateCeiling(dt, wish)
	end

	-- hard speed limit
	local maxSpeed = M.MaxSpeed * stats().MoveSpeedMultiplier
	if momentum.Magnitude > maxSpeed then
		momentum = momentum.Unit * maxSpeed
	end

	-- never push into walls (prevents clipping / phasing through thin walls)
	if mode ~= "WallRun" then
		momentum = clipAgainstWalls(momentum, dt)
	end

	-- FEATHERWEIGHT power-up: cancel part of gravity while airborne
	local gravityScale = stats().GravityScale
	if gravityScale < 1 and mode == "Air" and not Movement.IsBulletTime() then
		local v = root.AssemblyLinearVelocity
		setVerticalVelocity(v.Y + workspace.Gravity * (1 - gravityScale) * dt)
	end

	updateBulletTime(dt, grounded)

	-- Drive the character
	local drive = momentum
	if Movement.IsBulletTime() then
		drive *= PU.BulletTime.MoveScale
	end
	linearVelocity.PlaneVelocity = Vector2.new(drive.X, drive.Z)
	lastDrive = drive
	humanoid.JumpPower = 0 -- jumps are done by this script (so the Jump key can be rebound)

	-- FOV kick from movement
	local speed = momentum.Magnitude
	local kick = 0
	if mode == "Slide" then
		kick = C.SlideFOVKick
	elseif mode == "WallRun" then
		kick = C.WallRunFOVKick
	elseif speed > M.RunSpeed + 2 then
		kick = C.SprintFOVKick
	end
	kick += math.clamp((speed - M.SprintSpeed) * C.SpeedFOVPerStud, 0, C.MaxSpeedFOV)
	fovKick = Util.lerp(fovKick, kick, Util.smooth(8, dt))
end

----------------------------------------------------------------------------
-- Character setup
----------------------------------------------------------------------------
local function onCharacterAdded(newCharacter)
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	root = newCharacter:WaitForChild("HumanoidRootPart")

	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0 -- jumps are done by this script (so the Jump key can be rebound)
	-- Roblox's own jump is always on Space; turn it off so only our Jump bind jumps
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	humanoid.WalkSpeed = M.RunSpeed

	local attachment = root:FindFirstChild("RootAttachment") or root:FindFirstChild("RootRigAttachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "MoveAttachment"
		attachment.Parent = root
	end

	linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.Name = "MoveVelocity"
	linearVelocity.Attachment0 = attachment
	linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	linearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	linearVelocity.PrimaryTangentAxis = Vector3.xAxis
	linearVelocity.SecondaryTangentAxis = Vector3.zAxis
	linearVelocity.MaxForce = 200000
	linearVelocity.Enabled = false
	linearVelocity.Parent = root

	mode = "Ground"
	momentum = Vector3.zero
	lastDrive = Vector3.zero
	airJumpsLeft = stats().AirJumps
	grapple.Point = nil
	speedBoost.Until = 0
	bulletTime.Until = 0
	peakY = root.Position.Y
	lowestVelocityY = 0

	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping and (mode == "Ground" or mode == "Slide") then
			lastGroundJumpTime = now()
		end
	end)
end

----------------------------------------------------------------------------
-- Input
----------------------------------------------------------------------------

-- Roblox's own control scripts bind Space (and some mouse buttons) with
-- ContextActionService, which marks those inputs as "processed". So we only
-- ignore input while the player is typing in a text box (e.g. chat).
local function isTyping(processed)
	return processed and UserInputService:GetFocusedTextBox() ~= nil
end

local function onInputBegan(input, processed)
	if isTyping(processed) then
		return
	end
	if Keybinds.Matches("Jump", input) then
		jumpHeld = true
		onJumpPressed()
	elseif Keybinds.Matches("Sprint", input) then
		sprintHeld = true
	elseif Keybinds.Matches("Slide", input) then
		slideHeld = true
		if canMove() then
			if mode == "Ground" then
				startSlide()
			elseif mode == "Slide" and not M.SlideHold then
				mode = "Ground" -- tap again to stand up
			elseif mode == "Air" then
				slidePressedAt = now() -- slide as soon as we land
			end
		end
	elseif Keybinds.Matches("Grapple", input) then
		if canMove() then
			if grapple.Point then
				endGrapple(false)
			else
				startGrapple()
			end
		end
	elseif Keybinds.Matches("Blink", input) then
		if canMove() and ClientState.CanShoot() then
			startBlink()
		end
	elseif Keybinds.Matches("Decoy", input) then
		if canMove() and ClientState.CanShoot() then
			startDecoy()
		end
	end
end

local function onInputEnded(input)
	if Keybinds.Matches("Jump", input) then
		jumpHeld = false
	elseif Keybinds.Matches("Sprint", input) then
		sprintHeld = false
	elseif Keybinds.Matches("Slide", input) then
		slideHeld = false
	end
end

function Movement.Init(controllers)
	Controllers = controllers
end

function Movement.Start()
	workspace.Gravity = M.Gravity

	if player.Character then
		task.spawn(onCharacterAdded, player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	Keybinds.VirtualBegan:Connect(onInputBegan) -- on-screen buttons (mobile)
	Keybinds.VirtualEnded:Connect(onInputEnded)

	Remotes.Get("Knockback").OnClientEvent:Connect(function(velocity)
		if typeof(velocity) == "Vector3" then
			Movement.ApplyImpulse(velocity)
			Controllers.Camera.Shake(2)
		end
	end)

	Remotes.Get("Buff").OnClientEvent:Connect(function(buff)
		if buff.Type == "SpeedBoost" then
			speedBoost.Until = now() + buff.Duration
			speedBoost.Multiplier = buff.Multiplier
		end
	end)

	RunService.Heartbeat:Connect(step)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--[[
	Sfx.lua  (Client.Sfx)
	Plays the sounds listed in Config.Sounds.

		Sfx.Play("Fire")                         -- 2D (UI / your own gun)
		Sfx.Play("Explosion", { Parent = part }) -- 3D at a part/attachment
		Sfx.Play("Hit", { Pitch = 1.2 })         -- pitch multiplier
]]

local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Sfx = {}

function Sfx.Play(name, options)
	local def = Config.Sounds[name]
	if not def then
		return nil
	end
	options = options or {}
	local sound = Instance.new("Sound")
	sound.SoundId = def.Id
	sound.Volume = (def.Volume or 0.5) * (options.Volume or 1)
	sound.PlaybackSpeed = (def.Pitch or 1) * (options.Pitch or 1)
	if options.Parent then
		sound.RollOffMaxDistance = 600
		sound.RollOffMinDistance = 12
		sound.Parent = options.Parent
	else
		sound.Parent = SoundService
	end
	sound:Play()
	Debris:AddItem(sound, 5)
	return sound
end

-- Plays a 3D sound at a world position (creates a tiny invisible anchor).
function Sfx.PlayAt(name, position, options)
	local anchor = Instance.new("Attachment")
	anchor.WorldPosition = position
	anchor.Parent = workspace.Terrain
	Debris:AddItem(anchor, 5)
	options = options or {}
	options.Parent = anchor
	return Sfx.Play(name, options)
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Spring</string>
            <string name="Source"><![CDATA[--[[
	Spring.lua  (Client.Spring)
	A damped spring for Vector3 values, used for viewmodel sway and recoil.

		local s = Spring.new(stiffness, damping)
		s.Target = Vector3.new(...)
		s:Impulse(Vector3.new(...))  -- kick the velocity
		s:Update(dt)                 -- returns s.Position
]]

local Spring = {}
Spring.__index = Spring

function Spring.new(stiffness, damping)
	return setmetatable({
		Stiffness = stiffness,
		Damping = damping,
		Position = Vector3.zero,
		Velocity = Vector3.zero,
		Target = Vector3.zero,
	}, Spring)
end

function Spring:Impulse(v)
	self.Velocity += v
end

function Spring:Update(dt)
	-- small fixed sub-steps keep it stable at low frame rates
	local steps = math.max(1, math.ceil(dt / (1 / 120)))
	local h = dt / steps
	for _ = 1, steps do
		local force = (self.Target - self.Position) * self.Stiffness - self.Velocity * self.Damping
		self.Velocity += force * h
		self.Position += self.Velocity * h
	end
	return self.Position
end

return Spring
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--[[
	UIController.lua  (Client.UIController)
	Creates every screen and forwards match-state changes to them.

	Screens (Client/ui):
		HUD           crosshair, scope, scoreboard, health, banners, hitmarkers
		PickScreen    power-up cards between rounds
		VictoryScreen end of match
		LobbyUI       find match / playground / bot buttons
		SettingsMenu  sliders + keybinds for mouse and controller (P)
		PowerUpLab    try power-ups solo in the lobby (B)
		Locker        pick your rifle and knife skins (L)
		Shop          crates, credit packs, VIP (M)
		Toast         short server messages (admin commands)
		DuelUI        challenge a player, duel / rematch invites
		MobileControls on-screen buttons + look pad for touch screens
]]

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local ClientState = require(script.Parent.ClientState)
local ui = script.Parent:WaitForChild("ui")
local HUD = require(ui.HUD)
local PickScreen = require(ui.PickScreen)
local VictoryScreen = require(ui.VictoryScreen)
local LobbyUI = require(ui.LobbyUI)
local SettingsMenu = require(ui.SettingsMenu)
local PowerUpLab = require(ui.PowerUpLab)
local Locker = require(ui.Locker)
local Shop = require(ui.Shop)
local Toast = require(ui.Toast)
local DuelUI = require(ui.DuelUI)
local MobileControls = require(ui.MobileControls)

local UIController = {}

UIController.HUD = HUD
UIController.Settings = SettingsMenu

function UIController.Init(controllers)
	controllers.HUD = HUD
	controllers.Settings = SettingsMenu
	controllers.Duel = DuelUI
	controllers.Locker = Locker
	controllers.Shop = Shop
	MobileControls.Init(controllers)
	HUD.Init(controllers)
	LobbyUI.Init(controllers)
	SettingsMenu.Init(controllers)
	VictoryScreen.Init(controllers)
end

function UIController.Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	-- No reset button (dying on purpose would skip rounds) and a clean screen
	task.spawn(function()
		for _ = 1, 10 do
			local ok = pcall(function()
				StarterGui:SetCore("ResetButtonCallback", false)
			end)
			if ok then
				break
			end
			task.wait(1)
		end
	end)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)

	HUD.Start(playerGui)
	PickScreen.Start(playerGui)
	VictoryScreen.Start(playerGui)
	LobbyUI.Start(playerGui)
	SettingsMenu.Start(playerGui)
	PowerUpLab.Start(playerGui)
	Locker.Start(playerGui)
	Shop.Start(playerGui)
	Toast.Start(playerGui)
	DuelUI.Start(playerGui)
	MobileControls.Start(playerGui)

	ClientState.Changed:Connect(function(snapshot, old)
		HUD.OnState(snapshot, old)
		PickScreen.OnState(snapshot, old)
		VictoryScreen.OnState(snapshot, old)
		LobbyUI.OnState(snapshot, old)
	end)
end

return UIController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">WeaponAnim</string>
            <string name="Source"><![CDATA[--[[
	WeaponAnim.lua  (Client.WeaponAnim)

	Every weapon animation, as pure maths (no instances), so the SAME motion
	plays on your character in first person and on everyone else's screen.

	For a moment in time it returns, in "view space" (the eye: +X right,
	+Y up, -Z where you look):
		Weapon     where the rifle's grip / the knife's handle is
		Right      where the right hand goes (nil = on the weapon's grip)
		Left       where the left hand goes
		Body       { Yaw, Pitch, Roll (degrees, the waist), Lean (degrees),
		             Dip / Forward (studs, the hips), Step (0-1, lunge legs) }
		Bolt       the bolt's offset (rifle)
	BodyAnimator then bends your real arms (IK), twists your torso and puts
	the weapon there.

	Knife moves are keyframed and played back on smooth splines (positions
	and rotations both), so they flow instead of stopping at each pose.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local KnifeModel = require(Shared.KnifeModel)

local WeaponAnim = {}

local rad = math.rad
local V = Vector3.new
local KN = Config.Knife
local B = Config.Body

----------------------------------------------------------------------------
-- Maths helpers
----------------------------------------------------------------------------
local function clamp01(x)
	return math.clamp(x, 0, 1)
end
local function smoothstep(t)
	t = clamp01(t)
	return t * t * (3 - 2 * t)
end
local function easeOutBack(t)
	t = clamp01(t)
	local c1, c3 = 1.5, 2.5
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end
local function seg(t, a, b)
	return clamp01((t - a) / (b - a))
end

-- A pose from where the handle is, which way the blade (or barrel) points
-- and which way the edge (or the gun's underside) faces.
local function aim(pos, forward, down)
	local z = -forward.Unit
	local y = -(down - z * down:Dot(z)).Unit
	return CFrame.fromMatrix(pos, y:Cross(z), y, z)
end
WeaponAnim.Aim = aim

-- quaternion helpers for smooth rotation splines
local function toQuat(cf)
	local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	local trace = r00 + r11 + r22
	local w, x, y, z
	if trace > 0 then
		local s = math.sqrt(trace + 1) * 2
		w, x, y, z = 0.25 * s, (r21 - r12) / s, (r02 - r20) / s, (r10 - r01) / s
	elseif r00 > r11 and r00 > r22 then
		local s = math.sqrt(1 + r00 - r11 - r22) * 2
		w, x, y, z = (r21 - r12) / s, 0.25 * s, (r01 + r10) / s, (r02 + r20) / s
	elseif r11 > r22 then
		local s = math.sqrt(1 + r11 - r00 - r22) * 2
		w, x, y, z = (r02 - r20) / s, (r01 + r10) / s, 0.25 * s, (r12 + r21) / s
	else
		local s = math.sqrt(1 + r22 - r00 - r11) * 2
		w, x, y, z = (r10 - r01) / s, (r02 + r20) / s, (r12 + r21) / s, 0.25 * s
	end
	return { w, x, y, z }
end

local function catmull(p0, p1, p2, p3, t)
	local t2, t3 = t * t, t * t * t
	-- (scalars on the right so it works for numbers and Vector3s alike)
	return (p1 * 2 + (p2 - p0) * t + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2 + (p1 * 3 - p0 - p2 * 3 + p3) * t3) * 0.5
end

-- Smooth curve through a list of CFrames (Catmull-Rom on position and on
-- the rotation's quaternion), at u = 0..1 between key i and key i + 1.
local function splineCF(cfs, i, u)
	local n = #cfs
	local a, b, c, d = cfs[math.max(i - 1, 1)], cfs[i], cfs[math.min(i + 1, n)], cfs[math.min(i + 2, n)]
	local pos = catmull(a.Position, b.Position, c.Position, d.Position, u)
	local q = { toQuat(a), toQuat(b), toQuat(c), toQuat(d) }
	for k = 2, 4 do -- keep every quaternion on the same side as the one before
		local dot = 0
		for j = 1, 4 do
			dot += q[k][j] * q[k - 1][j]
		end
		if dot < 0 then
			for j = 1, 4 do
				q[k][j] = -q[k][j]
			end
		end
	end
	local out, len = {}, 0
	for j = 1, 4 do
		out[j] = catmull(q[1][j], q[2][j], q[3][j], q[4][j], u)
		len += out[j] * out[j]
	end
	len = math.sqrt(len)
	if len < 1e-6 then
		return b:Lerp(c, u)
	end
	return CFrame.new(pos.X, pos.Y, pos.Z, out[2] / len, out[3] / len, out[4] / len, out[1] / len)
end

local BODY_KEYS = { "Yaw", "Pitch", "Roll", "Lean", "Dip", "Forward", "Step", "NeckYaw", "NeckPitch" }

-- Plays a clip: keys = { { T, Weapon = CFrame | "BASE", Left = CFrame?, Body = {...}, Ease? } }
-- Returns weaponCF, leftCF (or nil), body table.
local function playClip(clip, u, base, baseLeft)
	local keys = clip.Keys
	local n = #keys
	local i = 1
	while i < n - 1 and u > keys[i + 1].T do
		i += 1
	end
	local k1, k2 = keys[i], keys[i + 1]
	local x = clamp01((u - k1.T) / math.max(k2.T - k1.T, 1e-4))
	if k2.Ease == "Snap" then
		x = 1 - (1 - x) ^ 2.6 -- fast start, soft landing (strikes)
	elseif k2.Ease == "Wind" then
		x = x * x * (2 - x) * 0.5 + x * 0.5
	end
	local weapons, lefts = {}, {}
	for k, key in ipairs(keys) do
		weapons[k] = key.Weapon == "BASE" and base or key.Weapon
		lefts[k] = key.Left or baseLeft
	end
	local weapon = splineCF(weapons, i, x)
	local left = splineCF(lefts, i, x)
	local body = {}
	for _, name in ipairs(BODY_KEYS) do
		local function at(k)
			local key = keys[math.clamp(k, 1, n)]
			return key.Body and key.Body[name] or 0
		end
		body[name] = catmull(at(i - 1), at(i), at(i + 1), at(i + 2), x)
	end
	return weapon, left, body
end

----------------------------------------------------------------------------
-- RIFLE (gun space: origin = right hand on the grip, -Z = the barrel)
----------------------------------------------------------------------------
local G = B.GunScale
local RIFLE_HIP = CFrame.new(B.RifleHip)
local RIFLE_SPRINT = RIFLE_HIP * CFrame.new(-0.12, -0.22, 0.2) * CFrame.Angles(rad(-18), rad(40), rad(16))
local RIFLE_EQUIP = RIFLE_HIP * CFrame.new(0.15, -1.1, 0.4) * CFrame.Angles(rad(-55), rad(25), rad(20))
-- the pistol grip goes through the fist; the forearm comes from behind it
local RIGHT_ON_GRIP = CFrame.new(0, -0.18 * G, 0.12 * G) * CFrame.Angles(rad(70), 0, 0)
local LEFT_GUARD_KNIFE = aim(V(-0.75, -1.15, -0.95), V(0.35, 0.55, -0.75), V(0.2, -0.2, 0.9))

local function rifleLeft(profile)
	-- (R15 arms are short for their shoulder width, so the left hand holds
	-- just ahead of the trigger guard, where it can actually reach)
	return CFrame.new(0, profile.LeftHold.Position.Y * G - 0.04, B.RifleLeftHold) * CFrame.Angles(0, 0, rad(95))
end

-- bolt cycle: reach (0-.15) lift (.15-.3) pull (.3-.5) push (.5-.68) lower (.68-.8) back (.8-1)
local function boltState(profile, t)
	local lift = smoothstep(seg(t, 0.15, 0.3)) - smoothstep(seg(t, 0.68, 0.8))
	local pull = smoothstep(seg(t, 0.3, 0.5)) - smoothstep(seg(t, 0.5, 0.68))
	local bolt = CFrame.new(0, 0, pull * profile.BoltTravel * G) * CFrame.Angles(0, 0, rad(profile.BoltLift) * lift)
	local pivot = CFrame.new(profile.BoltPivot.Position * G) * bolt
	local knob = pivot * CFrame.new(profile.KnobHold.Position * G) * CFrame.Angles(rad(60), 0, rad(-25))
	local reach = smoothstep(seg(t, 0, 0.15))
	local back = smoothstep(seg(t, 0.8, 1))
	local hand
	if t <= 0 or t >= 1 then
		hand = RIGHT_ON_GRIP
	elseif t < 0.15 then
		hand = RIGHT_ON_GRIP:Lerp(knob, reach)
	elseif t < 0.8 then
		hand = knob
	else
		hand = knob:Lerp(RIGHT_ON_GRIP, back)
	end
	local roll = math.sin(clamp01(t) * math.pi) * rad(18)
	return bolt, hand, roll
end

-- Rifle inspects (V): 1 show it off, 2 scope check, 3 chamber check.
local RIFLE_INSPECT_TIME = 2.4
WeaponAnim.RifleInspects = 3

local function rifle(state, t, ctx)
	local profile = ctx.Profile
	local base = RIFLE_HIP:Lerp(RIFLE_SPRINT, ctx.Sprint or 0)
	-- equip: swings up into view
	local e = clamp01((t - state.EquipStart) / (Config.Viewmodel.EquipTime or 0.35))
	local pose = RIFLE_EQUIP:Lerp(base, easeOutBack(e))
	-- recoil: a sharp kick up and back that settles
	local f = t - state.FireStart
	if f >= 0 and f < 0.6 then
		local kick = math.exp(-f * 11) * (1 - math.exp(-f * 90))
		pose = pose * CFrame.new(0, 0.03 * kick, 0.28 * kick) * CFrame.Angles(rad(12) * kick, 0, rad(3) * kick)
	end
	-- inspect (V): one of RIFLE_INSPECTS
	local body = { Yaw = -8, Pitch = 0 }
	local bolt, hand, roll = CFrame.new(), RIGHT_ON_GRIP, 0
	local left = rifleLeft(profile)
	local it = (t - state.InspectStart) / RIFLE_INSPECT_TIME
	if it >= 0 and it < 1 and state.InspectKind == "Rifle" then
		local w = math.sin(it * math.pi) ^ 0.7
		local variant = state.InspectVariant or 1
		if variant == 2 then
			-- scope check: tip it toward you, tap the scope twice
			pose = pose * CFrame.new(-0.25 * w, 0.22 * w, 0.25 * w) * CFrame.Angles(rad(8) * w, rad(32) * w, rad(-38) * w)
			local eye = profile.ScopeEye * G
			local tap = CFrame.new(0.02, eye.Y + 0.11 + math.max(0, math.sin(seg(it, 0.4, 0.7) * math.pi * 4)) * 0.05, eye.Z - 0.55)
				* CFrame.Angles(0, 0, rad(90))
			left = left:Lerp(tap, smoothstep(seg(it, 0.25, 0.38)) - smoothstep(seg(it, 0.72, 0.86)))
			body.NeckPitch = -6 * w
			body.NeckYaw = 8 * w
		elseif variant == 3 then
			-- chamber check: lift the bolt, ease it half open, look in, close it
			pose = pose * CFrame.new(-0.12 * w, 0.12 * w, 0.1 * w) * CFrame.Angles(rad(6) * w, rad(10) * w, rad(-24) * w)
			local lift = smoothstep(seg(it, 0.15, 0.28)) - smoothstep(seg(it, 0.74, 0.84))
			local pull = (smoothstep(seg(it, 0.28, 0.42)) - smoothstep(seg(it, 0.62, 0.74))) * 0.55
			bolt = CFrame.new(0, 0, pull * profile.BoltTravel * G) * CFrame.Angles(0, 0, rad(profile.BoltLift) * lift)
			local knob = CFrame.new(profile.BoltPivot.Position * G) * bolt * CFrame.new(profile.KnobHold.Position * G)
				* CFrame.Angles(rad(60), 0, rad(-25))
			hand = RIGHT_ON_GRIP:Lerp(knob, smoothstep(seg(it, 0.04, 0.15)) - smoothstep(seg(it, 0.84, 0.96)))
			body.NeckPitch = -8 * w
			body.NeckYaw = 10 * w
		else
			-- show it off: turn it to show both sides
			local turn = math.sin(it * math.pi * 2)
			pose = pose * CFrame.new(-0.35 * w, 0.2 * w, 0.3 * w) * CFrame.Angles(rad(12) * w, rad(60) * turn * w, rad(-30) * w)
			body.NeckPitch = -8 * w
		end
	end
	-- bolt
	local bt = state.BoltLength > 0 and (t - state.BoltStart) / state.BoltLength or 1
	if bt >= 0 and bt < 1 then
		bolt, hand, roll = boltState(profile, bt)
		pose = pose * CFrame.Angles(0, 0, -roll)
	end
	-- scope: bring the scope up to your eye
	local scope = ctx.Scope or 0
	if scope > 0 then
		local eye = profile.ScopeEye * G
		local ads = CFrame.new(-eye.X, -eye.Y, -eye.Z - 0.35)
		pose = pose:Lerp(ads, smoothstep(scope))
	end
	if f >= 0 and f < 0.25 then
		body.Pitch = 3 * math.exp(-f * 12)
	end
	return {
		Weapon = pose,
		Right = pose * hand,
		Left = pose * left,
		Body = body,
		Bolt = bolt,
	}
end

----------------------------------------------------------------------------
-- KNIFE (knife space: origin = middle of the handle, blade -Z, edge -Y)
----------------------------------------------------------------------------
local KS = KN.WorldScale

-- A knife pose from where the handle is and where the blade points. The
-- roll round the blade is worked out so the spine faces your right shoulder:
-- the fist closes on the handle with the forearm running back from it to the
-- elbow (a real hammer grip), so the arm and the knife always move as one
-- and the handle never cuts through the wrist. `twist` (degrees) rolls it
-- a little more when a move wants the flat or the edge shown.
local KNIFE_SHOULDER = V(0.95, -1.3, 0.35)
local function kaim(pos, forward, twist)
	local f = forward.Unit
	local toShoulder = KNIFE_SHOULDER - pos
	local spine = toShoulder - f * toShoulder:Dot(f)
	if spine.Magnitude < 1e-3 then
		spine = V(0, -1, 0) + f * f.Y -- (pointing straight at the shoulder: spine down)
	end
	local cf = aim(pos, f, -spine)
	if twist then
		cf = cf * CFrame.Angles(0, 0, rad(twist))
	end
	return cf
end
local KNIFE_IDLE = kaim(V(0.5, -0.88, -1.05), V(-0.35, 0.5, -0.8))
local KNIFE_SPRINT = kaim(V(0.6, -1.15, -0.8), V(-0.2, -0.1, -1))
-- the fist closes round the handle, thumb by the guard; the forearm leaves
-- the fist on the spine side (kaim points the spine at the shoulder), tipped
-- a touch toward the pommel like a real wrist
local HAND_ON_KNIFE = CFrame.new(KnifeModel.Grip.Position * KS) * CFrame.Angles(rad(8), 0, 0)

-- left hand: up in a guard, fist loose
local GUARD = LEFT_GUARD_KNIFE
local GUARD_OUT = aim(V(-1.0, -0.95, -0.85), V(0.2, 0.6, -0.8), V(0.3, -0.2, 0.9))
local GUARD_BACK = aim(V(-0.6, -1.25, -0.5), V(0.4, 0.4, -0.8), V(0.2, -0.3, 0.9))

local CLIPS = {}

-- Draw: up from the hip, a full flip in the air, caught into the grip.
CLIPS.Equip = {
	Length = 0.75,
	Toss = { From = 0.2, To = 0.52, Height = 0.55, Spins = -1, Catch = 3 },
	Keys = {
		{ T = 0, Weapon = kaim(V(0.75, -1.7, -0.45), V(0, -1, 0.3)), Left = GUARD_BACK },
		{ T = 0.2, Weapon = kaim(V(0.55, -0.85, -1.05), V(-0.1, 0.25, -1)), Body = { Yaw = 8, NeckPitch = -6 } },
		{ T = 0.52, Weapon = kaim(V(0.5, -0.62, -1.2), V(-0.3, 0.5, -0.8)), Body = { Yaw = 4, NeckPitch = -4 } },
		{ T = 0.75, Weapon = "BASE" },
	},
}

-- Slash, forehand: a short cock back to the right shoulder, then one fast,
-- clean diagonal swipe across in front of you (edge first), a follow
-- through low on the left and straight back to the guard.
CLIPS.SlashA = {
	Length = KN.SlashTime,
	Keys = {
		{ T = 0, Weapon = "BASE" },
		{ T = 0.18, Weapon = kaim(V(0.85, -0.3, -0.9), V(0.45, 0.6, -0.65)), Left = GUARD_OUT, Ease = "Wind",
			Body = { Yaw = 12, Roll = -3 } },
		{ T = 0.34, Weapon = kaim(V(0.1, -0.45, -1.35), V(-0.85, 0.15, -0.55)), Ease = "Snap",
			Body = { Yaw = -6, Lean = 4, Dip = 0.05 } },
		{ T = 0.48, Weapon = kaim(V(-0.75, -0.8, -1.05), V(-0.92, -0.25, -0.3)), Left = GUARD_BACK,
			Body = { Yaw = -16, Roll = 3, Lean = 6, Dip = 0.08 } },
		{ T = 0.64, Weapon = kaim(V(-0.8, -0.88, -0.95), V(-0.88, -0.3, -0.35)),
			Body = { Yaw = -17, Roll = 3, Lean = 5, Dip = 0.07 } },
		{ T = 1, Weapon = "BASE" },
	},
}

-- Slash, backhand: the same swipe the other way, from the left of your
-- chest out to the right.
CLIPS.SlashB = {
	Length = KN.SlashTime,
	Keys = {
		{ T = 0, Weapon = "BASE" },
		{ T = 0.18, Weapon = kaim(V(-0.3, -0.35, -0.95), V(-0.55, 0.55, -0.6)), Left = GUARD_BACK, Ease = "Wind",
			Body = { Yaw = -12, Roll = 3 } },
		{ T = 0.34, Weapon = kaim(V(0.4, -0.45, -1.35), V(0.85, 0.15, -0.55)), Ease = "Snap",
			Body = { Yaw = 6, Lean = 4, Dip = 0.05 } },
		{ T = 0.48, Weapon = kaim(V(1.15, -0.8, -1.0), V(0.92, -0.25, -0.3)), Left = GUARD_OUT,
			Body = { Yaw = 15, Roll = -3, Lean = 5, Dip = 0.07 } },
		{ T = 0.64, Weapon = kaim(V(1.2, -0.88, -0.9), V(0.88, -0.3, -0.35)),
			Body = { Yaw = 16, Roll = -3, Lean = 4, Dip = 0.06 } },
		{ T = 1, Weapon = "BASE" },
	},
}

-- Stab: draw it back by the shoulder, lunge and drive it straight in,
-- twist, rip it out, recover.
CLIPS.Stab = {
	Length = KN.StabTime,
	Keys = {
		{ T = 0, Weapon = "BASE" },
		{ T = 0.24, Weapon = kaim(V(0.95, -0.6, -0.9), V(-0.05, 0.3, -1)), Left = GUARD_OUT, Ease = "Wind",
			Body = { Yaw = 22, Lean = -8, Dip = 0.05 } },
		{ T = 0.37, Weapon = kaim(V(0.12, -0.25, -2.25), V(-0.12, 0.04, -1)), Left = GUARD_BACK, Ease = "Snap",
			Body = { Yaw = -14, Lean = 22, Dip = 0.5, Forward = 0.6, Step = 1 } },
		{ T = 0.5, Weapon = kaim(V(0.14, -0.28, -2.2), V(-0.12, 0.04, -1)),
			Body = { Yaw = -16, Lean = 22, Dip = 0.5, Forward = 0.6, Step = 1 } },
		{ T = 0.64, Weapon = kaim(V(0.45, -0.4, -1.4), V(-0.2, 0.25, -1)),
			Body = { Yaw = -6, Lean = 10, Dip = 0.25, Forward = 0.3, Step = 0.5 } },
		{ T = 1, Weapon = "BASE" },
	},
}

-- Inspect: just handling it. Bring it up and look along the flat, tip it
-- up to check the edge, a little toss (the knife turns over once in the
-- air, not your wrist), catch, and back down. Every turn of the hand stays
-- within what a real wrist does.
local SHOW = kaim(V(0.25, -0.45, -1.15), V(-1, 0.25, -0.3))
local SHOW_TILT = kaim(V(0.22, -0.4, -1.12), V(-1, 0.35, -0.2))
local SHOW_EDGE = kaim(V(0.32, -0.42, -1.15), V(-0.2, 1, -0.2))
local TOSS_HOLD = kaim(V(0.35, -0.6, -1.2), V(-0.1, 1, -0.25))
CLIPS.Inspect = {
	Length = 2.6,
	Toss = { From = 0.42, To = 0.6, Height = 0.9, Spins = -1, Catch = 7 },
	Keys = {
		{ T = 0, Weapon = "BASE" },
		{ T = 0.12, Weapon = SHOW, Body = { NeckPitch = -10, NeckYaw = 6 } },
		{ T = 0.22, Weapon = SHOW_TILT, Body = { NeckPitch = -11, NeckYaw = 8 } },
		{ T = 0.32, Weapon = SHOW_EDGE, Body = { NeckPitch = -8, NeckYaw = 4 } },
		{ T = 0.38, Weapon = TOSS_HOLD * CFrame.new(0, -0.12, 0), Body = { NeckPitch = -4 } },
		{ T = 0.42, Weapon = TOSS_HOLD, Body = { NeckPitch = 4 } },
		{ T = 0.6, Weapon = TOSS_HOLD, Body = { NeckPitch = 6 } },
		{ T = 0.67, Weapon = TOSS_HOLD * CFrame.new(0, -0.14, 0), Body = { NeckPitch = -2, Dip = 0.05 } },
		{ T = 0.84, Weapon = KNIFE_IDLE * CFrame.Angles(rad(-18), 0, 0) },
		{ T = 1, Weapon = "BASE" },
	},
}

-- The knife airborne between Toss.From and Toss.To (key index Toss.Catch
-- is where it's caught): rises and falls, spinning end over end.
local function tossPose(clip, u, launch, catch)
	local toss = clip.Toss
	local f = seg(u, toss.From, toss.To)
	local pos = launch.Position:Lerp(catch.Position, f) + V(0, 4 * toss.Height * f * (1 - f), 0)
	local rot = launch.Rotation:Lerp(catch.Rotation, f) * CFrame.Angles(toss.Spins * math.pi * 2 * smoothstep(f), 0, 0)
	return CFrame.new(pos) * rot
end

local function knife(state, t, ctx)
	local base = KNIFE_IDLE:Lerp(KNIFE_SPRINT, ctx.Sprint or 0)
		* CFrame.new(0, math.sin(t * 1.6) * 0.012, 0)
		* CFrame.Angles(rad(math.sin(t * 1.1) * 1.5), 0, rad(math.sin(t * 0.8) * 1.2))
	local action = state.Action
	local clip = action and CLIPS[action.Clip]
	local weapon, left, body = base, GUARD, {}
	local right
	if clip then
		local u = (t - action.Start) / clip.Length
		if u >= 1 then
			state.Action = nil
		else
			weapon, left, body = playClip(clip, u, base, GUARD)
			local toss = clip.Toss
			if toss and u > toss.From and u < toss.To then
				-- in the air: the hand waits at the catch point
				local launchKey, catchKey
				for _, key in ipairs(clip.Keys) do
					if math.abs(key.T - toss.From) < 1e-6 then
						launchKey = key
					end
				end
				catchKey = clip.Keys[toss.Catch]
				local launch = launchKey and launchKey.Weapon ~= "BASE" and launchKey.Weapon or base
				local catch = catchKey.Weapon ~= "BASE" and catchKey.Weapon or base
				right = catch * HAND_ON_KNIFE * CFrame.new(0, -0.06 * math.sin(seg(u, toss.From, toss.To) * math.pi), 0)
				weapon = tossPose(clip, u, launch, catch)
			end
		end
	end
	-- the knife is held a little higher with the weapon out of a sprint
	return {
		Weapon = weapon,
		Right = right or weapon * HAND_ON_KNIFE,
		Left = left,
		Body = body,
	}
end

----------------------------------------------------------------------------
-- VICTORY: the round winner's pose at the end of the kill cam. The rifle
-- swings up onto the shoulder (or the knife comes up blade-high) and the
-- free hand punches the air.
----------------------------------------------------------------------------
local VICTORY_RIFLE = kaim(V(1.0, -0.95, 0.05), V(0.22, 1, 0.3))
local VICTORY_KNIFE = kaim(V(1.15, -0.55, -0.55), V(0.35, 1, -0.2))
local FIST_UP = CFrame.new(-1.2, 2.1, 0.15) * CFrame.Angles(0, 0, math.pi) * CFrame.Angles(0, rad(90), 0)

local function victory(anim, state, t)
	local v = t - state.VictoryStart
	if v < 0 or v > 6 then
		return anim
	end
	local w = easeOutBack(seg(v, 0, 0.45))
	local pump = easeOutBack(seg(v, 0.25, 0.6)) - 0.12 * math.sin(seg(v, 0.6, 1.4) * math.pi * 2)
	local knifeOut = state.Weapon == "Knife"
	local weapon = anim.Weapon:Lerp(knifeOut and VICTORY_KNIFE or VICTORY_RIFLE, w)
	return {
		Weapon = weapon,
		Right = weapon * (knifeOut and HAND_ON_KNIFE or RIGHT_ON_GRIP),
		Left = anim.Left:Lerp(FIST_UP, pump),
		Body = { Yaw = 12 * w, Lean = -7 * w, NeckPitch = -10 * w, NeckYaw = -8 * w },
		Bolt = CFrame.new(),
	}
end

----------------------------------------------------------------------------
-- State + public API
----------------------------------------------------------------------------
function WeaponAnim.New()
	return {
		Weapon = "Sniper",
		EquipStart = -10,
		FireStart = -10,
		BoltStart = -10,
		BoltLength = 0,
		InspectStart = -10,
		InspectKind = nil,
		InspectVariant = nil, -- which rifle inspect (1-3)
		VictoryStart = -10,
		Action = nil, -- knife clip { Clip, Start }
		SwingSide = 1,
	}
end

function WeaponAnim.SetWeapon(state, weapon, t)
	if weapon ~= "Knife" then
		weapon = "Sniper"
	end
	if state.Weapon == weapon then
		return false
	end
	state.Weapon = weapon
	state.EquipStart = t
	state.InspectStart = -10
	state.Action = weapon == "Knife" and { Clip = "Equip", Start = t } or nil
	return true
end

function WeaponAnim.Fire(state, t)
	state.FireStart = t
	state.InspectStart = -10
end

function WeaponAnim.Bolt(state, t, length)
	state.BoltStart = t
	state.BoltLength = length
end

-- kind: "Slash" (alternates forehand / backhand) or "Stab"; side forces a slash direction
function WeaponAnim.Knife(state, kind, t, side)
	if kind == "Slash" then
		state.SwingSide = side or -state.SwingSide
		state.Action = { Clip = state.SwingSide > 0 and "SlashA" or "SlashB", Start = t }
	elseif kind == "Stab" then
		state.Action = { Clip = "Stab", Start = t }
	end
end

-- Returns false if something else is playing. variant: which rifle inspect
-- (1-3); nil picks one at random (never the same twice in a row).
-- Returns true and the variant played.
function WeaponAnim.Inspect(state, t, variant)
	if state.Weapon == "Knife" then
		if state.Action then
			return false
		end
		state.Action = { Clip = "Inspect", Start = t }
	else
		if t - state.InspectStart < RIFLE_INSPECT_TIME or t - state.BoltStart < state.BoltLength then
			return false
		end
		if not variant and state.InspectVariant then
			variant = math.random(1, WeaponAnim.RifleInspects - 1)
			if variant >= state.InspectVariant then
				variant += 1 -- (skip the one you just did)
			end
		end
		variant = variant or math.random(1, WeaponAnim.RifleInspects)
		state.InspectStart = t
		state.InspectKind = "Rifle"
		state.InspectVariant = math.clamp(math.floor(variant), 1, WeaponAnim.RifleInspects)
	end
	return true, state.InspectVariant
end

-- The victory pose (holds until the state is reset).
function WeaponAnim.Victory(state, t)
	state.VictoryStart = t
	state.Action = nil
	state.BoltLength = 0
end

function WeaponAnim.IsBusy(state, t)
	return state.Action ~= nil or t - state.BoltStart < state.BoltLength
end

-- ctx: { Sprint = 0..1, Scope = 0..1, Profile = gun profile }
function WeaponAnim.Evaluate(state, t, ctx)
	local anim = state.Weapon == "Knife" and knife(state, t, ctx) or rifle(state, t, ctx)
	return victory(anim, state, t)
end

-- (for previews / tests)
WeaponAnim.Clips = CLIPS
WeaponAnim.KnifeIdle = KNIFE_IDLE

return WeaponAnim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">WeaponController</string>
            <string name="Source"><![CDATA[--[[
	WeaponController.lua  (Client.WeaponController)

	The sniper:
		Right mouse  scope (hold, or toggle in settings)
		Left mouse   fire

	When you fire, the client:
	  1. traces the bullet(s) locally with Ballistics (same code as the server)
	     so tracers appear instantly,
	  2. sends the shot + what it saw itself hit ("claims") to the server,
	  3. plays recoil, the bolt animation and sound.
	The SERVER decides the real damage (see CombatService).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Ballistics = require(Shared.Ballistics)
local Util = require(Shared.Util)
local ClientState = require(script.Parent.ClientState)
local Sfx = require(script.Parent.Sfx)
local Keybinds = require(script.Parent.Keybinds)

local W = Config.Weapon
local player = Players.LocalPlayer

local Weapon = {}
local Controllers

local scopeHeld = false
local scopeAlpha = 0
local boltReadyAt = 0

----------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------
function Weapon.GetScopeAlpha()
	return scopeAlpha
end

function Weapon.IsScoped()
	return scopeAlpha > 0.9
end

-- 0 = ready, 1 = just fired
function Weapon.GetBoltProgress()
	local stats = ClientState.Stats
	local remaining = boltReadyAt - os.clock()
	return math.clamp(remaining / stats.BoltTime, 0, 1)
end

----------------------------------------------------------------------------
-- Firing
----------------------------------------------------------------------------
local function canShoot()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return ClientState.CanShoot()
		and not ClientState.MenuOpen
		and humanoid
		and humanoid.Health > 0
		and not character:GetAttribute("Frozen")
end

-- Random direction inside a cone of `degrees` around `dir`.
local function applySpread(dir, degrees)
	if degrees <= 0 then
		return dir
	end
	local angle = math.rad(degrees) * math.sqrt(math.random())
	local spin = math.random() * math.pi * 2
	local cf = CFrame.lookAt(Vector3.zero, dir)
	return (cf * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function buildExclude()
	local list = { workspace.CurrentCamera }
	if player.Character then
		table.insert(list, player.Character)
	end
	local effects = workspace:FindFirstChild("Effects")
	if effects then
		table.insert(list, effects)
	end
	local decoys = workspace:FindFirstChild("Decoys")
	if decoys then
		for _, decoy in ipairs(decoys:GetChildren()) do
			if decoy:GetAttribute("OwnerUserId") == player.UserId then
				table.insert(list, decoy)
			end
		end
	end
	return list
end

local function fire()
	if not canShoot() or os.clock() < boltReadyAt then
		return
	end
	local camera = workspace.CurrentCamera
	local stats = ClientState.Stats
	local scoped = Weapon.IsScoped()

	local origin = camera.CFrame.Position
	local direction = applySpread(camera.CFrame.LookVector, scoped and W.ScopedSpreadDegrees or W.HipSpreadDegrees)

	local opponent = ClientState.GetOpponentPlayer()
	local opponentCharacter = opponent and opponent.Character
	local homingTargets = ClientState.GetHomingTargets()
	local exclude = buildExclude()

	local muzzle = Controllers.Viewmodel.GetMuzzlePosition()
	if scoped then
		-- tracer starts slightly below the screen centre when scoped
		muzzle = origin + camera.CFrame.LookVector * 1.5 - camera.CFrame.UpVector * 0.4
	end

	-- dense list (sparse arrays don't survive RemoteEvents): { {Index, Part, Point} }
	local claims = {}
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	for i, dir in ipairs(Ballistics.GetShotDirections(direction, stats.Bullets)) do
		local sim = Ballistics.Simulate({
			Origin = origin,
			Direction = dir,
			Stats = stats,
			Exclude = exclude,
			HomingTargets = homingTargets,
		})
		-- the enemy in a match, or a practice dummy in the lobby
		local hitModel = sim.Hit and sim.Hit.Model
		local hitEnemy = hitModel ~= nil
			and ((opponentCharacter ~= nil and hitModel == opponentCharacter) or hitModel:GetAttribute("Dummy") == true)
		if hitEnemy then
			table.insert(claims, { Index = i, Model = hitModel, Part = sim.Hit.Part.Name, Point = sim.Hit.Position })
		end
		Controllers.Effects.DrawShot(sim.Segments, sim.Passes, sim.EndPosition, sim.EndNormal, muzzle, {
			Explosive = stats.Explosive,
			HitPlayer = hitEnemy,
		})

		-- ROCKET JUMP: shooting near your own feet launches you
		if stats.RocketJump and i == 1 and root and sim.EndPosition then
			local offset = root.Position - sim.EndPosition
			local cfg = Config.PowerUps.RocketJump
			if offset.Magnitude <= cfg.Radius then
				local away = Util.safeUnit(Util.flat(offset))
				local power = stats.RocketJumpPower
				Controllers.Movement.ApplyImpulse((away * cfg.LaunchAway + Vector3.new(0, cfg.LaunchUp, 0)) * power)
				Controllers.Camera.Shake(3)
			end
		end
	end

	Remotes.Get("Fire"):FireServer(origin, direction, claims)
	Controllers.Effects.MuzzleFlash(Controllers.Viewmodel.GetMuzzlePosition(), camera.CFrame.LookVector)

	-- Bolt delay (Quickdraw is already in stats.BoltTime; Bullet Time speeds it up)
	local boltTime = stats.BoltTime
	if Controllers.Movement.IsBulletTime() then
		boltTime /= Config.PowerUps.BulletTime.BoltSpeedScale
	end
	boltReadyAt = os.clock() + boltTime

	Sfx.Play("Fire", { Pitch = 0.95 + math.random() * 0.1 })
	Controllers.Viewmodel.PlayFire(scoped)
	Controllers.Viewmodel.PlayBolt(boltTime)
	Controllers.Camera.AddRecoil(scoped and Config.Camera.ScopedRecoilPitch or Config.Camera.RecoilPitch)
	Controllers.Camera.Shake(scoped and 0.6 or 1.2)
end

----------------------------------------------------------------------------
-- Input
----------------------------------------------------------------------------
-- Roblox's own control scripts bind Space (and some mouse buttons) with
-- ContextActionService, which marks those inputs as "processed". So we only
-- ignore input while the player is typing in a text box (e.g. chat).
local function isTyping(processed)
	return processed and UserInputService:GetFocusedTextBox() ~= nil
end

local function onInputBegan(input, processed)
	if isTyping(processed) or ClientState.Weapon == "Knife" then
		return -- (KnifeController handles the knife)
	end
	if Keybinds.Matches("Fire", input) then
		fire()
	elseif Keybinds.Matches("Scope", input) then
		if ClientState.Settings.ToggleScope then
			scopeHeld = not scopeHeld
		else
			scopeHeld = true
		end
	end
end

local function onInputEnded(input)
	if Keybinds.Matches("Scope", input) then
		if not ClientState.Settings.ToggleScope then
			scopeHeld = false
		end
	end
end

local function update(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local allowed = ClientState.HasGun() and not ClientState.MenuOpen and humanoid and humanoid.Health > 0
		and ClientState.Weapon ~= "Knife"
	if not allowed then
		scopeHeld = false
	end
	local target = scopeHeld and 1 or 0
	local scopeTime = ClientState.Stats.ScopeInTime
	scopeAlpha = Util.approach(scopeAlpha, target, dt / math.max(scopeTime, 0.01))
end

function Weapon.Init(controllers)
	Controllers = controllers
end

function Weapon.Start()
	-- HAIR TRIGGER power-up: the server tells us a hit re-chambered the rifle
	Remotes.Get("Buff").OnClientEvent:Connect(function(buff)
		if typeof(buff) == "table" and buff.Type == "Rechamber" then
			boltReadyAt = math.min(boltReadyAt, os.clock() + 0.1)
			Controllers.Viewmodel.PlayBolt(0.18)
		end
	end)

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	Keybinds.VirtualBegan:Connect(onInputBegan) -- on-screen buttons (mobile)
	Keybinds.VirtualEnded:Connect(onInputEnded)
	RunService:BindToRenderStep("SniperWeapon", Enum.RenderPriority.Input.Value + 1, update)
end

return Weapon
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="64">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">CrateReveal</string>
              <string name="Source"><![CDATA[--[[
	CrateReveal.lua  (Client.ui.CrateReveal)

	The 2D half of the crate opening (CrateController does the 3D half):
	letterbox bars, a coloured edge glow, the rarity "climb" label, the
	white flash, and the reveal card: the rarity name slams in over spinning
	light rays, then the skin name, NEW / duplicate, keys left and the
	OPEN ANOTHER / CONTINUE buttons. Legendary rains confetti; Secret glitches.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)
local Theme = require(script.Parent.Theme)
local Logo = require(Shared.Logo)

local P = Config.Palette
local CR = Config.Crates

local CrateReveal = {}
CrateReveal.Again = Signal.new()
CrateReveal.Done = Signal.new()

local gui, unlocker
local barTop, barBottom, black, flash
local edges = {}
local tierLabel, tierSub
local card, rays, titleLabel, glitchA, glitchB, skinLabel, infoLabel, keysLabel, badge
local buttons, againButton, doneButton
local confetti = {}
local rayAngle = 0
local glitchUntil = 0
local revealColor = Color3.new(1, 1, 1)
local RAY_COUNT = 9

local function font(weight)
	return Theme.Font(weight or Enum.FontWeight.Heavy)
end

----------------------------------------------------------------------------
-- Build
----------------------------------------------------------------------------
function CrateReveal.Start(playerGui)
	gui = Theme.screen("CrateReveal", 60, playerGui)
	gui.Enabled = false
	unlocker = Theme.mouseUnlocker(gui)

	-- edge glow: four soft gradients in the current tier colour
	for i, info in ipairs({
		{ UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.35), 90 },
		{ UDim2.fromScale(0, 0.65), UDim2.fromScale(1, 0.35), -90 },
		{ UDim2.fromScale(0, 0), UDim2.fromScale(0.25, 1), 0 },
		{ UDim2.fromScale(0.75, 0), UDim2.fromScale(0.25, 1), 180 },
	}) do
		local edge = Theme.new("Frame", {
			Position = info[1],
			Size = info[2],
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			Parent = gui,
		})
		Theme.new("UIGradient", {
			Rotation = info[3],
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
			Parent = edge,
		})
		edges[i] = edge
	end

	-- letterbox
	barTop = Theme.new("Frame", { Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 5, Parent = gui })
	barBottom = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		ZIndex = 5,
		Parent = gui,
	})

	-- the climb label (COMMON... UNCOMMON... RARE...) near the bottom
	tierLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.8),
		Size = UDim2.fromScale(0.5, 0.075),
		TextScaled = true,
		FontFace = font(),
		TextTransparency = 1,
		ZIndex = 6,
		Parent = gui,
	})
	Theme.stroke(tierLabel, Color3.new(0, 0, 0), 3, 0.4).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	tierSub = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.735),
		Size = UDim2.fromScale(0.4, 0.03),
		TextScaled = true,
		Text = "OPENING CRATE",
		FontFace = font(Enum.FontWeight.Bold),
		TextColor3 = P.UIText,
		TextTransparency = 1,
		ZIndex = 6,
		Parent = gui,
	})

	-- reveal card (no background: it floats over the 3D scene)
	card = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.74),
		Size = UDim2.fromScale(1, 0.4),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 7,
		Parent = gui,
	})
	rays = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, -0.55),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = card,
	})
	for _ = 1, RAY_COUNT do
		local ray = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 46, 2.2, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.55,
			ZIndex = 2,
			Parent = rays,
		})
		Theme.new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.42, 0.5),
				NumberSequenceKeypoint.new(0.5, 0.15),
				NumberSequenceKeypoint.new(0.58, 0.5),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = ray,
		})
	end
	local function title(z, color)
		local label = Theme.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.18),
			Size = UDim2.fromScale(0.8, 0.34),
			TextScaled = true,
			FontFace = font(),
			TextColor3 = color,
			ZIndex = z,
			Parent = card,
		})
		return label
	end
	glitchA = title(3, Color3.fromRGB(255, 30, 60))
	glitchB = title(3, Color3.fromRGB(40, 230, 255))
	titleLabel = title(5, Color3.new(1, 1, 1))
	Theme.stroke(titleLabel, Color3.new(0, 0, 0), 4, 0.2).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	Theme.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200)),
		Rotation = 90,
		Parent = titleLabel,
	})
	skinLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.6, 0.13),
		TextScaled = true,
		FontFace = font(),
		ZIndex = 5,
		Parent = card,
	})
	Theme.stroke(skinLabel, Color3.new(0, 0, 0), 2, 0.4).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	infoLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.54),
		Size = UDim2.fromScale(0.6, 0.065),
		TextScaled = true,
		FontFace = font(Enum.FontWeight.Bold),
		TextColor3 = P.UIText,
		ZIndex = 5,
		Parent = card,
	})
	badge = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.03),
		Size = UDim2.fromOffset(84, 26),
		Text = "NEW!",
		TextSize = 18,
		FontFace = font(),
		TextColor3 = P.UIBackground,
		BackgroundTransparency = 0,
		BackgroundColor3 = P.AccentB,
		Rotation = -6,
		ZIndex = 6,
		Visible = false,
		Parent = card,
	})
	Theme.corner(badge, 8)

	-- buttons
	buttons = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.74),
		Size = UDim2.fromOffset(470, 50),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = card,
	})
	Theme.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = buttons,
	})
	againButton = Theme.button({
		Size = UDim2.fromOffset(240, 50),
		Text = "[X]  OPEN ANOTHER",
		TextSize = 19,
		LayoutOrder = 1,
		ZIndex = 6,
		Parent = buttons,
	})
	doneButton = Theme.button({
		Size = UDim2.fromOffset(200, 50),
		Text = "[SPACE]  CONTINUE",
		TextSize = 19,
		BackgroundColor3 = P.UIPanelLight,
		TextColor3 = P.UIText,
		LayoutOrder = 2,
		ZIndex = 6,
		Parent = buttons,
	})
	Theme.stroke(doneButton, P.UIText, 1.5, 0.7)
	keysLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.9),
		Size = UDim2.fromScale(0.5, 0.05),
		TextScaled = true,
		FontFace = font(Enum.FontWeight.Bold),
		TextColor3 = P.UIText,
		TextTransparency = 0.25,
		ZIndex = 6,
		Parent = card,
	})
	againButton.Activated:Connect(function()
		CrateReveal.Again:Fire()
	end)
	doneButton.Activated:Connect(function()
		CrateReveal.Done:Fire()
	end)

	-- small logo in the corner so clips/screenshots carry the brand
	local corner = Theme.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -24, 0.02, 0),
		Size = UDim2.fromOffset(190, 48),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = gui,
	})
	Logo.Make(corner, { Layout = "Inline", Color = P.UIText, Accent = P.AccentA })

	flash = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = gui,
	})
	black = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = gui,
	})
end

----------------------------------------------------------------------------
-- Pieces the controller drives
----------------------------------------------------------------------------
function CrateReveal.Show()
	gui.Enabled = true
	card.Visible = false
	unlocker.Visible = false
	tierLabel.TextTransparency = 1
	tierSub.TextTransparency = 1
	for _, edge in ipairs(edges) do
		edge.BackgroundTransparency = 1
	end
	Theme.tween(barTop, 0.6, { Size = UDim2.fromScale(1, 0.1) }, Enum.EasingStyle.Quint)
	Theme.tween(barBottom, 0.6, { Size = UDim2.fromScale(1, 0.1) }, Enum.EasingStyle.Quint)
	Theme.tween(tierSub, 0.5, { TextTransparency = 0.3 })
end

function CrateReveal.Hide()
	gui.Enabled = false
	unlocker.Visible = false
	barTop.Size = UDim2.fromScale(1, 0)
	barBottom.Size = UDim2.fromScale(1, 0)
	card.Visible = false
	for _, bit in ipairs(confetti) do
		bit.Frame:Destroy()
	end
	table.clear(confetti)
end

-- One step of the rarity climb.
function CrateReveal.Tier(rarity, final)
	tierLabel.Text = rarity.Name
	tierLabel.TextColor3 = rarity.Color
	tierLabel.TextTransparency = 0
	Theme.pop(tierLabel, final and 0.45 or 0.25)
	for _, edge in ipairs(edges) do
		edge.BackgroundColor3 = rarity.Color
		edge.BackgroundTransparency = final and 0.15 or 0.4
		Theme.tween(edge, 0.45, { BackgroundTransparency = final and 0.55 or 0.75 })
	end
end

-- The climb stalls (Secret fake-out): everything dims.
function CrateReveal.Stall()
	Theme.tween(tierLabel, 0.5, { TextTransparency = 0.7 })
	for _, edge in ipairs(edges) do
		Theme.tween(edge, 0.5, { BackgroundTransparency = 1 })
	end
end

function CrateReveal.Flash(color, time)
	flash.BackgroundColor3 = color or Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 0
	Theme.tween(flash, time or 0.7, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
end

function CrateReveal.Black(alpha, time)
	return Theme.tween(black, time or 0.25, { BackgroundTransparency = 1 - alpha })
end

local function spawnConfetti(colors, count)
	local size = gui.AbsoluteSize
	for _ = 1, count do
		local frame = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(math.random(6, 12), math.random(10, 18)),
			BackgroundColor3 = colors[math.random(1, #colors)],
			ZIndex = 8,
			Parent = gui,
		})
		table.insert(confetti, {
			Frame = frame,
			Pos = Vector2.new(size.X * (0.5 + (math.random() - 0.5) * 0.2), size.Y * 0.45),
			Vel = Vector2.new((math.random() - 0.5) * size.X * 1.4, -size.Y * (0.5 + math.random() * 0.7)),
			Spin = (math.random() - 0.5) * 900,
			Age = 0,
		})
	end
end

-- The big moment. info = { Rarity, Skin, New, Count, Keys, Free, CanAgain }
function CrateReveal.Reveal(info)
	local rarity, skin = info.Rarity, info.Skin
	revealColor = rarity.Color
	tierLabel.TextTransparency = 1
	tierSub.TextTransparency = 1
	card.Visible = true
	titleLabel.Text = rarity.Name
	glitchA.Text = rarity.Name
	glitchB.Text = rarity.Name
	titleLabel.TextColor3 = rarity.Color
	glitchA.Visible = rarity.Id == "Secret"
	glitchB.Visible = rarity.Id == "Secret"
	glitchUntil = rarity.Id == "Secret" and os.clock() + 1.6 or 0
	for _, ray in ipairs(rays:GetChildren()) do
		ray.BackgroundColor3 = rarity.Color
	end
	rays.Visible = true

	-- title slams in
	local scale = Theme.scaleOf(titleLabel)
	scale.Scale = 2.6
	titleLabel.TextTransparency = 0
	Theme.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)

	skinLabel.Text = string.upper(skin.Name)
	skinLabel.TextColor3 = P.UIText
	skinLabel.TextTransparency = 1
	local kind = skin.Weapon == "Knife" and "KNIFE SKIN" or "RIFLE SKIN"
	infoLabel.Text = info.New and (kind .. "  -  EQUIP IT IN THE LOCKER [L]")
		or ("%s  -  DUPLICATE  x%d"):format(kind, info.Count or 2)
	infoLabel.TextTransparency = 1
	badge.Visible = false
	buttons.Visible = false
	if info.Free then
		keysLabel.Text = "FREE OPENS IN STUDIO"
	elseif info.CrateType == "Elite" then
		keysLabel.Text = ("%d CREDITS LEFT"):format(info.Credits or 0)
	else
		keysLabel.Text = ("%d KEY%s LEFT"):format(info.Keys or 0, info.Keys == 1 and "" or "S")
	end
	keysLabel.TextTransparency = 1

	task.delay(0.35, function()
		Theme.tween(skinLabel, 0.35, { TextTransparency = 0 })
		Theme.pop(skinLabel, 0.2)
	end)
	task.delay(0.6, function()
		Theme.tween(infoLabel, 0.35, { TextTransparency = 0.1 })
		if info.New then
			badge.Visible = true
			Theme.pop(badge, 0.5)
		end
	end)
	task.delay(1.1, function()
		if not card.Visible then
			return
		end
		buttons.Visible = true
		againButton.Visible = info.CanAgain
		Theme.pop(buttons, 0.12)
		Theme.tween(keysLabel, 0.35, { TextTransparency = 0.25 })
		unlocker.Visible = true
	end)

	local tier = 1
	for i, r in ipairs(CR.Rarities) do
		if r.Id == rarity.Id then
			tier = i
		end
	end
	if tier >= 5 then
		spawnConfetti({ rarity.Color, Color3.new(1, 1, 1), rarity.Color:Lerp(Color3.new(1, 1, 1), 0.5) }, rarity.Id == "Secret" and 90 or 70)
	elseif tier >= 3 then
		spawnConfetti({ rarity.Color, Color3.new(1, 1, 1) }, 26)
	end
end

function CrateReveal.HideCard()
	card.Visible = false
	unlocker.Visible = false
end

function CrateReveal.IsShowingButtons()
	return card.Visible and buttons.Visible
end

-- True when OPEN ANOTHER is offered (you have a key, or it's free).
function CrateReveal.CanAgain()
	return CrateReveal.IsShowingButtons() and againButton.Visible
end

function CrateReveal.Update(dt)
	if not gui or not gui.Enabled then
		return
	end
	-- rays
	rayAngle += dt * 22
	for i, ray in ipairs(rays:GetChildren()) do
		ray.Rotation = rayAngle + (i - 1) * 180 / RAY_COUNT
		ray.BackgroundTransparency = 0.55 + math.sin(os.clock() * 3 + i) * 0.08
	end
	-- secret glitch: RGB-split copies jitter, the title flickers
	if os.clock() < glitchUntil then
		local j = 9
		glitchA.Position = UDim2.new(0.5, math.random(-j, j), 0.18, math.random(-j, j) * 0.5)
		glitchB.Position = UDim2.new(0.5, math.random(-j, j), 0.18, math.random(-j, j) * 0.5)
		titleLabel.TextTransparency = math.random() < 0.12 and 0.6 or 0
		titleLabel.Position = UDim2.new(0.5, math.random(-3, 3), 0.18, 0)
	elseif glitchA.Visible then
		glitchA.Visible = false
		glitchB.Visible = false
		titleLabel.TextTransparency = 0
		titleLabel.Position = UDim2.fromScale(0.5, 0.18)
	end
	-- confetti
	for i = #confetti, 1, -1 do
		local bit = confetti[i]
		bit.Age += dt
		bit.Vel = Vector2.new(bit.Vel.X * (1 - 1.2 * dt), bit.Vel.Y + gui.AbsoluteSize.Y * 1.1 * dt)
		bit.Pos += bit.Vel * dt
		bit.Frame.Position = UDim2.fromOffset(bit.Pos.X, bit.Pos.Y)
		bit.Frame.Rotation += bit.Spin * dt
		bit.Frame.BackgroundTransparency = math.clamp((bit.Age - 2.2) / 0.8, 0, 1)
		if bit.Age > 3 then
			bit.Frame:Destroy()
			table.remove(confetti, i)
		end
	end
end

return CrateReveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">DuelUI</string>
              <string name="Source"><![CDATA[--[[
	DuelUI.lua  (Client.ui.DuelUI)

	Playing a specific person instead of the random queue:

	  DUEL A PLAYER (U / controller R-stick click / DUEL button on mobile)
	      a list of everyone in the server; CHALLENGE sends them an invite.
	  INVITES
	      when someone challenges you (or asks for a rematch) a card pops up
	      at the top: ACCEPT or DECLINE (it expires after Config.Match.InviteTime).
	  REMATCH
	      the lobby shows a REMATCH button after a match (LobbyUI); the other
	      player gets an invite card here. Against a bot, rematch starts right away.

	The server checks everything (Remotes "Duel" / "DuelInvite", MatchService).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Keybinds = require(script.Parent.Parent.Keybinds)
local ClientState = require(script.Parent.Parent.ClientState)

local Palette = Config.Palette
local player = Players.LocalPlayer

local DuelUI = {}

local gui, panel, list, unlocker, inviteHolder
local isOpen = false
local openInvites = 0

local function updateMouse()
	local need = isOpen or openInvites > 0
	unlocker.Visible = need
	ClientState.SetMenu("Duel", need)
end

local function refreshList()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local count = 0
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			count += 1
			local row = Theme.panel({
				Size = UDim2.new(1, 0, 0, 44),
				BackgroundColor3 = Palette.UIPanelLight,
				LayoutOrder = count,
				Parent = list,
			})
			Theme.label({
				Position = UDim2.fromOffset(14, 0),
				Size = UDim2.new(1, -170, 1, 0),
				Text = other.DisplayName,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
				FontFace = Theme.Font(Enum.FontWeight.Bold),
				Parent = row,
			})
			local busy = other:GetAttribute("InMatch") == true
			local button = Theme.button({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(140, 32),
				Text = busy and "IN A MATCH" or "CHALLENGE",
				TextSize = 15,
				BackgroundColor3 = busy and Palette.UIPanel or Palette.UIAccent,
				TextColor3 = busy and Palette.UISubText or Palette.UIBackground,
				AutoButtonColor = not busy,
				Parent = row,
			})
			if not busy then
				button.Activated:Connect(function()
					Remotes.Get("Duel"):FireServer("Challenge", other.UserId)
					Sfx.Play("CardPick", { Volume = 0.6 })
					button.Text = "SENT"
					button.BackgroundColor3 = Palette.UIPanel
					button.TextColor3 = Palette.UISubText
				end)
			end
		end
	end
	if count == 0 then
		local row = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = list })
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = "Nobody else is here yet. Invite a friend to the server!",
			TextSize = 15,
			TextColor3 = Palette.UISubText,
			Parent = row,
		})
	end
end

function DuelUI.Open()
	if isOpen or ClientState.InMatch() then
		return
	end
	isOpen = true
	panel.Visible = true
	refreshList()
	updateMouse()
	Theme.pop(panel, 0.05)
end

function DuelUI.Close()
	if not isOpen then
		return
	end
	isOpen = false
	panel.Visible = false
	updateMouse()
end

-- An invite card: "<name> challenges you" with ACCEPT / DECLINE.
local function showInvite(data)
	if typeof(data) ~= "table" then
		return
	end
	local isRematch = data.Kind == "Rematch"
	local card = Theme.panel({
		Size = UDim2.fromOffset(440, 96),
		BackgroundColor3 = Palette.UIPanel,
		Parent = inviteHolder,
	})
	Theme.stroke(card, Palette.UIAccent, 2, 0.1)
	Theme.label({
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 26),
		Text = isRematch and (tostring(data.Name) .. " wants a rematch!") or (tostring(data.Name) .. " challenges you to a duel!"),
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = card,
	})
	local timer = Theme.new("Frame", {
		Position = UDim2.new(0, 16, 0, 40),
		Size = UDim2.new(1, -32, 0, 4),
		BackgroundColor3 = Palette.UIAccent,
		Parent = card,
	})
	local accept = Theme.button({
		Position = UDim2.new(0, 16, 1, -44),
		Size = UDim2.new(0.5, -22, 0, 34),
		Text = "ACCEPT",
		TextSize = 16,
		Parent = card,
	})
	local decline = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 1, -44),
		Size = UDim2.new(0.5, -22, 0, 34),
		Text = "DECLINE",
		TextSize = 16,
		BackgroundColor3 = Palette.UIPanelLight,
		TextColor3 = Palette.UIText,
		Parent = card,
	})
	openInvites += 1
	updateMouse()
	Sfx.Play("CardPick", { Volume = 0.8, Pitch = 1.4 })
	Theme.pop(card, 0.1)

	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		openInvites -= 1
		updateMouse()
		card:Destroy()
	end
	accept.Activated:Connect(function()
		if isRematch then
			Remotes.Get("Duel"):FireServer("Rematch")
		else
			Remotes.Get("Duel"):FireServer("Accept", data.From)
		end
		close()
	end)
	decline.Activated:Connect(function()
		if not isRematch then
			Remotes.Get("Duel"):FireServer("Decline", data.From)
		end
		close()
	end)
	local life = tonumber(data.Time) or Config.Match.InviteTime
	Theme.tween(timer, life, { Size = UDim2.new(0, 0, 0, 4) }, Enum.EasingStyle.Linear)
	task.delay(life, close)
	-- a match starting (you accepted, or they did) clears it too
	local connection
	connection = ClientState.Changed:Connect(function(snapshot)
		if snapshot.InMatch then
			close()
		end
		if closed then
			connection.Disconnect()
		end
	end)
end

function DuelUI.Start(playerGui)
	gui = Theme.screen("Duel", 7, playerGui)
	unlocker = Theme.mouseUnlocker(gui)

	panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 420),
		BackgroundColor3 = Palette.UIBackground,
		Visible = false,
		Parent = gui,
	})
	Theme.padding(panel, 18)
	Theme.label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = "DUEL A PLAYER",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})
	list = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 1, -96),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	local close = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(160, 40),
		Text = "CLOSE",
		TextSize = 17,
		Parent = panel,
	})
	close.Activated:Connect(DuelUI.Close)

	inviteHolder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 170),
		Size = UDim2.fromOffset(440, 320),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.new("UIListLayout", {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		Parent = inviteHolder,
	})

	Remotes.Get("DuelInvite").OnClientEvent:Connect(showInvite)

	local function onActionInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if Keybinds.Matches("DuelFriend", input) then
			if isOpen then
				DuelUI.Close()
			else
				DuelUI.Open()
			end
		elseif input.KeyCode == Enum.KeyCode.Escape and isOpen then
			DuelUI.Close()
		end
	end
	UserInputService.InputBegan:Connect(onActionInput)
	Keybinds.VirtualBegan:Connect(onActionInput)

	Players.PlayerAdded:Connect(function()
		if isOpen then
			refreshList()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if isOpen then
			task.defer(refreshList)
		end
	end)
	ClientState.Changed:Connect(function(snapshot)
		if snapshot.InMatch then
			DuelUI.Close()
		end
	end)
end

return DuelUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	HUD.lua  (Client.ui.HUD)

	In-match heads-up display:
		crosshair (hidden while scoped) + bolt reload bar
		hitmarkers (red for headshots, bigger on kills) + kill sound
		scope overlay (black outside a circle, thin reticle)
		scoreboard (names, round wins, round timer) with each player's
		    collected power-up icons underneath
		health bar, ability hints with cooldowns
		big centre banner (countdown, GO, round won/lost)
		damage vignette + direction indicator
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local Keybinds = require(script.Parent.Parent.Keybinds)

local Palette = Config.Palette
local player = Players.LocalPlayer

local HUD = {}
local Controllers

local gui
local crosshair, boltBar, boltFill
local hitmarker
local scope
local scoreboard, nameLabels, winLabels, timerLabel, roundLabel, iconRows
local healthBar, healthFill, healthText
local abilityList
local banner, bannerTitle, bannerSub
local vignette, indicator
local lastCountdownNumber
local bannerToken = 0
local bannerLine
local speedLines = {}
local speedLinesFrame
local lastWins = {}
local speedLabel

----------------------------------------------------------------------------
-- Building
----------------------------------------------------------------------------
local function buildCrosshair()
	crosshair = Theme.new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local function line(pos, size)
		local f = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = pos,
			Size = size,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = crosshair,
		})
		Theme.stroke(f, Palette.UIBackground, 1, 0.5)
		return f
	end
	line(UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(3, 3)) -- centre dot
	line(UDim2.new(0.5, 0, 0.5, -9), UDim2.fromOffset(2, 6))
	line(UDim2.new(0.5, 0, 0.5, 9), UDim2.fromOffset(2, 6))
	line(UDim2.new(0.5, -9, 0.5, 0), UDim2.fromOffset(6, 2))
	line(UDim2.new(0.5, 9, 0.5, 0), UDim2.fromOffset(6, 2))

	boltBar = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 26),
		Size = UDim2.fromOffset(34, 3),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.5,
		Visible = false,
		Parent = gui,
	})
	Theme.corner(boltBar, 2)
	boltFill = Theme.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = boltBar,
	})
	Theme.corner(boltFill, 2)

	hitmarker = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	})
	for i = 0, 3 do
		local tick = Theme.new("Frame", {
			Name = "Tick",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(10, 3),
			Rotation = 45 + i * 90,
			BackgroundColor3 = Palette.UIHitmarker,
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = hitmarker,
		})
		tick:SetAttribute("Angle", math.rad(45 + i * 90))
		Theme.new("UIStroke", { Thickness = 1, Color = Color3.new(0, 0, 0), Transparency = 0.5, Parent = tick })
	end
end

local function buildScope()
	scope = Theme.new("Frame", {
		Name = "Scope",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	-- The lens: a circle whose huge outer stroke paints everything outside it black.
	local lens = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.92),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundTransparency = 1,
		Parent = scope,
	})
	Theme.corner(lens, UDim.new(0.5, 0))

	-- Black surround: four panels cover everything outside the lens's square,
	-- and a ring outline covers the square's corners outside the circle.
	local black = Color3.fromRGB(8, 9, 12)
	local panels = {}
	for i = 1, 4 do
		panels[i] = Theme.new("Frame", { BackgroundColor3 = black, Parent = scope })
	end
	local mask = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = scope,
	})
	Theme.corner(mask, UDim.new(0.5, 0))
	local maskStroke = Theme.stroke(mask, black, 1, 0)
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		local d = math.floor(viewport.Y * 0.92)
		local left = math.floor((viewport.X - d) / 2)
		local top = math.floor((viewport.Y - d) / 2)
		panels[1].Position, panels[1].Size = UDim2.fromOffset(0, 0), UDim2.new(0, left + 1, 1, 0) -- left
		panels[2].Position, panels[2].Size = UDim2.new(0, left + d - 1, 0, 0), UDim2.new(1, -(left + d - 1), 1, 0) -- right
		panels[3].Position, panels[3].Size = UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, top + 1) -- top
		panels[4].Position, panels[4].Size = UDim2.new(0, 0, 0, top + d - 1), UDim2.new(1, 0, 1, -(top + d - 1)) -- bottom
		-- the corners between a circle and its square are ~0.21 x diameter deep
		mask.Size = UDim2.fromOffset(d, d)
		maskStroke.Thickness = math.ceil(d * 0.22) + 2
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	-- inner ring
	local ring = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = lens,
	})
	Theme.corner(ring, UDim.new(0.5, 0))
	Theme.stroke(ring, Color3.fromRGB(30, 34, 44), 10, 0)
	-- reticle lines
	local dark = Color3.fromRGB(12, 12, 16)
	Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = dark, Parent = lens })
	Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 1, 0), BackgroundColor3 = dark, Parent = lens })
	-- thicker outer posts
	Theme.new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0.3, 0, 0, 6), BackgroundColor3 = dark, Parent = lens })
	Theme.new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.new(0.3, 0, 0, 6), BackgroundColor3 = dark, Parent = lens })
	Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.new(0, 6, 0.3, 0), BackgroundColor3 = dark, Parent = lens })
	-- centre dot
	local dot = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(5, 5),
		BackgroundColor3 = Palette.UIDanger,
		Parent = lens,
	})
	Theme.corner(dot, UDim.new(0.5, 0))
end

local function buildScoreboard()
	scoreboard = Theme.new("Frame", {
		Name = "Scoreboard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(520, 110),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(420, 54),
		Parent = scoreboard,
	})
	nameLabels, winLabels, iconRows = {}, {}, {}
	for slot = 1, 2 do
		local left = slot == 1
		nameLabels[slot] = Theme.label({
			AnchorPoint = Vector2.new(left and 0 or 1, 0.5),
			Position = UDim2.new(left and 0 or 1, left and 16 or -16, 0.5, 0),
			Size = UDim2.fromOffset(130, 24),
			TextXAlignment = left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
			TextSize = 17,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = panel,
		})
		local chip = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, left and -36 or 36, 0.5, 0),
			Size = UDim2.fromOffset(46, 40),
			BackgroundColor3 = ClientState.GetSlotColor(slot),
			Parent = panel,
		})
		Theme.corner(chip, 8)
		winLabels[slot] = Theme.label({
			Size = UDim2.fromScale(1, 1),
			TextSize = 26,
			FontFace = Theme.Font(Enum.FontWeight.Heavy),
			Text = "0",
			Parent = chip,
		})
		-- collected power-ups under each player (5 per row, up to 3 rows)
		iconRows[slot] = Theme.new("Frame", {
			AnchorPoint = Vector2.new(left and 0 or 1, 0),
			Position = UDim2.new(0.5, left and -210 or 210, 0, 60),
			Size = UDim2.fromOffset(140, 80),
			BackgroundTransparency = 1,
			Parent = scoreboard,
		}, {
			Theme.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(24, 24),
				CellPadding = UDim2.fromOffset(4, 4),
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = left and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20),
		Text = "-",
		TextSize = 22,
		TextColor3 = Palette.UISubText,
		Parent = panel,
	})
	roundLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(120, 16),
		TextSize = 12,
		TextColor3 = Palette.UISubText,
		Parent = scoreboard,
	})
	timerLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.fromOffset(120, 20),
		TextSize = 18,
		Parent = scoreboard,
	})
end

local function buildHealth()
	local panel = Theme.panel({
		Name = "Health",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 22, 1, -22),
		Size = UDim2.fromOffset(260, 46),
		Visible = false,
		Parent = gui,
	})
	healthBar = panel
	Theme.padding(panel, 10)
	local track = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, -64, 0, 10),
		BackgroundColor3 = Palette.UIPanelLight,
		Parent = panel,
	})
	Theme.corner(track, 5)
	healthFill = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIText,
		Parent = track,
	})
	Theme.corner(healthFill, 5)
	healthText = Theme.label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(56, 26),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 24,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})
end

local function buildAbilities()
	abilityList = Theme.new("Frame", {
		Name = "Abilities",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -22, 1, -22),
		Size = UDim2.fromOffset(220, 140),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", {
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function buildBanner()
	banner = Theme.new("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(700, 140),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	bannerTitle = Theme.label({
		Size = UDim2.new(1, 0, 0, 90),
		TextSize = 78,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = banner,
	})
	Theme.new("UIStroke", { Thickness = 2, Transparency = 0.55, Color = Palette.UIBackground, Parent = bannerTitle })
	bannerLine = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 88),
		Size = UDim2.fromOffset(0, 4),
		BackgroundColor3 = Palette.UIAccent,
		Parent = banner,
	})
	Theme.corner(bannerLine, 2)
	bannerSub = Theme.label({
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(1, 0, 0, 30),
		TextSize = 22,
		TextColor3 = Palette.UISubText,
		Parent = banner,
	})
end

-- Speedometer (bottom centre): your horizontal speed, handy for bunny hopping.
local function buildSpeedometer()
	speedLabel = Theme.label({
		Name = "Speed",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(160, 24),
		TextSize = 20,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		TextTransparency = 0.15,
		Parent = gui,
	})
	Theme.new("UIStroke", { Thickness = 1.5, Transparency = 0.6, Color = Palette.UIBackground, Parent = speedLabel })
end

-- Speed lines: thin streaks at the screen edges when you're moving fast.
local function buildSpeedLines()
	speedLinesFrame = Theme.new("Frame", {
		Name = "SpeedLines",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	for i = 1, 18 do
		local line = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			Parent = speedLinesFrame,
		})
		Theme.new("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) }),
			Parent = line,
		})
		speedLines[i] = { Frame = line, Angle = (i / 18) * math.pi * 2 }
	end
end

local function updateSpeedLines(speed, scoped)
	if not speedLinesFrame then
		return
	end
	local from = Config.Effects.SpeedLinesFrom
	local alpha = Config.Effects.SpeedLines and not scoped and math.clamp((speed - from) / 45, 0, 1) or 0
	speedLinesFrame.Visible = alpha > 0
	if alpha <= 0 then
		return
	end
	local viewport = workspace.CurrentCamera.ViewportSize
	local center = viewport / 2
	local radius = math.min(viewport.X, viewport.Y) * 0.42
	for _, l in ipairs(speedLines) do
		local angle = l.Angle + (math.random() - 0.5) * 0.12
		local r = radius + math.random() * radius * 0.5
		local length = 60 + math.random() * 140 * alpha
		local dir = Vector2.new(math.cos(angle), math.sin(angle))
		local pos = center + dir * (r + length / 2)
		l.Frame.Position = UDim2.fromOffset(pos.X, pos.Y)
		l.Frame.Size = UDim2.fromOffset(length, 2)
		l.Frame.Rotation = math.deg(angle)
		l.Frame.BackgroundTransparency = 1 - alpha * (0.25 + math.random() * 0.35)
	end
end

local function buildDamage()
	vignette = Theme.new("Frame", {
		Name = "DamageVignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	-- four soft edges made with gradients
	local edges = {
		{ UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0), 90 },
		{ UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0.75), -90 },
		{ UDim2.fromScale(0.2, 1), UDim2.fromScale(0, 0), 0 },
		{ UDim2.fromScale(0.2, 1), UDim2.fromScale(0.8, 0), 180 },
	}
	for _, e in ipairs(edges) do
		local f = Theme.new("Frame", {
			Size = e[1],
			Position = e[2],
			BackgroundColor3 = Palette.UIDanger,
			Parent = vignette,
		})
		Theme.new("UIGradient", {
			Rotation = e[3],
			Transparency = NumberSequence.new(0, 1),
			Parent = f,
		})
	end
	vignette.Visible = false

	indicator = Theme.new("Frame", {
		Name = "DamageIndicator",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(240, 240),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local arrow = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(60, 6),
		BackgroundColor3 = Palette.UIDanger,
		Parent = indicator,
	})
	Theme.corner(arrow, 3)
end

----------------------------------------------------------------------------
-- Banner
----------------------------------------------------------------------------
local function showBanner(title, sub, color, duration)
	bannerToken += 1
	local token = bannerToken
	banner.Visible = true
	bannerTitle.Text = title
	bannerTitle.TextColor3 = color or Palette.UIText
	bannerSub.Text = sub or ""
	-- punch in: big + transparent -> normal, underline wipes open, subtitle fades in
	bannerTitle.TextTransparency = 1
	bannerTitle.Size = UDim2.new(1, 0, 0, 90)
	bannerTitle.TextSize = 110
	Theme.tween(bannerTitle, 0.3, { TextSize = 78, TextTransparency = 0 }, Enum.EasingStyle.Back)
	bannerLine.BackgroundColor3 = color or Palette.UIAccent
	bannerLine.BackgroundTransparency = 0
	bannerLine.Size = UDim2.fromOffset(0, 4)
	Theme.tween(bannerLine, 0.4, { Size = UDim2.fromOffset(title == "" and 0 or 260, 4) }, Enum.EasingStyle.Quint)
	bannerSub.TextTransparency = 1
	Theme.tween(bannerSub, 0.5, { TextTransparency = 0 })
	if duration then
		task.delay(duration, function()
			if bannerToken == token then
				Theme.tween(bannerTitle, 0.25, { TextTransparency = 1 })
				Theme.tween(bannerSub, 0.25, { TextTransparency = 1 })
				Theme.tween(bannerLine, 0.25, { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 4) })
				task.wait(0.25)
				if bannerToken == token then
					banner.Visible = false
				end
			end
		end)
	end
end

local function hideBanner()
	bannerToken += 1
	banner.Visible = false
end

-- Short coloured flash + text (Second Wind etc.)
function HUD.Flash(color, text)
	local flash = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.6,
		Parent = gui,
	})
	Theme.tween(flash, 0.6, { BackgroundTransparency = 1 })
	task.delay(0.65, function()
		flash:Destroy()
	end)
	if text then
		showBanner(text, nil, color, 1.2)
	end
end

----------------------------------------------------------------------------
-- Hits and damage
----------------------------------------------------------------------------
-- The X on a hit: the four ticks snap in from further out, hold for a
-- moment and fade. Headshots are red, kills are bigger and red, with a
-- second, wider X that flies out.
local hitToken = 0
function HUD.Hitmarker(headshot, killed)
	hitToken += 1
	local token = hitToken
	local color = (headshot or killed) and Palette.UIHeadshot or Palette.UIHitmarker
	local length, thick = killed and 15 or 10, killed and 4 or 3
	local radius = killed and 13 or 10
	for _, tick in ipairs(hitmarker:GetChildren()) do
		local angle = tick:GetAttribute("Angle")
		if angle then
			tick.BackgroundColor3 = color
			tick.BackgroundTransparency = 0
			tick.UIStroke.Transparency = 0.5
			tick.Size = UDim2.fromOffset(length * 1.4, thick)
			tick.Position = UDim2.new(0.5, math.cos(angle) * (radius + 9), 0.5, math.sin(angle) * (radius + 9))
			Theme.tween(tick, 0.07, {
				Position = UDim2.new(0.5, math.cos(angle) * radius, 0.5, math.sin(angle) * radius),
				Size = UDim2.fromOffset(length, thick),
			})
		end
	end
	hitmarker.Visible = true
	hitmarker.Rotation = killed and -12 or 0
	Theme.tween(hitmarker, 0.15, { Rotation = 0 }, Enum.EasingStyle.Back)
	task.delay(killed and 0.32 or 0.2, function()
		if token ~= hitToken then
			return -- a newer hit took over
		end
		for _, tick in ipairs(hitmarker:GetChildren()) do
			if tick:GetAttribute("Angle") then
				Theme.tween(tick, 0.25, { BackgroundTransparency = 1 })
				Theme.tween(tick.UIStroke, 0.25, { Transparency = 1 })
			end
		end
		task.delay(0.3, function()
			if token == hitToken then
				hitmarker.Visible = false
			end
		end)
	end)
	if killed then
		-- the wide X flying out
		for _, tick in ipairs(hitmarker:GetChildren()) do
			local angle = tick:GetAttribute("Angle")
			if angle then
				local ghost = tick:Clone()
				ghost:SetAttribute("Angle", nil)
				ghost.BackgroundTransparency = 0.2
				ghost.Parent = hitmarker
				Theme.tween(ghost, 0.35, {
					Position = UDim2.new(0.5, math.cos(angle) * 34, 0.5, math.sin(angle) * 34),
					BackgroundTransparency = 1,
				}, Enum.EasingStyle.Quint)
				Theme.tween(ghost.UIStroke, 0.35, { Transparency = 1 })
				task.delay(0.4, ghost.Destroy, ghost)
			end
		end
	end
end

local function onDamaged(data)
	Sfx.Play("Hurt")
	vignette.Visible = true
	for _, edge in ipairs(vignette:GetChildren()) do
		edge.BackgroundTransparency = 0.3
		Theme.tween(edge, 0.7, { BackgroundTransparency = 1 })
	end
	Controllers.Camera.Shake(1.5)
	-- point toward the attacker
	if data.From then
		local camera = workspace.CurrentCamera
		local toAttacker = data.From - camera.CFrame.Position
		local localDir = camera.CFrame:VectorToObjectSpace(toAttacker)
		local angle = math.deg(math.atan2(localDir.X, -localDir.Z))
		indicator.Rotation = angle
		indicator.Visible = true
		local arrow = indicator:FindFirstChildOfClass("Frame")
		arrow.BackgroundTransparency = 0
		Theme.tween(arrow, 1.2, { BackgroundTransparency = 1 })
	end
end

-- Floating damage number at the hit position (rises, pops and fades).
local function damageNumber(position, amount, headshot, splash, killed)
	if not Config.Effects.DamageNumbers or not position or not amount then
		return
	end
	local anchor = Instance.new("Attachment")
	anchor.WorldPosition = position
	anchor.Parent = workspace.Terrain
	local billboard = Theme.new("BillboardGui", {
		Adornee = anchor,
		Size = UDim2.fromOffset(160, 50),
		AlwaysOnTop = true,
		LightInfluence = 0,
		StudsOffsetWorldSpace = Vector3.new((math.random() - 0.5) * 1.5, 1, 0),
		Parent = gui.Parent, -- BillboardGuis live directly in PlayerGui
	})
	local color = headshot and Palette.UIHeadshot or splash and Palette.TracerExplosive or killed and Palette.UIAccent or Palette.UIText
	local label = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = headshot and "HEADSHOT" or tostring(math.floor(amount + 0.5)),
		TextSize = headshot and 30 or math.clamp(18 + amount * 0.12, 18, 34),
		TextColor3 = color,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = billboard,
	})
	Theme.new("UIStroke", { Thickness = 2, Color = Palette.UIBackground, Transparency = 0.2, Parent = label })
	Theme.pop(label, 0.5)
	Theme.tween(billboard, 0.8, { StudsOffsetWorldSpace = billboard.StudsOffsetWorldSpace + Vector3.new(0, 3, 0) }, Enum.EasingStyle.Quint)
	task.delay(0.45, function()
		Theme.tween(label, 0.35, { TextTransparency = 1 })
	end)
	task.delay(0.85, function()
		billboard:Destroy()
		anchor:Destroy()
	end)
end

local function onHitConfirm(data)
	HUD.Hitmarker(data.Headshot, data.Killed)
	damageNumber(data.Position, data.Damage, data.Headshot, data.Splash, data.Killed)
	if data.Killed then
		local viewport = workspace.CurrentCamera.ViewportSize
		Theme.burst(gui, viewport / 2, data.Headshot and Palette.UIHeadshot or Palette.UIAccent, 18, 120, 7)
		Theme.ring(gui, viewport / 2, data.Headshot and Palette.UIHeadshot or Color3.new(1, 1, 1), 160, 5)
		Sfx.Play("Kill")
		Sfx.Play("KillThump")
		Sfx.Play("HitTick", { Pitch = 0.85 })
		if data.Headshot then
			task.delay(0.05, Sfx.Play, "Ding")
		end
		if data.Backstab then
			showBanner("BACKSTAB", nil, Palette.AccentB, 1.4)
		elseif data.Melee then
			showBanner("KNIFED", nil, Palette.UIAccent, 1.2)
		else
			showBanner(data.Headshot and "HEADSHOT" or "ELIMINATED", nil, data.Headshot and Palette.UIHeadshot or Palette.UIText, 1.2)
		end
	elseif data.Headshot then
		Sfx.Play("Headshot")
		Sfx.Play("Ding")
		Sfx.Play("HitTick")
	else
		Sfx.Play("Hit", { Pitch = data.Splash and 0.8 or 1 })
		Sfx.Play("HitTick", { Pitch = data.Splash and 0.8 or 1 })
	end
end

----------------------------------------------------------------------------
-- State updates
----------------------------------------------------------------------------
local function rebuildIcons(snapshot)
	for slot = 1, 2 do
		local row = iconRows[slot]
		for _, child in ipairs(row:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local entry = snapshot.Players and snapshot.Players[slot]
		if entry then
			local order = 0
			for _, def in ipairs(PowerUps.Definitions) do
				local stacks = entry.PowerUps[def.Id]
				if stacks and stacks > 0 then
					order += 1
					local icon = Icons.Create(def, 24)
					icon.LayoutOrder = order
					Theme.stroke(icon, Config.Rarity[def.Rarity].Color, 1.5, 0)
					if stacks > 1 then
						Theme.label({
							AnchorPoint = Vector2.new(1, 1),
							Position = UDim2.new(1, 3, 1, 3),
							Size = UDim2.fromOffset(14, 12),
							Text = "x" .. stacks,
							TextSize = 10,
							FontFace = Theme.Font(Enum.FontWeight.Heavy),
							Parent = icon,
						})
					end
					icon.Parent = row
				end
			end
		end
	end
end

local function rebuildAbilities()
	for _, child in ipairs(abilityList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local stats = ClientState.Stats
	local entries = {}
	local device = game:GetService("UserInputService"):GetLastInputType().Name:find("Gamepad") and "Gamepad" or "Keyboard"
	local function key(actionId)
		return Keybinds.Label(Keybinds.Get(actionId, device))
	end
	if stats.Grapple then
		table.insert(entries, { Key = key("Grapple"), Name = "Grapple", Cooldown = "Grapple" })
	end
	if stats.Blink then
		table.insert(entries, { Key = key("Blink"), Name = "Blink", Cooldown = "Blink" })
	end
	if stats.Decoy then
		table.insert(entries, { Key = key("Decoy"), Name = "Decoy", Cooldown = "Decoy" })
	end
	if stats.BulletTime then
		table.insert(entries, { Key = key("Scope"), Name = "Bullet Time (air)", Cooldown = "BulletTime" })
	end
	for i, e in ipairs(entries) do
		local row = Theme.panel({
			Name = e.Name,
			Size = UDim2.fromOffset(210, 30),
			LayoutOrder = i,
			Parent = abilityList,
		})
		local key = Theme.new("Frame", {
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.fromOffset(52, 22),
			BackgroundColor3 = Palette.UIPanelLight,
			Parent = row,
		})
		Theme.corner(key, 6)
		Theme.label({ Size = UDim2.fromScale(1, 1), Text = e.Key, TextSize = 13, Parent = key })
		Theme.label({
			Position = UDim2.fromOffset(64, 0),
			Size = UDim2.new(1, -70, 1, 0),
			Text = e.Name,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		if e.Cooldown then
			local fill = Theme.new("Frame", {
				Name = "CooldownFill",
				Size = UDim2.fromScale(0, 1),
				BackgroundColor3 = Palette.UIBackground,
				BackgroundTransparency = 0.4,
				ZIndex = 2,
				Parent = row,
			})
			Theme.corner(fill)
			fill:SetAttribute("Cooldown", e.Cooldown)
		end
	end
end

function HUD.OnState(snapshot, old)
	local inMatch = snapshot.InMatch
	scoreboard.Visible = inMatch
	healthBar.Visible = inMatch
	abilityList.Visible = true -- also shows Power-Up Lab abilities in the lobby
	rebuildAbilities()
	if not inMatch then
		if old.InMatch then
			hideBanner()
		end
		return
	end

	for slot = 1, 2 do
		local entry = snapshot.Players[slot]
		nameLabels[slot].Text = entry and entry.Name or "-"
		nameLabels[slot].TextColor3 = (entry and entry.UserId == player.UserId) and Palette.UIAccent or Palette.UIText
		winLabels[slot].Text = entry and tostring(entry.Wins) or "0"
		-- pop + burst when a score goes up
		if entry and lastWins[slot] and entry.Wins > lastWins[slot] then
			local chip = winLabels[slot].Parent
			Theme.pop(chip, 0.4)
			local center = chip.AbsolutePosition + chip.AbsoluteSize / 2
			Theme.burst(gui, center, ClientState.GetSlotColor(slot), 12, 70, 6)
		end
		lastWins[slot] = entry and entry.Wins or 0
	end
	roundLabel.Text = ("ROUND %d  -  FIRST TO %d"):format(snapshot.Round or 1, snapshot.RoundsToWin or 5)
	rebuildIcons(snapshot)

	local phase = snapshot.Phase
	if phase ~= old.Phase or snapshot.Round ~= old.Round then
		if phase == "Countdown" then
			lastCountdownNumber = nil
			local map = snapshot.MapName and ("   -   " .. string.upper(snapshot.MapName)) or ""
			showBanner("", "ROUND " .. tostring(snapshot.Round) .. map, Palette.UIText)
		elseif phase == "Fight" then
			Sfx.Play("Go")
			showBanner("GO", nil, Palette.UIAccent, 0.7)
		elseif phase == "RoundEnd" then
			local won = snapshot.RoundWinnerUserId == player.UserId
			local me, opp = ClientState.GetMe(), ClientState.GetOpponentEntry()
			local score = me and opp and ("%d  -  %d"):format(me.Wins, opp.Wins) or ""
			local sub = snapshot.Message and (snapshot.Message .. "   " .. score) or score
			if snapshot.RoundWinnerUserId == nil then
				showBanner("DRAW", snapshot.Message, Palette.UISubText, 2.2)
			else
				showBanner(won and "ROUND WON" or "ROUND LOST", sub, won and Palette.UIAccent or Palette.UIDanger, 2.3)
			end
		elseif phase == "Pick" or phase == "PickReveal" or phase == "Victory" then
			hideBanner()
		end
	end
end

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

local function update()
	local inArena = ClientState.HasGun() -- lobby practice range or a live round
	local scopeAlpha = Controllers.Weapon.GetScopeAlpha()
	local firstPerson = Controllers.Camera.IsFirstPerson()

	crosshair.Visible = inArena and firstPerson and scopeAlpha < 0.3 and not ClientState.MenuOpen
	scope.Visible = inArena and scopeAlpha > 0.85
	local bolt = Controllers.Weapon.GetBoltProgress()
	boltBar.Visible = inArena and bolt > 0
	boltFill.Size = UDim2.fromScale(1 - bolt, 1)

	-- speedometer: white at normal speed, teal when bunny hopping fast
	local speed = Controllers.Movement.GetSpeed()
	speedLabel.Visible = inArena and scopeAlpha < 0.85 and not ClientState.MenuOpen
	speedLabel.Text = tostring(math.floor(speed + 0.5)) .. " u/s"
	speedLabel.TextColor3 = speed > Config.Movement.SprintSpeed + 6 and Palette.UIAccent or Palette.UIText
	updateSpeedLines(inArena and speed or 0, scopeAlpha > 0.3)

	-- health
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local fraction = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
		healthFill.Size = UDim2.fromScale(fraction, 1)
		healthFill.BackgroundColor3 = fraction < 0.35 and Palette.UIDanger or Palette.UIText
		healthText.Text = tostring(math.ceil(humanoid.Health))
	end

	-- timers
	local snapshot = ClientState.Snapshot
	local timeLeft = ClientState.TimeLeft()
	if snapshot.InMatch then
		if snapshot.Phase == "Fight" and timeLeft then
			timerLabel.Text = formatTime(timeLeft)
			timerLabel.TextColor3 = timeLeft < 15 and Palette.UIDanger or Palette.UIText
		else
			timerLabel.Text = ""
		end
		if snapshot.Phase == "Countdown" and timeLeft then
			local n = math.ceil(timeLeft)
			if n ~= lastCountdownNumber and n > 0 then
				lastCountdownNumber = n
				bannerTitle.Text = tostring(n)
				bannerTitle.TextSize = 110
				Theme.tween(bannerTitle, 0.3, { TextSize = 78 }, Enum.EasingStyle.Back)
				Sfx.Play("Countdown")
			end
		end
	end

	-- ability cooldowns
	local cooldowns = Controllers.Movement.GetCooldowns()
	for _, row in ipairs(abilityList:GetChildren()) do
		local fill = row:IsA("Frame") and row:FindFirstChild("CooldownFill")
		if fill then
			local name = fill:GetAttribute("Cooldown")
			local stats = ClientState.Stats
			local total = name == "Grapple" and stats.GrappleCooldown
				or name == "Blink" and math.max(stats.BlinkCooldown, 0.1)
				or name == "Decoy" and Config.PowerUps.Decoy.Cooldown
				or Config.PowerUps.BulletTime.Cooldown
			fill.Size = UDim2.fromScale(math.clamp((cooldowns[name] or 0) / total, 0, 1), 1)
		end
	end
end

function HUD.Init(controllers)
	Controllers = controllers
end

function HUD.Start(playerGui)
	gui = Theme.screen("HUD", 1, playerGui)
	buildScope()
	buildCrosshair()
	buildScoreboard()
	buildHealth()
	buildAbilities()
	buildBanner()
	buildDamage()
	buildSpeedometer()
	buildSpeedLines()

	Remotes.Get("HitConfirm").OnClientEvent:Connect(onHitConfirm)
	Remotes.Get("Damaged").OnClientEvent:Connect(onDamaged)
	RunService.RenderStepped:Connect(update)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Icons</string>
              <string name="Source"><![CDATA[--[[
	Icons.lua  (Client.ui.Icons)
	Draws a power-up's flat icon from the simple shape list in PowerUps.lua.
	No images needed: every icon is a few rounded frames on a coloured tile.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(script.Parent.Theme)

local Icons = {}

--[[
	def   power-up definition (PowerUps.Get(id))
	size  pixel size of the square icon
	Returns a Frame (not parented).
]]
function Icons.Create(def, size)
	local tile = Theme.new("Frame", {
		Name = "Icon_" .. def.Id,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = def.IconColor,
	})
	Theme.corner(tile, math.floor(size * 0.22))

	local scale = size / 64
	for _, shape in ipairs(def.Icon or {}) do
		local kind, x, y = shape[1], shape[2], shape[3]
		local color = shape.Dark and def.IconColor:Lerp(Config.Palette.UIBackground, 0.75) or Color3.new(1, 1, 1)
		local frame = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, y),
			BackgroundColor3 = color,
			BackgroundTransparency = shape.A or 0,
			Parent = tile,
		})
		if kind == "Circle" then
			frame.Size = UDim2.fromScale(shape[4], shape[4])
			Theme.corner(frame, UDim.new(0.5, 0))
		elseif kind == "Ring" then
			frame.Size = UDim2.fromScale(shape[4], shape[4])
			frame.BackgroundTransparency = 1
			Theme.corner(frame, UDim.new(0.5, 0))
			Theme.stroke(frame, color, math.max(1, (shape[5] or 3) * scale), shape.A or 0)
		else -- "Rect"
			frame.Size = UDim2.fromScale(shape[4], shape[5])
			frame.Rotation = shape[6] or 0
			Theme.corner(frame, UDim.new(shape.Round or 0.15, 0))
		end
	end
	return tile
end

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">LobbyUI</string>
              <string name="Source"><![CDATA[--[[
	LobbyUI.lua  (Client.ui.LobbyUI)

	The lobby / playground overlay (hidden while you're in a match, where the
	HUD takes over). Everything hugs the screen edges so the middle stays
	clear while you walk around the lobby in first person:

		top left      SNIPER DUEL wordmark (+ PLAYGROUND chip in the playground)
		top right     player card (avatar, name) + ONLINE, KEYS, CREDITS and RANK chips
		bottom left   action stack: REMATCH (after a match), FIND MATCH
		              (animated "searching" state with timer + queue count),
		              then Playground / Power-Up Lab / Duel / Settings /
		              Play vs bot (admins)

	The mouse is locked in first person, so every action shows its key /
	controller button in a keycap (rebindable in Settings > Keyboard /
	Controller).

	On touch screens the stack becomes one compact row at the top centre
	(Duel, Lab and Settings already have MobileControls buttons) so it never
	covers the thumbstick or the fire / jump buttons.

	Everything is laid out in "design pixels" on a single spacing scale (SP)
	and multiplied by a UIScale per corner group, so it fits a 800x400 phone
	and a 1920x1080 monitor alike.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Keybinds = require(script.Parent.Parent.Keybinds)
local ClientState = require(script.Parent.Parent.ClientState)

local Palette = Config.Palette
local player = Players.LocalPlayer

local LobbyUI = {}
local Controllers

-- one spacing scale for everything (design pixels, before UIScale)
local SP = { XS = 4, S = 8, M = 12, L = 16, XL = 24 }

-- sizes (design pixels)
local STACK_WIDTH = 340 -- desktop action stack
local PRIMARY_HEIGHT = 64
local REMATCH_HEIGHT = 44
local ROW_HEIGHT = 36
local ROW_GAP = 6
local COMPACT_HEIGHT = 46 -- touch: one row of buttons
local COMPACT_WIDTHS = { Rematch = 132, FindMatch = 184, Playground = 124, BotMatch = 72 }

-- secondary buttons (desktop order). Ids are Keybinds action ids.
local SECONDARY = {
	{ Id = "Playground", Text = "PLAYGROUND", Hint = "FREE ROAM" },
	{ Id = "PowerUpLab", Text = "POWER-UP LAB", Hint = "TRY BUILDS" },
	{ Id = "Locker", Text = "LOCKER", Hint = "SKINS" },
	{ Id = "Shop", Text = "SHOP", Hint = "CRATES + CREDITS" },
	{ Id = "DuelFriend", Text = "DUEL A PLAYER", Hint = "INVITE" },
	{ Id = "Settings", Text = "SETTINGS", Hint = "" },
	{ Id = "BotMatch", Text = "PLAY VS BOT", Hint = "ADMIN" },
}

local gui, root
local scrimLeft, scrimTop
local brand, brandMark, title, tagline, modeRow, modeChip, subtitle
local card, cardPanel, avatar, chipRow, onlineChip, onlineLabel, keysChip, keysLabel
local rankChip, rankLabel, rankTier, rankStroke
local creditsChip, creditsLabel
local stack, statusLabel
local primary, playButton, playgroundButton, rematchButton
local spinner, progressTrack, progressFill, shine, timeLabel, subLabel
local entries = {} -- [actionId] = button entry
local groupScales = {} -- UIScale of each anchored group

local shown = false
local queued = false
local compact = false
local searchStart = os.clock()
local lastSecs = -1
local lastKeys = nil
local lastSnapshot = { InMatch = false, Phase = "Lobby" }

-- Same rule the server uses (MatchService isAdmin); the server still checks.
local function canPlayBot()
	local admin = Config.Admin or {}
	if admin.BotForEveryone then
		return true
	end
	if admin.AllowEveryoneInStudio and RunService:IsStudio() then
		return true
	end
	return table.find(admin.UserIds or {}, player.UserId) ~= nil
end
local SHOW_BOT = canPlayBot()

local function usingGamepad()
	return UserInputService:GetLastInputType().Name:find("Gamepad") ~= nil
end

-- same rule as MobileControls (its buttons are shown exactly when this is true)
local function isTouch()
	return UserInputService.TouchEnabled
		and (UserInputService:GetLastInputType() == Enum.UserInputType.Touch or not UserInputService.KeyboardEnabled)
end

-- "F" or "D-RIGHT" depending on the device you're using
local function keyText(actionId)
	local device = usingGamepad() and "Gamepad" or "Keyboard"
	return Keybinds.Label(Keybinds.Get(actionId, device))
end

local function topInset()
	local inset = 0
	local ok, topLeft = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(topLeft) == "Vector2" then
		inset = topLeft.Y
	end
	local ok2, rect = pcall(function()
		return GuiService.TopbarInset
	end)
	if ok2 and typeof(rect) == "Rect" then
		inset = math.max(inset, rect.Max.Y)
	end
	return inset
end

local function formatTime(secs)
	return string.format("%d:%02d", math.floor(secs / 60), secs % 60)
end

----------------------------------------------------------------------------
-- Buttons
----------------------------------------------------------------------------

-- A button with a keycap chip on the left, a label and an optional hint on
-- the right. Hover / press animate its UIScale and stroke.
local function makeEntry(id, parent, opts)
	opts = opts or {}
	local textSize = opts.TextSize or 15
	local button = Theme.new("TextButton", {
		Name = id,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Palette.UIPanel,
		BackgroundTransparency = 0.2,
		Parent = parent,
	})
	Theme.corner(button, opts.Radius or 10)
	local stroke = Theme.stroke(button, Palette.UIText, 1, 0.88)
	local keySize = opts.KeySize or 12
	local cap, capLabel = Theme.keycap("-", keySize, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, SP.M, 0.5, 0),
		Parent = button,
	})
	local label = Theme.label({
		Name = "Label",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, SP.M, 0.5, opts.LabelY or 0),
		Size = UDim2.new(1, -SP.M * 2, 0, textSize + 4),
		TextSize = textSize,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		FontFace = Theme.Font(opts.Weight or Enum.FontWeight.Bold),
		Parent = button,
	})
	local hint
	if opts.Hint and opts.Hint ~= "" then
		hint = Theme.label({
			Name = "Hint",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -SP.M, 0.5, 0),
			Size = UDim2.fromOffset(96, 14),
			Text = opts.Hint,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Palette.UISubText,
			FontFace = Theme.Font(Enum.FontWeight.SemiBold),
			Parent = button,
		})
	end

	local scale = Theme.scaleOf(button)
	local entry = {
		Id = id,
		Button = button,
		Stroke = stroke,
		StrokeRest = 0.88,
		Cap = cap,
		CapLabel = capLabel,
		KeySize = keySize,
		Label = label,
		LabelY = opts.LabelY or 0,
		Hint = hint,
		Hover = false,
	}
	button.MouseEnter:Connect(function()
		entry.Hover = true
		Theme.tween(scale, 0.15, { Scale = 1.03 })
		Theme.tween(stroke, 0.15, { Transparency = math.min(entry.StrokeRest, 0.5) })
	end)
	button.MouseLeave:Connect(function()
		entry.Hover = false
		Theme.tween(scale, 0.15, { Scale = 1 })
		Theme.tween(stroke, 0.15, { Transparency = entry.StrokeRest })
	end)
	button.MouseButton1Down:Connect(function()
		Theme.tween(scale, 0.08, { Scale = 0.96 })
	end)
	button.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.25, { Scale = entry.Hover and 1.03 or 1 }, Enum.EasingStyle.Back)
	end)
	entries[id] = entry
	return entry
end

-- Sets the keycap + label of a button (and moves the label next to the cap).
local function setEntry(entry, key, text, showKey)
	entry.Label.Text = text
	local x = SP.M
	entry.Cap.Visible = showKey
	if showKey then
		local w = Theme.keycapWidth(key, entry.KeySize)
		entry.Cap.Size = UDim2.fromOffset(w, math.floor(entry.KeySize * 1.85))
		entry.CapLabel.Text = key
		x += w + SP.S + 2
	end
	entry.TextX = x
	entry.Label.Position = UDim2.new(0, x, 0.5, entry.LabelY)
	local rightPad = entry.RightPad or SP.M
	entry.Label.Size = UDim2.new(1, -(x + rightPad), 0, entry.Label.TextSize + 4)
	if entry.Hint then
		-- short keys only, so a long controller label never runs into it
		entry.Hint.Visible = showKey and #key <= 3
	end
end

-- Colours of a button: "primary" (accent), "gold" (AccentB), "active"
-- (highlighted outline) or "normal" (dark panel).
local function styleEntry(entry, style)
	local b = entry.Button
	if style == "primary" or style == "gold" then
		local color = style == "gold" and Palette.AccentB or Palette.UIAccent
		b.BackgroundColor3 = color
		b.BackgroundTransparency = 0
		entry.Label.TextColor3 = Palette.UIBackground
		entry.Stroke.Color = Palette.UIText
		entry.StrokeRest = 0.7
		entry.Cap.BackgroundColor3 = Palette.UIBackground
		entry.CapLabel.TextColor3 = color
	elseif style == "active" then
		b.BackgroundColor3 = Palette.UIPanel
		b.BackgroundTransparency = 0.08
		entry.Label.TextColor3 = Palette.UIAccent
		entry.Stroke.Color = Palette.UIAccent
		entry.StrokeRest = 0.25
		entry.Cap.BackgroundColor3 = Palette.UIPanelLight
		entry.CapLabel.TextColor3 = Palette.UIText
	else
		b.BackgroundColor3 = Palette.UIPanel
		b.BackgroundTransparency = 0.2
		entry.Label.TextColor3 = Palette.UIText
		entry.Stroke.Color = Palette.UIText
		entry.StrokeRest = 0.88
		entry.Cap.BackgroundColor3 = Palette.UIPanelLight
		entry.CapLabel.TextColor3 = Palette.UIText
	end
	entry.Stroke.Transparency = entry.Hover and math.min(entry.StrokeRest, 0.5) or entry.StrokeRest
end

----------------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------------

local function secondaryVisible(id)
	if id == "BotMatch" then
		return SHOW_BOT
	end
	if id == "Playground" then
		return true
	end
	return not compact -- Lab / Duel / Settings have MobileControls buttons on touch
end

local function layoutStack()
	local rematchOn = lastSnapshot.Rematch ~= nil
	rematchButton.Visible = rematchOn

	local function place(entry, x, y, w, h)
		entry.Button.Visible = true
		entry.Button.Size = UDim2.fromOffset(w, h)
		entry.Button.Position = UDim2.fromOffset(x + w / 2, y + h / 2)
	end

	if compact then
		-- one row at the top centre
		local order = {}
		if rematchOn then
			table.insert(order, "Rematch")
		end
		table.insert(order, "FindMatch")
		table.insert(order, "Playground")
		if SHOW_BOT then
			table.insert(order, "BotMatch")
		end
		for _, item in ipairs(SECONDARY) do
			entries[item.Id].Button.Visible = false
		end
		local x = 0
		for _, id in ipairs(order) do
			local w = COMPACT_WIDTHS[id]
			place(entries[id], x, 0, w, COMPACT_HEIGHT)
			x += w + SP.S
		end
		x -= SP.S
		statusLabel.Visible = true
		statusLabel.Position = UDim2.fromOffset(0, COMPACT_HEIGHT + SP.S)
		statusLabel.Size = UDim2.fromOffset(x, 16)
		statusLabel.TextXAlignment = Enum.TextXAlignment.Center
		stack.Size = UDim2.fromOffset(x, COMPACT_HEIGHT + SP.S + 16)
		return x
	else
		-- vertical stack, bottom left
		local y = 0
		if rematchOn then
			place(entries.Rematch, 0, y, STACK_WIDTH, REMATCH_HEIGHT)
			y += REMATCH_HEIGHT + SP.S
		end
		place(primary, 0, y, STACK_WIDTH, PRIMARY_HEIGHT)
		y += PRIMARY_HEIGHT + SP.M
		for _, item in ipairs(SECONDARY) do
			local entry = entries[item.Id]
			if secondaryVisible(item.Id) then
				place(entry, 0, y, STACK_WIDTH, ROW_HEIGHT)
				y += ROW_HEIGHT + ROW_GAP
			else
				entry.Button.Visible = false
			end
		end
		y -= ROW_GAP
		statusLabel.Visible = false
		stack.Size = UDim2.fromOffset(STACK_WIDTH, y)
	end
	return 0
end

local function layoutBrand()
	if compact then
		brandMark.Size = UDim2.fromOffset(30, 30)
		title.Position = UDim2.fromOffset(30 + SP.S, 0)
		title.Size = UDim2.fromOffset(180, 30)
		title.TextSize = 20
		title.Visible = true
		tagline.Visible = false
		modeRow.Visible = false
		brand.Size = UDim2.fromOffset(220, 30)
	else
		brandMark.Size = UDim2.fromOffset(48, 48)
		title.Position = UDim2.fromOffset(48 + SP.M, -2)
		title.Size = UDim2.fromOffset(320, 34)
		title.TextSize = 32
		title.Visible = true
		tagline.Visible = true
		modeRow.Visible = lastSnapshot.Playground == true
		brand.Size = UDim2.fromOffset(420, 48 + SP.M + 26)
	end
end

local function layoutCard()
	if compact then
		cardPanel.Visible = false
		onlineChip.Visible = false
		chipRow.Position = UDim2.fromScale(1, 0)
		card.Size = UDim2.fromOffset(200, 28)
	else
		cardPanel.Visible = true
		onlineChip.Visible = true
		chipRow.Position = UDim2.new(1, 0, 0, 56 + SP.S)
		card.Size = UDim2.fromOffset(260, 56 + SP.S + 28)
	end
end

-- Positions every group for the current screen size / device.
local function relayout()
	compact = isTouch()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local scale
	if compact then
		scale = math.clamp(math.min(viewport.X / 900, viewport.Y / 460), 0.72, 1.2)
	else
		scale = math.clamp(math.min(viewport.X / 1400, viewport.Y / 800), 0.6, 1.35)
	end
	for _, uiScale in ipairs(groupScales) do
		uiScale.Scale = scale
	end

	local margin = math.floor((compact and SP.M or SP.XL) * scale)
	local top = topInset() + math.floor((compact and SP.S or SP.L) * scale)
	brand.Position = UDim2.fromOffset(margin, top)
	card.Position = UDim2.new(1, -margin, 0, top)
	if compact then
		stack.AnchorPoint = Vector2.new(0.5, 0)
		stack.Position = UDim2.new(0.5, 0, 0, top)
	else
		stack.AnchorPoint = Vector2.new(0, 1)
		stack.Position = UDim2.new(0, margin, 1, -margin)
	end

	-- soft scrims so text stays readable over the 3D lobby (centre stays clear)
	scrimLeft.Visible = not compact
	scrimTop.Size = UDim2.new(1, 120, compact and 0.3 or 0.22, 60)

	-- text sizes for the compact row
	primary.Label.TextSize = compact and 18 or 22
	subLabel.TextSize = compact and 11 or 12
	primary.RightPad = compact and 36 or 112
	timeLabel.Visible = queued and not compact
	entries.Rematch.Label.TextSize = compact and 14 or 15
	for _, item in ipairs(SECONDARY) do
		entries[item.Id].Label.TextSize = compact and 14 or 15
	end

	layoutBrand()
	layoutCard()
	local rowWidth = layoutStack()
	if compact then
		-- a very wide row (rematch + bot on a small phone): keep just the mark
		local brandRight = margin + (30 + SP.S + 150) * scale
		local rowLeft = viewport.X / 2 - rowWidth * scale / 2
		title.Visible = rowLeft > brandRight + SP.S
	end
end

----------------------------------------------------------------------------
-- State
----------------------------------------------------------------------------

local function updateSearchText()
	local secs = math.max(0, math.floor(os.clock() - searchStart))
	lastSecs = secs
	local time = formatTime(secs)
	timeLabel.Text = time
	if compact then
		subLabel.Text = time .. " · TAP TO CANCEL"
	else
		subLabel.Text = string.format("%d IN QUEUE  ·  PRESS TO CANCEL", lastSnapshot.QueueCount or 1)
	end
end

local function refreshPrimary(snapshot)
	local showKey = not compact
	local count = snapshot.QueueCount or 0
	if queued then
		setEntry(primary, keyText("FindMatch"), "SEARCHING", showKey)
		styleEntry(primary, "active")
		primary.Label.TextColor3 = Palette.UIText
		subLabel.TextColor3 = Palette.UISubText
		subLabel.TextTransparency = 0
		updateSearchText()
	else
		setEntry(primary, keyText("FindMatch"), "FIND MATCH", showKey)
		styleEntry(primary, "primary")
		subLabel.TextColor3 = Palette.UIBackground
		subLabel.TextTransparency = 0.25
		if count > 0 then
			subLabel.Text = string.format("%d PLAYER%s WAITING", count, count == 1 and "" or "S")
		else
			subLabel.Text = string.format("1V1  ·  FIRST TO %d", Config.Match.RoundsToWin or 5)
		end
	end
	subLabel.Position = UDim2.new(0, primary.TextX or SP.M, 0.5, compact and 10 or 12)
	subLabel.Size = UDim2.new(1, -((primary.TextX or SP.M) + (compact and 36 or 48)), 0, 16)
	spinner.Visible = queued
	progressTrack.Visible = queued
	timeLabel.Visible = queued and not compact
	shine.Visible = not queued
end

local function refreshRematch(snapshot)
	local rematch = snapshot.Rematch
	local entry = entries.Rematch
	if not rematch then
		return
	end
	local name = string.upper(tostring(rematch.Name or "?"))
	local showKey = not compact
	if rematch.Requested then
		setEntry(entry, keyText("Rematch"), compact and "WAITING..." or ("WAITING FOR " .. name .. "..."), showKey)
		styleEntry(entry, "normal")
	elseif rematch.TheyRequested then
		setEntry(entry, keyText("Rematch"), compact and "ACCEPT" or ("ACCEPT REMATCH VS " .. name), showKey)
		styleEntry(entry, "gold")
	else
		setEntry(entry, keyText("Rematch"), compact and "REMATCH" or ("REMATCH " .. name), showKey)
		styleEntry(entry, "gold")
	end
end

local function refreshSecondaries(snapshot)
	local showKey = not compact
	for _, item in ipairs(SECONDARY) do
		local entry = entries[item.Id]
		local text = item.Text
		local style = "normal"
		if item.Id == "Playground" and snapshot.Playground then
			text = "BACK TO LOBBY"
			style = "active"
			if entry.Hint then
				entry.Hint.Text = "EXIT"
			end
		elseif item.Id == "Playground" and entry.Hint then
			entry.Hint.Text = item.Hint
		end
		if compact and item.Id == "BotMatch" then
			text = "BOT"
		elseif compact and item.Id == "Playground" and snapshot.Playground then
			text = "TO LOBBY"
		end
		setEntry(entry, keyText(item.Id), text, showKey)
		styleEntry(entry, style)
	end
end

local function refreshInfo(snapshot)
	local online = #Players:GetPlayers()
	onlineLabel.Text = string.format("%d ONLINE", online)

	-- playground chip under the wordmark (desktop) / status line (touch)
	modeChip.Visible = snapshot.Playground == true
	subtitle.Text = snapshot.Playground and "Free roam on the match map." or ""
	modeRow.Visible = snapshot.Playground == true and not compact

	local parts = {}
	if snapshot.Playground then
		table.insert(parts, "PLAYGROUND MODE")
	end
	table.insert(parts, string.format("%d ONLINE", online))
	local count = snapshot.QueueCount or 0
	if not queued and count > 0 then
		table.insert(parts, string.format("%d IN QUEUE", count))
	end
	statusLabel.Text = table.concat(parts, "  ·  ")
end

-- RANK chip: your tier + rating (RankService's "Rating" attribute)
local function refreshRank()
	local rating = tonumber(player:GetAttribute("Rating"))
	rankChip.Visible = rating ~= nil
	if not rating then
		return
	end
	local tier = Config.RankTier(rating)
	rankTier.Text = tier.Name
	rankTier.TextColor3 = tier.Color
	rankStroke.Color = tier.Color
	rankLabel.Text = tostring(math.floor(rating))
end

local function refreshKeys()
	local keys = tonumber(player:GetAttribute("Keys")) or 0
	keysLabel.Text = tostring(math.floor(keys))
	if lastKeys and keys > lastKeys and shown then
		Theme.pop(keysChip, 0.2)
	end
	lastKeys = keys
end

function LobbyUI.OnState(snapshot)
	lastSnapshot = snapshot
	if not gui then
		return
	end
	local visible = not snapshot.InMatch
	if visible and not shown then
		-- fade + slide the whole screen in
		gui.Enabled = true
		root.GroupTransparency = 1
		root.Position = UDim2.fromOffset(0, 24)
		Theme.tween(root, 0.45, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
	elseif not visible then
		gui.Enabled = false
	end
	shown = visible
	if not visible then
		return
	end

	local wasQueued = queued
	queued = snapshot.Queued == true
	if queued and not wasQueued then
		searchStart = os.clock()
		lastSecs = -1
	end

	relayout()
	refreshPrimary(snapshot)
	refreshRematch(snapshot)
	refreshSecondaries(snapshot)
	refreshInfo(snapshot)
end

function LobbyUI.Init(controllers)
	Controllers = controllers
end

----------------------------------------------------------------------------
-- Build
----------------------------------------------------------------------------

-- A group anchored to a screen corner, scaled as one piece.
local function group(name, anchor)
	local frame = Theme.new("Frame", {
		Name = name,
		AnchorPoint = anchor,
		BackgroundTransparency = 1,
		Parent = root,
	})
	table.insert(groupScales, Theme.scaleOf(frame))
	return frame
end

-- Crosshair logo mark: dark tile, accent ring, four ticks, red dot.
local function buildMark(parent)
	local tile = Theme.new("Frame", {
		Name = "Mark",
		BackgroundColor3 = Palette.UIPanel,
		BackgroundTransparency = 0.1,
		Parent = parent,
	})
	Theme.corner(tile, UDim.new(0.24, 0))
	Theme.stroke(tile, Palette.UIAccent, 1.5, 0.55)
	local ring = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.54, 0.54),
		BackgroundTransparency = 1,
		Parent = tile,
	})
	Theme.corner(ring, UDim.new(0.5, 0))
	Theme.stroke(ring, Palette.UIAccent, 2.5, 0)
	local ticks = {
		{ UDim2.fromScale(0.5, 0.15), UDim2.new(0, 2, 0.2, 0) },
		{ UDim2.fromScale(0.5, 0.85), UDim2.new(0, 2, 0.2, 0) },
		{ UDim2.fromScale(0.15, 0.5), UDim2.new(0.2, 0, 0, 2) },
		{ UDim2.fromScale(0.85, 0.5), UDim2.new(0.2, 0, 0, 2) },
	}
	for _, t in ipairs(ticks) do
		Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = t[1],
			Size = t[2],
			BackgroundColor3 = Palette.UIText,
			Parent = tile,
		})
	end
	local dot = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.12, 0.12),
		BackgroundColor3 = Palette.PlayerB,
		Parent = tile,
	})
	Theme.corner(dot, UDim.new(0.5, 0))
	return tile
end

-- Little gold key glyph for the KEYS chip.
local function buildKeyIcon(parent)
	local icon = Theme.new("Frame", {
		Name = "KeyIcon",
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = parent,
	})
	local bow = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(9, 9),
		BackgroundTransparency = 1,
		Parent = icon,
	})
	Theme.corner(bow, UDim.new(0.5, 0))
	Theme.stroke(bow, Palette.AccentB, 2, 0)
	Theme.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 9, 0.5, 0),
		Size = UDim2.fromOffset(9, 2),
		BackgroundColor3 = Palette.AccentB,
		Parent = icon,
	})
	Theme.new("Frame", {
		Position = UDim2.new(0, 13, 0.5, 0),
		Size = UDim2.fromOffset(2, 4),
		BackgroundColor3 = Palette.AccentB,
		Parent = icon,
	})
	Theme.new("Frame", {
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(2, 3),
		BackgroundColor3 = Palette.AccentB,
		Parent = icon,
	})
	return icon
end

-- A pill chip with a horizontal row inside (icon, value, caption).
local function buildChip(name, parent, order, strokeColor)
	local chip = Theme.new("Frame", {
		Name = name,
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Palette.UIPanel,
		BackgroundTransparency = 0.15,
		LayoutOrder = order,
		Parent = parent,
	})
	Theme.corner(chip, UDim.new(0.5, 0))
	Theme.stroke(chip, strokeColor or Palette.UIText, 1, strokeColor and 0.45 or 0.88)
	Theme.new("UIPadding", {
		PaddingLeft = UDim.new(0, SP.M - 2),
		PaddingRight = UDim.new(0, SP.M),
		Parent = chip,
	})
	Theme.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, SP.XS + 2),
		Parent = chip,
	})
	return chip
end

local function buildBrand()
	brand = group("Brand", Vector2.new(0, 0))
	brandMark = buildMark(brand)
	title = Theme.label({
		Name = "Title",
		RichText = true,
		Text = string.format('SNIPER <font color="#%s">DUEL</font>', Palette.UIAccent:ToHex()),
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = brand,
	})
	tagline = Theme.label({
		Name = "Tagline",
		Position = UDim2.fromOffset(48 + SP.M, 32),
		Size = UDim2.fromOffset(320, 14),
		Text = "1V1 SNIPER ARENA",
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.SemiBold),
		Parent = brand,
	})

	-- "PLAYGROUND" chip + explanation under the wordmark
	modeRow = Theme.new("Frame", {
		Name = "Mode",
		Position = UDim2.fromOffset(0, 48 + SP.M),
		Size = UDim2.fromOffset(420, 26),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = brand,
	})
	modeChip = Theme.new("Frame", {
		Size = UDim2.fromOffset(118, 26),
		BackgroundColor3 = Palette.AccentB,
		Parent = modeRow,
	})
	Theme.corner(modeChip, UDim.new(0.5, 0))
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = "PLAYGROUND",
		TextSize = 13,
		TextColor3 = Palette.UIBackground,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = modeChip,
	})
	subtitle = Theme.label({
		Position = UDim2.fromOffset(118 + SP.S + 2, 0),
		Size = UDim2.new(1, -(118 + SP.S + 2), 1, 0),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UIText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = modeRow,
	})
end

local function buildCard()
	card = group("Player", Vector2.new(1, 0))

	cardPanel = Theme.new("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(260, 56),
		BackgroundColor3 = Palette.UIPanel,
		BackgroundTransparency = 0.15,
		Parent = card,
	})
	Theme.corner(cardPanel, 12)
	Theme.stroke(cardPanel, Palette.UIText, 1, 0.88)
	avatar = Theme.new("ImageLabel", {
		Name = "Avatar",
		Position = UDim2.fromOffset(SP.S, SP.S),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Palette.UIPanelLight,
		ScaleType = Enum.ScaleType.Crop,
		Image = "",
		Parent = cardPanel,
	})
	Theme.corner(avatar, UDim.new(0.5, 0))
	Theme.stroke(avatar, Palette.UIAccent, 2, 0.2)
	Theme.label({
		Name = "DisplayName",
		Position = UDim2.fromOffset(40 + SP.L, 9),
		Size = UDim2.new(1, -(40 + SP.L + SP.M), 0, 20),
		Text = player.DisplayName,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		Parent = cardPanel,
	})
	Theme.label({
		Name = "UserName",
		Position = UDim2.fromOffset(40 + SP.L, 30),
		Size = UDim2.new(1, -(40 + SP.L + SP.M), 0, 16),
		Text = "@" .. player.Name,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = cardPanel,
	})
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		avatar.Image = (ok and image)
			or ("rbxthumb://type=AvatarHeadShot&id=" .. tostring(player.UserId) .. "&w=150&h=150")
	end)

	-- chips under the card: ONLINE, KEYS (right aligned)
	chipRow = Theme.new("Frame", {
		Name = "Chips",
		AnchorPoint = Vector2.new(1, 0),
		Size = UDim2.fromOffset(260, 28),
		BackgroundTransparency = 1,
		Parent = card,
	})
	Theme.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, SP.S),
		Parent = chipRow,
	})

	onlineChip = buildChip("Online", chipRow, 1)
	local dot = Theme.new("Frame", {
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Palette.AccentA,
		LayoutOrder = 1,
		Parent = onlineChip,
	})
	Theme.corner(dot, UDim.new(0.5, 0))
	onlineLabel = Theme.label({
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "1 ONLINE",
		TextSize = 12,
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		LayoutOrder = 2,
		Parent = onlineChip,
	})

	keysChip = buildChip("Keys", chipRow, 2, Palette.AccentB)
	buildKeyIcon(keysChip)
	keysLabel = Theme.label({
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "0",
		TextSize = 15,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		LayoutOrder = 2,
		Parent = keysChip,
	})
	Theme.label({
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "KEYS",
		TextSize = 11,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		LayoutOrder = 3,
		Parent = keysChip,
	})
	creditsChip = buildChip("Credits", chipRow, 3, Color3.fromRGB(255, 196, 60))
	creditsLabel = Theme.label({
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "0",
		TextSize = 15,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		LayoutOrder = 1,
		Parent = creditsChip,
	})
	Theme.label({
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "CREDITS",
		TextSize = 11,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		LayoutOrder = 2,
		Parent = creditsChip,
	})
	rankChip = buildChip("Rank", chipRow, 4, Palette.UIText)
	rankStroke = rankChip:FindFirstChildOfClass("UIStroke")
	rankTier = Theme.label({
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 12,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		LayoutOrder = 1,
		Parent = rankChip,
	})
	rankLabel = Theme.label({
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 15,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		LayoutOrder = 2,
		Parent = rankChip,
	})
	rankChip.Visible = false
end

local function buildStack()
	stack = group("Actions", Vector2.new(0, 1))

	-- REMATCH (after a match, for a little while)
	local rematch = makeEntry("Rematch", stack, { TextSize = 15, Weight = Enum.FontWeight.Heavy })
	rematchButton = rematch.Button
	rematchButton.Visible = false

	-- FIND MATCH (primary)
	primary = makeEntry("FindMatch", stack, {
		TextSize = 22,
		KeySize = 14,
		Radius = 12,
		LabelY = -8,
		Weight = Enum.FontWeight.Heavy,
	})
	playButton = primary.Button
	subLabel = Theme.label({
		Name = "Sub",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, SP.M, 0.5, 12),
		Size = UDim2.new(1, -SP.M * 2, 0, 16),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		Parent = playButton,
	})
	spinner = Theme.new("Frame", {
		Name = "Spinner",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -SP.L, 0.5, 0),
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = playButton,
	})
	Theme.corner(spinner, UDim.new(0.5, 0))
	local spinStroke = Theme.stroke(spinner, Palette.UIAccent, 3, 0)
	Theme.fade(spinStroke, 0, { { 0, 0 }, { 1, 1 } })
	timeLabel = Theme.label({
		Name = "Time",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -(SP.L + 22 + SP.M), 0.5, -8),
		Size = UDim2.fromOffset(60, 22),
		Text = "0:00",
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Palette.UIAccent,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Visible = false,
		Parent = playButton,
	})
	-- indeterminate progress bar along the bottom while searching
	progressTrack = Theme.new("Frame", {
		Name = "Progress",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -5),
		Size = UDim2.new(1, -SP.L * 2, 0, 3),
		BackgroundColor3 = Palette.UIPanelLight,
		ClipsDescendants = true,
		Visible = false,
		Parent = playButton,
	})
	Theme.corner(progressTrack, 2)
	progressFill = Theme.new("Frame", {
		Size = UDim2.fromScale(0.35, 1),
		BackgroundColor3 = Palette.UIAccent,
		Parent = progressTrack,
	})
	Theme.corner(progressFill, 2)
	shine = Theme.shine(playButton, 1.4, true, 0.22)

	-- secondary actions
	for i, item in ipairs(SECONDARY) do
		local entry = makeEntry(item.Id, stack, { TextSize = 15, Hint = item.Hint })
		entry.Button.LayoutOrder = i
	end
	playgroundButton = entries.Playground.Button

	-- status line (compact layout: online / queue / playground)
	statusLabel = Theme.label({
		Name = "Status",
		Size = UDim2.fromOffset(300, 16),
		TextSize = 12,
		TextColor3 = Palette.UIText,
		TextTransparency = 0.1,
		FontFace = Theme.Font(Enum.FontWeight.SemiBold),
		Visible = false,
		Parent = stack,
	})
	Theme.new("UIStroke", {
		Thickness = 1,
		Transparency = 0.6,
		Color = Palette.UIBackground,
		Parent = statusLabel,
	})
end

function LobbyUI.Start(playerGui)
	gui = Theme.screen("Lobby", 2, playerGui)
	-- keep clear of notches / rounded corners (the top bar is handled by topInset)
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	end)
	root = Theme.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})

	-- soft gradient scrims behind the panels (never over the centre)
	scrimLeft = Theme.new("Frame", {
		Name = "ScrimLeft",
		Position = UDim2.fromOffset(-60, -60),
		Size = UDim2.new(0.5, 60, 1, 120),
		BackgroundColor3 = Palette.UIBackground,
		ZIndex = 0,
		Parent = root,
	})
	Theme.fade(scrimLeft, 0, { { 0, 0.3 }, { 0.45, 0.68 }, { 1, 1 } })
	scrimTop = Theme.new("Frame", {
		Name = "ScrimTop",
		Position = UDim2.fromOffset(-60, -60),
		Size = UDim2.new(1, 120, 0.22, 60),
		BackgroundColor3 = Palette.UIBackground,
		ZIndex = 0,
		Parent = root,
	})
	Theme.fade(scrimTop, 90, { { 0, 0.35 }, { 1, 1 } })

	buildBrand()
	buildCard()
	buildStack()

	local function toggleQueue()
		Sfx.Play("CardPick", { Volume = 0.6 })
		Theme.pop(playButton, 0.06)
		Remotes.Get("QueueToggle"):FireServer()
	end
	local function togglePlayground()
		Sfx.Play("CardPick", { Volume = 0.6, Pitch = 0.8 })
		Theme.pop(playgroundButton, 0.06)
		Remotes.Get("PlaygroundToggle"):FireServer()
	end
	local function requestRematch()
		Sfx.Play("CardPick", { Volume = 0.6, Pitch = 1.1 })
		Theme.pop(rematchButton, 0.06)
		Remotes.Get("Duel"):FireServer("Rematch")
	end
	rematchButton.Activated:Connect(requestRematch)

	local function botMatch()
		Sfx.Play("CardPick", { Volume = 0.6, Pitch = 1.2 })
		Theme.pop(entries.BotMatch.Button, 0.06)
		Remotes.Get("AdminCommand"):FireServer("bot")
	end
	playButton.Activated:Connect(toggleQueue)
	playgroundButton.Activated:Connect(togglePlayground)
	entries.BotMatch.Button.Activated:Connect(botMatch)

	-- Lab / Duel / Settings buttons run the same code as their keys
	entries.PowerUpLab.Button.Activated:Connect(function()
		Theme.pop(entries.PowerUpLab.Button, 0.06)
		Keybinds.Press("PowerUpLab", true)
		Keybinds.Press("PowerUpLab", false)
	end)
	entries.Shop.Button.Activated:Connect(function()
		Theme.pop(entries.Shop.Button, 0.06)
		if Controllers and Controllers.Shop then
			Controllers.Shop.Toggle()
		end
	end)
	entries.Locker.Button.Activated:Connect(function()
		Theme.pop(entries.Locker.Button, 0.06)
		if Controllers and Controllers.Locker then
			Controllers.Locker.Toggle()
		end
	end)
	entries.DuelFriend.Button.Activated:Connect(function()
		Theme.pop(entries.DuelFriend.Button, 0.06)
		if Controllers and Controllers.Duel then
			Controllers.Duel.Open()
		end
	end)
	entries.Settings.Button.Activated:Connect(function()
		Theme.pop(entries.Settings.Button, 0.06)
		if Controllers and Controllers.Settings then
			Controllers.Settings.Toggle()
		end
	end)

	local function onActionInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if Controllers and Controllers.Settings and Controllers.Settings.IsOpen() then
			return -- rebinding keys / moving sliders in Settings
		end
		if not gui.Enabled then
			return
		end
		if Keybinds.Matches("FindMatch", input) then
			toggleQueue()
		elseif Keybinds.Matches("Playground", input) then
			togglePlayground()
		elseif Keybinds.Matches("BotMatch", input) then
			botMatch()
		elseif Keybinds.Matches("Rematch", input) and rematchButton.Visible then
			requestRematch()
		end
	end
	UserInputService.InputBegan:Connect(onActionInput)
	Keybinds.VirtualBegan:Connect(onActionInput)

	-- idle animations: spinner, progress bar and timer while searching, a
	-- soft pulse on the find button otherwise
	RunService.RenderStepped:Connect(function()
		if not gui.Enabled then
			return
		end
		local t = os.clock()
		if queued then
			spinner.Rotation = (t * 360) % 360
			local p = (t * 0.7) % 1
			progressFill.Position = UDim2.fromScale(p * 1.35 - 0.35, 0)
			if math.floor(t - searchStart) ~= lastSecs then
				updateSearchText()
			end
		else
			local pulse = (math.sin(t * 3) + 1) / 2
			playButton.BackgroundColor3 = Palette.UIAccent:Lerp(Color3.new(1, 1, 1), pulse * 0.1)
		end
	end)

	-- KEYS (crates): LocalPlayer attribute "Keys"
	refreshKeys()
	player:GetAttributeChangedSignal("Keys"):Connect(refreshKeys)
	-- CREDITS (bought in the SHOP): LocalPlayer attribute "Credits"
	local function refreshCredits()
		creditsLabel.Text = tostring(math.floor(tonumber(player:GetAttribute("Credits")) or 0))
	end
	refreshCredits()
	player:GetAttributeChangedSignal("Credits"):Connect(refreshCredits)
	-- RANK: LocalPlayer attribute "Rating"
	refreshRank()
	player:GetAttributeChangedSignal("Rating"):Connect(refreshRank)

	local function refreshIfShown()
		if shown then
			LobbyUI.OnState(lastSnapshot)
		end
	end
	Players.PlayerAdded:Connect(refreshIfShown)
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshIfShown)
	end)

	-- button labels follow your keybinds, the device you're using and the
	-- screen size
	ClientState.SettingsChanged:Connect(function()
		LobbyUI.OnState(lastSnapshot)
	end)
	UserInputService.LastInputTypeChanged:Connect(refreshIfShown)
	local function watchCamera()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshIfShown)
		end
	end
	watchCamera()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		watchCamera()
		refreshIfShown()
	end)
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(refreshIfShown)
	end)

	LobbyUI.OnState({ InMatch = false, Phase = "Lobby" })
end

return LobbyUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Locker</string>
              <string name="Source"><![CDATA[--[[
	Locker.lua  (Client.ui.Locker)

	Your skins. In the lobby press L (or the LOCKER button) to open it:
		* RIFLE / KNIFE tabs
		* every skin for that weapon: the ones you own in full colour, the
		  rest locked (open crates to get them)
		* the selected skin spins in a 3D preview; EQUIP puts it in your
		  hands (everyone sees it), DEFAULT goes back to the stock look
	The server checks you own a skin before equipping it (CrateService).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local GunModel = require(Shared.GunModel)
local KnifeModel = require(Shared.KnifeModel)
local Skins = require(Shared.Skins)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Keybinds = require(script.Parent.Parent.Keybinds)
local Theme = require(script.Parent.Theme)

local Palette = Config.Palette
local CR = Config.Crates
local player = Players.LocalPlayer

local Locker = {}

local W, H = 900, 560
local gui, panel, unlocker, grid, tabs, viewport, worldModel, previewCam
local nameLabel, rarityLabel, statusLabel, equipButton, defaultButton
local isOpen = false
local weapon = "Rifle" -- the open tab
local selected -- skin id (nil = default) shown in the preview
local owned = ClientState.OwnedSkins -- { [id] = count }
local equipped = {} -- { Rifle = id, Knife = id } (your RifleSkin / KnifeSkin attributes)
local waiting -- { Weapon, Id }: an equip sent to the server, not confirmed yet
local tiles = {} -- [skin id or "Default"] = { Frame, Stroke, Tag }
local preview -- { Model, Built, IsKnife, Scale }
local spin = 0

local rarityOf, tierOf = {}, {}
for i, rarity in ipairs(CR.Rarities) do
	rarityOf[rarity.Id] = rarity
	tierOf[rarity.Id] = i
end

----------------------------------------------------------------------------
-- 3D preview
----------------------------------------------------------------------------
local function buildPreview()
	if preview then
		preview.Model:Destroy()
		preview = nil
	end
	local model = Instance.new("Model")
	local isKnife = weapon == "Knife"
	local scale = isKnife and 2.2 or 1
	local built = Skins.Build(weapon, model, Skins.Get(selected), { Scale = scale, Anchored = true, Effects = false })
	model.Parent = worldModel
	preview = { Model = model, Built = built, IsKnife = isKnife, Scale = scale }
end

local function placePreview(dt)
	if not preview then
		return
	end
	spin += dt * 0.6
	local cf = CFrame.Angles(0, math.pi / 2 + math.sin(spin) * 0.6, 0) * CFrame.Angles(0, 0, math.rad(4))
	if preview.IsKnife then
		KnifeModel.Place(preview.Built, cf * CFrame.new(0, 0, 0.47 * preview.Scale))
	else
		GunModel.Place(preview.Built, cf * CFrame.new(0, 0, 1.4), 1)
	end
	-- a slow pulse for Legendary glow (the game does this for real weapons)
	local skin = Skins.Get(selected)
	if skin and skin.Pulse then
		local k = (math.sin(os.clock() * 3) + 1) / 2
		for _, part in ipairs(preview.Model:GetDescendants()) do
			if part:IsA("BasePart") and part:GetAttribute("PulseA") then
				part.Color = part:GetAttribute("PulseA"):Lerp(part:GetAttribute("PulseB"), k)
			end
		end
	end
end

----------------------------------------------------------------------------
-- Tiles + details
----------------------------------------------------------------------------
local function skinsForTab()
	local list = Skins.ForWeapon(weapon)
	table.sort(list, function(a, b)
		local ta, tb = tierOf[a.Rarity] or 0, tierOf[b.Rarity] or 0
		if ta ~= tb then
			return ta < tb
		end
		return a.Name < b.Name
	end)
	return list
end

local function refreshDetails()
	local skin = Skins.Get(selected)
	local rarity = skin and rarityOf[skin.Rarity]
	nameLabel.Text = skin and string.upper(skin.Name) or "STANDARD ISSUE"
	rarityLabel.Text = rarity and rarity.Name or "DEFAULT"
	rarityLabel.TextColor3 = rarity and rarity.Color or Palette.UISubText
	local count = skin and owned[skin.Id] or 0
	local isEquipped = equipped[weapon] == selected
	local isWaiting = waiting ~= nil and waiting.Weapon == weapon and waiting.Id == selected
	if isWaiting and not isEquipped then
		statusLabel.Text = "EQUIPPING..."
		statusLabel.TextColor3 = Palette.UISubText
	elseif isEquipped then
		statusLabel.Text = "EQUIPPED"
		statusLabel.TextColor3 = Palette.UIAccent
	elseif skin and count <= 0 then
		statusLabel.Text = skin.Elite and "LOCKED  -  ONLY IN THE ELITE CRATE (SHOP)" or "LOCKED  -  OPEN CRATES (SHOP OR CRATE VAULT)"
		statusLabel.TextColor3 = Palette.UISubText
	else
		statusLabel.Text = skin and (count > 1 and ("OWNED  x%d"):format(count) or "OWNED") or "ALWAYS AVAILABLE"
		statusLabel.TextColor3 = Palette.UIText
	end
	local canEquip = not isEquipped and (not skin or count > 0)
	equipButton.Text = isEquipped and "EQUIPPED" or (canEquip and "EQUIP" or "LOCKED")
	equipButton.AutoButtonColor = canEquip
	equipButton.BackgroundColor3 = canEquip and Palette.UIAccent or Palette.UIPanelLight
	equipButton.TextColor3 = canEquip and Palette.UIBackground or Palette.UISubText
end

local function refreshTiles()
	for id, tile in pairs(tiles) do
		local skinId = id ~= "Default" and id or nil
		local skin = Skins.Get(skinId)
		local have = not skin or (owned[skinId] or 0) > 0
		local isEquipped = equipped[weapon] == skinId
		local isSelected = selected == skinId
		tile.Frame.BackgroundColor3 = isSelected and Palette.UIPanelLight or Palette.UIPanel
		tile.Stroke.Thickness = isSelected and 3 or 1
		tile.Stroke.Transparency = (isSelected or isEquipped) and 0 or 0.55
		tile.Tag.Text = isEquipped and "EQUIPPED" or (have and "" or "LOCKED")
		tile.Tag.TextColor3 = isEquipped and Palette.UIAccent or Palette.UISubText
		for _, swatch in ipairs(tile.Swatches) do
			swatch.BackgroundTransparency = have and 0 or 0.75
		end
		tile.Name.TextTransparency = have and 0 or 0.45
	end
	refreshDetails()
end

local function select(id)
	if selected == id and preview then
		return
	end
	selected = id
	buildPreview()
	refreshTiles()
end

local function makeTile(skin, order)
	local id = skin and skin.Id or "Default"
	local rarity = skin and rarityOf[skin.Rarity]
	local color = rarity and rarity.Color or Palette.UISubText
	local frame = Theme.new("TextButton", {
		Name = id,
		Text = "",
		AutoButtonColor = true,
		BackgroundColor3 = Palette.UIPanel,
		LayoutOrder = order,
		Parent = grid,
	})
	Theme.corner(frame, 10)
	local stroke = Theme.stroke(frame, color, 1, 0.55)
	-- rarity stripe on the left
	Theme.new("Frame", {
		Size = UDim2.new(0, 4, 1, -16),
		Position = UDim2.fromOffset(6, 8),
		BackgroundColor3 = color,
		Parent = frame,
	})
	-- colour swatches
	local swatches = {}
	local colors = skin and { skin.Body, skin.Weapon == "Knife" and (skin.Blade or skin.Metal) or skin.Metal, skin.Accent }
		or { Color3.fromRGB(190, 164, 120), Color3.fromRGB(58, 60, 60), Color3.fromRGB(84, 86, 90) }
	if weapon == "Knife" and not skin then
		colors = { Color3.fromRGB(34, 36, 40), Color3.fromRGB(176, 182, 190), Color3.fromRGB(70, 74, 82) }
	end
	for i, c in ipairs(colors) do
		local swatch = Theme.new("Frame", {
			Position = UDim2.fromOffset(18 + (i - 1) * 16, 10),
			Size = UDim2.fromOffset(13, 13),
			BackgroundColor3 = c,
			Parent = frame,
		})
		Theme.corner(swatch, 7)
		Theme.stroke(swatch, Color3.new(0, 0, 0), 1, 0.6)
		table.insert(swatches, swatch)
	end
	if skin and skin.Glow then
		Theme.label({
			Position = UDim2.fromOffset(70, 8),
			Size = UDim2.new(1, -78, 0, 16),
			Text = (skin.Elite and "ELITE  " or "") .. (skin.Pulse and "GLOW + FX" or "GLOW"),
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = color,
			Parent = frame,
		})
	end
	local name = Theme.label({
		Position = UDim2.fromOffset(18, 28),
		Size = UDim2.new(1, -26, 0, 20),
		Text = skin and skin.Name or "Default",
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	Theme.label({
		Position = UDim2.fromOffset(18, 48),
		Size = UDim2.new(0.6, 0, 0, 14),
		Text = rarity and rarity.Name or "STANDARD",
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color,
		Parent = frame,
	})
	local tag = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 48),
		Size = UDim2.new(0.5, 0, 0, 14),
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
	frame.Activated:Connect(function()
		Sfx.Play("CardHover")
		select(skin and skin.Id or nil)
	end)
	tiles[id] = { Frame = frame, Stroke = stroke, Tag = tag, Swatches = swatches, Name = name }
end

local function buildTab()
	for _, tile in pairs(tiles) do
		tile.Frame:Destroy()
	end
	table.clear(tiles)
	makeTile(nil, 0)
	for i, skin in ipairs(skinsForTab()) do
		makeTile(skin, i)
	end
	for name, button in pairs(tabs) do
		local on = name == weapon
		button.BackgroundColor3 = on and Palette.UIAccent or Palette.UIPanelLight
		button.TextColor3 = on and Palette.UIBackground or Palette.UIText
	end
	selected = equipped[weapon]
	buildPreview()
	refreshTiles()
end

----------------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------------
function Locker.Open()
	if isOpen or ClientState.InMatch() or ClientState.MenuOpen then
		return
	end
	isOpen = true
	gui.Enabled = true
	unlocker.Visible = true
	ClientState.SetMenu("Locker", true)
	buildTab()
	panel.Size = UDim2.fromOffset(W - 40, H - 40)
	Theme.tween(panel, 0.2, { Size = UDim2.fromOffset(W, H) }, Enum.EasingStyle.Back)
	Sfx.Play("CardPick", { Pitch = 1.1, Volume = 0.6 })
end

function Locker.Close()
	if not isOpen then
		return
	end
	isOpen = false
	gui.Enabled = false
	unlocker.Visible = false
	ClientState.SetMenu("Locker", false)
	if preview then
		preview.Model:Destroy()
		preview = nil
	end
end

function Locker.IsOpen()
	return isOpen
end

function Locker.Toggle()
	if isOpen then
		Locker.Close()
	else
		Locker.Open()
	end
end

function Locker.Init() end

function Locker.Start(playerGui)
	gui = Theme.screen("Locker", 9, playerGui)
	gui.Enabled = false
	Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.35,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)

	panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H),
		BackgroundTransparency = 0,
		ClipsDescendants = true,
		Parent = gui,
	})
	Theme.padding(panel, 20)
	local scale = Theme.new("UIScale", { Parent = panel })
	local function fit()
		local view = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.min(1, (view.X - 40) / W, (view.Y - 40) / H)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	Theme.label({
		Size = UDim2.new(0.5, 0, 0, 34),
		Text = "LOCKER",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})
	Theme.label({
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(0.6, 0, 0, 20),
		Text = "Pick a skin for each weapon. Everyone sees it.  L: close",
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = panel,
	})

	-- tabs
	tabs = {}
	for i, name in ipairs({ "Rifle", "Knife" }) do
		local button = Theme.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -(2 - i) * 128, 0, 4),
			Size = UDim2.fromOffset(120, 36),
			Text = string.upper(name),
			TextSize = 16,
			Parent = panel,
		})
		button.Activated:Connect(function()
			if weapon ~= name then
				weapon = name
				Sfx.Play("CardHover", { Pitch = 1.2 })
				buildTab()
			end
		end)
		tabs[name] = button
	end

	-- left: the preview + details
	local left = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(0.46, -8, 1, -70),
		BackgroundColor3 = Palette.UIBackground,
		Parent = panel,
	})
	Theme.corner(left, 12)
	viewport = Theme.new("ViewportFrame", {
		Size = UDim2.new(1, 0, 1, -128),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(150, 155, 170),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, -0.6),
		Parent = left,
	})
	worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewport
	previewCam = Instance.new("Camera")
	previewCam.FieldOfView = 30
	previewCam.CFrame = CFrame.lookAt(Vector3.new(0, 1.2, 9.5), Vector3.new(0, 0, 0))
	previewCam.Parent = viewport
	viewport.CurrentCamera = previewCam

	nameLabel = Theme.label({
		Position = UDim2.new(0, 16, 1, -124),
		Size = UDim2.new(1, -32, 0, 30),
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = left,
	})
	rarityLabel = Theme.label({
		Position = UDim2.new(0, 16, 1, -94),
		Size = UDim2.new(0.5, 0, 0, 18),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})
	statusLabel = Theme.label({
		Position = UDim2.new(0, 16, 1, -74),
		Size = UDim2.new(1, -32, 0, 16),
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = left,
	})
	equipButton = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -12),
		Size = UDim2.new(1, -32, 0, 42),
		Text = "EQUIP",
		TextSize = 18,
		Parent = left,
	})
	equipButton.Activated:Connect(function()
		local skin = Skins.Get(selected)
		if equipped[weapon] == selected or (skin and (owned[skin.Id] or 0) <= 0) then
			return
		end
		if waiting and waiting.Weapon == weapon and waiting.Id == selected then
			return
		end
		Sfx.Play("CardPick", { Pitch = 1.2 })
		Theme.pop(equipButton, 0.06)
		-- shown as EQUIPPING until the server confirms (our RifleSkin / KnifeSkin attribute changes)
		local request = { Weapon = weapon, Id = selected }
		waiting = request
		Remotes.Get("SkinEquip"):FireServer(weapon, selected)
		refreshTiles()
		task.delay(3, function()
			if waiting == request then
				waiting = nil -- (refused or lost: show what we really have on)
				refreshTiles()
			end
		end)
	end)

	-- right: every skin for this weapon
	grid = Theme.new("ScrollingFrame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 70),
		Size = UDim2.new(0.54, 0, 1, -122),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Palette.UISubText,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.new(0.5, -6, 0, 68),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Theme.new("UIPadding", { PaddingRight = UDim.new(0, 8) }),
	})

	defaultButton = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(160, 42),
		Text = "DONE",
		TextSize = 18,
		Parent = panel,
	})
	defaultButton.Activated:Connect(Locker.Close)

	-- what you own (CrateController hears it from the server) and have on
	ClientState.SkinsChanged:Connect(function()
		owned = ClientState.OwnedSkins
		if isOpen then
			refreshTiles()
		end
	end)
	for _, name in ipairs({ "Rifle", "Knife" }) do
		equipped[name] = player:GetAttribute(name .. "Skin")
		player:GetAttributeChangedSignal(name .. "Skin"):Connect(function()
			equipped[name] = player:GetAttribute(name .. "Skin")
			if waiting and waiting.Weapon == name and waiting.Id == equipped[name] then
				waiting = nil
			end
			if isOpen then
				refreshTiles()
			end
		end)
	end

	RunService.RenderStepped:Connect(function(dt)
		if isOpen then
			placePreview(dt)
		end
	end)

	ClientState.Changed:Connect(function(snapshot)
		if snapshot.InMatch then
			Locker.Close()
		end
	end)

	local function onActionInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if require(script.Parent.SettingsMenu).IsOpen() then
			return
		end
		if Keybinds.Matches("Locker", input) then
			if isOpen then
				Locker.Close()
			elseif not ClientState.InMatch() then
				Locker.Open()
			end
		end
	end
	UserInputService.InputBegan:Connect(onActionInput)
	Keybinds.VirtualBegan:Connect(onActionInput)
end

return Locker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">MobileControls</string>
              <string name="Source"><![CDATA[--[[
	MobileControls.lua  (Client.ui.MobileControls)

	On-screen controls for phones and tablets. Shown while you're using a
	touch screen (hidden as soon as you use a keyboard, mouse or controller).

	  left side    Roblox's own thumbstick moves you; a small FIRE button
	               above it lets you shoot with your left thumb
	  right side   drag anywhere to look (sensitivity in Settings > Touch),
	               FIRE (you can keep dragging on it to aim), SCOPE, JUMP
	               (hold to bunny hop), SLIDE, SPRINT (toggle) and your
	               ability buttons (Grapple / Blink / Decoy, when you have them)
	  top          LAB (Power-Up Lab, in the lobby), DUEL (challenge a player),
	               SKINS (the Locker)
	               and a settings button

	Buttons don't do anything themselves: they press the same actions as
	the keys (Keybinds.Press), so every rule (cooldowns, menus...) applies.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(script.Parent.Theme)
local Keybinds = require(script.Parent.Parent.Keybinds)
local ClientState = require(script.Parent.Parent.ClientState)

local Palette = Config.Palette
local player = Players.LocalPlayer

local MobileControls = {}
local Controllers

local gui, root, lookPad
local buttons = {} -- [name] = button
local lookTouches = {} -- [InputObject] = true: touches that turn the camera
local sprintOn = false

local function isTouch()
	return UserInputService.TouchEnabled
		and (UserInputService:GetLastInputType() == Enum.UserInputType.Touch or not UserInputService.KeyboardEnabled)
end

-- A round button. onDown/onUp get called on press / release.
local function roundButton(name, text, size, anchorPos, color, onDown, onUp, dragToLook)
	local button = Theme.new("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = anchorPos,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color or Palette.UIPanel,
		BackgroundTransparency = 0.25,
		Text = text,
		TextColor3 = Palette.UIText,
		TextSize = math.floor(size * 0.2),
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		AutoButtonColor = false,
		Parent = root,
	})
	Theme.corner(button, UDim.new(0.5, 0))
	Theme.stroke(button, Palette.UIText, 2, 0.6)
	button.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		button.BackgroundTransparency = 0.05
		Theme.pop(button, 0.08)
		if dragToLook then
			lookTouches[input] = true
		end
		if onDown then
			onDown()
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		button.BackgroundTransparency = 0.25
		if onUp then
			onUp()
		end
	end)
	buttons[name] = button
	return button
end

local function pill(name, text, pos, onPress)
	local button = Theme.button({
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = pos,
		Size = UDim2.fromOffset(78, 34),
		Text = text,
		TextSize = 14,
		BackgroundColor3 = Palette.UIPanel,
		TextColor3 = Palette.UIText,
		Parent = root,
	})
	button.Activated:Connect(onPress)
	buttons[name] = button
	return button
end

local function hold(action)
	return function()
		Keybinds.Press(action, true)
	end, function()
		Keybinds.Press(action, false)
	end
end

local function tap(action)
	return function()
		Keybinds.Press(action, true)
		Keybinds.Press(action, false)
	end
end

local function refresh()
	local show = isTouch() and not ClientState.MenuOpen
	gui.Enabled = show
	if not show then
		return
	end
	local stats = ClientState.Stats
	local inMatch = ClientState.InMatch()
	buttons.Grapple.Visible = stats.Grapple == true
	buttons.Blink.Visible = stats.Blink == true
	buttons.Decoy.Visible = stats.Decoy == true
	buttons.Lab.Visible = not inMatch
	buttons.Skins.Visible = not inMatch
	buttons.Shop.Visible = not inMatch
	buttons.Duel.Visible = not inMatch
	buttons.Sprint.BackgroundColor3 = sprintOn and Palette.UIAccent or Palette.UIPanel
end

function MobileControls.Init(controllers)
	Controllers = controllers
end

function MobileControls.Start(playerGui)
	gui = Theme.screen("MobileControls", 1, playerGui)
	root = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local scale = Theme.scaleOf(root)

	-- look pad: the right part of the screen (behind the buttons). It's
	-- Active, so Roblox's camera ignores these touches and we turn instead.
	lookPad = Theme.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(0.55, 1),
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = 0,
		Parent = gui,
	})
	lookPad.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			lookTouches[input] = true
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if lookTouches[input] and Controllers and Controllers.Camera.AddTouchLook then
			Controllers.Camera.AddTouchLook(Vector2.new(input.Delta.X, input.Delta.Y))
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		lookTouches[input] = nil
	end)

	local T = Config.Touch
	local function br(x, y)
		return UDim2.new(1, -x, 1, -y) -- from the bottom-right corner
	end
	roundButton("Fire", "FIRE", T.FireButtonSize, br(200, 175), Palette.PlayerB, function()
		Keybinds.Press("Fire", true)
	end, function()
		Keybinds.Press("Fire", false)
	end, true)
	roundButton("FireLeft", "FIRE", 70, UDim2.new(0, 120, 1, -270), Palette.PlayerB, function()
		Keybinds.Press("Fire", true)
	end, function()
		Keybinds.Press("Fire", false)
	end)
	local scopeDown, scopeUp = hold("Scope")
	roundButton("Scope", "SCOPE", 72, br(85, 215), Palette.UIPanel, scopeDown, scopeUp, true)
	local jumpDown, jumpUp = hold("Jump")
	roundButton("Jump", "JUMP", 84, br(80, 95), Palette.UIPanel, jumpDown, jumpUp)
	roundButton("Slide", "SLIDE", 64, br(190, 65), Palette.UIPanel, tap("Slide"))
	roundButton("Sprint", "RUN", 56, br(290, 60), Palette.UIPanel, function()
		sprintOn = not sprintOn
		Keybinds.Press("Sprint", sprintOn)
		refresh()
	end)
	roundButton("Grapple", "HOOK", 58, br(80, 310), Palette.UIPanel, tap("Grapple"))
	roundButton("Blink", "BLINK", 58, br(150, 300), Palette.UIPanel, tap("Blink"))
	roundButton("Decoy", "DECOY", 58, br(220, 300), Palette.UIPanel, tap("Decoy"))
	-- switch rifle <-> knife (with the knife out, FIRE slashes and SCOPE stabs)
	roundButton("Knife", "KNIFE", 58, br(305, 165), Palette.UIPanel, function()
		if Controllers and Controllers.Knife then
			Controllers.Knife.Toggle()
		end
	end)

	pill("Lab", "LAB", UDim2.new(0, 60, 0, 120), tap("PowerUpLab"))
	pill("Duel", "DUEL", UDim2.new(0, 150, 0, 120), tap("DuelFriend"))
	pill("Shop", "SHOP", UDim2.new(0, 330, 0, 120), function()
		if Controllers and Controllers.Shop then
			Controllers.Shop.Toggle()
		end
	end)
	pill("Skins", "SKINS", UDim2.new(0, 240, 0, 120), function()
		if Controllers and Controllers.Locker then
			Controllers.Locker.Toggle()
		end
	end)
	pill("Settings", "MENU", UDim2.new(1, -60, 0, 64), tap("Settings"))

	-- smaller on small screens
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(viewport.X / 900, viewport.Y / 500), 0.65, 1.2)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	UserInputService.LastInputTypeChanged:Connect(refresh)
	ClientState.Changed:Connect(refresh)
	ClientState.MenuChanged:Connect(refresh)
	player.CharacterAdded:Connect(function()
		sprintOn = false
		refresh()
	end)
	refresh()
end

return MobileControls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">PickScreen</string>
              <string name="Source"><![CDATA[--[[
	PickScreen.lua  (Client.ui.PickScreen)

	Between rounds the player who DIED picks 1 of 5 power-up cards.

	CARD LAYOUT (top to bottom)
		rarity pill + "owned x1 > x2" badge
		icon on a glowing disc
		name, tag chips (Bullets / Damage / Movement ...)
		description
		STACKS footer: what another copy adds

	ANIMATION
		open     background fades in, title slides down
		deal     cards rise from below one after another, face down
		flip     each card flips over with a white flash; Legendary cards burst
		         with gold particles, a ring and a looping shine
		idle     cards float gently, glows breathe
		hover    lift + tilt toward the mouse + brighter glow (picker only)
		pick     chosen card flies to the centre with a burst; the rest fall away
		timer    bar drains, ticks and turns red in the last 5 seconds

	The winner sees the same cards but can't pick. The mouse is unlocked.
	Also used solo by the Power-Up Lab ("practice pick").
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Palette = Config.Palette
local player = Players.LocalPlayer

local CARD_W, CARD_H = 210, 318
local GAP = 22

local PickScreen = {}

local gui, overlay, title, subtitle, timerTrack, timerFill, timerText, row, unlocker
local cards = {} -- card records
local isOpen = false
local isPicker = false
local pickedIndex = nil
local openToken = 0
local practiceCallback = nil -- set when opened from the Power-Up Lab (solo practice)
local lastTimerSecond = nil

----------------------------------------------------------------------------
-- Card construction
----------------------------------------------------------------------------
local function chip(parent, text, color)
	local c = Theme.new("Frame", {
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 18),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.82,
		Parent = parent,
	})
	Theme.corner(c, 9)
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = c })
	Theme.label({
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		Text = string.upper(text),
		TextSize = 10,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.45),
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = c,
	})
	return c
end

local function makeCard(index, def, ownedStacks)
	local rarity = Config.Rarity[def.Rarity]
	local color = rarity.Color
	local rec = { Index = index, Def = def, Flipped = false, Phase = index * 0.9 }

	-- holder: fixed slot in the row layout
	local holder = Theme.new("Frame", {
		Name = "Card" .. index,
		Size = UDim2.fromOffset(CARD_W, CARD_H),
		BackgroundTransparency = 1,
		LayoutOrder = index,
		Parent = row,
	})
	-- mover: everything that animates (position / rotation / scale)
	local mover = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 160),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local scale = Theme.new("UIScale", { Parent = mover })

	-- soft glow (two layers) behind the card
	local glow = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 26, 1, 26),
		BackgroundColor3 = color,
		BackgroundTransparency = 1,
		Parent = mover,
	})
	Theme.corner(glow, 26)
	local glowInner = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 10, 1, 10),
		BackgroundColor3 = color,
		BackgroundTransparency = 1,
		Parent = mover,
	})
	Theme.corner(glowInner, 20)

	-- flipper: its width animates for the card flip
	local flipper = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = mover,
	})

	-- the card face (a CanvasGroup so it fades and clips as one piece)
	local card = Theme.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIPanel,
		GroupTransparency = 1,
		Parent = flipper,
	})
	Theme.corner(card, 16)
	local stroke = Theme.stroke(card, color, 2.5, 0)

	-- FRONT -----------------------------------------------------------
	local front = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = card })
	-- colour wash from the top
	local wash = Theme.new("Frame", { Size = UDim2.new(1, 0, 0.55, 0), BackgroundColor3 = color, Parent = front })
	Theme.new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.72), NumberSequenceKeypoint.new(1, 1) }),
		Parent = wash,
	})
	-- rarity pill
	local pill = Theme.new("Frame", {
		Position = UDim2.fromOffset(12, 12),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 20),
		BackgroundColor3 = color,
		Parent = front,
	})
	Theme.corner(pill, 10)
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9), Parent = pill })
	Theme.label({
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		Text = string.upper(def.Rarity),
		TextSize = 11,
		TextColor3 = Palette.UIBackground,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = pill,
	})
	if ownedStacks > 0 then
		local badge = Theme.new("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 12),
			Size = UDim2.fromOffset(64, 20),
			BackgroundColor3 = Palette.UIBackground,
			BackgroundTransparency = 0.3,
			Parent = front,
		})
		Theme.corner(badge, 10)
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = ("x%d > x%d"):format(ownedStacks, ownedStacks + 1),
			TextSize = 11,
			TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.4),
			FontFace = Theme.Font(Enum.FontWeight.Heavy),
			Parent = badge,
		})
	end
	-- icon on a glowing disc
	local disc = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(112, 112),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.82,
		Parent = front,
	})
	Theme.corner(disc, UDim.new(0.5, 0))
	Theme.stroke(disc, color, 1.5, 0.55)
	local icon = Icons.Create(def, 74)
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.Parent = disc
	-- name
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 166),
		Size = UDim2.new(1, -24, 0, 26),
		Text = def.Name,
		TextSize = 21,
		TextTruncate = Enum.TextTruncate.AtEnd,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = front,
	})
	-- tag chips
	local tags = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 194),
		Size = UDim2.new(1, -24, 0, 18),
		BackgroundTransparency = 1,
		Parent = front,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 5),
		}),
	})
	for _, tag in ipairs(def.Tags or {}) do
		chip(tags, tag, color)
	end
	-- description
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 220),
		Size = UDim2.new(1, -28, 0, 52),
		Text = def.Description,
		TextSize = 13,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = front,
	})
	-- stacking footer
	local footer = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.35,
		Parent = front,
	})
	Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = color, BackgroundTransparency = 0.5, Parent = footer })
	Theme.label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = "STACKS  " .. (def.Stacking or "-"),
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35),
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		Parent = footer,
	})

	-- BACK ------------------------------------------------------------
	local back = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color:Lerp(Palette.UIBackground, 0.7),
		Parent = card,
	})
	for i = -4, 4 do
		Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, i * 34, 0.5, 0),
			Size = UDim2.new(0, 10, 1.6, 0),
			Rotation = 30,
			BackgroundColor3 = color,
			BackgroundTransparency = 0.85,
			Parent = back,
		})
	end
	local diamond = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(70, 70),
		Rotation = 45,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.2,
		Parent = back,
	})
	Theme.corner(diamond, 12)
	Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(60, 60),
		Text = "?",
		TextSize = 42,
		TextColor3 = Palette.UIBackground,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = back,
	})

	-- white flash layer used when the card flips / is picked
	local flash = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 9,
		Parent = card,
	})

	local button = Theme.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 11,
		Parent = mover,
	})

	rec.Holder, rec.Mover, rec.Scale, rec.Glow, rec.GlowInner = holder, mover, scale, glow, glowInner
	rec.Flipper, rec.Card, rec.Stroke, rec.Front, rec.Back = flipper, card, stroke, front, back
	rec.Flash, rec.Button, rec.Color = flash, button, color
	rec.BaseGlow = def.Rarity == "Legendary" and 0.6 or def.Rarity == "Epic" and 0.72 or 0.82
	return rec
end

local function cardCenter(rec)
	local p, s = rec.Mover.AbsolutePosition, rec.Mover.AbsoluteSize
	return p + s / 2
end

----------------------------------------------------------------------------
-- Animations
----------------------------------------------------------------------------
local function dealAndFlip(rec, delay, token)
	task.delay(delay, function()
		if token ~= openToken then
			return
		end
		rec.Mover.Rotation = (rec.Index % 2 == 0) and 6 or -6
		-- 1) rise in, face down
		Theme.tween(rec.Card, 0.35, { GroupTransparency = 0 })
		Theme.tween(rec.Mover, 0.5, { Position = UDim2.fromScale(0.5, 0.5), Rotation = 0 }, Enum.EasingStyle.Back)
		Sfx.Play("CardHover", { Pitch = 0.7 + rec.Index * 0.08, Volume = 1.2 })
		task.wait(0.55)
		if token ~= openToken then
			return
		end
		-- 2) flip: squash to edge-on...
		Theme.tween(rec.Flipper, 0.12, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.12)
		if token ~= openToken then
			return
		end
		-- ...swap faces and open up with a flash
		rec.Back.Visible = false
		rec.Front.Visible = true
		rec.Flash.BackgroundTransparency = 0.2
		Theme.tween(rec.Flash, 0.45, { BackgroundTransparency = 1 })
		Theme.tween(rec.Flipper, 0.24, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back)
		rec.Flipped = true
		rec.GlowInner.BackgroundTransparency = 0.4
		Theme.tween(rec.GlowInner, 0.6, { BackgroundTransparency = rec.BaseGlow })

		local rarity = rec.Def.Rarity
		if rarity == "Legendary" then
			Sfx.Play("CardLegendary")
			task.wait(0.05)
			local center = cardCenter(rec)
			Theme.burst(gui, center, rec.Color, 22, 200, 9)
			Theme.ring(gui, center, rec.Color, 380, 8)
			Theme.shine(rec.Card, 1.4, true, 0.4)
			Theme.pop(rec.Mover, 0.1)
		elseif rarity == "Epic" then
			Sfx.Play("CardFlip", { Pitch = 1.25 })
			Theme.burst(gui, cardCenter(rec), rec.Color, 10, 130, 7)
			Theme.shine(rec.Card, 0.7, false, 0.35)
		else
			Sfx.Play("CardFlip", { Pitch = 1 + Config.Rarity[rarity].Order * 0.08 })
			Theme.shine(rec.Card, 0.6, false, 0.25)
		end
	end)
end

local function setHover(rec, hovered)
	if not isPicker or pickedIndex or not rec.Flipped then
		return
	end
	rec.Hovered = hovered
	if hovered then
		Sfx.Play("CardHover")
		Theme.tween(rec.Mover, 0.18, { Position = UDim2.new(0.5, 0, 0.5, -20) }, Enum.EasingStyle.Back)
		Theme.tween(rec.Scale, 0.18, { Scale = 1.07 }, Enum.EasingStyle.Back)
		Theme.tween(rec.Stroke, 0.18, { Thickness = 4.5 })
		Theme.tween(rec.Glow, 0.18, { BackgroundTransparency = 0.7 })
	else
		Theme.tween(rec.Mover, 0.2, { Position = UDim2.fromScale(0.5, 0.5), Rotation = 0 })
		Theme.tween(rec.Scale, 0.2, { Scale = 1 })
		Theme.tween(rec.Stroke, 0.2, { Thickness = 2.5 })
		Theme.tween(rec.Glow, 0.2, { BackgroundTransparency = 1 })
	end
end

local function playPickAnimation(index)
	if pickedIndex == index and cards[index] and cards[index].Animated then
		return
	end
	pickedIndex = index
	local chosen = cards[index]
	if not chosen then
		return
	end
	chosen.Animated = true
	Sfx.Play("CardPick")

	-- the chosen card flies to the centre of the screen
	local viewport = workspace.CurrentCamera.ViewportSize
	local center = cardCenter(chosen)
	local rowScale = row:FindFirstChildOfClass("UIScale")
	local s = rowScale and rowScale.Scale or 1
	local dx = (viewport.X / 2 - center.X) / s
	chosen.Back.Visible = false
	chosen.Front.Visible = true
	chosen.Card.GroupTransparency = 0
	chosen.Flipper.Size = UDim2.fromScale(1, 1)
	chosen.Holder.ZIndex = 5
	Theme.tween(chosen.Mover, 0.45, { Position = UDim2.new(0.5, dx, 0.5, -10), Rotation = 0 }, Enum.EasingStyle.Quint)
	chosen.Scale.Scale = 1.3
	Theme.tween(chosen.Scale, 0.5, { Scale = 1.18 }, Enum.EasingStyle.Back)
	Theme.tween(chosen.Stroke, 0.2, { Thickness = 5, Color = Color3.new(1, 1, 1) })
	chosen.Flash.BackgroundTransparency = 0
	Theme.tween(chosen.Flash, 0.5, { BackgroundTransparency = 1 })
	chosen.Glow.BackgroundTransparency = 0.35
	Theme.tween(chosen.Glow, 0.8, { BackgroundTransparency = 0.6 })
	task.delay(0.3, function()
		if not chosen.Mover.Parent then
			return
		end
		local c = cardCenter(chosen)
		Theme.burst(gui, c, chosen.Color, 26, 260, 10)
		Theme.burst(gui, c, Color3.new(1, 1, 1), 12, 180, 6)
		Theme.ring(gui, c, chosen.Color, 520, 10)
		Theme.tween(chosen.Stroke, 0.4, { Color = chosen.Color })
		Theme.shine(chosen.Card, 0.6, false, 0.5)
	end)

	-- the others fall away
	for i, rec in ipairs(cards) do
		if i ~= index then
			task.delay(math.abs(i - index) * 0.05, function()
				Theme.tween(rec.Mover, 0.55, {
					Position = UDim2.new(0.5, 0, 0.5, 420),
					Rotation = (i < index) and -18 or 18,
				}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
				Theme.tween(rec.Card, 0.45, { GroupTransparency = 1 })
				Theme.tween(rec.Glow, 0.3, { BackgroundTransparency = 1 })
				Theme.tween(rec.GlowInner, 0.3, { BackgroundTransparency = 1 })
			end)
		end
	end

	local def = chosen.Def
	if isPicker then
		title.Text = "YOU PICKED " .. string.upper(def.Name)
	else
		local opp = ClientState.GetOpponentEntry()
		title.Text = (opp and string.upper(opp.Name) or "OPPONENT") .. " PICKED " .. string.upper(def.Name)
	end
	title.TextColor3 = chosen.Color
	Theme.pop(title, 0.2)
	subtitle.Text = "STACKS  " .. (def.Stacking or "")
end

----------------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------------
local function clearCards()
	for _, rec in ipairs(cards) do
		rec.Holder:Destroy()
	end
	table.clear(cards)
end

local function open(snapshot)
	openToken += 1
	local token = openToken
	clearCards()
	isOpen = true
	pickedIndex = nil
	lastTimerSecond = nil
	isPicker = snapshot.PickerUserId == player.UserId

	gui.Enabled = true
	unlocker.Visible = true
	ClientState.SetMenu("Pick", true)
	overlay.BackgroundTransparency = 1
	Theme.tween(overlay, 0.35, { BackgroundTransparency = 0.3 })
	-- title slides down
	title.Position = UDim2.new(0.5, 0, 0.1, -40)
	title.TextTransparency = 1
	subtitle.TextTransparency = 1
	Theme.tween(title, 0.5, { Position = UDim2.fromScale(0.5, 0.1), TextTransparency = 0 }, Enum.EasingStyle.Quint)
	Theme.tween(subtitle, 0.6, { TextTransparency = 0 })

	if isPicker then
		title.Text = "PICK A POWER-UP"
		title.TextColor3 = Palette.UIText
		subtitle.Text = "You lost the round. Choose one card - it stacks for the rest of the match."
	else
		local opp = ClientState.GetOpponentEntry()
		title.Text = (opp and string.upper(opp.Name) or "OPPONENT") .. " IS CHOOSING"
		title.TextColor3 = Palette.UISubText
		subtitle.Text = "You won the round. Here's what they could get..."
	end

	-- whose power-ups are we showing stacks for?
	local pickerEntry
	for _, entry in ipairs(snapshot.Players or {}) do
		if entry.UserId == snapshot.PickerUserId then
			pickerEntry = entry
		end
	end
	local owned = pickerEntry and pickerEntry.PowerUps or {}

	for i, id in ipairs(snapshot.Cards or {}) do
		local def = PowerUps.Get(id)
		if def then
			local rec = makeCard(i, def, owned[id] or 0)
			table.insert(cards, rec)
			rec.Button.MouseEnter:Connect(function()
				setHover(rec, true)
			end)
			rec.Button.MouseLeave:Connect(function()
				setHover(rec, false)
			end)
			rec.Button.Activated:Connect(function()
				if isPicker and not pickedIndex and rec.Flipped then
					if practiceCallback then
						local callback = practiceCallback
						playPickAnimation(i)
						callback(id)
						task.delay(1.8, function()
							if practiceCallback == callback then
								PickScreen.Close()
							end
						end)
					else
						Remotes.Get("PickCard"):FireServer(i)
						playPickAnimation(i)
					end
				end
			end)
			dealAndFlip(rec, 0.2 + (i - 1) * 0.16, token)
		end
	end
end

local function close()
	if not isOpen then
		return
	end
	practiceCallback = nil
	isOpen = false
	openToken += 1
	local token = openToken
	unlocker.Visible = false
	ClientState.SetMenu("Pick", false)
	Theme.tween(overlay, 0.3, { BackgroundTransparency = 1 })
	Theme.tween(title, 0.25, { TextTransparency = 1 })
	Theme.tween(subtitle, 0.25, { TextTransparency = 1 })
	for _, rec in ipairs(cards) do
		Theme.tween(rec.Card, 0.25, { GroupTransparency = 1 })
		Theme.tween(rec.Scale, 0.25, { Scale = 0.85 })
		Theme.tween(rec.Glow, 0.2, { BackgroundTransparency = 1 })
		Theme.tween(rec.GlowInner, 0.2, { BackgroundTransparency = 1 })
	end
	task.delay(0.35, function()
		if token == openToken then
			clearCards()
			gui.Enabled = false
		end
	end)
end

function PickScreen.Close()
	close()
end

function PickScreen.IsPracticeOpen()
	return isOpen and practiceCallback ~= nil
end

--[[
	Opens the real pick screen with `cardIds` for solo practice (from the
	Power-Up Lab). `onPick(id)` is called with the chosen power-up.
]]
function PickScreen.OpenPractice(cardIds, owned, onPick)
	open({
		Cards = cardIds,
		PickerUserId = player.UserId,
		Players = { { UserId = player.UserId, PowerUps = owned or {} } },
	})
	practiceCallback = onPick
	title.Text = "PICK A POWER-UP"
	title.TextColor3 = Palette.UIText
	subtitle.Text = "Practice pick - the card gets added to your Power-Up Lab.  (B to close)"
end

function PickScreen.OnState(snapshot, old)
	if practiceCallback then
		if not snapshot.InMatch then
			return -- practice pick stays open in the lobby
		end
		close()
	end
	local phase = snapshot.Phase
	if phase == "Pick" then
		if not isOpen or old.Phase ~= "Pick" then
			open(snapshot)
		end
	elseif phase == "PickReveal" then
		local wasOpen = isOpen
		if not wasOpen then
			open(snapshot)
		end
		if snapshot.PickedIndex then
			-- wait for the deal + flip if we opened late
			task.delay(wasOpen and 0 or 1.6, function()
				playPickAnimation(snapshot.PickedIndex)
			end)
		end
	elseif isOpen then
		close()
	end
end

----------------------------------------------------------------------------
-- Per-frame: idle float, hover tilt, timer
----------------------------------------------------------------------------
local function update()
	if not isOpen then
		return
	end
	local t = os.clock()
	local mouse = UserInputService:GetMouseLocation()
	for _, rec in ipairs(cards) do
		if rec.Flipped and not pickedIndex then
			-- gentle float + breathing glow
			local bob = UDim2.new(0.5, 0, 0.5, math.sin(t * 2 + rec.Phase) * 3)
			rec.Flipper.Position = bob
			rec.Glow.Position = bob
			rec.GlowInner.Position = bob
			rec.GlowInner.BackgroundTransparency = rec.BaseGlow + math.sin(t * 2.4 + rec.Phase) * 0.06
			-- tilt toward the mouse while hovered
			if rec.Hovered then
				local center = cardCenter(rec)
				local dx = math.clamp((mouse.X - center.X) / (CARD_W / 2), -1, 1)
				rec.Mover.Rotation = dx * 3
			end
		end
	end

	local snapshot = ClientState.Snapshot
	if snapshot.Phase == "Pick" and not practiceCallback then
		local left = ClientState.TimeLeft() or 0
		timerTrack.Visible = true
		timerFill.Size = UDim2.fromScale(math.clamp(left / Config.Match.PickTime, 0, 1), 1)
		local urgent = left < 5
		timerFill.BackgroundColor3 = urgent and Palette.UIDanger or Palette.UIAccent
		local second = math.ceil(left)
		timerText.Text = tostring(second)
		timerText.TextColor3 = urgent and Palette.UIDanger or Palette.UIText
		if second ~= lastTimerSecond then
			lastTimerSecond = second
			if urgent and not pickedIndex then
				Theme.pop(timerText, 0.35)
				Sfx.Play("Countdown", { Pitch = 1.4, Volume = 0.5 })
			end
		end
	else
		timerTrack.Visible = false
		timerText.Text = ""
	end
end

function PickScreen.Start(playerGui)
	gui = Theme.screen("PickScreen", 5, playerGui)
	gui.Enabled = false

	overlay = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)

	title = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.1),
		Size = UDim2.fromOffset(1000, 56),
		TextSize = 46,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = gui,
	})
	subtitle = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 58),
		Size = UDim2.fromOffset(1000, 24),
		TextSize = 17,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = gui,
	})

	row = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.54),
		Size = UDim2.fromOffset(5 * CARD_W + 4 * GAP, CARD_H + 80),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	-- shrink the cards on small screens
	local rowScale = Theme.new("UIScale", { Parent = row })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		rowScale.Scale = math.min(1, (viewport.X - 40) / row.Size.X.Offset, (viewport.Y * 0.62) / row.Size.Y.Offset)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	timerTrack = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.88),
		Size = UDim2.fromOffset(460, 6),
		BackgroundColor3 = Palette.UIPanelLight,
		Parent = gui,
	})
	Theme.corner(timerTrack, 3)
	timerFill = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIAccent,
		Parent = timerTrack,
	})
	Theme.corner(timerFill, 3)
	timerText = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.88, 12),
		Size = UDim2.fromOffset(80, 30),
		TextSize = 26,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = gui,
	})

	RunService.RenderStepped:Connect(update)
end

return PickScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">PowerUpLab</string>
              <string name="Source"><![CDATA[--[[
	PowerUpLab.lua  (Client.ui.PowerUpLab)

	Solo testing for power-ups. In the lobby, press B to open the lab:
		* left click a power-up to add a stack, right click to remove one
		* DRAW 5 CARDS opens the real pick screen with random cards
		* CLEAR ALL removes everything
	Then close the lab and try them on the shooting range dummies.

	The server keeps your lab picks, so server-checked effects like Explosive
	Rounds, Ricochet, Decoy and Phantom Step really work. Lab picks never
	carry into a match (matches always start with no power-ups).
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local PickScreen = require(script.Parent.PickScreen)
local Keybinds = require(script.Parent.Parent.Keybinds)

local Palette = Config.Palette

local PowerUpLab = {}

local gui, panel, grid, unlocker
local tiles = {} -- [id] = { Stacks = TextLabel, Stroke = UIStroke }
local isOpen = false

local function owned()
	return ClientState.Snapshot.PowerUps or {}
end

local function send(action, id)
	Remotes.Get("Practice"):FireServer(action, id)
end

local function refresh()
	local current = owned()
	for id, tile in pairs(tiles) do
		local stacks = current[id] or 0
		local def = PowerUps.Get(id)
		tile.Stacks.Text = stacks > 0 and ("x%d / %d"):format(stacks, def.MaxStacks or 1) or ""
		tile.Stroke.Thickness = stacks > 0 and 3 or 1
		tile.Stroke.Transparency = stacks > 0 and 0 or 0.6
		tile.Frame.BackgroundColor3 = stacks > 0 and Palette.UIPanelLight or Palette.UIPanel
	end
end

function PowerUpLab.Open()
	if isOpen or ClientState.InMatch() then
		return
	end
	isOpen = true
	gui.Enabled = true
	unlocker.Visible = true
	ClientState.SetMenu("Lab", true)
	refresh()
	panel.Size = UDim2.fromOffset(820, 520)
	Theme.tween(panel, 0.2, { Size = UDim2.fromOffset(860, 560) }, Enum.EasingStyle.Back)
end

function PowerUpLab.Close()
	if not isOpen then
		return
	end
	isOpen = false
	gui.Enabled = false
	unlocker.Visible = false
	ClientState.SetMenu("Lab", false)
end

local function drawCards()
	local cards = PowerUps.DrawCards(owned(), Config.Match.CardsPerPick)
	if #cards == 0 then
		return
	end
	PowerUpLab.Close()
	PickScreen.OpenPractice(cards, owned(), function(id)
		send("Add", id)
	end)
end

local function makeTile(def, order)
	local rarity = Config.Rarity[def.Rarity]
	local frame = Theme.new("TextButton", {
		Name = def.Id,
		Text = "",
		AutoButtonColor = true,
		BackgroundColor3 = Palette.UIPanel,
		LayoutOrder = rarity.Order * 100 + order,
		Parent = grid,
	})
	Theme.corner(frame, 10)
	local stroke = Theme.stroke(frame, rarity.Color, 1, 0.6)

	local icon = Icons.Create(def, 40)
	icon.Position = UDim2.fromOffset(8, 8)
	icon.Parent = frame
	Theme.label({
		Position = UDim2.fromOffset(56, 6),
		Size = UDim2.new(1, -60, 0, 20),
		Text = def.Name,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	Theme.label({
		Position = UDim2.fromOffset(56, 26),
		Size = UDim2.new(1, -60, 0, 16),
		Text = string.upper(def.Rarity),
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = rarity.Color,
		Parent = frame,
	})
	local stacks = Theme.label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -4),
		Size = UDim2.fromOffset(60, 16),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Palette.UIAccent,
		Parent = frame,
	})
	-- description on hover
	frame.MouseEnter:Connect(function()
		panel.Description.Text = def.Name .. ":  " .. def.Description .. "   (Stacks: " .. (def.Stacking or "-") .. ")"
	end)
	frame.Activated:Connect(function()
		Sfx.Play("CardHover")
		send("Add", def.Id)
	end)
	frame.MouseButton2Click:Connect(function()
		Sfx.Play("CardHover", { Pitch = 0.8 })
		send("Remove", def.Id)
	end)
	tiles[def.Id] = { Frame = frame, Stacks = stacks, Stroke = stroke }
end

function PowerUpLab.Init() end

function PowerUpLab.Start(playerGui)
	gui = Theme.screen("PowerUpLab", 9, playerGui)
	gui.Enabled = false
	Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.4,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)

	panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(860, 560),
		BackgroundTransparency = 0,
		Parent = gui,
	})
	Theme.padding(panel, 20)
	-- shrink on small screens
	local scale = Theme.new("UIScale", { Parent = panel })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.min(1, (viewport.X - 40) / 860, (viewport.Y - 40) / 560)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	Theme.label({
		Size = UDim2.new(1, 0, 0, 34),
		Text = "POWER-UP LAB",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})
	Theme.label({
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 20),
		Text = "Try any power-up on the range.  Left click: add  -  Right click: remove  -  B: close",
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = panel,
	})

	-- scrolls (mouse wheel) when there are more power-ups than fit
	grid = Theme.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 1, -150),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Palette.UISubText,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(196, 56),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, def in ipairs(PowerUps.Definitions) do
		makeTile(def, i)
	end

	local description = Theme.label({
		Name = "Description",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -52),
		Size = UDim2.new(1, 0, 0, 22),
		Text = "Hover a power-up to read what it does.",
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UIText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = panel,
	})
	description.Name = "Description"

	local draw = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(240, 42),
		Text = "DRAW 5 CARDS",
		TextSize = 18,
		Parent = panel,
	})
	draw.Activated:Connect(drawCards)
	local clear = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 252, 1, 0),
		Size = UDim2.fromOffset(160, 42),
		Text = "CLEAR ALL",
		TextSize = 18,
		BackgroundColor3 = Palette.UIPanelLight,
		TextColor3 = Palette.UIText,
		Parent = panel,
	})
	clear.Activated:Connect(function()
		send("Clear")
	end)
	local done = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(160, 42),
		Text = "DONE",
		TextSize = 18,
		Parent = panel,
	})
	done.Activated:Connect(PowerUpLab.Close)

	ClientState.Changed:Connect(function(snapshot)
		if snapshot.InMatch then
			PowerUpLab.Close()
		else
			refresh()
		end
	end)

	local function onActionInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if require(script.Parent.SettingsMenu).IsOpen() then
			return -- rebinding keys / moving sliders in Settings
		end
		if Keybinds.Matches("PowerUpLab", input) then
			if PickScreen.IsPracticeOpen() then
				PickScreen.Close()
			elseif isOpen then
				PowerUpLab.Close()
			elseif not ClientState.InMatch() then
				PowerUpLab.Open()
			end
		end
	end
	UserInputService.InputBegan:Connect(onActionInput)
	Keybinds.VirtualBegan:Connect(onActionInput)
end

return PowerUpLab
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">SettingsMenu</string>
              <string name="Source"><![CDATA[--[[
	SettingsMenu.lua  (Client.ui.SettingsMenu)

	Three tabs:
		GENERAL     sliders: mouse + scoped mouse sensitivity, controller +
		            scoped controller sensitivity, controller deadzone, field
		            of view. Toggles: scope mode, invert Y (controller), aim
		            assist (controller).
		KEYBOARD    rebind every action: click a binding, then press a key or
		            mouse button (Esc cancels).
		CONTROLLER  same for controller buttons.

	Open / close with the Settings bind (P / Select). Everything saves to the
	server (DataStore) when the menu closes.
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local ClientState = require(script.Parent.Parent.ClientState)
local Keybinds = require(script.Parent.Parent.Keybinds)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)

local Palette = Config.Palette

local SettingsMenu = {}

local gui, panel, unlocker, pages, tabButtons
local refreshers = {} -- functions that redraw values from ClientState.Settings
local isOpen = false
local capturing = nil -- { Device, Action, Button } while waiting for a key press
local PANEL_W, PANEL_H = 560, 520

----------------------------------------------------------------------------
-- Controls
----------------------------------------------------------------------------
local function sectionTitle(parent, order, text)
	Theme.label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UIAccent,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		LayoutOrder = order,
		Parent = parent,
	})
end

-- A horizontal slider bound to ClientState.Settings[key].
local function slider(parent, order, key, labelText, decimals)
	local limits = Config.SettingsLimits[key]
	local holder = Theme.new("Frame", {
		Size = UDim2.new(1, -8, 0, 50),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	Theme.label({
		Size = UDim2.new(0.7, 0, 0, 20),
		Text = labelText,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = holder,
	})
	local valueLabel = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.3, 0, 0, 20),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Palette.UIAccent,
		Parent = holder,
	})
	local track = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Palette.UIPanelLight,
		Parent = holder,
	})
	Theme.corner(track, 4)
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = Palette.UIAccent, Parent = track })
	Theme.corner(fill, 4)
	local knob = Theme.new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Palette.UIText,
		Text = "",
		AutoButtonColor = false,
		Parent = track,
	})
	Theme.corner(knob, UDim.new(0.5, 0))

	local function show(value)
		value = value or Config.SettingsDefaults[key]
		local alpha = (value - limits.Min) / (limits.Max - limits.Min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = decimals == 0 and tostring(math.floor(value + 0.5)) or ("%.2f"):format(value)
	end

	local dragging = false
	local function setFromX(x)
		local alpha = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local value = limits.Min + alpha * (limits.Max - limits.Min)
		local factor = decimals == 0 and 1 or 100
		value = math.floor(value * factor + 0.5) / factor
		ClientState.SetSetting(key, value)
		show(value)
	end
	local function begin(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end
	knob.InputBegan:Connect(begin)
	track.InputBegan:Connect(begin)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	-- controller: select the knob and press left / right on the D-pad
	knob.SelectionGained:Connect(function()
		knob.BackgroundColor3 = Palette.UIAccent
	end)
	knob.SelectionLost:Connect(function()
		knob.BackgroundColor3 = Palette.UIText
	end)
	UserInputService.InputBegan:Connect(function(input)
		if not isOpen or game:GetService("GuiService").SelectedObject ~= knob then
			return
		end
		local step = (limits.Max - limits.Min) / 40
		local current = ClientState.Settings[key] or Config.SettingsDefaults[key]
		if input.KeyCode == Enum.KeyCode.DPadRight then
			ClientState.SetSetting(key, math.clamp(current + step, limits.Min, limits.Max))
		elseif input.KeyCode == Enum.KeyCode.DPadLeft then
			ClientState.SetSetting(key, math.clamp(current - step, limits.Min, limits.Max))
		end
	end)

	table.insert(refreshers, function(settings)
		show(settings[key])
	end)
end

-- An ON/OFF style toggle row. `labels` = { onText, offText }.
local function toggle(parent, order, key, labelText, labels)
	local row = Theme.new("Frame", {
		Size = UDim2.new(1, -8, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	Theme.label({
		Size = UDim2.new(0.65, 0, 1, 0),
		Text = labelText,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = row,
	})
	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(120, 30),
		TextSize = 14,
		Parent = row,
	})
	local function show(settings)
		local on = settings[key]
		if on == nil then
			on = Config.SettingsDefaults[key]
		end
		button.Text = on and labels[1] or labels[2]
		button.BackgroundColor3 = on and Palette.UIAccent or Palette.UIPanelLight
		button.TextColor3 = on and Palette.UIBackground or Palette.UIText
	end
	button.Activated:Connect(function()
		local current = ClientState.Settings[key]
		if current == nil then
			current = Config.SettingsDefaults[key]
		end
		ClientState.SetSetting(key, not current)
		Theme.pop(button)
		Sfx.Play("CardHover")
	end)
	table.insert(refreshers, show)
end

----------------------------------------------------------------------------
-- Key binding rows
----------------------------------------------------------------------------
local function setBind(device, actionId, keyName)
	local binds = ClientState.Settings.Binds or {}
	binds = { Keyboard = table.clone(binds.Keyboard or {}), Gamepad = table.clone(binds.Gamepad or {}) }
	binds[device][actionId] = keyName
	ClientState.SetSetting("Binds", binds)
end

local function bindRow(parent, order, device, action)
	local row = Theme.new("Frame", {
		Size = UDim2.new(1, -8, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	Theme.label({
		Size = UDim2.new(0.6, 0, 1, 0),
		Text = action.Name,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = row,
	})
	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(150, 30),
		TextSize = 14,
		BackgroundColor3 = Palette.UIPanelLight,
		TextColor3 = Palette.UIText,
		Parent = row,
	})
	button.Activated:Connect(function()
		-- (ReadyAt: ignore the very button press that started the rebind)
		capturing = { Device = device, Action = action.Id, Button = button, ReadyAt = os.clock() + 0.15 }
		button.Text = device == "Gamepad" and "PRESS A BUTTON..." or "PRESS A KEY..."
		button.BackgroundColor3 = Palette.UIAccent
		button.TextColor3 = Palette.UIBackground
		Sfx.Play("CardHover")
	end)
	table.insert(refreshers, function()
		if capturing and capturing.Button == button then
			return
		end
		button.Text = Keybinds.Label(Keybinds.Get(action.Id, device))
		button.BackgroundColor3 = Palette.UIPanelLight
		button.TextColor3 = Palette.UIText
	end)
end

local function refreshAll()
	for _, fn in ipairs(refreshers) do
		fn(ClientState.Settings)
	end
end

-- Finishes a rebind with the pressed input (called from InputBegan).
local function tryCapture(input)
	if not capturing then
		return false
	end
	if os.clock() < (capturing.ReadyAt or 0) then
		return true
	end
	if input.KeyCode == Enum.KeyCode.Escape then
		capturing = nil
		refreshAll()
		return true
	end
	local name = Keybinds.InputName(input)
	local isPad = Keybinds.IsGamepad(input)
	local wantPad = capturing.Device == "Gamepad"
	if name == "Unknown" or name == "Thumbstick1" or name == "Thumbstick2" or isPad ~= wantPad then
		return true -- wrong kind of input: keep waiting
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.MouseWheel then
		return true
	end
	local device = capturing.Device
	local action = capturing.Action
	capturing = nil
	setBind(device, action, name)
	Sfx.Play("CardPick", { Volume = 0.5 })
	return true
end

----------------------------------------------------------------------------
-- Tabs + panel
----------------------------------------------------------------------------
local function makePage(name)
	local page = Theme.new("ScrollingFrame", {
		Name = name,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -110),
		BackgroundTransparency = 1,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Palette.UISubText,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = panel,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	pages[name] = page
	return page
end

local function showTab(name)
	for tabName, page in pairs(pages) do
		page.Visible = tabName == name
		local button = tabButtons[tabName]
		button.BackgroundColor3 = tabName == name and Palette.UIAccent or Palette.UIPanelLight
		button.TextColor3 = tabName == name and Palette.UIBackground or Palette.UIText
	end
end

function SettingsMenu.Open()
	if isOpen then
		return
	end
	isOpen = true
	gui.Enabled = true
	unlocker.Visible = true
	ClientState.SetMenu("Settings", true)
	refreshAll()
	local scale = Theme.scaleOf(panel)
	scale.Scale = 0.92
	Theme.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end

function SettingsMenu.Close()
	if not isOpen then
		return
	end
	isOpen = false
	capturing = nil
	gui.Enabled = false
	unlocker.Visible = false
	ClientState.SetMenu("Settings", false)
	ClientState.SaveSettings()
end

function SettingsMenu.IsOpen()
	return isOpen
end

function SettingsMenu.Toggle()
	if isOpen then
		SettingsMenu.Close()
	else
		SettingsMenu.Open()
	end
end

function SettingsMenu.Init() end

function SettingsMenu.Start(playerGui)
	gui = Theme.screen("Settings", 10, playerGui)
	gui.Enabled = false
	pages, tabButtons = {}, {}

	Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.45,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)

	panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(PANEL_W, PANEL_H),
		BackgroundTransparency = 0,
		Parent = gui,
	})
	Theme.padding(panel, 20)

	Theme.label({
		Size = UDim2.new(0.5, 0, 0, 34),
		Text = "SETTINGS",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})

	-- tabs
	local tabs = Theme.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(330, 34),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 6),
		}),
	})
	for i, name in ipairs({ "GENERAL", "KEYBOARD", "CONTROLLER" }) do
		local button = Theme.button({
			Size = UDim2.fromOffset(i == 1 and 96 or 108, 32),
			Text = name,
			TextSize = 13,
			LayoutOrder = i,
			Parent = tabs,
		})
		tabButtons[name] = button
		button.Activated:Connect(function()
			capturing = nil
			refreshAll()
			showTab(name)
			Sfx.Play("CardHover")
		end)
	end

	-- GENERAL
	local general = makePage("GENERAL")
	sectionTitle(general, 1, "MOUSE")
	slider(general, 2, "Sensitivity", "Mouse sensitivity")
	slider(general, 3, "ScopedSensitivity", "Scoped mouse sensitivity")
	sectionTitle(general, 4, "CONTROLLER")
	slider(general, 5, "ControllerSensitivity", "Controller sensitivity")
	slider(general, 6, "ControllerScopedSensitivity", "Scoped controller sensitivity")
	slider(general, 7, "ControllerDeadzone", "Stick deadzone")
	toggle(general, 8, "InvertY", "Invert look (Y)", { "ON", "OFF" })
	toggle(general, 9, "AimAssist", "Aim assist", { "ON", "OFF" })
	sectionTitle(general, 10, "TOUCH")
	slider(general, 11, "TouchSensitivity", "Touch sensitivity")
	slider(general, 12, "TouchScopedSensitivity", "Scoped touch sensitivity")
	sectionTitle(general, 13, "GAME")
	slider(general, 14, "FieldOfView", "Field of view", 0)
	toggle(general, 15, "ToggleScope", "Scope mode", { "TOGGLE", "HOLD" })

	-- KEYBOARD / CONTROLLER
	local keyboard = makePage("KEYBOARD")
	local controller = makePage("CONTROLLER")
	for i, action in ipairs(Keybinds.Actions) do
		bindRow(keyboard, i, "Keyboard", action)
		bindRow(controller, i, "Gamepad", action)
	end
	Theme.label({
		Size = UDim2.new(1, -8, 0, 20),
		Text = "Move with WASD / left stick and look with the mouse / right stick (not rebindable).",
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UISubText,
		LayoutOrder = 99,
		Parent = keyboard,
	})

	-- bottom buttons
	local reset = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(180, 40),
		Text = "RESET DEFAULTS",
		TextSize = 14,
		BackgroundColor3 = Palette.UIPanelLight,
		TextColor3 = Palette.UIText,
		Parent = panel,
	})
	reset.Activated:Connect(function()
		capturing = nil
		for key, value in pairs(Config.SettingsDefaults) do
			ClientState.Settings[key] = value
		end
		ClientState.SetSetting("Binds", { Keyboard = {}, Gamepad = {} })
		Theme.pop(reset)
	end)
	local done = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(160, 40),
		Text = "DONE",
		Parent = panel,
	})
	done.Activated:Connect(SettingsMenu.Close)

	showTab("GENERAL")
	refreshAll()
	ClientState.SettingsChanged:Connect(refreshAll)

	-- shrink the panel on small screens
	local scale = Theme.scaleOf(panel)
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.min(1, (viewport.X - 30) / PANEL_W, (viewport.Y - 30) / PANEL_H)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	UserInputService.InputBegan:Connect(function(input, processed)
		if isOpen and tryCapture(input) then
			return
		end
		if processed and UserInputService:GetFocusedTextBox() then
			return -- typing in chat
		end
		if Keybinds.Matches("Settings", input) then
			SettingsMenu.Toggle()
		elseif input.KeyCode == Enum.KeyCode.Escape and isOpen then
			SettingsMenu.Close()
		end
	end)
	-- on-screen Settings button (mobile)
	Keybinds.VirtualBegan:Connect(function(input)
		if Keybinds.Matches("Settings", input) then
			SettingsMenu.Toggle()
		end
	end)
end

return SettingsMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--[[
	Shop.lua  (Client.ui.Shop)

	The SHOP (lobby, key M or the SHOP button):
		CRATES    the Standard crate (Keys, earned by playing) and the Elite
		          crate (Credits: better odds, Elite-only skins, Secrets).
		          OPEN plays the opening at the crate vault.
		CREDITS   Credit packs (and a Key pack) for Robux
		VIP       the VIP pass (2x keys)
	Purchases are Roblox prompts; the server grants them (CrateService).
	Product ids live in Config.Shop (0 = not set up yet).
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Keybinds = require(script.Parent.Parent.Keybinds)
local Theme = require(script.Parent.Theme)

local Palette = Config.Palette
local CR = Config.Crates
local SHOP = Config.Shop
local player = Players.LocalPlayer

local Shop = {}

local W, H = 920, 580
local GOLD = Color3.fromRGB(255, 196, 60)
local gui, panel, unlocker, pages, tabs, balance
local isOpen = false
local current = "Crates"

local rarityById = {}
for _, rarity in ipairs(CR.Rarities) do
	rarityById[rarity.Id] = rarity
end

local function notSetUp()
	Sfx.Play("CardHover", { Pitch = 0.6 })
	local note = panel:FindFirstChild("Note")
	if note then
		note.Text = "This item isn't set up yet: add its id in Config.Shop (Creator Hub > Monetization)."
		note.TextTransparency = 0
		task.delay(3, function()
			Theme.tween(note, 0.4, { TextTransparency = 1 })
		end)
	end
end

local function refreshBalance()
	if balance then
		balance.Text = ("%d KEYS    %d CREDITS%s"):format(
			player:GetAttribute("Keys") or 0,
			player:GetAttribute("Credits") or 0,
			player:GetAttribute("VIP") and "    VIP" or ""
		)
	end
end

----------------------------------------------------------------------------
-- Pages
----------------------------------------------------------------------------
local function card(parent, props)
	local frame = Theme.new("Frame", {
		BackgroundColor3 = Palette.UIPanelLight,
		Position = props.Position,
		Size = props.Size,
		Parent = parent,
	})
	Theme.corner(frame, 14)
	Theme.stroke(frame, props.Color or Palette.UIText, props.Color and 2 or 1, props.Color and 0.2 or 0.85)
	Theme.padding(frame, 16)
	return frame
end

local function oddsLines(odds)
	local lines = {}
	for _, rarity in ipairs(CR.Rarities) do
		local chance = odds[rarity.Id]
		if chance and chance > 0 then
			table.insert(lines, ('<font color="#%s">%s</font>  %s%%'):format(rarity.Color:ToHex(), rarity.Name, tostring(chance)))
		end
	end
	return table.concat(lines, "\n")
end

local function crateCard(parent, typeName, x, color, blurb)
	local crateType = CR.Types[typeName]
	local frame = card(parent, {
		Position = UDim2.new(x, x > 0 and 8 or 0, 0, 0),
		Size = UDim2.new(0.5, -8, 1, 0),
		Color = color,
	})
	Theme.label({
		Size = UDim2.new(1, 0, 0, 34),
		Text = crateType.Name,
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = frame,
	})
	Theme.label({
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, 0, 0, 40),
		Text = blurb,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Palette.UISubText,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = frame,
	})
	Theme.label({
		Position = UDim2.fromOffset(0, 90),
		Size = UDim2.new(1, 0, 0, 150),
		RichText = true,
		Text = oddsLines(crateType.Odds),
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LineHeight = 1.25,
		Parent = frame,
	})
	local open = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 52),
		Text = ("OPEN  -  %d %s"):format(crateType.Cost, string.upper(crateType.Currency)),
		TextSize = 20,
		BackgroundColor3 = color,
		Parent = frame,
	})
	open.Activated:Connect(function()
		local have = player:GetAttribute(crateType.Currency) or 0
		local free = CR.FreeInStudio and RunService:IsStudio()
		if not free and have < crateType.Cost then
			Sfx.Play("CardHover", { Pitch = 0.6 })
			if crateType.Currency == "Credits" then
				Shop.Show("Credits") -- (get some credits first)
			end
			return
		end
		Sfx.Play("CardPick", { Pitch = 1.1 })
		Shop.Close()
		Remotes.Get("CrateOpen"):FireServer(typeName)
	end)
end

local function buildCrates(page)
	crateCard(page, "Standard", 0, Palette.UIAccent,
		("Earn keys by playing: %d for a win, %d for a loss. Every rarity up to Legendary."):format(CR.KeysPerWin, CR.KeysPerLoss))
	local elite = {}
	for _, skin in ipairs(CR.Skins) do
		if skin.Elite and skin.Rarity ~= "Secret" and #elite < 6 then
			table.insert(elite, skin.Name)
		end
	end
	crateCard(page, "Elite", 0.5, GOLD,
		"Better odds and the only crate with Elite-only skins (" .. table.concat(elite, ", ") .. "...) and the SECRETS.")
end

local function buyButton(parent, text, price, onBuy)
	local button = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 44),
		Text = ("%s  -  R$ %d"):format(text, price),
		TextSize = 17,
		BackgroundColor3 = GOLD,
		Parent = parent,
	})
	button.Activated:Connect(onBuy)
	return button
end

local function buildCredits(page)
	local packs = {}
	for _, pack in ipairs(SHOP.CreditPacks) do
		table.insert(packs, { Pack = pack, Amount = pack.Credits, Unit = "CREDITS" })
	end
	for _, pack in ipairs(SHOP.KeyPacks) do
		table.insert(packs, { Pack = pack, Amount = pack.Keys, Unit = "KEYS" })
	end
	local count = #packs
	for i, entry in ipairs(packs) do
		local pack = entry.Pack
		local frame = card(page, {
			Position = UDim2.new((i - 1) / count, 6, 0, 0),
			Size = UDim2.new(1 / count, -12, 1, 0),
			Color = entry.Unit == "KEYS" and Palette.UIAccent or GOLD,
		})
		Theme.label({
			Size = UDim2.new(1, 0, 0, 22),
			Text = pack.Name,
			TextSize = 15,
			TextColor3 = Palette.UISubText,
			Parent = frame,
		})
		Theme.label({
			Position = UDim2.fromOffset(0, 40),
			Size = UDim2.new(1, 0, 0, 60),
			Text = tostring(entry.Amount),
			TextSize = 52,
			TextColor3 = entry.Unit == "KEYS" and Palette.UIAccent or GOLD,
			FontFace = Theme.Font(Enum.FontWeight.Heavy),
			Parent = frame,
		})
		Theme.label({
			Position = UDim2.fromOffset(0, 100),
			Size = UDim2.new(1, 0, 0, 20),
			Text = entry.Unit,
			TextSize = 15,
			Parent = frame,
		})
		if pack.Tag then
			local tag = Theme.label({
				Position = UDim2.fromOffset(0, 140),
				Size = UDim2.new(1, 0, 0, 26),
				Text = pack.Tag,
				TextSize = 14,
				TextColor3 = Palette.UIBackground,
				BackgroundColor3 = GOLD,
				BackgroundTransparency = 0,
				Parent = frame,
			})
			Theme.corner(tag, 8)
		end
		buyButton(frame, "BUY", pack.Robux, function()
			if pack.Id == 0 then
				notSetUp()
				return
			end
			MarketplaceService:PromptProductPurchase(player, pack.Id)
		end)
	end
end

local function buildVip(page)
	local pass = SHOP.Passes.VIP
	local frame = card(page, {
		Position = UDim2.fromScale(0.2, 0),
		Size = UDim2.fromScale(0.6, 1),
		Color = GOLD,
	})
	Theme.label({
		Size = UDim2.new(1, 0, 0, 60),
		Text = "VIP",
		TextSize = 56,
		TextColor3 = GOLD,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = frame,
	})
	Theme.label({
		Position = UDim2.fromOffset(0, 80),
		Size = UDim2.new(1, 0, 0, 120),
		Text = pass.Perks,
		TextSize = 20,
		TextWrapped = true,
		FontFace = Theme.Font(Enum.FontWeight.Medium),
		Parent = frame,
	})
	local button = buyButton(frame, "GET VIP", pass.Robux, function()
		if player:GetAttribute("VIP") then
			return
		end
		if pass.Id == 0 then
			notSetUp()
			return
		end
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	end)
	local function refresh()
		if player:GetAttribute("VIP") then
			button.Text = "OWNED"
			button.AutoButtonColor = false
		end
	end
	refresh()
	player:GetAttributeChangedSignal("VIP"):Connect(refresh)
end

----------------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------------
function Shop.Show(name)
	current = name
	for pageName, page in pairs(pages) do
		page.Visible = pageName == name
	end
	for tabName, button in pairs(tabs) do
		local on = tabName == name
		button.BackgroundColor3 = on and Palette.UIAccent or Palette.UIPanelLight
		button.TextColor3 = on and Palette.UIBackground or Palette.UIText
	end
end

function Shop.Open(page)
	if ClientState.InMatch() or (ClientState.MenuOpen and not isOpen) then
		return
	end
	if not isOpen then
		isOpen = true
		gui.Enabled = true
		unlocker.Visible = true
		ClientState.SetMenu("Shop", true)
		panel.Size = UDim2.fromOffset(W - 40, H - 40)
		Theme.tween(panel, 0.2, { Size = UDim2.fromOffset(W, H) }, Enum.EasingStyle.Back)
		Sfx.Play("CardPick", { Pitch = 1.05, Volume = 0.6 })
	end
	refreshBalance()
	Shop.Show(page or current)
end

function Shop.Close()
	if not isOpen then
		return
	end
	isOpen = false
	gui.Enabled = false
	unlocker.Visible = false
	ClientState.SetMenu("Shop", false)
end

function Shop.Toggle()
	if isOpen then
		Shop.Close()
	else
		Shop.Open()
	end
end

function Shop.IsOpen()
	return isOpen
end

function Shop.Init() end

function Shop.Start(playerGui)
	gui = Theme.screen("Shop", 9, playerGui)
	gui.Enabled = false
	Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.35,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)
	panel = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H),
		BackgroundTransparency = 0,
		Parent = gui,
	})
	Theme.padding(panel, 20)
	local scale = Theme.new("UIScale", { Parent = panel })
	local function fit()
		local view = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.min(1, (view.X - 40) / W, (view.Y - 40) / H)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	Theme.label({
		Size = UDim2.new(0.4, 0, 0, 34),
		Text = "SHOP",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = panel,
	})
	balance = Theme.label({
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(0.6, 0, 0, 20),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = panel,
	})
	tabs = {}
	local names = { "Crates", "Credits", "VIP" }
	for i, name in ipairs(names) do
		local button = Theme.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -(#names - i) * 128, 0, 4),
			Size = UDim2.fromOffset(120, 36),
			Text = string.upper(name),
			TextSize = 16,
			Parent = panel,
		})
		button.Activated:Connect(function()
			Sfx.Play("CardHover", { Pitch = 1.2 })
			Shop.Show(name)
		end)
		tabs[name] = button
	end
	pages = {}
	for _, name in ipairs(names) do
		pages[name] = Theme.new("Frame", {
			Position = UDim2.fromOffset(0, 72),
			Size = UDim2.new(1, 0, 1, -130),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = panel,
		})
	end
	buildCrates(pages.Crates)
	buildCredits(pages.Credits)
	buildVip(pages.VIP)

	Theme.label({
		Name = "Note",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -8),
		Size = UDim2.new(1, -180, 0, 32),
		Text = "",
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.UISubText,
		Parent = panel,
	})
	local done = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(160, 42),
		Text = "DONE",
		TextSize = 18,
		Parent = panel,
	})
	done.Activated:Connect(Shop.Close)
	Shop.Show("Crates")

	for _, name in ipairs({ "Keys", "Credits", "VIP" }) do
		player:GetAttributeChangedSignal(name):Connect(refreshBalance)
	end
	ClientState.Changed:Connect(function(snapshot)
		if snapshot.InMatch then
			Shop.Close()
		end
	end)

	local function onActionInput(input, processed)
		if processed and UserInputService:GetFocusedTextBox() then
			return
		end
		if require(script.Parent.SettingsMenu).IsOpen() then
			return
		end
		if Keybinds.Matches("Shop", input) then
			if isOpen then
				Shop.Close()
			elseif not ClientState.InMatch() then
				Shop.Open()
			end
		end
	end
	UserInputService.InputBegan:Connect(onActionInput)
	Keybinds.VirtualBegan:Connect(onActionInput)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme.lua  (Client.ui.Theme)
	Shared UI helpers so every screen looks the same:
	flat colours from Config.Palette, rounded corners, one clean font.
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Theme = {}
Theme.Palette = Config.Palette

function Theme.Font(weight)
	return Font.new(Config.UI.FontFamily, weight or Enum.FontWeight.Medium)
end

-- Creates an instance with properties and children:
-- Theme.new("Frame", { Size = ..., Parent = ... }, { child1, child2 })
function Theme.new(className, props, children)
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	local parent
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end

function Theme.corner(parent, radius)
	return Theme.new("UICorner", {
		CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius or Config.UI.CornerRadius),
		Parent = parent,
	})
end

function Theme.stroke(parent, color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Theme.padding(parent, px)
	return Theme.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = Config.Palette.UIText,
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		TextSize = 18,
		Text = "",
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return Theme.new("TextLabel", defaults)
end

function Theme.panel(props)
	local defaults = {
		BackgroundColor3 = Config.Palette.UIPanel,
		BackgroundTransparency = 0.08,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local frame = Theme.new("Frame", defaults)
	Theme.corner(frame)
	return frame
end

function Theme.button(props)
	local defaults = {
		BackgroundColor3 = Config.Palette.UIAccent,
		TextColor3 = Config.Palette.UIBackground,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		TextSize = 20,
		AutoButtonColor = true,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local button = Theme.new("TextButton", defaults)
	Theme.corner(button)
	return button
end

function Theme.tween(inst, time, goals, style, direction)
	local tween = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goals
	)
	tween:Play()
	return tween
end

-- Returns the UIScale of a GUI object (creates one if needed).
function Theme.scaleOf(inst)
	local scale = inst:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Theme.new("UIScale", { Parent = inst })
	end
	return scale
end

-- Quick "pop" animation (grow a little, spring back).
function Theme.pop(inst, amount)
	local scale = Theme.scaleOf(inst)
	scale.Scale = 1 + (amount or 0.12)
	Theme.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

--[[
	UI particle burst: `count` little flat squares fly out from `center`
	(absolute screen position, Vector2) inside `parent`, then fade away.
]]
function Theme.burst(parent, center, color, count, distance, size)
	count = count or 14
	distance = distance or 140
	size = size or 8
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + math.random() * 0.4
		local reach = distance * (0.55 + math.random() * 0.6)
		local bit = Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X, center.Y),
			Size = UDim2.fromOffset(size, size),
			Rotation = math.random(0, 90),
			BackgroundColor3 = color,
			ZIndex = 20,
			Parent = parent,
		})
		Theme.corner(bit, 2)
		local target = center + Vector2.new(math.cos(angle), math.sin(angle)) * reach
		local time = 0.5 + math.random() * 0.35
		Theme.tween(bit, time, {
			Position = UDim2.fromOffset(target.X, target.Y),
			Size = UDim2.fromOffset(2, 2),
			Rotation = bit.Rotation + math.random(-180, 180),
			BackgroundTransparency = 1,
		}, Enum.EasingStyle.Quint)
		task.delay(time + 0.05, function()
			bit:Destroy()
		end)
	end
end

-- An expanding ring (UI shockwave) at an absolute screen position.
function Theme.ring(parent, center, color, size, thickness)
	local ring = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(center.X, center.Y),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		ZIndex = 19,
		Parent = parent,
	})
	Theme.corner(ring, UDim.new(0.5, 0))
	local stroke = Theme.stroke(ring, color, thickness or 6, 0)
	Theme.tween(ring, 0.55, { Size = UDim2.fromOffset(size, size) }, Enum.EasingStyle.Quint)
	Theme.tween(stroke, 0.55, { Transparency = 1, Thickness = 1 })
	task.delay(0.6, function()
		ring:Destroy()
	end)
end

-- A diagonal white shine that sweeps across `inst` once (or forever).
function Theme.shine(inst, duration, loop, strength)
	local band = Theme.new("Frame", {
		Name = "Shine",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 8,
		Parent = inst,
	})
	local corner = inst:FindFirstChildOfClass("UICorner")
	if corner then
		Theme.corner(band, corner.CornerRadius)
	end
	local peak = 1 - (strength or 0.45)
	local gradient = Theme.new("UIGradient", {
		Rotation = 25,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 1),
			NumberSequenceKeypoint.new(0.5, peak),
			NumberSequenceKeypoint.new(0.6, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Offset = Vector2.new(-1, 0),
		Parent = band,
	})
	local tween = TweenService:Create(
		gradient,
		TweenInfo.new(duration or 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, loop and -1 or 0, false, loop and 0.9 or 0),
		{ Offset = Vector2.new(1, 0) }
	)
	tween:Play()
	if not loop then
		task.delay((duration or 0.8) + 0.05, function()
			band:Destroy()
		end)
	end
	return band, tween
end

-- Rough pixel width of a short upper-case keycap label ("F", "D-RIGHT"),
-- so a keycap chip can be sized without measuring text (GothamSSm Heavy).
function Theme.keycapWidth(text, textSize)
	textSize = textSize or 13
	return math.max(math.floor(textSize * 2), math.ceil(#tostring(text) * textSize * 0.7) + 12)
end

-- A small keyboard-key chip showing a binding. Returns (frame, label).
-- `props` are applied to the frame (Position, AnchorPoint, Parent...).
function Theme.keycap(text, textSize, props)
	textSize = textSize or 13
	local defaults = {
		Name = "Keycap",
		Size = UDim2.fromOffset(Theme.keycapWidth(text, textSize), math.floor(textSize * 1.85)),
		BackgroundColor3 = Config.Palette.UIPanelLight,
	}
	for k, v in pairs(props or {}) do
		defaults[k] = v
	end
	local frame = Theme.new("Frame", defaults)
	Theme.corner(frame, 6)
	Theme.stroke(frame, Config.Palette.UIText, 1, 0.8)
	local label = Theme.label({
		Name = "Key",
		Size = UDim2.fromScale(1, 1),
		Text = tostring(text),
		TextSize = textSize,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = frame,
	})
	return frame, label
end

-- A UIGradient that only fades transparency. `points` is a list of
-- { position (0-1), transparency } pairs; rotation in degrees.
function Theme.fade(parent, rotation, points)
	local keypoints = {}
	for _, p in ipairs(points) do
		table.insert(keypoints, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return Theme.new("UIGradient", {
		Rotation = rotation or 0,
		Transparency = NumberSequence.new(keypoints),
		Parent = parent,
	})
end

-- A ScreenGui that ignores the top bar inset and survives respawns.
function Theme.screen(name, displayOrder, parent)
	return Theme.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		Parent = parent,
	})
end

-- An invisible button with Modal = true: while it's visible, Roblox frees
-- the mouse even in first person. Toggle `.Visible` to lock/unlock.
function Theme.mouseUnlocker(parent)
	return Theme.new("TextButton", {
		Name = "MouseUnlock",
		Modal = true,
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromOffset(0, 0),
		Visible = false,
		Parent = parent,
	})
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Toast</string>
              <string name="Source"><![CDATA[--[[
	Toast.lua  (Client.ui.Toast)

	Small message that slides in at the top of the screen for a few seconds
	(server "Notify" remote: admin command results, e.g. "BOT MATCH - HARD").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)

local Palette = Config.Palette

local Toast = {}

local gui, holder
local SHOW_TIME = 3

function Toast.Show(text)
	local card = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Palette.UIPanel,
		Parent = holder,
	})
	Theme.stroke(card, Palette.UIAccent, 2, 0.2)
	Theme.new("UIPadding", {
		PaddingLeft = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 18),
		Parent = card,
	})
	local label = Theme.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = string.upper(tostring(text)),
		TextSize = 17,
		FontFace = Theme.Font(Enum.FontWeight.Bold),
		Parent = card,
	})
	local scale = Theme.scaleOf(card)
	scale.Scale = 0.6
	card.BackgroundTransparency = 1
	label.TextTransparency = 1
	Theme.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Theme.tween(card, 0.2, { BackgroundTransparency = 0 })
	Theme.tween(label, 0.2, { TextTransparency = 0 })
	Sfx.Play("CardPick", { Volume = 0.4, Pitch = 1.3 })

	task.delay(SHOW_TIME, function()
		Theme.tween(scale, 0.25, { Scale = 0.8 })
		Theme.tween(card, 0.25, { BackgroundTransparency = 1 })
		Theme.tween(label, 0.25, { TextTransparency = 1 })
		task.wait(0.3)
		card:Destroy()
	end)
end

function Toast.Start(playerGui)
	gui = Theme.screen("Toast", 50, playerGui)
	holder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.fromOffset(600, 200),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.new("UIListLayout", {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = holder,
	})
	Remotes.Get("Notify").OnClientEvent:Connect(Toast.Show)
end

return Toast
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">VictoryScreen</string>
              <string name="Source"><![CDATA[--[[
	VictoryScreen.lua  (Client.ui.VictoryScreen)
	Shown when a player reaches 4 round wins: VICTORY / DEFEAT, the final
	score, and the power-ups each player ended with. Then back to the lobby.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local ClientState = require(script.Parent.Parent.ClientState)
local Sfx = require(script.Parent.Parent.Sfx)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Palette = Config.Palette
local player = Players.LocalPlayer

local VictoryScreen = {}

local gui, overlay, title, scoreLabel, messageLabel, columns, footer, unlocker
local isOpen = false

local function buildColumn(entry, slot)
	local column = Theme.panel({
		Size = UDim2.fromOffset(300, 300),
		LayoutOrder = slot,
		Parent = columns,
	})
	Theme.padding(column, 14)
	Theme.stroke(column, ClientState.GetSlotColor(slot), 2, 0)
	Theme.label({
		Size = UDim2.new(1, 0, 0, 26),
		Text = entry.Name .. "  -  " .. tostring(entry.Wins),
		TextSize = 20,
		TextColor3 = ClientState.GetSlotColor(slot),
		Parent = column,
	})
	local grid = Theme.new("Frame", {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 1, -36),
		BackgroundTransparency = 1,
		Parent = column,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(130, 26),
			CellPadding = UDim2.fromOffset(8, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local count = 0
	for _, def in ipairs(PowerUps.Definitions) do
		local stacks = entry.PowerUps[def.Id]
		if stacks and stacks > 0 then
			count += 1
			local cell = Theme.new("Frame", { BackgroundTransparency = 1, LayoutOrder = count, Parent = grid })
			local icon = Icons.Create(def, 26)
			icon.Parent = cell
			Theme.label({
				Position = UDim2.fromOffset(32, 0),
				Size = UDim2.new(1, -32, 1, 0),
				Text = def.Name .. (stacks > 1 and (" x" .. stacks) or ""),
				TextSize = 12,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = Config.Rarity[def.Rarity].Color,
				Parent = cell,
			})
		end
	end
	if count == 0 then
		Theme.label({ Text = "No power-ups", TextSize = 14, TextColor3 = Palette.UISubText, Parent = grid })
	end
end

local function open(snapshot)
	isOpen = true
	gui.Enabled = true
	unlocker.Visible = true
	ClientState.SetMenu("Victory", true)

	local won = snapshot.MatchWinnerUserId == player.UserId
	title.Text = won and "VICTORY" or "DEFEAT"
	title.TextColor3 = won and Palette.UIAccent or Palette.UIDanger
	title.TextSize = 140
	Theme.tween(title, 0.5, { TextSize = 96 }, Enum.EasingStyle.Back)
	Sfx.Play(won and "Victory" or "Hurt", { Pitch = won and 1 or 0.6 })

	local me, opp = ClientState.GetMe(), ClientState.GetOpponentEntry()
	scoreLabel.Text = (me and opp) and ("%d  -  %d"):format(me.Wins, opp.Wins) or ""
	messageLabel.Text = snapshot.Message or ""

	for _, child in ipairs(columns:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for slot, entry in ipairs(snapshot.Players or {}) do
		buildColumn(entry, slot)
	end
	overlay.BackgroundTransparency = 1
	Theme.tween(overlay, 0.4, { BackgroundTransparency = 0.15 })
	-- columns slide up, then confetti / embers
	columns.Position = UDim2.new(0.5, 0, 0.1, 260)
	Theme.tween(columns, 0.6, { Position = UDim2.new(0.5, 0, 0.1, 210) }, Enum.EasingStyle.Quint)
	task.spawn(function()
		local viewport = workspace.CurrentCamera.ViewportSize
		local colors = won and { Palette.UIAccent, Palette.AccentB, Palette.PlayerA, Palette.PlayerB, Color3.new(1, 1, 1) }
			or { Palette.UIDanger, Palette.UIPanelLight }
		for i = 1, won and 10 or 4 do
			if not isOpen then
				break
			end
			local x = viewport.X * (0.15 + math.random() * 0.7)
			local y = viewport.Y * (0.12 + math.random() * 0.25)
			Theme.burst(gui, Vector2.new(x, y), colors[(i % #colors) + 1], 16, 220, 9)
			task.wait(0.18)
		end
	end)
end

local function close()
	if not isOpen then
		return
	end
	isOpen = false
	gui.Enabled = false
	unlocker.Visible = false
	ClientState.SetMenu("Victory", false)
end

function VictoryScreen.OnState(snapshot)
	if snapshot.InMatch and snapshot.Phase == "Victory" then
		if not isOpen then
			open(snapshot)
		end
	else
		close()
	end
end

function VictoryScreen.Init() end

function VictoryScreen.Start(playerGui)
	gui = Theme.screen("Victory", 8, playerGui)
	gui.Enabled = false
	overlay = Theme.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.UIBackground,
		BackgroundTransparency = 0.15,
		Parent = gui,
	})
	unlocker = Theme.mouseUnlocker(gui)

	title = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.1),
		Size = UDim2.fromOffset(800, 110),
		TextSize = 96,
		FontFace = Theme.Font(Enum.FontWeight.Heavy),
		Parent = overlay,
	})
	scoreLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 112),
		Size = UDim2.fromOffset(400, 50),
		TextSize = 44,
		Parent = overlay,
	})
	messageLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 164),
		Size = UDim2.fromOffset(600, 24),
		TextSize = 16,
		TextColor3 = Palette.UISubText,
		Parent = overlay,
	})
	columns = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 210),
		Size = UDim2.fromOffset(640, 310),
		BackgroundTransparency = 1,
		Parent = overlay,
	}, {
		Theme.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 24),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	footer = Theme.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(400, 22),
		TextSize = 16,
		TextColor3 = Palette.UISubText,
		Parent = overlay,
	})

	RunService.RenderStepped:Connect(function()
		if isOpen then
			local left = ClientState.TimeLeft()
			footer.Text = left and ("Returning to lobby in %d..."):format(math.ceil(left)) or ""
		end
	end)
end

return VictoryScreen
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>