	Hurt = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.5, Pitch = 0.7 },
	Dash = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.45, Pitch = 1.2 },
	Jump = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.35, Pitch = 1.1 },
	Land = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.35, Pitch = 1 },
	Explosion = { Id = "rbxasset://sounds/collide.wav", Volume = 0.7, Pitch = 0.9 },
	CardFlip = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.35, Pitch = 1.8 },
	CardLegendary = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8, Pitch = 0.6 },
	CardHover = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.25, Pitch = 1.6 },
	CardPick = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.6, Pitch = 1.2 },
	Countdown = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.6, Pitch = 1 },
	Go = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Pitch = 1.2 },
	Victory = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8, Pitch = 0.5 },
	Ability = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.4, Pitch = 0.8 },
}

----------------------------------------------------------------------------
-- VISUAL EFFECTS (client). Turn things off here if you want a calmer look
-- or better performance.
----------------------------------------------------------------------------
Config.Effects = {
	NeonEffects = true, -- tracers, flashes and explosions glow (Neon + bloom)
	Particles = true, -- sparks / smoke / dust (Roblox's built-in particle textures)
	Lights = true, -- muzzle, impact and explosion light flashes
	KillShatter = true, -- bodies burst into shards on a kill
	DamageNumbers = true, -- floating numbers where your shots land
	SpeedLines = true, -- streaks at the screen edges when you're fast
	SpeedLinesFrom = 44, -- speed (u/s) where speed lines start
	SparkTexture = "rbxasset://textures/particles/sparkles_main.dds",
	SmokeTexture = "rbxasset://textures/particles/smoke_main.dds",
}

----------------------------------------------------------------------------
-- LIGHTING (applied by the server at startup, see LightingSetup.lua)
----------------------------------------------------------------------------
Config.Lighting = {
	-- The base values are the ARENA (outdoors). The sun sits fairly high so the
	-- tall walls don't throw half the map into shade, and the shade itself is
	-- lifted (OutdoorAmbient / EnvironmentDiffuseScale) so you can still see
	-- someone standing in it.
	ClockTime = 14.2,
	GeographicLatitude = 30,
	Brightness = 2.6,
	Ambient = Color3.fromRGB(96, 100, 110),
	OutdoorAmbient = Color3.fromRGB(168, 172, 184),
	EnvironmentDiffuseScale = 0.85,
	EnvironmentSpecularScale = 0.2,
	ShadowSoftness = 0.2,

	Atmosphere = {
		Density = 0.22,
		Offset = 0.1,
		Color = Color3.fromRGB(205, 218, 235),
		Decay = Color3.fromRGB(130, 148, 180),
		Glare = 0.05,
		Haze = 0.6,
	},
	Bloom = { Intensity = 0.2, Size = 20, Threshold = 2 }, -- only real lights glow, not light walls
	ColorCorrection = {
		Brightness = 0,
		Contrast = 0.06,
		Saturation = 0.08,
		TintColor = Color3.fromRGB(255, 253, 248),
	},
	SunRays = { Intensity = 0.03, Spread = 0.5 },
	-- soft 3D clouds (workspace.Terrain.Clouds)
	Clouds = { Cover = 0.52, Density = 0.62, Color = Color3.fromRGB(255, 255, 255) },

	-- The LOBBY is indoors (a roofed rotunda with a skylight), so it gets its own
	-- profile: a dimmer sun through the skylight, warmer fill light, less haze.
	-- The client blends between the two when you enter or leave a match.
	-- Only the values listed here change; everything else uses the arena's.
	Lobby = {
		ClockTime = 13,
		Brightness = 1.6,
		Ambient = Color3.fromRGB(112, 104, 96),
		OutdoorAmbient = Color3.fromRGB(150, 146, 140),
		EnvironmentDiffuseScale = 0.5,
		ShadowSoftness = 0.35,
		Atmosphere = { Density = 0.1, Haze = 0.2, Glare = 0 },
		Bloom = { Intensity = 0.15, Threshold = 1.8 },
		ColorCorrection = { Contrast = 0.04, Saturation = 0.05, TintColor = Color3.fromRGB(255, 247, 236) },
		SunRays = { Intensity = 0.01 },
	},
	BlendTime = 1.2, -- seconds to blend from one profile to the other
}

----------------------------------------------------------------------------
-- UI
----------------------------------------------------------------------------
Config.UI = {
	FontFamily = "rbxasset://fonts/families/GothamSSm.json",
	CornerRadius = 10,
	SettingsKey = Enum.KeyCode.P,
}

----------------------------------------------------------------------------
-- DEBUG
----------------------------------------------------------------------------
Config.Debug = {
	LogRejectedShots = true, -- print a warning when the server rejects a shot
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">CrateModel</string>
          <string name="Source"><![CDATA[--[[
	CrateModel.lua  (ReplicatedStorage.Shared.CrateModel)

	The loot crate, built from parts: a dark armoured case with metal corner
	posts, a glowing band in the rarity colour, side handles, a latch, the
	SNIPER DUEL mark on the front and a hinged lid with a glowing cross.

		local crate = CrateModel.Build({ CFrame = cf, Scale = 1.3, Color = c, Parent = folder })
		crate.Model:PivotTo(cf)          -- move the whole crate (pivot = bottom centre)
		CrateModel.SetLid(crate, 40)     -- open the lid 40 degrees
		CrateModel.SetColor(crate, c)    -- recolour the glow, light and emblems

	Front = -Z of the pivot.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logo = require(ReplicatedStorage.Shared.Logo)

local CrateModel = {}

local V = Vector3.new
local BODY = Color3.fromRGB(30, 33, 42)
local PANEL = Color3.fromRGB(22, 24, 31)
local METAL = Color3.fromRGB(104, 110, 124)
local METAL_DARK = Color3.fromRGB(58, 62, 72)

-- body parts: { size, position (bottom centre = 0), colour, material, glow? }
local BODY_PARTS = {
	{ V(4.1, 0.26, 3.1), V(0, 0.13, 0), METAL_DARK, "Metal" }, -- foot
	{ V(3.8, 2.12, 2.8), V(0, 1.34, 0), BODY, "SmoothPlastic" }, -- case (sits just above the foot)
	{ V(3.86, 0.14, 2.86), V(0, 1.02, 0), nil, "Neon", true }, -- glow band
	{ V(2.3, 1.2, 0.08), V(0, 1.5, -1.43), PANEL, "SmoothPlastic", false, "Emblem" }, -- front plate
	{ V(0.16, 0.34, 1.3), V(-2.0, 1.62, 0), METAL, "Metal" }, -- handles
	{ V(0.16, 0.34, 1.3), V(2.0, 1.62, 0), METAL, "Metal" },
	{ V(0.7, 0.5, 0.2), V(0, 2.18, -1.5), METAL, "Metal" }, -- latch
	{ V(0.26, 0.26, 0.1), V(0, 2.18, -1.62), nil, "Neon", true }, -- latch light
}
-- corner posts and the top rim
for _, x in ipairs({ -1.86, 1.86 }) do
	for _, z in ipairs({ -1.36, 1.36 }) do
		table.insert(BODY_PARTS, { V(0.42, 2.3, 0.42), V(x, 1.4, z), METAL, "Metal" })
	end
end
for _, z in ipairs({ -1.36, 1.36 }) do
	table.insert(BODY_PARTS, { V(3.3, 0.2, 0.3), V(0, 2.42, z), METAL_DARK, "Metal" })
end
-- glowing strips down the four corners
for _, x in ipairs({ -1.86, 1.86 }) do
	for _, z in ipairs({ -1.36, 1.36 }) do
		table.insert(BODY_PARTS, { V(0.12, 1.9, 0.12), V(x * 1.115, 1.4, z * 1.15), nil, "Neon", true })
	end
end
for _, x in ipairs({ -1.86, 1.86 }) do
	table.insert(BODY_PARTS, { V(0.3, 0.2, 2.3), V(x, 2.42, 0), METAL_DARK, "Metal" })
end

-- lid parts, relative to the hinge (back top edge of the case)
local HINGE = V(0, 2.52, 1.5)
local LID_PARTS = {
	{ V(4.06, 0.5, 3.06), V(0, 0.25, -1.5), BODY, "SmoothPlastic" }, -- lid
	{ V(3.4, 0.22, 2.4), V(0, 0.6, -1.5), METAL_DARK, "Metal", false, "Top" }, -- raised top
	{ V(3.44, 0.08, 0.2), V(0, 0.74, -1.5), nil, "Neon", true }, -- glowing cross
	{ V(0.2, 0.08, 2.44), V(0, 0.74, -1.5), nil, "Neon", true },
	{ V(4.1, 0.12, 0.16), V(0, 0.08, -3.02), METAL, "Metal" }, -- front lip
	{ V(4.12, 0.08, 3.12), V(0, 0.32, -1.5), nil, "Neon", true }, -- glowing seam round the lid
}

local function makePart(info, scale, color, parent)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = not info[5]
	part.Size = info[1] * scale
	part.Color = info[3] or color
	part.Material = Enum.Material[info[4]]
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

function CrateModel.Build(options)
	options = options or {}
	local scale = options.Scale or 1
	local color = options.Color or Color3.fromRGB(176, 182, 192)
	local pivot = options.CFrame or CFrame.new()

	local model = Instance.new("Model")
	model.Name = options.Name or "Crate"
	local lid = Instance.new("Model")
	lid.Name = "Lid"
	lid.Parent = model

	local crate = { Model = model, Lid = lid, Glow = {}, Emblems = {}, Scale = scale, Parts = {} }
	local function add(info, cf, parent)
		local part = makePart(info, scale, color, parent)
		part.CFrame = cf
		table.insert(crate.Parts, part)
		if info[5] then
			table.insert(crate.Glow, part)
		end
		if info[6] == "Emblem" then
			part.Name = "Emblem"
			table.insert(crate.Emblems, Logo.OnPart(part, Enum.NormalId.Front, { Layout = "Mark", Color = color, Accent = color, Stroke = 6 * scale }, 40))
		elseif info[6] == "Top" then
			part.Name = "LidTop"
			table.insert(crate.Emblems, Logo.OnPart(part, Enum.NormalId.Top, { Layout = "Mark", Color = color, Accent = color, Stroke = 6 * scale }, 40))
		end
		return part
	end
	for _, info in ipairs(BODY_PARTS) do
		add(info, pivot * CFrame.new(info[2] * scale), model)
	end
	crate.HingeOffset = CFrame.new(HINGE * scale)
	local hinge = pivot * crate.HingeOffset
	for _, info in ipairs(LID_PARTS) do
		add(info, hinge * CFrame.new(info[2] * scale), lid)
	end
	model.WorldPivot = pivot
	lid.WorldPivot = hinge

	local core = crate.Parts[2]
	crate.Core = core
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 9 * scale
	light.Brightness = 1.1
	light.Shadows = false
	light.Parent = core
	crate.Light = light

	crate.Color = color
	model.Parent = options.Parent
	return crate
end

function CrateModel.SetColor(crate, color)
	crate.Color = color
	for _, part in ipairs(crate.Glow) do
		part.Color = color
	end
	crate.Light.Color = color
	for _, gui in ipairs(crate.Emblems) do
		for _, item in ipairs(gui:GetDescendants()) do
			if item:IsA("UIStroke") then
				item.Color = color
			elseif item:IsA("Frame") and item.BackgroundTransparency < 1 then
				item.BackgroundColor3 = color
			end
		end
	end
end

-- Opens the lid `degrees` (0 = shut). `extra` is an optional CFrame applied
-- after the hinge turn (e.g. to throw the lid off).
function CrateModel.SetLid(crate, degrees, extra)
	local hinge = crate.Model:GetPivot() * crate.HingeOffset
	crate.Lid:PivotTo(hinge * CFrame.Angles(math.rad(degrees), 0, 0) * (extra or CFrame.new()))
end

-- Fades every part (0 = solid, 1 = gone) on this client only.
function CrateModel.SetFade(crate, alpha, lidOnly)
	for _, part in ipairs(crate.Parts) do
		if not lidOnly or part:IsDescendantOf(crate.Lid) then
			part.LocalTransparencyModifier = alpha
		end
	end
	for _, gui in ipairs(crate.Emblems) do
		if not lidOnly or gui:IsDescendantOf(crate.Lid) then
			gui.Enabled = alpha < 0.5
		end
	end
end

return CrateModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">GunModel</string>
          <string name="Source"><![CDATA[--[[
	GunModel.lua  (ReplicatedStorage.Shared.GunModel)

	The sniper rifle ("VX-7"), described once as a list of flat-coloured
	parts and built twice:
	  * the rifle in your hands (CharacterService builds it, BodyAnimator animates it)
	  * the rifle other players see in your hands (CharacterService, smaller)

	Look: an angular two-tone rifle (light shell over dark metal) with
	glowing energy lines. The lines take the colour of your best power-up,
	and every power-up bolts its own attachment onto the rifle (see
	GunModel.Mods): coils, side barrels, a grenade canister, tesla coils,
	a blood vial... with its own effect (sparks, embers, a laser, a
	ghostly shimmer...). Stacking a power-up can add more of its parts.

	Gun space: the origin is where the right hand holds the pistol grip.
	+X = right, +Y = up, -Z = forward (down the barrel).

	Each part: { Name, Shape, Size, Position, Rotation(degrees), Color, Group, Extra }
	  Shape     "Block" | "Cylinder" | "Ball" | "Wedge"
	  Size      for a Cylinder: Vector3(length, diameter, diameter), and the
	            cylinder runs along Z (forward) unless Rotation is given
	            (UP = standing up, X = sideways)
	  Color     a key in Config.Palette, or a Color3. "GunGlow" parts glow
	            (Neon) in the rifle's glow colour.
	  Group     "Bolt" parts are animated by the viewmodel (Position is
	            relative to the bolt pivot)
	  Extra     optional { Neon = true, Transparency = n,
	                       Anim = "Pulse" | "Flicker" | "Spin" | "Ghost" | "Speed" }
	            (Anim was played by the old first-person viewmodel)
]]

local Config = require(script.Parent.Config)
local PowerUps = require(script.Parent.PowerUps)

local GunModel = {}

local V = Vector3.new
local C3 = Color3.fromRGB

local X = V(0, 0, 0) -- "rotation given": a cylinder that stays along X (sideways)
local UP = V(0, 0, 90) -- a cylinder standing up (along Y)

local NEON = { Neon = true }

GunModel.Parts = {
	-- SKELETON STOCK
	{ "StockTop", "Block", V(0.16, 0.1, 0.78), V(0, 0.06, 0.78), nil, "GunShell" },
	{ "StockGlow", "Block", V(0.168, 0.025, 0.6), V(0, 0.025, 0.8), nil, "GunGlow" },
	{ "CheekPad", "Block", V(0.18, 0.07, 0.42), V(0, 0.14, 0.86), nil, "GunMetal" },
	{ "StockStrut", "Block", V(0.1, 0.42, 0.1), V(0, -0.12, 0.58), V(-28, 0, 0), "GunMetalLight" },
	{ "StockBottom", "Block", V(0.13, 0.08, 0.66), V(0, -0.33, 0.9), V(-6, 0, 0), "GunMetal" },
	{ "StockRear", "Block", V(0.2, 0.58, 0.14), V(0, -0.12, 1.2), nil, "GunShell" },
	{ "ButtPad", "Block", V(0.22, 0.62, 0.07), V(0, -0.12, 1.3), nil, "GunMetal" },
	{ "StockRearGlow", "Block", V(0.205, 0.04, 0.145), V(0, 0.05, 1.2), nil, "GunGlow" },

	-- GRIP + TRIGGER
	{ "Grip", "Block", V(0.15, 0.4, 0.2), V(0, -0.27, 0.16), V(-18, 0, 0), "GunMetal" },
	{ "GripPanel", "Block", V(0.155, 0.26, 0.12), V(0, -0.27, 0.19), V(-18, 0, 0), "GunMetalLight" },
	{ "GripCap", "Block", V(0.16, 0.04, 0.22), V(0, -0.47, 0.22), V(-18, 0, 0), "GunShell" },
	{ "TriggerGuard", "Block", V(0.05, 0.04, 0.38), V(0, -0.27, -0.06), nil, "GunShell" },
	{ "TriggerGuardFront", "Block", V(0.05, 0.16, 0.04), V(0, -0.2, -0.24), nil, "GunShell" },
	{ "Trigger", "Block", V(0.03, 0.11, 0.03), V(0, -0.17, -0.04), V(15, 0, 0), "GunGlow" },

	-- RECEIVER (angular shell over a dark core)
	{ "Receiver", "Block", V(0.26, 0.26, 1.2), V(0, 0.02, -0.3), nil, "GunShell" },
	{ "ReceiverLower", "Block", V(0.24, 0.12, 0.92), V(0, -0.15, -0.36), nil, "GunMetal" },
	{ "ReceiverCover", "Block", V(0.2, 0.06, 1.1), V(0, 0.17, -0.3), nil, "GunMetal" },
	{ "ReceiverChamferL", "Wedge", V(0.05, 0.06, 1.1), V(-0.125, 0.17, -0.3), V(0, 0, 90), "GunShell" },
	{ "ReceiverChamferR", "Wedge", V(0.05, 0.06, 1.1), V(0.125, 0.17, -0.3), V(0, 0, -90), "GunShell" },
	{ "ReceiverGlowL", "Block", V(0.012, 0.04, 0.9), V(-0.133, 0.04, -0.34), nil, "GunGlow" },
	{ "ReceiverGlowR", "Block", V(0.012, 0.04, 0.6), V(0.133, 0.04, -0.5), nil, "GunGlow" },
	{ "EjectionPort", "Block", V(0.02, 0.1, 0.3), V(0.131, 0.07, -0.05), nil, "GunMetal" },
	{ "BoltShroud", "Cylinder", V(0.18, 0.16, 0.16), V(0, 0.07, 0.36), nil, "GunMetalLight" },
	{ "Rail", "Block", V(0.12, 0.04, 1.0), V(0, 0.22, -0.35), nil, "GunMetalLight" },
	-- energy cell on the left side (glows)
	{ "CellHousing", "Block", V(0.06, 0.16, 0.42), V(-0.15, -0.04, -0.2), nil, "GunMetal" },
	{ "Cell", "Cylinder", V(0.34, 0.1, 0.1), V(-0.18, -0.04, -0.2), nil, "GunGlow", nil, { Anim = "Pulse" } },
	{ "CellCapF", "Cylinder", V(0.04, 0.12, 0.12), V(-0.18, -0.04, -0.39), nil, "GunMetalLight" },
	{ "CellCapB", "Cylinder", V(0.04, 0.12, 0.12), V(-0.18, -0.04, -0.01), nil, "GunMetalLight" },

	-- MAGAZINE (with a glowing round counter)
	{ "Magazine", "Block", V(0.17, 0.34, 0.38), V(0, -0.31, -0.56), V(-10, 0, 0), "GunMetal" },
	{ "MagazineBase", "Block", V(0.19, 0.05, 0.42), V(0, -0.48, -0.59), V(-10, 0, 0), "GunShell" },
	{ "MagWindow", "Block", V(0.176, 0.16, 0.05), V(0, -0.29, -0.48), V(-10, 0, 0), "GunGlow" },

	-- HANDGUARD (angular vented shroud)
	{ "Handguard", "Block", V(0.3, 0.28, 1.4), V(0, 0, -1.6), nil, "GunShell" },
	{ "HandguardTop", "Block", V(0.22, 0.05, 1.42), V(0, 0.16, -1.6), nil, "GunMetal" },
	{ "HandguardBottom", "Block", V(0.2, 0.05, 1.1), V(0, -0.155, -1.7), nil, "GunMetal" },
	{ "HandguardGlowL", "Block", V(0.012, 0.03, 1.3), V(-0.152, -0.07, -1.6), nil, "GunGlow" },
	{ "HandguardGlowR", "Block", V(0.012, 0.03, 1.3), V(0.152, -0.07, -1.6), nil, "GunGlow" },
	{ "HandguardCap", "Block", V(0.32, 0.3, 0.06), V(0, 0, -2.31), nil, "GunMetal" },

	-- BARREL
	{ "Barrel", "Cylinder", V(1.6, 0.12, 0.12), V(0, 0.03, -3.05), nil, "GunMetal" },
	{ "BarrelRing1", "Cylinder", V(0.07, 0.17, 0.17), V(0, 0.03, -2.5), nil, "GunMetalLight" },
	{ "BarrelRing2", "Cylinder", V(0.07, 0.17, 0.17), V(0, 0.03, -2.95), nil, "GunMetalLight" },
	{ "BarrelRing3", "Cylinder", V(0.07, 0.17, 0.17), V(0, 0.03, -3.4), nil, "GunMetalLight" },

	-- MUZZLE BRAKE (big and angular)
	{ "Brake", "Block", V(0.22, 0.2, 0.44), V(0, 0.03, -4.06), nil, "GunMetal" },
	{ "BrakeFin", "Block", V(0.06, 0.08, 0.36), V(0, 0.16, -4.06), nil, "GunShell" },
	{ "BrakeTip", "Cylinder", V(0.05, 0.16, 0.16), V(0, 0.03, -4.29), nil, "GunGlow" },

	-- SCOPE
	{ "ScopeMountFront", "Block", V(0.1, 0.12, 0.12), V(0, 0.28, -0.75), nil, "GunMetal" },
	{ "ScopeMountRear", "Block", V(0.1, 0.12, 0.12), V(0, 0.28, -0.05), nil, "GunMetal" },
	{ "ScopeRingFront", "Cylinder", V(0.1, 0.18, 0.18), V(0, 0.36, -0.75), nil, "GunMetalLight" },
	{ "ScopeRingRear", "Cylinder", V(0.1, 0.18, 0.18), V(0, 0.36, -0.05), nil, "GunMetalLight" },
	{ "ScopeTube", "Cylinder", V(1.0, 0.14, 0.14), V(0, 0.36, -0.38), nil, "GunMetal" },
	{ "ScopeBody", "Block", V(0.17, 0.17, 0.46), V(0, 0.36, -0.4), nil, "GunShell" },
	{ "ScopeBodyGlow", "Block", V(0.175, 0.03, 0.3), V(0, 0.33, -0.4), nil, "GunGlow" },
	{ "ScopeTaper", "Cylinder", V(0.12, 0.19, 0.19), V(0, 0.36, -0.86), nil, "GunMetal" },
	{ "ScopeObjective", "Cylinder", V(0.34, 0.25, 0.25), V(0, 0.36, -1.05), nil, "GunMetal" },
	{ "ScopeHood", "Block", V(0.27, 0.04, 0.42), V(0, 0.5, -1.08), nil, "GunShell" },
	{ "ScopeObjectiveRing", "Cylinder", V(0.04, 0.27, 0.27), V(0, 0.36, -1.22), nil, "GunGlow" },
	{ "ScopeLensFront", "Cylinder", V(0.02, 0.21, 0.21), V(0, 0.36, -1.235), nil, "ScopeGlass" },
	{ "ScopeEyepiece", "Cylinder", V(0.26, 0.2, 0.2), V(0, 0.36, 0.24), nil, "GunMetal" },
	{ "ScopeEyepieceRing", "Cylinder", V(0.05, 0.215, 0.215), V(0, 0.36, 0.16), nil, "GunShell" },
