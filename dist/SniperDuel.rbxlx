-- Movement power-ups without their own attachment get a small charm.
local CHARMS = {
	DoubleJump = C3(160, 120, 255),
	Adrenaline = C3(255, 120, 90),
	Featherweight = C3(170, 220, 200),
	SpringLegs = C3(140, 230, 120),
	PhantomDash = C3(110, 120, 150),
	MagneticBoots = C3(200, 70, 90),
	ShockwaveLanding = C3(240, 170, 40),
	WallRunner = C3(110, 200, 190),
}
local charmIds = {}
for id in pairs(CHARMS) do
	table.insert(charmIds, id)
end
table.sort(charmIds)
for i, id in ipairs(charmIds) do
	-- each charm hangs in its own spot along the right side
	local z = -0.62 - (i - 1) * 0.1
	local color = CHARMS[id]
	GunModel.Mods[id] = function()
		return {
			{ id .. "CharmCord", "Block", V(0.015, 0.12, 0.015), V(0.11, -0.24, z), nil, "GunMetal" },
			{ id .. "Charm", "Ball", V(0.07, 0.07, 0.07), V(0.11, -0.31, z), nil, color, nil, NEON },
		}
	end
end

-- The glow colour for a set of power-ups: the colour of the rarest one
-- (ties: the one with more stacks). No power-ups = Palette.GunGlow.
function GunModel.GlowColor(owned)
	local best, bestScore = nil, -1
	for id, stacks in pairs(owned or {}) do
		local def = PowerUps.Get(id)
		if def and stacks > 0 then
			local rarity = Config.Rarity[def.Rarity]
			local score = (rarity and rarity.Order or 0) * 10 + stacks
			if score > bestScore then
				best, bestScore = def, score
			end
		end
	end
	return best and best.IconColor or Config.Palette.GunGlow
end

-- Total stacks owned (used for "how charged" the rifle looks).
function GunModel.PowerLevel(owned)
	local total = 0
	for _, stacks in pairs(owned or {}) do
		total += stacks
	end
	return total
end

----------------------------------------------------------------------------
-- BUILDING
----------------------------------------------------------------------------

-- The local CFrame of a part spec (cylinders are turned to run along Z).
local function specCFrame(spec, scale)
	local rot = spec[5] or Vector3.zero
	local cf = CFrame.new(spec[4] * scale)
		* CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
	if spec[2] == "Cylinder" and not spec[5] then
		cf *= CFrame.Angles(0, math.rad(90), 0) -- Roblox cylinders run along X
	end
	return cf
end

local EFFECT_TEXTURES = {
	Sparks = "rbxasset://textures/particles/sparkles_main.dds",
	Embers = "rbxasset://textures/particles/sparkles_main.dds",
	Drips = "rbxasset://textures/particles/sparkles_main.dds",
	Wisps = "rbxasset://textures/particles/smoke_main.dds",
}

local function addEffect(part, effect, scale, lightsOn)
	if effect.Kind == "Glow" then
		if lightsOn then
			local light = Instance.new("PointLight")
			light.Color = effect.Color
			light.Range = 4 * scale
			light.Brightness = 1.5
			light.Shadows = false
			light.Parent = part
		end
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "ModEffect"
	emitter.Texture = EFFECT_TEXTURES[effect.Kind] or EFFECT_TEXTURES.Sparks
	emitter.Color = ColorSequence.new(effect.Color)
	emitter.LightEmission = 1
	emitter.LockedToPart = effect.Kind ~= "Drips" and effect.Kind ~= "Embers"
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.12 * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.SpreadAngle = Vector2.new(180, 180)
	if effect.Kind == "Sparks" then
		emitter.Rate = 14
		emitter.Lifetime = NumberRange.new(0.08, 0.2)
		emitter.Speed = NumberRange.new(1.5 * scale, 3 * scale)
	elseif effect.Kind == "Embers" then
		emitter.Rate = 6
		emitter.Lifetime = NumberRange.new(0.4, 0.8)
		emitter.Speed = NumberRange.new(0.3 * scale, 0.8 * scale)
		emitter.Acceleration = Vector3.new(0, 2 * scale, 0)
	elseif effect.Kind == "Drips" then
		emitter.Rate = 2
		emitter.Lifetime = NumberRange.new(0.4, 0.6)
		emitter.Speed = NumberRange.new(0, 0.1)
		emitter.SpreadAngle = Vector2.new(5, 5)
		emitter.Acceleration = Vector3.new(0, -6 * scale, 0)
	else -- Wisps
		emitter.Rate = 5
		emitter.Lifetime = NumberRange.new(0.4, 0.8)
		emitter.Speed = NumberRange.new(0.2 * scale, 0.5 * scale)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05 * scale),
			NumberSequenceKeypoint.new(1, 0.25 * scale),
		})
	end
	emitter.Parent = part
end

--[[
	Builds the gun into `parent`.
	options:
		Scale      size multiplier (default 1)
		Anchored   anchor the parts (viewmodel) or leave them free to weld
		CastShadow
		PowerUps   { [id] = stacks }: adds each power-up's attachment + effects
		           and tints the glow lines
		Effects    false to skip particles / lights
		UseMesh    false to always use the flat-part rifle
	Returns {
		Parts = {[name] = part}, Offsets = {[name] = CFrame}, Bolt = {[name] = true},
		Anims = {[name] = "Pulse" | ...}, Glow = { glowing parts }, GlowColor = Color3,
		BaseTransparency = {[name] = number}
	}
	Offsets of "Bolt" parts are relative to BoltPivot; all others to the grip.
]]
function GunModel.Build(parent, options)
	options = options or {}
	local scale = options.Scale or 1
	local owned = options.PowerUps or {}
	local glowColor = GunModel.GlowColor(owned)
	local template = options.UseMesh ~= false and GunModel.FindTemplate() or nil
	local profile = template and GunModel.MeshProfile or GunModel.PartsProfile
	local result = {
		Parts = {},
		Offsets = {},
		Bolt = {},
		Anims = {},
		Glow = {},
		GlowColor = glowColor,
		BaseTransparency = {},
		Profile = profile, -- Muzzle, ScopeEye, BoltPivot, LeftHold, BarrelY for this rifle
		UsesMesh = template ~= nil,
	}

	local function setup(part, name, offset)
		part.Name = name
		part.Anchored = options.Anchored == true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.Parent = parent
		result.Parts[name] = part
		result.Offsets[name] = offset
		result.BaseTransparency[name] = part.Transparency
	end

	local specs = {}
	if template then
		-- the imported rifle's meshes (textures come along with them)
		for _, info in ipairs(meshLayout(template)) do
			local part = info.Part:Clone()
			for _, child in ipairs(part:GetChildren()) do
				if child:IsA("JointInstance") or child:IsA("Constraint") or child:IsA("BasePart") then
					child:Destroy()
				end
			end
			part.Size = info.Size * scale
			part.CastShadow = options.CastShadow == true
			paintIfBare(part)
			local offset = info.Offset.Rotation + info.Offset.Position * scale
			if info.Part.Name:lower():find("bolt") then
				-- the bolt handle moves with the bolt pivot (see Place / the viewmodel)
				local pivot = CFrame.new(profile.BoltPivot.Position * scale)
				setup(part, info.Name, pivot:Inverse() * offset)
				result.Bolt[info.Name] = true
			else
				setup(part, info.Name, offset)
			end
		end
		-- invisible anchors other code looks up by name
		for name, pos in pairs({ Receiver = Vector3.new(0, 0, -0.3), Barrel = Vector3.new(0, profile.BarrelY, -3) }) do
			local anchor = Instance.new("Part")
			anchor.Size = Vector3.one * 0.1
			anchor.Transparency = 1
			anchor.CastShadow = false
			setup(anchor, name, CFrame.new(pos * scale))
		end
	else
		specs = table.clone(GunModel.Parts)
	end
	local effects = {}
	local ids = {}
	for id in pairs(owned) do
		table.insert(ids, id)
	end
	table.sort(ids) -- same build order every time
	for _, id in ipairs(ids) do
		local mod = GunModel.Mods[id]
		if mod and owned[id] > 0 then
			local modParts, modEffects = mod(owned[id])
			for _, spec in ipairs(modParts or {}) do
				if profile.ModShift ~= Vector3.zero then
					spec = table.clone(spec)
					spec[4] += profile.ModShift
				end
				table.insert(specs, spec)
			end
			for _, effect in ipairs(modEffects or {}) do
				table.insert(effects, effect)
			end
		end
	end

	for _, spec in ipairs(specs) do
		local name, shape, size = spec[1], spec[2], spec[3]
		local extra = spec[8] or {}
		local part
		if shape == "Wedge" then
			part = Instance.new("WedgePart")
		else
			part = Instance.new("Part")
			if shape == "Cylinder" then
				part.Shape = Enum.PartType.Cylinder
			elseif shape == "Ball" then
				part.Shape = Enum.PartType.Ball
			end
		end
		local colorKey = spec[6]
		local isGlow = colorKey == "GunGlow"
		part.Name = name
		part.Size = size * scale
		if typeof(colorKey) == "Color3" then
			part.Color = colorKey
		elseif isGlow then
			part.Color = glowColor
		else
			part.Color = Config.Palette[colorKey] or Color3.new(1, 0, 1)
		end
		part.Material = (isGlow or extra.Neon) and Enum.Material.Neon or Enum.Material.SmoothPlastic
		part.Transparency = extra.Transparency or 0
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Anchored = options.Anchored == true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = options.CastShadow == true and not isGlow and not extra.Neon
		part.Parent = parent

		result.Parts[name] = part
		result.Offsets[name] = specCFrame(spec, scale)
		result.BaseTransparency[name] = part.Transparency
		if spec[7] == "Bolt" then
			result.Bolt[name] = true
		end
		if extra.Anim then
			result.Anims[name] = extra.Anim
		end
		if isGlow then
			table.insert(result.Glow, part)
		end
	end

	if options.Effects ~= false then
		local lightsOn = Config.Effects == nil or Config.Effects.Lights ~= false
		for _, effect in ipairs(effects) do
			local part = result.Parts[effect.Part] or result.Parts.Barrel
			if part then
				addEffect(part, effect, scale, lightsOn)
			end
		end
		-- a charged rifle (lots of power-ups) shimmers along the handguard
		if GunModel.PowerLevel(owned) >= 5 then
			for _, name in ipairs({ "HandguardGlowL", "HandguardGlowR", "Barrel" }) do
				if result.Parts[name] and (name ~= "Barrel" or template) then
					addEffect(result.Parts[name], { Kind = "Sparks", Color = glowColor }, scale * 0.6, lightsOn)
				end
			end
		end
	end
	return result
end

-- CFrame of every part for a given grip CFrame (bolt closed). Handy for
-- placing the gun once before welding it.
function GunModel.Place(built, grip, scale)
	scale = scale or 1
	local boltPivot = grip * CFrame.new(built.Profile.BoltPivot.Position * scale)
	for name, part in pairs(built.Parts) do
		local base = built.Bolt[name] and boltPivot or grip
		part.CFrame = base * built.Offsets[name]
	end
end

return GunModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">PowerUps</string>
          <string name="Source"><![CDATA[--[[
	PowerUps.lua  (ReplicatedStorage.Shared.PowerUps)

	Every power-up is ONE data entry in the `Definitions` list below:

		Id          unique key (used in code and saved in match state)
		Name        shown on the card
		Description short text shown on the card
		Stacking    what each extra copy adds (shown on the card)
		Rarity      "Common" | "Rare" | "Epic" | "Legendary"  (see Config.Rarity)
		Tags        build categories shown on the card ("Bullets", "Damage", ...)
		IconColor   background colour of the flat icon
		Icon        list of simple shapes drawn on the icon (see "ICON SHAPES" below)
		MaxStacks   how many times a player can own it (cards for maxed power-ups
		            stop appearing). Picking it again adds a stack.
		Effect      function(stats, stacks) that changes the player's stat table.

	BUILDS
	Power-ups are designed to combine. Some examples:
	  * Pinball:    Ricochet + Pinball + Shrapnel   (every bounce adds damage AND shards)
	  * Demolition: Explosive Rounds + Shrapnel + Split Shot (a shower of blasts)
	  * Speedster:  Adrenaline + Momentum Rounds + Sky Sniper (bhop = more damage)
	  * Assassin:   Ghost Round + Wallhack Pulse + Marked (shoot through walls at marked targets)
	  * Gunslinger: Hair Trigger + Split Shot + Quickdraw (hits re-chamber instantly)
	  * Tank:       Thick Skin + Vampire + Second Wind
	  * Glass:      Glass Cannon x3 + Momentum Rounds (huge damage, 40 HP)

	HOW EFFECTS WORK
	All game systems (movement, sniper, server damage) read a single "stats"
	table built by PowerUps.ComputeStats(owned). A power-up's Effect just edits
	that table, e.g. Thick Skin does `stats.MaxHealth += 40 * stacks`.

	ADDING A NEW POWER-UP
	1. Add a new entry to Definitions.
	2. If it only changes numbers that already exist in baseStats() (health,
	   jumps, bolt time, bullets, bounces, damage multiplier...) you're done.
	3. If it needs brand new behaviour, add a new field to baseStats(), set it
	   in your Effect, and read that field where the behaviour lives
	   (MovementController / WeaponController / CombatService).

	ICON SHAPES (all positions/sizes are 0-1 of the icon square)
		{ "Circle", x, y, size }
		{ "Ring",   x, y, size, thickness(px) }
		{ "Rect",   x, y, width, height, rotationDegrees }
	Optional keys on any shape:
		A = 0.5        transparency (0 = solid, 1 = invisible)
		Dark = true    draw in the dark UI colour instead of white
		Round = 0.5    corner rounding for a Rect (0-0.5)
	Example: { "Rect", 0.5, 0.5, 0.2, 0.6, 0, A = 0.5 }
]]

local Config = require(script.Parent.Config)
local P = Config.PowerUps

local PowerUps = {}

----------------------------------------------------------------------------
-- BASE STATS: what a player has with zero power-ups.
----------------------------------------------------------------------------
local function baseStats()
	return {
		-- body
		MaxHealth = Config.Player.MaxHealth,
		LifeSteal = 0, -- fraction of damage healed
		SecondWindCharges = 0, -- lethal hits survived per round

		-- rifle
		BoltTime = Config.Weapon.BoltTime,
		ScopeInTime = Config.Weapon.ScopeInTime,
		Bullets = 1,
		HairTrigger = false, -- a hit re-chambers instantly

		-- bullet path
		GhostWalls = 0, -- walls a bullet can pass through
		Bounces = 0, -- ricochets per bullet
		Homing = false,
		HomingTurn = 0, -- degrees per step
		HomingRadius = 0,
		Explosive = false,
		ExplosionRadius = 0,
		ExplosionDamage = 0,
		ShrapnelCount = 0, -- shards per bounce / wall pass / impact
		StaticChargeDamage = 0, -- near misses zap the enemy
		StaticChargeRadius = 0,

		-- damage
		DamageMultiplier = 1,
		AirDamageBonus = 0, -- extra damage while you're airborne
		SpeedDamageBonus = 0, -- multiplier on the Momentum Rounds bonus
		HopDamageBonus = 0, -- extra damage per bounce / wall pass before the hit
		MarkBonus = 0, -- extra damage against a target you hit recently

		-- movement
		AirJumps = Config.Movement.AirJumps,
		MoveSpeedMultiplier = 1,
		GravityScale = 1,
		JumpMultiplier = 1,
		RocketJump = false,
		RocketJumpPower = 1,
		Grapple = false,
		GrappleCooldown = Config.Movement.GrappleCooldown,
		GrapplePull = 1,
		Blink = false,
		BlinkDistance = 0,
		BlinkCooldown = 0,
		PhantomDash = false,
		PhantomTime = 0,
		WallRun = false, -- Wall Runner power-up
		WallRunTime = 0,
		WallRunCooldown = Config.Movement.WallRunCooldown,
		CeilingRun = false,
		ShockwaveLanding = false,
		ShockwaveRadius = 0,
		ShockwaveKnockback = 0,
		ShockwaveDamage = 0,

		-- utility
		BulletTime = false,
		BulletTimeDuration = 0,
		WallhackPulse = false,
		WallhackInterval = 0,
		WallhackDuration = 0,
		Decoy = false,
		DecoyCount = 0,
	}
end

----------------------------------------------------------------------------
-- DEFINITIONS
----------------------------------------------------------------------------
PowerUps.Definitions = {
	-------------------------------------------------------------- BULLETS
	{
		Id = "GhostRound",
		Name = "Ghost Round",
		Description = "Bullets pass through a wall before hitting.",
		Stacking = "+1 wall per stack",
		Rarity = "Epic",
		Tags = { "Bullets" },
		IconColor = Color3.fromRGB(150, 110, 255),
		MaxStacks = 3,
		Icon = {
			{ "Rect", 0.5, 0.5, 0.12, 0.7, 0 },
			{ "Circle", 0.22, 0.5, 0.16, A = 0.45 },
			{ "Circle", 0.78, 0.5, 0.16 },
		},
		Effect = function(s, n)
			s.GhostWalls += P.GhostRound.WallsPerStack * n
		end,
	},
	{
		Id = "Ricochet",
		Name = "Ricochet",
		Description = "Bullets bounce off surfaces.",
		Stacking = "+1 bounce per stack",
		Rarity = "Rare",
		Tags = { "Bullets" },
		IconColor = Color3.fromRGB(40, 190, 200),
		MaxStacks = 4,
		Icon = {
			{ "Rect", 0.36, 0.45, 0.12, 0.55, -30 },
			{ "Rect", 0.64, 0.45, 0.12, 0.55, 30 },
			{ "Rect", 0.5, 0.82, 0.7, 0.08, 0 },
		},
		Effect = function(s, n)
			s.Bounces += P.Ricochet.BouncesPerStack * n
		end,
	},
	{
		Id = "SplitShot",
		Name = "Split Shot",
		Description = "Every shot fires 3 bullets in a tight spread.",
		Stacking = "+2 bullets per stack",
		Rarity = "Legendary",
		Tags = { "Bullets" },
		IconColor = Color3.fromRGB(255, 90, 90),
		MaxStacks = 2,
		Icon = {
			{ "Rect", 0.5, 0.5, 0.08, 0.7, 0 },
			{ "Rect", 0.36, 0.52, 0.08, 0.66, -18 },
			{ "Rect", 0.64, 0.52, 0.08, 0.66, 18 },
		},
		Effect = function(s, n)
			s.Bullets += P.SplitShot.BulletsPerStack * n
		end,
	},
	{
		Id = "HomingRounds",
		Name = "Homing Rounds",
		Description = "Bullets curve toward the enemy when they pass close by.",
		Stacking = "Stronger and wider curve per stack",
		Rarity = "Legendary",
		Tags = { "Bullets" },
		IconColor = Color3.fromRGB(255, 70, 140),
		MaxStacks = 3,
		Icon = {
			{ "Ring", 0.5, 0.5, 0.74, 4 },
			{ "Ring", 0.5, 0.5, 0.42, 4 },
			{ "Circle", 0.5, 0.5, 0.14 },
		},
		Effect = function(s, n)
			local cfg = P.HomingRounds
			s.Homing = true
			s.HomingTurn = cfg.TurnDegreesPerStack * n
			s.HomingRadius = cfg.Radius + cfg.RadiusPerStack * (n - 1)
		end,
	},
	{
		Id = "ExplosiveRounds",
		Name = "Explosive Rounds",
		Description = "Bullets explode on impact with splash damage and knockback.",
		Stacking = "Bigger, harder blasts per stack",
		Rarity = "Epic",
		Tags = { "Bullets", "Damage" },
		IconColor = Color3.fromRGB(255, 120, 50),
		MaxStacks = 3,
		Icon = {
			{ "Rect", 0.5, 0.5, 0.5, 0.5, 0 },
			{ "Rect", 0.5, 0.5, 0.5, 0.5, 45 },
			{ "Circle", 0.5, 0.5, 0.24, Dark = true },
		},
		Effect = function(s, n)
			local cfg = P.ExplosiveRounds
			s.Explosive = true
			s.ExplosionRadius = cfg.Radius + cfg.RadiusPerStack * (n - 1)
			s.ExplosionDamage = cfg.Damage + cfg.DamagePerStack * (n - 1)
		end,
	},
	{
		Id = "Shrapnel",
		Name = "Shrapnel",
		Description = "Every bounce, wall pass and impact sprays 2 damaging shards.",
		Stacking = "+2 shards per stack. Great with Ricochet",
		Rarity = "Epic",
		Tags = { "Bullets", "Damage" },
		IconColor = Color3.fromRGB(230, 150, 60),
		MaxStacks = 3,
		Icon = {
			{ "Rect", 0.5, 0.82, 0.7, 0.08, 0 },
			{ "Rect", 0.32, 0.45, 0.07, 0.42, -35 },
			{ "Rect", 0.5, 0.4, 0.07, 0.5, 0 },
			{ "Rect", 0.68, 0.45, 0.07, 0.42, 35 },
		},
		Effect = function(s, n)
			s.ShrapnelCount += P.Shrapnel.ShardsPerStack * n
		end,
	},
	{
		Id = "StaticCharge",
		Name = "Static Charge",
		Description = "Near misses zap the enemy for 20 damage.",
		Stacking = "+20 damage and wider zap per stack",
		Rarity = "Rare",
		Tags = { "Bullets", "Damage" },
		IconColor = Color3.fromRGB(80, 200, 255),
		MaxStacks = 3,
		Icon = {
			{ "Rect", 0.56, 0.28, 0.1, 0.36, 25 },
			{ "Rect", 0.5, 0.5, 0.4, 0.1, -10 },
			{ "Rect", 0.44, 0.72, 0.1, 0.36, 25 },
			{ "Ring", 0.5, 0.5, 0.86, 2, A = 0.5 },
		},
		Effect = function(s, n)
			local cfg = P.StaticCharge
			s.StaticChargeDamage += cfg.Damage * n
			s.StaticChargeRadius = cfg.Radius + cfg.RadiusPerStack * (n - 1)
		end,
	},

	-------------------------------------------------------------- DAMAGE
	{
		Id = "Pinball",
		Name = "Pinball",
		Description = "Bullets deal +35% damage for every bounce or wall they went through.",
		Stacking = "+35% per hop per stack. Needs Ricochet or Ghost Round",
		Rarity = "Rare",
		Tags = { "Damage" },
		IconColor = Color3.fromRGB(255, 110, 200),
		MaxStacks = 2,
		Icon = {
			{ "Circle", 0.3, 0.3, 0.2 },
			{ "Circle", 0.7, 0.45, 0.2, A = 0.35 },
			{ "Circle", 0.4, 0.72, 0.2, A = 0.6 },
			{ "Rect", 0.5, 0.38, 0.4, 0.06, 20 },
			{ "Rect", 0.55, 0.6, 0.06, 0.32, 40 },
		},
		Effect = function(s, n)
			s.HopDamageBonus += P.Pinball.BonusPerHop * n
		end,
	},
	{
		Id = "MomentumRounds",
		Name = "Momentum Rounds",
		Description = "The faster you move, the harder you hit (up to +60%).",
		Stacking = "Bonus doubles, triples... per stack. Bunny hop!",
		Rarity = "Rare",
		Tags = { "Damage", "Movement" },
		IconColor = Color3.fromRGB(255, 170, 60),
		MaxStacks = 3,
		Icon = {
			{ "Rect", 0.35, 0.3, 0.4, 0.08, 0, A = 0.5 },
			{ "Rect", 0.3, 0.5, 0.4, 0.08, 0, A = 0.3 },
			{ "Rect", 0.35, 0.7, 0.4, 0.08, 0, A = 0.5 },
			{ "Circle", 0.68, 0.5, 0.3 },
		},
		Effect = function(s, n)
			s.SpeedDamageBonus += n
		end,
	},
	{
		Id = "SkySniper",
		Name = "Sky Sniper",
		Description = "+20% damage while you're in the air.",
		Stacking = "+20% per stack",
		Rarity = "Common",
		Tags = { "Damage", "Movement" },
		IconColor = Color3.fromRGB(110, 190, 255),
		MaxStacks = 3,
		Icon = {
			{ "Circle", 0.5, 0.35, 0.3 },
			{ "Rect", 0.5, 0.75, 0.7, 0.06, 0, A = 0.4 },
			{ "Rect", 0.5, 0.35, 0.06, 0.5, 0, Dark = true },
			{ "Rect", 0.5, 0.35, 0.5, 0.06, 0, Dark = true },
		},
		Effect = function(s, n)
			s.AirDamageBonus += P.SkySniper.AirBonus * n
		end,
	},
	{
		Id = "GlassCannon",
		Name = "Glass Cannon",
		Description = "+30% damage, but -20 max health.",
		Stacking = "+30% damage / -20 health per stack",
		Rarity = "Common",
		Tags = { "Damage" },
		IconColor = Color3.fromRGB(200, 230, 255),
		MaxStacks = 3,
		Icon = {
			{ "Rect", 0.5, 0.5, 0.42, 0.42, 45, A = 0.3 },
			{ "Rect", 0.42, 0.42, 0.04, 0.36, 30, Dark = true },
			{ "Rect", 0.58, 0.58, 0.04, 0.3, -20, Dark = true },
		},
		Effect = function(s, n)
			s.DamageMultiplier *= 1 + P.GlassCannon.DamageBonus * n
			s.MaxHealth -= P.GlassCannon.HealthCost * n
		end,
	},
	{
		Id = "Marked",
		Name = "Marked",
		Description = "Hitting the enemy marks them for 4s: they glow for you and take +25% damage.",
		Stacking = "+25% damage per stack",
		Rarity = "Rare",
		Tags = { "Damage" },
		IconColor = Color3.fromRGB(255, 80, 80),
		MaxStacks = 3,
		Icon = {
			{ "Ring", 0.5, 0.5, 0.62, 4 },
			{ "Rect", 0.5, 0.14, 0.06, 0.2, 0 },
			{ "Rect", 0.5, 0.86, 0.06, 0.2, 0 },
			{ "Rect", 0.14, 0.5, 0.2, 0.06, 0 },
			{ "Rect", 0.86, 0.5, 0.2, 0.06, 0 },
		},
		Effect = function(s, n)
			s.MarkBonus += P.Marked.BonusPerStack * n
		end,
	},
	{
		Id = "HairTrigger",
		Name = "Hair Trigger",
